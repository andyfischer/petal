// Micro-benchmark: `speculate` of a small pure function against a plain call
// (docs/tasks/differentiation-rewrite.md, Design §4). `f` touches nothing
// `speculate` would have to put back, so the difference per call is the
// fixed cost of entering, leaving and building the result: what every
// `autodiff` probe of an arithmetic helper pays. `plain`, `spec` and `specv`
// each call `f` 500 times with a varying argument.
//
//   petal bench --fn plain --fn spec --fn specv test/benchmarks/micro/speculate_pure.ptl
//
// Numbers are in docs/features/speculate.md (Performance).

fn f(x)
  (x - 3.0) * (x - 3.0) + sin(x)
end

fn plain(x)
  f(x)
end

fn spec(x)
  speculate(f, x).value
end

fn specv(x)
  speculate_value(f, x)
end

var total = 0.0
for i in range(0, 500) do
  let x = i * 0.01
  set total += plain(x)
  set total += spec(x)
  set total += specv(x)
end
get total
