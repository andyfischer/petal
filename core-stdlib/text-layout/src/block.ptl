@module_doc("""
A paragraph placed in a box: wrapped, aligned on both axes, line-limited and
elided, as a layout value or drawn.

One call takes a string, a rect and an options record and returns every line
with the exact `{x, y}` to draw it at, or draws them itself. Wrapping,
alignment on both axes, a line limit with an ellipsis, and a leading — the
things a label needs once it is more than one word.

The layout is a *value*: `text_block` measures and places without drawing, so
a caller can size a panel to its text, decide whether it overflowed, or hand
the same layout to a hit-test and to the paint. `draw_text_block` is that
call plus the loop that draws it.
""", see: ["text_block", "draw_text_block"])

import text_layout/place: text_baseline, text_align_x
import text_layout/fit: wrap_text, elide, clamp_lines, line_step, lines_width
import ui

@doc("""
Lay `s` out in `r`, without drawing it: every line with the exact position
to draw it at. The layout is a value, so a caller can size a panel to its
text, decide whether it overflowed, or hand the same layout to a hit-test and
to the paint.

A line that is still too wide after wrapping is cut with an ellipsis rather
than allowed to run out of its box.
""", params: {s: "The text.", r: "The box.", style: "The text style record it is drawn with."},
  options: {
    align: """`"left"` (the default), `"center"` or `"right"`.""",
    valign: """`"top"` (the default), `"middle"` (or `"center"`) or `"bottom"`: where the block sits in `r`.""",
    wrap: "False keeps each line whole whatever its width; the text's own newlines still break (true).",
    lines: "A maximum line count, the last line elided; 0 for no limit (0).",
    elide: """True marks a cut with "…" (the default); `"tail"` / `"both"` choose which end survives, as `elide`'s `keep`; false lets a line overflow.""",
    lead: "Line spacing: a multiple of the face's own recommendation, or a pixel distance when 4 or more (1.0).",
  },
  returns: """
    `{lines, w, h, overflow}`: `lines` is a list of `{text, x, y, baseline,
    w}`, each `y` ready for `draw_text` and `baseline` the same line's
    baseline, for a caller drawing its own decorations; `w` and `h` are the
    block's own extent (which may be smaller than `r`; `h` is ink to ink);
    `overflow` says the text needed more room than `r` gave it.
  """,
  example: """
    let b = text_block(body, card, style, {lines: 3, lead: 1.2})
    if b.overflow then show_more = true end
  """, see: ["draw_text_block", "text_size"])
pub fn text_block(s: string, r: record, style: record, opts: record) -> record
  let wrapping = field(opts, "wrap", true)
  let limit = field(opts, "lines", 0)
  let eliding = field(opts, "elide", true)
  let lead = field(opts, "lead", 1.0)
  let align = field(opts, "align", "left")

  let raw = if wrapping then
    text_wrap(s, style, float(r.w))
  else
    # Not wrapping still means honouring the author's own newlines: a
    # two-line label is two lines, it just does not gain any more.
    text_wrap(s, style, 0.0)
  let capped = if limit > 0 && len(raw) > limit then
    clamp_lines(s, style, float(r.w), limit)
  else
    raw
  # A line that is still too wide — an unwrapped label, or a wrapped one whose
  # longest word beat the box — is cut here rather than left to overflow.
  let keep = if eliding == true then "head" else eliding end
  let fitted = if eliding == false then
    capped
  else
    var out = []
    for line in capped do
      set out = append(out, elide(line, style, float(r.w), keep))
    out

  let m = text_metrics(style)
  let step = line_step(style, lead)
  let n = max(1, len(fitted))
  # The block's height is ink to ink: the first line's cap height down to the
  # last line's descenders. Counting a whole line box per line would add a
  # leading above the first line that nothing is drawn in, and a box "fitted"
  # to that looks bottom-heavy.
  let h = m.cap_height + m.descent + float(n - 1) * step
  let first = match field(opts, "valign", "top")
    when "middle" -> float(r.y) + (float(r.h) - h) / 2.0 + m.cap_height
    when "center" -> float(r.y) + (float(r.h) - h) / 2.0 + m.cap_height
    when "bottom" -> float(r.y) + float(r.h) - h + m.cap_height
    when _ -> float(r.y) + m.cap_height

  var placed = []
  var widest = 0.0
  for i in range(0, len(fitted)) do
    let text = fitted[i]
    let lw = float(text_width(text, style))
    if lw > widest then
      set widest = lw
    let base = first + float(i) * step
    set placed = append(placed, {text: text, x: text_align_x(lw, r, align),
      y: base - m.baseline, baseline: base, w: lw})
  {lines: placed, w: widest, h: h, overflow: len(raw) > len(fitted) || widest > float(r.w) + 0.5}

pub fn text_block(s: string, r: record, style: record) -> record
  text_block(s, r, style, {})

@doc("""
Lay `s` out in `r` and draw it: `text_block` plus the loop that draws it.
""", params: {s: "The text.", r: "The box.", style: "The text style record."},
  options: {
    align: """`"left"` (the default), `"center"` or `"right"`.""",
    valign: """`"top"` (the default), `"middle"` (or `"center"`) or `"bottom"`: where the block sits in `r`.""",
    wrap: "False keeps each line whole whatever its width; the text's own newlines still break (true).",
    lines: "A maximum line count, the last line elided; 0 for no limit (0).",
    elide: """True marks a cut with "…" (the default); `"tail"` / `"both"` choose which end survives, as `elide`'s `keep`; false lets a line overflow.""",
    lead: "Line spacing: a multiple of the face's own recommendation, or a pixel distance when 4 or more (1.0).",
  },
  returns: "The record `text_block` returns, so the caller that needs the block's height for the next row gets it without laying the text out twice.",
  example: """
    let b = text_layout.draw_text_block(summary, card, style, {lines: 2, lead: 1.15})
    let next_y = card.y + b.h + 12
  """, see: ["text_block", "text_layout/place.draw_text_line"])
pub fn draw_text_block(s: string, r: record, style: record, opts: record) -> record
  let b = text_block(s, r, style, opts)
  for line in b.lines do
    draw_text(line.text, {x: line.x, y: line.y}, style)
  b

pub fn draw_text_block(s: string, r: record, style: record) -> record
  draw_text_block(s, r, style, {})

@doc("""
The size `s` would take in a box `max_w` wide: for a caller that sizes a
panel, a tooltip or a table row to its content before it has anywhere to put
it.
""", params: {s: "The text.", style: "The text style record.", max_w: "The wrap width, in px.",
  opts: "`text_block`'s options."},
  returns: """`{w, h}` in px.""",
  example: """let sz = text_size(tip, style, 240)""", see: ["text_block"])
pub fn text_size(s: string, style: record, max_w: num, opts: record) -> record
  let b = text_block(s, Rect(0, 0, float(max_w), 0), style, opts)
  {w: b.w, h: b.h}

pub fn text_size(s: string, style: record, max_w: num) -> record
  text_size(s, style, max_w, {})
