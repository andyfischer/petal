@module_doc("""
Derivatives and solving by finite differences: deriv, jacobian, solve_step
and solve.

Needs `import autodiff`, which puts these in scope bare (`deriv(…)`),
qualified (`autodiff.deriv(…)`) and as methods.

Each function calls `f` with its inputs nudged (every call inside
[`speculate`](features/speculate.md), so nothing `f` writes or draws is left
behind) and measures how the output moved. `f` returns a number or a list of
numbers. Because every probe runs inside `speculate`, `f` may read and write
`state`, emit draw commands or call effectful natives; when the caller is
itself speculating (inside a `ui/drag` candidate rendering, or a `speculate`
call), the probes run directly, since the outer call already puts everything
back. The rules for each measurement's `quality`, the options and worked
examples are in [features/differentiation.md](features/differentiation.md).
""",
  see: ["speculate", "fd_column", "gn_step"])

# Package `autodiff`, written in Petal over two natives
# (core/src/builtins/drag_math.rs): `fd_column`, which classifies a column by
# direct manipulation v2's rules (smooth, kink, branch flip, step, zero,
# errored) and asks for the points to sample, and `gn_step`, the
# Gauss-Newton step `ui/drag`'s `vary` and DM v2 share.

# `f(arg)`, put back afterwards: under `speculate`, or directly when a
# speculative call is already running (`speculate` does not nest).
fn _run(f, arg)
  if speculating() then f(arg) else speculate(f, arg).value end

# One column: ask `fd_column` for points until it has what it needs.
# `probe(x)` is the function with the input at `x`; `base` its value at
# `at`.
fn _column(probe, at, base, opts)
  let samples = []
  let r = fd_column(at, base, samples, opts)
  while type(r) == "float" do
    samples = append(samples, [r, probe(r)])
    r = fd_column(at, base, samples, opts)
  r

# The `fd_column` options out of a caller's.
fn _fd_opts(opts)
  {h: opts.h ?? nil, mode: opts.mode ?? "central"}

# A number or a list of numbers, as a list.
fn _rows(v)
  if type(v) == "list" then v else [v] end

# The Euclidean distance between two lists of numbers.
fn _dist(a, b)
  let s = 0.0
  for i in range(0, len(a)) do
    let d = a[i] - b[i]
    s += d * d
  sqrt(s)

# The result of `deriv` from a column: `error` only when a probe failed.
fn _result(c)
  if c.quality == "errored" then
    {value: c.value, quality: c.quality, step: c.step, error: c.error}
  else
    {value: c.value, quality: c.quality, step: c.step}

@doc("""
The derivative of `f` at `x` by central differences, with
`h = 1e-4 * max(abs(x), 1)`. `quality` says whether `value` can be trusted
as a slope: `"smooth"`, `"kink"`, `"branch_flip"`, `"step"`, `"zero"` or
`"errored"` (the record then has `error`), and `step` is the `h` the value
was measured with.
""",
  params: {f: "One number in, a number or a list of numbers out.", x: "Where to measure."},
  options: {h: "The step to measure with, in place of the default.", mode: """`"central"` (the default) or `"forward"` differences."""},
  returns: """`{value, quality, step}`, plus `error` when `quality` is `"errored"`.""",
  example: """
    import autodiff
    print(round(deriv(fn(x) x * x end, 3.0).value, 6))   # 6.0
    print(deriv(abs, 0.0).quality)                       # kink
  """,
  see: ["jacobian", "fd_column"])
pub fn deriv(f, x, opts = {})
  let x0 = float(x)
  let base = _run(f, x0)
  _result(_column(fn(v) _run(f, v) end, x0, base, _fd_opts(opts)))

# The Jacobian and the base value: `{rows, quality, step, base}`.
fn _jacobian(f, xs, opts)
  let x0 = map(xs, fn(v) float(v) end)
  let base = _run(f, x0)
  let fo = _fd_opts(opts)
  let cols = for j in range(0, len(x0)) do
    _column(fn(v) _run(f, set_in(x0, [j], v)) end, x0[j], base, fo)
  let n = len(_rows(base))
  let rows = for i in range(0, n) do
    for c in cols do _rows(c.value)[i] end
  {
    rows: rows,
    quality: map(cols, fn(c) c.quality end),
    step: map(cols, fn(c) c.step end),
    base: base,
  }

@doc("""
The Jacobian of `f` at the list `xs`: `rows[i][j]` is the derivative of
output `i` by input `j` (`d out_i / d in_j`; a number out is one row), and
`quality` and `step` have one entry per input. Same options as `deriv`.
""",
  params: {f: "A list of numbers in, a number or a list of numbers out.", xs: "The inputs to measure at."},
  options: {h: "The step to measure with, in place of the default.", mode: """`"central"` (the default) or `"forward"` differences."""},
  returns: """`{rows, quality, step}`.""",
  example: """
    import autodiff
    let j = jacobian(fn(p) [p[0] + p[1], p[0] * p[1]] end, [2.0, 3.0])
    print(j.quality)   # ["smooth", "smooth"]
  """,
  see: ["deriv", "solve_step"])
pub fn jacobian(f, xs, opts = {})
  let j = _jacobian(f, xs, opts)
  {rows: j.rows, quality: j.quality, step: j.step}

# Clamp `v` into `b`, nil or `[lo, hi]` (either end may be nil).
fn _bound(v, b)
  if b == nil then
    v
  else
    let lo = if b[0] == nil then v else max(v, b[0]) end
    if b[1] == nil then lo else min(lo, b[1]) end

# Move from `xs` toward `next` by at most `max_step` per input (nil, a
# number for all, or one per input; nil entries are unlimited), and keep
# each input in its bounds.
fn _limit(xs, next, max_step, bounds)
  for i in range(0, len(xs)) do
    let cap = if type(max_step) == "list" then max_step[i] else max_step end
    let d = next[i] - xs[i]
    let d2 = if cap == nil then d else clamp(d, -abs(cap), abs(cap)) end
    _bound(xs[i] + d2, if bounds == nil then nil else bounds[i] end)

@doc("""
One damped Gauss-Newton step from `xs` toward `f(xs) == target`, with the
Jacobian measured as `jacobian` does. A step that does not bring the output
closer is halved, up to four times; when none does, `xs` comes back
unchanged with `improved: false`.

The result: `xs`, the new inputs; `residual`, the distance from `f(xs)` to
`target` there; `improved`, whether the step got closer; `stuck`, the
indices of inputs that do not move the output (quality `"zero"` or
`"errored"`); and `quality`, the Jacobian's, one per input.
""",
  params: {f: "A list of numbers in, a number or a list of numbers out.", xs: "The inputs to start from.", target: "The output wanted: a number or a list of numbers."},
  options: {
    bounds: "`[[lo, hi], …]`, one per input; either end may be nil.",
    max_step: "The most an input may move: a number for all, or one per input.",
    damping: "The step's scale (default `1.0`).",
    h: "As for `deriv`.",
    mode: "As for `deriv`.",
  },
  returns: """`{xs, residual, improved, stuck, quality}`.""",
  example: """
    import autodiff
    let r = solve_step(fn(p) [p[0] + p[1], p[0] - p[1]] end, [0.0, 0.0], [3.0, 1.0])
    print(r.xs)   # [2.0, 1.0]
  """,
  see: ["solve", "jacobian", "gn_step"])
pub fn solve_step(f, xs, target, opts = {})
  let j = _jacobian(f, xs, opts)
  let x0 = map(xs, fn(v) float(v) end)
  let ts = _rows(target)
  let ys = _rows(j.base)
  let stuck = []
  for i in range(0, len(j.quality)) do
    if j.quality[i] == "zero" || j.quality[i] == "errored" then
      stuck = append(stuck, i)
  # A stuck column is not divided by: its sensitivities count as 0.
  let jac = for row in j.rows do
    for k in range(0, len(row)) do
      if j.quality[k] == "zero" || j.quality[k] == "errored" then 0.0 else row[k] end
  let bounds = opts.bounds ?? nil
  let r0 = _dist(ys, ts)
  let out = {xs: x0, residual: r0, improved: false, stuck: stuck, quality: j.quality}
  let scale = opts.damping ?? 1.0
  let done = false
  for attempt in range(0, 5) do
    if !done then
      let next = _limit(x0, gn_step(x0, ys, ts, jac, bounds, scale), opts.max_step ?? nil, bounds)
      if next == x0 then
        done = true
      else
        let r = _dist(_rows(_run(f, next)), ts)
        if r < r0 then
          out.xs = next
          out.residual = r
          out.improved = true
          done = true
      scale *= 0.5
  out

@doc("""
`solve_step` repeated until `residual` is at most `tol`, `max_iter` steps
are spent, or a step stops improving. The result is `solve_step`'s record
from the last step, with `improved` true when any step improved, plus
`iterations`.
""",
  params: {f: "A list of numbers in, a number or a list of numbers out.", xs: "The inputs to start from.", target: "The output wanted: a number or a list of numbers."},
  options: {
    tol: "The residual that counts as solved (default `1e-6`).",
    max_iter: "The most steps to take (default 20).",
    bounds: "As for `solve_step`.",
    max_step: "As for `solve_step`.",
    damping: "As for `solve_step`.",
    h: "As for `deriv`.",
    mode: "As for `deriv`.",
  },
  returns: """`{xs, residual, improved, stuck, quality, iterations}`.""",
  example: """
    import autodiff
    let s = solve(fn(a) 200.0 + 80.0 * cos(a[0]) end, [0.6], 240.0)
    print(round(s.xs[0], 4))   # 1.0472
  """,
  see: ["solve_step"])
pub fn solve(f, xs, target, opts = {})
  let tol = opts.tol ?? 0.000001
  let max_iter = opts.max_iter ?? 20
  let r = {xs: map(xs, fn(v) float(v) end), residual: nil, improved: false, stuck: [], quality: []}
  let improved = false
  let iterations = 0
  let done = false
  for i in range(0, max_iter) do
    if !done then
      let s = solve_step(f, r.xs, target, opts)
      iterations += 1
      improved = improved || s.improved
      r = s
      if s.residual <= tol || !s.improved then
        done = true
  {...r, improved: improved, iterations: iterations}
