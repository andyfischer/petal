// ── view state ──────────────────────────────────────────────────────────────
state seg      = "All"        // segment filter (a stage name, or "All")
state q        = ""
state sort_key = "days"       // name | company | stage | value | days
state sort_dir = 1            // 1 ascending, -1 descending
state sel_id   = 1            // selected contact id (stable across sorts)
state scroll   = 0            // first visible row
state focus    = ""           // focused text field id, "" = none
state editing  = false        // inspector is in form mode
state ed_id    = 0
state ed_name  = ""
state ed_title = ""
state ed_co    = ""
state ed_email = ""
state ed_phone = ""
state ed_stage = "Lead"
state ed_value = ""
state saves    = 0            // count of form saves (observable in /state)

// ── small helpers ───────────────────────────────────────────────────────────
fn stage_color(s: string) -> record
  match s
    when "Lead" -> VIOLET
    when "Qualified" -> ACCENT
    when "Proposal" -> AMBER
    when "Customer" -> TEAL
    when _ -> ROSE
  end
end

fn stage_rank(s: string) -> int
  match s
    when "Lead" -> 0
    when "Qualified" -> 1
    when "Proposal" -> 2
    when "Customer" -> 3
    when _ -> 4
  end
end

fn money(v: num) -> string
  if v >= 1000 then "${int(v / 1000)}k" else "${v}" end
end

fn money_big(v: num) -> string
  if v >= 1000000 then
    "${int(v / 1000000)}.{int((v % 1000000) / 100000)}M"
  else
    money(v)
  end
end

fn ago(d: num) -> string
  if d == 0 then "today"
  elsif d == 1 then "yesterday"
  elsif d < 7 then "{d}d ago"
  elsif d < 60 then "{int(d / 7)}w ago"
  else "{int(d / 30)}mo ago"
  end
end

// How warm a contact is, as a 0..1 fraction of a 45-day window plus the color
// the table paints it in.
fn freshness(days: num) -> record
  let f = clamp(1.0 - float(days) / 45.0, lo: 0.0, hi: 1.0)
  let c = if days <= 7 then TEAL
  elsif days <= 30 then AMBER
  else ROSE
  end
  {frac: f, color: c}
end

// Keep only ASCII digits — the deal-value field is numeric, and this is the
// closest Petal gets to an input mask.
fn digits(s: string) -> string
  var out = ""
  for i in range(0, len(s)) do
    let ch = slice(s, start: i, end: i + 1)
    if contains("0123456789", ch) && len(ch) > 0 then set out = out ++ ch end
  end
  out
end

fn initials(name: string) -> string
  var out = ""
  for part in split(name, " ") do
    if len(part) > 0 && len(out) < 2 then
      // slice is byte-indexed and snaps DOWN to a char boundary, so a leading
      // multi-byte letter ("Ó") makes slice(part, 0, 1) empty — widen until a
      // whole character comes out.
      var ch = slice(part, start: 0, end: 1)
      var n = 1
      while len(ch) == 0 && n < 5 do
        set n = n + 1
        set ch = slice(part, start: 0, end: n)
      end
      set out = out ++ upper(ch)
    end
  end
  out
end

// A short, deterministic history for a contact: the newest entry reflects the
// stage the deal is actually in, the older two are the same for everyone.
fn activity(c: record) -> list
  let head = match c.stage
    when "Lead" -> "Inbound enquiry received"
    when "Qualified" -> "Discovery call completed"
    when "Proposal" -> "Proposal sent for review"
    when "Customer" -> "Contract countersigned"
    when _ -> "Cancellation confirmed"
  end
  [
    {label: head, ago_days: c.days},
    {label: "Follow-up email from {c.owner}", ago_days: c.days + 6 + c.id % 9},
    {label: "Added to the pipeline", ago_days: c.days + 74 + c.id % 60},
  ]
end

// A rounded panel with a 1px border, since draw_rect_outline is square-cornered.
fn rr(r: record, radius: num, fill: record, border: record)
  draw_rect_rounded(r, radius, c: border)
  draw_rect_rounded(rect(r.x + 1, r.y + 1, r.w - 2, r.h - 2), radius: radius - 1, c: fill)
end

fn chip(x: num, y: num, label: string, c: record) -> num
  let tw = text_width(label, FS_MICRO)
  let r = rect(x, y, tw + 16, 18)
  draw_rect_rounded(r, radius: 9, c: c, a: 38)
  draw_text(label, pos: {x: x + 8, y: y + 4}, style: {size: FS_MICRO, color: c, spacing: 0.4})
  r.w
end

// Draws a button and answers whether it was clicked. The inspector reads its
// clicks through hit1/hit2 instead, so the answer is dropped at those callsites.
fn btn(r: record, label: string, kind: num, on: bool) -> bool
  // kind: 0 = quiet, 1 = primary
  let hov = hovered(r)
  if kind == 1 then
    let bg = if hov then #829eff else ACCENT end
    draw_rect_rounded(r, radius: 8, c: bg)
    draw_text_center(label, cx: r.x + r.w / 2, y: r.y + (r.h - FS) / 2, size: FS, c: #10141a)
  else
    let bg = if hov then CARD_HI else CARD end
    rr(r, radius: 8, fill: bg, border: LINE)
    let fg = if on then TEXT else DIM end
    draw_text_center(label, cx: r.x + r.w / 2, y: r.y + (r.h - FS) / 2, size: FS, c: fg)
  end
  hov && mouse_pressed(0)
end

// ── sorting ─────────────────────────────────────────────────────────────────
fn sort_val(c: record, key: string)
  match key
    when "name" -> lower(c.name)
    when "company" -> lower(c.company)
    when "stage" -> stage_rank(c.stage)
    when "value" -> c.value
    when _ -> c.days
  end
end

fn row_less(a: record, b: record, key: string, dir: num) -> bool
  let av = sort_val(a, key)
  let bv = sort_val(b, key)
  if av == bv then
    lower(a.name) < lower(b.name)
  elsif dir == 1 then
    av < bv
  else
    av > bv
  end
end

fn sort_rows(rows: list, key: string, dir: num) -> list
  var out = []
  for r in rows do
    var placed = false
    var res = []
    for x in out do
      if !placed && row_less(r, x, key, dir) then
        set res = append(res, r)
        set placed = true
      end
      set res = append(res, x)
    end
    if !placed then set res = append(res, r) end
    set out = res
  end
  out
end

fn matches(c: record, needle: string) -> bool
  let hay = lower("{c.name} {c.company} {c.title} {c.email} {join(c.tags, " ")}")
  contains(hay, needle)
end

// ── derived data ────────────────────────────────────────────────────────────
let needle = lower(q)
let filtered = for c in contacts do
  if seg != "All" && c.stage != seg then continue end
  if len(needle) > 0 && !matches(c, needle) then continue end
  c
end
let rows = sort_rows(rows: filtered, key: sort_key, dir: sort_dir)
let n_rows = len(rows)

let pipeline = reduce(rows, 0, fn(acc, c) -> acc + c.value)

fn count_stage(cs: list, s: string) -> int
  var n = 0
  for c in cs do
    if s == "All" || c.stage == s then set n = n + 1 end
  end
  n
end

// index of the selected id within the current row order (-1 when filtered out)
fn index_of_id(rs: list, id: num) -> int
  var found = -1
  for i in range(0, len(rs)) do
    if rs[i].id == id then set found = i end
  end
  found
end
let sel_ix = index_of_id(rows, sel_id)
// A filter that hides the selected contact hands the selection to the first
// visible row rather than leaving the inspector blank.
if sel_ix < 0 && n_rows > 0 then
  sel_id = rows[0].id
  sel_ix = 0
end

// ── geometry ────────────────────────────────────────────────────────────────
let mx = mouse_x()
let my = mouse_y()

let search_r = rect(RAIL_W + 24, 14, 330, 32)

let cx0 = TABLE_X + 22
let inner = TABLE_W - 44 - 10
let w_name  = int(inner * 0.33)
let w_co    = int(inner * 0.23)
let w_stage = int(inner * 0.15)
let w_val   = int(inner * 0.13)
let w_last  = inner - w_name - w_co - w_stage - w_val

let cols = [
  {key: "name",    label: "CONTACT",      x: cx0,                                 w: w_name,  right: false},
  {key: "company", label: "COMPANY",      x: cx0 + w_name,                        w: w_co,    right: false},
  {key: "stage",   label: "STAGE",        x: cx0 + w_name + w_co,                 w: w_stage, right: false},
  {key: "value",   label: "DEAL",         x: cx0 + w_name + w_co + w_stage,       w: w_val,   right: true},
  {key: "days",    label: "LAST CONTACT", x: cx0 + w_name + w_co + w_stage + w_val, w: w_last, right: true},
]

let rows_rect = rect(TABLE_X, ROWS_TOP, TABLE_W, ROWS_H)

// One sortable column header's hit rect.
fn head_rect(c: record) -> Rect
  rect(c.x - 8, HEAD_Y, c.w, HEAD_H)
end

// ── input ───────────────────────────────────────────────────────────────────
// Focus ring: the search box on its own, or the five form fields while editing.
let ring = if editing then ["name", "title", "co", "email", "phone", "value"] else ["q"] end

// A press anywhere that is not a field clears the keyboard focus.
let grabbed = false

if mouse_pressed(0) && point_in(px: mx, py: my, r: search_r) then
  focus = "q"
  grabbed = true
end

// `/` jumps to the search box (only when nothing else owns the keyboard).
if len(focus) == 0 && key_pressed("/") then
  focus = "q"
  grabbed = true
end

// Column headers: click to sort, click again to flip the direction.
if mouse_pressed(0) then
  for c in cols do
    let hr = head_rect(c)
    if point_in(px: mx, py: my, r: hr) then
      if sort_key == c.key then
        sort_dir = -sort_dir
      else
        sort_key = c.key
        sort_dir = 1
      end
      scroll = 0
    end
  end
end

// Segment rail. Walked twice: once here for input, once below to draw it.
let seg_top = TOP_H + 54

fn seg_label(i: num) -> string
  if i == 0 then "All" else STAGES[i - 1] end
end

fn seg_rect(i: num) -> Rect
  rect(12, seg_top + i * 34, RAIL_W - 24, 30)
end

for i in range(0, len(STAGES) + 1) do
  let label = seg_label(i)
  let r = seg_rect(i)
  if mouse_pressed(0) && point_in(px: mx, py: my, r: r) then
    seg = label
    scroll = 0
    focus = ""
  end
end

// Row selection by click.
if mouse_pressed(0) && point_in(px: mx, py: my, r: rows_rect) then
  let ix = scroll + int((my - ROWS_TOP) / ROW_H)
  if ix >= 0 && ix < n_rows then
    sel_id = rows[ix].id
    editing = false
  end
  focus = ""
end

// Wheel over the table.
if point_in(px: mx, py: my, r: rows_rect) then
  scroll = clamp(int(scroll + scroll_y()), lo: 0, hi: max(0, n_rows - VISIBLE))
end

// Keyboard navigation — only when no text field owns the keyboard.
if len(focus) == 0 then
  if n_rows > 0 then
    var want = sel_ix
    if key_pressed("down") || key_pressed("j") then set want = want + 1 end
    if key_pressed("up") || key_pressed("k") then set want = want - 1 end
    if key_pressed("pagedown") then set want = want + VISIBLE end
    if key_pressed("pageup") then set want = want - VISIBLE end
    if key_pressed("home") then set want = 0 end
    if key_pressed("end") then set want = n_rows - 1 end
    if want != sel_ix then
      let w2 = int(clamp(want, lo: 0, hi: n_rows - 1))
      sel_id = rows[w2].id
      scroll = ensure_visible(scroll, selected: w2, visible_rows: VISIBLE)
    end
  end
end

// Clamp scroll after any filter change, and keep the selection on screen.
scroll = int(clamp(scroll, lo: 0, hi: max(0, n_rows - VISIBLE)))

// Tab cycles the focus ring.
if key_pressed("tab") && len(focus) > 0 then
  var j = 0
  for i in range(0, len(ring)) do
    if ring[i] == focus then set j = i end
  end
  let step = if mod_shift() then len(ring) - 1 else 1 end
  focus = ring[(j + step) % len(ring)]
  grabbed = true
end

let selected = if sel_ix >= 0 then rows[sel_ix] else nil end
let has_sel = sel_ix >= 0

// ── inspector controls ──────────────────────────────────────────────────────
let pad = 22
let dx = DETAIL_X + pad
let dw = DETAIL_W - pad * 2

let act_y = H - 62
let act1 = rect(dx, act_y, int((dw - 10) / 2), 34)
let act2 = rect(dx + int((dw - 10) / 2) + 10, act_y, dw - int((dw - 10) / 2) - 10, 34)

// Stage picker rects (edit mode) — five chips on two rows.
fn stage_pick_rect(i: num, x: num, y: num, w: num) -> Rect
  let cw = int((w - 8) / 3)
  rect(x + (i % 3) * (cw + 4), y + int(i / 3) * 30, cw, 26)
end

// Text field rects, laid out top-down in the form.
let form_top = TOP_H + 118
fn field_rect(i: num, x: num, y: num, w: num) -> Rect
  rect(x, y + i * 52 + 18, w, 32)
end

// ── field editing (state writes must live at top level) ─────────────────────
let typed = if grabbed then "" else text_input() end
let backsp = key_pressed("backspace")
let submitted = key_pressed("return")

fn edited(cur: string, typed: string, backsp: bool) -> string
  var t = cur
  if backsp && len(t) > 0 then set t = slice(t, start: 0, end: len(t) - 1) end
  if len(typed) > 0 then set t = t ++ typed end
  t
end

if focus == "q" then q = edited(q, typed, backsp) end
if focus == "name" then ed_name = edited(ed_name, typed, backsp) end
if focus == "title" then ed_title = edited(ed_title, typed, backsp) end
if focus == "co" then ed_co = edited(ed_co, typed, backsp) end
if focus == "email" then ed_email = edited(ed_email, typed, backsp) end
if focus == "phone" then ed_phone = edited(ed_phone, typed, backsp) end
if focus == "value" then ed_value = digits(edited(ed_value, typed, backsp)) end

if key_pressed("escape") then
  if len(focus) > 0 then
    focus = ""
  elsif editing then
    editing = false
  elsif len(q) > 0 then
    q = ""
  end
end

// Clicking a form field focuses it.
if editing && mouse_pressed(0) then
  for i in range(0, len(ring)) do
    if point_in(px: mx, py: my, r: field_rect(i, x: dx, y: form_top, w: dw)) then
      focus = ring[i]
      grabbed = true
    end
  end
end

// Stage chips in the form.
if editing && mouse_pressed(0) then
  for i in range(0, len(STAGES)) do
    if point_in(px: mx, py: my, r: stage_pick_rect(i, x: dx, y: form_top + 6 * 52 + 22, w: dw)) then
      ed_stage = STAGES[i]
    end
  end
end

// Action buttons: Edit / Advance in read mode, Save / Cancel in form mode.
let hit1 = has_sel && mouse_pressed(0) && point_in(px: mx, py: my, r: act1)
let hit2 = has_sel && mouse_pressed(0) && point_in(px: mx, py: my, r: act2)
let do_save = editing && (hit1 || (submitted && len(focus) > 0))

if has_sel && !editing && hit1 then
  editing = true
  ed_id = selected.id
  ed_name = selected.name
  ed_title = selected.title
  ed_co = selected.company
  ed_email = selected.email
  ed_phone = selected.phone
  ed_value = "{selected.value}"
  ed_stage = selected.stage
  focus = "name"
  grabbed = true
end

// Advance the deal one step along the pipeline. Customer is the end of the
// road and Churned is off it, so neither advances — the button draws dim there.
if has_sel && !editing && hit2 && stage_rank(selected.stage) < 3 then
  let nxt = stage_rank(selected.stage) + 1
  contacts = for c in contacts do
    if c.id == selected.id then {...c, stage: STAGES[nxt], days: 0} else c end
  end
end

if do_save then
  contacts = for c in contacts do
    if c.id == ed_id then
      {...c, name: ed_name, title: ed_title, company: ed_co, email: ed_email,
        phone: ed_phone, stage: ed_stage,
        value: if len(ed_value) > 0 then int(ed_value) else 0 end}
    else
      c
    end
  end
  editing = false
  focus = ""
  saves = saves + 1
end

if editing && hit2 then
  editing = false
  focus = ""
end

// ═════════════════════════════════════════════════════════════════════════════
// Draw
// ═════════════════════════════════════════════════════════════════════════════
clear(BG.r, BG.g, BG.b)

// ── left rail ───────────────────────────────────────────────────────────────
draw_rect(rect(0, 0, RAIL_W, H), RAIL)
draw_rect(rect(RAIL_W, 0, 1, H), LINE)

// brand
draw_rect_rounded(rect(24, 19, 22, 22), radius: 6, c: ACCENT)
draw_text("M", pos: {x: 31, y: 24}, style: {size: FS, color: #0f1319})
draw_text("meridian", pos: {x: 56, y: 21}, style: {size: FS_H, color: TEXT, spacing: 0.2})

draw_text("SEGMENTS", pos: {x: 24, y: TOP_H + 26}, style: {size: FS_MICRO, color: FAINT, spacing: 1.4})

for i in range(0, len(STAGES) + 1) do
  let label = seg_label(i)
  let r = seg_rect(i)
  let on = seg == label
  let hov = point_in(px: mx, py: my, r: r)
  if on then
    draw_rect_rounded(r, radius: 8, c: CARD_HI)
    draw_rect_rounded(rect(r.x, r.y + 6, 3, r.h - 12), radius: 2, c: ACCENT)
  elsif hov then
    draw_rect_rounded(r, radius: 8, c: CARD, a: 140)
  end
  let dot = if i == 0 then FAINT else stage_color(label) end
  draw_circle(center: {x: r.x + 18, y: r.y + 15}, radius: 3.5, c: dot)
  let fg = if on then TEXT else DIM end
  draw_text(label, pos: {x: r.x + 30, y: r.y + 8}, style: {size: FS, color: fg})
  let cnt = count_stage(contacts, label)
  draw_text_right("{cnt}", right_x: r.x + r.w - 12, y: r.y + 8, size: FS_SM, c: if on then DIM else FAINT end)
end

// pipeline card at the foot of the rail
let card_y = H - 130
rr(rect(12, card_y, RAIL_W - 24, 106), radius: 10, fill: CARD, border: LINE)
draw_text("OPEN PIPELINE", pos: {x: 26, y: card_y + 16}, style: {size: FS_MICRO, color: FAINT, spacing: 1.2})
draw_text(money_big(pipeline), pos: {x: 26, y: card_y + 34}, style: {size: FS_XL, color: TEXT})
draw_line({x: 26, y: card_y + 68}, {x: RAIL_W - 26, y: card_y + 68}, c: LINE)
draw_text("{n_rows} shown", pos: {x: 26, y: card_y + 78}, style: {size: FS_SM, color: DIM})
draw_text_right("of {len(contacts)}", right_x: RAIL_W - 26, y: card_y + 78, size: FS_SM, c: FAINT)

// ── top bar ─────────────────────────────────────────────────────────────────
draw_rect(rect(0, TOP_H, W, 1), LINE)

// search box
let q_focus = focus == "q"
rr(search_r, radius: 9, fill: if q_focus then #10141b else CARD end, border: if q_focus then ACCENT else LINE end)
draw_circle({x: search_r.x + 17, y: search_r.y + 14}, 5, FAINT, 0)
draw_circle(center: {x: search_r.x + 17, y: search_r.y + 14}, radius: 5.5, c: if q_focus then ACCENT else FAINT end)
draw_circle(center: {x: search_r.x + 17, y: search_r.y + 14}, radius: 3.6, c: if q_focus then #10141b else CARD end)
draw_line({x: search_r.x + 21, y: search_r.y + 18}, {x: search_r.x + 25, y: search_r.y + 22},
  c: if q_focus then ACCENT else FAINT end)
let qx = search_r.x + 34
if len(q) == 0 && !q_focus then
  draw_text("Search contacts, companies, tags…", pos: {x: qx, y: search_r.y + 9}, style: {size: FS, color: FAINT})
else
  draw_text(q, pos: {x: qx, y: search_r.y + 9}, style: {size: FS, color: TEXT})
end
if q_focus && int(time() * 2) % 2 == 0 then
  let cxp = qx + text_width(q, FS) + 1
  draw_line({x: cxp, y: search_r.y + 8}, {x: cxp, y: search_r.y + 24}, c: ACCENT)
end
if !q_focus then
  draw_text("/", pos: {x: search_r.x + search_r.w - 18, y: search_r.y + 9}, style: {size: FS_SM, color: FAINT})
end

let sort_label = if sort_key == "days" then "last contact"
elsif sort_key == "value" then "deal size"
else sort_key
end
let dir_label = if sort_dir == 1 then "ascending" else "descending" end
draw_text_right("sorted by {sort_label} · {dir_label}", right_x: TABLE_X + TABLE_W - 22, y: 22, size: FS_SM, c: FAINT)

// ── table header ────────────────────────────────────────────────────────────
for c in cols do
  let on = sort_key == c.key
  let hr = head_rect(c)
  if point_in(px: mx, py: my, r: hr) then
    draw_rect_rounded(hr, radius: 6, c: CARD, a: 120)
  end
  let fg = if on then ACCENT else FAINT end
  let st = {size: FS_MICRO, color: fg, spacing: 1.0}
  let lw = text_width(c.label, st)
  let lx = if c.right then c.x + c.w - lw - 4 else c.x end
  draw_text(c.label, pos: {x: lx, y: HEAD_Y + 8}, style: st)
  if on then
    let ax = if c.right then lx - 12 else lx + lw + 7 end
    let ay = HEAD_Y + 12
    if sort_dir == 1 then
      fill_triangle(x1: ax, y1: ay + 3, x2: ax + 7, y2: ay + 3, x3: ax + 3.5, y3: ay - 2, r: fg.r, g: fg.g, b: fg.b)
    else
      fill_triangle(x1: ax, y1: ay - 2, x2: ax + 7, y2: ay - 2, x3: ax + 3.5, y3: ay + 3, r: fg.r, g: fg.g, b: fg.b)
    end
  end
end
draw_rect(rect(TABLE_X, HEAD_Y + HEAD_H + 3, TABLE_W, 1), LINE)

// ── rows ────────────────────────────────────────────────────────────────────
clip(x: TABLE_X, y: ROWS_TOP, w: TABLE_W, h: ROWS_H)
let shown = min(VISIBLE, max(0, n_rows - scroll))
for i in range(0, shown) do
  let idx = scroll + i
  let c = rows[idx]
  let y = ROWS_TOP + i * ROW_H
  let r = rect(TABLE_X + 10, y + 2, TABLE_W - 20, ROW_H - 4)
  let on = c.id == sel_id
  let hov = point_in(px: mx, py: my, r: r)
  if on then
    draw_rect_rounded(r, radius: 8, c: CARD_HI)
    draw_rect_rounded(rect(TABLE_X + 10, y + 8, 3, ROW_H - 16), radius: 2, c: ACCENT)
  elsif hov then
    draw_rect_rounded(r, radius: 8, c: CARD, a: 150)
  end

  // avatar + name + title
  let acol = AV[c.id % len(AV)]
  let ax = cx0 + 14
  draw_circle({x: ax, y: y + ROW_H / 2}, 14, acol, 46)
  draw_text_center(initials(c.name), cx: ax, y: y + ROW_H / 2 - 6, size: FS_SM, c: acol)
  let nm_x = cx0 + 34
  let nm_w = w_name - 46
  draw_text(ellipsize(c.name, avail_px: nm_w, size: FS_ROW), pos: {x: nm_x, y: y + 8},
    style: {size: FS_ROW, color: if on then WHITE else TEXT end})
  draw_text(ellipsize(c.title, avail_px: nm_w, size: FS_SM), pos: {x: nm_x, y: y + 26}, style: {size: FS_SM, color: FAINT})

  // company + owner
  draw_text(ellipsize(c.company, avail_px: w_co - 16, size: FS), pos: {x: cols[1].x, y: y + 9}, style: {size: FS, color: DIM})
  draw_text(c.owner, pos: {x: cols[1].x, y: y + 27}, style: {size: FS_SM, color: FAINT})

  // stage chip
  chip(x: cols[2].x, y: y + 13, label: c.stage, c: stage_color(c.stage))

  // deal value
  draw_text_right(money(c.value), right_x: cols[3].x + cols[3].w - 4, y: y + 16, size: FS_ROW,
    c: if on then TEXT else DIM end)

  // last contact: a freshness dot and the phrase, on the row's centre line
  let fresh = freshness(c.days)
  let last_r = cols[4].x + cols[4].w - 4
  let last_s = ago(c.days)
  draw_text_right(last_s, right_x: last_r, y: y + 16, size: FS, c: fresh.color)
  draw_circle({x: last_r - text_width(last_s, FS) - 11, y: y + 23}, 3.5, fresh.color, 210)

  if !on && i < shown - 1 then
    draw_rect(rect(cx0, y + ROW_H - 1, TABLE_W - 54, 1), LINE_SOFT)
  end
end
clip_none()

if n_rows == 0 then
  draw_text("No contacts match this filter.", pos: {x: cx0, y: ROWS_TOP + 40}, style: {size: FS_ROW, color: DIM})
  draw_text("Clear the search with Escape, or pick a different segment.",
    pos: {x: cx0, y: ROWS_TOP + 64}, style: {size: FS, color: FAINT})
end

// scrollbar
if n_rows > VISIBLE then
  let track = rect(TABLE_X + TABLE_W - 13, ROWS_TOP + 2, 6, ROWS_H - 6)
  draw_rect_rounded(track, radius: 3, c: LINE)
  let th = max(28, int(track.h * VISIBLE / n_rows))
  let ty = track.y + int((track.h - th) * scroll / max(1, n_rows - VISIBLE))
  draw_rect_rounded(rect(track.x, ty, track.w, th), radius: 3, c: #4c5768)
end

// ── footer ──────────────────────────────────────────────────────────────────
draw_rect(rect(TABLE_X, H - FOOT_H, TABLE_W, 1), LINE)
let foot = if n_rows == 0 then "no results" else "{n_rows} contacts · {money_big(pipeline)} in view" end
draw_text(foot, pos: {x: cx0, y: H - 26}, style: {size: FS_SM, color: FAINT})
draw_text_right("click a header to sort  ·  ↑↓ select  ·  / search", right_x: TABLE_X + TABLE_W - 22, y: H - 26,
  size: FS_SM, c: FAINT)

// ── inspector ───────────────────────────────────────────────────────────────
draw_rect(rect(DETAIL_X, 0, DETAIL_W, H), SURFACE)
draw_rect(rect(DETAIL_X, 0, 1, H), LINE)

if !has_sel then
  draw_text("Nothing selected", pos: {x: dx, y: TOP_H + 40}, style: {size: FS_ROW, color: DIM})
  draw_text("Pick a row to see the full record.", pos: {x: dx, y: TOP_H + 64}, style: {size: FS, color: FAINT})
else
  let acol = AV[selected.id % len(AV)]
  let hy = TOP_H + 30
  draw_circle({x: dx + 26, y: hy + 26}, 26, acol, 40)
  draw_text_center(initials(selected.name), cx: dx + 26, y: hy + 17, size: FS_H, c: acol)

  if editing then
    draw_text("EDIT RECORD", pos: {x: dx + 66, y: hy + 12}, style: {size: FS_MICRO, color: ACCENT, spacing: 1.4})
    draw_text(ellipsize(ed_name, avail_px: dw - 70, size: FS_H), pos: {x: dx + 66, y: hy + 28}, style: {size: FS_H, color: TEXT})

    let labels = ["FULL NAME", "TITLE", "COMPANY", "EMAIL", "PHONE", "DEAL VALUE (USD)"]
    let vals = [ed_name, ed_title, ed_co, ed_email, ed_phone, ed_value]
    for i in range(0, 6) do
      let fr = field_rect(i, x: dx, y: form_top, w: dw)
      let f_on = focus == ring[i]
      draw_text(labels[i], pos: {x: dx, y: fr.y - 15}, style: {size: FS_MICRO, color: FAINT, spacing: 1.2})
      rr(fr, radius: 8, fill: if f_on then #10141b else CARD end, border: if f_on then ACCENT else LINE end)
      draw_text(ellipsize(vals[i], avail_px: dw - 22, size: FS), pos: {x: fr.x + 10, y: fr.y + 9}, style: {size: FS, color: TEXT})
      if f_on && int(time() * 2) % 2 == 0 then
        let cxp = fr.x + 10 + text_width(vals[i], FS) + 1
        draw_line({x: cxp, y: fr.y + 8}, {x: cxp, y: fr.y + 24}, c: ACCENT)
      end
    end

    let sy = form_top + 6 * 52 + 22
    draw_text("STAGE", pos: {x: dx, y: sy - 15}, style: {size: FS_MICRO, color: FAINT, spacing: 1.2})
    for i in range(0, len(STAGES)) do
      let pr = stage_pick_rect(i, x: dx, y: sy, w: dw)
      let s = STAGES[i]
      let sc = stage_color(s)
      let on = ed_stage == s
      if on then
        draw_rect_rounded(pr, radius: 7, c: sc, a: 52)
        draw_rect_rounded(rect(pr.x, pr.y, pr.w, pr.h), radius: 7, c: sc, a: 52)
      elsif hovered(pr) then
        draw_rect_rounded(pr, radius: 7, c: CARD_HI)
      else
        draw_rect_rounded(pr, radius: 7, c: CARD)
      end
      draw_text_center(s, cx: pr.x + pr.w / 2, y: pr.y + 7, size: FS_SM, c: if on then sc else DIM end)
    end

    // Everything the form does not own, shown so the record still reads whole.
    let ry2 = sy + 78
    draw_line({x: dx, y: ry2 - 16}, {x: dx + dw, y: ry2 - 16}, c: LINE)
    draw_text("NOT EDITABLE HERE", pos: {x: dx, y: ry2}, style: {size: FS_MICRO, color: FAINT, spacing: 1.2})
    draw_text("Owner", pos: {x: dx, y: ry2 + 20}, style: {size: FS, color: FAINT})
    draw_text_right(selected.owner, right_x: dx + dw, y: ry2 + 20, size: FS, c: DIM)
    draw_text("Last contact", pos: {x: dx, y: ry2 + 42}, style: {size: FS, color: FAINT})
    draw_text_right(ago(selected.days), right_x: dx + dw, y: ry2 + 42, size: FS, c: DIM)
    draw_text("Tags", pos: {x: dx, y: ry2 + 64}, style: {size: FS, color: FAINT})
    draw_text_right(join(selected.tags, " · "), right_x: dx + dw, y: ry2 + 64, size: FS, c: DIM)

    draw_text("Tab moves between fields · Return saves", pos: {x: dx, y: act_y - 26},
      style: {size: FS_SM, color: FAINT})
    btn(act1, label: "Save changes", kind: 1, on: true)
    btn(act2, label: "Cancel", kind: 0, on: false)
  else
    draw_text(ellipsize(selected.name, avail_px: dw - 70, size: FS_XL), pos: {x: dx + 66, y: hy + 6},
      style: {size: FS_XL, color: TEXT})
    draw_text(ellipsize(selected.title, avail_px: dw - 70, size: FS), pos: {x: dx + 66, y: hy + 34},
      style: {size: FS, color: DIM})
    chip(x: dx + 66, y: hy + 56, label: selected.stage, c: stage_color(selected.stage))

    let by = hy + 96
    draw_line({x: dx, y: by - 12}, {x: dx + dw, y: by - 12}, c: LINE)

    fn detail_row(x: num, y: num, w: num, label: string, value: string, color: record)
      draw_text(label, pos: {x: x, y: y}, style: {size: FS_MICRO, color: FAINT, spacing: 1.2})
      draw_text(ellipsize(value, avail_px: w, size: FS), pos: {x: x, y: y + 16}, style: {size: FS, color: color})
    end

    detail_row(x: dx, y: by, w: dw, label: "COMPANY", value: selected.company, color: TEXT)
    detail_row(x: dx, y: by + 46, w: dw, label: "EMAIL", value: selected.email, color: ACCENT)
    detail_row(x: dx, y: by + 92, w: (dw / 2) - 8, label: "PHONE", value: selected.phone, color: TEXT)
    detail_row(x: dx + (dw / 2) + 8, y: by + 92, w: (dw / 2) - 8, label: "OWNER", value: selected.owner, color: TEXT)
    detail_row(x: dx, y: by + 138, w: (dw / 2) - 8, label: "DEAL VALUE", value: money(selected.value), color: TEAL)
    detail_row(x: dx + (dw / 2) + 8, y: by + 138, w: (dw / 2) - 8, label: "LAST CONTACT",
      value: ago(selected.days), color: if selected.days > 30 then AMBER else TEXT end)

    let ty2 = by + 188
    draw_text("TAGS", pos: {x: dx, y: ty2}, style: {size: FS_MICRO, color: FAINT, spacing: 1.2})
    var tagx = dx
    for t in selected.tags do
      let adv = chip(x: tagx, y: ty2 + 16, label: t, c: DIM)
      set tagx = tagx + adv + 6
    end

    let ny = ty2 + 54
    draw_text("NOTES", pos: {x: dx, y: ny}, style: {size: FS_MICRO, color: FAINT, spacing: 1.2})
    let lines = preview(selected.notes, max_chars: dw / 7, max_lines: 5).lines
    for i in range(0, len(lines)) do
      draw_text(lines[i], pos: {x: dx, y: ny + 18 + i * 19}, style: {size: FS, color: DIM})
    end

    // Activity timeline — synthesized from the record so every contact has a
    // plausible history behind it.
    let ay2 = ny + 132
    draw_line({x: dx, y: ay2 - 16}, {x: dx + dw, y: ay2 - 16}, c: LINE)
    draw_text("ACTIVITY", pos: {x: dx, y: ay2}, style: {size: FS_MICRO, color: FAINT, spacing: 1.2})
    let acts = activity(selected)
    for i in range(0, len(acts)) do
      let a = acts[i]
      let ry = ay2 + 24 + i * 34
      if i < len(acts) - 1 then
        draw_line({x: dx + 4, y: ry + 10}, {x: dx + 4, y: ry + 34}, c: LINE)
      end
      let dotc = if i == 0 then stage_color(selected.stage) else FAINT end
      draw_circle({x: dx + 4, y: ry + 5}, 4, dotc, if i == 0 then 255 else 150 end)
      draw_text(ellipsize(a.label, avail_px: dw - 90, size: FS), pos: {x: dx + 18, y: ry}, style: {size: FS, color: TEXT})
      draw_text_right(ago(a.ago_days), right_x: dx + dw, y: ry + 1, size: FS_SM, c: FAINT)
    end

    btn(act1, label: "Edit record", kind: 1, on: true)
    let last_stage = selected.stage == "Customer" || selected.stage == "Churned"
    btn(act2, label: "Advance stage", kind: 0, on: !last_stage)
  end
end

// ── observable summary (read from /state → panes[].panel.values) ────────────
let visible_rows = n_rows
let selection = if has_sel then selected.name else "" end
let focus_id = focus
