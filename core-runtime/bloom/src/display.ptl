// bloom/display — the components that show rather than take input: badges
// and pills, cards, the empty state, the keyboard-hint bar, section labels,
// the scrollbar, the load view and the text spinner.
//
// These were `ui`'s (core-libs/petal-ui/prelude/widgets.ptl) until bloom
// took over the widgets. The calls and the return values are the same, so a
// port is a change of qualifier; the look is bloom's (labels placed by
// text-layout, theme tokens, eased hover), and each `opts` record still takes
// the keys the `ui` style record did.

import bloom/theme: theme, ts, tone, hair, stroke, rate
import bloom/motion: ease_to, ease_flag
import bloom/interact: probe
import bloom/button: spinner
import text_layout: draw_text_line
import ui

// ── Badge and pill ─────────────────────────────────────────────────────────

// A small rounded label chip at (x, y). Returns the rect it drew, so a row of
// them can flow. `opts`: {size, bg, fg, gradient, gradient_angle} —
// `gradient: [c0, c1]` fills the chip with a ramp instead of a flat colour.
pub fn badge(x: num, y: num, text: string) -> record
  _badge(x, y, text, {})
end

pub fn badge(x: num, y: num, text: string, opts: record) -> record
  _badge(x, y, text, opts)
end

// `badge`, `pill` and the other names below are also `ui`'s, which this module
// imports plainly. Inside one variant's own body the short form would escape
// to `ui`'s set, so both forms go through a private implementation (see
// bloom/button's `button_impl`).
fn _badge(x: num, y: num, text: string, opts: record) -> record
  let t = theme()
  let size = field(opts, "size", t.font_sm)
  let style = ts(t, size, field(opts, "fg", t.muted))
  let r = _chip_rect(x, y, text, style, size)
  let grad = field(opts, "gradient", [])
  if len(grad) < 2 then
    draw_rect_rounded(r, int(r.h / 2), field(opts, "bg", tone(t, t.panel, 0.18)))
  else
    linear_gradient(r, grad, field(opts, "gradient_angle", GRAD_DOWN), int(r.h / 2))
  end
  draw_text_line(text, Rect(r.x + 7, r.y, r.w - 14, r.h), style, "center")
  r
end

// The coloured badge: `color` tints the fill and the text — the status-chip
// look (pass t.success / t.warn / t.danger / t.accent). Returns its rect.
// `opts`: {size, on} — `on` is the surface the pill sits on, which the tint is
// flattened against, so two overlapping pills still read as one wash.
pub fn pill(x: num, y: num, text: string, color: record) -> record
  _pill(x, y, text, color, {})
end

pub fn pill(x: num, y: num, text: string, color: record, opts: record) -> record
  _pill(x, y, text, color, opts)
end

fn _pill(x: num, y: num, text: string, color: record, opts: record) -> record
  let t = theme()
  let size = field(opts, "size", t.font_sm)
  let style = ts(t, size, color)
  let r = _chip_rect(x, y, text, style, size)
  draw_rect_rounded(r, int(r.h / 2), over(field(opts, "on", t.panel), color, 42))
  draw_text_line(text, Rect(r.x + 7, r.y, r.w - 14, r.h), style, "center")
  r
end

// A chip is as wide as its label plus padding, so the width it reserves comes
// from the style the label is drawn in.
fn _chip_rect(x: num, y: num, text: string, style: record, size: num) -> record
  rect(x, y, text_width(text, style) + 14, size + 8)
end

// ── Card ───────────────────────────────────────────────────────────────────

// A raised surface: a soft shadow, a face and a hairline. Returns the padded
// content rect. `opts`: {radius, pad, bg, outline, shadow, elevation} —
// `shadow: false` skips the shadow, `elevation` picks a step of the theme's
// elevation scale (1 by default).
pub fn card(r: record) -> record
  _card(r, {})
end

pub fn card(r: record, opts: record) -> record
  _card(r, opts)
end

fn _card(r: record, opts: record) -> record
  let t = theme()
  let radius = field(opts, "radius", t.radius)
  if field(opts, "shadow", true) then
    draw_elevation(r, radius, field(opts, "elevation", 1))
  end
  draw_rect_rounded(r, radius, field(opts, "bg", t.panel))
  stroke(t, r, radius, field(opts, "outline", hair(t)))
  pad(r, field(opts, "pad", t.space_lg))
end

// ── Empty state ────────────────────────────────────────────────────────────

// Centred "nothing here" copy for an empty region: a dim title and, when
// `hint` is not "", a dimmer line under it. `opts`: {size, fg}.
pub fn empty_state(r: record, title: string, hint: string)
  _empty_state(r, title, hint, {})
end

pub fn empty_state(r: record, title: string, hint: string, opts: record)
  _empty_state(r, title, hint, opts)
end

fn _empty_state(r: record, title: string, hint: string, opts: record)
  let t = theme()
  let size = field(opts, "size", t.font_lg)
  let title_ts = ts(t, size, field(opts, "fg", t.dim))
  let hint_ts = ts(t, t.font_sm, mix(t.dim, t.bg, 0.35))
  let cy = r.y + r.h / 2.0
  if len(hint) > 0 then
    // The pair is centred as a block: the title's line above the middle, the
    // hint's below, with a small gap between.
    draw_text_line(title, Rect(r.x, cy - size * 1.3, r.w, size * 1.3), title_ts, "center")
    draw_text_line(hint, Rect(r.x, cy + 4.0, r.w, t.font_sm * 1.4), hint_ts, "center")
  else
    draw_text_line(title, r, title_ts, "center")
  end
end

// ── Hint bar ───────────────────────────────────────────────────────────────

// One entry of a hint bar: the key-cap text and what it does.
pub fn hint(key: string, label: string) -> record
  {key: key, label: label}
end

// The keyboard-hint bar a full-pane app draws along its bottom edge: key caps
// in small rounded boxes, labels dim beside them.
//
//   hint_bar(bottom, [hint("j/k", "move"), hint("enter", "open")])
//
// `opts`: {bg, rule, size, fg, cap, cap_fg}.
pub fn hint_bar(r: record, hints: list)
  _hint_bar(r, hints, {})
end

pub fn hint_bar(r: record, hints: list, opts: record)
  _hint_bar(r, hints, opts)
end

fn _hint_bar(r: record, hints: list, opts: record)
  let t = theme()
  draw_rect(r, field(opts, "bg", t.panel))
  draw_line({x: r.x, y: r.y}, {x: r.x + r.w, y: r.y}, field(opts, "rule", hair(t)))
  let size = field(opts, "size", t.font_sm)
  let cap_ts = ts(t, size, field(opts, "cap_fg", t.muted))
  let label_ts = ts(t, size, field(opts, "fg", t.dim))
  let x = r.x + 10
  for hn in hints do
    let kw = text_width(hn.key, cap_ts) + 10
    let kh = size + 6
    let kr = Rect(x, r.y + (r.h - kh) / 2.0, kw, kh)
    draw_rect_rounded(kr, t.radius_sm, field(opts, "cap", tone(t, t.panel, 0.18)))
    draw_text_line(hn.key, kr, cap_ts, "center")
    x = x + kw + 6
    // The next cap flows after this label, so the advance is the drawn width.
    let lw = draw_text_line(hn.label, Rect(x, r.y, text_width(hn.label, label_ts) + 1, r.h),
      label_ts, "left")
    x = x + lw + 16
  end
end

// ── Section label ──────────────────────────────────────────────────────────

// A section heading that shows which region owns the keyboard: accent with an
// underline (grown from the left) when `active`, dim otherwise. `(x, y)` is
// the top-left of the run. Pass `has_focus(id)` as `active`. Returns the
// run's width. `opts`: {active, inactive, size}.
pub fn section_label(label: string, x: num, y: num, active: bool) -> num
  _section_label(label, x, y, active, {})
end

pub fn section_label(label: string, x: num, y: num, active: bool, opts: record) -> num
  _section_label(label, x, y, active, opts)
end

fn _section_label(label: string, x: num, y: num, active: bool, opts: record) -> num
  let t = theme()
  let size = field(opts, "size", t.font_md)
  let k = ease_flag(active, rate(t, 18.0))
  let color = mix(field(opts, "inactive", t.dim), field(opts, "active", t.accent), k)
  let style = ts(t, size, color)
  let w = text_width(label, style)
  draw_text(label, {x: x, y: y}, style)
  if k > 0.01 then
    let uy = y + size + 1
    draw_line({x: x, y: uy}, {x: x + w * k, y: uy}, color)
  end
  w
end

// ── Scrollbar ──────────────────────────────────────────────────────────────

// A proportional thumb along the right edge of scroll region `r`: `count`
// rows in all, `rows` visible, `scroll` the top offset (as `list_update` /
// `scroll_update` keep it). Draws nothing when the content fits. The thumb
// brightens while the pointer is over the region. `opts`: {track, thumb,
// width}.
pub fn scrollbar(r: record, count: num, rows: num, scroll: num)
  scrollbar(r, count, rows, scroll, {})
end

pub fn scrollbar(r: record, count: num, rows: num, scroll: num, opts: record)
  let t = theme()
  let near = ease_flag(count > rows && probe(r).hover, rate(t, 14.0))
  if count > rows then
    let bar_w = field(opts, "width", 4)
    let track = Rect(r.x + r.w - bar_w, r.y, bar_w, r.h)
    draw_rect_rounded(track, int(bar_w / 2), field(opts, "track", tone(t, t.panel, 0.08)))
    let thumb_h = max(12.0, float(r.h) * rows / count)
    let at = clamp(scroll / float(count - rows), 0.0, 1.0)
    let thumb = Rect(track.x, track.y + (float(r.h) - thumb_h) * at, bar_w, thumb_h)
    let base = field(opts, "thumb", t.dim)
    draw_rect_rounded(thumb, int(bar_w / 2), mix(base, t.text, 0.35 * near))
  end
end

// ── Load view ──────────────────────────────────────────────────────────────

// The non-ready states of a `ui` load state (`load_state` / `load_poll`):
// a spinner while loading, the error while failed, a hint while idle. Returns
// true when the value is ready and the caller should draw it instead.
//
//   state ls = load_state()
//   ls = load_poll(ls, key, query("diff", sha))
//   if bloom.load_view(content, ls) then
//     ...draw ls.value...
//   end
//
// `opts`: {radius, error_title, idle_title}.
pub fn load_view(r: record, ls: record) -> bool
  load_view(r, ls, {})
end

pub fn load_view(r: record, ls: record, opts: record) -> bool
  if load_ready(ls) then
    true
  else
    let t = theme()
    if load_failed(ls) then
      _empty_state(r, field(opts, "error_title", "Something went wrong"), str(ls.error),
        {fg: t.danger})
    elsif load_loading(ls) then
      spinner(r.x + r.w / 2.0, r.y + r.h / 2.0, field(opts, "radius", 10), t.accent)
    else
      _empty_state(r, field(opts, "idle_title", "Nothing loaded"), "", {})
    end
    false
  end
end

// ── Text spinner ───────────────────────────────────────────────────────────

// The one-character spinner for a line of text: | / - \ cycling on the frame
// clock. Draw it in the line's own style.
pub fn spinner_glyph() -> string
  let glyphs = ["|", "/", "-", "\\"]
  glyphs[(frame_count() / 6) % 4]
end
