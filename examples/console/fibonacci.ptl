// Fibonacci Sequence
// Two approaches to computing Fibonacci numbers.

// Recursive (simple but slow for large n)
fn fib_recursive(n: num) -> int
  if n <= 0 then 0
  elsif n == 1 then 1
  else fib_recursive(n - 1) + fib_recursive(n - 2)
  end
end

// Iterative (fast)
fn fib_iterative(n: num) -> int
  if n <= 0 then return 0 end
  if n == 1 then return 1 end
  let a = 0
  let b = 1
  for _ in range(2, n + 1) do
    let temp = b
    b = a + b
    a = temp
  end
  b
end

print("Fibonacci - Recursive")
print("=====================")
for i in range(0, 12) do
  print("fib({i}) = {fib_recursive(i)}")
end

print("")
print("Fibonacci - Iterative")
print("=====================")
for i in range(0, 20) do
  print("fib({i}) = {fib_iterative(i)}")
end

// `petal test examples/console/fibonacci.ptl` runs these; the prints above
// are the file's top level, which runs first and is not part of any test.
test "the two definitions agree" do
  for i in range(0, 20) do
    expect_eq(fib_recursive(i), fib_iterative(i), "at n = {i}")
  end
end

test "known values" do
  expect_eq(fib_iterative(10), 55)
  expect_eq(fib_iterative(50), 12586269025)
  expect_eq(fib_iterative(-3), 0)
end
