pub fn seed_messages() -> list
  let out = []
  for i in range(0, len(SEED)) do
    out = append(out, {...SEED[i], id: i + 1})
  end
  out
end

// What has been read when the app opens: everything except the newest
// message in #general and in #design.
pub fn seed_seen(msgs: list) -> record
  let seen = {}
  for c in CHANNELS do
    let n = count(msgs, fn(x) -> x.ch == c.id)
    let unread = if c.id == "general" || c.id == "design" then 1 else 0 end
    seen = {...seen, [c.id]: n - unread}
  end
  seen
end

// ── The afternoon's script ───────────────────────────────────────────────
// `at` is seconds after 2:32 PM. Each line is announced by its author typing
// for `typing` seconds first. `thread` names the seeded message (by its text
// prefix) a thread reply goes under.

fn ev(at: num, ch: string, who: string, typing: num, text: string) -> record
  {at: at, ch: ch, who: who, typing: typing, text: text, thread: ""}
end

