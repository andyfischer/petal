# Package `core` — Hypothetical calls (core/src/backend/bytecode/vm/speculate.rs,
# docs/features/speculate.md).
#
# `speculate(f, ...args)` calls `f(...args)` "as if": its `state` writes and
# `set`s are put back when it returns, a native whose effect escapes the run
# is not called, what it emits is handed back instead of reaching the host,
# and random draws do not advance the live stream. It returns
# `{value, emits, places}`. `speculating()` is true inside one;
# `speculate_place(key, value)` records `{key, value}` into its `places` and
# returns `value` (outside one it only returns `value`).
# `speculate_value(f, ...args)` is `speculate(f, ...args).value` without
# building the record: for a caller that wants only the value.
#
# Native interface declarations: each `native fn` binds a name to the host
# native of the same name and gives the checker its parameter names, arity
# and types. See docs/usage/ffi.md (Native interfaces).

pub native fn speculate(f: function, ...args) -> record
pub native fn speculating() -> bool
pub native fn speculate_place(key, value)
pub native fn speculate_value(f: function, ...args)
