@module_doc("""
Pending values: inspecting a value that has not arrived yet.

A host can hand a script a value that has not arrived yet: an image still
loading, a query in flight. Such a value is *pending*. `??` falls through a
pending value as it does through `nil`. These inspect one; all are global.
How a pending value moves through arithmetic, lists, `state` and draw calls
is in [features/pending-values.md](features/pending-values.md).
""")

# Package `core`, module `pending`: the inspectors, and the test-only
# resource natives (core/src/builtins/pending.rs).
#
# Native interface declarations: each `native fn` binds a name to the host
# native of the same name and gives the checker its parameter names, arity
# and types. Several declarations of one name are that native's call forms.
# See docs/usage/ffi.md (Native interfaces).

@doc("Test-only: `__pending(key)`, the resource named `key`: its value once resolved, a pending value until then.", hidden: true)
pub native fn __pending(...args)

@doc("Test-only: `__resolve(key, value)` lands the resource named `key` with `value`.", hidden: true)
pub native fn __resolve(...args)

@doc("Test-only: `__reject(key, error)` fails the resource named `key`.", hidden: true)
pub native fn __reject(...args)

@doc("""
True when the value is pending and still loading. False for a value that is
not pending.
""",
  see: ["is_error", "is_pending"])
pub native fn is_loading(value) -> bool

@doc("""
True when the value is pending and failed. False for a value that is not
pending.
""",
  see: ["error_of", "is_loading", "is_pending"])
pub native fn is_error(value) -> bool

@doc("""
True when the value is pending at all, loading or errored.
""",
  example: """
    is_pending(1)   # false
  """,
  see: ["is_ready", "is_loading", "is_error"])
pub native fn is_pending(value) -> bool

@doc("""
The negation of `is_pending`: true for any usable value.
""",
  example: """
    is_ready(1)     # true
  """,
  see: ["is_pending"])
pub native fn is_ready(value) -> bool

@doc("""
The error a failed pending value holds, or `nil` for anything else.
""",
  see: ["is_error"])
pub native fn error_of(value)

@doc("""
`fallback` when `value` is pending (loading or errored), otherwise `value`.
Both arguments are evaluated before the call; `value ?? fallback` evaluates
its right side only when needed.
""",
  see: ["is_pending"])
pub native fn or_else(value, fallback)

@doc("""
The cache key of a pending value's resource as an int, or `nil` for a value
that is not pending. Two pending values for the same resource have the same
key.
""")
pub native fn resource_key(value)
