// ─────────────────────────────────────────────────────────────────────────────
// LEDGER — a personal finance dashboard with drill-down
//
// A Garden panel app. Four KPI tiles, a donut of spending by category, a
// twelve-month column chart, a cumulative line chart and a transaction table —
// all scoped to the same drill path. Click a donut slice (or a legend row, or
// a table row) to descend: all spending → a category → a merchant. Escape
// climbs back out; the breadcrumb jumps straight to a level.
//
//   Run:  garden --headless --debug-port 0 --init layout.ptl
//   Keys: up/down pick a slice   enter/right drill in   esc/left drill out
//         n / p  step the month filter    a  clear it    t  re-sort the table
// ─────────────────────────────────────────────────────────────────────────────

// ── Palette ──────────────────────────────────────────────────────────────────
// One near-black ground, two surface steps, a hairline that separates cards
// without boxing them in, and eight categorical hues for the breakdown.

let BG       = #0c0e13
let SURFACE  = #14171e
let RAISED   = #1a1e27
let HAIRLINE = #262c38
let GRID     = #1e232d
let TEXT     = #e8edf5
let DIM      = #8b95a6
let FAINT    = #59616f
let POS      = #58cf99
let NEG      = #ef7d8e
let ACCENT   = #6ea8ff
let AMBER    = #f2b661
let STEEL    = #7e93b8
let WHITE    = #ffffff

// Spacing scale — every gap in the layout is one of these.
let S1 = 6
let S2 = 12
let S3 = 18
let S4 = 24

// Five text sizes, and no more: the host rasterizes one glyph per
// (character, size) into a fixed atlas, and a page spread over many sizes
// overflows it.
let T_MICRO = 10
let T_SMALL = 12
let T_BODY  = 14
let T_HEAD  = 18
let T_HERO  = 26

// ── Text helpers ─────────────────────────────────────────────────────────────

fn text_w(s, st)
  text_width(s, st)
end

fn text_at(s, x, y, st)
  draw_text(s, {x: x, y: y}, st)
end

fn text_right(s, right_x, y, st)
  draw_text(s, {x: right_x - text_w(s, st), y: y}, st)
end

// The prelude's `ellipsize` measures with a bare font size, which under-counts
// a style carrying `spacing` — this one measures the exact record it draws.
fn fit_style(s, avail, st)
  if text_width(s, st) <= avail then
    return s
  end
  let out = s
  while len(out) > 0 && text_width(out ++ "...", st) > avail do
    out = slice(out, 0, len(out) - 1)
  end
  out ++ "..."
end

fn text_mid(s, cx, y, st)
  draw_text(s, {x: cx - text_w(s, st) / 2.0, y: y}, st)
end

// ── Numbers ──────────────────────────────────────────────────────────────────

fn commas(n)
  let s = str(n)
  let out = ""
  let c = 0
  let i = len(s) - 1
  while i >= 0 do
    out = slice(s, i, i + 1) ++ out
    c = c + 1
    if c % 3 == 0 && i > 0 then
      out = "," ++ out
    end
    i = i - 1
  end
  out
end

// Fixed-point without a printf: scale, round, split the integer back apart.
// str(float) would hand us 12.300000000000001.
fn dec(x, places)
  let mul = 1
  for i in range(0, places) do
    mul = mul * 10
  end
  let neg = x < 0.0
  let scaled = int(round(abs(x) * float(mul)))
  let whole = scaled / mul
  let frac = scaled % mul
  let s = commas(whole)
  if places > 0 then
    let fs = str(frac)
    while len(fs) < places do
      fs = "0" ++ fs
    end
    s = s ++ "." ++ fs
  end
  if neg then "-" ++ s else s end
end

fn money(v)
  if v < 0.0 then
    "-$" ++ commas(int(round(abs(v))))
  else
    "$" ++ commas(int(round(v)))
  end
end

fn money_cents(v)
  "$" ++ dec(v, 2)
end

// One format per axis: a $250 step stays in dollars, a $10,000 step goes to k.
// Mixing them inside a single axis ("$750" above "$1.0k") reads as a mistake.
fn axis_label(v, step)
  if abs(v) < 0.5 then
    "$0"
  elsif step >= 1000.0 then
    "$" ++ dec(v / 1000.0, 1) ++ "k"
  else
    "$" ++ commas(int(round(v)))
  end
end

fn pct(v)
  dec(v, 1) ++ "%"
end

// ── Deterministic pseudo-random ──────────────────────────────────────────────
// Seeded, so the ledger holds the same numbers across every launch and every
// hot reload. A dashboard that reshuffles on reload cannot be read.

fn hashi(n)
  let x = (n * 374761393 + 668265263) % 2147483647
  x = (x + 2147483647) % 2147483647
  (x * 1103515245 + 12345) % 2147483647
end

// Hashed twice: a single LCG pass over an arithmetic seed walk (which is what
// the generator below produces) comes back as an arithmetic sequence mod 1, and
// every "does this merchant bill this month?" coin flip lands the same way.
fn rand01(n)
  float(hashi(hashi(n) % 65521) % 100000) / 100000.0
end

// ── Calendar ─────────────────────────────────────────────────────────────────

let MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
let MDAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
let YEAR = "2025"

// ── The chart of accounts ────────────────────────────────────────────────────
// `avg` is a typical charge, `freq` the expected number of charges a month
// (fractional means "only some months"), `jit` the spread around `avg`.

let CATS = [
  {name: "Housing", color: #6ea8ff, merchants: [
