// Benchmark: `match` dispatch — a 40-arm match on a string literal, on an
// int literal and on an enum variant, 1,000,000 matches of each.
//
// With the optimizer on, each match is entered through a jump table: one
// hash of the subject. With it off (`--no-opt`), the arms are tested one
// after another, so the two timings are the table against the chain.
// `tools/bench-opts.ts` reports both.

enum Variant
  v00,
  v01,
  v02,
  v03,
  v04,
  v05,
  v06,
  v07,
  v08,
  v09,
  v10,
  v11,
  v12,
  v13,
  v14,
  v15,
  v16,
  v17,
  v18,
  v19,
  v20,
  v21,
  v22,
  v23,
  v24,
  v25,
  v26,
  v27,
  v28,
  v29,
  v30,
  v31,
  v32,
  v33,
  v34,
  v35,
  v36,
  v37,
  v38,
  v39,
end

let STRINGS = [
  "cmd_00_a", "cmd_01_b", "cmd_02_c", "cmd_03_d", "cmd_04_e",
  "cmd_05_f", "cmd_06_g", "cmd_07_h", "cmd_08_i", "cmd_09_j",
  "cmd_10_a", "cmd_11_b", "cmd_12_c", "cmd_13_d", "cmd_14_e",
  "cmd_15_f", "cmd_16_g", "cmd_17_h", "cmd_18_i", "cmd_19_j",
  "cmd_20_a", "cmd_21_b", "cmd_22_c", "cmd_23_d", "cmd_24_e",
  "cmd_25_f", "cmd_26_g", "cmd_27_h", "cmd_28_i", "cmd_29_j",
  "cmd_30_a", "cmd_31_b", "cmd_32_c", "cmd_33_d", "cmd_34_e",
  "cmd_35_f", "cmd_36_g", "cmd_37_h", "cmd_38_i", "cmd_39_j",
]
let VARIANTS = Variant.all

fn by_string(k)
  match k
    when "cmd_00_a" -> 0
    when "cmd_01_b" -> 1
    when "cmd_02_c" -> 2
    when "cmd_03_d" -> 3
    when "cmd_04_e" -> 4
    when "cmd_05_f" -> 5
    when "cmd_06_g" -> 6
    when "cmd_07_h" -> 7
    when "cmd_08_i" -> 8
    when "cmd_09_j" -> 9
    when "cmd_10_a" -> 10
    when "cmd_11_b" -> 11
    when "cmd_12_c" -> 12
    when "cmd_13_d" -> 13
    when "cmd_14_e" -> 14
    when "cmd_15_f" -> 15
    when "cmd_16_g" -> 16
    when "cmd_17_h" -> 17
    when "cmd_18_i" -> 18
    when "cmd_19_j" -> 19
    when "cmd_20_a" -> 20
    when "cmd_21_b" -> 21
    when "cmd_22_c" -> 22
    when "cmd_23_d" -> 23
    when "cmd_24_e" -> 24
    when "cmd_25_f" -> 25
    when "cmd_26_g" -> 26
    when "cmd_27_h" -> 27
    when "cmd_28_i" -> 28
    when "cmd_29_j" -> 29
    when "cmd_30_a" -> 30
    when "cmd_31_b" -> 31
    when "cmd_32_c" -> 32
    when "cmd_33_d" -> 33
    when "cmd_34_e" -> 34
    when "cmd_35_f" -> 35
    when "cmd_36_g" -> 36
    when "cmd_37_h" -> 37
    when "cmd_38_i" -> 38
    when "cmd_39_j" -> 39
    when _ -> -1
  end
end

fn by_int(k)
  match k
    when 0 -> 0
    when 7 -> 1
    when 14 -> 2
    when 21 -> 3
    when 28 -> 4
    when 35 -> 5
    when 42 -> 6
    when 49 -> 7
    when 56 -> 8
    when 63 -> 9
    when 70 -> 10
    when 77 -> 11
    when 84 -> 12
    when 91 -> 13
    when 98 -> 14
    when 105 -> 15
    when 112 -> 16
    when 119 -> 17
    when 126 -> 18
    when 133 -> 19
    when 140 -> 20
    when 147 -> 21
    when 154 -> 22
    when 161 -> 23
    when 168 -> 24
    when 175 -> 25
    when 182 -> 26
    when 189 -> 27
    when 196 -> 28
    when 203 -> 29
    when 210 -> 30
    when 217 -> 31
    when 224 -> 32
    when 231 -> 33
    when 238 -> 34
    when 245 -> 35
    when 252 -> 36
    when 259 -> 37
    when 266 -> 38
    when 273 -> 39
    when _ -> -1
  end
end

fn by_variant(k)
  match k
    when Variant.v00 -> 0
    when Variant.v01 -> 1
    when Variant.v02 -> 2
    when Variant.v03 -> 3
    when Variant.v04 -> 4
    when Variant.v05 -> 5
    when Variant.v06 -> 6
    when Variant.v07 -> 7
    when Variant.v08 -> 8
    when Variant.v09 -> 9
    when Variant.v10 -> 10
    when Variant.v11 -> 11
    when Variant.v12 -> 12
    when Variant.v13 -> 13
    when Variant.v14 -> 14
    when Variant.v15 -> 15
    when Variant.v16 -> 16
    when Variant.v17 -> 17
    when Variant.v18 -> 18
    when Variant.v19 -> 19
    when Variant.v20 -> 20
    when Variant.v21 -> 21
    when Variant.v22 -> 22
    when Variant.v23 -> 23
    when Variant.v24 -> 24
    when Variant.v25 -> 25
    when Variant.v26 -> 26
    when Variant.v27 -> 27
    when Variant.v28 -> 28
    when Variant.v29 -> 29
    when Variant.v30 -> 30
    when Variant.v31 -> 31
    when Variant.v32 -> 32
    when Variant.v33 -> 33
    when Variant.v34 -> 34
    when Variant.v35 -> 35
    when Variant.v36 -> 36
    when Variant.v37 -> 37
    when Variant.v38 -> 38
    when Variant.v39 -> 39
  end
end

var total = 0
for i in range(0, 1000000) do
  set total = total + by_string(STRINGS[i % 40])
end
for i in range(0, 1000000) do
  set total = total + by_int((i % 40) * 7)
end
for i in range(0, 1000000) do
  set total = total + by_variant(VARIANTS[i % 40])
end
print("match dispatch checksum:", get total)
