// bloom — a component library written entirely in Petal.
//
// This file is the front door. Import it and you have the whole library:
//
//     import bloom                      // bloom.button(r, "Save")
//     import bloom: button, dropdown    // button(r, "Save")
//
// Everything below is a re-export of the module that implements it, so the
// implementation stays in small files and an app never has to know which one a
// component lives in. Import the individual modules instead when you want only
// a slice of it (`import bloom_motion: spring` in a game's HUD, say).
//
// bloom sits on top of `petal-ui`'s host layer — the input and draw natives
// and the `ui` prelude's primitives — and adds a component layer with its own
// theme, its own interaction model (press-and-release clicks, one open menu,
// input capture for overlays), and animation in every component by default.
// It is pure Petal: no Rust, no assets. Drop `src/*.ptl` beside your script,
// or register the files as modules, and it works in any host that embeds
// petal-ui.

import bloom_motion
import bloom_theme
import bloom_icon
import bloom_interact
import bloom_button
import bloom_controls
