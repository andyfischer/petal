  {name: "Shopping", color: #4fc3d9, merchants: [
    {name: "Amazon",                avg: 46.0,   freq: 3.0,  jit: 0.55},
    {name: "Uniqlo",                avg: 68.0,   freq: 0.5,  jit: 0.30},
    {name: "Ikea",                  avg: 129.0,  freq: 0.35, jit: 0.50},
    {name: "Powell's Books",        avg: 27.0,   freq: 1.0,  jit: 0.35},
  ]},
  {name: "Health", color: #9fd35f, merchants: [
    {name: "Greenleaf Pharmacy",    avg: 24.0,   freq: 1.2,  jit: 0.40},
    {name: "Dr. Amara Osei",        avg: 45.0,   freq: 0.4,  jit: 0.10},
    {name: "Peak Fitness",          avg: 39.0,   freq: 1.0,  jit: 0.0},
  ]},
  {name: "Subscriptions", color: #f08fc4, merchants: [
    {name: "Netflix",               avg: 17.99,  freq: 1.0,  jit: 0.0},
    {name: "Spotify",               avg: 11.99,  freq: 1.0,  jit: 0.0},
    {name: "iCloud+",               avg: 2.99,   freq: 1.0,  jit: 0.0},
    {name: "Substack",              avg: 8.0,    freq: 0.6,  jit: 0.0},
    {name: "Figma",                 avg: 15.0,   freq: 1.0,  jit: 0.0},
