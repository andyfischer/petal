  {id: 6,  name: "Henrik Vasquez",   title: "Procurement Lead",   company: "Orillion Energy",  email: "hv@orillion.com",       phone: "+1 713 555 0166", stage: "Proposal",  value: 210000, days: 6,  owner: "J. Weaver", tags: ["enterprise", "rfp"],         notes: "Formal RFP, response due the 14th. Pricing needs a volume tier we do not publish — approvals pending."},
