  {name: "Transport", color: #ef7d8e, merchants: [
    {name: "Metro Transit",         avg: 2.75,   freq: 8.0,  jit: 0.05},
    {name: "Shell",                 avg: 47.0,   freq: 1.5,  jit: 0.20},
    {name: "Lyft",                  avg: 17.0,   freq: 2.4,  jit: 0.40},
    {name: "CityBike",              avg: 12.0,   freq: 1.0,  jit: 0.10},
  ]},
  {name: "Utilities", color: #b08bf5, merchants: [
    {name: "Pacific Power",         avg: 96.0,   freq: 1.0,  jit: 0.12},
    {name: "Cascade Water",         avg: 41.0,   freq: 0.5,  jit: 0.10},
    {name: "Fiberline Internet",    avg: 79.0,   freq: 1.0,  jit: 0.01},
