// ── Tunables ─────────────────────────────────────────────────────────────

config let iter_rate    = 3600000.0 // iterations per second while you interact
config let idle_boost   = 3.0       // times that when nothing else is happening
config let sample_cost  = 24        // fixed overhead of one sample, in iterations
config let fit_eps      = 0.007     // phase error a fitted gradient may make, in cycles
config let fit_span     = 0.11      // most phase one gradient may cover, in cycles
config let merge_eps    = 0.003     // phase two rows may differ by and still be drawn as one
config let draw_budget  = 24000     // draw calls the image may cost per frame
config let growth       = 3.0       // draw calls a tile gains per level, at worst
config let pan_speed    = 620.0     // px/s while an arrow key is held
config let wheel_gain   = 1.22      // zoom factor per wheel line
config let cycle_speed  = 0.07      // palette cycles per second when cycling

// ── Lattice ──────────────────────────────────────────────────────────────

let CELL   = 2                       // px per sample at the finest level
let TS     = 32                      // samples per tile side
let TPX    = 64                      // px per tile side
let TN     = 1024                    // samples per tile
let SEGCAP = 1024                    // most segments a tile can need
let MAXLOD = 4
let STEPS  = [0, 8, 4, 2, 1]         // sample stride of level 1..4
let LOD_SAMPLES = [0, 16, 64, 256, 1024]
let PVCAP  = 26000                   // segments the zoom preview can hold
let BAIL   = 65536.0
let INV_LN2 = 1.4426950408889634
let MIN_SCALE = 0.000000000000002    // world units per px: where f64 runs out
let LN     = 256                     // entries per palette
let PHASE_OCT = 4.0                  // doublings of the iteration count per palette cycle

