// petal-ui prelude — module `ui`
//
// Standard interaction primitives over the Layer-0 input natives and the
// Layer-2 draw natives. Registered by embedders as an implicit import, so
// scripts call these bare; `import ui` / `import ui: button` also work.
// Only declarations marked `export` are visible to importers; everything else
// (and any name starting with `_`) is module-private.
//
// Rects are records: {x, y, w, h}. Colors are records: {r, g, b} (hex
// literals like #3c8cff work). Button 0 is the left mouse button.

// ── Geometry + hit testing ────────────────────────────────────────────────

// A rect is a `Rect` — the built-in class (fields x, y, w, h). It is still an
// ordinary record, so every `{x, y, w, h}` written by hand keeps working
// everywhere a rect is taken; going through the class is what earns the
// geometry methods (`r.center_x()`, `r.inset(4)`, `r.right()` …) and makes
// `type(r)` say "Rect". See docs/language-guide.md (Classes & Methods).
//
// Coordinates are kept exactly as passed — `rect(10.5, …)` is a sub-pixel rect,
// not a truncated one — so animated and fractional layout stays smooth. The
// draw natives are where a coordinate becomes a whole pixel.
//
// `rect` *is* the constructor rather than a function wrapping it, so a bad
// argument is reported at the caller's own `rect(...)` — a wrapper would put
// the caret on this file's line and leave the app author reading the prelude.
export let rect = Rect

export fn point_in(px, py, r)
  px >= r.x && px < r.x + r.w && py >= r.y && py < r.y + r.h
end

export fn hovered(r)
  point_in(mouse_x(), mouse_y(), r)
end

export fn clicked(r)
  hovered(r) && mouse_pressed(0)
end

// ── Timing ────────────────────────────────────────────────────────────────
// `time()` is an absolute clock in seconds, published by the host each frame
// (monotonic, read fresh — never a running sum of `dt()`, so it does not
// drift). `elapsed()` reports the seconds since it was first called: it
// captures the clock once into `state` and subtracts. That `state` is keyed by
// the call path, so the capture is per *callsite*: every `elapsed()` in a
// program is its own timer, started on the first frame that callsite runs —
// which is what makes "one timer per thing being timed" the default. A call
// inside a loop gets one timer per iteration by the same rule. For a single
// app-global clock instead, capture it once into a top-level cell
// (`state var t0 = time()`) and subtract, or use an absolute `state(key)`.
export fn elapsed()
  state start = time()
  time() - start
end

// ── Record overloads over the flat draw natives ───────────────────────────
// The flat-int arities delegate to the captured natives, so scripts that use
// the classic signatures keep working when these shadow the builtins.

let _native_image = draw_image
let _native_rect = draw_rect
let _native_rect_rounded = draw_rect_rounded
let _native_rect_outline = draw_rect_outline
let _native_line = draw_line
let _native_circle = draw_circle
let _native_text = draw_text
let _native_font = font

// Every primitive takes an optional trailing alpha (0–255, 255 = opaque).
// Lines and outlines also take an optional trailing stroke `width`. Rounded
// rects add a `radius`. Each forwards to the native, which fills defaults.

export fn draw_image(source, x, y, w, h)
  _native_image(source, x, y, w, h)
end
export fn draw_image(source, x, y, w, h, a)
  _native_image(source, x, y, w, h, a)
end
export fn draw_image(source, r)
  _native_image(source, r.x, r.y, r.w, r.h)
end
export fn draw_image(source, r, a)
  _native_image(source, r.x, r.y, r.w, r.h, a)
end
// Rounded corners — the avatar, the card thumbnail. A host that can't round a
// bitmap draws the square image rather than nothing.
export fn draw_image(source, x, y, w, h, a, radius)
  _native_image(source, x, y, w, h, a, radius)
end
export fn draw_image(source, r, a, radius)
  _native_image(source, r.x, r.y, r.w, r.h, a, radius)
end

export fn draw_rect(x, y, w, h, r, g, b)
  _native_rect(x, y, w, h, r, g, b)
end
export fn draw_rect(x, y, w, h, r, g, b, a)
  _native_rect(x, y, w, h, r, g, b, a)
end
export fn draw_rect(r, c)
  _native_rect(r.x, r.y, r.w, r.h, c.r, c.g, c.b)
end
export fn draw_rect(r, c, a)
  _native_rect(r.x, r.y, r.w, r.h, c.r, c.g, c.b, a)
end

export fn draw_rect_rounded(x, y, w, h, radius, r, g, b)
  _native_rect_rounded(x, y, w, h, radius, r, g, b)
end
export fn draw_rect_rounded(x, y, w, h, radius, r, g, b, a)
  _native_rect_rounded(x, y, w, h, radius, r, g, b, a)
end
export fn draw_rect_rounded(rect, radius, c)
  _native_rect_rounded(rect.x, rect.y, rect.w, rect.h, radius, c.r, c.g, c.b)
end
export fn draw_rect_rounded(rect, radius, c, a)
  _native_rect_rounded(rect.x, rect.y, rect.w, rect.h, radius, c.r, c.g, c.b, a)
end

export fn draw_rect_outline(x, y, w, h, r, g, b)
  _native_rect_outline(x, y, w, h, r, g, b)
end
export fn draw_rect_outline(x, y, w, h, r, g, b, a)
  _native_rect_outline(x, y, w, h, r, g, b, a)
end
export fn draw_rect_outline(x, y, w, h, r, g, b, a, width)
  _native_rect_outline(x, y, w, h, r, g, b, a, width)
end
export fn draw_rect_outline(r, c)
  _native_rect_outline(r.x, r.y, r.w, r.h, c.r, c.g, c.b)
end
export fn draw_rect_outline(r, c, a)
  _native_rect_outline(r.x, r.y, r.w, r.h, c.r, c.g, c.b, a)
end
export fn draw_rect_outline(r, c, a, width)
  _native_rect_outline(r.x, r.y, r.w, r.h, c.r, c.g, c.b, a, width)
end

export fn draw_line(x1, y1, x2, y2, r, g, b)
  _native_line(x1, y1, x2, y2, r, g, b)
end
export fn draw_line(x1, y1, x2, y2, r, g, b, a)
  _native_line(x1, y1, x2, y2, r, g, b, a)
end
export fn draw_line(x1, y1, x2, y2, r, g, b, a, width)
  _native_line(x1, y1, x2, y2, r, g, b, a, width)
end
export fn draw_line(a, b, c)
  _native_line(a.x, a.y, b.x, b.y, c.r, c.g, c.b)
end
// Alpha and stroke width, matching the flat arities and every other primitive's
// record overload. A checkmark, a strikethrough, a caret and a focus underline
// all want a 2px or translucent stroke; without these the call fell through to
// the native's arity check and failed at *runtime* with "draw_line() expects
// 7 or 8 or 9 or 3 arguments, got 5".
export fn draw_line(a, b, c, alpha)
  _native_line(a.x, a.y, b.x, b.y, c.r, c.g, c.b, alpha)
end
export fn draw_line(a, b, c, alpha, width)
  _native_line(a.x, a.y, b.x, b.y, c.r, c.g, c.b, alpha, width)
end

export fn draw_circle(cx, cy, radius, r, g, b)
  _native_circle(cx, cy, radius, r, g, b)
end
export fn draw_circle(cx, cy, radius, r, g, b, a)
  _native_circle(cx, cy, radius, r, g, b, a)
end
export fn draw_circle(center, radius, c)
  _native_circle(center.x, center.y, radius, c.r, c.g, c.b)
end
export fn draw_circle(center, radius, c, a)
  _native_circle(center.x, center.y, radius, c.r, c.g, c.b, a)
end

export fn draw_text(text, x, y, size, r, g, b)
  _native_text(text, x, y, size, r, g, b)
end
export fn draw_text(text, x, y, size, r, g, b, a)
  _native_text(text, x, y, size, r, g, b, a)
end
export fn draw_text(text, pos, size, c)
  _native_text(text, pos.x, pos.y, size, c.r, c.g, c.b)
end
export fn draw_text(text, pos, size, c, a)
  _native_text(text, pos.x, pos.y, size, c.r, c.g, c.b, a)
end
// Styled: a record of any subset of {size, color, font, weight, italic,
// spacing}. Omitted fields mean plain text — the host's own font, upright,
// regular — so a style is a diff against what draw_text always did. Measure
// the same record with text_width(s, style) and the two agree.
//   draw_text("#482", {x: 60, y: 20}, {size: 15, color: FG, weight: 700})
export fn draw_text(text, pos, style)
  _native_text(text, pos.x, pos.y, style)
end

// ── Clipping ──────────────────────────────────────────────────────────────

// `clip` *replaces* the active clip and `clip_none()` clears it — the pair
// this prelude has always had. `clip_push`/`clip_pop` are the composable form:
// a push intersects with the clip already in force and a pop puts it back, so
// a widget can clip its own contents without knowing (or destroying) the clip
// its caller set. Prefer them inside anything reusable.
//
// The optional trailing `radius` rounds the clip's corners, so a card can clip
// its content to its own rounded shape. A host that can only scissor a
// rectangle ignores it and clips square.

let _native_clip = clip
let _native_clip_push = clip_push
let _native_clip_pop = clip_pop

export fn clip(x, y, w, h)
  _native_clip(x, y, w, h)
end
export fn clip(x, y, w, h, radius)
  _native_clip(x, y, w, h, radius)
end
export fn clip(r)
  _native_clip(r.x, r.y, r.w, r.h)
end
export fn clip(r, radius)
  _native_clip(r.x, r.y, r.w, r.h, radius)
end

export fn clip_push(x, y, w, h)
  _native_clip_push(x, y, w, h)
end
export fn clip_push(x, y, w, h, radius)
  _native_clip_push(x, y, w, h, radius)
end
export fn clip_push(r)
  _native_clip_push(r.x, r.y, r.w, r.h)
end
export fn clip_push(r, radius)
  _native_clip_push(r.x, r.y, r.w, r.h, radius)
end

export fn clip_pop()
  _native_clip_pop()
end

// ── Gradients ─────────────────────────────────────────────────────────────
// A gradient stop is an ordinary color record. It may carry an `a` field, in
// which case that is the stop's alpha — the only primitive where alpha rides
// *with* the color, because a two-stop fade needs two of them and there is no
// sensible positional place for the second. The trailing `a0, a1` overloads
// override it when you'd rather pass alpha the way every other primitive does.
//
// `angle` is radians, clockwise from +x with y growing downward (the screen
// convention `fill_arc` uses): 0 runs left→right, PI/2 top→bottom.

// A stop's own alpha, or opaque when it carries none.
fn _stop_a(c)
  c["a"] ?? 255
end

// Captured like the other primitives' natives, so the record overloads below
// can shadow the builtin names without cutting off the flat arities.
let _native_rect_gradient = draw_rect_gradient
let _native_rect_gradient_rounded = draw_rect_gradient_rounded
let _native_circle_gradient = draw_circle_gradient

export fn draw_rect_gradient(rect, c0, c1, angle)
  _native_rect_gradient(rect.x, rect.y, rect.w, rect.h, c0.r, c0.g, c0.b, _stop_a(c0),
                        c1.r, c1.g, c1.b, _stop_a(c1), angle)
end
export fn draw_rect_gradient(rect, c0, c1, angle, a0, a1)
  _native_rect_gradient(rect.x, rect.y, rect.w, rect.h, c0.r, c0.g, c0.b, a0,
                        c1.r, c1.g, c1.b, a1, angle)
end
export fn draw_rect_gradient(x, y, w, h, c0, c1, angle)
  _native_rect_gradient(x, y, w, h, c0.r, c0.g, c0.b, _stop_a(c0),
                        c1.r, c1.g, c1.b, _stop_a(c1), angle)
end
// The flat form, forwarded so the native stays reachable through the prelude.
export fn draw_rect_gradient(x, y, w, h, r0, g0, b0, a0, r1, g1, b1, a1, angle)
  _native_rect_gradient(x, y, w, h, r0, g0, b0, a0, r1, g1, b1, a1, angle)
end

export fn draw_rect_gradient_rounded(rect, radius, c0, c1, angle)
  _native_rect_gradient_rounded(rect.x, rect.y, rect.w, rect.h, radius,
                                c0.r, c0.g, c0.b, _stop_a(c0),
                                c1.r, c1.g, c1.b, _stop_a(c1), angle)
end
export fn draw_rect_gradient_rounded(rect, radius, c0, c1, angle, a0, a1)
  _native_rect_gradient_rounded(rect.x, rect.y, rect.w, rect.h, radius,
                                c0.r, c0.g, c0.b, a0, c1.r, c1.g, c1.b, a1, angle)
end
export fn draw_rect_gradient_rounded(x, y, w, h, radius, r0, g0, b0, a0, r1, g1, b1, a1, angle)
  _native_rect_gradient_rounded(x, y, w, h, radius, r0, g0, b0, a0, r1, g1, b1, a1, angle)
end

// A disc shading from `c0` at the center to `c1` at the rim — glow, vignette,
// soft spotlight.
export fn draw_circle_gradient(center, radius, c0, c1)
  _native_circle_gradient(center.x, center.y, radius, c0.r, c0.g, c0.b, _stop_a(c0),
                          c1.r, c1.g, c1.b, _stop_a(c1))
end
export fn draw_circle_gradient(center, radius, c0, c1, a0, a1)
  _native_circle_gradient(center.x, center.y, radius, c0.r, c0.g, c0.b, a0,
                          c1.r, c1.g, c1.b, a1)
end
export fn draw_circle_gradient(cx, cy, radius, c0, c1)
  _native_circle_gradient(cx, cy, radius, c0.r, c0.g, c0.b, _stop_a(c0),
                          c1.r, c1.g, c1.b, _stop_a(c1))
end
export fn draw_circle_gradient(cx, cy, radius, r0, g0, b0, a0, r1, g1, b1, a1)
  _native_circle_gradient(cx, cy, radius, r0, g0, b0, a0, r1, g1, b1, a1)
end

// A multi-stop gradient: `stops` is a list of color records, spaced evenly
// along the axis. Two stops is exactly `draw_rect_gradient`; more than two is
// subdivided here into one two-stop band per pair, so a three-stop sky or a
// heat ramp costs no new draw command. Neighbouring bands share their edge
// color and the host interpolates per vertex, so the seams do not show.
//
// The bands are laid out along whichever axis the angle leans toward, which
// makes them exact for an axis-aligned `angle` and an approximation for a
// diagonal one (each band still gradates along the true angle; only the band
// *boundaries* are axis-aligned). Two stops has no bands and is exact at any
// angle.
export fn linear_gradient(rect, stops, angle)
  linear_gradient(rect, stops, angle, 0)
end

export fn linear_gradient(rect, stops, angle, radius)
  let n = len(stops)
  if n == 1 then
    draw_rect_rounded(rect, radius, stops[0], _stop_a(stops[0]))
  end
  if n == 2 then
    draw_rect_gradient_rounded(rect, radius, stops[0], stops[1], angle)
  end
  if n > 2 then
    // The rounded corners come from a rounded clip rather than from the
    // bands: only the first and last band touch a corner, and asking each to
    // round the ones it doesn't touch would notch the middle of the shape.
    if radius > 0 then
      clip_push(rect, radius)
    end
    let bands = n - 1
    let along_x = abs(cos(angle)) >= abs(sin(angle))
    let forward = cos(angle) >= 0.0
    if !along_x then
      forward = sin(angle) >= 0.0
    end
    for i in range(0, bands) do
      // The band's span along the layout axis, as fractions of the rect. A
      // gradient pointing backwards along the axis lays its bands out from
      // the far end, so stop 0 is still where the gradient starts.
      let t0 = (i * 1.0) / bands
      let t1 = ((i + 1) * 1.0) / bands
      if !forward then
        let swap = t0
        t0 = 1.0 - t1
        t1 = 1.0 - swap
      end
      let band = {x: rect.x + t0 * rect.w, y: rect.y, w: (t1 - t0) * rect.w, h: rect.h}
      if !along_x then
        band = {x: rect.x, y: rect.y + t0 * rect.h, w: rect.w, h: (t1 - t0) * rect.h}
      end
      // Band `i` is the i-th *along the gradient*, so it always carries stops
      // i→i+1; a backwards angle only moved where it sits, and the angle
      // itself still orients the fade inside it.
      draw_rect_gradient(band, stops[i], stops[i + 1], angle)
    end
    if radius > 0 then
      clip_pop()
    end
  end
  nil
end

// ── Shadows ───────────────────────────────────────────────────────────────

// A CSS box-shadow cast by the rounded rect `rect`. `opts` is a partial record
// of {radius, blur, spread, dx, dy, color, a} — anything omitted defaults to
// the plain drop shadow (square corners, no spread, no offset, black at 25%).
// The whole shadow composites once, so it never shows a seam:
//
//   draw_shadow(card, {radius: 8, blur: 16, dy: 4, a: 60})
//   draw_rect_rounded(card, 8, t.panel)
let _native_shadow = draw_shadow

export fn draw_shadow(rect, opts)
  let c = opts["color"] ?? #000000
  _native_shadow(rect.x, rect.y, rect.w, rect.h,
                 opts["radius"] ?? 0, opts["blur"] ?? 8, opts["spread"] ?? 0,
                 opts["dx"] ?? 0, opts["dy"] ?? 0,
                 c.r, c.g, c.b, opts["a"] ?? 64)
end

// The positional form, for the common "soft shadow under this card" call.
export fn draw_shadow(rect, radius, blur, c)
  _native_shadow(rect.x, rect.y, rect.w, rect.h, radius, blur, 0, 0, 0, c.r, c.g, c.b, _stop_a(c))
end
export fn draw_shadow(rect, radius, blur, c, a)
  _native_shadow(rect.x, rect.y, rect.w, rect.h, radius, blur, 0, 0, 0, c.r, c.g, c.b, a)
end
// The flat form the native takes, forwarded so it stays reachable.
export fn draw_shadow(x, y, w, h, radius, blur, spread, dx, dy, r, g, b)
  _native_shadow(x, y, w, h, radius, blur, spread, dx, dy, r, g, b)
end
export fn draw_shadow(x, y, w, h, radius, blur, spread, dx, dy, r, g, b, a)
  _native_shadow(x, y, w, h, radius, blur, spread, dx, dy, r, g, b, a)
end

// ── Fonts ─────────────────────────────────────────────────────────────────

// `font(name)` names a face as an *object* rather than a string, so the size
// and decorations that belong with it can travel with it:
//
//   let title = font_bold(font("Helvetica Neue", 22))
//   draw_text("Chapter One", {x: 20, y: 40}, title)
//   let w = text_width("Chapter One", title)
//
// A font object is an ordinary style record — the same `{size, color, font,
// weight, italic, spacing}` `draw_text`, `text_width` and every widget `style`
// argument already take — so it drops into all of them, and merges with a
// style the usual way (`{...title, color: FG}`). That is the point: one value
// describes a run's whole appearance, so what you measure is what you draw.
//
// `name` is a family name (`"Helvetica Neue"`), one of the host's role names
// (`"mono"`, `"ui"`), or a CSS-style fallback list (`"Menlo, mono"`). The host
// resolves it against the fonts actually installed; one it cannot draw keeps
// the name as written and falls back to the host's default face for both
// measuring and drawing, so a script written on one machine still lays out
// sensibly on another. `fonts()` lists what this host offers.
export fn font(name)
  _native_font(name)
end

// `font(name, size)` — the common case, in one call.
export fn font(name, size)
  {..._native_font(name), size: size}
end

// The decorations. Each returns a *new* font object with one field set, so
// they compose and never mutate the font they were given:
//   let body = font("Inter", 14)
//   let emphasis = font_italic(font_color(body, ACCENT))
export fn font_size(f, size)
  {...f, size: size}
end

// CSS numeric weight, 100–900. A host draws the nearest cut the family ships,
// synthesizing bold only for a family that has none.
export fn font_weight(f, w)
  {...f, weight: w}
end

export fn font_bold(f)
  {...f, weight: 700}
end

export fn font_italic(f)
  {...f, italic: true}
end

// Letter-spacing in pixels, added after each glyph.
export fn font_spacing(f, px)
  {...f, spacing: px}
end

// The color a run in this font draws in — a `{r, g, b}` (or `{r, g, b, a}`)
// record, the same shape every other draw call takes.
export fn font_color(f, c)
  {...f, color: c}
end

// ── Text helpers ──────────────────────────────────────────────────────────

// Keep the tail of `s` (rightmost chars, e.g. a file path), "…"-prefixed
// when clipped to `max_chars`.
export fn truncate_tail(s, max_chars)
  if len(s) <= max_chars then
    s
  else
    "…" ++ slice(s, len(s) - max_chars + 1, len(s))
  end
end

// Keep the head of `s`, "…"-suffixed when clipped to `max_chars`.
export fn truncate_head(s, max_chars)
  if len(s) <= max_chars then
    s
  else
    slice(s, 0, max_chars - 1) ++ "…"
  end
end

fn _wrap_segment(seg, max_chars)
  let lines = []
  let cur = ""
  for word in split(seg, " ") do
    let w = word
    // A token that can never fit gets its own hard-broken lines.
    while len(w) > max_chars do
      if len(cur) > 0 then
        lines = append(lines, cur)
        cur = ""
      end
      let take = max_chars
      let piece = slice(w, 0, take)
      while len(piece) == 0 do
        // max_chars landed inside w's first char and boundary snapping
        // emptied the slice: widen until the char fits.
        take = take + 1
        piece = slice(w, 0, take)
      end
      lines = append(lines, piece)
      w = slice(w, len(piece), len(w))
    end
    if len(cur) == 0 then
      cur = w
    elsif len(cur) + 1 + len(w) <= max_chars then
      cur = cur ++ " " ++ w
    else
      lines = append(lines, cur)
      cur = w
    end
  end
  // Flush the line under construction; skip a leftover "" (the tail of a
  // fully hard-broken final word) unless it is the segment's only line.
  if len(cur) > 0 || len(lines) == 0 then
    lines = append(lines, cur)
  end
  lines
end

// Greedy word wrap: split `s` into a list of lines at most `max_chars` wide.
// Explicit "\n"s split first (each segment wraps independently), words break
// on single spaces, and a token longer than max_chars is hard-broken into
// max_chars-sized pieces. Widths are bytes, like the truncate_* helpers;
// slice snaps to UTF-8 char boundaries, so multibyte input never panics
// (its lines may just run a little short). max_chars <= 0 returns [s].
export fn wrap(s, max_chars)
  if max_chars <= 0 then
    [s]
  else
    let lines = []
    for seg in split(s, "\n") do
      for line in _wrap_segment(seg, max_chars) do
        lines = append(lines, line)
      end
    end
    lines
  end
end

// Bounded-cost N-line preview: wrap `text` into at most `max_lines` lines of
// `max_chars`, ending the last kept line with an explicit "…" when content was
// clipped. The wrap input is pre-clipped to (max_lines+1)*max_chars bytes first,
// so a huge string costs no more than a short one to preview (slice snaps to
// UTF-8 char boundaries, so multibyte text never breaks). Widths are bytes, like
// wrap / truncate_*. Returns {lines: [..], truncated: bool} — `truncated` is
// true when the last kept line carries the "…" (content was dropped).
export fn preview(text, max_chars, max_lines)
  let t = text
  let over = false
  if len(t) > max_chars * (max_lines + 1) then
    t = slice(t, 0, max_chars * (max_lines + 1))
    over = true
  end
  let ls = wrap(t, max_chars)
  if len(ls) > max_lines then
    over = true
  end
  let keep = min(max_lines, len(ls))
  let kept = []
  for j in range(0, keep) do
    let line = ls[j]
    if over && j == keep - 1 then
      // Keep the head, explicit trailing "…" (truncate_head keeps the head;
      // truncate_tail would keep the tail and prefix the ellipsis).
      line = truncate_head(line ++ "…", max_chars)
    end
    kept = append(kept, line)
  end
  {lines: kept, truncated: over}
end

// Right-aligned text: the right edge sits at `right_x`.
export fn draw_text_right(text, right_x, y, size, c)
  _native_text(text, right_x - text_width(text, size), y, size, c.r, c.g, c.b)
end

// Style-record form — `{size, color, font, weight, italic, spacing}`, the same
// record `draw_text` and `text_width` take. Measuring and drawing then agree
// even for bold or spaced text, which the bare-`size` form cannot do.
export fn draw_text_right(text, right_x, y, style)
  _native_text(text, right_x - text_width(text, style), y, style)
end

// Centered text: the run's midpoint sits at `cx`.
export fn draw_text_center(text, cx, y, size, c)
  _native_text(text, cx - text_width(text, size) / 2, y, size, c.r, c.g, c.b)
end

export fn draw_text_center(text, cx, y, style)
  _native_text(text, cx - text_width(text, style) / 2, y, style)
end

// Shorten `s` until it fits `avail_px` at font `size`, with a trailing "…".
//
// `size` is either a bare pixel size or a full style record — the same
// `{size, weight, font, spacing, …}` record `draw_text` and `text_width` take.
// Pass the style you are going to *draw* with and what you measure is what you
// get; measuring a bare 14 and drawing 14-bold overflows the box.
//
// The pixel-measured counterpart to truncate_head, for anything carrying text
// of unknown length into a fixed box. Returns `s` untouched when it already
// fits.
//
// The ellipsis is appended once, at the end, and never measured back into the
// string being trimmed. That is not tidiness: **len and slice are byte-indexed**
// while text_width counts characters, and "…" is three bytes. A loop that
// trimmed bytes off a string *already ending* in an ellipsis got them snapped
// back to the character boundary, dropping the whole ellipsis and re-adding it —
// a fixed point, and a frame that never returned.
export fn ellipsize(s, avail_px, size)
  if text_width(s, size) <= avail_px then return s end
  let out = s
  // slice snaps down to a character boundary, so each pass drops one whole
  // character and the loop is bounded by the length of the string.
  while len(out) > 0 && text_width(out ++ "…", size) > avail_px do
    out = slice(out, 0, len(out) - 1)
  end
  out ++ "…"
end

// Shorten `s` until it fits `avail_px` at font `size`, with a *leading* "…":
// the mirror of ellipsize, keeping the rightmost text instead of the leftmost.
//
// `size` may be a bare pixel size or a style record, exactly as in `ellipsize`.
//
// The pixel-measured counterpart to truncate_tail, and what a file path wants:
// "…/panel/src/git_panel.ptl" says which file this is, while the head-keeping
// ellipsize would spend the whole box on the directories it shares with every
// other row. Returns `s` untouched when it already fits.
//
// The ellipsis is prepended once, at the end, and never measured back into the
// string being trimmed — the same discipline ellipsize documents above, for the
// same reason. Trimming from the front is safe where trimming a string that
// already carries its ellipsis is not: slice snaps a *start* index **up** to a
// character boundary (an end index down), so `slice(out, 1, len(out))` always
// drops one whole character and the loop strictly shrinks toward "".
export fn ellipsize_tail(s, avail_px, size)
  if text_width(s, size) <= avail_px then return s end
  let out = s
  while len(out) > 0 && text_width("…" ++ out, size) > avail_px do
    out = slice(out, 1, len(out))
  end
  "…" ++ out
end

// Join `parts` left to right with "   ·   " separators, keeping only the leading
// run that fits `avail_px` (measured with text_width at font `size`): it stops
// at the first part whose addition would overflow and drops that part and every
// part after it. Lets header / metadata lines degrade by shedding their rightmost
// segments instead of clipping mid-glyph at the pane edge. `size` may be a bare
// pixel size or a style record, exactly as in `ellipsize`. Returns {text, count}
// — `count` is how many segments survived (0 when even the first overflows).
export fn fit_parts_n(parts, avail_px, size)
  let out = ""
  let cnt = 0
  let stopped = false
  for i in range(0, len(parts)) do
    if !stopped then
      let cand = parts[i]
      if len(out) > 0 then
        cand = out ++ "   ·   " ++ parts[i]
      end
      if text_width(cand, size) <= avail_px then
        out = cand
        cnt = cnt + 1
      else
        stopped = true
      end
    end
  end
  {text: out, count: cnt}
end

// The plain-text convenience over fit_parts_n: just the joined string.
export fn fit_parts(parts, avail_px, size)
  fit_parts_n(parts, avail_px, size).text
end

// ── Color helpers ─────────────────────────────────────────────────────────

// Blend two colors: `t` = 0 is `a`, 1 is `b`. Thin wrapper over the `color_lerp`
// builtin so the prelude's own name for it is discoverable next to `theme` —
// several apps hand-rolled this same three-channel average.
export fn mix(a, b, t)
  color_lerp(a, b, t)
end

// `lerp_color` is the same function under the name the graphics-minded reach
// for first.
export fn lerp_color(a, b, t)
  color_lerp(a, b, t)
end

// Perceived brightness of a color, 0 (black) – 255 (white), using the Rec. 601
// luma weights. The one thing a themeable widget actually needs to know about a
// color it did not choose: `luma(bg) > 128` means "this is a light surface", so
// pick dark ink. Handy for deriving a readable foreground for arbitrary tags,
// avatars and status chips.
export fn luma(c)
  (c.r * 299 + c.g * 587 + c.b * 114) / 1000
end

// A foreground that stays readable on `bg`: near-black on light surfaces,
// near-white on dark ones.
export fn contrast_text(bg)
  if luma(bg) > 140 then #14161c else #f2f5fa end
end

// ── Style ─────────────────────────────────────────────────────────────────
// `theme` is the *default* palette. The live palette every prelude widget
// paints with is `ui_theme()`, resolved in this order:
//
//   1. an explicit `theme_set(...)` — the app's own palette, merged over the
//      resolved theme at the moment it was set;
//   2. the host palette, when the embedder published one with
//      `petal_ui::input::bind_host_palette` (Garden binds its full palette, so
//      prelude widgets paint native there with zero script-side setup);
//   3. the built-in default below.
//
//   theme_set({panel: #ffffff, text: #202020, outline: #d0d4da})   // light
//   theme_set(theme_from_palette(palette()))                        // manual
//
// `theme_set` merges: keys you leave out keep their current value, so a light
// panel is a three-line diff rather than a re-typed palette. Every widget also
// takes an optional trailing `style` record that overrides the theme for that
// one call (see `button`), and a style may omit any key — missing keys fall
// through to `ui_theme()`. Between the two, no app has to reimplement a widget
// just to change its colors.
//
// Beyond colors, the theme carries the scales widgets default their geometry
// and typography from: spacing (space_sm/space/space_lg), corner radius
// (radius_sm/radius/radius_lg), and type sizes (font_sm/font_md/font_lg/
// font_xl). Numbers, not colors — but merged and overridden the same way.

export let theme = {
  // Surfaces
  bg: #14161c,          // window / canvas floor
  panel: #1d2027,       // raised panel (original name; `surface` is its twin)
  surface: #1d2027,     // card / widget surface
  overlay: #262b34,     // floating layer: tooltips, key caps, badges
  // Text
  text: #d8dee9,
  muted: #aab4c2,       // secondary text
  dim: #8a93a2,         // tertiary text (original name)
  // Hues
  accent: #3c8cff,
  success: #3fb950,
  warn: #d29922,
  danger: #f85149,
  // Lines
  outline: #3a404c,     // original name; `border` is its twin
  border: #3a404c,
  border_strong: #4d5566,
  // Interaction
  hover: #262b34,
  selection: #2c4a7a,
  // Scales (numbers, not colors)
  space_sm: 4,
  space: 8,
  space_lg: 16,
  radius_sm: 3,
  radius: 6,
  radius_lg: 10,
  font_sm: 12,
  font_md: 14,
  font_lg: 18,
  font_xl: 24
}

// Field `key` of `rec`, or `fallback` when the record does not carry it. The
// whole reason a style record can be partial. This is `std`'s `field`, which
// programs can call directly — a module's body does not see the implicit
// prelude import, so the ui prelude spells it locally.
fn _get(rec, key, fallback)
  rec[key] ?? fallback
end

// Every key the default theme carries, in order. `theme_set` merges by these
// keys over the *resolved* current theme, so a partial theme never leaves a
// widget reading nil.
let _THEME_KEYS = keys(theme)

// The module cell holding an explicitly-set palette: one slot, shared by every
// caller and preserved across hot reload. A top-level `state var` is the
// sanctioned shape for cross-function shared state — the `get` at each read
// site keeps the sharing visible.
state var _live_theme = theme

// Whether `theme_set` has been called: an explicit theme outranks the host
// palette until `theme_reset`.
state var _theme_explicit = false

// Per-frame cache of the host-defaulted theme, so the palette projection runs
// once a frame instead of once per widget.
state var _hp_cache = theme
state var _hp_frame = -1

// The palette record the host published via petal_ui's `bind_host_palette`
// (Garden's `palette()` vocabulary: window_bg / panel / text / text_dim /
// accent / border / sel / hover / green / orange / red …), or {} when the
// embedder never bound one. Read through the core `binding` builtin so no
// native has to exist for this to be safe in any embedder.
fn _host_palette()
  binding(symbol("__ui_host_palette")) ?? {}
end

// Project a host palette record — Garden's `palette()` / `panel_theme()`,
// whose keys are the host's semantic names — onto the theme's key names, over
// `base` for anything the host does not name (the scale numbers always come
// from `base`).
fn _project_palette(p, base)
  let out = {}
  for k in keys(base) do
    out[k] = base[k]
  end
  out["bg"] = _get(p, "window_bg", base.bg)
  out["panel"] = _get(p, "panel", base.panel)
  out["surface"] = _get(p, "panel", base.surface)
  out["overlay"] = _get(p, "hover", base.overlay)
  out["text"] = _get(p, "text", base.text)
  out["muted"] = _get(p, "text_mut", base.muted)
  out["dim"] = _get(p, "text_dim", base.dim)
  out["accent"] = _get(p, "accent", base.accent)
  out["success"] = _get(p, "green", base.success)
  out["warn"] = _get(p, "orange", base.warn)
  out["danger"] = _get(p, "red", base.danger)
  out["outline"] = _get(p, "border", base.outline)
  out["border"] = _get(p, "border", base.border)
  out["border_strong"] = _get(p, "border_focused", base.border_strong)
  out["hover"] = _get(p, "hover", base.hover)
  out["selection"] = _get(p, "sel", base.selection)
  out
end

// The theme when nothing was set explicitly: the host palette projected onto
// the theme keys when the host bound one, the built-in default otherwise.
fn _host_theme()
  if get _hp_frame == frame_count() then
    get _hp_cache
  else
    let hp = _host_palette()
    let resolved = theme
    if len(keys(hp)) > 0 then
      resolved = _project_palette(hp, theme)
    end
    set _hp_cache = resolved
    set _hp_frame = frame_count()
    resolved
  end
end

// The live palette a widget paints with: `ui_theme()`, with the module default
// standing in if a caller ever emptied it.
//
fn _palette()
  let live = ui_theme()
  if len(keys(live)) == 0 then theme else live end
end

// The live palette. Widgets read this through `_palette`, never `theme`
// directly. Resolution: explicit `theme_set` > host palette > built-in default
// (see the section comment above).
export fn ui_theme()
  if get _theme_explicit then
    get _live_theme
  else
    _host_theme()
  end
end

// Merge `t`'s keys onto the live palette and return the result. Call it once
// at startup (or every frame — it is idempotent for a fixed `t`). From then on
// the explicit theme wins over any host palette, until `theme_reset`.
export fn theme_set(t)
  let cur = _palette()
  let next = {}
  for k in _THEME_KEYS do
    next[k] = _get(t, k, cur[k])
  end
  // Carry through any extra keys the app hangs on its theme, so a style record
  // and a theme record are interchangeable.
  for k in keys(t) do
    next[k] = t[k]
  end
  set _live_theme = next
  set _theme_explicit = true
end

// Back to the default resolution: host palette when bound, else the built-in
// dark palette.
export fn theme_reset()
  set _live_theme = theme
  set _theme_explicit = false
end

// Project a host palette record onto the ui theme's key names, over the
// current resolved theme. Kept for apps that want the projection explicitly —
//   theme_set(theme_from_palette(palette()))
// — though in Garden the same happens automatically through the bound host
// palette (see `ui_theme` above).
export fn theme_from_palette(p)
  _project_palette(p, _palette())
end

// ── Button (immediate-mode): draws, returns true on click this frame ─────

export fn button(r, label)
  button(r, label, {})
end

// `style` overrides any of {bg, hover, fg, outline, size}; anything it omits
// comes from `ui_theme()`. A `{}` style is the themed button. The face eases
// between its resting and hover colors (~120ms) and dips toward black while
// pressed; at rest it paints exactly the resting color, so a still frame is
// pixel-identical to the pre-animation button.
export fn button(r, label, style)
  let t = _palette()
  let hov = _anim_flag(hovered(r), 16.0)
  let bg = mix(_get(style, "bg", t.panel), _get(style, "hover", t.hover), hov)
  if hovered(r) && mouse_down(0) then
    bg = mix(bg, #000000, 0.18)
  end
  draw_rect(r, bg)
  draw_rect_outline(r, _get(style, "outline", t.outline))
  let size = _get(style, "size", 14)
  let tx = r.x + (r.w - text_width(label, size)) / 2
  let ty = r.y + (r.h - size) / 2
  draw_text(label, {x: tx, y: ty}, size, _get(style, "fg", t.text))
  clicked(r)
end

// ── List widget ───────────────────────────────────────────────────────────
// State is an explicit record so multiple lists coexist:
//   state files = list_state()
//   files = list_update(files, count, visible_rows, r)
// Semantics: j/k/arrows/home/end/pageup/pagedown move the selection, a click
// inside `r` selects the row under the pointer, the wheel scrolls when the
// pointer is over `r`, and the selection is always kept visible.

export fn list_state()
  {selected: 0, scroll: 0}
end

fn _row_h(r, visible_rows)
  max(1, r.h / visible_rows)
end

// Rect of the item with absolute index `i`, given the list's current scroll.
export fn list_row_rect(r, visible_rows, i, scroll)
  {x: r.x, y: r.y + (i - scroll) * _row_h(r, visible_rows), w: r.w, h: _row_h(r, visible_rows)}
end

// Scroll offset that keeps `selected` inside a `visible_rows` window.
export fn ensure_visible(scroll, selected, visible_rows)
  let s = scroll
  if selected < s then
    s = selected
  end
  if selected >= s + visible_rows then
    s = selected - visible_rows + 1
  end
  s
end

// Pixel counterpart of ensure_visible for a VARIABLE-height row list: return the
// scroll offset (px) that keeps the selected row's full [row_off, row_off+row_h)
// span inside a `view_h`-tall viewport. `scroll`, `row_off`, `row_h`, `view_h`
// are all pixels. A row taller than the viewport pins its top (its overflow then
// runs off the bottom); for any row that fits, this leaves an already-visible
// row untouched, scrolls up to reveal a row above, or down to reveal one below.
export fn ensure_visible_px(scroll, row_off, row_h, view_h)
  let s = scroll
  if row_off + row_h > s + view_h then
    s = row_off + row_h - view_h
  end
  if row_off < s then
    s = row_off
  end
  s
end

export fn list_update(lst, item_count, visible_rows, r)
  list_update(lst, item_count, visible_rows, r, true)
end

// Focus-gated form: keyboard navigation only runs when `active` is true, so a
// list can share the keyboard with other widgets (see the focus registry).
// Mouse click still selects a row regardless — the caller pairs that click
// with `focus_set` to make the list focused.
//
// The wheel scrolls the window freely, unclamped by the selection (like gitk /
// native list widgets): only keyboard navigation re-runs `ensure_visible` to
// pull the selection back on screen, so you can browse a long list past the
// selection without it snapping back.
export fn list_update(lst, item_count, visible_rows, r, active)
  let sel = lst.selected
  let scroll = lst.scroll
  let key_moved = false
  if active then
    if key_pressed("down") || key_pressed("j") then
      sel = sel + 1
      key_moved = true
    end
    if key_pressed("up") || key_pressed("k") then
      sel = sel - 1
      key_moved = true
    end
    if key_pressed("pagedown") then
      sel = sel + visible_rows
      key_moved = true
    end
    if key_pressed("pageup") then
      sel = sel - visible_rows
      key_moved = true
    end
    if key_pressed("home") then
      sel = 0
      key_moved = true
    end
    if key_pressed("end") then
      sel = item_count - 1
      key_moved = true
    end
  end
  if mouse_pressed(0) && point_in(mouse_x(), mouse_y(), r) then
    let row = scroll + (mouse_y() - r.y) / _row_h(r, visible_rows)
    if row >= 0 && row < item_count then
      sel = row
    end
  end
  if hovered(r) then
    scroll = scroll + scroll_y()
  end
  sel = clamp(sel, 0, max(0, item_count - 1))
  scroll = clamp(scroll, 0, max(0, item_count - visible_rows))
  if key_moved then
    scroll = ensure_visible(scroll, sel, visible_rows)
  end
  {selected: sel, scroll: scroll}
end

// ── Scroll region (row/line based) ────────────────────────────────────────
// Wheel scrolls when the pointer is over `r`; pageup/pagedown page; the
// offset is clamped to [0, total_lines - visible_lines].

export fn scroll_update(offset, total_lines, visible_lines, r)
  scroll_update(offset, total_lines, visible_lines, r, true)
end

// Focus-gated form (mirrors list_update's): the wheel stays hover-scoped, but
// pageup/pagedown only page when `active` is true. In a multi-region panel
// built on the focus registry this stops PageDown in the focused region from
// paging every other scroll region on screen — gate on focused(fc, id).
export fn scroll_update(offset, total_lines, visible_lines, r, active)
  let off = offset
  if hovered(r) then
    off = off + scroll_y()
  end
  if active then
    if key_pressed("pagedown") then
      off = off + visible_lines
    end
    if key_pressed("pageup") then
      off = off - visible_lines
    end
  end
  clamp(off, 0, max(0, total_lines - visible_lines))
end

// Proportional scrollbar thumb along the right edge of scroll region `r`.
// `count` is the total row count, `rows` the visible rows, `scroll` the current
// top offset (as fed to list_update / scroll_update). Draws nothing when the
// content fits (count <= rows); otherwise a dim track with an accent-neutral
// thumb sized rows/count of the track and positioned by scroll/(count - rows).
export fn draw_scrollbar(r, count, rows, scroll)
  draw_scrollbar(r, count, rows, scroll, {})
end

// `style` overrides any of {track, thumb, width}; omitted keys come from
// `ui_theme()`.
export fn draw_scrollbar(r, count, rows, scroll, style)
  if count > rows then
    let t = _palette()
    let bar_w = _get(style, "width", 4)
    let track = {x: r.x + r.w - bar_w, y: r.y, w: bar_w, h: r.h}
    draw_rect(track, _get(style, "track", t.outline))
    let thumb_h = max(12, r.h * rows / count)
    let thumb_y = track.y + (r.h - thumb_h) * scroll / (count - rows)
    draw_rect({x: track.x, y: thumb_y, w: bar_w, h: thumb_h}, _get(style, "thumb", t.dim))
  end
end

// ── Focus registry ─────────────────────────────────────────────────────────
// Focus is panel-global: at most one widget id holds the keyboard at a time.
// Keep it in a `state` record so it survives hot reload:
//   state fc = focus_state()
// An id is any value you compare with == ; the default "" means "nothing".
// Widgets that consume the keyboard (text_field, the gated list_update) check
// `focused(fc, id)` before reading keys, and request focus on click.

export fn focus_state()
  {id: ""}
end

export fn focused(fc, id)
  fc.id == id
end

export fn focus_set(fc, id)
  {id: id}
end

export fn focus_clear(fc)
  {id: ""}
end

// Position of `id` in the ordered list `ids`, or -1 if absent (so an unfocused
// registry — id "" — reads as "before the first").
fn _index_of(ids, id)
  let found = -1
  for i in range(0, len(ids)) do
    if found < 0 && ids[i] == id then
      found = i
    end
  end
  found
end

// Move focus to the next / previous id in the ordered ring `ids`. From nothing
// focused, next lands on the first and prev on the last; both wrap.
export fn focus_next(fc, ids)
  if len(ids) == 0 then
    fc
  else
    let j = _index_of(ids, fc.id) + 1
    if j >= len(ids) then
      j = 0
    end
    focus_set(fc, ids[j])
  end
end

export fn focus_prev(fc, ids)
  if len(ids) == 0 then
    fc
  else
    let idx = _index_of(ids, fc.id)
    let j = idx - 1
    if idx < 0 || j < 0 then
      j = len(ids) - 1
    end
    focus_set(fc, ids[j])
  end
end

// Convenience: Tab advances focus, Shift+Tab reverses it. Call once per frame
// with the ring of focusable widget ids.
export fn focus_update(fc, ids)
  if key_pressed("tab") then
    if mod_shift() then
      focus_prev(fc, ids)
    else
      focus_next(fc, ids)
    end
  else
    fc
  end
end

// A section heading that shows which region owns the keyboard: accent-colored
// with an underline when `active`, dim otherwise. Pairs with the focus
// registry — pass `focused(fc, id)` as `active` to label each focusable region.
export fn section_label(label, x, y, active)
  section_label(label, x, y, active, {})
end

// `style` overrides any of {active, inactive, size}; omitted keys come from
// `ui_theme()`.
export fn section_label(label, x, y, active, style)
  let t = _palette()
  let size = _get(style, "size", 14)
  let color = if active then _get(style, "active", t.accent) else _get(style, "inactive", t.dim) end
  draw_text(label, {x: x, y: y}, size, color)
  if active then
    let uy = y + size + 1
    draw_line({x: x, y: uy}, {x: x + text_width(label, size), y: uy}, color)
  end
end

// ── Text field (immediate-mode, focus-aware) ────────────────────────────────
// Single-line editable text with a real caret. Clicking focuses the field and
// places the caret at the clicked character; while focused, typing inserts at
// the caret, left/right/home/end move it, backspace deletes before it
// (alt/ctrl+backspace deletes back to the start of the word), delete removes
// the char after it, and Return sets `submitted`. State is the plain string
// `buf` (keep it in `state`); focus lives in a separate focus record; the
// caret lives in widget-internal `state`, keyed per callsite like every other
// in-function state. Returns {focus, text, caret, submitted}:
//   let res = text_field(fc, "name", r, buf)
//   fc = res.focus  buf = res.text
//   if res.submitted then ... end
// (Selection is not modeled — the field is for names, paths and filters, not
// prose.)

// Char index of the caret slot nearest pixel offset `px` into `text`.
fn _caret_from_x(text, px, size)
  let n = char_len(text)
  let best = 0
  let best_d = abs(px)
  for i in range(1, n + 1) do
    let d = abs(text_width(char_slice(text, 0, i), size) - px)
    if d < best_d then
      best = i
      best_d = d
    end
  end
  best
end

// Char index where the word before `caret` starts (for word-backspace):
// skip the run of spaces just left of the caret, then the word before it.
fn _word_start(text, caret)
  let i = caret
  while i > 0 && char_slice(text, i - 1, i) == " " do
    i = i - 1
  end
  while i > 0 && char_slice(text, i - 1, i) != " " do
    i = i - 1
  end
  i
end

// The input half, with no pixels of its own: click-to-focus, caret movement,
// editing and Return, returning the same {focus, text, caret, submitted} the
// full widget does. An app with its own palette keeps the editing logic —
// which is the fiddly part — and draws the box itself:
//
//   let res = text_field_update(fc, "name", r, buf)
//   fc = res.focus  buf = res.text
//   ...my own box, my own caret (at char index res.caret)...
//
// Pair it with `draw_text_field(r, buf, focused(fc, "name"), res.caret, style)`
// to get the stock look back.
export fn text_field_update(fc, id, r, buf)
  text_field_update(fc, id, r, buf, {})
end

// The update half reads only {size, inset} from `style` — they must match what
// the draw half uses, or click-to-place lands the caret a few pixels off.
export fn text_field_update(fc, id, r, buf, style)
  let size = _get(style, "size", 14)
  let inset = _get(style, "inset", 6)
  // The caret, in characters. -1 means "end of text" until first placed, and
  // any external change to `buf` that leaves the caret past the end clamps it.
  state caret = -1
  let f = fc
  let text = buf
  let n = char_len(text)
  if caret < 0 || caret > n then
    caret = n
  end
  if mouse_pressed(0) && point_in(mouse_x(), mouse_y(), r) then
    f = focus_set(fc, id)
    caret = _caret_from_x(text, mouse_x() - (r.x + inset), size)
  end
  let has = focused(f, id)
  let submitted = false
  if has then
    if key_pressed("left") then caret = max(0, caret - 1) end
    if key_pressed("right") then caret = min(n, caret + 1) end
    if key_pressed("home") then caret = 0 end
    if key_pressed("end") then caret = n end
    if key_pressed("backspace") && caret > 0 then
      let cut = caret - 1
      if mod_alt() || mod_ctrl() then
        cut = _word_start(text, caret)
      end
      text = char_slice(text, 0, cut) ++ char_slice(text, caret, n)
      caret = cut
    end
    if key_pressed("delete") && caret < char_len(text) then
      text = char_slice(text, 0, caret) ++ char_slice(text, caret + 1, char_len(text))
    end
    let typed = text_input()
    if len(typed) > 0 then
      text = char_slice(text, 0, caret) ++ typed ++ char_slice(text, caret, char_len(text))
      caret = caret + char_len(typed)
    end
    if key_pressed("return") then
      submitted = true
    end
  end
  {focus: f, text: text, caret: caret, submitted: submitted}
end

// The draw half. `has` is whether the field holds focus (draws the accent
// border and the caret). Without an explicit caret the bar sits at the end of
// the text, which is what the pre-caret prelude always drew.
export fn draw_text_field(r, text, has)
  draw_text_field(r, text, has, char_len(text), {})
end

// `style` overrides any of {bg, fg, outline, focus, caret, size, inset};
// omitted keys come from `ui_theme()`.
export fn draw_text_field(r, text, has, style)
  draw_text_field(r, text, has, char_len(text), style)
end

// Full form: `caret` is the char index the caret bar is drawn at (clamped).
export fn draw_text_field(r, text, has, caret, style)
  let t = _palette()
  let accent = _get(style, "focus", t.accent)
  draw_rect(r, _get(style, "bg", t.panel))
  let border = if has then accent else _get(style, "outline", t.outline) end
  draw_rect_outline(r, border)
  let size = _get(style, "size", 14)
  let tx = r.x + _get(style, "inset", 6)
  let ty = r.y + (r.h - size) / 2
  draw_text(text, {x: tx, y: ty}, size, _get(style, "fg", t.text))
  if has then
    let c = clamp(caret, 0, char_len(text))
    let cx = tx + text_width(char_slice(text, 0, c), size)
    draw_line({x: cx, y: ty}, {x: cx, y: ty + size}, _get(style, "caret", accent))
  end
end

export fn text_field(fc, id, r, buf)
  text_field(fc, id, r, buf, {})
end

export fn text_field(fc, id, r, buf, style)
  let res = text_field_update(fc, id, r, buf, style)
  draw_text_field(r, res.text, focused(res.focus, id), res.caret, style)
  res
end

// ── Context menu (immediate-mode dropdown) ─────────────────────────────────
// A right-click menu. State is an explicit record so several menus coexist and
// it survives hot reload:
//
//   state menu = menu_state()
//   ...
//   // near the TOP of the frame, before the app's own click handling:
//   if !menu_blocking(menu) then ...normal left-click handling... end
//   menu = menu_open_on_right_click(menu, row_rect, "row:{i}")
//   ...
//   // near the BOTTOM, so it draws over everything else:
//   let picked = context_menu(menu, [menu_item("Copy"), menu_sep(),
//                                    menu_item("Delete", false)])
//   menu = picked.menu
//   if picked.index >= 0 then ...act on picked.label / picked.tag... end
//
// The two-call shape (`menu_blocking` early, `context_menu` late) is what an
// immediate-mode pass can do about z-order: the menu must be *drawn* last to
// sit on top, but its click must be claimed *before* the widgets underneath
// react to the same press. So while a menu is open the rest of the UI simply
// stands down for the frame, and the menu resolves the click at the end.
//
// `tag` is any value you want handed back with the choice — the row the menu
// was opened on, typically. It is never interpreted here.

// One menu row. `enabled: false` draws dim and cannot be chosen.
export fn menu_item(label)
  menu_item(label, true)
end

export fn menu_item(label, enabled)
  {label: label, enabled: enabled, sep: false}
end

// A divider rule between groups of items. Never hoverable or choosable.
export fn menu_sep()
  {label: "", enabled: false, sep: true}
end

// `at` is the frame the menu opened on. The press that opens a menu is still
// a live `mouse_pressed` edge when `context_menu` runs later in the *same*
// frame, and a menu that resolved that edge would dismiss itself the instant it
// appeared. So the opening frame is recorded and skipped when input is
// resolved — the menu starts listening on the next one.
export fn menu_state()
  {open: false, x: 0, y: 0, tag: "", hover: -1, at: -1}
end

// True while the menu owns the pointer. Guard the rest of the panel's own
// click handling with this so one press is not acted on twice.
export fn menu_blocking(m)
  m.open
end

export fn menu_close(m)
  {open: false, x: 0, y: 0, tag: m.tag, hover: -1, at: -1}
end

// Open (or move) the menu to `(x, y)`, remembering `tag`. Hover starts on
// nothing, so a menu opened under the pointer highlights only once it moves.
export fn menu_show(m, x, y, tag)
  {open: true, x: x, y: y, tag: tag, hover: -1, at: frame_count()}
end

// The common trigger: a right press inside `r` opens the menu at the pointer.
// Any other frame leaves the state alone, so this is safe to call every frame
// for every row.
export fn menu_open_on_right_click(m, r, tag)
  if mouse_pressed(1) && point_in(mouse_x(), mouse_y(), r) then
    menu_show(m, mouse_x(), mouse_y(), tag)
  else
    m
  end
end

let _MENU_ROW_H = 24
let _MENU_SEP_H = 9
let _MENU_PAD = 6
let _MENU_SIZE = 14

// The menu's metrics, with a style record's overrides applied. Exported so an
// app that draws its own menu chrome measures with the same numbers the
// prelude lays out with instead of copying the constants (which is exactly
// what two testbed apps had to do, and what silently rots when these change).
export fn menu_metrics()
  menu_metrics({})
end

export fn menu_metrics(style)
  {
    row_h: _get(style, "row_h", _MENU_ROW_H),
    sep_h: _get(style, "sep_h", _MENU_SEP_H),
    pad: _get(style, "pad", _MENU_PAD),
    size: _get(style, "size", _MENU_SIZE)
  }
end

fn _menu_row_h(item, mm)
  if item.sep then mm.sep_h else mm.row_h end
end

// Total height of `items` plus the frame's own vertical padding.
fn _menu_h(items, mm)
  let h = mm.pad * 2
  for it in items do
    h = h + _menu_row_h(it, mm)
  end
  h
end

// Width that fits the widest label, clamped so a very long one does not run
// off the screen and a very short menu is still comfortably clickable.
fn _menu_w(items, mm)
  let widest = 0
  for it in items do
    let tw = text_width(it.label, mm.size)
    if !it.sep && tw > widest then
      widest = tw
    end
  end
  // The `clamp` builtin preserves int-ness (it used to return a float, which is
  // why this went through a private `_clamp` for years) and this feeds pixel
  // geometry that has to stay integral.
  clamp(widest + 28, 120, max(140, screen_width() - 24))
end

// Where the menu actually lands: it prefers down-and-right of the click, and
// flips to the other side of the pointer when that would put it off-screen —
// so a right-click near the bottom edge opens upward instead of being clipped.
//
// EXPORTED because the flip rule is not something an app can guess: a panel
// that has to know where the menu will be — to suppress its own hover, to skip
// drawing text under it, to scroll it into view — otherwise reimplements this
// function *and* the four metric constants above, and the copy drifts the
// moment either changes. `context_menu` also hands the same rect back as
// `.rect` in its result, for the common case of "where did the open menu land".
export fn menu_rect(m, items)
  menu_rect(m, items, {})
end

export fn menu_rect(m, items, style)
  let mm = menu_metrics(style)
  let w = _menu_w(items, mm)
  let h = _menu_h(items, mm)
  let x = m.x
  let y = m.y
  if x + w > screen_width() then
    x = max(0, m.x - w)
  end
  if y + h > screen_height() then
    y = max(0, m.y - h)
  end
  {x: x, y: y, w: w, h: h}
end

// Index of the choosable item at pane-local `(px, py)`, or -1. Separators and
// disabled rows are transparent to this, so neither can be picked.
fn _menu_hit(r, items, px, py, mm)
  let hit = -1
  let y = r.y + mm.pad
  for i in range(0, len(items)) do
    let it = items[i]
    let rh = _menu_row_h(it, mm)
    if !it.sep && it.enabled && px >= r.x && px < r.x + r.w && py >= y && py < y + rh then
      hit = i
    end
    y = y + rh
  end
  hit
end

// Step the keyboard highlight `from` by `step`, skipping separators and
// disabled rows, and stopping at the ends rather than wrapping (a menu is
// short enough that wrapping reads as a glitch). -1 means "nothing yet", so
// the first Down lands on the first choosable row.
fn _menu_step(items, from, step)
  let i = from + step
  if from < 0 && step < 0 then
    i = len(items) - 1
  end
  let found = from
  while i >= 0 && i < len(items) && found == from do
    if !items[i].sep && items[i].enabled then
      found = i
    end
    i = i + step
  end
  found
end

// Draw the menu and resolve this frame's input. Returns
// {menu, index, label, tag, rect}: `index` is -1 unless something was chosen,
// `tag` is whatever was passed to `menu_show` / `menu_open_on_right_click`, and
// `rect` is where the menu landed this frame (an empty rect when closed) — so a
// panel can keep its own painting out from under the menu without recomputing
// the geometry. A closed menu draws nothing and always returns index -1.
export fn context_menu(m, items)
  context_menu(m, items, {})
end

// `style` overrides any of {bg, fg, dim, outline, selection, shadow, size,
// row_h, sep_h, pad}; omitted keys come from `ui_theme()` and the menu metrics.
export fn context_menu(m, items, style)
  if !m.open || len(items) == 0 then
    {menu: m, index: -1, label: "", tag: m.tag, rect: {x: 0, y: 0, w: 0, h: 0}}
  else
    let t = _palette()
    let mm = menu_metrics(style)
    let r = menu_rect(m, items, style)
    let mx = mouse_x()
    let my = mouse_y()
    let inside = point_in(mx, my, r)
    // The opening press is not the menu's to act on — see `menu_state`.
    let live = m.at != frame_count()

    // Pointer hover wins over the keyboard highlight the moment it is over a
    // row — the two share one `hover`, so the menu never shows two of them.
    let hover = m.hover
    let over = _menu_hit(r, items, mx, my, mm)
    if inside && over >= 0 then
      hover = over
    end
    if key_pressed("down") then
      hover = _menu_step(items, hover, 1)
    end
    if key_pressed("up") then
      hover = _menu_step(items, hover, -1)
    end

    // Resolve: a click on a choosable row takes it, Return takes the
    // highlighted one, and anything else — a click outside, Escape, a second
    // right-click — dismisses without choosing.
    let chosen = -1
    let close = false
    if live then
      if mouse_pressed(0) || mouse_pressed(1) then
        if inside && over >= 0 then
          chosen = over
        end
        close = true
      end
      if key_pressed("return") && hover >= 0 then
        chosen = hover
        close = true
      end
      if key_pressed("escape") then
        close = true
      end
    end

    // Drawn after the input so the highlight reflects this frame's pointer.
    // A soft drop shadow lifts the menu off whatever it covers; without it a
    // dark menu over a dark panel reads as part of the background.
    // Alpha is 0–255, not a 0–1 fraction: a float here truncates to 0 and the
    // shadow disappears entirely.
    let bg = _get(style, "bg", t.panel)
    let fg_on = _get(style, "fg", t.text)
    let fg_off = _get(style, "dim", t.dim)
    let outline = _get(style, "outline", t.outline)
    draw_rect({x: r.x + 2, y: r.y + 3, w: r.w, h: r.h}, _get(style, "shadow", #000000), 89)
    draw_rect(r, bg)
    draw_rect_outline(r, outline)
    let y = r.y + mm.pad
    for i in range(0, len(items)) do
      let it = items[i]
      let rh = _menu_row_h(it, mm)
      if it.sep then
        let sy = y + rh / 2
        draw_line({x: r.x + 8, y: sy}, {x: r.x + r.w - 8, y: sy}, outline)
      else
        let fg = if it.enabled then fg_on else fg_off end
        if i == hover then
          draw_rect({x: r.x + 1, y: y, w: r.w - 2, h: rh}, _get(style, "selection", t.selection))
          fg = fg_on
        end
        draw_text(it.label, {x: r.x + 12, y: y + (rh - mm.size) / 2}, mm.size, fg)
      end
      y = y + rh
    end

    let next = if close then menu_close(m) else {open: true, x: m.x, y: m.y, tag: m.tag, hover: hover, at: m.at} end
    let label = if chosen >= 0 then items[chosen].label else "" end
    {menu: next, index: chosen, label: label, tag: m.tag, rect: r}
  end
end

// ── Drag and drop (immediate-mode) ────────────────────────────────────────
// The primitive every reorderable list, kanban board, timeline editor and tab
// strip was hand-rolling. State is an explicit record; keep it in `state` and
// thread it through one `drag_update` call per draggable item per frame:
//
//   state dg = drag_state()
//   for i in range(0, len(cards)) do
//     let r = card_rect(i)
//     dg = drag_update(dg, cards[i].id, r)
//     ...draw the card, offset by (dg.dx, dg.dy) when dg.dragging && dg.id == id
//   end
//   if dg.dropped then
//     let to = insertion_index(card_rects, mouse_y())
//     ...move dg.id to `to`...
//   end
//
// Fields: `dragging` (a drag is in flight), `id` (which item — the value you
// passed as `item_id`), `dx`/`dy` (pointer offset from where the press landed),
// `dropped` (true for exactly the frame the button came up, with `id`/`dx`/`dy`
// still describing the finished drag). `sx`/`sy` are the press position and
// `at` the frame the drop happened on — internal bookkeeping, but harmless to
// read.
//
// `dropped` survives the rest of the frame's `drag_update` calls (it is cleared
// on the next frame, not by the next call), so the app can loop over every item
// and still see the drop afterwards.

export fn drag_state()
  {dragging: false, id: "", dx: 0, dy: 0, dropped: false, sx: 0, sy: 0, at: -1}
end

export fn drag_update(ds, item_id, r)
  let d = ds
  // A finished drag is visible for one whole frame, then cleared.
  if d.dropped && d.at != frame_count() then
    d = drag_state()
  end
  // A press inside `r` claims the drag, unless another item already holds it.
  if !d.dragging && !d.dropped && mouse_pressed(0) && point_in(mouse_x(), mouse_y(), r) then
    d = {dragging: true, id: item_id, dx: 0, dy: 0, dropped: false,
      sx: mouse_x(), sy: mouse_y(), at: -1}
  end
  if d.dragging && d.id == item_id then
    let dx = mouse_x() - d.sx
    let dy = mouse_y() - d.sy
    if mouse_down(0) then
      d = {dragging: true, id: item_id, dx: dx, dy: dy, dropped: false,
        sx: d.sx, sy: d.sy, at: -1}
    else
      // The button came up: report the drop, keeping the final offset.
      d = {dragging: false, id: item_id, dx: dx, dy: dy, dropped: true,
        sx: d.sx, sy: d.sy, at: frame_count()}
    end
  end
  d
end

// Abandon an in-flight drag (Escape, a lost window, a list that just changed
// under the pointer). Returns a fresh state, so no `dropped` is reported.
export fn drag_cancel(ds)
  drag_state()
end

// True while `item_id` is the item being dragged.
export fn dragging(ds, item_id)
  ds.dragging && ds.id == item_id
end

// Where an item dropped at pixel `y` belongs in a vertical list whose rows are
// `rects` (in list order): the count of rows whose midpoint is above `y`. 0
// means "before the first row", len(rects) means "after the last" — exactly the
// index an insert wants, and the index to draw the drop indicator at.
export fn insertion_index(rects, y)
  let idx = 0
  for r in rects do
    if y > r.y + r.h / 2 then
      idx = idx + 1
    end
  end
  idx
end

// The horizontal counterpart, for tab strips and kanban columns.
export fn insertion_index_x(rects, x)
  let idx = 0
  for r in rects do
    if x > r.x + r.w / 2 then
      idx = idx + 1
    end
  end
  idx
end

// ── Layout: RectCut ───────────────────────────────────────────────────────
// Slice-off-a-side layout (no constraint solver): each `cut_*` returns
// {cut, rest} — the strip taken off `r` and what remains. Chain them to build
// a whole pane:
//
//   let top = cut_top(screen, 40)      // header
//   let side = cut_left(top.rest, 220) // sidebar
//   ...draw into top.cut / side.cut / side.rest...

export fn cut_left(r, px)
  {cut: rect(r.x, r.y, px, r.h), rest: rect(r.x + px, r.y, r.w - px, r.h)}
end

export fn cut_right(r, px)
  {cut: rect(r.x + r.w - px, r.y, px, r.h), rest: rect(r.x, r.y, r.w - px, r.h)}
end

export fn cut_top(r, px)
  {cut: rect(r.x, r.y, r.w, px), rest: rect(r.x, r.y + px, r.w, r.h - px)}
end

export fn cut_bottom(r, px)
  {cut: rect(r.x, r.y + r.h - px, r.w, px), rest: rect(r.x, r.y, r.w, r.h - px)}
end

// Split `r` into {a, b} at fraction `frac` of its width (a takes the left).
// The optional `gap` is left empty between them.
export fn split_h(r, frac)
  split_h(r, frac, 0)
end

export fn split_h(r, frac, gap)
  let aw = int(float(r.w - gap) * frac)
  {a: rect(r.x, r.y, aw, r.h), b: rect(r.x + aw + gap, r.y, r.w - aw - gap, r.h)}
end

// The vertical counterpart: `a` takes the top.
export fn split_v(r, frac)
  split_v(r, frac, 0)
end

export fn split_v(r, frac, gap)
  let ah = int(float(r.h - gap) * frac)
  {a: rect(r.x, r.y, r.w, ah), b: rect(r.x, r.y + ah + gap, r.w, r.h - ah - gap)}
end

// Shrink `r` by a margin: pad(r, n) all sides, pad(r, h, v) horizontal /
// vertical, pad(r, l, t, rt, b) each side.
export fn pad(r, n)
  rect(r.x + n, r.y + n, r.w - n * 2, r.h - n * 2)
end

export fn pad(r, h, v)
  rect(r.x + h, r.y + v, r.w - h * 2, r.h - v * 2)
end

export fn pad(r, l, t, rt, b)
  rect(r.x + l, r.y + t, r.w - l - rt, r.h - t - b)
end

// `count` equal columns across `r`, `gap` px apart. Returns a list of rects.
export fn hstack(r, count)
  hstack(r, count, 8)
end

export fn hstack(r, count, gap)
  let out = []
  if count <= 0 then return out end
  let cw = (r.w - gap * (count - 1)) / count
  for i in range(0, count) do
    out = append(out, rect(r.x + i * (cw + gap), r.y, cw, r.h))
  end
  out
end

// `count` equal rows down `r`.
export fn vstack(r, count)
  vstack(r, count, 8)
end

export fn vstack(r, count, gap)
  let out = []
  if count <= 0 then return out end
  let ch = (r.h - gap * (count - 1)) / count
  for i in range(0, count) do
    out = append(out, rect(r.x, r.y + i * (ch + gap), r.w, ch))
  end
  out
end

// Distribute `r` into columns by `widths`: an int entry is fixed pixels, a
// float entry is a weight over whatever the fixed columns and gaps leave
// (weights need not sum to 1 — they are normalized against each other).
//   row(bar, [80, 0.5, 0.5, 120], 8)   // fixed, two equal flexes, fixed
export fn row(r, widths, gap)
  let fixed = 0
  let weights = 0.0
  for w in widths do
    if type(w) == "float" then
      weights = weights + w
    else
      fixed = fixed + w
    end
  end
  let leftover = max(0, r.w - fixed - gap * (len(widths) - 1))
  let out = []
  let x = r.x
  for w in widths do
    let cw = 0
    if type(w) != "float" then
      cw = w
    elsif weights > 0.0 then
      cw = int(float(leftover) * w / weights)
    end
    out = append(out, rect(x, r.y, cw, r.h))
    x = x + cw + gap
  end
  out
end

// The vertical counterpart of `row`: heights instead of widths (int = fixed
// pixels, float = weight).
export fn col(r, heights, gap)
  let fixed = 0
  let weights = 0.0
  for h in heights do
    if type(h) == "float" then
      weights = weights + h
    else
      fixed = fixed + h
    end
  end
  let leftover = max(0, r.h - fixed - gap * (len(heights) - 1))
  let out = []
  let y = r.y
  for h in heights do
    let ch = 0
    if type(h) != "float" then
      ch = h
    elsif weights > 0.0 then
      ch = int(float(leftover) * h / weights)
    end
    out = append(out, rect(r.x, y, r.w, ch))
    y = y + ch + gap
  end
  out
end

// ── Motion ────────────────────────────────────────────────────────────────
// Frame-rate-independent smoothing and easing. All deterministic under the
// headless harness (dt is fixed there), so animated widgets still trace
// reproducibly.

// Exponential approach: move `cur` toward `target` by rate `rate` (1/seconds —
// higher is snappier; ~16 lands in ~120ms). Snaps exactly onto the target when
// within a thousandth, so settled values stop generating churn.
export fn approach(cur, target, rate)
  let next = cur + (target - cur) * (1.0 - exp(-rate * dt()))
  if abs(target - next) < 0.001 then target else next end
end

// Cubic ease-out: fast start, gentle landing. t in [0, 1] (clamped).
export fn ease_out(t)
  let c = clamp(float(t), 0.0, 1.0)
  1.0 - (1.0 - c) * (1.0 - c) * (1.0 - c)
end

// Cubic ease-in-out: gentle at both ends.
export fn ease_in_out(t)
  let c = clamp(float(t), 0.0, 1.0)
  if c < 0.5 then
    4.0 * c * c * c
  else
    1.0 - pow(-2.0 * c + 2.0, 3.0) / 2.0
  end
end

// A per-callsite animated value easing toward `target`: the widget-internal
// building block behind hover/press/check transitions. First call snaps (no
// fade-in out of nowhere on first frame or hot reload).
fn _anim(target, rate)
  state v = -1.0
  if v < 0.0 then
    v = float(target)
  else
    v = approach(v, float(target), rate)
  end
  v
end

// 0→1 as `on` flips true/false, eased at `rate`. One instance per callsite
// (and per loop iteration), like every in-function `state`.
fn _anim_flag(on, rate)
  _anim(if on then 1.0 else 0.0 end, rate)
end

// ── Spinner + progress ────────────────────────────────────────────────────

// An indeterminate spinner: a rotating arc, driven by `time()`.
// `style` overrides {color, width}.
export fn spinner(cx, cy, radius)
  spinner(cx, cy, radius, {})
end

export fn spinner(cx, cy, radius, style)
  let t = _palette()
  let col = _get(style, "color", t.accent)
  let thick = _get(style, "width", max(2, radius / 4))
  let a0 = time() * 5.5
  fill_arc(cx, cy, float(radius - thick), float(radius), a0, a0 + 4.5, col.r, col.g, col.b, 235)
end

// The one-character text spinner several apps hand-rolled: | / - \ cycling on
// the frame clock. Draw it with the app's own font size and color.
export fn spinner_glyph()
  let glyphs = ["|", "/", "-", "\\"]
  glyphs[(frame_count() / 6) % 4]
end

// A progress bar. `frac` in [0, 1]; a negative `frac` draws the indeterminate
// sweep. `style` overrides {track, fill, radius}.
export fn progress_bar(r, frac)
  progress_bar(r, frac, {})
end

export fn progress_bar(r, frac, style)
  let t = _palette()
  let rad = _get(style, "radius", min(t.radius, r.h / 2))
  draw_rect_rounded(r, rad, _get(style, "track", t.overlay))
  let fill = _get(style, "fill", t.accent)
  if float(frac) < 0.0 then
    // Indeterminate: a 30%-wide segment sweeping left to right inside the
    // track (always visible — including on the very first frame at time 0).
    let span = min(r.w, max(8, int(float(r.w) * 0.3)))
    let ph = fract(time() / 1.2)
    let x = r.x + int(ph * float(r.w - span))
    draw_rect_rounded(rect(x, r.y, span, r.h), rad, fill)
  else
    let wpx = int(float(r.w) * clamp(float(frac), 0.0, 1.0))
    if wpx > 0 then
      draw_rect_rounded(rect(r.x, r.y, wpx, r.h), rad, fill)
    end
  end
end

// ── Checkbox / toggle / radio / slider ────────────────────────────────────

// A checkbox with a label. Returns the new value; click anywhere in `r`
// toggles. `style` overrides {box, bg, fill, outline, focus, fg, size}.
export fn checkbox(r, label, value)
  checkbox(r, label, value, {})
end

export fn checkbox(r, label, value, style)
  let t = _palette()
  let v = value
  if clicked(r) then v = !v end
  let box = _get(style, "box", min(16, r.h))
  let br = rect(r.x, r.y + (r.h - box) / 2, box, box)
  let hov = _anim_flag(hovered(r), 16.0)
  let on = _anim_flag(v, 22.0)
  let border = mix(_get(style, "outline", t.outline), _get(style, "focus", t.accent), max(on, hov * 0.5))
  let fillc = mix(_get(style, "bg", t.panel), _get(style, "fill", t.accent), on)
  draw_rect_rounded(br, t.radius_sm, fillc)
  draw_rect_outline(br, border)
  if on > 0.05 then
    // The checkmark: two strokes meeting at the low point.
    let ink = contrast_text(fillc)
    let al = int(255.0 * on)
    let ax = br.x + box * 22 / 100
    let ay = br.y + box * 52 / 100
    let mx2 = br.x + box * 42 / 100
    let my2 = br.y + box * 72 / 100
    let bx = br.x + box * 78 / 100
    let by = br.y + box * 28 / 100
    draw_line({x: ax, y: ay}, {x: mx2, y: my2}, ink, al, 2)
    draw_line({x: mx2, y: my2}, {x: bx, y: by}, ink, al, 2)
  end
  let size = _get(style, "size", t.font_md)
  draw_text(label, {x: br.x + box + t.space, y: r.y + (r.h - size) / 2}, size, _get(style, "fg", t.text))
  v
end

// An animated on/off switch. Returns the new value; click anywhere in `r`
// flips it. `style` overrides {height, track, fill, knob}.
export fn toggle(r, value)
  toggle(r, value, {})
end

export fn toggle(r, value, style)
  let t = _palette()
  let v = value
  if clicked(r) then v = !v end
  let on = _anim_flag(v, 18.0)
  let hov = _anim_flag(hovered(r), 16.0)
  let th = min(r.h, _get(style, "height", 18))
  let tr = rect(r.x, r.y + (r.h - th) / 2, min(r.w, th * 2), th)
  let track = mix(_get(style, "track", t.overlay), _get(style, "fill", t.accent), on)
  draw_rect_rounded(tr, th / 2, mix(track, t.text, hov * 0.06))
  let kd = th - 4
  let kx = tr.x + 2 + int(float(tr.w - kd - 4) * ease_out(on))
  draw_circle({x: kx + kd / 2, y: tr.y + th / 2}, kd / 2, _get(style, "knob", t.text))
  v
end

// A vertical radio group: one row per label, dot on the selected one. Returns
// the new selected index. `style` overrides {row_h, size, bg, fill, outline,
// focus, fg}.
export fn radio_group(r, labels, selected)
  radio_group(r, labels, selected, {})
end

export fn radio_group(r, labels, selected, style)
  let t = _palette()
  let sel = selected
  let row_h = _get(style, "row_h", 24)
  let size = _get(style, "size", t.font_md)
  for i in range(0, len(labels)) do
    let rr = rect(r.x, r.y + i * row_h, r.w, row_h)
    if clicked(rr) then sel = i end
    let on = _anim_flag(sel == i, 22.0)
    let hov = _anim_flag(hovered(rr), 16.0)
    let d = min(14, row_h - 6)
    let cc = {x: r.x + d / 2, y: rr.y + row_h / 2}
    let border = mix(_get(style, "outline", t.outline), _get(style, "focus", t.accent), max(on, hov * 0.5))
    draw_circle(cc, d / 2, border)
    draw_circle(cc, d / 2 - 1, _get(style, "bg", t.panel))
    if on > 0.05 then
      draw_circle(cc, float(d) * 0.28 * ease_out(on), _get(style, "fill", t.accent))
    end
    draw_text(labels[i], {x: r.x + d + t.space, y: rr.y + (row_h - size) / 2}, size, _get(style, "fg", t.text))
  end
  sel
end

// A horizontal slider over [lo, hi]. Returns the new value (a float). Press
// anywhere in `r` to jump-and-drag; the drag keeps tracking outside the rect
// until release. `style` overrides {track_h, track, fill, knob}.
export fn slider(r, value, lo, hi)
  slider(r, value, lo, hi, {})
end

export fn slider(r, value, lo, hi, style)
  let t = _palette()
  state dragging = false
  if mouse_pressed(0) && hovered(r) then dragging = true end
  if !mouse_down(0) then dragging = false end
  let knob = clamp(r.h / 2 - 2, 5, 9)
  let pad_x = knob + 2
  let usable = max(1, r.w - pad_x * 2)
  let v = clamp(float(value), float(lo), float(hi))
  if dragging then
    let fr = clamp(float(mouse_x() - r.x - pad_x) / float(usable), 0.0, 1.0)
    v = float(lo) + (float(hi) - float(lo)) * fr
  end
  let span = float(hi) - float(lo)
  let frac = if span > 0.0 then (v - float(lo)) / span else 0.0 end
  let track_h = _get(style, "track_h", 4)
  let cy = r.y + r.h / 2
  let tr = rect(r.x + pad_x, cy - track_h / 2, usable, track_h)
  draw_rect_rounded(tr, track_h / 2, _get(style, "track", t.overlay))
  let fw = int(float(usable) * frac)
  if fw > 0 then
    draw_rect_rounded(rect(tr.x, tr.y, fw, track_h), track_h / 2, _get(style, "fill", t.accent))
  end
  let act = _anim_flag(dragging || hovered(r), 16.0)
  let kx = tr.x + fw
  draw_circle({x: kx, y: cy}, float(knob) + act * 1.5, _get(style, "knob", t.text))
  v
end

// ── Tab bar ───────────────────────────────────────────────────────────────
// A horizontal tab strip along the top of `r` (use the full height of `r` as
// the strip). Returns the new active index; click a tab to switch. `style`
// overrides {size, gap, fg, fg_active, underline, hover}.
export fn tab_bar(r, labels, active)
  tab_bar(r, labels, active, {})
end

export fn tab_bar(r, labels, active, style)
  let t = _palette()
  let act = active
  let size = _get(style, "size", t.font_md)
  let gap = _get(style, "gap", 4)
  let x = r.x
  for i in range(0, len(labels)) do
    let wl = text_width(labels[i], size) + 24
    let tr = rect(x, r.y, wl, r.h)
    if clicked(tr) then act = i end
    let hov = _anim_flag(hovered(tr), 16.0)
    let is = act == i
    if !is && hov > 0.01 then
      draw_rect(tr, _get(style, "hover", t.hover), int(hov * 160.0))
    end
    let fg = if is then
      _get(style, "fg_active", t.text)
    else
      mix(_get(style, "fg", t.dim), t.text, hov * 0.5)
    end
    draw_text_center(labels[i], tr.x + wl / 2, r.y + (r.h - size) / 2, size, fg)
    if is then
      draw_rect(rect(tr.x + 6, r.y + r.h - 2, wl - 12, 2), _get(style, "underline", t.accent))
    end
    x = x + wl + gap
  end
  draw_line({x: r.x, y: r.y + r.h}, {x: r.x + r.w, y: r.y + r.h}, t.outline)
  act
end

// ── Tooltip ───────────────────────────────────────────────────────────────
// Show `text` near the pointer after it has rested over `anchor` for a beat
// (default 0.45s), fading in. Call it late in the frame so the tip draws over
// the widgets beneath. `style` overrides {delay, size, bg, fg, outline}.
export fn tooltip(anchor, text)
  tooltip(anchor, text, {})
end

export fn tooltip(anchor, text, style)
  state hover_since = -1.0
  if hovered(anchor) then
    if hover_since < 0.0 then hover_since = time() end
  else
    hover_since = -1.0
  end
  let delay = _get(style, "delay", 0.45)
  if hover_since >= 0.0 && time() - hover_since >= delay then
    let t = _palette()
    let a = clamp((time() - hover_since - delay) / 0.12, 0.0, 1.0)
    let size = _get(style, "size", t.font_sm)
    let wpx = text_width(text, size) + 16
    let hpx = size + 10
    let x = clamp(mouse_x() + 12, 0, max(0, screen_width() - wpx))
    let y = mouse_y() + 18
    if y + hpx > screen_height() then
      y = mouse_y() - hpx - 6
    end
    let alpha = int(a * 235.0)
    draw_rect_rounded(rect(x, y, wpx, hpx), t.radius_sm, _get(style, "bg", t.overlay), alpha)
    draw_rect_outline(rect(x, y, wpx, hpx), _get(style, "outline", t.outline), alpha)
    draw_text(text, {x: x + 8, y: y + 5}, size, _get(style, "fg", t.text), alpha)
  end
end

// ── Modal / dialog ────────────────────────────────────────────────────────
// An overlay dialog over a dimmed backdrop. Escape or a click outside closes
// it. Immediate-mode two-call shape, like the context menu: while open, guard
// the panel's own input handling with `modal_blocking(md)` near the top of the
// frame, and draw the modal near the bottom so it sits on top:
//
//   state md = modal_state()
//   if button(open_r, "Delete…") then md = modal_open(md) end
//   ...
//   let res = modal(md, 380, 200, "Delete branch?")
//   md = res.modal
//   if res.open then
//     ...draw into res.content; call modal_close(md) on your buttons...
//   end

export fn modal_state()
  {open: false, at: -1}
end

// `at` records the opening frame: the click (or keypress) that opened the
// modal is still a live edge when the modal runs later the same frame, and
// must not be read as the click-outside that dismisses it.
export fn modal_open(m)
  {open: true, at: frame_count()}
end

export fn modal_close(m)
  {open: false, at: -1}
end

// True while the modal owns the input. Guard the panel's own click/keyboard
// handling with this so one press is not acted on twice.
export fn modal_blocking(m)
  m.open
end

// Where a w×h modal sits: centered on the screen.
export fn modal_rect(w, h)
  rect((screen_width() - w) / 2, (screen_height() - h) / 2, w, h)
end

// The input half: Escape or a press outside `r` closes. Safe to call every
// frame; a closed modal passes through untouched.
export fn modal_update(m, r)
  if !m.open || m.at == frame_count() then
    m
  else
    let nm = m
    if key_pressed("escape") then nm = modal_close(m) end
    if mouse_pressed(0) && !point_in(mouse_x(), mouse_y(), r) then nm = modal_close(m) end
    nm
  end
end

// The dimming layer between the panel and the dialog.
export fn draw_modal_backdrop()
  draw_modal_backdrop({})
end

export fn draw_modal_backdrop(style)
  draw_rect(rect(0, 0, screen_width(), screen_height()), _get(style, "shadow", #000000), _get(style, "dim", 120))
end

// The dialog chrome: shadow, rounded panel, title. Returns the content rect.
export fn draw_modal(r, title)
  draw_modal(r, title, {})
end

export fn draw_modal(r, title, style)
  let t = _palette()
  draw_rect_rounded(rect(r.x + 3, r.y + 5, r.w, r.h), t.radius_lg, #000000, 90)
  draw_rect_rounded(r, t.radius_lg, _get(style, "outline", t.border_strong))
  draw_rect_rounded(pad(r, 1), t.radius_lg - 1, _get(style, "bg", t.panel))
  let size = _get(style, "size", t.font_lg)
  let inset = _get(style, "pad", t.space_lg)
  draw_text(title, {x: r.x + inset, y: r.y + inset - 2}, {size: size, color: _get(style, "fg", t.text), weight: 600})
  rect(r.x + inset, r.y + inset + size + 8, r.w - inset * 2, r.h - inset * 2 - size - 8)
end

// The one-call form: update + backdrop + chrome. Returns
// {modal, open, rect, content}; draw your body into `content` when `open`.
export fn modal(m, w, h, title)
  modal(m, w, h, title, {})
end

export fn modal(m, w, h, title, style)
  let r = modal_rect(w, h)
  let nm = modal_update(m, r)
  if nm.open then
    draw_modal_backdrop(style)
    let content = draw_modal(r, title, style)
    {modal: nm, open: true, rect: r, content: content}
  else
    {modal: nm, open: false, rect: rect(0, 0, 0, 0), content: rect(0, 0, 0, 0)}
  end
end

// ── Badge / pill / card / empty state / hint bar ──────────────────────────

// A small rounded label chip at (x, y). Returns the rect it drew (so callers
// can flow the next one after it). `style` overrides {size, bg, fg}.
export fn badge(x, y, text)
  badge(x, y, text, {})
end

export fn badge(x, y, text, style)
  let t = _palette()
  let size = _get(style, "size", t.font_sm)
  let wpx = text_width(text, size) + 14
  let hpx = size + 8
  let r = rect(x, y, wpx, hpx)
  draw_rect_rounded(r, hpx / 2, _get(style, "bg", t.overlay))
  draw_text(text, {x: x + 7, y: y + 4}, size, _get(style, "fg", t.muted))
  r
end

// The colored badge: `color` tints a translucent fill and the text — the
// status-chip look (pass t.success / t.warn / t.danger / t.accent).
export fn pill(x, y, text, color)
  pill(x, y, text, color, {})
end

export fn pill(x, y, text, color, style)
  let t = _palette()
  let size = _get(style, "size", t.font_sm)
  let wpx = text_width(text, size) + 14
  let hpx = size + 8
  let r = rect(x, y, wpx, hpx)
  draw_rect_rounded(r, hpx / 2, color, 42)
  draw_text(text, {x: x + 7, y: y + 4}, size, color)
  r
end

// A raised surface with a rounded border and a soft shadow. Returns the
// padded content rect. `style` overrides {radius, pad, bg, outline, shadow}
// (`shadow: false` to skip the drop shadow).
export fn card(r)
  card(r, {})
end

export fn card(r, style)
  let t = _palette()
  let rad = _get(style, "radius", t.radius)
  if _get(style, "shadow", true) then
    draw_rect_rounded(rect(r.x + 2, r.y + 3, r.w, r.h), rad, #000000, 60)
  end
  draw_rect_rounded(r, rad, _get(style, "outline", t.border))
  draw_rect_rounded(pad(r, 1), max(0, rad - 1), _get(style, "bg", t.surface))
  pad(r, _get(style, "pad", t.space_lg))
end

// Centered "nothing here" copy for an empty region: a dim title plus an even
// dimmer hint line. `style` overrides {size, fg}.
export fn empty_state(r, title, hint_text)
  empty_state(r, title, hint_text, {})
end

export fn empty_state(r, title, hint_text, style)
  let t = _palette()
  let size = _get(style, "size", t.font_lg)
  let cx = r.x + r.w / 2
  let cy = r.y + r.h / 2
  draw_text_center(title, cx, cy - size + 2, size, _get(style, "fg", t.dim))
  if len(hint_text) > 0 then
    draw_text_center(hint_text, cx, cy + 8, t.font_sm, mix(t.dim, t.bg, 0.35))
  end
end

// One entry of a hint bar: the key cap text and what it does.
export fn hint(key, label)
  {key: key, label: label}
end

// The keyboard-hint bar every full-pane app draws along its bottom edge:
// key caps in small pills, labels dim beside them.
//   hint_bar(bottom, [hint("j/k", "move"), hint("enter", "open")])
export fn hint_bar(r, hints)
  hint_bar(r, hints, {})
end

export fn hint_bar(r, hints, style)
  let t = _palette()
  draw_rect(r, _get(style, "bg", t.panel))
  draw_line({x: r.x, y: r.y}, {x: r.x + r.w, y: r.y}, t.outline)
  let size = _get(style, "size", t.font_sm)
  let x = r.x + 10
  for hn in hints do
    let kw = text_width(hn.key, size) + 10
    let kh = size + 6
    let kr = rect(x, r.y + (r.h - kh) / 2, kw, kh)
    draw_rect_rounded(kr, t.radius_sm, _get(style, "cap", t.overlay))
    draw_text_center(hn.key, kr.x + kw / 2, kr.y + 3, size, _get(style, "cap_fg", t.muted))
    x = x + kw + 6
    draw_text(hn.label, {x: x, y: r.y + (r.h - size) / 2}, size, _get(style, "fg", t.dim))
    x = x + text_width(hn.label, size) + 16
  end
end

// ── Splitter ──────────────────────────────────────────────────────────────
// A draggable divider splitting `r` in two — the widget git_panel/db_view
// hand-rolled as `left_frac` + `drag_div`. State is an explicit record so
// several splitters coexist:
//
//   state sp = splitter_state(0.3)
//   let s = splitter(sp, content)
//   sp = s.state
//   ...draw into s.a (left/top) and s.b (right/bottom)...
//
// `style`: axis ("x" divider slides horizontally splitting left|right — the
// default — or "y" for top|bottom), min_a / min_b (px floors for each side),
// band (grab-zone thickness), gap (space left blank beside the divider line),
// line / active (colors).

export fn splitter_state()
  splitter_state(0.5)
end

export fn splitter_state(frac)
  {frac: frac, drag: false}
end

export fn splitter(sp, r)
  splitter(sp, r, {})
end

export fn splitter(sp, r, style)
  let t = _palette()
  let axis = _get(style, "axis", "x")
  let min_a = _get(style, "min_a", 80)
  let min_b = _get(style, "min_b", 80)
  let band = _get(style, "band", 9)
  let gap = _get(style, "gap", 4)
  let total = if axis == "x" then r.w else r.h end
  let s = sp
  let hi = float(max(min_a, total - min_b))
  let apx = int(clamp(float(total) * s.frac, float(min_a), hi))
  let hit = if axis == "x" then
    rect(r.x + apx - band / 2, r.y, band, r.h)
  else
    rect(r.x, r.y + apx - band / 2, r.w, band)
  end
  if mouse_pressed(0) && hovered(hit) then
    s = {frac: s.frac, drag: true}
  end
  if !mouse_down(0) then
    s = {frac: s.frac, drag: false}
  end
  if s.drag then
    let along = if axis == "x" then mouse_x() - r.x else mouse_y() - r.y end
    s = {frac: clamp(float(along) / float(max(1, total)), 0.02, 0.98), drag: true}
    apx = int(clamp(float(total) * s.frac, float(min_a), hi))
    hit = if axis == "x" then
      rect(r.x + apx - band / 2, r.y, band, r.h)
    else
      rect(r.x, r.y + apx - band / 2, r.w, band)
    end
  end
  let active = s.drag || hovered(hit)
  let lc = if active then _get(style, "active", t.accent) else _get(style, "line", t.outline) end
  let lw = if active then 2 else 1 end
  let a = rect(0, 0, 0, 0)
  let b = rect(0, 0, 0, 0)
  if axis == "x" then
    draw_line({x: r.x + apx, y: r.y}, {x: r.x + apx, y: r.y + r.h}, lc, 255, lw)
    a = rect(r.x, r.y, apx - gap, r.h)
    b = rect(r.x + apx + gap, r.y, r.w - apx - gap, r.h)
  else
    draw_line({x: r.x, y: r.y + apx}, {x: r.x + r.w, y: r.y + apx}, lc, 255, lw)
    a = rect(r.x, r.y, r.w, apx - gap)
    b = rect(r.x, r.y + apx + gap, r.w, r.h - apx - gap)
  end
  {state: s, a: a, b: b, divider: hit}
end

// ── Table ─────────────────────────────────────────────────────────────────
// A header + rows grid with column sizing, keyboard/mouse selection (list
// semantics), zebra striping, a scrollbar, and click-to-sort headers. The
// table records the *request* (sort_col / sort_asc); the caller owns the data
// and applies the sort — the widget never reorders rows itself.
//
//   state tb = table_state()
//   tb = table(tb, r, [{label: "Name", w: 0.6}, {label: "Size", w: 90}],
//              rows)                       // rows: a list of row lists
//   ...sort `rows` by tb.sort_col / tb.sort_asc before passing them in...

export fn table_state()
  {selected: 0, scroll: 0, sort_col: -1, sort_asc: true}
end

// Column rects for `cols` across `r`: each col is {label, w} — `w` >= 1 is
// fixed pixels, 0 < w < 1 a weight over the leftover, missing/0 an equal
// flex share.
export fn table_col_rects(r, cols)
  let fixed = 0
  let weights = 0.0
  for c in cols do
    let w = float(_get(c, "w", 0))
    if w >= 1.0 then
      fixed = fixed + int(w)
    elsif w > 0.0 then
      weights = weights + w
    else
      weights = weights + 1.0
    end
  end
  let leftover = max(0, r.w - fixed)
  let out = []
  let x = r.x
  for c in cols do
    let w = float(_get(c, "w", 0))
    let cw = 0
    if w >= 1.0 then
      cw = int(w)
    else
      let wt = if w > 0.0 then w else 1.0 end
      if weights > 0.0 then cw = int(float(leftover) * wt / weights) end
    end
    out = append(out, rect(x, r.y, cw, r.h))
    x = x + cw
  end
  out
end

export fn table(tb, r, cols, rows_data)
  table(tb, r, cols, rows_data, {})
end

// `style` overrides {row_h, head_h, size, head_bg, selection, zebra, active}
// — `active` gates keyboard navigation, like list_update's.
export fn table(tb, r, cols, rows_data, style)
  let t = _palette()
  let row_h = _get(style, "row_h", 26)
  let head_h = _get(style, "head_h", 28)
  let size = _get(style, "size", t.font_md)
  let nt = tb
  let parts = cut_top(r, head_h)
  let head = parts.cut
  let body = parts.rest
  let crects = table_col_rects(head, cols)
  draw_rect(head, _get(style, "head_bg", t.panel))
  for i in range(0, len(cols)) do
    let cr = crects[i]
    if clicked(cr) then
      if nt.sort_col == i then
        nt = {...nt, sort_asc: !nt.sort_asc}
      else
        nt = {...nt, sort_col: i, sort_asc: true}
      end
    end
    let label = _get(cols[i], "label", "")
    let fg = if nt.sort_col == i then t.text else t.muted end
    draw_text(label, {x: cr.x + 8, y: head.y + (head_h - size) / 2}, {size: size, color: fg, weight: 600})
    if nt.sort_col == i then
      let arrow = if nt.sort_asc then "▲" else "▼" end
      draw_text(arrow, {x: cr.x + 12 + text_width(label, size), y: head.y + (head_h - size) / 2 + 2}, size - 4, t.accent)
    end
  end
  draw_line({x: r.x, y: body.y}, {x: r.x + r.w, y: body.y}, t.border)
  let visible = max(1, body.h / row_h)
  let lr = rect(body.x, body.y, body.w, visible * row_h)
  let lst = list_update({selected: nt.selected, scroll: nt.scroll}, len(rows_data), visible, lr, _get(style, "active", true))
  nt = {...nt, selected: lst.selected, scroll: lst.scroll}
  let zebra = _get(style, "zebra", true)
  for vi in range(0, min(visible, len(rows_data) - lst.scroll)) do
    let idx = lst.scroll + vi
    let rr = rect(body.x, body.y + vi * row_h, body.w, row_h)
    if idx == lst.selected then
      draw_rect(rr, _get(style, "selection", t.selection))
    elsif hovered(rr) then
      draw_rect(rr, t.hover)
    elsif zebra && idx % 2 == 1 then
      draw_rect(rr, t.hover, 70)
    end
    let cells = rows_data[idx]
    for ci in range(0, min(len(cols), len(cells))) do
      let cr = crects[ci]
      draw_text(ellipsize(str(cells[ci]), cr.w - 16, size), {x: cr.x + 8, y: rr.y + (row_h - size) / 2}, size, t.text)
    end
  end
  draw_scrollbar(lr, len(rows_data), visible, lst.scroll)
  nt
end

// ── Pixel-budget word wrap ────────────────────────────────────────────────
// `wrap` with a pixel budget instead of a char budget: lines measured with
// text_width at `size` (a bare px size or a style record, like ellipsize), so
// what fits is what actually fits. Explicit "\n"s split first; a word wider
// than the budget is hard-broken. The pixel counterpart every drawer's local
// `wrap2` approximated.
export fn wrap_px(s, avail_px, size)
  if avail_px <= 0 then
    [s]
  else
    let out = []
    for seg in split(s, "\n") do
      for line in _wrap_px_segment(seg, avail_px, size) do
        out = append(out, line)
      end
    end
    out
  end
end

fn _wrap_px_segment(seg, avail_px, size)
  let lines = []
  let cur = ""
  for word in split(seg, " ") do
    let w = word
    // A word that can never fit gets hard-broken into budget-sized pieces.
    while len(w) > 0 && text_width(w, size) > avail_px do
      if len(cur) > 0 then
        lines = append(lines, cur)
        cur = ""
      end
      let take = len(w)
      while take > 1 && text_width(slice(w, 0, take), size) > avail_px do
        take = take - 1
      end
      let piece = slice(w, 0, take)
      if len(piece) == 0 then
        // The budget is narrower than the first character: emit it whole
        // rather than looping (a too-wide char clips at the draw side).
        piece = w
      end
      lines = append(lines, piece)
      w = slice(w, len(piece), len(w))
    end
    if len(cur) == 0 then
      cur = w
    elsif text_width(cur ++ " " ++ w, size) <= avail_px then
      cur = cur ++ " " ++ w
    else
      lines = append(lines, cur)
      cur = w
    end
  end
  if len(cur) > 0 || len(lines) == 0 then
    lines = append(lines, cur)
  end
  lines
end

// ── Async load state ──────────────────────────────────────────────────────
// The `X_ready / X_err / X_loading` pattern every data-driven panel
// hand-rolls, blessed as one record + a poll step. Keep it in `state` and
// feed it the pending value your data channel returns:
//
//   state ls = load_state()
//   let key = "diff:" ++ sha
//   ls = load_poll(ls, key, query("diff", sha))
//   if draw_load(content, ls) then
//     ...draw ls.value...
//   end
//
// A changed `key` restarts the load (the stale value stays readable in
// `ls.value` while the new one is in flight, if you want to keep painting it).

export fn load_state()
  {status: "idle", key: "@none", value: nil, error: ""}
end

export fn load_loading(ls)
  ls.status == "loading"
end

export fn load_ready(ls)
  ls.status == "ready"
end

export fn load_failed(ls)
  ls.status == "error"
end

// Begin (or restart) a load for `key`.
export fn load_begin(ls, key)
  {status: "loading", key: key, value: ls.value, error: ""}
end

export fn load_ok(ls, value)
  {status: "ready", key: ls.key, value: value, error: ""}
end

export fn load_fail(ls, msg)
  {status: "error", key: ls.key, value: ls.value, error: msg}
end

// One poll step: restart when `key` changed, then absorb `pv` — a pending
// value from an async channel (Garden's `query`), or a plain value (ready
// immediately). Uses the core is_ready / is_error / error_of builtins.
export fn load_poll(ls, key, pv)
  let s = ls
  if s.key != key then
    s = load_begin(s, key)
  end
  if s.status == "loading" then
    if is_error(pv) then
      s = load_fail(s, error_of(pv) ?? "load failed")
    elsif is_ready(pv) then
      s = load_ok(s, pv)
    end
  end
  s
end

// Draw the non-ready states into `r` (spinner while loading, the error while
// failed, a hint while idle); returns true when the content is ready and the
// caller should draw it instead. `style` overrides {radius, error_title,
// idle_title}.
export fn draw_load(r, ls)
  draw_load(r, ls, {})
end

export fn draw_load(r, ls, style)
  if load_ready(ls) then
    true
  else
    let t = _palette()
    if load_failed(ls) then
      empty_state(r, _get(style, "error_title", "Something went wrong"), ls.error, {fg: t.danger})
    elsif load_loading(ls) then
      spinner(r.x + r.w / 2, r.y + r.h / 2, _get(style, "radius", 10))
    else
      empty_state(r, _get(style, "idle_title", "Nothing loaded"), "")
    end
    false
  end
end
