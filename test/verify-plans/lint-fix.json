{
  "name": "lint-fix",
  "mode": "source",
  "size": "1280x850",
  "corpus": [
    "examples",
    "test",
    "garden",
    "docs/examples",
    "~/.garden",
    "~/worlds-fair/ui/ptl"
  ],
  "exclude": [
    "test/vitest"
  ],
  "steps": [
    {
      "check": "compiles"
    },
    {
      "check": "ir-equal",
      "stop_on": "pass"
    },
    {
      "check": "control-run",
      "stop_on": "fail",
      "frames": 30
    },
    {
      "check": "run-diff",
      "seeds": [
        1
      ],
      "frames": 30,
      "scenarios": [
        "checked-in",
        "monkey:2"
      ]
    }
  ],
  "include": [
    "garden/garden-script/packages",
    "integrations/petal-desktop-sdl/packages",
    "core/packages/web",
    "examples/custom-apps/petal-fps/packages"
  ]
}
