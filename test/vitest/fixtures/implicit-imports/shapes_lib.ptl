// A library module. The host names it calls — `draw_rect`'s record overload,
// `screen_width` — arrive through its own `import ui`; nothing is implicit.
// `draw_rect(r, c)` here must reach the package's record overload, not the
// raw native's int arity ("Expected int at arg 1, got record").

import ui

fn margin()
  8
end

pub fn banner(c)
  let m = margin()
  draw_rect({ x: m, y: m, w: screen_width() - m * 2, h: 24 }, c)
  print("banner " ++ str(m))
end
