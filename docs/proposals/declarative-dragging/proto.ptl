# Prototype: D2 "closest + floating" on a reorderable list, in today's Petal.
# The view is a pure function model -> scene (data), so speculation is a call.
import ui

let COLORS = {A: {r: 229, g: 115, b: 115}, B: {r: 255, g: 183, b: 77}, C: {r: 129, g: 199, b: 132}, D: {r: 100, g: 181, b: 246}, E: {r: 186, g: 104, b: 200}}

fn view(items)
  for i in range(0, len(items)) do
    {key: items[i], x: 40 + i * 70, y: 100, w: 60, h: 60, c: COLORS[items[i]]}
  end
end

# ── Candidate states: item i reinserted at every index ──
fn moves(xs, i)
  let x = xs[i]
  let rest = remove_at(xs, i)
  for j in range(0, len(xs)) do take(rest, j) ++ [x] ++ drop(rest, j) end
end

fn find_key(scene, key)
  let out = nil
  for n in scene do
    if n.key == key then out = n end
  end
  out
end

# ── The engine: speculate once at drag start, then pick per frame ──
fn start_drag(model, key, mx, my)
  let i = 0
  for j in range(0, len(model)) do
    if model[j] == key then i = j end
  end
  let cands = moves(model, i)
  let targets = for c in cands do find_key(view(c), key) end
  let me = find_key(view(model), key)
  {active: true, key: key, cands: cands, targets: targets, gx: mx - me.x, gy: my - me.y}
end

fn closest(d, fx, fy)
  let best = 0
  let bd = 1.0e9
  for j in range(0, len(d.targets)) do
    let t = d.targets[j]
    let dd = (t.x - fx) * (t.x - fx) + (t.y - fy) * (t.y - fy)
    if dd < bd then
      best = j
      bd = dd
    end
  end
  best
end

state items = ["A", "B", "C", "D", "E"]
state drag = {active: false}
state specs = 0

let mx = mouse_x()
let my = mouse_y()

if !drag.active && mouse_pressed(0) then
  for n in view(items) do
    if mx >= n.x && mx < n.x + n.w && my >= n.y && my < n.y + n.h then
      drag = start_drag(items, n.key, mx, my)
      specs = specs + len(drag.cands)
    end
  end
end

let preview = items
if drag.active then
  preview = drag.cands[closest(drag, mx - drag.gx, my - drag.gy)]
  if mouse_released(0) then
    items = preview
    drag = {active: false}
  end
end

clear(24, 24, 32)
for n in view(preview) key n.key do
  let floating = drag.active && n.key == drag.key
  let tx = if floating then mx - drag.gx else n.x end
  let ty = if floating then my - drag.gy else n.y end
  # Layout animation: each keyed element eases toward where the view put it.
  state ax = tx
  state ay = ty
  ax = if floating then tx else approach(ax, tx, 18.0) end
  ay = if floating then ty else approach(ay, ty, 18.0) end
  draw_rect(ax, ay, n.w, n.h, n.c)
end
