// A small library module — see imports.ptl for a script that imports it.
// A top-level fn / let / state is exported only when marked `pub`;
// everything else (including _underscore names) is module-private.

pub let ellipsis = "..."

fn _cut(s: string, n: num) -> string
  slice(s, start: 0, end: n)
end

pub fn truncate(s: string, max: num) -> string
  if len(s) > max then
    _cut(s, max) ++ ellipsis
  else
    s
  end
end

pub fn shout(s: string) -> string
  s ++ "!"
end
