// `lerp` on colors (alpha too) and number lists, the inverse trig
// functions and `hypot`, and `random` with 0, 1 or 2 arguments.
print(lerp(#6a5a48, #ffd08a, 0.5))
print(lerp(#00000000, #ffffff, 0.5))
print(color_lerp(#ff000080, #0000ff, 0.5))
print(lerp([0, 10, 20], [1.0, 20, 40], 0.5))
print(lerp(1, 3, 0.5))
print(degrees(asin(1.0)), degrees(acos(0.0)), degrees(atan(1.0)), hypot(3, 4))
print(deriv_of(atan(dual(1.0, 1.0))))
let r = random()
print(r >= 0.0 && r < 1.0)
let h = random(5.0)
print(h >= 0.0 && h < 5.0)
let lh = random(2.0, 3.0)
print(lh >= 2.0 && lh < 3.0)
