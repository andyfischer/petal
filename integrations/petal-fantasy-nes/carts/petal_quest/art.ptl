// The 16 background tiles for world `n` (0, 1 or 2). Any index outside that
// range falls back to world 0, so a mis-typed level number draws something
// rather than crashing mid-frame.
export fn tileset(n)
  if n == 1 then
    [EMPTY, CAVE_TOP, CAVE_FILL, CAVE_BRICK, HARD, LEDGE_L, LEDGE_M, LEDGE_R,
     CRYSTAL, SKULL, STALAGMITE, WALL_L, WALL_R, POLE, SPIKES, BANNER]
  elsif n == 2 then
    [EMPTY, CASTLE_TOP, CASTLE_FILL, CASTLE_BRICK, HARD, LEDGE_L, LEDGE_M, LEDGE_R,
     BANNER_WALL, WINDOW, STARS, CLOUD_L, CLOUD_R, POLE, SPIKES, BANNER]
  else
    [EMPTY, FIELD_TOP, FIELD_FILL, FIELD_BRICK, HARD, LEDGE_L, LEDGE_M, LEDGE_R,
     BUSH, MUSHROOM, TUFT, CLOUD_L, CLOUD_R, POLE, SPIKES, BANNER]
  end
end

