// Seasonality: heating peaks in winter, gifts in December, patios in summer.
// Keeps the column chart from being twelve identical bars.
fn season(ci: num, m: num) -> float
  let ph = float(m) / 12.0 * 2.0 * pi()
  if ci == 2 then
    1.0 + 0.20 * sin(ph - 1.6)
  elsif ci == 4 then
    1.0 + 0.34 * cos(ph)
  elsif ci == 5 then
    if m >= 10 then 1.85 elsif m == 7 then 1.25 else 0.88 end
  elsif ci == 6 then
    1.0 + 0.18 * cos(ph + 0.8)
  else
    1.0
  end
end

fn build_txns() -> list
  let out = []
  let seed = 7
  for m in range(0, 12) do
    for ci in range(0, len(CATS)) do
      let cat = CATS[ci]
      for mi in range(0, len(cat.merchants)) do
        let mer = cat.merchants[mi]
        seed = seed + 1
        let n = int(floor(mer.freq))
        if rand01(seed * 31 + 5) < mer.freq - float(n) then
          n = n + 1
        end
        for k in range(0, n) do
          seed = seed + 1
          let r1 = rand01(seed * 17 + 3)
          let r2 = rand01(seed * 29 + 11)
          let amt = mer.avg * (1.0 - mer.jit + 2.0 * mer.jit * r1) * season(ci, m)
          let day = 1 + int(r2 * float(MDAYS[m]))
          out = append(out, {m: m, day: day, cat: ci, mer: mi, amt: amt})
        end
      end
    end
  end
  out
end

fn build_income() -> list
  for m in range(0, 12) do
    let base = if m < 6 then 5240.0 else 5615.0 end
    let bonus = if rand01(9000 + m) > 0.58 then 420.0 + rand01(9100 + m) * 1380.0 else 0.0 end
    base + bonus
  end
end

// ── Aggregation ──────────────────────────────────────────────────────────────

fn shade(c: record, i: num, n: num) -> record
  if n <= 1 then
    c
  else
    let hi = color_lerp(c, WHITE, t: 0.34)
    let lo = color_lerp(c, #1b2130, t: 0.52)
    color_lerp(hi, lo, t: float(i) / float(n - 1))
  end
end

fn sum_of(xs: list) -> float
  let s = 0.0
  for v in xs do
    s = s + v
  end
  s
end

fn max_of(xs: list)
  let m = xs[0]
  for v in xs do
    if v > m then m = v end
  end
  m
end

fn min_of(xs: list)
  let m = xs[0]
  for v in xs do
    if v < m then m = v end
  end
  m
end

fn argmax_of(xs: list) -> int
  let m = xs[0]
  let k = 0
  for i in range(0, len(xs)) do
    if xs[i] > m then
      m = xs[i]
      k = i
    end
  end
  k
end

fn in_scope(t: record, ci: num, mi: num, mo: num)
  (ci < 0 || t.cat == ci) && (mi < 0 || t.mer == mi) && (mo < 0 || t.m == mo)
end

fn zeros(n: num) -> list
  for i in range(0, n) do 0.0 end
end

fn zeros12() -> list
  zeros(12)
end

// Everything one drill scope needs, computed once and cached against its key.
fn build_view(txns: list, income: list, ci: num, mi: num, mo: num, sort_mode: num) -> record
  // The monthly series always spans the full year: the month filter
  // highlights a column rather than collapsing the chart to one.
  let months = zeros12()
  let all_months = zeros12()
  let cat_totals = zeros(len(CATS))
  let bucket = if ci < 0 then
    zeros(len(CATS))
  else
    zeros(len(CATS[ci].merchants))
  end
  let rows = []
  let total = 0.0

  for t in txns do
    all_months[t.m] = all_months[t.m] + t.amt
    cat_totals[t.cat] = cat_totals[t.cat] + t.amt
    if in_scope(t, ci, mi, mo: -1) then
      months[t.m] = months[t.m] + t.amt
    end
    if in_scope(t, ci, mi, mo) then
      rows = append(rows, t)
      total = total + t.amt
    end
    if in_scope(t, ci, mi: -1, mo: mo) then
      if ci < 0 then
        bucket[t.cat] = bucket[t.cat] + t.amt
      else
        bucket[t.mer] = bucket[t.mer] + t.amt
      end
    end
  end

  let slices = []
  if ci < 0 then
    slices = for c in range(0, len(CATS)) do
      {label: CATS[c].name, value: bucket[c], color: CATS[c].color, key: c}
    end
  elsif mi < 0 then
    let ms = CATS[ci].merchants
    slices = for k in range(0, len(ms)) do
      {label: ms[k].name, value: bucket[k], color: shade(c: CATS[ci].color, i: k, n: len(ms)), key: k}
    end
  else
    let here = sum_of(bucket)
    slices = [
      {label: CATS[ci].merchants[mi].name, value: bucket[mi],
        color: CATS[ci].color, key: mi},
      {label: "rest of " ++ CATS[ci].name, value: max(0.0, here - bucket[mi]),
        color: color_lerp(CATS[ci].color, #1b2130, t: 0.66), key: -1},
    ]
  end

  // Big slices first, so the donut reads clockwise by weight.
  slices = sort_by(slices, fn(s) -> s.value, "desc")

  // Newest first, or largest first. `sort_by` is stable, so rows that tie
  // keep the order the ledger had them in.
  rows = if sort_mode == 0 then
    sort_by(rows, fn(t) -> t.m * 64 + t.day, "desc")
  else
    sort_by(rows, fn(t) -> t.amt, "desc")
  end

  {slices: slices, months: months, all_months: all_months, rows: rows,
    total: total, grand: sum_of(all_months), cat_totals: cat_totals,
    income: income, inc_total: sum_of(income), spend_total: sum_of(all_months)}
end

// ── Card chrome ──────────────────────────────────────────────────────────────

fn card(r: record)
  draw_rect_rounded(x: r.x, y: r.y + 2, w: r.w, h: r.h, radius: 14, r: 0, g: 0, b: 0, a: 70)
  draw_rect_rounded(r, radius: 14, c: SURFACE)
  draw_rect_outline(r, c: HAIRLINE, a: 255, width: 1)
end

// The content rect under a card's title row.
fn card_body(r: record) -> Rect
  rect(r.x + S3, r.y + S3 + 24, r.w - S3 * 2, r.h - S3 * 2 - 24)
end

fn card_head(r: record, title: string, note: string) -> Rect
  text_at(title, x: r.x + S3, y: r.y + S3, st: {size: T_MICRO, color: DIM, spacing: 1.5})
  if len(note) > 0 then
    text_right(note, right_x: r.x + r.w - S3, y: r.y + S3, st: {size: T_MICRO, color: FAINT})
  end
  card_body(r)
end

// ── Donut ────────────────────────────────────────────────────────────────────

fn ring_pt(cx: num, cy: num, a: num, r: num) -> list
  [cx + sin(a) * r, cy - cos(a) * r]
end

fn ring_arc(cx: num, cy: num, r_in: num, r_out: num, a0: num, a1: num, c: record, alpha: num)
  let steps = max(2, int((a1 - a0) / 0.10) + 1)
  for i in range(0, steps) do
    let b0 = a0 + (a1 - a0) * float(i) / float(steps)
    let b1 = a0 + (a1 - a0) * float(i + 1) / float(steps)
    fill_poly(points: [
      ring_pt(cx, cy, a: b0, r: r_in),
      ring_pt(cx, cy, a: b0, r: r_out),
      ring_pt(cx, cy, a: b1, r: r_out),
      ring_pt(cx, cy, a: b1, r: r_in),
    ], r: c.r, g: c.g, b: c.b, a: alpha)
  end
end

// Index of the slice under the pointer, or -1.
fn donut_hit(cx: num, cy: num, r_in: num, r_out: num, slices: list, total: num) -> int
  let dx = float(mouse_x()) - cx
  let dy = float(mouse_y()) - cy
  let d = sqrt(dx * dx + dy * dy)
  if d < r_in - 2.0 || d > r_out + 8.0 then
    return -1
  end
  let a = atan2(dy, dx) + pi() / 2.0
  if a < 0.0 then a = a + 2.0 * pi() end
  let acc = 0.0
  let hit = -1
  for i in range(0, len(slices)) do
    let sweep = if total > 0.0 then slices[i].value / total * 2.0 * pi() else 0.0 end
    if hit < 0 && a >= acc && a < acc + sweep then
      hit = i
    end
    acc = acc + sweep
  end
  hit
end

fn draw_donut(cx: num, cy: num, r_in: num, r_out: num, slices: list, total: num, hot: num, sel: num, t: num)
  draw_circle(center: {x: cx, y: cy}, radius: r_out + 2.0, c: GRID)
  let acc = 0.0
  for i in range(0, len(slices)) do
    let s = slices[i]
    let sweep = if total > 0.0 then s.value / total * 2.0 * pi() * t else 0.0 end
    let lift = if i == hot then 8.0 elsif i == sel then 3.5 else 0.0 end
    let alpha = if hot >= 0 && i != hot then 140 else 255 end
    // A hair of padding between wedges reads as separation without a stroke.
    let gap = if sweep > 0.07 then 0.013 else 0.0 end
    ring_arc(cx, cy, r_in, r_out + lift, acc + gap, acc + sweep - gap, c: s.color, alpha: alpha)
    acc = acc + sweep
  end
  draw_circle(center: {x: cx, y: cy}, radius: r_in, c: SURFACE)
end

// ── Column chart ─────────────────────────────────────────────────────────────

// A round gridline step, so the axis reads $1.0k / $2.0k rather than the
// quarters of whatever the maximum happens to be.
fn axis_scale(maxv: num, target: num) -> record
  let raw = max(maxv, 0.000001) / float(target)
  let mag = pow(10.0, floor(log(raw) / log(10.0)))
  let n = raw / mag
  let mult = if n <= 1.0 then 1.0
  elsif n <= 2.0 then 2.0
  elsif n <= 2.5 then 2.5
  elsif n <= 5.0 then 5.0
  else 10.0
  end
  let step = mult * mag
  let ndiv = max(1, int(ceil(maxv / step)))
  {step: step, ndiv: ndiv, top: step * float(ndiv)}
end

fn col_rect(plot: record, i: num, n: num) -> Rect
  let slot = plot.w / float(n)
  let bw = slot * 0.54
  rect(plot.x + slot * float(i) + (slot - bw) / 2.0, plot.y, bw, plot.h)
end

fn col_hit(plot: record, n: num) -> int
  let hit = -1
  if mouse_y() >= plot.y - 8.0 && mouse_y() <= plot.y + plot.h + 18.0 then
    for i in range(0, n) do
      let slot = col_rect(plot, i, n)
      if mouse_x() >= slot.x - 4.0 && mouse_x() <= slot.x + slot.w + 4.0 then
        hit = i
      end
    end
  end
  hit
end

fn draw_columns(plot: record, vals: list, base_c: record, hot: num, marked: num, t: num)
  let sc = axis_scale(max_of(vals) * 1.06, 5)
  let top = sc.top
  for g in range(0, sc.ndiv + 1) do
    let y = plot.y + plot.h * (1.0 - float(g) / float(sc.ndiv))
    draw_line(x1: plot.x, y1: y, x2: plot.x + plot.w, y2: y, r: GRID.r, g: GRID.g, b: GRID.b, a: 255, width: 1)
    text_right(axis_label(sc.step * float(g), sc.step), right_x: plot.x - 10.0, y: y - 6.0,
      st: {size: T_MICRO, color: FAINT})
  end
  for i in range(0, len(vals)) do
    let slot = col_rect(plot, i, n: len(vals))
    let h = plot.h * (vals[i] / top) * t
    let c = if i == hot then color_lerp(base_c, WHITE, t: 0.32)
    elsif marked >= 0 && i != marked then color_lerp(base_c, SURFACE, t: 0.58)
    else base_c
    end
    draw_rect_rounded(x: slot.x, y: plot.y + plot.h - h, w: slot.w, h: max(2.0, h), radius: 4,
      r: c.r, g: c.g, b: c.b)
    let lc = if i == marked then ACCENT elsif i == hot then TEXT else FAINT end
    text_mid(MONTHS[i], cx: slot.x + slot.w / 2.0, y: plot.y + plot.h + 10.0,
      st: {size: T_MICRO, color: lc})
    if i == marked then
      draw_line(x1: slot.x - 3.0, y1: plot.y + plot.h + 3.0, x2: slot.x + slot.w + 3.0,
        y2: plot.y + plot.h + 3.0, r: ACCENT.r, g: ACCENT.g, b: ACCENT.b, a: 255, width: 2)
    end
  end
  // Mean line last, so it sits over the columns.
  let avg = sum_of(vals) / float(len(vals))
  let ay = plot.y + plot.h * (1.0 - avg / top)
  let x = plot.x
  while x < plot.x + plot.w do
    draw_line(x1: x, y1: ay, x2: min(x + 5.0, plot.x + plot.w), y2: ay, r: TEXT.r, g: TEXT.g, b: TEXT.b, a: 95, width: 1)
    x = x + 11.0
  end
  text_at("avg " ++ money(avg), x: plot.x + 4.0, y: ay - 15.0, st: {size: T_MICRO, color: DIM})
  if hot >= 0 then
    let slot = col_rect(plot, i: hot, n: len(vals))
    let h = plot.h * (vals[hot] / top) * t
    text_mid(money(vals[hot]), cx: slot.x + slot.w / 2.0, y: plot.y + plot.h - h - 18.0,
      st: {size: T_SMALL, color: TEXT})
  end
  top
end

// ── Line chart ───────────────────────────────────────────────────────────────

fn cum(vals: list) -> list
  let out = []
  let acc = 0.0
  for v in vals do
    acc = acc + v
    out = append(out, acc)
  end
  out
end

fn lx(plot: record, i: num, n: num)
  if n <= 1 then plot.x + plot.w / 2.0 else plot.x + plot.w * float(i) / float(n - 1) end
end

fn ly(plot: record, v: num, lo: num, hi: num)
  plot.y + plot.h * (1.0 - (v - lo) / max(hi - lo, 0.0001))
end

// fill_poly is convex-only, so the band under a polyline is emitted one
// vertical trapezoid per segment; the gradient comes from redrawing the whole
// band inside clip strips of falling alpha.
fn area_under(plot: record, pts: list, c: record, a_top: num)
  let bands = 12
  for b in range(0, bands) do
    let y0 = int(plot.y + plot.h * float(b) / float(bands))
    let y1 = int(plot.y + plot.h * float(b + 1) / float(bands))
    clip(x: int(plot.x), y: y0, w: int(plot.w) + 1, h: max(1, y1 - y0))
    let a = int(lerp(float(a_top), 0.0, t: float(b) / float(bands - 1)))
    for i in range(0, len(pts) - 1) do
      fill_poly(points: [
        [pts[i][0], pts[i][1]],
        [pts[i + 1][0], pts[i + 1][1]],
        [pts[i + 1][0], plot.y + plot.h],
        [pts[i][0], plot.y + plot.h],
      ], r: c.r, g: c.g, b: c.b, a: a)
    end
  end
  clip_none()
end

fn polyline(pts: list, c: record, w: num, a: num)
  for i in range(0, len(pts) - 1) do
    draw_line(x1: pts[i][0], y1: pts[i][1], x2: pts[i + 1][0], y2: pts[i + 1][1], r: c.r, g: c.g, b: c.b, a: a, width: w)
  end
end

fn dashed(x0: num, y0: num, x1: num, y1: num, c: record, a: num)
  let steps = 36
  for i in range(0, steps) do
    if i % 2 == 0 then
      let t0 = float(i) / float(steps)
      let t1 = float(i + 1) / float(steps)
      draw_line(x1: lerp(x0, x1, t: t0), y1: lerp(y0, y1, t: t0),
        x2: lerp(x0, x1, t: t1), y2: lerp(y0, y1, t: t1), r: c.r, g: c.g, b: c.b, a: a, width: 1)
    end
  end
end

// ── Breadcrumb ───────────────────────────────────────────────────────────────

let CRUMB = {size: T_SMALL, color: DIM}

fn crumb_parts(lv: num, ci: num, mi: num) -> list
  if lv == 0 then
    ["All spending"]
  elsif lv == 1 then
    ["All spending", CATS[ci].name]
  else
    ["All spending", CATS[ci].name, CATS[ci].merchants[mi].name]
  end
end

fn crumb_rects(x: num, y: num, parts: list) -> list
  let out = []
  let cx = x
  let sepw = text_w("  >  ", CRUMB)
  for i in range(0, len(parts)) do
    let w = text_w(parts[i], CRUMB)
    out = append(out, rect(cx, y - 4, w, 20))
    cx = cx + w + sepw
  end
  out
end

fn hit_list(rs: list) -> int
  let hit = -1
  for i in range(0, len(rs)) do
    if hovered(rs[i]) then hit = i end
  end
  hit
end

// ── Legend ───────────────────────────────────────────────────────────────────

let LEG_H = 26

fn leg_rect(x: num, y0: num, w: num, i: num) -> Rect
  rect(x, y0 + i * LEG_H, w, LEG_H)
end

fn leg_hit(x: num, y0: num, w: num, n: num) -> int
  let hit = -1
  for i in range(0, n) do
    if hovered(leg_rect(x, y0, w, i)) then hit = i end
  end
  hit
end

// ── KPI tiles ────────────────────────────────────────────────────────────────

fn kpi_tile(r: record, label: string, value: string, sub: string, sub_c: record, series: list, c: record, t: num)
  card(r)
  // The histogram owns the right side of the tile, so a long scope name is
  // clipped rather than allowed to run under it.
  let label_st = {size: T_MICRO, color: DIM, spacing: 1.4}
  text_at(fit_style(label, avail: r.w - S3 - 122, st: label_st), x: r.x + S3, y: r.y + 14, st: label_st)
  text_at(value, x: r.x + S3, y: r.y + 30, st: {size: T_HERO, color: TEXT})
  text_at(sub, x: r.x + S3, y: r.y + 64, st: {size: T_MICRO, color: sub_c})
  // A twelve-column micro-histogram, right-aligned in the tile.
  let bw = 5
  let gap = 3
  let bx = r.x + r.w - S3 - 12 * (bw + gap) + gap
  let by = r.y + 20
  let bh = 46.0
  let top = max_of(series) * 1.05 + 0.0001
  for i in range(0, 12) do
    let h = max(2.0, bh * (series[i] / top) * t)
    draw_rect_rounded(x: bx + i * (bw + gap), y: by + bh - h, w: bw, h: h, radius: 2, r: c.r, g: c.g, b: c.b, a: 210)
  end
end

fn kpi_rect(r: record, i: num, kw: num) -> Rect
  rect(r.x + i * (kw + 16), r.y, kw, r.h)
end

// ── Table ────────────────────────────────────────────────────────────────────

let TROW = 24

fn table_hit(view: record, scroll: num, count: num, visible: num) -> int
  let hit = -1
  for i in range(0, visible) do
    let idx = scroll + i
    if idx < count && hovered(rect(view.x, view.y + i * TROW, view.w, TROW)) then
      hit = idx
    end
  end
  hit
end

// ── Layout ───────────────────────────────────────────────────────────────────

let W = screen_width()
let H = screen_height()
let PAD = 20
let GAP = 16
let COL_L = 468
let COL_R = W - PAD * 2 - COL_L - GAP

let ROW2 = 176
let ROW3 = 480
let r_kpis  = rect(PAD, 78, W - PAD * 2, 86)
let r_donut = rect(PAD, ROW2, COL_L, ROW3 - ROW2 - GAP)
let r_bars  = rect(PAD + COL_L + GAP, ROW2, COL_R, ROW3 - ROW2 - GAP)
let r_line  = rect(PAD, ROW3, COL_L, H - ROW3 - PAD)
let r_table = rect(PAD + COL_L + GAP, ROW3, COL_R, H - ROW3 - PAD)

// ── Persistent state ─────────────────────────────────────────────────────────
// `_`-prefixed names are filtered out of the debug server's `panel.values`,
// which is where the 700-row ledger and the derived view belong.

state _txns = build_txns()
state _income = build_income()
state _cache = nil
state _cache_key = ""

state level = 0        // 0 all spending · 1 one category · 2 one merchant
state sel_cat = -1
state sel_mer = -1
state month = -1       // -1 = the whole year
state legend_sel = 0
state sort_mode = 0    // 0 by date · 1 by amount
state table_scroll = 0
state anim = 0.0
state drills = 0       // counted, so a drill is observable in /state

fn scope_key(ci: num, mi: num, mo: num, sm: num) -> string
  "{ci}|{mi}|{mo}|{sm}"
end

// ── Frame ────────────────────────────────────────────────────────────────────

clear(BG.r, BG.g, BG.b)

let key0 = scope_key(ci: sel_cat, mi: sel_mer, mo: month, sm: sort_mode)
_cache = if _cache_key == key0 then _cache
else build_view(txns: _txns, income: _income, ci: sel_cat, mi: sel_mer, mo: month, sort_mode: sort_mode) end
_cache_key = key0
let pre = _cache
let total_pre = sum_of(for s in pre.slices do s.value end)

// ── Hit testing, before drawing, so a click lands on the same frame ──────────

let dcx = r_donut.x + S3 + 106.0
let dcy = r_donut.y + 42.0 + 122.0
let d_in = 62.0
let d_out = 100.0
let hot_slice = donut_hit(cx: dcx, cy: dcy, r_in: d_in, r_out: d_out, slices: pre.slices, total: total_pre)

let leg_x = r_donut.x + S3 + 228
let leg_w = r_donut.w - S3 * 2 - 228
let leg_y0 = int(dcy) - len(pre.slices) * LEG_H / 2
let hot_leg = leg_hit(x: leg_x, y0: leg_y0, w: leg_w, n: len(pre.slices))

let bplot = rect(r_bars.x + S3 + 46, r_bars.y + 50,
  r_bars.w - S3 * 2 - 46, r_bars.h - 50 - S3 - 22)
let hot_col = col_hit(bplot, 12)

let parts = crumb_parts(lv: level, ci: sel_cat, mi: sel_mer)
let crumbs = crumb_rects(x: PAD, y: 46, parts: parts)
let hot_crumb = hit_list(crumbs)

let tplot = card_body(r_table)
let t_view = rect(tplot.x, tplot.y + 24, tplot.w, tplot.h - 24)
let t_rows_visible = int(t_view.h) / TROW
table_scroll = scroll_update(offset: table_scroll, total_lines: len(pre.rows), visible_lines: t_rows_visible, r: t_view)
let hot_row = table_hit(view: t_view, scroll: table_scroll, count: len(pre.rows), visible: t_rows_visible)

// ── Input ────────────────────────────────────────────────────────────────────

let n_slices = len(pre.slices)
let want_cat = sel_cat
let want_mer = sel_mer
let want_level = level
let want_sel = legend_sel

if key_pressed("down") || key_pressed("j") then
  want_sel = min(n_slices - 1, legend_sel + 1)
end
if key_pressed("up") || key_pressed("k") then
  want_sel = max(0, legend_sel - 1)
end

// Which slice the pointer or the keyboard is asking to descend into.
let pick = if mouse_pressed(0) && hot_slice >= 0 then hot_slice
elsif mouse_pressed(0) && hot_leg >= 0 then hot_leg
elsif key_pressed("return") || key_pressed("enter") || key_pressed("right") then want_sel
else -1
end

if pick >= 0 && pick < n_slices && level < 2 then
  let s = pre.slices[pick]
  if level == 0 then
    want_cat = s.key
    want_level = 1
    want_sel = 0
  elsif s.key >= 0 then
    want_mer = s.key
    want_level = 2
    want_sel = 0
  end
end

// A table row drills straight to its merchant.
if mouse_pressed(0) && hot_row >= 0 then
  let t = pre.rows[hot_row]
  want_cat = t.cat
  want_mer = t.mer
  want_level = 2
  want_sel = 0
end

let climb = key_pressed("escape") || key_pressed("backspace") || key_pressed("left")
let crumb_click = hot_crumb >= 0 && mouse_pressed(0)
if climb || crumb_click then
  let to = if crumb_click then hot_crumb else level - 1 end
  if to <= 0 then
    want_level = 0
    want_cat = -1
    want_mer = -1
    want_sel = 0
  elsif to == 1 && level > 1 then
    want_level = 1
    want_mer = -1
    want_sel = 0
  end
end

if key_pressed("n") then
  month = if month >= 11 then -1 else month + 1 end
end
if key_pressed("p") then
  month = if month <= -1 then 11 else month - 1 end
end
if key_pressed("a") then
  month = -1
end
if mouse_pressed(0) && hot_col >= 0 then
  month = if month == hot_col then -1 else hot_col end
end
if key_pressed("t") then
  sort_mode = 1 - sort_mode
end

let changed = want_level != level || want_cat != sel_cat || want_mer != sel_mer
drills = if changed then drills + 1 else drills end
level = want_level
sel_cat = want_cat
sel_mer = want_mer
legend_sel = want_sel
anim = if changed then 0.0 else min(1.0, anim + dt() * 3.4) end
let ease = 1.0 - pow(1.0 - anim, 3.0)

let key1 = scope_key(ci: sel_cat, mi: sel_mer, mo: month, sm: sort_mode)
_cache = if _cache_key == key1 then _cache
else build_view(txns: _txns, income: _income, ci: sel_cat, mi: sel_mer, mo: month, sort_mode: sort_mode) end
_cache_key = key1
let view = _cache
let slices = view.slices
let total = sum_of(for s in slices do s.value end)

let scope_name = if level == 0 then "All spending"
elsif level == 1 then CATS[sel_cat].name
else CATS[sel_cat].merchants[sel_mer].name
end
// Low-chroma steel means "all of it"; a drill picks up the category's own hue.
let scope_color = if level == 0 then STEEL else CATS[sel_cat].color end
let line_color = if level == 0 then POS else CATS[sel_cat].color end
let month_label = if month < 0 then "Full year {YEAR}" else "{MONTHS[month]} {YEAR}" end

// ── Header ───────────────────────────────────────────────────────────────────

draw_circle(center: {x: PAD + 5, y: 27}, radius: 5.0, c: scope_color)
let mark_st = {size: T_HEAD, color: TEXT, spacing: 2.0}
text_at("LEDGER", x: PAD + 18, y: 18, st: mark_st)
text_at("personal accounts", x: PAD + 22 + text_w("LEDGER", mark_st), y: 23,
  st: {size: T_SMALL, color: FAINT})

let sepw = text_w("  >  ", CRUMB)
let cbx = PAD
for i in range(0, len(parts)) do
  let last = i == len(parts) - 1
  let c = if last then TEXT elsif i == hot_crumb then ACCENT else DIM end
  text_at(parts[i], x: cbx, y: 46, st: {size: T_SMALL, color: c})
  if i == hot_crumb && !last then
    draw_line(x1: cbx, y1: 61, x2: cbx + text_w(parts[i], CRUMB), y2: 61,
      r: ACCENT.r, g: ACCENT.g, b: ACCENT.b, a: 200, width: 1)
  end
  cbx = cbx + text_w(parts[i], CRUMB)
  if !last then
    text_at("  >  ", x: cbx, y: 46, st: {size: T_SMALL, color: FAINT})
    cbx = cbx + sepw
  end
end

text_right("up/down pick   enter drill in   esc back   n/p month   t sort",
  right_x: W - PAD, y: 47, st: {size: T_MICRO, color: FAINT})
let mp_w = text_w(month_label, {size: T_MICRO}) + 18
let mp_c = if month < 0 then DIM else ACCENT end
draw_rect_rounded(rect(W - PAD - mp_w, 16, mp_w, 22), radius: 11, c: mp_c, a: 32)
text_at(month_label, x: W - PAD - mp_w + 9, y: 21, st: {size: T_MICRO, color: mp_c})

// ── KPI tiles ────────────────────────────────────────────────────────────────

let kw = (r_kpis.w - GAP * 3) / 4

if level == 0 then
  let inc = view.inc_total
  let spend = view.spend_total
  let net = inc - spend
  let rate = net / max(inc, 1.0) * 100.0
  let best = argmax_of(view.all_months)
  kpi_tile(kpi_rect(r_kpis, i: 0, kw: kw), label: "INCOME  12 MO", value: money(inc),
    sub: "avg " ++ money(inc / 12.0) ++ " per month", sub_c: DIM, series: view.income, c: POS, t: ease)
  kpi_tile(kpi_rect(r_kpis, i: 1, kw: kw), label: "SPENDING  12 MO", value: money(spend),
    sub: "avg " ++ money(spend / 12.0) ++ " per month", sub_c: DIM, series: view.all_months, c: NEG, t: ease)
  kpi_tile(kpi_rect(r_kpis, i: 2, kw: kw), label: "NET SAVED", value: money(net),
    sub: "heaviest month " ++ MONTHS[best], sub_c: DIM,
    series: for i in range(0, 12) do max(0.0, view.income[i] - view.all_months[i]) end,
    c: ACCENT, t: ease)
  kpi_tile(kpi_rect(r_kpis, i: 3, kw: kw), label: "SAVINGS RATE", value: pct(rate),
    sub: if rate >= 25.0 then "ahead of the 25% target" else "under the 25% target" end,
    sub_c: if rate >= 25.0 then POS else NEG end,
    series: for i in range(0, 12) do
      max(0.0, (view.income[i] - view.all_months[i]) / max(view.income[i], 1.0) * 100.0)
    end, c: AMBER, t: ease)
else
  let scope_total = sum_of(view.months)
  let share = scope_total / max(view.grand, 1.0) * 100.0
  let big = argmax_of(view.months)
  kpi_tile(kpi_rect(r_kpis, i: 0, kw: kw), label: upper(scope_name) ++ "  12 MO", value: money(scope_total),
    sub: if len(view.rows) == 1 then "1 transaction in view"
    else str(len(view.rows)) ++ " transactions in view" end,
    sub_c: DIM, series: view.months, c: scope_color, t: ease)
  let avg_note = if level == 2 then "over the last 12 months"
  else "across " ++ str(len(slices)) ++ " merchants" end
  kpi_tile(kpi_rect(r_kpis, i: 1, kw: kw), label: "MONTHLY AVERAGE", value: money(scope_total / 12.0),
    sub: avg_note, sub_c: DIM, series: view.months, c: scope_color, t: ease)
  kpi_tile(kpi_rect(r_kpis, i: 2, kw: kw), label: "HEAVIEST MONTH", value: money(max_of(view.months)),
    sub: MONTHS[big] ++ " " ++ YEAR, sub_c: DIM, series: view.months, c: scope_color, t: ease)
  kpi_tile(kpi_rect(r_kpis, i: 3, kw: kw), label: "SHARE OF SPENDING", value: pct(share),
    sub: "of " ++ money(view.grand) ++ " spent this year", sub_c: DIM,
    series: for i in range(0, 12) do
      view.months[i] / max(view.all_months[i], 1.0) * 100.0
    end, c: scope_color, t: ease)
end

// ── Donut card ───────────────────────────────────────────────────────────────

card(r_donut)
let d_title = if level == 0 then "SPENDING BY CATEGORY"
elsif level == 1 then upper(CATS[sel_cat].name) ++ " BY MERCHANT"
else "SHARE OF " ++ upper(CATS[sel_cat].name)
end
card_head(r_donut, title: d_title, note: if month < 0 then "12 months" else month_label end)

draw_donut(cx: dcx, cy: dcy, r_in: d_in, r_out: d_out, slices: slices, total: total, hot: hot_slice,
  sel: if hot_leg >= 0 then hot_leg else legend_sel end, t: ease)

let focus = if hot_slice >= 0 then hot_slice
elsif hot_leg >= 0 then hot_leg
elsif legend_sel < len(slices) then legend_sel
else -1
end
if focus >= 0 && len(slices) > 0 then
  let s = slices[focus]
  let p = s.value / max(total, 0.0001) * 100.0
  text_mid(pct(p), cx: dcx, y: dcy - 26, st: {size: T_HERO, color: s.color})
  text_mid(money(s.value), cx: dcx, y: dcy + 6, st: {size: T_SMALL, color: TEXT})
  text_mid(ellipsize(s.label, avail_px: d_in * 1.8, size: T_MICRO), cx: dcx, y: dcy + 22,
    st: {size: T_MICRO, color: DIM})
else
  text_mid(money(total), cx: dcx, y: dcy - 14, st: {size: T_HERO, color: TEXT})
  text_mid("total", cx: dcx, y: dcy + 16, st: {size: T_MICRO, color: DIM})
end

for i in range(0, len(slices)) do
  let s = slices[i]
  let lr = leg_rect(x: leg_x, y0: leg_y0, w: leg_w, i: i)
  let on = i == hot_leg || i == hot_slice || i == legend_sel
  if on then
    draw_rect_rounded(rect(lr.x - 7, lr.y + 1, lr.w + 10, lr.h - 2), radius: 6, c: RAISED)
  end
  draw_rect_rounded(rect(lr.x, lr.y + 9, 8, 8), radius: 2, c: s.color)
  let amt = money(s.value)
  let aw = text_w(amt, {size: T_SMALL})
  text_at(ellipsize(s.label, avail_px: lr.w - aw - 26, size: T_SMALL), x: lr.x + 16, y: lr.y + 6,
    st: {size: T_SMALL, color: if on then TEXT else DIM end})
  text_right(amt, right_x: lr.x + lr.w, y: lr.y + 6,
    st: {size: T_SMALL, color: if on then TEXT else FAINT end})
end

// ── Column chart card ────────────────────────────────────────────────────────

card(r_bars)
let b_title = if level == 0 then "MONTHLY SPENDING"
else upper(scope_name) ++ " BY MONTH" end
card_head(r_bars, title: b_title, note: "click a column to filter that month")
draw_columns(plot: bplot, vals: view.months, base_c: scope_color, hot: hot_col, marked: month, t: ease)

// ── Line chart card ──────────────────────────────────────────────────────────

card(r_line)
let l_body = card_head(r_line,
  title: if level == 0 then "CASH BALANCE" else "CUMULATIVE " ++ upper(scope_name) end,
  note: if level == 0 then "opening $4,200" else "vs. even pace" end)
let lplot = rect(l_body.x + 46, l_body.y + 14, l_body.w - 46, l_body.h - 40)

let base = if level == 0 then 4200.0 else 0.0 end
let net_months = for i in range(0, 12) do view.income[i] - view.all_months[i] end
let series = if level == 0 then cum(net_months) else cum(view.months) end
let vals = for v in series do v + base end
let lsc = axis_scale(max_of(vals) * 1.06, 5)
let hi = lsc.top
let vmin = min_of(vals)
let lo_n = if vmin < 0.0 then 0.0 - axis_scale(abs(vmin) * 1.15, 2).top else 0.0 end

for g in range(0, lsc.ndiv + 1) do
  let y = lplot.y + lplot.h * (1.0 - float(g) / float(lsc.ndiv))
  draw_line(x1: lplot.x, y1: y, x2: lplot.x + lplot.w, y2: y, r: GRID.r, g: GRID.g, b: GRID.b, a: 255, width: 1)
  text_right(axis_label(lerp(lo_n, hi, t: float(g) / float(lsc.ndiv)), lsc.step),
    right_x: lplot.x - 10.0, y: y - 6.0, st: {size: T_MICRO, color: FAINT})
end

let pts = for i in range(0, 12) do
  [lx(plot: lplot, i: i, n: 12), ly(plot: lplot, v: lo_n + (vals[i] - lo_n) * ease, lo: lo_n, hi: hi)]
end
area_under(plot: lplot, pts: pts, c: line_color, a_top: 80)

// The reference line: the opening balance at the top level, an even pace to
// the year's total once drilled in.
if level == 0 then
  let by = ly(plot: lplot, v: base, lo: lo_n, hi: hi)
  dashed(x0: lplot.x, y0: by, x1: lplot.x + lplot.w, y1: by, c: DIM, a: 110)
else
  dashed(x0: lplot.x, y0: ly(plot: lplot, v: 0.0, lo: lo_n, hi: hi),
    x1: lplot.x + lplot.w, y1: ly(plot: lplot, v: vals[11] * ease, lo: lo_n, hi: hi), c: DIM, a: 110)
end

polyline(pts, c: line_color, w: 2.0, a: 255)
for i in range(0, 12) do
  if i % 2 == 0 then
    text_mid(MONTHS[i], cx: pts[i][0], y: lplot.y + lplot.h + 9, st: {size: T_MICRO, color: FAINT})
  end
  let on = i == month
  draw_circle(center: {x: pts[i][0], y: pts[i][1]}, radius: if on then 5.0 else 2.5 end,
    c: if on then WHITE else line_color end)
end
text_at(if level == 0 then "closing " ++ money(vals[11])
else "year to date " ++ money(vals[11]) end,
  x: lplot.x + 4, y: lplot.y - 12, st: {size: T_MICRO, color: DIM})

// ── Transactions card ────────────────────────────────────────────────────────

card(r_table)
let sort_note = if sort_mode == 0 then "newest first  ·  t sorts by amount"
else "largest first  ·  t sorts by date" end
card_head(r_table, title: "TRANSACTIONS  " ++ str(len(view.rows)), note: sort_note)

let col_date = tplot.x
let col_desc = tplot.x + 76
let col_cat = tplot.x + tplot.w - 252
let col_amt = tplot.x + tplot.w - 14

let HDR = {size: T_MICRO, color: FAINT, spacing: 1.2}
text_at("DATE", x: col_date, y: tplot.y + 2, st: HDR)
text_at("MERCHANT", x: col_desc, y: tplot.y + 2, st: HDR)
text_at("CATEGORY", x: col_cat, y: tplot.y + 2, st: HDR)
text_right("AMOUNT", right_x: col_amt, y: tplot.y + 2, st: HDR)
draw_line(x1: tplot.x, y1: tplot.y + 18, x2: tplot.x + tplot.w, y2: tplot.y + 18,
  r: HAIRLINE.r, g: HAIRLINE.g, b: HAIRLINE.b, a: 255, width: 1)

clip(x: int(t_view.x) - 8, y: int(t_view.y), w: int(t_view.w) + 16, h: int(t_view.h))
for i in range(0, t_rows_visible) do
  let idx = table_scroll + i
  if idx < len(view.rows) then
    let t = view.rows[idx]
    let ry = t_view.y + i * TROW
    if idx == hot_row then
      draw_rect_rounded(rect(t_view.x - 7, ry, t_view.w + 14, TROW), radius: 5, c: RAISED)
    elsif idx % 2 == 1 then
      draw_rect(x: t_view.x - 7, y: ry, w: t_view.w + 14, h: TROW, r: RAISED.r, g: RAISED.g, b: RAISED.b, a: 80)
    end
    let c = CATS[t.cat]
    let mname = c.merchants[t.mer].name
    text_at(MONTHS[t.m] ++ " " ++ str(t.day), x: col_date, y: ry + 5,
      st: {size: T_SMALL, color: FAINT})
    text_at(ellipsize(mname, avail_px: col_cat - col_desc - 18, size: T_SMALL), x: col_desc, y: ry + 5,
      st: {size: T_SMALL, color: TEXT})
    draw_rect_rounded(rect(col_cat, ry + 8, 8, 8), radius: 2, c: c.color)
    text_at(c.name, x: col_cat + 16, y: ry + 5, st: {size: T_SMALL, color: DIM})
    text_right(money_cents(t.amt), right_x: col_amt, y: ry + 5, st: {size: T_SMALL, color: TEXT})
  end
end
clip_none()
if len(view.rows) == 0 then
  text_at("no transactions in this scope", x: tplot.x, y: t_view.y + 14,
    st: {size: T_SMALL, color: FAINT})
end
draw_scrollbar(t_view, count: len(view.rows), rows: t_rows_visible, scroll: table_scroll)
