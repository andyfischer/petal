// bloom — a component library written entirely in Petal.
//
// This file is the front door. Import it and you have the whole library:
//
//     import bloom                      // bloom.button(r, "Save")
//     import bloom: button, dropdown    // button(r, "Save")
//
// It is a facade: every line below re-exports a whole implementation module,
// so the implementation stays in small files and an app never has to know
// which one a component lives in. Import an individual module instead when you
// want only a slice of it (`import bloom/motion: spring` in a game's HUD).
//
// bloom sits on top of `petal-ui`'s host layer — the input and draw natives
// and the `ui` prelude's primitives — and adds a component layer with its own
// theme, its own interaction model (press-and-release clicks, one open menu,
// input capture for overlays), and animation in every component by default.
// It is pure Petal: no Rust, no assets. Put the library on the module path
// (`-I petal-libs`, `PETAL_PATH`) or register it with `env.add_package` /
// `env.register_package`, and it works in any host that embeds petal-ui.
//
// `petal.toml` at the library root is what makes the paths below work: the
// package is named `bloom`, so its modules answer to `bloom/<name>` wherever
// the directory sits, and this file — named like its package — is what a bare
// `import bloom` finds.

// `export import m: *` re-exports every export of `m` under its own name, and
// carries whole overload sets across, so `bloom.button` has both of
// bloom/button's arities. This replaced 130 hand-written `export let x = m.x`
// lines; adding an export to a module now publishes it here with no edit.
export import bloom/motion: *
export import bloom/theme: *
export import bloom/icon: *
export import bloom/interact: *
export import bloom/button: *
export import bloom/controls: *
export import bloom/menu: *
export import bloom/overlay: *

// Two names the facade spells differently from the module that defines them:
// `on` and `NAMES` are clear inside `bloom/theme` and `bloom/icon`, and much
// too generic out here. A star binds locally as well as re-exporting, so the
// aliases are ordinary declarations over what the stars just brought in.
export let ink_on = on
export let ICONS = NAMES

// Bumped when the export surface grows. Additive: a script written against an
// older level keeps working. Level 2 is what the star re-exports published on
// their own: `step` and `capture_owner`, two exports the hand-written facade
// had been missing.
export let VERSION = 2
