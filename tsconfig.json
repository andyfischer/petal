{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    // tools/*.ts run under Node's native type stripping (see their shebangs),
    // which resolves specifiers literally and so requires the `.ts` extension
    // that `import ... from './example-corpus.ts'` carries. Safe with noEmit.
    "allowImportingTsExtensions": true,
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": ["tools/*.ts", "test/vitest/**/*.ts"],
  // The MCP servers import packages that only tools/package.json installs;
  // `npm run tsc` in tools/ checks them.
  "exclude": ["tools/petal-mcp.ts", "tools/petal-diagram-mcp.ts"]
}
