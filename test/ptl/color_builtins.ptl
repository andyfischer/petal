// The color constructors: `hsv` / `hsl` take a hue in [0, 1), and the `_deg`
// forms take it in degrees. Run with `petal test test/ptl`.

import color

let RED = {r: 255, g: 0, b: 0}
let GREEN = {r: 0, g: 255, b: 0}
let BLUE = {r: 0, g: 0, b: 255}

test "hsv: hue 0 is red, 1/3 green, 2/3 blue" do
  expect_eq(hsv(0.0, 1.0, 1.0), RED)
  expect_eq(hsv(1.0 / 3.0, 1.0, 1.0), GREEN)
  expect_eq(hsv(2.0 / 3.0, 1.0, 1.0), BLUE)
end

test "hsv: hue 0.5 is cyan" do
  expect_eq(hsv(0.5, 1.0, 1.0), {r: 0, g: 255, b: 255})
end

test "hsv: hue wraps past 1.0" do
  expect_eq(hsv(1.0, 1.0, 1.0), hsv(0.0, 1.0, 1.0))
end

test "hsl: hue 0 is red and 1/3 is green at half lightness" do
  expect_eq(hsl(0.0, 1.0, 0.5), RED)
  expect_eq(hsl(1.0 / 3.0, 1.0, 0.5), GREEN)
end

test "hsv_deg and hsl_deg take degrees" do
  expect_eq(hsv_deg(120.0, 1.0, 1.0), GREEN)
  expect_eq(hsv_deg(240.0, 1.0, 1.0), BLUE)
  expect_eq(hsl_deg(120.0, 1.0, 0.5), GREEN)
end

test "hsv_deg(h) is hsv(h / 360)" do
  expect_eq(hsv_deg(200.0, 0.6, 0.8), hsv(200.0 / 360.0, 0.6, 0.8))
end
