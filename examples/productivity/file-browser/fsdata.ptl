// Burrow: the virtual filesystem's seed data and the pure helpers over it.
//
// Nothing here touches a disk. The whole tree is a flat list of node records,
// built once from the SEED lines below, and a node's id is its index in that
// list for the life of the session:
//
//   {id, name, parent, dir, size, mt, from, doc}
//
// `parent` is another node's id (-1 for the two roots, GONE once deleted for
// good), `mt` is minutes since 2024-01-01, `from` is where a trashed node
// came from, and `doc` names the entry in DOCS that holds its text, if any.

pub let HOME = 0
pub let TRASH = 1
pub let GONE = -9

// "Now" is fixed, so the dates on screen are the same on every run:
// Friday 9 October 2026, 2:30 PM.
pub let TODAY = 1012
pub let NOW = 1012 * 1440 + 14 * 60 + 30

// path | size | days ago | time of day. A folder is made the first time a
// path walks through it. Lines under "Trash/" carry a fifth field: the
// folder they were thrown away from.
