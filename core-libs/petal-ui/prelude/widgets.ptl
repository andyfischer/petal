# petal-ui widgets — module `ui/widgets` (deprecated)
#
# The drawn widgets: buttons, scrollbars, text fields and areas, context
# menus and popovers, checkboxes, sliders, inspector fields, tab bars,
# tooltips, modals, badges and cards, splitters, tables and the load view.
# bloom (core-runtime/bloom) owns the widgets now, and every name here has a
# bloom replacement; `petal lint` rule `ui-widget-moved` names it at each
# call. `ui` still re-exports these during the deprecation period. Add
# nothing here: new widgets go in bloom. The parts that draw nothing (focus,
# list state, text editing, drag and drop, the load state) are `ui/interaction`.

import ./interaction
import ./input
import ./_native
import ./_style
import ./_frame
import ./draw
import ./hit
import ./text
import ./layout

# ── Animated flags ──────────────────────────────────────────────────────────

# A per-callsite animated value easing toward `target`: the widget-internal
# building block behind hover/press/check transitions. First call snaps (no
# fade-in out of nowhere on first frame or hot reload).
fn _anim(target, rate)
  state v = -1.0
  if v < 0.0 then
    v = float(target)
  else
    v = approach(v, float(target), rate)
  end
  v
end

# 0→1 as `on` flips true/false, eased at `rate`. One instance per callsite
# (and per loop iteration), like every in-function `state`.
fn _anim_flag(on, rate)
  _anim(if on then 1.0 else 0.0 end, rate)
end


# ── Button (immediate-mode): draws, returns true on click this frame ─────


pub fn button(r, label)
  button(r, label, {})
end

# `style` overrides any of {bg, hover, fg, outline, size, font, radius,
# gradient, gradient_angle, elevation}; anything it omits comes from
# `ui_theme()`. A `{}` style is the themed button. The face eases between its
# resting and hover colors (~120ms) and dips toward black while pressed; at
# rest it paints exactly the resting color, so a still frame is
# pixel-identical to the pre-animation button.
#
# `gradient: [c0, c1]` fills the face with a two-stop ramp instead of a flat
# colour — the primary-action button, where a flat fill reads as inert. The
# hover and press states still apply, as a lightening and a darkening of both
# stops, so the whole ramp reacts together. `elevation: 1` (or 2) casts the
# shared elevation shadow under it.
pub fn button(r, label, style)
  let t = _palette()
  # Registered under `style.id`, or its label: `ui_target_rect("Save")`.
  let hot = _hot(r, style["id"] ?? label)
  let hov = _anim_flag(hot, 16.0)
  let press = hot && mouse_down(0)
  let rad = _get(style, "radius", 0)
  let lift = _get(style, "elevation", 0)
  if lift > 0 && !press then
    draw_elevation(r, rad, lift)
  end
  let outline = _get(style, "outline", t.outline)
  # A rounded button's border is the rounded rect *behind* its face, inset by
  # one pixel — the same trick `card` uses, since there is no rounded-outline
  # primitive. A square one keeps the outline command it always drew.
  let face = r
  if rad > 0 then
    draw_rect_rounded(r, rad, outline)
    face = pad(r, 1)
  end
  let grad = _get(style, "gradient", [])
  if len(grad) < 2 then
    let bg = mix(_get(style, "bg", t.panel), _get(style, "hover", t.hover), hov)
    if press then
      bg = mix(bg, :000000, 0.18)
    end
    if rad > 0 then
      draw_rect_rounded(face, max(0, rad - 1), bg)
    else
      draw_rect(face, bg)
      draw_rect_outline(r, outline)
    end
  else
    # Both stops take the same hover lift and press dip, so the ramp keeps its
    # shape through the interaction instead of flattening at one end.
    let stops = []
    for c in grad do
      let s = mix(c, t.text, hov * 0.10)
      if press then
        s = mix(s, :000000, 0.18)
      end
      stops = append(stops, s)
    end
    linear_gradient(face, stops, _get(style, "gradient_angle", GRAD_DOWN), max(0, rad - 1))
    if rad == 0 then
      draw_rect_outline(r, outline)
    end
  end
  let size = _get(style, "size", t.font_md)
  let ts = _ts(_face(t, style), size, _get(style, "fg", t.text))
  # Measured and drawn with the one record: a centred label that measures in
  # a different face than it draws in is off by a fifth of its width.
  let tx = r.x + (r.w - text_width(label, ts)) / 2
  let ty = r.y + (r.h - size) / 2
  draw_text(label, {x: tx, y: ty}, ts)
  hot && mouse_pressed(0)
end


# ── Scrollbar ─────────────────────────────────────────────────────────────

# Proportional scrollbar thumb along the right edge of scroll region `r`.
# `count` is the total row count, `rows` the visible rows, `scroll` the current
# top offset (as fed to list_update / scroll_update). Draws nothing when the
# content fits (count <= rows); otherwise a dim track with an accent-neutral
# thumb sized rows/count of the track and positioned by scroll/(count - rows).
pub fn draw_scrollbar(r, count, rows, scroll)
  draw_scrollbar(r, count, rows, scroll, {})
end

# `style` overrides any of {track, thumb, width}; omitted keys come from
# `ui_theme()`.
pub fn draw_scrollbar(r, count, rows, scroll, style)
  if count > rows then
    let t = _palette()
    let bar_w = _get(style, "width", 4)
    let track = {x: r.x + r.w - bar_w, y: r.y, w: bar_w, h: r.h}
    draw_rect(track, _get(style, "track", t.outline))
    let thumb_h = max(12, r.h * rows / count)
    let thumb_y = track.y + (r.h - thumb_h) * scroll / (count - rows)
    draw_rect({x: track.x, y: thumb_y, w: bar_w, h: thumb_h}, _get(style, "thumb", t.dim))
  end
end


# ── Section label ─────────────────────────────────────────────────────────
# A section heading that shows which region owns the keyboard: accent-colored
# with an underline when `active`, dim otherwise. Pairs with the focus
# registry — pass `has_focus(id)` as `active` to label each focusable region.
pub fn section_label(label, x, y, active)
  section_label(label, x, y, active, {})
end

# `style` overrides any of {active, inactive, size, font}; omitted keys come
# from `ui_theme()`.
pub fn section_label(label, x, y, active, style)
  let t = _palette()
  let size = _get(style, "size", t.font_md)
  let color = if active then _get(style, "active", t.accent) else _get(style, "inactive", t.dim) end
  let ts = _ts(_face(t, style), size, color)
  draw_text(label, {x: x, y: y}, ts)
  if active then
    # The underline is exactly as wide as the run, so it has to measure the
    # style the run was drawn in.
    let uy = y + size + 1
    draw_line({x: x, y: uy}, {x: x + text_width(label, ts), y: uy}, color)
  end
end


# ── Text field (immediate-mode, focus-aware) ────────────────────────────────
# Single-line editable text with a caret, a selection, the clipboard and
# undo. State is the plain string `buf` (keep it in `state`); focus lives in
# a separate focus record; the caret, the selection and the history live in
# widget-internal `state`, keyed per callsite like every other in-function
# state.
#
#   let res = text_field("name", r, buf)
#   buf = res.text
#   if res.submitted then ... end
#
# Mouse: a click focuses the field and places the caret, shift+click extends
# the selection to the click, a drag selects, a double click selects the
# word and a triple click everything. A press anywhere else gives the focus
# up, unless a higher layer took it.
#
# Keys, while focused (cmd and ctrl are interchangeable for the shortcuts):
#   left / right / home / end     move the caret; with shift, extend the selection
#   alt or ctrl + left / right    by word;  cmd + left / right  to either end
#   backspace / delete            the selection, else one character
#   alt or ctrl + backspace       back to the start of the word
#   cmd + backspace               back to the start of the field
#   cmd + a                       select all
#   cmd + c / x / v               copy, cut, paste (`clipboard_get` / `clipboard_set`)
#   cmd + z,  cmd + shift + z or cmd + y     undo, redo
#   return                        sets `submitted`
#   escape                        sets `cancelled` (the field keeps the focus;
#                                 a caller that reverts drops it)
# Typing replaces the selection. A run of typing undoes as one step, a word
# at a time. Pasted text loses its line breaks (the field is one line).
#
# Returns {text, caret, submitted, changed, anchor, sel_start, sel_end,
# scroll, overflow, blurred, cancelled}. `blurred` is true on the frame after
# the field lost the keyboard (a click elsewhere, Tab, a `focus_request`), the
# cue to apply an edit on blur; `commit_field` below does exactly that.
# `caret` and the selection are character offsets;
# `sel_start == sel_end` means nothing is selected, and `anchor` is the end of
# the selection that is not the caret. When `buf` is not what the field last
# returned (the app cleared or replaced it), the history is dropped: it
# described a different string.


# The draw half. `has` is whether the field holds focus (draws the accent
# border and the caret). Without an explicit caret the bar sits at the end of
# the text, which is what the pre-caret prelude always drew.
pub fn draw_text_field(r, text, has)
  draw_text_field(r, text, has, char_len(text), {}, {})
end

# `style` overrides any of {bg, fg, outline, focus, caret, selection, size,
# font, inset, text_style, placeholder}; omitted keys come from `ui_theme()`.
# `placeholder` is drawn dim while the field is empty.
pub fn draw_text_field(r, text, has, style)
  draw_text_field(r, text, has, char_len(text), {}, style)
end

# `caret` is the char index the caret bar is drawn at (clamped).
pub fn draw_text_field(r, text, has, caret, style)
  draw_text_field(r, text, has, caret, {}, style)
end

# Full form. `view` carries what `text_field_update` returned beyond the
# caret — any of {sel_start, sel_end, scroll, overflow} — so passing its whole
# result works: the selection is painted behind the text, and a field whose
# text overflows is clipped and shifted by `scroll`.
pub fn draw_text_field(r, text, has, caret, view, style)
  let t = _palette()
  let accent = _get(style, "focus", t.accent)
  let bg = _get(style, "bg", t.panel)
  draw_rect(r, bg)
  let border = if has then accent else _get(style, "outline", t.outline) end
  draw_rect_outline(r, border)
  let size = _get(style, "size", t.font_md)
  let ts = _get(style, "text_style", _ts(_face(t, style), size, _get(style, "fg", t.text)))
  let tsize = _get(ts, "size", size)
  let tx = r.x + _get(style, "inset", 6) - _get(view, "scroll", 0)
  let ty = r.y + (r.h - tsize) / 2
  let clipped = _get(view, "overflow", false)
  if clipped then
    clip_push({x: r.x + 1, y: r.y, w: r.w - 2, h: r.h})
  end
  let n = char_len(text)
  let s0 = clamp(_get(view, "sel_start", 0), 0, n)
  let s1 = clamp(_get(view, "sel_end", 0), 0, n)
  if has && s0 < s1 then
    let x0 = text_width(char_slice(text, 0, s0), ts)
    let x1 = text_width(char_slice(text, 0, s1), ts)
    draw_rect({x: tx + x0, y: ty - 2, w: x1 - x0, h: tsize + 4}, _get(style, "selection", tint(bg, accent, 35)))
  end
  let placeholder = _get(style, "placeholder", "")
  if n == 0 && placeholder != "" then
    draw_text(placeholder, {x: tx, y: ty}, {...ts, color: t.dim})
  end
  draw_text(text, {x: tx, y: ty}, ts)
  if has then
    # The caret sits where the drawn run actually ends, so it measures the
    # same style — this is the one place a face mismatch is visible as a
    # caret drifting away from the text it is inside.
    let c = clamp(caret, 0, n)
    let cx = tx + text_width(char_slice(text, 0, c), ts)
    draw_line({x: cx, y: ty}, {x: cx, y: ty + tsize}, _get(style, "caret", accent))
  end
  if clipped then
    clip_pop()
  end
end

pub fn text_field(id, r, buf)
  text_field(id, r, buf, {})
end

pub fn text_field(id, r, buf, style)
  let res = text_field_update(id, r, buf, {...style, scroll: true})
  draw_text_field(r, res.text, has_focus(id), res.caret, res, style)
  res
end


# ── Text area (immediate-mode, focus-aware, multi-line) ─────────────────────
# `text_field` for text with line breaks: captions, notes, a chat message.
# The text wraps to the box (`text_wrap_rows`), Return starts a new line, and
# a box whose text is taller than it scrolls with the wheel and follows the
# caret. Everything else is the field's: focus, selection, the clipboard
# (line breaks kept) and undo, a run of typing undone a word at a time.
#
#   state notes = ""
#   let res = text_area("notes", r, notes)
#   notes = res.text
#
# Mouse: as `text_field` — click, shift+click, drag, double click (word),
# triple click (everything), a press elsewhere gives the focus up — plus the
# wheel over the box.
#
# Keys, while focused, beyond the field's:
#   up / down                     a row up or down, keeping the column
#   cmd + up / down               to the start or end of the text
#   home / end, cmd + left / right    to the start or end of the row
#   return                        a line break (there is no `submitted`)
#
# Returns {text, caret, changed, anchor, sel_start, sel_end, scroll,
# overflow, rows, line_h, content_h}: `rows` is the wrap (`text_wrap_rows`
# rows relative to the text), `scroll` how many pixels the text is shifted
# up, `content_h` its whole height.

# A copy of ui/interaction's private helper: the caret's rect in the
# wrapped rows. It goes when this module does.
# Where a caret at character `at` sits: {x, y, row}, from the rows' top-left.
fn _area_caret(rows, ts, at, lh)
  let i = text_row_of(rows, at)
  let row = rows[i]
  let x = text_width(char_slice(row.text, 0, clamp(at - row.start, 0, row.end - row.start)), ts)
  {x: x, y: i * lh, row: i}
end


# The draw half: the box, the selection, the rows, the caret and, when the
# text overflows, a scrollbar. `res` is what `text_area_update` returned (or
# a record with the same fields). `style` overrides any of {bg, fg, outline,
# focus, caret, selection, size, font, inset, text_style, placeholder}.
pub fn draw_text_area(r, res, has)
  draw_text_area(r, res, has, {})
end

pub fn draw_text_area(r, res, has, style)
  let t = _palette()
  let accent = _get(style, "focus", t.accent)
  let bg = _get(style, "bg", t.panel)
  draw_rect(r, bg)
  draw_rect_outline(r, if has then accent else _get(style, "outline", t.outline) end)
  let size = _get(style, "size", t.font_md)
  let ts = _get(style, "text_style", _ts(_face(t, style), size, _get(style, "fg", t.text)))
  let tsize = _get(ts, "size", size)
  let inset = _get(style, "inset", 6)
  let lh = res.line_h
  let rows = res.rows
  let ox = r.x + inset
  let top = r.y + inset - res.scroll
  clip_push({x: r.x + 1, y: r.y + 1, w: r.w - 2, h: r.h - 2})
  if has && res.sel_start < res.sel_end then
    let sel = _get(style, "selection", tint(bg, accent, 35))
    for sr in text_range_rects(rows, ts, res.sel_start, res.sel_end, lh) do
      draw_rect({x: ox + sr.x, y: top + sr.y, w: sr.w, h: sr.h}, sel)
    end
  end
  let placeholder = _get(style, "placeholder", "")
  if char_len(res.text) == 0 && placeholder != "" then
    draw_text(placeholder, {x: ox, y: top + (lh - tsize) / 2}, {...ts, color: t.dim})
  end
  for i in range(0, len(rows)) do
    let y = top + i * lh
    if y + lh > r.y && y < r.y + r.h then
      draw_text(rows[i].text, {x: ox, y: y + (lh - tsize) / 2}, ts)
    end
  end
  if has then
    let c = _area_caret(rows, ts, res.caret, lh)
    let cx = ox + c.x
    draw_line({x: cx, y: top + c.y + 1}, {x: cx, y: top + c.y + lh - 1}, _get(style, "caret", accent))
  end
  clip_pop()
  if res.overflow then
    let inner_h = r.h - 2 * inset
    draw_scrollbar({x: r.x, y: r.y + 1, w: r.w - 1, h: r.h - 2}, res.content_h, inner_h, res.scroll)
  end
end

pub fn text_area(id, r, buf)
  text_area(id, r, buf, {})
end

pub fn text_area(id, r, buf, style)
  let res = text_area_update(id, r, buf, style)
  draw_text_area(r, res, has_focus(id), style)
  res
end


# ── Context menu (immediate-mode dropdown) ─────────────────────────────────
# A right-click menu. State is an explicit record so several menus coexist and
# it survives hot reload:
#
#   state menu = menu_state()
#   ...
#   menu = menu_open_on_right_click(menu, row_rect, "row:{i}")
#   ...
#   // near the BOTTOM, so it draws over everything else:
#   let picked = context_menu(menu, [menu_item("Copy"), menu_sep(),
#                                    menu_item("Delete", false)])
#   menu = picked.menu
#   if picked.index >= 0 then ...act on picked.label / picked.tag... end
#
# Draw it late, so it sits over the rest. An open menu is modal, and the
# runtime closes it (Escape, a press outside) before the frame runs
# (core-libs/petal-ui/src/popover.rs), so the press that closes it reaches
# no widget under it. Code that reads the mouse itself (`mouse_pressed`
# and `point_in`) is not covered by that, and stands down while `menu.open`.
#
# At most one menu or popover is open at a time: opening one closes the
# others. While one is open, `shortcut(chord)` is quiet.
#
# `tag` is any value you want handed back with the choice — the row the menu
# was opened on, typically. It is never interpreted here.

# One menu row. `enabled: false` draws dim and cannot be chosen.
pub fn menu_item(label)
  menu_item(label, true)
end

pub fn menu_item(label, enabled)
  {label: label, enabled: enabled, sep: false}
end

# A divider rule between groups of items. Never hoverable or choosable.
pub fn menu_sep()
  {label: "", enabled: false, sep: true}
end

# Each menu record has its own popover id, made once where it is created
# (`state menu = menu_state()`), so several menus coexist. `live` is whether
# the runtime has opened it yet: a menu shown this frame is drawn at once,
# and takes input from the next frame, after the roll has applied its open
# request. That is why the press that opened it cannot close it.
state var _pop_seq = 0
fn _pop_new_id()
  set _pop_seq = (get _pop_seq) + 1
  "menu-" ++ str(get _pop_seq)
end

pub fn menu_state()
  {open: false, x: 0, y: 0, tag: "", hover: -1, id: _pop_new_id(), live: false, waited: false}
end

# A record made before menus had ids shares the one id "menu".
fn _menu_id(m)
  str(_get(m, "id", "menu"))
end

pub fn menu_close(m)
  if m.open then _ui_popover_request(false, _menu_id(m)) end
  {...m, open: false, x: 0, y: 0, hover: -1, live: false, waited: false}
end

# Open (or move) the menu to `(x, y)`, remembering `tag`. Hover starts on
# nothing, so a menu opened under the pointer highlights only once it moves.
pub fn menu_show(m, x, y, tag)
  _ui_popover_request(true, _menu_id(m))
  {...m, open: true, x: x, y: y, tag: tag, hover: -1, live: popover_shown(_menu_id(m)), waited: false}
end

# The common trigger: a right press inside `r` opens the menu at the pointer.
# Any other frame leaves the state alone, so this is safe to call every frame
# for every row.
pub fn menu_open_on_right_click(m, r, tag)
  if mouse_pressed(1) && _over(r) then
    menu_show(m, mouse_x(), mouse_y(), tag)
  else
    m
  end
end

let _MENU_ROW_H = 24
let _MENU_SEP_H = 9
let _MENU_PAD = 6
let _MENU_SIZE = 14

# The menu's metrics, with a style record's overrides applied. Exported so an
# app that draws its own menu chrome measures with the same numbers the
# prelude lays out with instead of copying the constants (which is exactly
# what two testbed apps had to do, and what silently rots when these change).
pub fn menu_metrics()
  menu_metrics({})
end

pub fn menu_metrics(style)
  {
    row_h: _get(style, "row_h", _MENU_ROW_H),
    sep_h: _get(style, "sep_h", _MENU_SEP_H),
    pad: _get(style, "pad", _MENU_PAD),
    size: _get(style, "size", _MENU_SIZE),
    # The face travels with the metrics because the width the menu sizes
    # itself to is measured in it — a menu measured in one face and drawn in
    # another is either padded or clipped.
    font: _face(_palette(), style)
  }
end

fn _menu_row_h(item, mm)
  if item.sep then mm.sep_h else mm.row_h end
end

# Total height of `items` plus the frame's own vertical padding.
fn _menu_h(items, mm)
  let h = mm.pad * 2
  for it in items do
    h = h + _menu_row_h(it, mm)
  end
  h
end

# Width that fits the widest label, clamped so a very long one does not run
# off the screen and a very short menu is still comfortably clickable.
fn _menu_w(items, mm)
  let widest = 0
  let ts = _tm(mm.font, mm.size)
  for it in items do
    let tw = text_width(it.label, ts)
    if !it.sep && tw > widest then
      widest = tw
    end
  end
  # The `clamp` builtin preserves int-ness (it used to return a float, which is
  # why this went through a private `_clamp` for years) and this feeds pixel
  # geometry that has to stay integral.
  clamp(widest + 28, 120, max(140, screen_width() - 24))
end

# Where the menu actually lands: it prefers down-and-right of the click, and
# flips to the other side of the pointer when that would put it off-screen —
# so a right-click near the bottom edge opens upward instead of being clipped.
#
# EXPORTED because the flip rule is not something an app can guess: a panel
# that has to know where the menu will be — to suppress its own hover, to skip
# drawing text under it, to scroll it into view — otherwise reimplements this
# function *and* the four metric constants above, and the copy drifts the
# moment either changes. `context_menu` also hands the same rect back as
# `.rect` in its result, for the common case of "where did the open menu land".
pub fn menu_rect(m, items)
  menu_rect(m, items, {})
end

pub fn menu_rect(m, items, style)
  let mm = menu_metrics(style)
  let w = _menu_w(items, mm)
  let h = _menu_h(items, mm)
  let x = m.x
  let y = m.y
  if x + w > screen_width() then
    x = max(0, m.x - w)
  end
  if y + h > screen_height() then
    y = max(0, m.y - h)
  end
  {x: x, y: y, w: w, h: h}
end

# Index of the choosable item at pane-local `(px, py)`, or -1. Separators and
# disabled rows are transparent to this, so neither can be picked.
fn _menu_hit(r, items, px, py, mm)
  let hit = -1
  let y = r.y + mm.pad
  for i in range(0, len(items)) do
    let it = items[i]
    let rh = _menu_row_h(it, mm)
    if !it.sep && it.enabled && px >= r.x && px < r.x + r.w && py >= y && py < y + rh then
      hit = i
    end
    y = y + rh
  end
  hit
end

# Step the keyboard highlight `from` by `step`, skipping separators and
# disabled rows, and stopping at the ends rather than wrapping (a menu is
# short enough that wrapping reads as a glitch). -1 means "nothing yet", so
# the first Down lands on the first choosable row.
fn _menu_step(items, from, step)
  let i = from + step
  if from < 0 && step < 0 then
    i = len(items) - 1
  end
  let found = from
  while i >= 0 && i < len(items) && found == from do
    if !items[i].sep && items[i].enabled then
      found = i
    end
    i = i + step
  end
  found
end

# Draw the menu and resolve this frame's input. Returns
# {menu, index, label, tag, rect}: `index` is -1 unless something was chosen,
# `tag` is whatever was passed to `menu_show` / `menu_open_on_right_click`, and
# `rect` is where the menu landed this frame (an empty rect when closed) — so a
# panel can keep its own painting out from under the menu without recomputing
# the geometry. A closed menu draws nothing and always returns index -1.
pub fn context_menu(m, items)
  context_menu(m, items, {})
end

# `style` overrides any of {bg, fg, dim, outline, rule, selection, shadow,
# radius, size, font, row_h, sep_h, pad}; omitted keys come from `ui_theme()`
# and the menu metrics.
pub fn context_menu(m, items, style)
  let id = _menu_id(m)
  let shown = popover_shown(id)
  # Open in the record but not in the runtime, after it was live or after
  # a frame of waiting: Escape, a press outside, or another menu closed it.
  let gone = m.open && !shown && (_get(m, "live", false) || _get(m, "waited", false))
  if gone then
    {menu: {...m, open: false, x: 0, y: 0, hover: -1, live: false, waited: false},
     index: -1, label: "", tag: m.tag, rect: {x: 0, y: 0, w: 0, h: 0}}
  elsif !m.open || len(items) == 0 then
    {menu: m, index: -1, label: "", tag: m.tag, rect: {x: 0, y: 0, w: 0, h: 0}}
  else
    let t = _palette()
    let mm = menu_metrics(style)
    let r = menu_rect(m, items, style)
    let mx = mouse_x()
    let my = mouse_y()
    let inside = point_in(mx, my, r)
    # Input is the menu's once the runtime has it open — see `menu_state`.
    let live = shown

    # Pointer hover wins over the keyboard highlight the moment the pointer
    # *moves* over a row — the two share one `hover`, so the menu never shows
    # two of them. A resting pointer does not win: the menu opens under it,
    # so without this rule Down, Down, Return picked row 0 every time, both
    # for a person who reached for the arrow keys and for a headless test
    # driving the menu by keys.
    let hover = m.hover
    let over = _menu_hit(r, items, mx, my, mm)
    let moved = mx != (m.px ?? -1) || my != (m.py ?? -1)
    if inside && over >= 0 && (moved || hover < 0) then
      hover = over
    end
    if key_pressed("down") then
      hover = _menu_step(items, hover, 1)
    end
    if key_pressed("up") then
      hover = _menu_step(items, hover, -1)
    end

    # Resolve: a press on a choosable row takes it, Return takes the
    # highlighted one, and a press on the rest of the menu closes it. A press
    # outside and Escape are the runtime's: it has already closed the menu.
    let chosen = -1
    let close = false
    if live then
      if mouse_pressed(0) || mouse_pressed(1) then
        if inside && over >= 0 then
          chosen = over
        end
        close = true
      end
      if key_pressed("return") && hover >= 0 then
        chosen = hover
        close = true
      end
      if key_pressed("escape") then
        close = true
      end
    end

    # Drawn after the input so the highlight reflects this frame's pointer.
    # A soft drop shadow lifts the menu off whatever it covers; without it a
    # dark menu over a dark panel reads as part of the background. It is the
    # shared elevation-2 shadow, so a menu, a popover and a dropdown all sit
    # at the same height under the same light.
    let bg = _get(style, "bg", t.panel)
    let fg_on = _get(style, "fg", t.text)
    # A disabled row is its own ink at 40% over the menu's surface — an
    # opaque colour, so it is the same grey whether or not the row under it
    # was highlighted first.
    let fg_off = _get(style, "dim", tint(bg, fg_on, 40))
    let outline = _get(style, "outline", t.outline)
    let rad = _get(style, "radius", 0)
    # On the popup layer, outside every clip, and modal while it is open: the
    # menu draws over whatever was drawn after it, a menu opened from a row
    # of a scrolled list is not cut off by the list, and the press that
    # dismisses it is not also a click on the widget underneath.
    ui_overlay(max(ui_layer(), UI_LAYER_POPUP), fn()
      # Not on the frame it closes: the registry is what the *next* frame is
      # tested against, and by then the menu is gone.
      if !close then
        ui_modal()
        # Under its popover id, which is what the runtime tests a press
        # against; a style id names it for tests too.
        _reg(r, id)
        let sid = _get(style, "id", nil)
        if sid != nil then ui_target(sid, r) end
      end
      draw_elevation(r, rad, 2, {color: _get(style, "shadow", :000000)})
      draw_rect(r, bg)
      draw_rect_outline(r, outline)
      let rule = _get(style, "rule", hairline(bg, fg_on))
      let y = r.y + mm.pad
      for i in range(0, len(items)) do
        let it = items[i]
        let rh = _menu_row_h(it, mm)
        if it.sep then
          let sy = y + rh / 2
          draw_line({x: r.x + 8, y: sy}, {x: r.x + r.w - 8, y: sy}, rule)
        else
          let fg = if it.enabled then fg_on else fg_off end
          if i == hover then
            draw_rect({x: r.x + 1, y: y, w: r.w - 2, h: rh}, _get(style, "selection", t.selection))
            fg = fg_on
          end
          draw_text(it.label, {x: r.x + 12, y: y + (rh - mm.size) / 2}, _ts(mm.font, mm.size, fg))
        end
        y = y + rh
      end
    end)

    let next = if close then menu_close(m) else {...m, hover: hover, px: mx, py: my, live: live, waited: true} end
    let label = if chosen >= 0 then items[chosen].label else "" end
    {menu: next, index: chosen, label: label, tag: m.tag, rect: r}
  end
end


# ── Popover ───────────────────────────────────────────────────────────────
# A menu whose open state is the runtime's, by id: no record to thread.
#
#   if button(r, "Sort") then popover_open("sort") end
#   let p = popover("sort", r, [menu_item("Name"), menu_item("Date")])
#   if p.index >= 0 then ...act on p.label... end
#
# At most one popover (or context menu) is open: opening one closes the
# rest. Escape and a press outside close it before the frame runs, and that
# press reaches nothing underneath. It opens on the frame after
# `popover_open`, and it has the keys while it is open: `shortcut(chord)`
# is quiet, `shortcut(chord, id)` answers.


# The popover's menu, under `anchor` (a rect: below it; a point {x, y}: at
# it). Returns {open, index, label, rect}; `index` is -1 unless an item was
# chosen, which also closes it. `style` is `context_menu`'s.
pub fn popover(id, anchor, items, style = {})
  state hov = {hover: -1, px: -1, py: -1}
  if !popover_shown(id) then
    if hov.hover != -1 then hov = {hover: -1, px: -1, py: -1} end
    {open: false, index: -1, label: "", rect: {x: 0, y: 0, w: 0, h: 0}}
  else
    let at = if _get(anchor, "h", nil) != nil then {x: anchor.x, y: anchor.y + anchor.h + 2} else anchor end
    let m = {open: true, x: at.x, y: at.y, tag: id, hover: hov.hover, px: hov.px, py: hov.py,
             id: str(id), live: true, waited: true}
    let res = context_menu(m, items, style)
    hov = {hover: res.menu.hover, px: _get(res.menu, "px", -1), py: _get(res.menu, "py", -1)}
    {open: res.menu.open, index: res.index, label: res.label, rect: res.rect}
  end
end


# ── Spinner + progress ────────────────────────────────────────────────────

# An indeterminate spinner: a rotating arc, driven by `time()`.
# `style` overrides {color, width}.
pub fn spinner(cx, cy, radius)
  spinner(cx, cy, radius, {})
end

pub fn spinner(cx, cy, radius, style)
  let t = _palette()
  let col = _get(style, "color", t.accent)
  let thick = _get(style, "width", max(2, radius / 4))
  let a0 = time() * 5.5
  fill_arc(cx, cy, float(radius - thick), float(radius), a0, a0 + 4.5, col.r, col.g, col.b, 235)
end

# The one-character text spinner several apps hand-rolled: | / - \ cycling on
# the frame clock. Draw it with the app's own font size and color.
pub fn spinner_glyph()
  let glyphs = ["|", "/", "-", "\\"]
  glyphs[(frame_count() / 6) % 4]
end

# A progress bar. `frac` in [0, 1]; a negative `frac` draws the indeterminate
# sweep. `style` overrides {track, fill, radius}.
pub fn progress_bar(r, frac)
  progress_bar(r, frac, {})
end

pub fn progress_bar(r, frac, style)
  let t = _palette()
  let rad = _get(style, "radius", min(t.radius, r.h / 2))
  draw_rect_rounded(r, rad, _get(style, "track", t.overlay))
  let fill = _get(style, "fill", t.accent)
  if float(frac) < 0.0 then
    # Indeterminate: a 30%-wide segment sweeping left to right inside the
    # track (always visible — including on the very first frame at time 0).
    let span = min(r.w, max(8, int(float(r.w) * 0.3)))
    let ph = fract(time() / 1.2)
    let x = r.x + int(ph * float(r.w - span))
    draw_rect_rounded(rect(x, r.y, span, r.h), rad, fill)
  else
    let wpx = int(float(r.w) * clamp(float(frac), 0.0, 1.0))
    if wpx > 0 then
      draw_rect_rounded(rect(r.x, r.y, wpx, r.h), rad, fill)
    end
  end
end


# ── Checkbox / toggle / radio / slider ────────────────────────────────────


# A checkbox with a label. Returns the new value; click anywhere in `r`
# toggles. `style` overrides {box, bg, fill, outline, focus, fg, size}.
pub fn checkbox(r, label, value)
  checkbox(r, label, value, {})
end

pub fn checkbox(r, label, value, style)
  let t = _palette()
  let v = value
  let hot = _hot(r, style["id"] ?? label)
  if hot && mouse_pressed(0) then v = !v end
  let box = _get(style, "box", min(16, r.h))
  let br = rect(r.x, r.y + (r.h - box) / 2, box, box)
  let hov = _anim_flag(hot, 16.0)
  let on = _anim_flag(v, 22.0)
  let border = mix(_get(style, "outline", t.outline), _get(style, "focus", t.accent), max(on, hov * 0.5))
  let fillc = mix(_get(style, "bg", t.panel), _get(style, "fill", t.accent), on)
  draw_rect_rounded(br, t.radius_sm, fillc)
  draw_rect_outline(br, border)
  if on > 0.05 then
    # The checkmark: two strokes meeting at the low point.
    let ink = contrast_text(fillc)
    let al = int(255.0 * on)
    let ax = br.x + box * 22 / 100
    let ay = br.y + box * 52 / 100
    let mx2 = br.x + box * 42 / 100
    let my2 = br.y + box * 72 / 100
    let bx = br.x + box * 78 / 100
    let by = br.y + box * 28 / 100
    draw_line({x: ax, y: ay}, {x: mx2, y: my2}, ink, al, 2)
    draw_line({x: mx2, y: my2}, {x: bx, y: by}, ink, al, 2)
  end
  let size = _get(style, "size", t.font_md)
  draw_text(label, {x: br.x + box + t.space, y: r.y + (r.h - size) / 2},
            _ts(_face(t, style), size, _get(style, "fg", t.text)))
  v
end

# An animated on/off switch. Returns the new value; click anywhere in `r`
# flips it. `style` overrides {height, track, fill, knob}.
pub fn toggle(r, value)
  toggle(r, value, {})
end

pub fn toggle(r, value, style)
  let t = _palette()
  let v = value
  let hot = _hot(r, style["id"] ?? nil)
  if hot && mouse_pressed(0) then v = !v end
  let on = _anim_flag(v, 18.0)
  let hov = _anim_flag(hot, 16.0)
  let th = min(r.h, _get(style, "height", 18))
  let tr = rect(r.x, r.y + (r.h - th) / 2, min(r.w, th * 2), th)
  let track = mix(_get(style, "track", t.overlay), _get(style, "fill", t.accent), on)
  draw_rect_rounded(tr, th / 2, mix(track, t.text, hov * 0.06))
  let kd = th - 4
  let kx = tr.x + 2 + int(float(tr.w - kd - 4) * ease_out(on))
  draw_circle({x: kx + kd / 2, y: tr.y + th / 2}, kd / 2, _get(style, "knob", t.text))
  v
end

# A vertical radio group: one row per label, dot on the selected one. Returns
# the new selected index. `style` overrides {row_h, size, bg, fill, outline,
# focus, fg}.
pub fn radio_group(r, labels, selected)
  radio_group(r, labels, selected, {})
end

pub fn radio_group(r, labels, selected, style)
  let t = _palette()
  let sel = selected
  let row_h = _get(style, "row_h", 24)
  let size = _get(style, "size", t.font_md)
  let ts = _ts(_face(t, style), size, _get(style, "fg", t.text))
  for i in range(0, len(labels)) do
    let rr = rect(r.x, r.y + i * row_h, r.w, row_h)
    let hot = _hot(rr, labels[i])
    if hot && mouse_pressed(0) then sel = i end
    let on = _anim_flag(sel == i, 22.0)
    let hov = _anim_flag(hot, 16.0)
    let d = min(14, row_h - 6)
    let cc = {x: r.x + d / 2, y: rr.y + row_h / 2}
    let border = mix(_get(style, "outline", t.outline), _get(style, "focus", t.accent), max(on, hov * 0.5))
    draw_circle(cc, d / 2, border)
    draw_circle(cc, d / 2 - 1, _get(style, "bg", t.panel))
    if on > 0.05 then
      draw_circle(cc, float(d) * 0.28 * ease_out(on), _get(style, "fill", t.accent))
    end
    draw_text(labels[i], {x: r.x + d + t.space, y: rr.y + (row_h - size) / 2}, ts)
  end
  sel
end

# A horizontal slider over [lo, hi]. Returns the new value (a float). Press
# anywhere in `r` to jump-and-drag; the drag keeps tracking outside the rect
# until release. `style` overrides {track_h, track, fill, knob}.
#
# The drag lives in widget `state`, keyed per callsite — so in a loop it is
# keyed by *position*, and a slider whose list reorders mid-drag hands its drag
# to whichever row now sits in that slot. Key the loop to keep each row's drag
# with its row: `for n in nodes key n.id do slider(r, n.gain, 0, 1) end`.
pub fn slider(r, value, lo, hi)
  slider(r, value, lo, hi, {})
end

pub fn slider(r, value, lo, hi, style)
  state dragging = false
  let hot = _hot(r, style["id"] ?? nil)
  dragging = _slider_drag(hot, dragging)
  _slider_draw(r, value, lo, hi, style, dragging, _anim_flag(dragging || hot, 16.0))
end

# Whether the slider is being dragged this frame, given last frame's and
# whether the pointer is over it now.
fn _slider_drag(hot, dragging)
  let d = dragging
  if mouse_pressed(0) && hot then d = true end
  if !mouse_down(0) then d = false end
  d
end

fn _slider_draw(r, value, lo, hi, style, dragging, act)
  let t = _palette()
  let knob = clamp(r.h / 2 - 2, 5, 9)
  let pad_x = knob + 2
  let usable = max(1, r.w - pad_x * 2)
  let v = clamp(float(value), float(lo), float(hi))
  if dragging then
    let fr = clamp(float(mouse_x() - r.x - pad_x) / float(usable), 0.0, 1.0)
    v = float(lo) + (float(hi) - float(lo)) * fr
  end
  let span = float(hi) - float(lo)
  let frac = if span > 0.0 then (v - float(lo)) / span else 0.0 end
  let track_h = _get(style, "track_h", 4)
  let cy = r.y + r.h / 2
  let tr = rect(r.x + pad_x, cy - track_h / 2, usable, track_h)
  draw_rect_rounded(tr, track_h / 2, _get(style, "track", t.overlay))
  let fw = int(float(usable) * frac)
  if fw > 0 then
    draw_rect_rounded(rect(tr.x, tr.y, fw, track_h), track_h / 2, _get(style, "fill", t.accent))
  end
  let kx = tr.x + fw
  draw_circle({x: kx, y: cy}, float(knob) + act * 1.5, _get(style, "knob", t.text))
  v
end


# ── Inspector fields ──────────────────────────────────────────────────────
# The controls of a property inspector, which every document editor needs
# and each used to copy: a text that applies on Return or blur, a number box
# that scrubs, a hex colour, a row of colour chips, a ‹ value › stepper, a
# segmented control and a dropdown.
#
# The keyboard fields take the runtime focus like `text_field`. Each one keeps its edit in widget `state`, which is keyed per
# callsite — so in a loop, key it by the row (`for p in props key p.name do
# ... end`) to keep an edit with its row when rows move.
#
# Every one applies only when the edit is done: the result holds the new
# value on the frame it is committed (Return, or the field losing the
# keyboard) and the old one, or nil, before. Escape abandons the edit and
# gives the focus up.


# One line of text that applies on Return or when the field loses the
# keyboard; Escape reverts. While unfocused it shows `current`. Returns
# {text, editing}: `text` is nil except on the frame the edit is
# applied. `style` is `text_field`'s ({placeholder, size, font, ...}), plus
# `start`: take the keyboard as soon as the field shows (a rename opened by
# a double-click), rather than on a click in it.
pub fn commit_field(id, r, current)
  commit_field(id, r, current, {})
end

pub fn commit_field(id, r, current, style)
  state buf = ""
  state editing = false
  let out = nil
  if _get(style, "start", false) && !editing && !has_focus(id) then
    focus_request(id)
  end
  let res = text_field(id, r, if editing then buf else str(current ?? "") end, style)
  if has_focus(id) then
    if !editing then
      editing = true
    end
    buf = res.text
    if res.cancelled then
      focus_request(nil)
      editing = false
    elsif res.submitted then
      out = buf
      focus_request(nil)
      editing = false
    end
  elsif editing then
    # The keyboard went elsewhere (a click, Tab) mid-edit: apply it.
    editing = false
    out = buf
  end
  {text: out, editing: editing}
end

# A number box: drag sideways to scrub (shift for fine steps), double-click
# to type, Return or a click away to apply the typed value, Escape to drop
# it. Returns {value, changed}: `value` is the new value (the old one
# when nothing happened), `changed` whether it differs.
#
# `style` sets {step (1.0, per pixel of drag), places (2, decimals shown and
# typed), min, max, fine (0.1, the shift multiplier), tip (the hover hint; ""
# for none), size, font, bg, hover, active, fg, radius}.
pub fn number_field(id, r, value)
  number_field(id, r, value, {})
end

pub fn number_field(id, r, value, style)
  let t = _palette()
  let places = _get(style, "places", 2)
  state buf = ""
  state editing = false
  state last_x = 0
  let out = value
  if has_focus(id) then
    # Typing: entered by a double-click, or by the focus arriving (Tab).
    if !editing then
      buf = fixed(float(value), places)
      editing = true
    end
    let res = text_field(id, r, buf, style)
    buf = res.text
    if res.cancelled then
      focus_request(nil)
      editing = false
    elsif res.submitted || !has_focus(id) then
      let v = parse_float(trim(buf))
      if v != nil then out = v end
      focus_request(nil)
      editing = false
    end
  else
    if editing then
      # The focus went elsewhere while typing (a click, Tab): keep the value.
      editing = false
      let v = parse_float(trim(buf))
      if v != nil then out = v end
    end
    let it = interact(r, id)
    let bg = if it.down then _get(style, "active", t.selection)
             elsif it.hover then _get(style, "hover", t.hover)
             else _get(style, "bg", t.overlay) end
    draw_rect_rounded(r, _get(style, "radius", t.radius_sm), bg)
    let size = _get(style, "size", t.font_sm)
    let ts = _ts(_face(t, style), size, _get(style, "fg", t.text))
    draw_text_center(text_ellipsize(fixed(float(value), places), ts, r.w - 4), r.x + r.w / 2, r.y + (r.h - size) / 2, ts)
    # The drag is measured from the pointer itself, not `mouse_dx()`, so it
    # scrubs in hosts that report no relative motion.
    if it.down && !it.pressed && mouse_x() != last_x then
      let k = if mod_shift() then _get(style, "fine", 0.1) else 1.0 end
      out = float(value) + float(mouse_x() - last_x) * float(_get(style, "step", 1.0)) * k
    end
    last_x = mouse_x()
    if it.pressed && click_count() == 2 then
      focus_request(id)
    end
    let tip = _get(style, "tip", "drag to change · shift for fine · double-click to type")
    if tip != "" then tooltip(r, tip) end
  end
  if out != value then
    # `_get`, not `style["min"]`: a missing key is an error, and most
    # fields have no bounds.
    let lo = _get(style, "min", nil)
    let hi = _get(style, "max", nil)
    if lo != nil then out = max(out, lo) end
    if hi != nil then out = min(out, hi) end
  end
  {value: out, changed: out != value}
end

# A colour chip and its hex, typed: Return or a click away applies, Escape
# reverts. Returns {color}: `color` is nil unless a valid new colour
# was entered. A nil `color` shows an empty chip and field. `style` is
# `commit_field`'s, plus {chip_radius, outline}.
pub fn color_field(id, r, color)
  color_field(id, r, color, {})
end

pub fn color_field(id, r, color, style)
  let t = _palette()
  let chip = rect(r.x, r.y + 3, r.h - 6, r.h - 6)
  let cr = _get(style, "chip_radius", 3)
  if color != nil then draw_rect_rounded(chip, cr, color) end
  draw_rect_rounded_outline(chip, cr, _get(style, "outline", t.border_strong), 255, 1)
  let fr = rect(r.x + r.h, r.y, r.w - r.h, r.h)
  let shown = if color == nil then "" else color_to_hex(color) end
  let res = commit_field(id, fr, shown, {placeholder: "#rrggbb", ...style})
  let picked = if res.text == nil then nil else color_from_hex(res.text) end
  {color: if same_color(picked, color) then nil else picked end}
end

# A row of square colour chips, `r.h` on a side, `current` ringed; chips
# that would overrun `r.w` are left out. Returns the colour clicked, or nil. `style` sets {gap (4), radius (3), ring, hover,
# id (the hit-test name prefix)}.
pub fn swatches(r, colors, current)
  swatches(r, colors, current, {})
end

pub fn swatches(r, colors, current, style)
  let t = _palette()
  let picked = nil
  let size = r.h
  let gap = _get(style, "gap", 4)
  let rad = _get(style, "radius", 3)
  let prefix = _get(style, "id", "swatch-" ++ str(r.x) ++ "-" ++ str(r.y))
  for i in range(0, len(colors)) do
    let c = colors[i]
    let cr = rect(r.x + i * (size + gap), r.y, size, size)
    if cr.x + cr.w <= r.x + r.w then
      let it = interact(cr, prefix ++ "-" ++ str(i))
      draw_rect_rounded(cr, rad, c)
      if same_color(c, current) then
        draw_rect_rounded_outline(pad(cr, -2), rad + 1, _get(style, "ring", t.accent), 255, 2)
      elsif it.hover then
        draw_rect_rounded_outline(pad(cr, -1), rad + 1, _get(style, "hover", t.border_strong), 255, 1)
      end
      if it.click then picked = c end
    end
  end
  picked
end

# A small chevron pointing left (`dir` -1) or right (1), centred in `r`.
fn _chevron(r, dir, c)
  let cx = r.x + r.w / 2
  let cy = r.y + r.h / 2
  let s = max(2, min(r.w, r.h) / 5)
  draw_line({x: cx + dir * s / 2, y: cy - s}, {x: cx - dir * s / 2, y: cy}, c, 255, 2)
  draw_line({x: cx - dir * s / 2, y: cy}, {x: cx + dir * s / 2, y: cy + s}, c, 255, 2)
end

# ‹ value › — the arrows step back and forward through `options` (wrapping),
# and a click on the value steps forward. Returns the chosen option.
# `style` sets {labels (shown in place of `str(option)`), id, size, font, bg,
# hover, fg, radius, arrow_w (22)}.
pub fn stepper(r, options, current)
  stepper(r, options, current, {})
end

pub fn stepper(r, options, current, style)
  let t = _palette()
  let n = len(options)
  let i = max(0, index_of(options, current))
  let aw = _get(style, "arrow_w", 22)
  let id = _get(style, "id", "stepper-" ++ str(r.x) ++ "-" ++ str(r.y))
  let left = rect(r.x, r.y, aw, r.h)
  let right = rect(r.x + r.w - aw, r.y, aw, r.h)
  let mid = rect(r.x + aw, r.y, r.w - 2 * aw, r.h)
  let rad = _get(style, "radius", t.radius_sm)
  draw_rect_rounded(r, rad, _get(style, "bg", t.overlay))
  let out = current
  if n > 0 then
    let lt = interact(left, id ++ "-prev")
    let rt = interact(right, id ++ "-next")
    let md = interact(mid, id)
    for side in [{it: lt, r: left, dir: -1}, {it: rt, r: right, dir: 1}] do
      if side.it.hover then draw_rect_rounded(pad(side.r, 2), rad, _get(style, "hover", t.hover)) end
      _chevron(side.r, side.dir, if side.it.hover then t.text else t.muted end)
    end
    if lt.click then out = options[(i + n - 1) % n] end
    if rt.click || md.click then out = options[(i + 1) % n] end
  end
  let labels = _get(style, "labels", nil)
  let shown = if labels != nil && index_of(options, current) >= 0 then labels[index_of(options, current)] else str(current) end
  let size = _get(style, "size", t.font_sm)
  let ts = _ts(_face(t, style), size, _get(style, "fg", t.text))
  draw_text_center(text_ellipsize(shown, ts, max(0, mid.w - 4)), mid.x + mid.w / 2, mid.y + (mid.h - size) / 2, ts)
  out
end

# One of n, as a row of equal segments. Returns the new selected index.
# `style` sets {id, size, font, bg, on (the selected segment), hover, fg,
# fg_on, radius, inset (2)}.
pub fn segmented(r, labels, index)
  segmented(r, labels, index, {})
end

pub fn segmented(r, labels, index, style)
  let t = _palette()
  let n = max(1, len(labels))
  let rad = _get(style, "radius", t.radius_sm)
  let inset = _get(style, "inset", 2)
  let id = _get(style, "id", "segmented-" ++ str(r.x) ++ "-" ++ str(r.y))
  draw_rect_rounded(r, rad, _get(style, "bg", t.overlay))
  let size = _get(style, "size", t.font_sm)
  let face = _face(t, style)
  let out = index
  for i in range(0, len(labels)) do
    let x0 = r.x + r.w * i / n
    let x1 = r.x + r.w * (i + 1) / n
    let sr = rect(x0, r.y, x1 - x0, r.h)
    let it = interact(sr, id ++ "-" ++ str(i))
    if i == index then
      draw_rect_rounded(pad(sr, inset), max(0, rad - inset), _get(style, "on", t.panel))
    elsif it.hover then
      draw_rect_rounded(pad(sr, inset), max(0, rad - inset), _get(style, "hover", t.hover))
    end
    if it.click then out = i end
    let fg = if i == index then _get(style, "fg_on", t.text) else _get(style, "fg", t.muted) end
    let ts = _ts(face, size, fg)
    draw_text_center(text_ellipsize(labels[i], ts, max(0, sr.w - 6)), sr.x + sr.w / 2, sr.y + (r.h - size) / 2, ts)
  end
  out
end

# A button showing `current` that opens a menu of `options` under itself.
# Returns the chosen option (`current` until one is picked). The menu is a
# `context_menu` on the popup layer, so it draws over the widgets after it
# and takes the pointer while open: call `dropdown` where the button goes.
# `style` sets {labels, id, placeholder, size, font, bg, hover, fg, radius}
# plus `context_menu`'s keys for the menu.
pub fn dropdown(r, options, current)
  dropdown(r, options, current, {})
end

pub fn dropdown(r, options, current, style)
  let t = _palette()
  state m = menu_state()
  let id = _get(style, "id", "dropdown-" ++ str(r.x) ++ "-" ++ str(r.y))
  let labels = _get(style, "labels", nil)
  let label_of = fn(i) -> if labels != nil then labels[i] else str(options[i]) end
  let i = index_of(options, current)
  let shown = if i >= 0 then label_of(i) else _get(style, "placeholder", str(current ?? "")) end
  let it = interact(r, id)
  let rad = _get(style, "radius", t.radius_sm)
  let bg = if m.open then t.selection elsif it.hover then _get(style, "hover", t.hover) else _get(style, "bg", t.overlay) end
  draw_rect_rounded(r, rad, bg)
  let size = _get(style, "size", t.font_sm)
  let ts = _ts(_face(t, style), size, _get(style, "fg", t.text))
  draw_text(text_ellipsize(shown, ts, max(0, r.w - 30)), {x: r.x + 8, y: r.y + (r.h - size) / 2}, ts)
  # A down chevron at the right end.
  let cx = r.x + r.w - 12
  let cy = r.y + r.h / 2
  draw_line({x: cx - 4, y: cy - 2}, {x: cx, y: cy + 2}, t.muted, 255, 2)
  draw_line({x: cx, y: cy + 2}, {x: cx + 4, y: cy - 2}, t.muted, 255, 2)
  if it.click && !m.open then
    m = menu_show(m, r.x, r.y + r.h + 2, id)
  end
  let items = map(range(0, len(options)), fn(k) -> menu_item(label_of(k)))
  let res = context_menu(m, items, style)
  m = res.menu
  if res.index >= 0 then options[res.index] else current end
end


# ── Tab bar ───────────────────────────────────────────────────────────────

# A horizontal tab strip along the top of `r` (use the full height of `r` as
# the strip). Returns the new active index; click a tab to switch. `style`
# overrides {size, font, gap, fg, fg_active, underline, hover, rule, on} —
# `on` is the surface colour the strip is drawn over, which the hover wash is
# composited against.
pub fn tab_bar(r, labels, active)
  tab_bar(r, labels, active, {})
end

pub fn tab_bar(r, labels, active, style)
  let t = _palette()
  let act = active
  let size = _get(style, "size", t.font_md)
  let face = _face(t, style)
  let gap = _get(style, "gap", 4)
  # The surface the strip sits on, so its hover wash can be composited to an
  # opaque colour here rather than left as a translucent fill (see `over`).
  let on = _get(style, "on", t.bg)
  let x = r.x
  for i in range(0, len(labels)) do
    # Each tab is exactly as wide as its label plus padding, so the measure
    # and the draw below share one style record.
    let is = act == i
    let fg0 = if is then
      _get(style, "fg_active", t.text)
    else
      _get(style, "fg", t.dim)
    end
    let ts = _ts(face, size, fg0)
    let wl = text_width(labels[i], ts) + 24
    let tr = rect(x, r.y, wl, r.h)
    let hot = _hot(tr, labels[i])
    if hot && mouse_pressed(0) then act = i end
    let hov = _anim_flag(hot, 16.0)
    if !is && hov > 0.01 then
      draw_rect(tr, over(on, _get(style, "hover", t.hover), hov * 160.0 / 255.0))
    end
    let fg = if is then fg0 else mix(fg0, t.text, hov * 0.5) end
    draw_text_center(labels[i], tr.x + wl / 2, r.y + (r.h - size) / 2, {...ts, color: fg})
    if is then
      draw_rect(rect(tr.x + 6, r.y + r.h - 2, wl - 12, 2), _get(style, "underline", t.accent))
    end
    x = x + wl + gap
  end
  draw_line({x: r.x, y: r.y + r.h}, {x: r.x + r.w, y: r.y + r.h}, _get(style, "rule", t.outline))
  act
end


# ── Tooltip ───────────────────────────────────────────────────────────────

# Show `text` near the pointer after it has rested over `anchor` for a beat
# (default 0.45s), fading in. Call it late in the frame so the tip draws over
# the widgets beneath. `style` overrides {delay, size, font, bg, fg, outline}.
pub fn tooltip(anchor, text)
  tooltip(anchor, text, {})
end

pub fn tooltip(anchor, text, style)
  state hover_since = -1.0
  if _over(anchor) then
    if hover_since < 0.0 then hover_since = time() end
  else
    hover_since = -1.0
  end
  let delay = _get(style, "delay", 0.45)
  if hover_since >= 0.0 && time() - hover_since >= delay then
    let t = _palette()
    let a = clamp((time() - hover_since - delay) / 0.12, 0.0, 1.0)
    let size = _get(style, "size", t.font_sm)
    let fg = _get(style, "fg", t.text)
    let ts = _ts(_face(t, style), size, fg)
    let wpx = text_width(text, ts) + 16
    let hpx = size + 10
    let x = clamp(mouse_x() + 12, 0, max(0, screen_width() - wpx))
    let y = mouse_y() + 18
    if y + hpx > screen_height() then
      y = mouse_y() - hpx - 6
    end
    # The tip is over content it did not paint and is *fading in*, so its
    # alpha is genuine translucency, not a flat tint: it stays an alpha.
    let alpha = int(a * 235.0)
    let tr = rect(x, y, wpx, hpx)
    # On the tooltip layer and outside every clip: the tip comes out on top
    # wherever in the frame it was asked for, and a tip for a row inside a
    # scrolled list is not cut off by the list.
    ui_overlay(max(ui_layer(), UI_LAYER_TOOLTIP), fn()
      draw_elevation(tr, t.radius_sm, 2, {a: int(a * float(elevation(2).a))})
      draw_rect_rounded(tr, t.radius_sm, _get(style, "bg", t.overlay), alpha)
      draw_rect_outline(tr, _get(style, "outline", t.outline), alpha)
      draw_text(text, {x: x + 8, y: y + 5}, {...ts, color: {...fg, a: alpha}})
    end)
  end
end


# ── Modal / dialog ────────────────────────────────────────────────────────
# An overlay dialog over a dimmed backdrop. Escape or a click outside closes
# it. Immediate-mode two-call shape, like the context menu: while open, guard
# the panel's own input handling with `modal_blocking(md)` near the top of the
# frame, and draw the modal near the bottom so it sits on top:
#
#   state md = modal_state()
#   if button(open_r, "Delete…") then md = modal_open(md) end
#   ...
#   let res = modal(md, 380, 200, "Delete branch?")
#   md = res.modal
#   if res.open then
#     ...draw into res.content; call modal_close(md) on your buttons...
#   end


pub fn modal_state()
  {open: false, at: -1}
end

# `at` records the opening frame: the click (or keypress) that opened the
# modal is still a live edge when the modal runs later the same frame, and
# must not be read as the click-outside that dismisses it.
pub fn modal_open(m)
  {open: true, at: frame_count()}
end

pub fn modal_close(m)
  {open: false, at: -1}
end

# True while the modal owns the input. Guard the panel's own click/keyboard
# handling with this so one press is not acted on twice.
pub fn modal_blocking(m)
  m.open
end

# Where a w×h modal sits: centered on the screen.
pub fn modal_rect(w, h)
  rect((screen_width() - w) / 2, (screen_height() - h) / 2, w, h)
end

# The input half: Escape or a press outside `r` closes. Safe to call every
# frame; a closed modal passes through untouched.
pub fn modal_update(m, r)
  if !m.open || m.at == frame_count() then
    m
  else
    let nm = m
    if key_pressed("escape") then nm = modal_close(m) end
    if mouse_pressed(0) && !point_in(mouse_x(), mouse_y(), r) then nm = modal_close(m) end
    nm
  end
end

# A dialog takes the rest of the frame: from its first draw call on, the
# frame is on the modal layer (so the dialog's own controls, drawn by the app
# after `modal()` returns, are on it too) and everything below is inert.
# Idempotent, so the backdrop and the chrome can both call it.
fn _modal_layer()
  if ui_layer() < UI_LAYER_MODAL then
    ui_layer(UI_LAYER_MODAL)
  end
  ui_modal()
end

# The dimming layer between the panel and the dialog.
pub fn draw_modal_backdrop()
  draw_modal_backdrop({})
end

# The backdrop is the one place a flat alpha is right rather than lazy: it
# covers content the modal did not paint, so there is nothing to composite it
# against ahead of time (see `over`). What was wrong was the *number* being a
# bare 120 with no stated intent — it is 47% dim, written as such.
pub fn draw_modal_backdrop(style)
  _modal_layer()
  draw_rect(rect(0, 0, screen_width(), screen_height()),
            _get(style, "shadow", :000000), _get(style, "dim", alpha_pct(47)))
end

# The dialog chrome: shadow, rounded panel, title. Returns the content rect.
pub fn draw_modal(r, title)
  draw_modal(r, title, {})
end

pub fn draw_modal(r, title, style)
  let t = _palette()
  _modal_layer()
  _reg(r, style["id"] ?? title)
  # Elevation 3 — the top of the scale, because a modal is the frontmost
  # thing on screen. The old offset rectangle read as a second, misaligned
  # dialog behind this one.
  draw_elevation(r, t.radius_lg, 3, {color: _get(style, "shadow", :000000)})
  draw_rect_rounded(r, t.radius_lg, _get(style, "outline", t.border_strong))
  draw_rect_rounded(pad(r, 1), t.radius_lg - 1, _get(style, "bg", t.panel))
  let size = _get(style, "size", t.font_lg)
  let inset = _get(style, "pad", t.space_lg)
  draw_text(title, {x: r.x + inset, y: r.y + inset - 2},
            {..._ts(_face(t, style), size, _get(style, "fg", t.text)), weight: 600})
  rect(r.x + inset, r.y + inset + size + 8, r.w - inset * 2, r.h - inset * 2 - size - 8)
end

# The one-call form: update + backdrop + chrome. Returns
# {modal, open, rect, content}; draw your body into `content` when `open`.
pub fn modal(m, w, h, title)
  modal(m, w, h, title, {})
end

pub fn modal(m, w, h, title, style)
  let r = modal_rect(w, h)
  let nm = modal_update(m, r)
  if nm.open then
    draw_modal_backdrop(style)
    let content = draw_modal(r, title, style)
    {modal: nm, open: true, rect: r, content: content}
  else
    {modal: nm, open: false, rect: rect(0, 0, 0, 0), content: rect(0, 0, 0, 0)}
  end
end


# ── Badge / pill / card / empty state / hint bar ──────────────────────────


# A small rounded label chip at (x, y). Returns the rect it drew (so callers
# can flow the next one after it). `style` overrides {size, font, bg, fg,
# gradient, gradient_angle} — `gradient: [c0, c1]` fills the chip with a ramp
# instead of a flat colour.
pub fn badge(x, y, text)
  badge(x, y, text, {})
end

pub fn badge(x, y, text, style)
  let t = _palette()
  let size = _get(style, "size", t.font_sm)
  let ts = _ts(_face(t, style), size, _get(style, "fg", t.muted))
  # The chip is sized to its own label, so the width it reserves has to come
  # from the style it will draw that label in.
  let wpx = text_width(text, ts) + 14
  let hpx = size + 8
  let r = rect(x, y, wpx, hpx)
  let grad = _get(style, "gradient", [])
  if len(grad) < 2 then
    draw_rect_rounded(r, hpx / 2, _get(style, "bg", t.overlay))
  else
    linear_gradient(r, grad, _get(style, "gradient_angle", GRAD_DOWN), hpx / 2)
  end
  draw_text(text, {x: x + 7, y: y + 4}, ts)
  r
end

# The colored badge: `color` tints the fill and the text — the status-chip
# look (pass t.success / t.warn / t.danger / t.accent). `style` overrides
# {size, font, on} — `on` is the surface colour the chip sits on, which the
# tint is composited against.
pub fn pill(x, y, text, color)
  pill(x, y, text, color, {})
end

pub fn pill(x, y, text, color, style)
  let t = _palette()
  let size = _get(style, "size", t.font_sm)
  let ts = _ts(_face(t, style), size, color)
  let wpx = text_width(text, ts) + 14
  let hpx = size + 8
  let r = rect(x, y, wpx, hpx)
  # The tint is flattened against the surface the pill sits on rather than
  # drawn translucent: two pills overlapping, or one drawn twice in a frame,
  # then still read as one 16% wash instead of stacking to 31%.
  draw_rect_rounded(r, hpx / 2, over(_get(style, "on", t.surface), color, 42))
  draw_text(text, {x: x + 7, y: y + 4}, ts)
  r
end

# A raised surface with a rounded border and a soft shadow. Returns the
# padded content rect. `style` overrides {radius, pad, bg, outline, shadow,
# elevation} — `shadow: false` skips the drop shadow, `elevation` picks a
# step of the theme's elevation scale (1 by default).
pub fn card(r)
  card(r, {})
end

pub fn card(r, style)
  let t = _palette()
  let rad = _get(style, "radius", t.radius)
  if _get(style, "shadow", true) then
    # Elevation 1: a card is resting on the surface, not floating over it.
    draw_elevation(r, rad, _get(style, "elevation", 1))
  end
  draw_rect_rounded(r, rad, _get(style, "outline", t.border))
  draw_rect_rounded(pad(r, 1), max(0, rad - 1), _get(style, "bg", t.surface))
  pad(r, _get(style, "pad", t.space_lg))
end

# Centered "nothing here" copy for an empty region: a dim title plus an even
# dimmer hint line. `style` overrides {size, font, fg}.
pub fn empty_state(r, title, hint_text)
  empty_state(r, title, hint_text, {})
end

pub fn empty_state(r, title, hint_text, style)
  let t = _palette()
  let size = _get(style, "size", t.font_lg)
  let face = _face(t, style)
  let cx = r.x + r.w / 2
  let cy = r.y + r.h / 2
  # Centred copy is exactly what breaks when the measure and the draw
  # disagree about the face, so both go through one style record.
  draw_text_center(title, cx, cy - size + 2, _ts(face, size, _get(style, "fg", t.dim)))
  if len(hint_text) > 0 then
    draw_text_center(hint_text, cx, cy + 8, _ts(face, t.font_sm, mix(t.dim, t.bg, 0.35)))
  end
end

# One entry of a hint bar: the key cap text and what it does.
pub fn hint(key, label)
  {key: key, label: label}
end

# The keyboard-hint bar every full-pane app draws along its bottom edge:
# key caps in small pills, labels dim beside them.
#   hint_bar(bottom, [hint("j/k", "move"), hint("enter", "open")])
pub fn hint_bar(r, hints)
  hint_bar(r, hints, {})
end

pub fn hint_bar(r, hints, style)
  let t = _palette()
  let bg = _get(style, "bg", t.panel)
  draw_rect(r, bg)
  # The bar paints its own background, so its top rule is a hairline of its
  # own ink over it rather than a full-strength border.
  draw_line({x: r.x, y: r.y}, {x: r.x + r.w, y: r.y},
            _get(style, "rule", hairline(bg, _get(style, "fg", t.dim))))
  let size = _get(style, "size", t.font_sm)
  let face = _face(t, style)
  let cap_ts = _ts(face, size, _get(style, "cap_fg", t.muted))
  let lbl_ts = _ts(face, size, _get(style, "fg", t.dim))
  let x = r.x + 10
  for hn in hints do
    let kw = text_width(hn.key, cap_ts) + 10
    let kh = size + 6
    let kr = rect(x, r.y + (r.h - kh) / 2, kw, kh)
    draw_rect_rounded(kr, t.radius_sm, _get(style, "cap", t.overlay))
    draw_text_center(hn.key, kr.x + kw / 2, kr.y + 3, cap_ts)
    x = x + kw + 6
    draw_text(hn.label, {x: x, y: r.y + (r.h - size) / 2}, lbl_ts)
    # The next cap flows after this label, so the advance is measured in the
    # style the label was drawn in.
    x = x + text_width(hn.label, lbl_ts) + 16
  end
end


# ── Splitter ──────────────────────────────────────────────────────────────
# A draggable divider splitting `r` in two — the widget git_panel/db_view
# hand-rolled as `left_frac` + `drag_div`. State is an explicit record so
# several splitters coexist:
#
#   state sp = splitter_state(0.3)
#   let s = splitter(sp, content)
#   sp = s.state
#   ...draw into s.a (left/top) and s.b (right/bottom)...
#
# `style`: axis ("x" divider slides horizontally splitting left|right — the
# default — or "y" for top|bottom), min_a / min_b (px floors for each side),
# band (grab-zone thickness), gap (space left blank beside the divider line),
# line / active (colors).


pub fn splitter_state()
  splitter_state(0.5)
end

pub fn splitter_state(frac)
  {frac: frac, drag: false}
end

pub fn splitter(sp, r)
  splitter(sp, r, {})
end

pub fn splitter(sp, r, style)
  let t = _palette()
  let axis = _get(style, "axis", "x")
  let min_a = _get(style, "min_a", 80)
  let min_b = _get(style, "min_b", 80)
  let band = _get(style, "band", 9)
  let gap = _get(style, "gap", 4)
  let total = if axis == "x" then r.w else r.h end
  let s = sp
  let hi = float(max(min_a, total - min_b))
  let apx = int(clamp(float(total) * s.frac, float(min_a), hi))
  let hit = if axis == "x" then
    rect(r.x + apx - band / 2, r.y, band, r.h)
  else
    rect(r.x, r.y + apx - band / 2, r.w, band)
  end
  let hot = _hot(hit, style["id"] ?? nil)
  if mouse_pressed(0) && hot then
    s = {frac: s.frac, drag: true}
  end
  if !mouse_down(0) then
    s = {frac: s.frac, drag: false}
  end
  if s.drag then
    let along = if axis == "x" then mouse_x() - r.x else mouse_y() - r.y end
    s = {frac: clamp(float(along) / float(max(1, total)), 0.02, 0.98), drag: true}
    apx = int(clamp(float(total) * s.frac, float(min_a), hi))
    hit = if axis == "x" then
      rect(r.x + apx - band / 2, r.y, band, r.h)
    else
      rect(r.x, r.y + apx - band / 2, r.w, band)
    end
  end
  let active = s.drag || hot
  let lc = if active then _get(style, "active", t.accent) else _get(style, "line", t.outline) end
  let lw = if active then 2 else 1 end
  let a = rect(0, 0, 0, 0)
  let b = rect(0, 0, 0, 0)
  if axis == "x" then
    draw_line({x: r.x + apx, y: r.y}, {x: r.x + apx, y: r.y + r.h}, lc, 255, lw)
    a = rect(r.x, r.y, apx - gap, r.h)
    b = rect(r.x + apx + gap, r.y, r.w - apx - gap, r.h)
  else
    draw_line({x: r.x, y: r.y + apx}, {x: r.x + r.w, y: r.y + apx}, lc, 255, lw)
    a = rect(r.x, r.y, r.w, apx - gap)
    b = rect(r.x, r.y + apx + gap, r.w, r.h - apx - gap)
  end
  {state: s, a: a, b: b, divider: hit}
end


# ── Table ─────────────────────────────────────────────────────────────────
# A header + rows grid with column sizing, keyboard/mouse selection (list
# semantics), zebra striping, a scrollbar, and click-to-sort headers. The
# table records the *request* (sort_col / sort_asc); the caller owns the data
# and applies the sort — the widget never reorders rows itself.
#
#   state tb = table_state()
#   tb = table(tb, r, [{label: "Name", w: 0.6}, {label: "Size", w: 90}],
#              rows)                       // rows: a list of row lists
#   ...sort `rows` by tb.sort_col / tb.sort_asc before passing them in...


pub fn table_state()
  {selected: 0, scroll: 0, sort_col: -1, sort_asc: true}
end

# Column rects for `cols` across `r`: each col is {label, w} — `w` >= 1 is
# fixed pixels, 0 < w < 1 a weight over the leftover, missing/0 an equal
# flex share.
pub fn table_col_rects(r, cols)
  let fixed = 0
  let weights = 0.0
  for c in cols do
    let w = float(_get(c, "w", 0))
    if w >= 1.0 then
      fixed = fixed + int(w)
    elsif w > 0.0 then
      weights = weights + w
    else
      weights = weights + 1.0
    end
  end
  let leftover = max(0, r.w - fixed)
  let out = []
  let x = r.x
  for c in cols do
    let w = float(_get(c, "w", 0))
    let cw = 0
    if w >= 1.0 then
      cw = int(w)
    else
      let wt = if w > 0.0 then w else 1.0 end
      if weights > 0.0 then cw = int(float(leftover) * wt / weights) end
    end
    out = append(out, rect(x, r.y, cw, r.h))
    x = x + cw
  end
  out
end

pub fn table(tb, r, cols, rows_data)
  table(tb, r, cols, rows_data, {})
end

# `style` overrides {row_h, head_h, size, font, fg, head_bg, selection, zebra,
# rule, on, active} — `active` gates keyboard navigation, like list_update's,
# and `on` is the surface colour the grid sits on (what the zebra stripe is
# composited against).
pub fn table(tb, r, cols, rows_data, style)
  let t = _palette()
  let row_h = _get(style, "row_h", 26)
  let head_h = _get(style, "head_h", 28)
  let size = _get(style, "size", t.font_md)
  let face = _face(t, style)
  # The surface the grid sits on, so the zebra stripe can be flattened
  # against it (see `over`) instead of stacking with the hover wash.
  let on = _get(style, "on", t.bg)
  let nt = tb
  let parts = cut_top(r, head_h)
  let head = parts.cut
  let body = parts.rest
  let crects = table_col_rects(head, cols)
  draw_rect(head, _get(style, "head_bg", t.panel))
  for i in range(0, len(cols)) do
    let cr = crects[i]
    if _hot(cr, cols[i]["label"] ?? nil) && mouse_pressed(0) then
      if nt.sort_col == i then
        nt = {...nt, sort_asc: !nt.sort_asc}
      else
        nt = {...nt, sort_col: i, sort_asc: true}
      end
    end
    let label = _get(cols[i], "label", "")
    let fg = if nt.sort_col == i then t.text else t.muted end
    # Semibold headings, in the theme face: the record measured below is the
    # record drawn, so the sort arrow lands against the label's real width.
    let head_ts = {..._ts(face, size, fg), weight: 600}
    draw_text(label, {x: cr.x + 8, y: head.y + (head_h - size) / 2}, head_ts)
    if nt.sort_col == i then
      let arrow = if nt.sort_asc then "▲" else "▼" end
      draw_text(arrow, {x: cr.x + 12 + text_width(label, head_ts), y: head.y + (head_h - size) / 2 + 2},
                _ts(face, size - 4, t.accent))
    end
  end
  draw_line({x: r.x, y: body.y}, {x: r.x + r.w, y: body.y}, _get(style, "rule", t.border))
  let visible = max(1, body.h / row_h)
  let lr = rect(body.x, body.y, body.w, visible * row_h)
  let lst = list_update({selected: nt.selected, scroll: nt.scroll}, len(rows_data), visible, lr, _get(style, "active", true))
  nt = {...nt, selected: lst.selected, scroll: lst.scroll}
  let zebra = _get(style, "zebra", true)
  for vi in range(0, min(visible, len(rows_data) - lst.scroll)) do
    let idx = lst.scroll + vi
    let rr = rect(body.x, body.y + vi * row_h, body.w, row_h)
    if idx == lst.selected then
      draw_rect(rr, _get(style, "selection", t.selection))
    elsif _over(rr) then
      draw_rect(rr, t.hover)
    elsif zebra && idx % 2 == 1 then
      draw_rect(rr, over(on, t.hover, 70))
    end
    let cells = rows_data[idx]
    let cell_ts = _ts(face, size, _get(style, "fg", t.text))
    for ci in range(0, min(len(cols), len(cells))) do
      let cr = crects[ci]
      # Fitting and drawing take the same record, so a cell trimmed to fit
      # really does fit.
      draw_text(ellipsize(str(cells[ci]), cr.w - 16, cell_ts),
                {x: cr.x + 8, y: rr.y + (row_h - size) / 2}, cell_ts)
    end
  end
  draw_scrollbar(lr, len(rows_data), visible, lst.scroll)
  nt
end


# ── Load view ─────────────────────────────────────────────────────────────
# Draw the non-ready states into `r` (spinner while loading, the error while
# failed, a hint while idle); returns true when the content is ready and the
# caller should draw it instead. `style` overrides {radius, error_title,
# idle_title}.
pub fn draw_load(r, ls)
  draw_load(r, ls, {})
end

pub fn draw_load(r, ls, style)
  if load_ready(ls) then
    true
  else
    let t = _palette()
    if load_failed(ls) then
      empty_state(r, _get(style, "error_title", "Something went wrong"), ls.error, {fg: t.danger})
    elsif load_loading(ls) then
      spinner(r.x + r.w / 2, r.y + r.h / 2, _get(style, "radius", 10))
    else
      empty_state(r, _get(style, "idle_title", "Nothing loaded"), "")
    end
    false
  end
end
