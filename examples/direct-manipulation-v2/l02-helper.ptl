// dm-title: one helper function (center + offset)
// dm-level: L2
//
// Two circles are placed by `offset(center, dx, dy)`. The literal that
// moves the right circle alone is its `dx` argument, through the helper's
// body; the centre's `200` moves all three shapes.
//
// dm-goal right-circle: circle#1.0 += 30 | expect=lit:60
// dm-goal left-circle-up: circle#0.1 -= 20 | expect=lit:0
// dm-goal center-dot: circle#2.0 += 25 | expect=lit:200
// dm-goal all-three: circle#0.0 += 25, circle#1.0 += 25, circle#2.0 += 25 | expect=lit:200

import ui

let center = {x: 200, y: 150}

fn offset(p, dx, dy)
  {x: p.x + dx, y: p.y + dy}
end

let a = offset(center, -60, 0)
let b = offset(center, 60, 0)

draw_rect(0, 0, 400, 300, #101418)
draw_circle(a.x, a.y, 16, #e0a040)
draw_circle(b.x, b.y, 16, #40c080)
draw_circle(center.x, center.y, 6, #ffffff)
