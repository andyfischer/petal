# ─────────────────────────────────────────────────────────────────────────
# Kanban — a drag-and-drop sprint board, drawn as a Garden panel.
#
# Exercises: columns, cards, declarative drag and drop (`ui/drag`) with the
# other cards sliding out of the way, per-column pixel scrolling, keyboard
# navigation and card movement, hover/selection states, and a typographic
# hierarchy built only from size / color / spacing.
#
# Run:  garden --headless --debug-port 0 --init layout.ptl
# ─────────────────────────────────────────────────────────────────────────

import ui
import ui/drag

class Card
  id: string,
  title: string,
  tag: string,
  who: string,
  pts: int,
  pri: int,          # 0 = low, 1 = normal, 2 = urgent
end

# ── Palette ──────────────────────────────────────────────────────────────

let BG        = :0b0d12
let SURFACE   = :12151d
let CARD_BG   = :1a1f2a
let CARD_HOV  = :222937
let CARD_LIFT = :2a3342
let RULE      = :232a37
let TEXT      = :e9edf4
let DIM       = :838d9c
let FAINT     = :59626f
let ACCENT    = :5b9dff
let DANGER    = :e0655f
let GOOD      = :3fae7a

let LANES = [
  {name: "BACKLOG",     color: :6c7a90, limit: 0},
  {name: "IN PROGRESS", color: :5b9dff, limit: 3},
  {name: "REVIEW",      color: :d9a441, limit: 2},
  {name: "SHIPPED",     color: :3fae7a, limit: 0},
]

fn tag_color(t: string) -> record
  match t
    when "render" -> :d98a4a
    when "input" -> :5b9dff
    when "vm" -> :e0655f
    when "prelude" -> :3fae7a
    when "docs" -> :a98ce0
    when "tooling" -> :46b1c9
    when _ -> DIM
  end
end

fn who_color(w: string) -> record
  match w
    when "AF" -> :5b9dff
    when "EK" -> :d98a4a
    when "JN" -> :3fae7a
    when "MR" -> :a98ce0
    when _ -> DIM
  end
end

fn pri_color(p: num) -> record
  if p == 2 then DANGER
  elsif p == 1 then :d9a441
  else :3d4653
  end
end

fn pri_name(p: num) -> string
  if p == 2 then "urgent" elsif p == 1 then "normal" else "low" end
end

# ── Board state ──────────────────────────────────────────────────────────

state cols = [
  [
    Card(id: "c1", title: "Embed the Bold face for panel text runs", tag: "render", who: "EK", pts: 3, pri: 1),
    Card(id: "c2", title: "Wheel scroll should respect clip regions", tag: "input", who: "JN", pts: 2, pri: 0),
    Card(id: "c3", title: "Document the panel sleep/wake window", tag: "docs", who: "AF", pts: 1, pri: 0),
    Card(id: "c4", title: "Sparkline widget for the ui prelude", tag: "prelude", who: "MR", pts: 5, pri: 1),
    Card(id: "c5", title: "Fuzz the bytecode VM against the corpus", tag: "vm", who: "AF", pts: 8, pri: 0),
  ],
  [
    Card(id: "c6", title: "Capture the drag gesture across panes", tag: "input", who: "JN", pts: 5, pri: 2),
    Card(id: "c7", title: "Corner antialiasing at small radii", tag: "render", who: "EK", pts: 3, pri: 1),
  ],
  [
    Card(id: "c8", title: "Fast path for immutable list append", tag: "vm", who: "AF", pts: 8, pri: 2),
    Card(id: "c9", title: "Focus registry: shift+tab wraps twice", tag: "prelude", who: "MR", pts: 2, pri: 0),
  ],
  [
    Card(id: "c10", title: "Bytecode VM is the only engine", tag: "vm", who: "AF", pts: 13, pri: 1),
    Card(id: "c11", title: "Panel values exposed in /state", tag: "tooling", who: "JN", pts: 3, pri: 1),
    Card(id: "c12", title: "text_width uses real font advances", tag: "render", who: "EK", pts: 2, pri: 0),
  ],
]

state sel_id = "c6"
state scrolls = [0, 0, 0, 0]
state moves = 0

# ── Layout metrics (recomputed every frame — the pane can resize) ─────────

let W = screen_width()
let H = screen_height()
let M = 26
let GUT = 16
let COL_W = (W - M * 2 - GUT * 3) / 4
let BOARD_TOP = 104
let FOOT_H = 54
let LANE_HEAD = 30
let SURF_TOP = BOARD_TOP + LANE_HEAD + 10
let SURF_H = H - SURF_TOP - FOOT_H - M
let COL_PAD = 12
let CARD_GAP = 10
let CARD_PAD = 13
let INNER_W = COL_W - COL_PAD * 2
let CARD_IN = INNER_W - CARD_PAD * 2
let TITLE_SIZE = 14
let TITLE_LH = 19
# Measure ten glyphs, not one: the real advance is fractional (8.4px at 14),
# and rounding it down per-character overestimates a line by several chars.
let CHW10 = max(50, text_width("MMMMMMMMMM", TITLE_SIZE))
let LINE_CHARS = max(8, CARD_IN * 10 / CHW10)

fn col_x(c: num) -> num
  M + c * (COL_W + GUT)
end

# The clipped card well one column's cards scroll inside.
fn col_surf(c: num) -> Rect
  rect(col_x(c), SURF_TOP, COL_W, SURF_H)
end

# ── Small list surgery (lists are immutable values) ───────────────────────

fn list_remove(xs: list, k: num) -> list
  let out = []
  for i in range(0, len(xs)) do
    if i != k then
      out = append(out, xs[i])
    end
  end
  out
end

fn list_insert(xs: list, k: num, v) -> list
  let out = []
  for i in range(0, len(xs)) do
    if i == k then
      out = append(out, v)
    end
    out = append(out, xs[i])
  end
  if k >= len(xs) then
    out = append(out, v)
  end
  out
end

fn find_card(cs: list, id: string) -> record
  let out = {c: -1, i: -1}
  for c in range(0, 4) do
    for i in range(0, len(cs[c])) do
      if cs[c][i].id == id then
        out = {c: c, i: i}
      end
    end
  end
  out
end

# ── Card geometry ────────────────────────────────────────────────────────

# Each title's wrapped lines, worked out once a frame: the drag engine runs
# the view once per board a drag can reach, and every one has these cards.
let TITLE_LINES = Map()
for col in cols do
  for card in col do
    TITLE_LINES[card.title] = preview(card.title, max_chars: LINE_CHARS, max_lines: 2).lines
  end
end

fn card_lines(card: record)
  TITLE_LINES[card.title] ?? preview(card.title, max_chars: LINE_CHARS, max_lines: 2).lines
end

fn card_h(card: record) -> int
  82 + TITLE_LH * len(card_lines(card))
end

fn column_h(cards: list) -> int
  let h = 0
  for c in cards do
    h = h + card_h(c) + CARD_GAP
  end
  max(0, h - CARD_GAP)
end

# ── Drawing ──────────────────────────────────────────────────────────────

fn draw_card(r: record, card: record, mode: string)
  if mode == "lift" then
    draw_rect_rounded(rect(r.x + 2, r.y + 9, r.w, r.h), radius: 12, c: :000000, a: 120)
  end
  let bg = if mode == "lift" then CARD_LIFT
  elsif mode == "hover" then CARD_HOV
  else CARD_BG
  end
  draw_rect_rounded(r, radius: 12, c: bg)
  if mode == "lift" then
    draw_rect_outline(r, c: ACCENT, a: 170, width: 1)
  elsif mode == "sel" then
    draw_rect_outline(r, c: ACCENT, a: 200, width: 1)
  else
    draw_rect_outline(r, c: RULE, a: 255, width: 1)
  end
  if mode == "sel" || mode == "lift" then
    draw_rect_rounded(rect(r.x + 1, r.y + 13, 3, r.h - 26), radius: 2, c: ACCENT)
  end

  # Top row: tag pill on the left, priority dot on the right.
  let tc = tag_color(card.tag)
  let pw = text_width(card.tag, 10) + 16
  draw_rect_rounded(rect(r.x + CARD_PAD, r.y + CARD_PAD, pw, 17), radius: 8, c: tc, a: 38)
  draw_text(card.tag, {x: r.x + CARD_PAD + 8, y: r.y + CARD_PAD + 4}, 10, tc)
  draw_circle(center: {x: r.x + r.w - CARD_PAD - 4, y: r.y + CARD_PAD + 8}, radius: 4,
    c: pri_color(card.pri))

  # Title, one or two wrapped lines.
  let lines = card_lines(card)
  let ty = r.y + CARD_PAD + 26
  for k in range(0, len(lines)) do
    draw_text(lines[k], {x: r.x + CARD_PAD, y: ty + k * TITLE_LH}, TITLE_SIZE, TEXT)
  end

  # Footer: assignee chip, estimate.
  let fy = r.y + r.h - CARD_PAD - 20
  let wc = who_color(card.who)
  draw_circle({x: r.x + CARD_PAD + 10, y: fy + 10}, 10, wc, 46)
  draw_text_center(card.who, cx: r.x + CARD_PAD + 10, y: fy + 5, size: 10, c: wc)
  draw_text_right("{card.pts} pts", right_x: r.x + r.w - CARD_PAD, y: fy + 5, size: 11, c: FAINT)
end

# Soft edges where the well clips its cards, so a scrolled column reads as
# continuing rather than as a card sliced in half.
fn draw_edge_fade(surf: record, content: num, off: num)
  let steps = 16
  for k in range(0, steps) do
    let a = 255 - k * 16
    if off > 0 then
      draw_rect(rect(surf.x + 2, surf.y + 2 + k * 4, surf.w - 4, 4), c: SURFACE, a: a)
    end
    if off < content - surf.h then
      draw_rect(rect(surf.x + 2, surf.y + surf.h - 6 - k * 4, surf.w - 4, 4), c: SURFACE, a: a)
    end
  end
end

fn draw_vscroll(surf: record, content: num, off: num)
  if content > surf.h then
    let track_h = surf.h - 16
    let th = max(24, track_h * surf.h / content)
    let ty = surf.y + 8 + (track_h - th) * off / max(1, content - surf.h)
    draw_rect_rounded(rect(surf.x + surf.w - 7, ty, 3, th), radius: 2, c: FAINT, a: 150)
  end
end

# ── The board, as a function of the columns ──────────────────────────────
# Everything a drag can change comes from `cs`. The drag engine also runs it,
# speculatively, on every board a drag can reach, so a card lands exactly
# where this code would draw it. `sc` (the scrolls), `sel` (the selected id)
# and `hover_id` only place the wells' contents and pick card styles.

var hover_id = ""

fn view(cs: list, sc: list, sel: string)
  let dk = drag_key()
  let tc = if dk == nil then -1 else find_card(cs, dk).c end
  for c in range(0, 4) do
    let lane = LANES[c]
    let x = col_x(c)
    let surf = col_surf(c)
    let cnt = len(cs[c])

    # Lane header, above the surface so the surface stays a clean card well.
    draw_circle(center: {x: x + 6, y: BOARD_TOP + 12}, radius: 4, c: lane.color)
    draw_text(lane.name, pos: {x: x + 18, y: BOARD_TOP + 5},
      style: {size: 12, color: TEXT, spacing: 1})
    let over = lane.limit > 0 && cnt > lane.limit
    let ctext = if lane.limit > 0 then "{cnt}/{lane.limit}" else str(cnt) end
    draw_text_right(ctext, right_x: x + COL_W, y: BOARD_TOP + 5, size: 12,
      c: if over then DANGER else FAINT end)
    draw_rect(rect(x, BOARD_TOP + 24, COL_W, 2), c: lane.color, a: 90)

    # Card well; mid-drag, the lane the card would land in is outlined.
    draw_rect_rounded(surf, radius: 14, c: SURFACE)
    if c == tc then
      draw_rect_outline(surf, c: ACCENT, a: 70, width: 1)
    end

    clip(x: surf.x, y: surf.y, w: surf.w, h: surf.h)
    if cnt == 0 then
      draw_text_center("empty", cx: x + COL_W / 2, y: SURF_TOP + 26, size: 11, c: :333b47)
    end
    # Cards ease to new slots relative to the scroll, so the wheel moves
    # them at once while a reorder animates.
    place_origin({x: 0, y: -sc[c]}, fn()
      let y = SURF_TOP + COL_PAD - sc[c]
      for card in cs[c] key card.id do
        let h = card_h(card)
        let r = place(card.id, rect(x + COL_PAD, y, INNER_W, h))
        draggable(card.id, r, fn() closest(moves_nested(cs, card.id)) |> floating() end)
        let mode = if is_dragging(card.id) then "lift"
        elsif card.id == sel then "sel"
        elsif card.id == get hover_id then "hover"
        else "plain"
        end
        place(card.id, r, fn(p) draw_card(p, card, mode) end)
        y = y + h + CARD_GAP
      end
    end)
    let content = column_h(cs[c]) + COL_PAD * 2
    draw_edge_fade(surf, content, off: sc[c])
    clip_none()
    draw_vscroll(surf, content, off: sc[c])
  end
  nil
end

# ── Input ────────────────────────────────────────────────────────────────

# The drag engine: a press on a card and a few pixels of travel pick it up;
# releasing commits the board it previews.
let d = drag_session(cols, fn(cs) view(cs, scrolls, sel_id) end)
if d.dropped then
  cols = d.drop
  moves += 1
end

let mx = mouse_x()
let my = mouse_y()

# Which card is the pointer over, as drawn last frame? (Not mid-drag.)
if !d.active then
  for c in range(0, 4) do
    if point_in(px: mx, py: my, r: col_surf(c)) then
      for card in cols[c] do
        let r = ui_target_rect("drag:{card.id}")
        if r != nil && point_in(px: mx, py: my, r: r) then
          set hover_id = card.id
        end
      end
    end
  end
end
let hit = get hover_id

# Wheel scrolls the column under the pointer.
if scroll_y() != 0 && !d.active then
  for c in range(0, 4) do
    let surf = col_surf(c)
    if point_in(px: mx, py: my, r: surf) then
      let content = column_h(cols[c]) + COL_PAD * 2
      let maxs = max(0, content - SURF_H)
      scrolls[c] = max(0, min(maxs, scrolls[c] + scroll_y() * 40))
    end
  end
end

# Press: select the card, or clear the selection on bare well space.
if mouse_pressed(0) && hit != "" then
  sel_id = hit
elsif mouse_pressed(0) then
  let over_board = false
  for c in range(0, 4) do
    if point_in(px: mx, py: my, r: col_surf(c)) then
      over_board = true
    end
  end
  if over_board then
    sel_id = ""
  end
end

# Keyboard: arrows select, shift+arrows move, 1-4 send, p cycles priority.
let cur = find_card(cols, sel_id)
let arrowed = key_pressed("up") || key_pressed("down") || key_pressed("left") || key_pressed("right")
if cur.c < 0 && arrowed && len(cols[0]) > 0 then
  # Nothing selected: the first arrow lands on the first card.
  cur = {c: 0, i: 0}
  sel_id = cols[0][0].id
elsif key_pressed("escape") then
  sel_id = ""
  cur = {c: -1, i: -1}
elsif mod_shift() && cur.c >= 0 then
  if key_pressed("up") && cur.i > 0 then
    let card = cols[cur.c][cur.i]
    cols[cur.c] = list_insert(list_remove(cols[cur.c], cur.i), k: cur.i - 1, v: card)
    moves = moves + 1
  end
  if key_pressed("down") && cur.i < len(cols[cur.c]) - 1 then
    let card = cols[cur.c][cur.i]
    cols[cur.c] = list_insert(list_remove(cols[cur.c], cur.i), k: cur.i + 1, v: card)
    moves = moves + 1
  end
  if key_pressed("left") && cur.c > 0 then
    let card = cols[cur.c][cur.i]
    cols[cur.c] = list_remove(cols[cur.c], cur.i)
    cols[cur.c - 1] = list_insert(cols[cur.c - 1], k: min(cur.i, len(cols[cur.c - 1])), v: card)
    moves = moves + 1
  end
  if key_pressed("right") && cur.c < 3 then
    let card = cols[cur.c][cur.i]
    cols[cur.c] = list_remove(cols[cur.c], cur.i)
    cols[cur.c + 1] = list_insert(cols[cur.c + 1], k: min(cur.i, len(cols[cur.c + 1])), v: card)
    moves = moves + 1
  end
elsif cur.c >= 0 then
  if key_pressed("up") && cur.i > 0 then
    sel_id = cols[cur.c][cur.i - 1].id
  end
  if key_pressed("down") && cur.i < len(cols[cur.c]) - 1 then
    sel_id = cols[cur.c][cur.i + 1].id
  end
  if key_pressed("left") && cur.c > 0 && len(cols[cur.c - 1]) > 0 then
    sel_id = cols[cur.c - 1][min(cur.i, len(cols[cur.c - 1]) - 1)].id
  end
  if key_pressed("right") && cur.c < 3 && len(cols[cur.c + 1]) > 0 then
    sel_id = cols[cur.c + 1][min(cur.i, len(cols[cur.c + 1]) - 1)].id
  end
end

let sent = false
for n in range(0, 4) do
  if key_pressed(str(n + 1)) && cur.c >= 0 && cur.c != n && len(cols[cur.c]) > 0 then
    let card = cols[cur.c][cur.i]
    cols[cur.c] = list_remove(cols[cur.c], cur.i)
    cols[n] = list_insert(cols[n], k: 0, v: card)
    moves = moves + 1
    sent = true
  end
end

# Keyboard navigation keeps the selection on screen.
if arrowed || sent then
  let s2 = find_card(cols, sel_id)
  if s2.c >= 0 then
    let off = 0
    for i in range(0, s2.i) do
      off = off + card_h(cols[s2.c][i]) + CARD_GAP
    end
    let view_h = SURF_H - COL_PAD * 2
    scrolls[s2.c] = max(0, ensure_visible_px(scroll: scrolls[s2.c], row_off: off, row_h: card_h(cols[s2.c][s2.i]), view_h: view_h))
  end
end

if key_pressed("p") then
  let seat = find_card(cols, sel_id)
  if seat.c >= 0 then
    let card = cols[seat.c][seat.i]
    card.pri = (card.pri + 1) % 3
    cols[seat.c][seat.i] = card
  end
end

# ── Frame ────────────────────────────────────────────────────────────────

let sel = find_card(cols, sel_id)

clear(BG.r, BG.g, BG.b)

# Header ------------------------------------------------------------------
let total_pts = 0
let done_pts = 0
let n_cards = 0
for c in range(0, 4) do
  for card in cols[c] do
    total_pts = total_pts + card.pts
    n_cards = n_cards + 1
    if c == 3 then
      done_pts = done_pts + card.pts
    end
  end
end

draw_text("Petal Board", pos: {x: M, y: 24}, style: {size: 25, color: TEXT})
let move_note = if moves == 1 then "1 card moved" else "{moves} cards moved" end
draw_text(fit_parts(parts: ["sprint 24", "{n_cards} cards", move_note], avail_px: W / 2, size: 11),
  pos: {x: M + 2, y: 60}, style: {size: 11, color: DIM, spacing: 1})

let bar_w = 260
let bar_x = W - M - bar_w
draw_text_right("{done_pts} of {total_pts} points shipped", right_x: W - M, y: 26, size: 11, c: DIM)
draw_rect_rounded(rect(bar_x, 48, bar_w, 6), radius: 3, c: RULE)
let fill_w = if total_pts > 0 then bar_w * done_pts / total_pts else 0 end
if fill_w > 0 then
  draw_rect_rounded(rect(bar_x, 48, max(6, fill_w), 6), radius: 3, c: GOOD)
end
draw_rect(rect(0, 86, W, 1), RULE)

# Columns: the board a drag previews, else the board.
view(if d.active then d.preview else cols end, scrolls, sel_id)

# Footer ------------------------------------------------------------------
let fy = H - FOOT_H
draw_rect(rect(0, fy, W, 1), RULE)
if sel.c >= 0 then
  let card = cols[sel.c][sel.i]
  let wc = who_color(card.who)
  draw_circle({x: M + 10, y: fy + 27}, 10, wc, 46)
  draw_text_center(card.who, cx: M + 10, y: fy + 22, size: 10, c: wc)
  draw_text(ellipsize(card.title, avail_px: W / 2 - 120, size: 13), pos: {x: M + 30, y: fy + 14},
    style: {size: 13, color: TEXT})
  draw_text(fit_parts(parts: [LANES[sel.c].name, card.tag, pri_name(card.pri),
    "{card.pts} pts"], avail_px: W / 2 - 120, size: 10),
    pos: {x: M + 30, y: fy + 32}, style: {size: 10, color: FAINT, spacing: 1})
else
  draw_text("nothing selected", pos: {x: M, y: fy + 22}, style: {size: 12, color: FAINT})
end

let hints = fit_parts(parts: ["drag a card", "arrows select", "shift+arrows move",
  "1-4 send to lane", "p priority", "esc deselect"],
  avail_px: W - M * 2 - 440, size: 11)
draw_text_right(hints, right_x: W - M, y: fy + 22, size: 11, c: FAINT)
