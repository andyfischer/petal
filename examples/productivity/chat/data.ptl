  {id: "launch", kind: "channel", name: "launch-lumen", topic: "Lumen 2.0 ships Thursday · runbook is pinned", members: ALL},
  {id: "design", kind: "channel", name: "design", topic: "Crits, specs and Figma links", members: ["jordan", "maya", "kenji", "priya"]},
  {id: "eng", kind: "channel", name: "eng-platform", topic: "CI, infra, on-call · Theo is on call from 6pm", members: ["jordan", "theo", "lars"]},
  {id: "random", kind: "channel", name: "random", topic: "Sourdough, coffee machines and other emergencies", members: ALL},
  {id: "dm-maya", kind: "dm", name: "Maya Chen", topic: "Design lead", members: ["jordan", "maya"]},
  {id: "dm-theo", kind: "dm", name: "Theo Okafor", topic: "Sync engine", members: ["jordan", "theo"]},
  {id: "dm-priya", kind: "dm", name: "Priya Natarajan", topic: "Product manager", members: ["jordan", "priya"]},
]

pub fn channel(id: string) -> record
  find(CHANNELS, fn(c) -> c.id == id) ?? CHANNELS[0]
end

pub fn channel_index(id: string) -> int
  let ids = map(CHANNELS, fn(c) -> c.id)
  max(0, index_of(ids, id))
end

// The other person in a direct message.
pub fn dm_peer(c: record) -> string
  find(c.members, fn(k) -> k != ME) ?? ME
end

// ── Time ─────────────────────────────────────────────────────────────────

pub fn clock_text(minute: int) -> string
  let h = (minute / 60) % 24
  let m = minute % 60
  let h12 = if h % 12 == 0 then 12 else h % 12 end
  let ampm = if h < 12 then "AM" else "PM" end
  "{h12}:{pad_start(str(m), 2, "0")} {ampm}"
end

// ── Seeded history ───────────────────────────────────────────────────────
// day 0 is yesterday, day 1 today.

fn m(ch: string, who: string, day: int, at: int, text: string, reacts: list, thread: list) -> record
  {id: 0, ch: ch, who: who, day: day, at: at, text: text, reacts: reacts, thread: thread, born: -1.0}
end

fn r(e: string, who: list) -> record
  {e: e, who: who}
end

fn t(who: string, at: int, text: string) -> record
  {who: who, at: at, text: text, born: -1.0}
end

fn hm(h: int, mi: int) -> int
  h * 60 + mi
end

