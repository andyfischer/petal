# glsl — translate a Petal function to GLSL. EXPERIMENTAL.
#
#     import glsl
#
#     let grade = fn(fx: Fx, amount = 0.5) -> fx.color * amount
#     let g = glsl.glsl_function(grade, ENV)   // {code, common, params, uniforms, taps, error, ...}
#     let text = glsl.to_glsl(grade, ENV)      // the same as one GLSL string
#
# The translator reads the function with the core introspection builtins
# (`fn_info`, `fn_ast`) and walks its syntax tree. It runs nothing: the code
# only has to be in the pure numeric subset (floats, ints, bools, vec2/vec3,
# arithmetic, the math builtins, `let`/`var`/`set`, `if`, `for i in range`,
# `while`, `return`, calls of other translatable functions). Anything else is
# refused with the line and column of the construct.
#
# The result is cached under the function's `code_hash`, so a script that
# calls this every frame translates once, and again only after an edit that
# changes the function (or a function it calls). See
# docs/game-engine-features/petal-to-glsl.md for the mapping, the environment record and the
# limits.

pub let VERSION = 1

# --- GLSL types ------------------------------------------------------------
#
# The host names types with strings (`env.structs`, `env.functions`, and the
# annotations in the Petal source); they become a `Ty` on the way in and a
# string again on the way out (`ty_text`).

enum Ty
  float(dim: 1),
  int(dim: 1),
  bool(dim: 1),
  vec2(dim: 2),
  vec3(dim: 3),
  vec4(dim: 4),
  # A struct of `env.structs`, or a type only the host's functions know.
  named(id, dim: 0),
  # The type of an expression that was refused.
  unknown(dim: 0),

let TY_BY_NAME = {
  float: Ty.float, int: Ty.int, bool: Ty.bool,
  vec2: Ty.vec2, vec3: Ty.vec3, vec4: Ty.vec4,
}
# The float vector of each width (a width of 1 is a float).
let VEC_OF_DIM = [Ty.unknown, Ty.float, Ty.vec2, Ty.vec3, Ty.vec4]

fn ty_named(name: string) -> Ty
  TY_BY_NAME?.[name] ?? Ty.named(name)

fn ty_text(t: Ty) -> string
  match t
    when Ty.named(id) -> id
    when Ty.unknown -> "?"
    when _ -> t.name

# A float, int, bool or vector: what a uniform or a local may be.
fn is_value_type(t: Ty) -> bool
  t.dim > 0

fn is_vec(t: Ty) -> bool
  t.dim > 1

fn is_num(t: Ty) -> bool
  t == Ty.int || t == Ty.float

# The vector type a call of `name` constructs (`vec3(...)`), or nil.
fn vec_ctor(name: string)
  let t = TY_BY_NAME?.[name]
  if t != nil && is_vec(t) then t else nil end

# `env.structs` with its field types read: {Fx: {color: Ty.vec3, ...}}.
fn read_structs(raw: record) -> record
  let out = {}
  for name in keys(raw) do
    let fields = {}
    for f in keys(raw[name]) do
      fields[f] = ty_named(raw[name][f])
    out[name] = fields
  out

# `env.functions` with its signatures read.
fn read_signatures(raw: record) -> record
  let out = {}
  for name in keys(raw) do
    let sig = raw[name]
    out[name] = Sig(for a in sig.args do ty_named(a) end, ty_named(sig.returns))
  out

# --- Tables ----------------------------------------------------------------

# Petal builtin -> GLSL name, generic over float / vecN: f(T) -> T.
let SAME_TYPE_1 = {
  floor: "floor", ceil: "ceil", fract: "fract", round: "round",
  sin: "sin", cos: "cos", tan: "tan", asin: "asin", acos: "acos",
  atan: "atan", exp: "exp", log: "log", sqrt: "sqrt",
  radians: "radians", degrees: "degrees", normalize: "normalize",
}
# Also defined on int.
let KEEP_INT_1 = {abs: "abs", sign: "sign"}
# f(float | vecN, ...) -> the widest argument; the value is the arity.
let WIDEST_N = {clamp: 3, lerp: 3, smoothstep: 3, step: 2, mod: 2, pow: 2}

# Names a local must not take: GLSL keywords, and the functions this
# translator emits calls to (a local of that name would hide the function).
let RESERVED_LIST = [
  "sample", "input", "output", "common", "filter", "active", "half", "fixed",
  "texture", "mix", "length", "step", "mod", "min", "max", "fx", "params",
  "in", "out", "inout", "const", "float", "int", "bool", "uniform", "main",
  "union", "partition", "superp", "patch", "smooth", "flat", "layout",
  "floor", "ceil", "fract", "round", "sin", "cos", "tan", "asin", "acos",
  "atan", "exp", "log", "sqrt", "radians", "degrees", "normalize", "abs",
  "sign", "clamp", "smoothstep", "pow", "distance", "dot", "cross", "trunc",
  "vec2", "vec3", "vec4", "mat2", "mat3", "mat4", "true", "false", "if",
  "else", "for", "while", "return", "break", "continue", "void", "struct",
  "discard", "do", "switch", "case", "default", "highp", "mediump", "lowp",
  "precision",
]

# Precedence levels, loosest first: 0 ternary, 1 ||, 2 &&, 3 == !=,
# 4 < <= > >=, 5 + -, 6 * / %, 7 unary, 8 atom.
let BINOPS = {
  Add: {sym: "+", prec: 5}, Sub: {sym: "-", prec: 5},
  Mul: {sym: "*", prec: 6}, Div: {sym: "/", prec: 6},
  Lt: {sym: "<", prec: 4}, Le: {sym: "<=", prec: 4},
  Gt: {sym: ">", prec: 4}, Ge: {sym: ">=", prec: 4},
  Eq: {sym: "==", prec: 3}, Ne: {sym: "!=", prec: 3},
  And: {sym: "&&", prec: 2}, Or: {sym: "||", prec: 1},
}

# --- Values ----------------------------------------------------------------

# A translated expression: GLSL text, its type, its precedence.
class Val
  code: string,
  ty: Ty,
  prec: int,
  # The value of an int literal (it can be re-printed as a float), or nil.
  lit,
  # The value of a constant int expression (for loop trip counts), or nil.
  cv,

# The two operands of an arithmetic operator, brought to compatible types.
class Operands
  a: Val,
  b: Val,
  ty: Ty,

# A function body's tail value and where it is.
class Tail
  v: Val,
  node: record,

fn atom(code: string, ty: Ty) -> Val
  Val(code, ty, 8, nil, nil)

fn bad() -> Val
  Val("?", Ty.unknown, 8, nil, nil)

fn at(v: Val, prec: int) -> string
  if v.prec >= prec then v.code else "(" ++ v.code ++ ")" end

fn has(rec: record, name: string) -> bool
  rec?.[name] != nil

fn float_lit(x: num) -> string
  let text = str(float(x))
  if index_of(text, ".") < 0 && index_of(text, "e") < 0 then text ++ ".0" else text end

fn finite(x: float) -> bool
  x == x && x < 1.0e300 && x > -1.0e300

fn srgb_to_linear(channel: int) -> float
  let c = channel / 255.0
  let lin = if c <= 0.04045 then c / 12.92 else pow((c + 0.055) / 1.055, 2.4) end
  round(lin * 1000000.0) / 1000000.0

# Whether `v` (any value) is a color record (what `#rrggbb` evaluates to).
fn is_color(v) -> bool
  if type(v) != "record" then return false end
  let ks = keys(v)
  if len(ks) != 3 then return false end
  type(v?.r) == "int" && type(v?.g) == "int" && type(v?.b) == "int"

fn color_vec3(r: int, g: int, b: int) -> string
  "vec3(" ++ float_lit(srgb_to_linear(r)) ++ ", " ++ float_lit(srgb_to_linear(g)) ++ ", " ++
    float_lit(srgb_to_linear(b)) ++ ")"

# [r, g, b] when `node` is what a color literal parses to, else nil.
fn color_of(node: record)
  if node.tag != "Record" || len(node.fields) != 3 then return nil end
  let out = {}
  for f in node.fields do
    if f.spread || f.value.tag != "Literal" || f.value.type != "int" then return nil end
    out[f.name] = f.value.value
  if has(out, "r") && has(out, "g") && has(out, "b") then [out.r, out.g, out.b] else nil end

fn join_codes(vals: list) -> string
  join(for v in vals do v.code end, ", ")

# --- The translation context -----------------------------------------------
#
# `c` is one function being translated. `c.read()` / `c.write(s)` read and
# write its mutable half (a `FnState`), and `c.tr` is the same pair for what
# the whole translation shares (a `TranslationState`). `c.cfg` is what the
# environment and the options say, the same for every function.

# A mutable value behind two closures.
class Cell
  read: function,
  write: function,

class Config
  # {name: Sig}: the functions the shader has that Petal does not.
  env_fns: record,
  # {name: {field: Ty}}.
  structs: record,
  # The names of `env.count`.
  counted: list,
  inline: bool,
  # `params.` (or "") in front of a uniform's name.
  uniforms_struct: string,
  # In front of a helper's GLSL name.
  prefix: string,

class Sig
  args: list,
  returns: Ty,

# A local or a parameter in scope: its GLSL name and type.
class Local
  glsl: string,
  ty: Ty,

# A hook's result: the struct field the body's value is assigned to.
class Hook
  target: string,
  ty: Ty,

# A translated helper and how to call it. Emitted once per name.
class Helper
  glsl: string,
  params: list,
  ret: Ty,
  taps: int,
  taps_hidden: bool,

class FnState
  lines: list,
  # A list of {name: Local}, innermost last.
  scopes: list,
  # The GLSL names taken: {name: true}.
  used: record,
  indent: int,
  # How many times the current statement runs per call, nil when not known.
  loop_factor,
  taps: int,
  taps_hidden: bool,
  # The return type, a Ty once known.
  ret_ty,

class TranslationState
  # {name: Helper}.
  helpers: record,
  # The GLSL of every helper, in order.
  common: list,
  # The first error, {message, line, column}, or nil.
  err,
  uniforms: list,
  # {name: glsl type string}.
  uniform_types: record,
  # The helpers being translated (to refuse recursion).
  busy: list,

class Ctx
  read: function,
  write: function,
  tr: Cell,
  cfg: Config,
  # {name: {value}}: what the function captured.
  captures: record,
  uniform_prefix: string,
  # A Hook, or nil for a plain function.
  hook,
  # The function's name, nil for the entry function.
  fn_name,
  line,
  column,

fn cell(initial) -> Cell
  var value = initial
  Cell(read: fn() -> get value, write: fn(s)
    set value = s
    nil
  )

# `node` is the construct refused, or nil for the function itself.
fn fail(c: Ctx, message: string, node) -> Val
  let ts = c.tr.read()
  if ts.err == nil then
    let line = if node != nil then node.line else c.line end
    let column = if node != nil then node.column else c.column end
    ts.err = {message: message, line: line, column: column}
    c.tr.write(ts)
  bad()

fn failed(c: Ctx) -> bool
  c.tr.read().err != nil

fn emit(c: Ctx, text: string) -> nil
  let s = c.read()
  s.lines = append(s.lines, repeat("    ", s.indent) ++ text)
  c.write(s)

fn declare(c: Ctx, name: string, ty: Ty) -> string
  let s = c.read()
  let glsl = if contains(RESERVED_LIST, name) || has(c.cfg.env_fns, name) then name ++ "_" else name end
  let n = 1
  while has(s.used, glsl) do
    glsl = name ++ "_" ++ str(n)
    n += 1
  s.used[glsl] = true
  let top = len(s.scopes) - 1
  let scope = s.scopes[top]
  scope[name] = Local(glsl, ty)
  s.scopes[top] = scope
  c.write(s)
  glsl

# The Local `name` is, or nil.
fn lookup(c: Ctx, name: string)
  let scopes = c.read().scopes
  let n = len(scopes)
  for i in range(0, n) do
    let found = scopes[n - 1 - i]?.[name]
    if found != nil then return found end
  nil

fn push_scope(c: Ctx) -> nil
  let s = c.read()
  s.scopes = append(s.scopes, {})
  c.write(s)

fn pop_scope(c: Ctx) -> nil
  let s = c.read()
  s.scopes = drop_last(s.scopes)
  c.write(s)

fn indent_by(c: Ctx, by: int) -> nil
  let s = c.read()
  s.indent += by
  c.write(s)

# --- Types -----------------------------------------------------------------

fn to_float(c: Ctx, v: Val, node: record) -> Val
  if v.ty == Ty.float then return v end
  if v.ty == Ty.int then
    if v.lit != nil then
      return Val(float_lit(v.lit), Ty.float, if v.lit < 0 then 7 else 8 end, nil, nil)
    return atom("float(" ++ v.code ++ ")", Ty.float)
  fail(c, "expected a number, found " ++ ty_text(v.ty), node)

fn coerce(c: Ctx, v: Val, ty: Ty, node: record) -> Val
  if v.ty == ty then return v end
  if ty == Ty.float then return to_float(c, v, node) end
  fail(c, "expected " ++ ty_text(ty) ++ ", found " ++ ty_text(v.ty), node)

# Bring two operands of an arithmetic operator to compatible GLSL types.
fn unify(c: Ctx, a: Val, b: Val, node: record) -> Operands
  if a.ty == b.ty then return Operands(a, b, a.ty) end
  if is_vec(a.ty) && is_num(b.ty) then return Operands(a, to_float(c, b, node), a.ty) end
  if is_vec(b.ty) && is_num(a.ty) then return Operands(to_float(c, a, node), b, b.ty) end
  if is_num(a.ty) && is_num(b.ty) then
    return Operands(to_float(c, a, node), to_float(c, b, node), Ty.float)
  fail(c, "no GLSL operation between " ++ ty_text(a.ty) ++ " and " ++ ty_text(b.ty), node)
  Operands(a, b, Ty.unknown)

fn floats(c: Ctx, args: list, node: record) -> list
  for a in args do
    if is_vec(a.ty) then a else to_float(c, a, node) end

fn widest(c: Ctx, vals: list, node: record) -> Ty
  let found = nil
  for v in vals do
    if is_vec(v.ty) then
      if found != nil && found != v.ty then
        fail(c, "mixed vector sizes " ++ ty_text(found) ++ " and " ++ ty_text(v.ty), node)
        return Ty.unknown
      found = v.ty
  found ?? Ty.float

# --- Expressions -----------------------------------------------------------

fn expr(c: Ctx, node: record) -> Val
  if failed(c) then return bad() end
  match node.tag
    when "Literal" -> e_literal(c, node)
    when "Ident" -> e_ident(c, node)
    when "CellGet" -> e_ident(c, node)
    when "Record" -> e_record(c, node)
    when "UnaryOp" -> e_unary(c, node)
    when "BinaryOp" -> e_binary(c, node)
    when "FieldAccess" -> e_field(c, node)
    when "If" -> e_if(c, node)
    when "Call" -> e_call(c, node)
    when "For" -> fail(c, "a `for` used as a value builds a list, which has no GLSL form", node)
    when "Lambda" -> fail(c, "a function value has no GLSL form", node)
    when other -> fail(c, other ++ " has no GLSL form", node)

fn e_literal(c: Ctx, node: record) -> Val
  if node.type == "float" then return atom(float_lit(node.value), Ty.float) end
  if node.type == "int" then return Val(str(node.value), Ty.int, 8, node.value, node.value) end
  if node.type == "bool" then return atom(if node.value then "true" else "false" end, Ty.bool) end
  fail(c, "a " ++ node.type ++ " literal has no GLSL form", node)

# A captured value read as an expression.
fn capture(c: Ctx, name: string, value, node: record) -> Val
  let t = type(value)
  if t == "int" then
    return Val(str(value), Ty.int, if value < 0 then 7 else 8 end, value, value)
  if t == "bool" then return atom(if value then "true" else "false" end, Ty.bool) end
  if t == "function" then
    return fail(c, "`" ++ name ++ "` is a function; a function can only be called here", node)
  let ty = if t == "float" then Ty.float
    else if t == "vec2" then Ty.vec2
    else if t == "vec3" then Ty.vec3
    else if is_color(value) then Ty.vec3
    else nil end
  if ty == nil then
    return fail(c, "captured `" ++ name ++ "` is a " ++ t ++ ", which has no GLSL form", node)
  if c.cfg.inline then
    if t == "float" then
      if !finite(value) then
        return fail(c, "captured `" ++ name ++ "` is not a finite number", node)
      return Val(float_lit(value), Ty.float, if value < 0.0 then 7 else 8 end, nil, nil)
    if t == "vec2" then
      return atom("vec2(" ++ float_lit(value.x) ++ ", " ++ float_lit(value.y) ++ ")", Ty.vec2)
    if t == "vec3" then
      return atom("vec3(" ++ float_lit(value.x) ++ ", " ++ float_lit(value.y) ++ ", " ++
        float_lit(value.z) ++ ")", Ty.vec3)
    return atom(color_vec3(value.r, value.g, value.b), Ty.vec3)
  # A uniform: the text then depends on the code alone, never on the value.
  let uname = c.uniform_prefix ++ name
  let ts = c.tr.read()
  if !contains(ts.uniforms, uname) then
    ts.uniforms = append(ts.uniforms, uname)
    ts.uniform_types[uname] = ty_text(ty)
    c.tr.write(ts)
  atom(c.cfg.uniforms_struct ++ uname, ty)

fn e_ident(c: Ctx, node: record) -> Val
  let found = lookup(c, node.name)
  if found != nil then return atom(found.glsl, found.ty) end
  let cap = c.captures?.[node.name]
  if cap != nil then return capture(c, node.name, cap.value, node) end
  fail(c, "`" ++ node.name ++ "` is not a local, a parameter or a captured value", node)

fn e_record(c: Ctx, node: record) -> Val
  let rgb = color_of(node)
  if rgb == nil then
    return fail(c, "a record has no GLSL form (only a color literal does)", node)
  atom(color_vec3(rgb[0], rgb[1], rgb[2]), Ty.vec3)

fn e_unary(c: Ctx, node: record) -> Val
  let v = expr(c, node.operand)
  if node.op == "Neg" then
    if v.lit != nil then return Val(str(-v.lit), Ty.int, 7, -v.lit, -v.lit) end
    if !is_num(v.ty) && !is_vec(v.ty) then
      return fail(c, "cannot negate " ++ ty_text(v.ty), node)
    return Val("-" ++ at(v, 8), v.ty, 7, nil, if v.cv != nil then -v.cv else nil end)
  if v.ty != Ty.bool then
    return fail(c, "`!` needs a bool (GLSL has no truthiness)", node)
  Val("!" ++ at(v, 8), Ty.bool, 7, nil, nil)

fn e_binary(c: Ctx, node: record) -> Val
  let op = node.op
  let a = expr(c, node.left)
  let b = expr(c, node.right)
  if failed(c) then return bad() end
  if op == "And" || op == "Or" then
    if a.ty != Ty.bool || b.ty != Ty.bool then
      return fail(c, "`" ++ lower(op) ++ "` needs bools (GLSL has no truthiness)", node)
    let o = BINOPS[op]
    return Val(at(a, o.prec) ++ " " ++ o.sym ++ " " ++ at(b, o.prec + 1), Ty.bool, o.prec, nil, nil)
  if op == "Mod" then
    let u = unify(c, a, b, node)
    if u.ty == Ty.int then
      return Val(at(u.a, 6) ++ " % " ++ at(u.b, 7), Ty.int, 6, nil, nil)
    return atom("mod(" ++ u.a.code ++ ", " ++ u.b.code ++ ")", u.ty)
  let o = BINOPS?.[op]
  if o == nil then
    return fail(c, "operator " ++ op ++ " has no GLSL form", node)
  let u = unify(c, a, b, node)
  if failed(c) then return bad() end
  let ty = u.ty
  if o.prec == 4 || o.prec == 3 then
    if o.prec == 4 && !is_num(ty) then
      return fail(c, if is_vec(ty) then "vectors do not order" else "cannot order " ++ ty_text(ty) end, node)
    ty = Ty.bool
  else if !is_num(ty) && !is_vec(ty) then
    return fail(c, "no GLSL operation `" ++ o.sym ++ "` on " ++ ty_text(ty), node)
  let cv = nil
  if ty == Ty.int && a.cv != nil && b.cv != nil then
    cv = match op
      when "Add" -> a.cv + b.cv
      when "Sub" -> a.cv - b.cv
      when "Mul" -> a.cv * b.cv
      when _ -> nil
  Val(at(u.a, o.prec) ++ " " ++ o.sym ++ " " ++ at(u.b, o.prec + 1), ty, o.prec, nil, cv)

fn swizzle_ok(field: string, dim: int) -> bool
  let n = len(field)
  if n < 1 || n > 4 then return false end
  for names in ["xyzw", "rgba"] do
    let allowed = slice(names, 0, dim)
    let ok = true
    for i in range(0, n) do
      if index_of(allowed, field[i]) < 0 then ok = false end
    if ok then return true end
  false

# {field: Ty} when `ty` is a struct of the environment, else nil.
fn struct_fields(c: Ctx, ty: Ty)
  match ty
    when Ty.named(id) -> c.cfg.structs?.[id]
    when _ -> nil

fn e_field(c: Ctx, node: record) -> Val
  let obj = expr(c, node.object)
  if failed(c) then return bad() end
  let field = node.field
  let fields = struct_fields(c, obj.ty)
  if fields != nil then
    let fty = fields?.[field]
    if fty == nil then
      return fail(c, ty_text(obj.ty) ++ " has no field `" ++ field ++ "`", node)
    return atom(at(obj, 8) ++ "." ++ field, fty)
  if is_vec(obj.ty) then
    if swizzle_ok(field, obj.ty.dim) then
      return atom(at(obj, 8) ++ "." ++ field, VEC_OF_DIM[len(field)])
    return fail(c, ty_text(obj.ty) ++ " has no component(s) `" ++ field ++ "`", node)
  fail(c, "field access on " ++ ty_text(obj.ty), node)

fn cond(c: Ctx, node: record) -> Val
  let v = expr(c, node)
  if failed(c) then return bad() end
  if v.ty != Ty.bool then
    return fail(c, "a condition must be a bool, found " ++ ty_text(v.ty) ++ " (GLSL has no truthiness)", node)
  v

fn single_expr(stmts: list) -> bool
  len(stmts) == 1 && stmts[0].tag == "Expr"

# An `if` whose value is used.
fn e_if(c: Ctx, node: record) -> Val
  let then_body = node.then_body
  let else_body = node.else_body
  if else_body == nil then
    return fail(c, "an `if` used as a value needs an `else`", node)
  if single_expr(then_body) && single_expr(else_body) then
    # Two plain expressions: a ternary, unless an arm needs statements of its
    # own (then everything it did is undone and the general form is used).
    let saved = c.read()
    let cv = cond(c, node.condition)
    let a = expr(c, then_body[0].expr)
    let b = expr(c, else_body[0].expr)
    if failed(c) then return bad() end
    if len(c.read().lines) == len(saved.lines) then
      let u = unify(c, a, b, node)
      if failed(c) then return bad() end
      return Val(at(cv, 1) ++ " ? " ++ at(u.a, 1) ++ " : " ++ at(u.b, 1), u.ty, 0, nil, nil)
    c.write(saved)
  # A temporary assigned in both arms.
  let tmp = declare(c, "pick", Ty.unknown)
  let slot = len(c.read().lines)
  emit(c, "")
  let cv = cond(c, node.condition)
  emit(c, "if (" ++ cv.code ++ ") \{")
  let ty = branch_value(c, then_body, tmp, node)
  emit(c, "} else \{")
  let ty2 = branch_value(c, else_body, tmp, node)
  emit(c, "}")
  if failed(c) then return bad() end
  if ty != ty2 then
    return fail(c, "the arms of this `if` have different types (" ++ ty_text(ty) ++ ", " ++
      ty_text(ty2) ++ ")", node)
  let s = c.read()
  s.lines[slot] = repeat("    ", s.indent) ++ ty_text(ty) ++ " " ++ tmp ++ ";"
  c.write(s)
  atom(tmp, ty)

fn branch_value(c: Ctx, stmts: list, tmp: string, node: record) -> Ty
  if len(stmts) == 0 || stmts[len(stmts) - 1].tag != "Expr" then
    fail(c, "this arm has no value", node)
    return Ty.unknown
  indent_by(c, 1)
  push_scope(c)
  for i in range(0, len(stmts) - 1) do
    stmt(c, stmts[i])
  let v = expr(c, stmts[len(stmts) - 1].expr)
  emit(c, tmp ++ " = " ++ v.code ++ ";")
  pop_scope(c)
  indent_by(c, -1)
  v.ty

fn count_taps(c: Ctx, times: int) -> nil
  let s = c.read()
  if s.loop_factor == nil then
    s.taps_hidden = true
  else
    s.taps += times * s.loop_factor
  c.write(s)

fn call_text(name: string, vals: list) -> string
  name ++ "(" ++ join_codes(vals) ++ ")"

fn e_call(c: Ctx, node: record) -> Val
  if node.function.tag != "Ident" then
    return fail(c, "only calls of named functions translate", node)
  if len(node.arg_names) > 0 then
    return fail(c, "named arguments do not translate; pass them by position", node)
  let name = node.function.name
  let args = for a in node.args do expr(c, a) end
  if failed(c) then return bad() end
  let n = len(args)

  if lookup(c, name) == nil then
    let cap = c.captures?.[name]
    if cap != nil && type(cap.value) == "function" then
      return call_helper(c, name, cap.value, args, node)
  let vt = vec_ctor(name)
  if vt != nil then
    let fl = floats(c, args, node)
    if failed(c) then return bad() end
    let total = 0
    for a in fl do
      total += a.ty.dim
    if total != 1 && total != vt.dim then
      return fail(c, name ++ "() from " ++ join(for a in fl do ty_text(a.ty) end, ", "), node)
    return atom(call_text(name, fl), vt)
  if name == "float" && n == 1 then return to_float(c, args[0], node) end
  if name == "int" && n == 1 then
    if !is_num(args[0].ty) then return fail(c, "int() of " ++ ty_text(args[0].ty), node) end
    return atom(call_text("int", args), Ty.int)
  let sig = c.cfg.env_fns?.[name]
  if sig != nil then
    if n != len(sig.args) then
      return fail(c, name ++ "() takes " ++ str(len(sig.args)) ++ " argument(s)", node)
    if contains(c.cfg.counted, name) then count_taps(c, 1) end
    let vals = for i in range(0, n) do coerce(c, args[i], sig.args[i], node) end
    if failed(c) then return bad() end
    return atom(call_text(name, vals), sig.returns)
  if has(KEEP_INT_1, name) && n == 1 then
    if !is_num(args[0].ty) && !is_vec(args[0].ty) then
      return fail(c, name ++ "() of " ++ ty_text(args[0].ty), node)
    return atom(call_text(KEEP_INT_1[name], args), args[0].ty)
  if has(SAME_TYPE_1, name) && n == 1 then
    let fl = floats(c, args, node)
    if failed(c) then return bad() end
    return atom(call_text(SAME_TYPE_1[name], fl), fl[0].ty)
  if (name == "min" || name == "max") && n == 2 then
    if args[0].ty == Ty.int && args[1].ty == Ty.int then
      return atom(call_text(name, args), Ty.int)
    let fl = floats(c, args, node)
    let ty = widest(c, fl, node)
    if failed(c) then return bad() end
    return atom(call_text(name, fl), ty)
  if has(WIDEST_N, name) then
    if n != WIDEST_N[name] then
      return fail(c, name ++ "() takes " ++ str(WIDEST_N[name]) ++ " arguments", node)
    let fl = floats(c, args, node)
    let ty = widest(c, fl, node)
    if failed(c) then return bad() end
    if name == "pow" then
      # GLSL's pow wants both arguments of one type.
      fl = for a in fl do
        if a.ty == ty then a else atom(ty_text(ty) ++ "(" ++ a.code ++ ")", ty) end
    return atom(call_text(if name == "lerp" then "mix" else name end, fl), ty)
  if name == "mag" || name == "distance" || name == "dot" then
    let fl = floats(c, args, node)
    if failed(c) then return bad() end
    if name == "mag" && n > 1 then
      if n > 4 then return fail(c, "mag() takes at most 4 numbers", node) end
      return atom("length(" ++ ty_text(VEC_OF_DIM[n]) ++ "(" ++ join_codes(fl) ++ "))", Ty.float)
    return atom(call_text(if name == "mag" then "length" else name end, fl), Ty.float)
  if name == "cross" && n == 2 then return atom(call_text("cross", args), Ty.vec3) end
  if name == "atan2" && n == 2 then
    let fl = floats(c, args, node)
    if failed(c) then return bad() end
    return atom(call_text("atan", fl), Ty.float)
  if name == "hypot" && n == 2 then
    let fl = floats(c, args, node)
    if failed(c) then return bad() end
    return atom("length(vec2(" ++ join_codes(fl) ++ "))", Ty.float)
  if name == "pi" && n == 0 then return atom("3.141592653589793", Ty.float) end
  if name == c.fn_name then
    return fail(c, "`" ++ name ++ "` calls itself; GLSL has no recursion", node)
  fail(c, "`" ++ name ++ "` is not a function the shader has", node)

fn call_helper(c: Ctx, name: string, value: function, args: list, node: record) -> Val
  let h = helper(c, name, value, node)
  if h == nil then return bad() end
  if len(args) != len(h.params) then
    return fail(c, name ++ "() takes " ++ str(len(h.params)) ++ " argument(s)", node)
  let vals = for i in range(0, len(args)) do coerce(c, args[i], h.params[i], node) end
  if failed(c) then return bad() end
  let s = c.read()
  s.taps += h.taps * (s.loop_factor ?? 1)
  if h.taps_hidden || (h.taps > 0 && s.loop_factor == nil) then s.taps_hidden = true end
  c.write(s)
  atom(call_text(h.glsl, vals), h.ret)

# --- Statements ------------------------------------------------------------

# A function body: its statements, then the tail value (a Tail; nil when the
# body ends in a statement).
fn body(c: Ctx, stmts: list)
  let n = len(stmts)
  if n == 0 then return nil end
  for i in range(0, n - 1) do
    stmt(c, stmts[i])
  let last = stmts[n - 1]
  if last.tag == "Expr" then
    let e = last.expr
    # A loop, or an `if` with no `else`, ends the body as a statement.
    if e.tag != "For" && !(e.tag == "If" && e.else_body == nil) then
      return Tail(expr(c, e), e)
  stmt(c, last)
  nil

fn block(c: Ctx, stmts: list) -> nil
  indent_by(c, 1)
  push_scope(c)
  for s in stmts do
    stmt(c, s)
  pop_scope(c)
  indent_by(c, -1)

fn stmt(c: Ctx, node: record) -> nil
  if failed(c) then return nil end
  let tag = node.tag
  if tag == "Let" then
    let v = expr(c, node.value)
    if node.type != nil then v = coerce(c, v, ty_named(node.type), node) end
    if failed(c) then return nil end
    if !type_ok(c, v.ty) then
      fail(c, "a local cannot hold a " ++ ty_text(v.ty), node)
      return nil
    emit(c, ty_text(v.ty) ++ " " ++ declare(c, node.name, v.ty) ++ " = " ++ v.code ++ ";")
  else if tag == "Set" || tag == "Assign" then
    if node.target.kind != "Name" then
      fail(c, "only whole variables can be assigned (vectors are immutable in Petal)", node)
      return nil
    let found = lookup(c, node.target.name)
    if found == nil then
      fail(c, "`" ++ node.target.name ++ "` is not a local of this function", node)
      return nil
    if index_of(found.glsl, ".") >= 0 then
      fail(c, "`" ++ node.target.name ++ "` is a parameter; a shader cannot assign to it", node)
      return nil
    let v = coerce(c, expr(c, node.value), found.ty, node)
    if failed(c) then return nil end
    emit(c, found.glsl ++ " = " ++ v.code ++ ";")
  else if tag == "Expr" then
    let e = node.expr
    if e.tag == "If" then
      if_stmt(c, e)
    else if e.tag == "For" then
      for_stmt(c, e)
    else
      let v = expr(c, e)
      if !failed(c) then emit(c, v.code ++ ";") end
  else if tag == "For" then
    for_stmt(c, node)
  else if tag == "While" then
    let cv = cond(c, node.condition)
    emit(c, "while (" ++ cv.code ++ ") \{")
    let s = c.read()
    let saved = s.loop_factor
    s.loop_factor = nil
    c.write(s)
    block(c, node.body)
    let s2 = c.read()
    s2.loop_factor = saved
    c.write(s2)
    emit(c, "}")
  else if tag == "Return" then
    if node.value == nil then
      ret(c, nil, node)
    else
      ret(c, expr(c, node.value), node.value)
  else if tag == "Break" then
    emit(c, "break;")
  else if tag == "Continue" then
    emit(c, "continue;")
  else
    fail(c, tag ++ " has no GLSL form", node)

fn if_stmt(c: Ctx, node: record) -> nil
  let cv = cond(c, node.condition)
  emit(c, "if (" ++ cv.code ++ ") \{")
  block(c, node.then_body)
  if node.else_body != nil then
    emit(c, "} else \{")
    block(c, node.else_body)
  emit(c, "}")

fn for_stmt(c: Ctx, node: record) -> nil
  let it = node.iter
  let ok = it.tag == "Call" && it.function.tag == "Ident" && it.function.name == "range"
  if !ok || len(it.args) < 1 || len(it.args) > 3 then
    fail(c, "only `for i in range(...)` translates (no lists in a shader)", node)
    return nil
  let r = for a in it.args do expr(c, a) end
  if failed(c) then return nil end
  for v in r do
    if v.ty != Ty.int then
      fail(c, "range() bounds must be ints", node)
      return nil
  let zero = Val("0", Ty.int, 8, 0, 0)
  let one = Val("1", Ty.int, 8, 1, 1)
  let lo = if len(r) > 1 then r[0] else zero end
  let hi = if len(r) > 1 then r[1] else r[0] end
  let step = if len(r) == 3 then r[2] else one end
  if step.lit == nil || step.lit <= 0 then
    fail(c, "range() step must be a positive literal", node)
    return nil
  let s = c.read()
  let saved = s.loop_factor
  if saved != nil && lo.cv != nil && hi.cv != nil then
    let span = hi.cv - lo.cv
    let trips = if span <= 0 then 0 else (span + step.lit - 1) / step.lit end
    s.loop_factor = saved * trips
  else
    s.loop_factor = nil
  c.write(s)
  push_scope(c)
  let i = declare(c, node.var, Ty.int)
  let inc = if step.lit == 1 then i ++ "++" else i ++ " += " ++ str(step.lit) end
  emit(c, "for (int " ++ i ++ " = " ++ lo.code ++ "; " ++ i ++ " < " ++ hi.code ++ "; " ++ inc ++ ") \{")
  block(c, node.body)
  pop_scope(c)
  let s2 = c.read()
  s2.loop_factor = saved
  c.write(s2)
  emit(c, "}")

# `return v` (v is nil for a bare `return`), or the body's tail value.
fn ret(c: Ctx, v, node: record) -> nil
  if failed(c) then return nil end
  if c.hook != nil then
    if v != nil then
      emit(c, c.hook.target ++ " = " ++ hook_result(c, v, node).code ++ ";")
    emit(c, "return;")
    return nil
  if v == nil then
    fail(c, "a helper must return a value", node)
    return nil
  let s = c.read()
  if s.ret_ty == nil then
    s.ret_ty = v.ty
    c.write(s)
  let out = coerce(c, v, c.read().ret_ty, node)
  if !failed(c) then emit(c, "return " ++ out.code ++ ";") end

fn hook_result(c: Ctx, v: Val, node: record) -> Val
  if v.ty != c.hook.ty then
    return fail(c, "the function returns the new `" ++ c.hook.target ++ "` (" ++ ty_text(c.hook.ty) ++
      "), found " ++ ty_text(v.ty), node)
  v

# --- Functions -------------------------------------------------------------

fn captures_of(info: record) -> record
  let out = {}
  for cap in info.captures do
    out[cap.name] = {value: cap.value}
  out

# A context for translating one function.
fn context(
  tr: Cell, cfg: Config, indent: int, ret_ty, captures: record, uniform_prefix: string,
  hook, fn_name, line, column,
) -> Ctx
  let st = cell(FnState(
    lines: [], scopes: [{}], used: {}, indent: indent, loop_factor: 1,
    taps: 0, taps_hidden: false, ret_ty: ret_ty,
  ))
  Ctx(
    read: st.read, write: st.write, tr: tr, cfg: cfg,
    captures: captures, uniform_prefix: uniform_prefix, hook: hook,
    fn_name: fn_name, line: line, column: column,
  )

fn type_ok(c: Ctx, ty: Ty) -> bool
  is_value_type(ty) || struct_fields(c, ty) != nil

# Translate `value` (a Petal function) into a GLSL function and return how to
# call it (a Helper, nil after a failure). Emitted once per name.
#
# `uprefix` prefixes the uniforms its captures become (default `<name>_`) and
# `glsl_name` overrides the emitted name (default `<prefix><name>`); the entry
# function of a plain-function translation passes both. `node` is the call
# being translated, nil for the entry function.
fn helper(c: Ctx, name: string, value: function, node, uprefix = nil, glsl_name = nil)
  let ts = c.tr.read()
  let known = ts.helpers?.[name]
  if known != nil then return known end
  if contains(ts.busy, name) then
    fail(c, "`" ++ name ++ "` is recursive; GLSL has no recursion", node)
    return nil
  let info = fn_info(value)
  let ast = fn_ast(value)
  if info == nil || ast == nil then
    fail(c, "`" ++ name ++ "` has no source to translate (a builtin or an overloaded function)", node)
    return nil
  ts.busy = append(ts.busy, name)
  c.tr.write(ts)

  let declared_ret = if ast.returns == nil then nil else ty_named(ast.returns) end
  let h = context(
    tr: c.tr, cfg: c.cfg, indent: 1, ret_ty: declared_ret, captures: captures_of(info),
    uniform_prefix: uprefix ?? (name ++ "_"), hook: nil, fn_name: name,
    line: ast.line, column: ast.column,
  )
  let params = []
  let sig = []
  for p in ast.params do
    if p.type == nil then
      fail(c, name ++ ": parameter `" ++ p.name ++ "` needs a type annotation", node)
      return nil
    let pty = ty_named(p.type)
    if !type_ok(c, pty) then
      fail(c, name ++ ": parameter type `" ++ p.type ++ "` has no GLSL form", node)
      return nil
    params = append(params, pty)
    sig = append(sig, p.type ++ " " ++ declare(h, p.name, pty))
  if declared_ret != nil && !type_ok(c, declared_ret) then
    fail(c, name ++ ": return type `" ++ ast.returns ++ "` has no GLSL form", node)
    return nil
  let tail = body(h, ast.body)
  if tail != nil then ret(h, tail.v, tail.node) end
  if failed(c) then return nil end
  let hs = h.read()
  if hs.ret_ty == nil then
    fail(c, name ++ ": cannot tell what it returns; annotate it", node)
    return nil
  let glsl = glsl_name ?? (c.cfg.prefix ++ name)
  let ts2 = c.tr.read()
  ts2.common = concat(ts2.common,
    concat([ty_text(hs.ret_ty) ++ " " ++ glsl ++ "(" ++ join(sig, ", ") ++ ") \{"], concat(hs.lines, ["}"])))
  let out = Helper(glsl, params, hs.ret_ty, hs.taps, hs.taps_hidden)
  ts2.helpers[name] = out
  ts2.busy = filter(ts2.busy, fn(b) -> b != name)
  c.tr.write(ts2)
  out

# The GLSL type of an effect parameter (a uniform); Ty.unknown after a
# failure. `node` is where to report a failure, nil for the function itself.
fn param(c: Ctx, p: record, pinfo: record, node) -> Ty
  if p.default == nil then
    fail(c, "param `" ++ p.name ++ "` needs a default (it is the param's default value)", node)
    return Ty.unknown
  let ty = Ty.unknown
  if p.type == nil then
    let d = p.default
    if d.tag == "Literal" && (d.type == "float" || d.type == "int") then
      ty = Ty.float
    else if d.tag == "UnaryOp" && d.op == "Neg" && d.operand.tag == "Literal" then
      ty = Ty.float
    else if color_of(d) != nil then
      ty = Ty.vec3
    else if d.tag == "Call" && d.function.tag == "Ident" && vec_ctor(d.function.name) != nil then
      ty = vec_ctor(d.function.name)
    else
      fail(c, "cannot tell the type of param `" ++ p.name ++ "` from its default; annotate it", d)
      return Ty.unknown
  else
    ty = ty_named(p.type)
    if !is_value_type(ty) then
      fail(c, "param `" ++ p.name ++ "`: type `" ++ p.type ++ "` has no GLSL form", node)
      return Ty.unknown
  if pinfo.default == nil then
    fail(c, "param `" ++ p.name ++ "`: the default must be a literal (a number, a color, a vec2/vec3 of numbers)", p.default)
    return Ty.unknown
  ty

fn empty_result(message: string, line, column) -> record
  {
    error: {message: message, line: line, column: column},
    kind: nil, name: nil, code: "", common: "", signature: nil,
    params: {}, param_types: {}, uniform_names: [], uniform_types: {},
    taps: nil, taps_in_loop: false,
  }

fn translate(f: function, info: record, env: record, opts: record) -> record
  let ast = fn_ast(f)
  if ast == nil then
    return empty_result("this function has no source to translate", nil, nil)
  let tr = cell(TranslationState(
    helpers: {}, common: [], err: nil, uniforms: [], uniform_types: {}, busy: [],
  ))

  let structs = read_structs(env?.structs ?? {})
  let counted = env?.count ?? []
  let base = opts?.name ?? ast.name
  let cfg = Config(
    env_fns: read_signatures(env?.functions ?? {}),
    structs: structs,
    counted: if type(counted) == "string" then [counted] else counted end,
    inline: opts?.inline_captures ?? false,
    uniforms_struct: if (env?.uniforms ?? "params") == "" then "" else (env?.uniforms ?? "params") ++ "." end,
    prefix: if base == nil then "" else base ++ "_" end,
  )
  let params = ast.params
  let first = if len(params) > 0 then params[0] else nil end
  let is_hook = first != nil && first.type != nil && has(structs, first.type)

  if !is_hook then
    # A plain function: the whole thing is one GLSL function definition.
    # A named fn keeps its name (behind opts.name as a prefix, when given); a
    # lambda is called opts.name, or `f`.
    let name = ast.name ?? (opts?.name ?? "f")
    cfg.prefix = if opts?.name != nil then opts.name ++ "_" else "" end
    let top = context(
      tr: tr, cfg: cfg, indent: 0, ret_ty: nil, captures: {}, uniform_prefix: "", hook: nil,
      fn_name: nil, line: ast.line, column: ast.column,
    )
    let h = helper(top, name, f, nil, "", if ast.name == nil then name else nil end)
    let done = tr.read()
    if done.err != nil then
      return empty_result(done.err.message, done.err.line, done.err.column)
    # The entry function is the last definition; everything before it is common.
    let cut = last_definition(done.common)
    return {
      error: nil, kind: "function", name: h.glsl,
      code: join(slice(done.common, cut, len(done.common)), "\n"),
      common: join(slice(done.common, 0, cut), "\n"),
      signature: nil, params: {}, param_types: {},
      uniform_names: done.uniforms, uniform_types: done.uniform_types,
      taps: if h.taps_hidden then nil else h.taps end, taps_in_loop: false,
    }

  # A hook body: the first parameter is the host's `inout` struct, every
  # other parameter is a uniform with a default, and the body's value is the
  # new value of one field of the struct.
  let self_name = env?.self ?? first.name
  let result_field = env?.result
  if result_field == nil || !has(structs[first.type], result_field) then
    return empty_result("the environment must name the field the body's value is assigned to (env.result), a field of " ++
      first.type, ast.line, ast.column)
  let c = context(
    tr: tr, cfg: cfg, indent: 0, ret_ty: nil, captures: captures_of(info), uniform_prefix: "",
    hook: Hook(self_name ++ "." ++ result_field, structs[first.type][result_field]),
    fn_name: nil, line: ast.line, column: ast.column,
  )
  let s = c.read()
  s.used[first.name] = true
  s.used[self_name] = true
  let scope = s.scopes[0]
  scope[first.name] = Local(self_name, ty_named(first.type))
  let out_params = {}
  let param_types = {}
  for i in range(1, len(params)) do
    let p = params[i]
    let got = param(c, p, info.params[i], nil)
    if failed(c) then
      let e = tr.read()
      return empty_result(e.err.message, e.err.line, e.err.column)
    scope[p.name] = Local(cfg.uniforms_struct ++ p.name, got)
    out_params[p.name] = info.params[i].default
    param_types[p.name] = ty_text(got)
  s.scopes[0] = scope
  c.write(s)

  let tail = body(c, ast.body)
  if tail != nil && !failed(c) then
    emit(c, c.hook.target ++ " = " ++ hook_result(c, tail.v, tail.node).code ++ ";")
  let done = tr.read()
  if done.err != nil then
    return empty_result(done.err.message, done.err.line, done.err.column)
  let fs = c.read()
  let in_loop = false
  for line in fs.lines do
    if index_of(line, "for (") >= 0 || index_of(line, "while (") >= 0 then in_loop = true end
  {
    error: nil, kind: "hook", name: env?.entry ?? "apply",
    code: join(fs.lines, "\n"), common: join(done.common, "\n"),
    signature: "void " ++ (env?.entry ?? "apply") ++ "(inout " ++ first.type ++ " " ++ self_name ++ ")",
    params: out_params, param_types: param_types,
    uniform_names: done.uniforms, uniform_types: done.uniform_types,
    taps: if fs.taps_hidden then nil else fs.taps end,
    taps_in_loop: in_loop && fs.taps > 0,
  }

# The index of the line that opens the last function definition in `lines`
# (definitions start in column 0, their bodies are indented).
fn last_definition(lines: list) -> int
  let cut = 0
  for i in range(0, len(lines)) do
    let line = lines[i]
    if line != "}" && !starts_with(line, " ") then cut = i end
  cut

# --- Captures as of this run -----------------------------------------------

# What the cached translation depends on besides the code (`key`: the values
# that are written into the text, and the types of the ones that are not), and
# the current value of every capture that can be a uniform (`values`).
fn live_captures(info: record, prefix: string, inline: bool, depth: int) -> record
  let key = []
  let values = {}
  for cap in info.captures do
    let v = cap.value
    let t = type(v)
    if t == "function" then
      let inner = if depth < 6 then fn_info(v) else nil end
      if inner != nil then
        let sub = live_captures(inner, cap.name ++ "_", inline, depth + 1)
        key = concat(key, sub.key)
        values = {...values, ...sub.values}
    else if t == "int" || t == "bool" || inline then
      key = append(key, [prefix ++ cap.name, v])
    else
      key = append(key, [prefix ++ cap.name, t])
      values[prefix ++ cap.name] = {value: v}
  {key: key, values: values}

# --- The public surface ----------------------------------------------------

# Translate the Petal function `f` to GLSL and return the parts a host needs:
#
#   error         nil, or {message, line, column} for code outside the subset
#   kind          "hook" or "function"
#   code          a hook: the statements of its body; a function: its definition
#   common        the GLSL functions `code` calls (helpers), "" when none
#   name          a function: its GLSL name; a hook: env.entry
#   signature     a hook: "void <entry>(inout <Struct> <self>)"
#   params        a hook: {name: default} for each parameter after the first
#   param_types   {name: glsl type} for the same
#   uniforms      {name: current value} for each captured float / vector /
#                 color the code reads (they are uniforms, not constants)
#   uniform_types {name: glsl type} for the same
#   taps          how many times the functions named in env.count are called
#                 (loops with constant bounds multiplied out), nil if unknown
#   taps_in_loop  whether some of those calls sit in a loop
#   code_hash     the function's code hash (what the cache is keyed on)
#
# `env` describes the shader side: {structs, functions, self, result,
# uniforms, count, entry}. `opts`: {name, inline_captures}. Both are
# documented in docs/game-engine-features/petal-to-glsl.md.
#
# The translation is cached in a `memo` per (code hash, structural captures,
# environment, options), so calling this every frame is cheap: a hit costs
# one `fn_info` per function involved and a memo lookup. It is a pure function
# of that key, so every caller asking for the same shader shares the entry.
pub fn glsl_function(f, env: record = {}, opts: record = {}) -> record
  if type(f) != "function" then
    return {...empty_result("to_glsl expects a function, got a " ++ type(f), nil, nil), uniforms: {}, code_hash: nil}
  let info = fn_info(f)
  if info == nil || info.code_hash == nil then
    return {
      ...empty_result("to_glsl needs a Petal function with source (a lambda or a named fn), not a builtin, a constructor or an overloaded name", nil, nil),
      uniforms: {}, code_hash: nil,
    }
  let live = live_captures(info, "", opts?.inline_captures ?? false, 0)
  memo([info.code_hash, live.key, env, opts]) cached = translate(f, info, env, opts)
  let uniforms = {}
  for name in cached.uniform_names do
    let held = live.values?.[name]
    if held != nil then uniforms[name] = held.value end
  {...cached, uniforms: uniforms, code_hash: info.code_hash}

# The GLSL of `f` as one string: its helpers, then the function itself (a
# hook body is wrapped in its signature). Code outside the subset gives a
# `#error` line carrying the message and position, so the failure surfaces
# where the shader is compiled; use `glsl_function` to get it as data.
pub fn to_glsl(f, env: record = {}, opts: record = {}) -> string
  let g = glsl_function(f, env, opts)
  if g.error != nil then
    return "#error to_glsl: " ++ glsl_error_text(g.error)
  let text = if g.kind == "hook" then
    g.signature ++ " \{\n" ++ join(for line in split(g.code, "\n") do "    " ++ line end, "\n") ++ "\n}"
  else
    g.code
  if g.common == "" then text else g.common ++ "\n\n" ++ text end

# "message [line L, column C]" for an error record of `glsl_function`.
pub fn glsl_error_text(err: record) -> string
  if err.line == nil then
    err.message
  else
    err.message ++ " [line " ++ str(err.line) ++ ", column " ++ str(err.column) ++ "]"
