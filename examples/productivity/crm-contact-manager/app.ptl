  {id: 23, name: "Leila Farhadi",    title: "Head of Support",    company: "Cinder & Co",      email: "leila@cinder.co",       phone: "+1 917 555 0128", stage: "Customer",  value: 34000,  days: 23, owner: "J. Weaver", tags: ["fintech", "support"],        notes: "Uses us daily and files the most detailed feature requests we get. Invite her to the design partner call."},
