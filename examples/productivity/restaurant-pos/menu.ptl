pub fn item_by_id(id: num) -> record
  find(ITEMS, fn(it) -> it.id == id)
end

pub fn items_in(cat: num) -> list
  filter(ITEMS, fn(it) -> it.cat == cat)
end

// ── The floor ───────────────────────────────────────────────────────────────

pub const TABLES = [
  {name: "1", seats: 2}, {name: "2", seats: 2}, {name: "3", seats: 4}, {name: "4", seats: 4},
  {name: "5", seats: 4}, {name: "6", seats: 6}, {name: "7", seats: 4}, {name: "8", seats: 2},
  {name: "9", seats: 6}, {name: "10", seats: 8},
]

// ── The evening so far ──────────────────────────────────────────────────────
// A line is `{id, item, qty, mods, mod_cents, note, sent, sent_at, void}`.
// `mods` is the chosen option labels in group order; `picks` keeps the option
// indices per group so the modifier sheet can reopen an unsent line.

pub fn line(id: num, item_id: num, qty: num, picks: list, note: string, sent_at: num) -> record
  let it = item_by_id(item_id)
  // Seed lines may leave trailing groups out; they are empty choices.
  let full = for g in range(0, len(it.groups)) do
    if g < len(picks) then picks[g] else [] end
  end
  let mods = []
  let cents = 0
  for g in range(0, len(it.groups)) do
    let grp = it.groups[g]
    for k in full[g] do
      let o = grp.opts[k]
      // An optional one-of group's first option is the house default; the
      // check and the kitchen only print a change from it.
      if !(grp.pick == "one" && !grp.req && k == 0) then
        mods = append(mods, o.label)
      end
      cents += o.cents
    end
  end
  {id: id, item: item_id, qty: qty, picks: full, mods: mods, mod_cents: cents, note: note,
    sent: sent_at >= 0, sent_at: sent_at, void: ""}
end

fn empty_table(i: num) -> record
  {guests: 0, opened: -1, lines: [], split: 1, paid: []}
end

// `now` is the clock at the start of service, in seconds after midnight.
pub fn seed_tables(now: num) -> list
  let t = for i in range(0, len(TABLES)) do empty_table(i) end
  t[1] = {...t[1], guests: 2, opened: now - 52 * 60, lines: [
    line(1, 0, 1, [], "", now - 44 * 60),
    line(2, 10, 1, [[1], [1], [0]], "", now - 44 * 60),
    line(3, 12, 1, [[2]], "", now - 44 * 60),
    line(4, 64, 2, [], "", now - 49 * 60),
  ]}
  t[3] = {...t[3], guests: 4, opened: now - 21 * 60, lines: [
    line(5, 61, 1, [[1]], "", now - 18 * 60),
    line(6, 60, 2, [[1]], "", now - 18 * 60),
    line(7, 1, 1, [], "", now - 15 * 60),
    line(8, 2, 1, [[0, 1]], "", now - 15 * 60),
    line(9, 13, 1, [[2], [0], [0], [1]], "No onions", -1),
    line(10, 21, 2, [[1]], "", -1),
    line(11, 11, 1, [[1]], "", -1),
  ]}
  t[6] = {...t[6], guests: 3, opened: now - 7 * 60, lines: [
    line(12, 50, 2, [], "", now - 5 * 60),
    line(13, 62, 1, [], "", now - 5 * 60),
    line(14, 5, 1, [], "Nut allergy", -1),
    line(15, 10, 1, [[1], [3], [0]], "", -1),
    line(16, 31, 1, [], "", -1),
  ]}
  t[8] = {...t[8], guests: 6, opened: now - 84 * 60, split: 3, lines: [
    line(17, 0, 2, [], "", now - 75 * 60),
    line(18, 14, 2, [[1]], "", now - 64 * 60),
    line(19, 22, 1, [[0]], "", now - 64 * 60),
    line(20, 21, 2, [[0]], "", now - 64 * 60),
    line(21, 40, 3, [], "", now - 20 * 60),
    line(22, 64, 4, [], "", now - 80 * 60),
  ]}
  t
end

// Tickets already on the kitchen rail: `{no, table, count, stations, at}`.
pub fn seed_tickets(now: num) -> list
  [
    {no: 1043, table: "7", count: 3, stations: "Bar", at: now - 5 * 60, items: [
      tk(2, "Sparkling Water"), tk(1, "Espresso Martini")]},
    {no: 1042, table: "9", count: 3, stations: "Pastry", at: now - 20 * 60, items: [
      tk(3, "Basque Cheesecake", "", "Candle on one, birthday")]},
    {no: 1041, table: "4", count: 5, stations: "Bar, Cold", at: now - 15 * 60, items: [
      tk(1, "Negroni", "On the rocks"), tk(2, "Old Fashioned", "Rye"), tk(1, "Crispy Calamari"),
      tk(1, "Wood-Fired Flatbread", "Prosciutto, Hot honey")]},
    {no: 1039, table: "2", count: 3, stations: "Cold, Grill", at: now - 44 * 60, items: [
      tk(1, "Burrata & Heirloom"), tk(1, "Ribeye 14 oz", "Medium rare, Garlic mash, Peppercorn sauce"),
      tk(1, "Seared Salmon", "Side salad")]},
  ]
end

fn tk(qty: num, name: string, mods: string = "", note: string = "") -> record
  {qty: qty, name: name, mods: mods, note: note}
end
