// Nature of Code - Mutual Attraction
// Inspired by Chapter 2: Forces - Gravitational Attraction
// N-body simulation where every object attracts every other

state bodies = []
state trails = []
state time = 0.0

let delta = dt()
let sw = float(screen_width())
let sh = float(screen_height())
let PI = pi()
time += delta

let G = 5000.0

// Initialize bodies in orbital configurations
if len(bodies) == 0 then
  // Central massive body
  bodies = append(bodies, {
    x: sw / 2.0, y: sh / 2.0,
    vx: 0.0, vy: 0.0,
    mass: 30.0,
    r: 255, g: 220, b: 100
  })

  // Orbiting bodies
  for i in range(0, 12) do
    let angle = float(i) / 12.0 * PI * 2.0
    let radius = 100.0 + random(30.0, 120.0)
    let orbital_speed = sqrt(G * 30.0 / radius) * 0.4

    bodies = append(bodies, {
      x: sw / 2.0 + cos(angle) * radius,
      y: sh / 2.0 + sin(angle) * radius,
      vx: -sin(angle) * orbital_speed,
      vy: cos(angle) * orbital_speed,
      mass: 2.0 + random(0.0, 6.0),
      r: int(random(100.0, 255.0)),
      g: int(random(100.0, 255.0)),
      b: int(random(150.0, 255.0))
    })
  end
end

// Calculate gravitational forces between all pairs
let forces = []
for i in range(0, len(bodies)) do
  forces = append(forces, { fx: 0.0, fy: 0.0 })
end

for i in range(0, len(bodies)) do
  for j in range(i + 1, len(bodies)) do
    let a = bodies[i]
    let b = bodies[j]

    let dx = b.x - a.x
    let dy = b.y - a.y
    let dist = sqrt(dx * dx + dy * dy)
    let min_dist = (a.mass + b.mass) * 2.0
    let d = max(min_dist, dist)

    // F = G * m1 * m2 / r^2
    let force = G * a.mass * b.mass / (d * d)

    let fx = force * dx / (dist + 0.1)
    let fy = force * dy / (dist + 0.1)

    // Apply to both bodies (Newton's third law)
    forces[i] = { fx: forces[i].fx + fx, fy: forces[i].fy + fy }
    forces[j] = { fx: forces[j].fx - fx, fy: forces[j].fy - fy }
  end
end

// Update bodies
let new_bodies = []
for i in range(0, len(bodies)) do
  let b = bodies[i]
  let f = forces[i]

  // a = F / m
  let ax = f.fx / b.mass
  let ay = f.fy / b.mass

  let nvx = b.vx + ax * delta
  let nvy = b.vy + ay * delta
  let nx = b.x + nvx * delta
  let ny = b.y + nvy * delta

  // Soft boundary (push back toward center)
  let margin = 50.0
  if nx < margin then nvx += 200.0 * delta end
  if nx > sw - margin then nvx -= 200.0 * delta end
  if ny < margin then nvy += 200.0 * delta end
  if ny > sh - margin then nvy -= 200.0 * delta end

  // Record trail
  if frame_count() % 2 == 0 then
    trails = append(trails, { x: nx, y: ny, r: b.r, g: b.g, b: b.b, life: 1.0 })
  end

  new_bodies = append(new_bodies, {
    x: nx, y: ny, vx: nvx, vy: nvy,
    mass: b.mass, r: b.r, g: b.g, b: b.b
  })
end
bodies = new_bodies

// Age trails
let new_trails = []
for t in trails do
  let nt = { x: t.x, y: t.y, r: t.r, g: t.g, b: t.b, life: t.life - delta * 0.3 }
  if nt.life > 0.0 then new_trails = append(new_trails, nt) end
end
trails = new_trails
if len(trails) > 4000 then
  trails = slice(trails, start: len(trails) - 3000, end: len(trails))
end

// === Drawing ===
clear(5, 5, 12)

// Draw gravitational field lines between bodies (subtle)
for i in range(0, len(bodies)) do
  for j in range(i + 1, len(bodies)) do
    let a = bodies[i]
    let b = bodies[j]
    let dx = a.x - b.x
    let dy = a.y - b.y
    let dist = sqrt(dx * dx + dy * dy)
    if dist < 200.0 then
      let alpha = int((1.0 - dist / 200.0) * 25.0 * (a.mass + b.mass) * 0.1)
      let al = min(40, max(5, alpha))
      draw_line(int(a.x), int(a.y), int(b.x), int(b.y), al, al, al + 10)
    end
  end
end

// Draw trails
for t in trails do
  let alpha = t.life * 0.4
  draw_circle(cx: int(t.x), cy: int(t.y), radius: 1,
    r: int(float(t.r) * alpha), g: int(float(t.g) * alpha), b: int(float(t.b) * alpha))
end

// Draw bodies
for b in bodies do
  let radius = int(b.mass * 1.5) + 2

  // Glow
  draw_circle(cx: int(b.x), cy: int(b.y), radius: radius + 6, r: b.r / 6, g: b.g / 6, b: b.b / 6)
  draw_circle(cx: int(b.x), cy: int(b.y), radius: radius + 3, r: b.r / 3, g: b.g / 3, b: b.b / 3)
  // Body
  draw_circle(cx: int(b.x), cy: int(b.y), radius: radius, r: b.r, g: b.g, b: b.b)
  // Core highlight
  draw_circle(cx: int(b.x) - radius / 3, cy: int(b.y) - radius / 3, radius: max(1, radius / 3),
    r: min(255, b.r + 80), g: min(255, b.g + 80), b: min(255, b.b + 80))
end

draw_text("Mutual Attraction (N-body)", x: 10, y: 10, size: 16, r: 100, g: 100, b: 120)
draw_text("Every body attracts every other", x: 10, y: 30, size: 12, r: 60, g: 60, b: 80)
draw_text("Bodies: " ++ str(len(bodies)), x: 10, y: 46, size: 10, r: 50, g: 50, b: 70)
