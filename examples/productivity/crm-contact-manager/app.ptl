// ── Meridian CRM ────────────────────────────────────────────────────────────
// A contact manager: a sortable / filterable / searchable table of contacts on
// the left, an inspector-and-edit-form on the right.
//
// Exercises: a real data table (five columns, click-to-sort headers with a
// direction toggle), segment filtering, incremental search, keyboard + mouse
// selection, wheel + scrollbar scrolling, and an editable multi-field form
// with its own focus ring that writes back into the record store.
//
// Designed for a 1280x850 panel.

// ── palette ─────────────────────────────────────────────────────────────────
let BG      = #14181e   // table / page ground
let RAIL    = #0f1319   // left rail, one step darker
let SURFACE = #181d25   // right inspector
let CARD    = #1c222b   // raised chips, fields, headers
let CARD_HI = #232a35
let LINE    = #262d38
let LINE_SOFT = #1f2530
let TEXT    = #e7ecf3
let DIM     = #93a0b2
let FAINT   = #626e7e
let ACCENT  = #6d8dff
let TEAL    = #2fc0a0
let AMBER   = #e3a83f
let ROSE    = #e8607c
let VIOLET  = #a884f5
let WHITE   = #ffffff

let AV = [#6d8dff, #2fc0a0, #e3a83f, #e8607c, #a884f5, #48b7e8]

// ── metrics ─────────────────────────────────────────────────────────────────
let W = screen_width()
let H = screen_height()

let RAIL_W   = 212
let DETAIL_W = 356
let TOP_H    = 60
let ROW_H    = 46
let FOOT_H   = 40

let FS_MICRO = 10
let FS_LABEL = 11
let FS_SM    = 12
let FS       = 13
let FS_ROW   = 14
let FS_H     = 17
let FS_XL    = 21

let TABLE_X = RAIL_W
let TABLE_W = W - RAIL_W - DETAIL_W
let DETAIL_X = W - DETAIL_W

let HEAD_Y   = TOP_H + 14
let HEAD_H   = 26
let ROWS_TOP = HEAD_Y + HEAD_H + 8
let ROWS_H   = H - FOOT_H - ROWS_TOP
let VISIBLE  = ROWS_H / ROW_H

let STAGES = ["Lead", "Qualified", "Proposal", "Customer", "Churned"]

