// Package `core` — Output, conversion to text, type names and assertions (core/src/builtins/io.rs).
//
// Native interface declarations: each `native fn` binds a name to the host
// native of the same name and gives the checker its parameter names, arity
// and types. Several declarations of one name are that native's call forms.
// See docs/ffi.md (Native interfaces).

pub native fn print(...values)
pub native fn str(value) -> string
pub native fn type(value) -> string
pub native fn assert(condition, message?)
pub native fn assert_eq(actual, expected)
