// =====================================================================
// LEVEL EDITOR  -  Petal + petal-sdl
// =====================================================================
// Run:
//     ./petal-sdl/target/debug/petal-sdl side-scroller/editor.ptl --width 960 --height 600
//
// CONTROLS
//   1..9         choose tool (1 plat, 2 oneway, 3 coin, 4 spike,
//                              5 goomba, 6 jumper, 7 check,
//                              8 start,  9 goal)
//   left-click   place / drag-resize for plat & oneway
//   right-click  delete object under cursor
//   arrows       pan camera   (hold shift = fast)
//   G            toggle grid snap
//   [ / ]        cycle level slot 1..3
//   S            save level to its slot file
//   L            (re)load level from disk
//   N            new empty level
//   T            test play - launches game (close window to come back)
//   ESC          quit
//
// The editor carries its own copy of the level format so it runs as a single
// self-contained script, exactly as game.ptl does.
// =====================================================================

let SCREEN_W = 960
let SCREEN_H = 600

state cam_x       = 0.0
state grid_snap   = true
state grid_size   = 20
state tool        = 1
state slot        = 0
state slot_files  = [
  "side-scroller/levels/01_first_steps.lvl",
  "side-scroller/levels/02_cavern.lvl",
  "side-scroller/levels/03_sky_ruins.lvl"
]
state slot_titles = ["First Steps", "Cavern Dive", "Sky Ruins"]
// `level` and the HUD banner are written from inside functions (`delete_at`,
// `say`), so they need a cell: a plain `=` in a function builds a local shadow
// rather than writing the state.
state var level   = nil
state loaded_slot = -1
state var msg     = ""
state var msg_t   = 0.0
state drag_start  = nil          // {x,y} when dragging to size a plat/oneway
state hover_world = {x: 0, y: 0}

// ----------------------------- HELPERS --------------------------------

fn clamp(v: num, lo: num, hi: num) -> num
  max(lo, min(v, hi))
end

fn snap(n: num) -> num
  if grid_snap then
    (n / grid_size) * grid_size
  else
    n
  end
end

fn say(s: string)
  set msg = s; set msg_t = 2.0
end

// ----------------------------- LEVEL FORMAT ---------------------------
// The same .lvl grammar game.ptl parses, plus the serializer that writes it
// back out.

fn empty_level() -> record
  {
    name: "Untitled",
    width: 2400,
    bg_r: 110, bg_g: 180, bg_b: 240,
    start: {x: 100.0, y: 400.0},
    goal:  {x: 2200.0, y: 400.0},
    plats: [],
    oneways: [],
    coins: [],
    spikes: [],
    enemies: [],
    checks: []
  }
end

fn parse_level(src: string) -> record
  let L = empty_level()
  let lines = split(src, "\n")
  for raw in lines do
    let toks = split(raw, " ")
    if len(toks) == 0 then continue end
    let tag = toks[0]
    if tag == "" then continue end
    if tag == "name" then
      L.name = join(slice(toks, start: 1, end: len(toks)), " ")
    elsif tag == "width" then
      L.width = int(toks[1])
    elsif tag == "bg" then
      L.bg_r = int(toks[1]); L.bg_g = int(toks[2]); L.bg_b = int(toks[3])
    elsif tag == "start" then
      L.start = {x: float(toks[1]), y: float(toks[2])}
    elsif tag == "goal" then
      L.goal = {x: float(toks[1]), y: float(toks[2])}
    elsif tag == "plat" then
      L.plats = append(L.plats, {
        x: int(toks[1]), y: int(toks[2]),
        w: int(toks[3]), h: int(toks[4])
      })
    elsif tag == "oneway" then
      L.oneways = append(L.oneways, {x: int(toks[1]), y: int(toks[2]), w: int(toks[3])})
    elsif tag == "coin" then
      L.coins = append(L.coins, {x: int(toks[1]), y: int(toks[2]), collected: false})
    elsif tag == "spike" then
      L.spikes = append(L.spikes, {x: int(toks[1]), y: int(toks[2])})
    elsif tag == "goomba" then
      L.enemies = append(L.enemies, {
        kind: "goomba",
        x: float(toks[1]), y: float(toks[2]),
        origin_y: float(toks[2]),
        patrol: float(toks[3])
      })
    elsif tag == "jumper" then
      L.enemies = append(L.enemies, {
        kind: "jumper",
        x: float(toks[1]), y: float(toks[2]),
        origin_y: float(toks[2]),
        patrol: 0.0
      })
    elsif tag == "check" then
      L.checks = append(L.checks, {x: int(toks[1]), y: int(toks[2])})
    end
  end
  L
end

fn serialize_level(L: record) -> string
  let lines = []
  lines = append(lines, "name {L.name}")
  lines = append(lines, "width {L.width}")
  lines = append(lines, "bg {L.bg_r} {L.bg_g} {L.bg_b}")
  lines = append(lines, "start {L.start.x} {L.start.y}")
  lines = append(lines, "goal {L.goal.x} {L.goal.y}")
  for p in L.plats do
    lines = append(lines, "plat {p.x} {p.y} {p.w} {p.h}")
  end
  for o in L.oneways do
    lines = append(lines, "oneway {o.x} {o.y} {o.w}")
  end
  for c in L.coins do
    lines = append(lines, "coin {c.x} {c.y}")
  end
  for s in L.spikes do
    lines = append(lines, "spike {s.x} {s.y}")
  end
  for e in L.enemies do
    if e.kind == "goomba" then
      lines = append(lines, "goomba {int(e.x)} {int(e.origin_y)} {int(e.patrol)}")
    else
      lines = append(lines, "jumper {int(e.x)} {int(e.origin_y)} 0")
    end
  end
  for ck in L.checks do
    lines = append(lines, "check {ck.x} {ck.y}")
  end
  join(lines, "\n")
end

// ----------------------------- LOAD / SAVE ----------------------------

fn load_slot(idx) -> record
  let path = slot_files[idx]
  let src  = load_text_file(path)
  if len(src) == 0 then
    let L = empty_level()
    L.name = slot_titles[idx]
    say("New empty level (file not found)")
    L
  else
    say("Loaded {path}")
    parse_level(src)
  end
end

fn save_slot(idx)
  let path = slot_files[idx]
  let txt  = serialize_level(get level)
  let ok   = save_text_file(path, txt)
  if ok then say("Saved {path}") else say("Save failed!") end
end

// loaded_slot starts at -1, so this also covers the first frame's load.
if loaded_slot != slot then set level = load_slot(slot); loaded_slot = slot end

// ----------------------------- INPUT ----------------------------------

let dts = dt()
set msg_t = max(0.0, msg_t - dts)

// pan
let pan_speed = if key_down("lshift") || key_down("rshift") || key_down("shift") then 900.0 else 350.0 end
if key_down("left")  then cam_x = cam_x - pan_speed * dts end
if key_down("right") then cam_x = cam_x + pan_speed * dts end
cam_x = clamp(cam_x, lo: 0.0, hi: float(level.width) - float(SCREEN_W))

// tools
if key_pressed("1") then tool = 1 end
if key_pressed("2") then tool = 2 end
if key_pressed("3") then tool = 3 end
if key_pressed("4") then tool = 4 end
if key_pressed("5") then tool = 5 end
if key_pressed("6") then tool = 6 end
if key_pressed("7") then tool = 7 end
if key_pressed("8") then tool = 8 end
if key_pressed("9") then tool = 9 end
if key_pressed("g") then grid_snap = !grid_snap; say(if grid_snap then "Grid ON" else "Grid OFF" end) end

// slot switching
if key_pressed("[") then slot = (slot + len(slot_files) - 1) % len(slot_files) end
if key_pressed("]") then slot = (slot + 1) % len(slot_files) end

if key_pressed("s") then save_slot(slot) end
if key_pressed("l") then set level = load_slot(slot); loaded_slot = slot end
if key_pressed("n") then
  let L = empty_level()
  L.name = slot_titles[slot]
  set level = L
  say("Cleared")
end

// mouse position in world coords
let mwx = mouse_x() + int(cam_x)
let mwy = mouse_y()
hover_world = {x: snap(mwx), y: snap(mwy)}

// ----------------------------- TOOL ACTIONS ---------------------------

fn delete_at(wx: num, wy: num) -> bool
  // Delete the topmost item at (wx, wy): each list is scanned back to front,
  // so the most recently placed object wins.
  let i = len(get level.plats) - 1
  while i >= 0 do
    let p = get level.plats[i]
    if wx >= p.x && wx <= p.x + p.w && wy >= p.y && wy <= p.y + p.h then
      set level.plats = filter_index(get level.plats, i)
      return true
    end
    i = i - 1
  end
  let j = len(get level.oneways) - 1
  while j >= 0 do
    let o = get level.oneways[j]
    if wx >= o.x && wx <= o.x + o.w && wy >= o.y - 4 && wy <= o.y + 10 then
      set level.oneways = filter_index(get level.oneways, j)
      return true
    end
    j = j - 1
  end
  let k = len(get level.coins) - 1
  while k >= 0 do
    let c = get level.coins[k]
    if abs(wx - c.x) < 14 && abs(wy - c.y) < 14 then
      set level.coins = filter_index(get level.coins, k)
      return true
    end
    k = k - 1
  end
  let m = len(get level.spikes) - 1
  while m >= 0 do
    let s = get level.spikes[m]
    if wx >= s.x && wx <= s.x + 24 && wy >= s.y && wy <= s.y + 16 then
      set level.spikes = filter_index(get level.spikes, m)
      return true
    end
    m = m - 1
  end
  let n = len(get level.enemies) - 1
  while n >= 0 do
    let e = get level.enemies[n]
    if abs(wx - int(e.x) - 12) < 16 && abs(wy - int(e.origin_y) - 11) < 16 then
      set level.enemies = filter_index(get level.enemies, n)
      return true
    end
    n = n - 1
  end
  let cc = len(get level.checks) - 1
  while cc >= 0 do
    let ck = get level.checks[cc]
    if abs(wx - ck.x - 12) < 14 && wy > ck.y - 36 && wy < ck.y then
      set level.checks = filter_index(get level.checks, cc)
      return true
    end
    cc = cc - 1
  end
  false
end

fn filter_index(list: list, idx: num) -> list
  let out = []
  let i = 0
  while i < len(list) do
    if i != idx then out = append(out, list[i]) end
    i = i + 1
  end
  out
end

// place
if mouse_pressed(1) then
  let wx = hover_world.x
  let wy = hover_world.y
  if tool == 1 then
    drag_start = {x: wx, y: wy}
  elsif tool == 2 then
    drag_start = {x: wx, y: wy}
  elsif tool == 3 then
    set level.coins = append(level.coins, {x: wx, y: wy, collected: false})
  elsif tool == 4 then
    set level.spikes = append(level.spikes, {x: wx, y: wy})
  elsif tool == 5 then
    set level.enemies = append(level.enemies, {
      kind: "goomba", x: float(wx), y: float(wy) - 22.0,
      origin_y: float(wy) - 22.0, patrol: 100.0
    })
  elsif tool == 6 then
    set level.enemies = append(level.enemies, {
      kind: "jumper", x: float(wx), y: float(wy) - 24.0,
      origin_y: float(wy) - 24.0, patrol: 0.0
    })
  elsif tool == 7 then
    set level.checks = append(level.checks, {x: wx, y: wy})
  elsif tool == 8 then
    set level.start = {x: float(wx), y: float(wy)}
  elsif tool == 9 then
    set level.goal = {x: float(wx), y: float(wy)}
  end
end

// release: finalise plat/oneway drag
if mouse_down(1) == false && drag_start != nil then
  let wx = hover_world.x
  let wy = hover_world.y
  let x0 = min(drag_start.x, wx)
  let y0 = min(drag_start.y, wy)
  let x1 = max(drag_start.x, wx)
  let y1 = max(drag_start.y, wy)
  let w  = max(grid_size, x1 - x0)
  let h  = max(grid_size, y1 - y0)
  if tool == 1 then
    set level.plats = append(level.plats, {x: x0, y: y0, w: w, h: max(grid_size, h)})
  elsif tool == 2 then
    set level.oneways = append(level.oneways, {x: x0, y: y0, w: w})
  end
  drag_start = nil
end

if mouse_pressed(3) then delete_at(mwx, mwy) end

// ----------------------------- DRAW -----------------------------------

fn world_x(wx: num) -> num
  wx - int(cam_x)
end

clear(level.bg_r, level.bg_g, level.bg_b)

// grid
if grid_snap then
  let gx = -int(cam_x) % grid_size
  let i = 0
  while i < SCREEN_W / grid_size + 2 do
    let x = gx + i * grid_size
    draw_line(x, 36, x, SCREEN_H, 50, 50, 70)
    i = i + 1
  end
  let j = 0
  while j < SCREEN_H / grid_size do
    let y = j * grid_size
    draw_line(0, y, SCREEN_W, y, 50, 50, 70)
    j = j + 1
  end
end

// level boundary
let bx_end = world_x(level.width)
draw_line(bx_end, 0, bx_end, SCREEN_H, 200, 80, 80)

// platforms
for p in level.plats do
  draw_rect(x: world_x(p.x), y: p.y, w: p.w, h: p.h, r: 110, g: 70, b: 40)
  draw_rect(x: world_x(p.x), y: p.y, w: p.w, h: 5, r: 60, g: 170, b: 55)
end
for o in level.oneways do
  draw_rect(x: world_x(o.x), y: o.y, w: o.w, h: 6, r: 200, g: 160, b: 90)
end
for c in level.coins do
  draw_circle(cx: world_x(c.x), cy: c.y, radius: 8, r: 255, g: 210, b: 40)
  draw_circle(cx: world_x(c.x) - 2, cy: c.y - 2, radius: 4, r: 255, g: 240, b: 130)
end
for s in level.spikes do
  draw_line(world_x(s.x) + 2, s.y + 16, world_x(s.x) + 8, s.y, 220, 220, 230)
  draw_line(world_x(s.x) + 8, s.y, world_x(s.x) + 14, s.y + 16, 220, 220, 230)
  draw_line(world_x(s.x) + 12, s.y + 16, world_x(s.x) + 18, s.y + 4, 200, 200, 210)
  draw_line(world_x(s.x) + 18, s.y + 4, world_x(s.x) + 22, s.y + 16, 200, 200, 210)
end
for e in level.enemies do
  let ex = world_x(int(e.x))
  let ey = int(e.origin_y)
  if e.kind == "goomba" then
    draw_rect(x: ex, y: ey, w: 24, h: 22, r: 120, g: 70, b: 30)
    draw_rect(x: ex + 6, y: ey + 6, w: 4, h: 5, r: 255, g: 255, b: 255)
    draw_rect(x: ex + 14, y: ey + 6, w: 4, h: 5, r: 255, g: 255, b: 255)
  else
    draw_rect(x: ex, y: ey, w: 24, h: 24, r: 60, g: 170, b: 80)
    draw_rect(x: ex + 6, y: ey + 6, w: 4, h: 5, r: 255, g: 255, b: 255)
    draw_rect(x: ex + 14, y: ey + 6, w: 4, h: 5, r: 255, g: 255, b: 255)
  end
end
for ck in level.checks do
  draw_rect(x: world_x(ck.x) + 6, y: ck.y - 32, w: 3, h: 32, r: 200, g: 200, b: 220)
  draw_rect(x: world_x(ck.x) + 9, y: ck.y - 30, w: 14, h: 9, r: 240, g: 80, b: 90)
end

// start
draw_rect(x: world_x(int(level.start.x)) - 4, y: int(level.start.y) - 4, w: 28, h: 36, r: 100, g: 200, b: 100)
draw_text("S", x: world_x(int(level.start.x)) + 4, y: int(level.start.y) + 4, size: 20, r: 20, g: 60, b: 20)

// goal
draw_rect(x: world_x(int(level.goal.x)) + 8, y: int(level.goal.y) - 80, w: 4, h: 80, r: 230, g: 230, b: 230)
draw_rect(x: world_x(int(level.goal.x)) + 12, y: int(level.goal.y) - 76, w: 24, h: 16, r: 230, g: 60, b: 60)
draw_text("G", x: world_x(int(level.goal.x)) + 18, y: int(level.goal.y) - 76, size: 16, r: 255, g: 255, b: 255)

// drag preview
if drag_start != nil then
  let wx = hover_world.x
  let wy = hover_world.y
  let x0 = min(drag_start.x, wx)
  let y0 = min(drag_start.y, wy)
  let w  = max(grid_size, abs(wx - drag_start.x))
  let h  = max(grid_size, abs(wy - drag_start.y))
  if tool == 1 then
    draw_rect_outline(world_x(x0), y0, w, h, 220, 220, 100)
  elsif tool == 2 then
    draw_rect_outline(world_x(x0), y0, w, 6, 200, 160, 90)
  end
end

// cursor crosshair (in screen coords)
let mx = mouse_x()
let my = mouse_y()
draw_line(mx - 8, my, mx + 8, my, 220, 220, 240)
draw_line(mx, my - 8, mx, my + 8, 220, 220, 240)

// ----------------------------- HUD ------------------------------------

draw_rect(x: 0, y: 0, w: SCREEN_W, h: 36, r: 0, g: 0, b: 0)
draw_rect(x: 0, y: 0, w: SCREEN_W, h: 34, r: 25, g: 30, b: 50)
draw_text("EDITOR  -  slot {slot + 1}/3  -  {level.name}", x: 8, y: 8, size: 18, r: 230, g: 230, b: 250)

let tools_row = [
  {n: 1, label: "plat"},
  {n: 2, label: "oneway"},
  {n: 3, label: "coin"},
  {n: 4, label: "spike"},
  {n: 5, label: "goomba"},
  {n: 6, label: "jumper"},
  {n: 7, label: "check"},
  {n: 8, label: "start"},
  {n: 9, label: "goal"}
]
let tx = 8
for t in tools_row do
  let sel = t.n == tool
  let bg_r = if sel then 230 else 50 end
  let bg_g = if sel then 200 else 60 end
  let bg_b = if sel then 80  else 80 end
  draw_rect(x: tx, y: SCREEN_H - 30, w: 96, h: 26, r: bg_r, g: bg_g, b: bg_b)
  draw_text("{t.n} {t.label}", x: tx + 6, y: SCREEN_H - 26, size: 16,
    r: if sel then 30 else 230 end,
    g: if sel then 30 else 230 end,
    b: if sel then 30 else 250 end)
  tx = tx + 100
end

// status
let stats = "plats {len(level.plats)}  ow {len(level.oneways)}  coins {len(level.coins)}  spikes {len(level.spikes)}  enemies {len(level.enemies)}  checks {len(level.checks)}"
draw_rect(x: 0, y: SCREEN_H - 56, w: SCREEN_W, h: 22, r: 0, g: 0, b: 0)
draw_text(stats, x: 8, y: SCREEN_H - 52, size: 16, r: 200, g: 200, b: 230)

// hover read
draw_text("@ {hover_world.x},{hover_world.y}", x: SCREEN_W - 200, y: 8, size: 16, r: 200, g: 200, b: 230)

if msg_t > 0.0 then
  draw_rect(x: SCREEN_W / 2 - 200, y: 44, w: 400, h: 26, r: 0, g: 0, b: 0)
  draw_text(msg, x: SCREEN_W / 2 - 190, y: 48, size: 18, r: 255, g: 230, b: 120)
end
