fn has_doc(name: string) -> bool
  for d in DOCS do
    if d[0] == name then
      return true
    end
  end
  false
end

// ── Building the tree ───────────────────────────────────────────────────────

fn parse_size(s: string) -> int
  let unit = slice(s, -1)
  let n = parse_float(slice(s, 0, len(s) - 1)) ?? 0.0
  let mul = if unit == "G" then 1000000000 elsif unit == "M" then 1000000 else 1000 end
  // A size that is not a round number of kilobytes reads as a real file's.
  int(n * mul) + (len(s) * 137) % 911
end

// A camera roll long enough to scroll: forty shots over a fortnight, mostly
// photos, the odd HEIC and clip.
fn camera_roll() -> list
  for i in range(0, 40) do
    let n = 4780 + i
    let ext = if i % 9 == 4 then "mov" elsif i % 5 == 2 then "heic" else "jpg" end
    let size = if ext == "mov" then "{38 + (i * 17) % 90}.{i % 10}M" else "{2 + (i * 7) % 5}.{(i * 3) % 10}M" end
    let hm = 700 + ((i * 37) % 13) * 100 + (i * 23) % 60
    "Pictures/Camera Roll/IMG_{n}.{ext}|{size}|{17 - i / 3}|{pad_start(str(hm), 4, "0")}"
  end
end

pub fn seed() -> list
  let out = [
    {id: 0, name: "Home", parent: -1, dir: true, size: 0, mt: NOW, from: -1, doc: ""},
    {id: 1, name: "Trash", parent: -1, dir: true, size: 0, mt: NOW, from: -1, doc: ""},
  ]
  let by_path = {Trash: 1}
  for line in camera_roll() ++ SEED do
    let f = split(line, "|")
    let parts = split(f[0], "/")
    let hm = parse_int(f[3]) ?? 0
    let mt = (TODAY - (parse_int(f[2]) ?? 0)) * 1440 + (hm / 100) * 60 + hm % 100
    let parent = 0
    let path = ""
    for i in range(0, len(parts) - 1) do
      path = if path == "" then parts[i] else path ++ "/" ++ parts[i] end
      let known = field(by_path, path, -1)
      if known < 0 then
        known = len(out)
        out = append(out, {id: known, name: parts[i], parent: parent, dir: true, size: 0, mt: 0, from: -1, doc: ""})
        by_path[path] = known
      end
      parent = known
      // A folder was last touched when the newest thing in it was.
      if out[parent].mt < mt && parent > 1 then
        out[parent].mt = mt
      end
    end
    let name = last(parts)
    let from = if len(f) > 4 then field(by_path, f[4], 0) else -1 end
    out = append(out, {id: len(out), name: name, parent: parent, dir: false, size: parse_size(f[1]),
      mt: mt, from: from, doc: if has_doc(name) then name else "" end})
  end
  out
end

// The id of the node at a path under Home ("Documents/Taxes"), or -1.
pub fn find(nodes: list, path: string) -> int
  let at = 0
  for part in split(path, "/") do
    let next = -1
    for n in nodes do
      if n.parent == at && n.name == part then
        next = n.id
        break
      end
    end
    if next < 0 then
      return -1
    end
    at = next
  end
  at
end

// ── Names and kinds ─────────────────────────────────────────────────────────

// "report.final.pdf" → {stem: "report.final", ext: "pdf"}. A leading dot is
// part of the name, not an extension.
pub fn split_name(name: string) -> record
  let cs = chars(name)
  let dot = -1
  for i in range(1, len(cs)) do
    if cs[i] == "." then
      dot = i
    end
  end
  if dot < 0 || dot == len(cs) - 1 then
    {stem: name, ext: ""}
  else
    {stem: slice(name, 0, dot), ext: slice(name, dot + 1)}
  end
end

let KIND_BY_EXT = {
  png: ["image", "PNG image"], jpg: ["image", "JPEG image"], jpeg: ["image", "JPEG image"],
  heic: ["image", "HEIC image"], svg: ["image", "SVG image"],
  txt: ["text", "Plain text"], md: ["text", "Markdown"],
  pdf: ["pdf", "PDF document"],
  docx: ["doc", "Word document"],
  xlsx: ["sheet", "Spreadsheet"], csv: ["sheet", "CSV table"],
  mp3: ["audio", "MP3 audio"], wav: ["audio", "WAV audio"], flac: ["audio", "FLAC audio"], m4a: ["audio", "AAC audio"],
  mov: ["video", "QuickTime movie"], mp4: ["video", "MPEG-4 movie"],
  zip: ["archive", "ZIP archive"],
  dmg: ["disk", "Disk image"],
  ptl: ["code", "Petal source"], py: ["code", "Python source"], rs: ["code", "Rust source"],
  sh: ["code", "Shell script"], json: ["code", "JSON"], toml: ["code", "TOML"],
}

// {key, label}: `key` picks the icon and the preview, `label` is the Kind
// column.
pub fn kind_of(n: record) -> record
  if n.dir then
    return {key: "folder", label: "Folder"}
  end
  let k = field(KIND_BY_EXT, lower(split_name(n.name).ext), nil)
  if k == nil then
    {key: "file", label: "Document"}
  else
    {key: k[0], label: k[1]}
  end
end

// ── Formatting ──────────────────────────────────────────────────────────────

pub fn fmt_size(bytes: num) -> string
  if bytes < 1000 then
    "{int(bytes)} bytes"
  elsif bytes < 1000000 then
    "{int(round(bytes / 1000.0))} KB"
  elsif bytes < 1000000000 then
    let mb = bytes / 1000000.0
    if mb < 100.0 then "{round(mb, 1)} MB" else "{int(round(mb))} MB" end
  else
    "{round(bytes / 1000000000.0, 2)} GB"
  end
end

let MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
let MONTH_DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

// Day number (0 = 1 Jan 2024) to {y, m, d}.
fn civil(day: int) -> record
  let y = 2024
  let d = day
  while d >= (if y % 4 == 0 then 366 else 365 end) do
    d = d - (if y % 4 == 0 then 366 else 365 end)
    y += 1
  end
  let m = 0
  while true do
    let dm = if m == 1 && y % 4 == 0 then 29 else MONTH_DAYS[m] end
    if d < dm then
      break
    end
    d -= dm
    m += 1
  end
  {y: y, m: m, d: d + 1}
end

fn clock(minute: int) -> string
  let h = minute / 60
  let h12 = if h % 12 == 0 then 12 else h % 12 end
  "{h12}:{pad_start(str(minute % 60), 2, "0")} {if h < 12 then "AM" else "PM" end}"
end

// The list column: "Today, 2:02 PM", "Yesterday, 9:41 AM", "Oct 3, 2026".
// `long` adds the time to an older date, for the info pane.
pub fn fmt_date(mt: int, long: bool = false) -> string
  let day = mt / 1440
  let at = clock(mt % 1440)
  if day == TODAY then
    "Today, {at}"
  elsif day == TODAY - 1 then
    "Yesterday, {at}"
  else
    let c = civil(day)
    let date = "{MONTHS[c.m]} {c.d}, {c.y}"
    if long then "{date} at {at}" else date end
  end
end

// A small stable number from a name, for the procedural previews.
let HASH_CHARS = "abcdefghijklmnopqrstuvwxyz0123456789-_. "
pub fn hash(s: string) -> int
  let h = 7
  for c in chars(lower(s)) do
    h = (h * 31 + index_of(HASH_CHARS, c) + 2) % 1000003
  end
  h
end

// The text behind a node, or "" when it has none.
pub fn doc_text(n: record) -> string
  for d in DOCS do
    if d[0] == n.doc then
      return trim(d[1])
    end
  end
  ""
end
