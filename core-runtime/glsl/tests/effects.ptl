// Post effects written as Petal lambdas instead of GLSL strings.
//
// Each one is the Petal counterpart of an effect in
// engine/script/prelude/postfx.ptl (or tests/data/post_effects.ptl for
// duotone); `streak` is new and exercises control flow, a helper function and
// int/float mixing. petal2glsl.py turns them back into GLSL.
//
// Convention used by the experiment:
//   - the first parameter is the pixel (`fx: Fx`);
//   - every other parameter is an effect param, its default the param's default;
//   - the value of the body is the new fx.color;
//   - a captured top-level constant is inlined;
//   - src, fx_luma, hash33, ... are the shader environment (not Petal builtins).
//
// This file compiles and runs (nothing here calls the lambdas).

class Fx
  color: vec3,
  uv: vec2,
  time: float,
  resolution: vec2,
  aspect: float,
end

let TAU = 6.283185307179586

let film_grain = fn(fx: Fx, amount = 0.35, size = 1.5, color = 0.25, speed = 24.0)
  let cell = floor(fx.uv * fx.resolution / max(size, 1.0))
  let n = hash33(vec3(cell.x, cell.y, floor(fx.time * speed))) - 0.5
  let weight = clamp(1.0 - abs(fx_luma(fx.color) - 0.45) * 1.2, 0.25, 1.0)
  fx.color + lerp(vec3(n.x, n.x, n.x), n, color) * amount * 0.22 * weight
end

let scanlines = fn(fx: Fx, amount = 0.3, lines = 360.0, roll = 0.15)
  // Never finer than two pixels per line (it would alias into bands).
  let line = 0.5 + 0.5 * cos(fx.uv.y * min(lines, fx.resolution.y * 0.5) * TAU)
  // Bright pixels bleed over the gap between lines, as on a tube.
  let c = fx.color * (1 - amount * (1 - line) * (1 - 0.6 * fx_luma(fx.color)))
  let band = fract(fx.uv.y * 0.6 + fx.time * 0.08)
  c * (1 - roll * 0.3 * smoothstep(0.85, 1.0, 1 - abs(band * 2 - 1)))
end

let chromatic_aberration = fn(fx: Fx, amount = 0.4)
  let d = fx.uv - 0.5
  let offset = d * dot(d, d) * amount * 0.03
  vec3(src(fx.uv + offset).x, fx.color.y, src(fx.uv - offset).z)
end

let glitch = fn(fx: Fx, amount = 0.35, speed = 6.0, blocks = 18.0)
  let t = floor(fx.time * speed)
  let row = floor(fx.uv.y * blocks)
  let on = step(1.0 - amount * 0.35, hash12(vec2(row, t)))
  let shift = (hash12(vec2(row + 7.0, t)) - 0.5) * 0.12 * amount * on
  let uv = vec2(clamp(fx.uv.x + shift, 0.0, 1.0), fx.uv.y)
  let c = src(uv)
  vec3(lerp(c.x, src(uv + vec2(0.006 * amount, 0.0)).x, on), c.y, c.z)
end

let sharpen = fn(fx: Fx, amount = 0.5)
  let px = 1.0 / fx.resolution
  let around = (src(fx.uv + vec2(px.x, 0.0)) + src(fx.uv - vec2(px.x, 0.0)) +
                src(fx.uv + vec2(0.0, px.y)) + src(fx.uv - vec2(0.0, px.y))) * 0.25
  fx.color + (fx.color - around) * amount * 2.0
end

let color_grade = fn(fx: Fx, amount = 0.35, shadows = #1a2a6c, highlights = #ffb45a, balance = 0.5, fade = 0.0)
  let l = fx_luma(fx.color)
  let tint = linear_to_srgb(lerp(shadows, highlights, smoothstep(balance - 0.35, balance + 0.35, l)))
  let c = fx.color + (tint - fx_luma(tint)) * amount * 0.6
  // Faded film: lifted blacks, slightly lower whites.
  c * (1.0 - fade * 0.15) + fade * 0.08
end

let duotone = fn(fx: Fx, dark = #1b1040, light = #ffd9a0, amount = 0.6)
  let two = lerp(linear_to_srgb(dark), linear_to_srgb(light), fx_luma(fx.color))
  lerp(fx.color, two, amount)
end

let paper = fn(fx: Fx, amount = 0.3, scale = 2.0, fibers = 0.5)
  let p = fx.uv * fx.resolution / max(scale, 0.25)
  let tooth = fbm(p * 0.35, 4) - 0.5
  let fiber = noise(vec2(p.x * 0.08, p.y * 1.3)) * noise(vec2(p.x * 1.1, p.y * 0.06)) - 0.25
  fx.color * (1.0 + (tooth * 0.8 + fiber * fibers) * amount)
end

let pixelate = fn(fx: Fx, size = 4.0)
  let px = max(size, 1.0) / fx.resolution
  src((floor(fx.uv / px) + 0.5) * px)
end

let outline = fn(fx: Fx, amount = 0.8, width = 1.5, threshold = 0.04, color = #05030a)
  let px = width / fx.resolution
  let d = scene_depth(fx.uv)
  let dx = abs(scene_depth(fx.uv + vec2(px.x, 0.0)) - scene_depth(fx.uv - vec2(px.x, 0.0)))
  let dy = abs(scene_depth(fx.uv + vec2(0.0, px.y)) - scene_depth(fx.uv - vec2(0.0, px.y)))
  let edge = smoothstep(threshold, threshold * 2.5, (dx + dy) / max(d, 0.1)) * (1.0 - smoothstep(150.0, 400.0, d))
  lerp(fx.color, linear_to_srgb(color), edge * amount)
end

// Not in the library: a horizontal streak of the bright pixels. Here for the
// constructs the others do not use: var/set, for, if (statement and
// expression), return, an int capture, int/float mixing, a helper function.
fn streak_weight(i: int, n: int) -> float
  1.0 - abs(i) / (n + 1.0)
end

let STREAK_TAPS = 3

let streak = fn(fx: Fx, amount = 0.6, reach = 0.02, threshold = 0.6)
  var acc = vec3(0.0, 0.0, 0.0)
  var total = 0.0
  for i in range(-STREAK_TAPS, STREAK_TAPS + 1) do
    let s = src(fx.uv + vec2(i * reach / STREAK_TAPS, 0.0))
    let w = if fx_luma(s) > threshold then streak_weight(i, STREAK_TAPS) else 0.0 end
    set acc = acc + s * w
    set total += w
  end
  if total <= 0.0 then
    return fx.color
  end
  fx.color + acc / total * amount
end
