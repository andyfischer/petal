    // Deep space
    P(DEEP, USA, 2, 1962, 12, 14, "Mariner 2", "Passes Venus and returns the first data from another planet: the surface is hot enough to melt lead."),
    P(DEEP, USA, 2, 1965, 7, 15, "Mariner 4", "Twenty-two grainy frames show a cratered Mars and end the dream of canals."),
    P(DEEP, SOV, 2, 1970, 12, 15, "Venera 7", "Survives 23 minutes on Venus, the first transmission from the surface of another planet."),
    P(DEEP, USA, 3, 1971, 11, 14, "Mariner 9", "The first spacecraft to orbit another planet waits out a dust storm, then maps all of Mars."),
