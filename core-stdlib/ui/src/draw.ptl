# The point-list primitives take their points as a list already, so the
# record form only swaps the packed r, g, b for a colour.
@doc("A filled convex polygon.", params: {points: """The corners, `{x, y}` records in order."""}, see: ["fill_polygon", "draw_polygon_outline"])
pub fn fill_poly(points, r, g, b, a = 255)
  _native_poly(points, r, g, b, a)
pub fn fill_poly(points, c, a = 255)
  _native_poly(points, c.r, c.g, c.b, a)

@doc("A filled simple polygon, concave included.", params: {points: """The corners, `{x, y}` records in order."""}, see: ["fill_poly"])
pub fn fill_polygon(points, r, g, b, a = 255)
  _native_polygon(points, r, g, b, a)
pub fn fill_polygon(points, c, a = 255)
  _native_polygon(points, c.r, c.g, c.b, a)

@doc("A triangle fan from a centre to each consecutive pair of `points`.", params: {center: """The hub, `{x, y}`."""})
pub fn fill_fan(cx, cy, points, r, g, b, a = 255)
  _native_fan(cx, cy, points, r, g, b, a)
pub fn fill_fan(center, points, c)
  _native_fan(center.x, center.y, points, c.r, c.g, c.b)
# Also positionally the mixed `(cx, cy, points, c)`.
pub fn fill_fan(center, points, c, a)
  if _is_num(center) then
    _native_fan(center, points, c, a.r, a.g, a.b)
  else
    _native_fan(center.x, center.y, points, c.r, c.g, c.b, a)
pub fn fill_fan(cx, cy, points, c, a = 255)
  _native_fan(cx, cy, points, c.r, c.g, c.b, a)

# `(points, c, a, width)` has the same count as the flat `(points, r, g, b)`.
# The native tells them apart itself (a colour record second means alpha and
# width follow), and takes the colour as it is — a `{r, g, b}` record, or with
# two or three arguments a packed RGB int (`r * 65536 + g * 256 + b`) — so no declaration here tests
# a type or unpacks a record: each only forwards. They stay Petal functions
# for the named calls that skip `a` to reach `width`.

@doc("""
One open stroked path through `points`. Translucent joins do not darken.
The colour may be a record or a packed int.
""",
  params: {points: """`{x, y}` records in order.""", width: "Stroke width in px (1)."},
  see: ["draw_polygon_outline", "draw_line"])
pub fn draw_polyline(points, r, g, b, a = 255, width = 1)
  _native_polyline(points, r, g, b, a, width)
pub fn draw_polyline(points, c)
  _native_polyline(points, c)
pub fn draw_polyline(points, c, a)
  _native_polyline(points, c, a)
# Also positionally the flat `(points, r, g, b)`.
pub fn draw_polyline(points, c, a = 255, width = 1)
  _native_polyline(points, c, a, width)

# A closed outline: `draw_polyline` with the first point repeated at the end,
# so a ship, a hex or a rotated box needs no `append(pts, pts[0])` at every
# call. Takes exactly `draw_polyline`'s argument shapes.
fn _closed(points)
  if len(points) > 1 then append(points, points[0]) else points end
@doc("""
A closed stroked path: `draw_polyline` with the first point repeated at the
end, so a ship, a hex or a rotated box needs no `append(pts, pts[0])`. Takes
exactly `draw_polyline`'s argument shapes.
""", params: {width: "Stroke width in px (1)."}, see: ["draw_polyline"])
pub fn draw_polygon_outline(points, r, g, b, a = 255, width = 1)
  draw_polyline(_closed(points), r, g, b, a, width)
pub fn draw_polygon_outline(points, c)
  draw_polyline(_closed(points), c)
pub fn draw_polygon_outline(points, c, a)
  draw_polyline(_closed(points), c, a)
# Also positionally the flat `(points, r, g, b)`.
pub fn draw_polygon_outline(points, c, a = 255, width = 1)
  draw_polyline(_closed(points), c, a, width)

@doc("""
Draw a run of text. `y` (or `pos.y`) is the top of the line. With a style
record, omitted fields mean plain text (the host's own face, upright,
regular), so a style is a diff against the plain call. Measure with the same
record (`text_width(s, style)`) and the two agree.

A **text style** is a record; every field is optional.

| Field | Meaning |
|---|---|
| `size` | Pixel size. |
| `color` | A colour record; its `a` is the run's alpha. |
| `font` | A face: an installed family name (`"Georgia"`, any case), a host role (`"ui"`, `"mono"`), or a fallback list (`"Georgia, ui"`). A family the host can't find draws, and measures, in the default face. |
| `weight` | 400 regular, 600 semibold, 700 bold. |
| `italic` | `true` for italic. |
| `spacing` or `tracking` | Extra pixels between letters. Measured as well as drawn. |
| `shadow` | `true`, or `{dx, dy, color, a}`: one copy under the text, offset (1, 1) and black at alpha 160 by default. |
| `outline` | `true`, a colour, or `{color, width, a}`: a ring around the glyphs, 1 px and black by default. |

`shadow` and `outline` fade with the text's own alpha. See docs/usage/text-and-fonts.md
for which hosts look font families up.
""",
  params: {
    pos: """Where the run starts: `{x, y}`, `y` the top of the line.""",
    style: "A text style record (above).",
    size: "A pixel size, in the host's default face.",
    c: "The colour, with `size`.",
  },
  example: """
    let title = {size: 22, color: :ffffff, tracking: 2, outline: :000000}
    draw_text("ROUND 3", 40, 20, title)
    draw_text("#482", {x: 60, y: 20}, {size: 15, color: :d8dee9, weight: 700})
  """,
  see: ["text_width", "font", "ui.draw_text_center", "ui.draw_text_right"])
pub fn draw_text(text, x, y, size, r, g, b, a = 255)
  _native_text(text, x, y, size, r, g, b, a)
pub fn draw_text(text, x, y, size, c, a = 255)
  _native_text(text, x, y, size, c.r, c.g, c.b, a)
# Also positionally the mixed `(text, x, y, size, c)`.
pub fn draw_text(text, pos, size, c, a = 255)
  if _is_num(pos) then
    _native_text(text, pos, size, c, a.r, a.g, a.b)
  else
    _native_text(text, pos.x, pos.y, size, c.r, c.g, c.b, a)
# Styled: a record of any subset of {size, color, font, weight, italic,
# spacing}. Omitted fields mean plain text — the host's own font, upright,
# regular — so a style is a diff against what draw_text always did. Measure
# the same record with text_width(s, style) and the two agree.
#   draw_text("#482", {x: 60, y: 20}, {size: 15, color: FG, weight: 700})
pub fn draw_text(text, pos, style)
  _native_text(text, pos.x, pos.y, style)
# The styled form with flat coordinates. Also positionally `(text, pos, size,
# c)`.
pub fn draw_text(text, x, y, style)
  if _is_num(x) then
    _native_text(text, x, y, style)
  else
    _native_text(text, x.x, x.y, y, style.r, style.g, style.b)

# ── Pixel snapping ────────────────────────────────────────────────────────

@doc("""
How what is drawn after it lands on the pixel grid, on a host that draws at
fractional positions, until the frame ends. By default rects (and images,
gradients, shadows, canvases, text positions) snap to whole pixels, so rects
that tile meet without a seam, and circles, lines, polylines and polygons
keep their fractions, so a slow drift moves smoothly. Every frame starts at
the default. A host that draws only whole pixels snaps everything whatever
this says.
""",
  params: {on: "`true` snaps everything (pixel art), `false` nothing, `nil` restores the default."})
pub fn pixel_snap(on)
  _native_pixel_snap(on)

# ── Gradients ─────────────────────────────────────────────────────────────
# A gradient stop is an ordinary color record. It may carry an `a` field, in
# which case that is the stop's alpha — the only primitive where alpha rides
# *with* the color, because a two-stop fade needs two of them and there is no
# sensible positional place for the second. The trailing `a0, a1` parameters
# default to it, and override it when you'd rather pass alpha the way every
# other primitive does.
#
# `angle` is radians, clockwise from +x with y growing downward (the screen
# convention `fill_arc` uses): 0 runs left→right, PI/2 top→bottom.

# A stop's own alpha, or opaque when it carries none.
fn _stop_a(c)
  c["a"] ?? 255

@doc("""
A rect filled with a two-stop linear gradient from `c0` to `c1`.

A stop is an ordinary colour record, and may carry its own `a`: the one
primitive where alpha rides with the colour, because a two-stop fade needs
two of them. The trailing `a0`, `a1` default to the stops' own alphas and
override them.
""",
  params: {
    angle: "The direction the gradient travels, in radians clockwise from +x with y downward: 0 runs left to right, `GRAD_DOWN` top to bottom.",
    a0: "The alpha at `c0` (its own `a`, or 255).",
    a1: "The alpha at `c1`.",
  },
  example: """draw_rect_gradient(header, :3c8cff, {r: 60, g: 140, b: 255, a: 0}, GRAD_DOWN)""",
  see: ["draw_rect_gradient_rounded", "linear_gradient", "GRAD_DOWN"])
pub fn draw_rect_gradient(rect, c0, c1, angle, a0 = _stop_a(c0), a1 = _stop_a(c1))
  _native_rect_gradient(rect.x, rect.y, rect.w, rect.h, c0.r, c0.g, c0.b, a0,
                        c1.r, c1.g, c1.b, a1, angle)
pub fn draw_rect_gradient(x, y, w, h, c0, c1, angle)
  _native_rect_gradient(x, y, w, h, c0.r, c0.g, c0.b, _stop_a(c0),
                        c1.r, c1.g, c1.b, _stop_a(c1), angle)
# The flat form, forwarded so the native stays reachable through the prelude.
pub fn draw_rect_gradient(x, y, w, h, r0, g0, b0, a0, r1, g1, b1, a1, angle)
  _native_rect_gradient(x, y, w, h, r0, g0, b0, a0, r1, g1, b1, a1, angle)

@doc("`draw_rect_gradient` with rounded corners.", params: {radius: "The corner radius, in px."}, see: ["draw_rect_gradient"])
pub fn draw_rect_gradient_rounded(rect, radius, c0, c1, angle, a0 = _stop_a(c0), a1 = _stop_a(c1))
  _native_rect_gradient_rounded(rect.x, rect.y, rect.w, rect.h, radius,
                                c0.r, c0.g, c0.b, a0, c1.r, c1.g, c1.b, a1, angle)
pub fn draw_rect_gradient_rounded(x, y, w, h, radius, c0, c1, angle)
  _native_rect_gradient_rounded(x, y, w, h, radius,
                                c0.r, c0.g, c0.b, _stop_a(c0),
                                c1.r, c1.g, c1.b, _stop_a(c1), angle)
pub fn draw_rect_gradient_rounded(x, y, w, h, radius, r0, g0, b0, a0, r1, g1, b1, a1, angle)
  _native_rect_gradient_rounded(x, y, w, h, radius, r0, g0, b0, a0, r1, g1, b1, a1, angle)

@doc("""
A radial gradient: a disc shading from `c0` at the centre to `c1` at the
rim. A glow, a vignette, a soft spotlight. Stops may carry their own `a`,
as in `draw_rect_gradient`.
""", example: """draw_circle_gradient({x: 200, y: 120}, 80, {r: 255, g: 220, b: 120, a: 160}, {r: 255, g: 220, b: 120, a: 0})""", see: ["draw_rect_gradient"])
pub fn draw_circle_gradient(center, radius, c0, c1, a0 = _stop_a(c0), a1 = _stop_a(c1))
  _native_circle_gradient(center.x, center.y, radius, c0.r, c0.g, c0.b, a0,
                          c1.r, c1.g, c1.b, a1)
pub fn draw_circle_gradient(cx, cy, radius, c0, c1)
  _native_circle_gradient(cx, cy, radius, c0.r, c0.g, c0.b, _stop_a(c0),
                          c1.r, c1.g, c1.b, _stop_a(c1))
pub fn draw_circle_gradient(cx, cy, radius, r0, g0, b0, a0, r1, g1, b1, a1)
  _native_circle_gradient(cx, cy, radius, r0, g0, b0, a0, r1, g1, b1, a1)

# More than two stops is subdivided here into one two-stop band per pair, so
# a three-stop sky or a heat ramp costs no new draw command. Neighbouring
# bands share their edge colour and the host interpolates per vertex, so the
# seams do not show.
@doc("""
A linear gradient with any number of evenly spaced stops: a three-stop sky,
a heat ramp. Two stops is exactly `draw_rect_gradient`. With more, the
bands between stops are laid out along whichever axis `angle` leans toward,
so the result is exact for an axis-aligned angle and an approximation for a
diagonal one (each band still runs along the true angle).
""",
  params: {
    stops: "A list of colour records, which may carry an `a`.",
    angle: "Radians clockwise from +x with y downward (`GRAD_RIGHT`, `GRAD_DOWN`, …).",
    radius: "Rounds the rect's corners (0).",
  },
  example: "linear_gradient(sky, [:0b1d3a, :3c6fb0, :f2b880], GRAD_DOWN)",
  see: ["draw_rect_gradient"])
pub fn linear_gradient(rect, stops, angle, radius = 0)
  let n = len(stops)
  if n == 1 then
    draw_rect_rounded(rect, radius, stops[0], _stop_a(stops[0]))
  if n == 2 then
    draw_rect_gradient_rounded(rect, radius, stops[0], stops[1], angle)
  if n > 2 then
    # The rounded corners come from a rounded clip rather than from the
    # bands: only the first and last band touch a corner, and asking each to
    # round the ones it doesn't touch would notch the middle of the shape.
    if radius > 0 then
      clip_push(rect, radius)
    let bands = n - 1
    let along_x = abs(cos(angle)) >= abs(sin(angle))
    let forward = cos(angle) >= 0.0
    if !along_x then
      forward = sin(angle) >= 0.0
    for i in range(0, bands) do
      # The band's span along the layout axis, as fractions of the rect. A
      # gradient pointing backwards along the axis lays its bands out from
      # the far end, so stop 0 is still where the gradient starts.
      let t0 = (i * 1.0) / bands
      let t1 = ((i + 1) * 1.0) / bands
      if !forward then
        let swap = t0
        t0 = 1.0 - t1
        t1 = 1.0 - swap
      let band = {x: rect.x + t0 * rect.w, y: rect.y, w: (t1 - t0) * rect.w, h: rect.h}
      if !along_x then
        band = {x: rect.x, y: rect.y + t0 * rect.h, w: rect.w, h: (t1 - t0) * rect.h}
      # Band `i` is the i-th *along the gradient*, so it always carries stops
      # i→i+1; a backwards angle only moved where it sits, and the angle
      # itself still orients the fade inside it.
      draw_rect_gradient(band, stops[i], stops[i + 1], angle)
    if radius > 0 then
      clip_pop()
  nil

# The four axis-aligned gradient angles, named. `angle` is radians clockwise
# from +x with y downward, so these are the directions a fade *travels*.
@doc("The gradient angle that runs left to right (0).", see: ["GRAD_DOWN", "draw_rect_gradient"])
pub let GRAD_RIGHT = 0.0
@doc("The gradient angle that runs top to bottom (π/2): a fade from the top edge.", see: ["GRAD_RIGHT"])
pub let GRAD_DOWN = 1.5707963267948966
@doc("The gradient angle that runs right to left (π).", see: ["GRAD_RIGHT"])
pub let GRAD_LEFT = 3.141592653589793
@doc("The gradient angle that runs bottom to top (3π/2): a fade from the bottom edge.", see: ["GRAD_RIGHT"])
pub let GRAD_UP = 4.71238898038469

# ── Scrims, fades and area fills ──────────────────────────────────────────
# The three things a two-stop gradient is for in an interface, as helpers, so
# no panel has to work out the stop-and-angle arithmetic again.

@doc("""
A scrim: a band of colour fading to nothing, laid over content so text on
top of it stays legible. A caption over a photo, a title over a hero image,
a toolbar over a map. The band is solid at the edge the text is anchored to
and gone at the other, so the image stays visible everywhere the text is not.
""",
  options: {
    color: "The band's colour (black).",
    a: "Its alpha at the solid edge (190).",
    edge: """Which side of `r` is solid: `"bottom"` (the default, a caption band), `"top"`, `"left"` or `"right"`.""",
  },
  example: """
    draw_scrim(caption_band, {edge: "bottom"})
    draw_text(caption, caption_band.x + 8, caption_band.y + 8, {size: 14, color: :ffffff})
  """,
  see: ["draw_fade"])
pub fn draw_scrim(r)
  draw_scrim(r, {})

# `style` overrides {color, a, edge} — `edge` is which side of `r` the scrim
# is solid at: "bottom" (the default — a caption band), "top", "left",
# "right".
pub fn draw_scrim(r, style)
  let c = _get(style, "color", :000000)
  let a = _get(style, "a", 190)
  let edge = _get(style, "edge", "bottom")
  # The fade runs *away* from the solid edge, so the angle is the direction
  # the alpha decreases in.
  let angle = GRAD_UP
  if edge == "top" then
    angle = GRAD_DOWN
  else if edge == "left" then
    angle = GRAD_RIGHT
  else if edge == "right" then
    angle = GRAD_LEFT
  draw_rect_gradient(r, c, c, angle, a, 0)

@doc("""
A fade-out mask along one edge of a scrolling region: the region's own
background, opaque at the edge and transparent a few pixels in, so content
scrolling past the boundary dissolves instead of being cut by the clip. A
scrim hides what is under it; a fade hides where content ends.
""",
  options: {
    color: "What the fade dissolves into (the theme's `bg`).",
    a: "The alpha at the solid edge (255).",
    edge: """The side that is solid: `"bottom"` (the default), `"top"`, `"left"`, `"right"`.""",
  },
  example: """
    clip_push(list_rect)
    draw_rows(list_rect)
    clip_pop()
    draw_fade(cut_bottom(list_rect, 24).cut, {edge: "bottom"})
  """,
  see: ["draw_scrim"])
pub fn draw_fade(r)
  draw_fade(r, {})

# `style` overrides {color, a, edge}; `color` defaults to the theme background
# (what the fade is dissolving *into*) and `edge` is the side it is solid at.
pub fn draw_fade(r, style)
  let t = _palette()
  draw_scrim(r, {
    color: _get(style, "color", t.bg),
    a: _get(style, "a", 255),
    edge: _get(style, "edge", "bottom")
  })

# Each segment is cut into `step`-px columns and each column drawn as its own
# vertical gradient. That is exact rather than approximate: the fill's alpha
# at a pixel is a linear function of y alone, so starting each column at its
# own top with the alpha that ramp has *there* reproduces the single global
# ramp, column by column.
@doc("""
The filled area under a line chart, fading to transparent at the baseline:
the shape a plain rect fill cannot make, because its top edge follows the
data.
""",
  params: {
    points: """The series' polyline, in order, as `{x, y}` records.""",
    baseline_y: "The axis the fill drops to.",
    color: "The fill colour.",
  },
  options: {
    a: "The alpha at the highest point of the series (the fill is weakest where the data is lowest, which reads as depth).",
    step: "The column width in px.",
  },
  example: """
    draw_area_fill(pts, plot.y + plot.h, :3c8cff, {a: 90})
    draw_polyline(pts, :3c8cff, 255, 2)
  """,
  see: ["draw_polyline"])
pub fn draw_area_fill(points, baseline_y, color)
  draw_area_fill(points, baseline_y, color, {})

# `style` overrides {a, step} — `a` is the alpha at the highest point of the
# series (the fill is weakest where the data is lowest, which is what reads as
# depth), `step` the column width in px.
pub fn draw_area_fill(points, baseline_y, color, style)
  let n = len(points)
  if n >= 2 then
    let peak = _get(style, "a", 110)
    let step = max(1, _get(style, "step", 3))
    # The top of the ramp: the highest point of the series. Everything below
    # it is proportionally weaker.
    let top = points[0].y
    for p in points do
      if p.y < top then top = p.y end
    let span = float(baseline_y - top)
    for i in range(0, n - 1) do
      let a = points[i]
      let b = points[i + 1]
      let dx = float(b.x - a.x)
      if dx > 0.0 then
        let cols = max(1, int(dx / float(step)))
        for j in range(0, cols) do
          let x0 = float(a.x) + dx * float(j) / float(cols)
          let x1 = float(a.x) + dx * float(j + 1) / float(cols)
          # The column's own top, on the segment.
          let cy = float(a.y) + float(b.y - a.y) * (float(j) + 0.5) / float(cols)
          if float(baseline_y) > cy then
            # The global ramp's alpha at this column's top.
            let a0 = peak
            if span > 0.0 then
              a0 = int(float(peak) * (float(baseline_y) - cy) / span)
            let band = {x: x0, y: cy, w: x1 - x0, h: float(baseline_y) - cy}
            draw_rect_gradient(band, color, color, GRAD_DOWN, a0, 0)
  nil

# ── Shadows ───────────────────────────────────────────────────────────────

@doc("""
A box shadow cast by the rounded rect `rect`, like CSS `box-shadow`. The
whole shadow composites once, so it never shows a seam. Draw it before the
surface. The positional form `(rect, radius, blur, c[, a])` is the common
"soft shadow under this card" call.
""",
  options: {
    radius: "The casting rect's corner radius (0).",
    blur: "The blur radius in px (8).",
    spread: "Grows the shadow on every side (0).",
    dx: "Horizontal offset (0).",
    dy: "Vertical offset (0).",
    color: "Shadow colour (black).",
    a: "Shadow alpha (64, about 25%)."
  },
  example: """
    draw_shadow(card, {radius: 8, blur: 16, dy: 4, a: 60})
    draw_rect_rounded(card, 8, ui_theme().panel)
  """,
  see: ["draw_elevation", "elevation"])
pub fn draw_shadow(rect, opts)
  let c = opts["color"] ?? :000000
  _native_shadow(rect.x, rect.y, rect.w, rect.h,
                 opts["radius"] ?? 0, opts["blur"] ?? 8, opts["spread"] ?? 0,
                 opts["dx"] ?? 0, opts["dy"] ?? 0,
                 c.r, c.g, c.b, opts["a"] ?? 64)

# The positional form, for the common "soft shadow under this card" call.
pub fn draw_shadow(rect, radius, blur, c, a = _stop_a(c))
  _native_shadow(rect.x, rect.y, rect.w, rect.h, radius, blur, 0, 0, 0, c.r, c.g, c.b, a)
# The flat form the native takes, forwarded so it stays reachable.
pub fn draw_shadow(x, y, w, h, radius, blur, spread, dx, dy, r, g, b, a = 255)
  _native_shadow(x, y, w, h, radius, blur, spread, dx, dy, r, g, b, a)

# ── Elevation ─────────────────────────────────────────────────────────────
# The named scale the widget set casts its shadows from — `elevation_1/2/3` on
# the theme. One scale for every floating thing (cards at 1, menus and
# popovers and dropdowns at 2, modals and toasts at 3) is what makes a panel
# read as one surface lit by one light. The alternative, which this library
# shipped for years, is a hard-edged offset rectangle per widget: that does
# not read as elevation at all, it reads as a misaligned duplicate.
#
#   draw_elevation(card_rect, t.radius, 1)
#   draw_rect_rounded(card_rect, t.radius, t.surface)

@doc("""
The theme's shadow for elevation `level`, as a `draw_shadow` options record.
One scale for every floating thing (cards at 1, menus, popovers and
dropdowns at 2, modals and toasts at 3) makes a panel read as one surface
lit by one light.
""", params: {level: "1–3, clamped."}, returns: """`{blur, spread, dy, a}` from the theme's `elevation_1/2/3`.""", see: ["draw_elevation", "draw_shadow"])
pub fn elevation(level)
  let t = _palette()
  let l = clamp(level, 1, 3)
  if l == 1 then
    t.elevation_1
  else if l == 2 then
    t.elevation_2
  else
    t.elevation_3

@doc("""
Cast elevation `level`'s shadow for a rounded rect. Draw it *before* the
surface: the shadow is what is behind the card, not on it.
""",
  params: {level: "1 resting (cards), 2 floating (menus), 3 lifted (modals)."},
  options: {blur: "Override the level's blur.", spread: "Override its spread.", dx: "Horizontal offset.", dy: "Vertical offset.", color: "Shadow colour, for a coloured glow.", a: "Shadow alpha."},
  example: """
    draw_elevation(card_rect, t.radius, 1)
    draw_rect_rounded(card_rect, t.radius, t.surface)
  """,
  see: ["elevation", "draw_shadow"])
pub fn draw_elevation(r, radius, level)
  draw_elevation(r, radius, level, {})

# `style` overrides any of {blur, spread, dx, dy, color, a} over the level's
# values — for a coloured glow, or a shadow that has to lean a particular way.
pub fn draw_elevation(r, radius, level, style)
  let e = elevation(level)
  draw_shadow(r, {
    radius: radius,
    blur: _get(style, "blur", e.blur),
    spread: _get(style, "spread", e.spread),
    dx: _get(style, "dx", 0),
    dy: _get(style, "dy", e.dy),
    color: _get(style, "color", :000000),
    a: _get(style, "a", e.a)
  })

@doc("""
A focus ring: the accent colour bloomed around `r` rather than a hard second
outline, so focus reads as attention rather than as a doubled border. Draw
it before the widget's own surface, like any other shadow.
""",
  options: {color: "The glow's colour (the theme's accent).", blur: "Blur radius.", spread: "How far it reaches past `r`.", a: "Its alpha."},
  see: ["draw_elevation"])
pub fn draw_focus_ring(r, radius)
  draw_focus_ring(r, radius, {})

# `style` overrides {color, blur, spread, a}.
pub fn draw_focus_ring(r, radius, style)
  let t = _palette()
  let c = _get(style, "color", t.accent)
  draw_shadow(r, {
    radius: radius,
    blur: _get(style, "blur", 8),
    spread: _get(style, "spread", 1),
    color: c,
    a: _get(style, "a", 150)
  })

@doc("""
The shadow a sticky header casts over content scrolled under it: a short
fade below `header_rect`, as strong as the content is scrolled, so a list at
rest shows no seam at all.
""",
  params: {frac: "0 (at the top: nothing drawn) to 1 (fully lifted)."},
  options: {height: "The fade's height in px.", color: "Shadow colour.", a: "Alpha at full strength."},
  example: "draw_scroll_shadow(header, min(1.0, scroll_px / 24.0))")
pub fn draw_scroll_shadow(header_rect, frac)
  draw_scroll_shadow(header_rect, frac, {})

# `style` overrides {height, color, a}.
pub fn draw_scroll_shadow(header_rect, frac, style)
  let f = clamp(float(frac), 0.0, 1.0)
  if f > 0.004 then
    let h = _get(style, "height", 8)
    let c = _get(style, "color", :000000)
    let peak = int(float(_get(style, "a", 70)) * f)
    let band = rect(header_rect.x, header_rect.y + header_rect.h, header_rect.w, h)
    # Downward: opaque at the header's edge, gone `h` px later.
    draw_rect_gradient(band, c, c, GRAD_DOWN, peak, 0)

# ── Layers — offscreen canvases, backdrops and blur ───────────────────────
# A *layer* is a canvas the size of a rect that a closure draws into, then
# composited back at that rect. It is what every effect that needs an
# offscreen buffer is made of, and the closure is what keeps it composable:
# `draw_to` hands back the target it replaced, so layers nest without a
# stack anyone has to keep, and the body draws in canvas-local coordinates
# ((0, 0) is the rect's top-left) the same way it would on screen.
#
#   // A group of overlapping translucent shapes at 50%, as one object — the
#   // thing drawing each shape at 50% gets wrong, since alpha blending is not
#   // idempotent and every overlap would read darker.
#   layer(card, {a: 128}, fn()
#     draw_circle(rect(0, 0, 80, 80), c1)
#     draw_circle(rect(40, 0, 80, 80), c2)
#   end)
#
#   // A glow: the shape drawn into a layer and the layer blurred.
#   layer(halo, {blur: 12}, fn() draw_circle(rect(0, 0, halo.w, halo.h), accent) end)
#
#   // The translucent bar content scrolls under — see draw_material.
#   draw_material(bar, {kind: "regular", hairline: true})
#
# Hosts without render targets draw nothing for a canvas (it never existed),
# so a helper that must stay legible everywhere paints its flat fallback
# *outside* the layer — `draw_material` draws its tint after the blurred
# snapshot, which on such a host is the tint alone: right in aggregate.

@doc("""
A transparent offscreen canvas `w` by `h` (or the size of rect `r`), good
for this frame. Hosts without render targets draw nothing for a canvas.
""", returns: "The canvas id, for `draw_to` and `draw_canvas`.", see: ["layer", "draw_canvas", "create_canvas"])
pub fn canvas(w, h)
  create_canvas(int(w), int(h))
pub fn canvas(r)
  create_canvas(int(r.w), int(r.h))

# The flat form, forwarded so it stays reachable under the record one.
@doc("""
Composite canvas `id`: at a point `{x, y}` at its natural size, or scaled
into a rect. Three arguments is also, positionally, the flat
`draw_canvas(id, x, y)`.
""",
  params: {at: """A point `{x, y}`, or a rect to scale into.""", opts: """`{a}`: the canvas's opacity."""},
  see: ["canvas", "layer"])
pub fn draw_canvas(id, x, y, a = 255, w = 0, h = 0)
  _native_draw_canvas(id, x, y, a, w, h)

# draw_canvas(id, at[, opts]) — `at` is a point {x, y} (natural size) or a
# rect (the canvas scaled into it); `opts` is {a}. Three arguments is also,
# positionally, the flat `draw_canvas(id, x, y)`, told apart by whether the
# second is a number.
pub fn draw_canvas(id, at, opts = {})
  if _is_num(at) then
    _native_draw_canvas(id, at, opts)
  else
    _draw_canvas_at(id, at, opts)

# `at`'s numbers go through as the flat form's do: a host that truncates
# does so in the native, and a sub-pixel host keeps the fractions under
# `pixel_snap(false)`.
fn _draw_canvas_at(id, at, opts)
  _native_draw_canvas(id, at.x, at.y, _get(opts, "a", 255),
                      _get(at, "w", 0), _get(at, "h", 0))

@doc("""
An offscreen layer: draw `body()` into a fresh canvas the size of `r`, in
canvas-local coordinates ((0, 0) is the rect's top-left), then composite it
at `r`. Group opacity (overlapping translucent shapes at 50% as one object,
which drawing each at 50% gets wrong), glows. Layers nest.
""",
  options: {a: "The group's opacity, 0–255.", blur: "A Gaussian blur in px, applied to the whole layer before it is drawn."},
  returns: "The canvas id, to draw again (a repeated stamp) or filter further.",
  example: """
    layer(card, {a: 128}, fn()
      draw_circle({x: 40, y: 40}, 40, c1)
      draw_circle({x: 80, y: 40}, 40, c2)
    )
    layer(halo, {blur: 12}, fn() draw_circle({x: halo.w / 2, y: halo.h / 2}, halo.h / 2, accent) end)
  """,
  see: ["canvas", "draw_material", "ui.cached_layer"])
pub fn layer(r, body)
  layer(r, {}, body)
pub fn layer(r, opts, body)
  let c = create_canvas(int(r.w), int(r.h))
  let prev = draw_to(c)
  body()
  draw_to(prev)
  let blur = _get(opts, "blur", 0)
  if blur > 0 then
    blur_canvas(c, blur)
  _native_draw_canvas(c, int(r.x), int(r.y), _get(opts, "a", 255), 0, 0)
  c

@doc("""
A canvas holding a copy of what is already painted under `r`: the backdrop
primitive. It copies the target as drawn *so far*.
""", returns: "The canvas id.", see: ["draw_backdrop_blur", "snapshot_to"])
pub fn snapshot(r)
  let c = create_canvas(int(r.w), int(r.h))
  snapshot_to(c, int(r.x), int(r.y))
  c

@doc("Replace what is already painted under `r` with a `radius`-px Gaussian blur of itself.", see: ["draw_material", "snapshot"])
pub fn draw_backdrop_blur(r, radius)
  let c = snapshot(r)
  blur_canvas(c, radius)
  _native_draw_canvas(c, int(r.x), int(r.y), 255, 0, 0)

@doc("""
The translucent, blurred bar content scrolls under: navigation and tab bars,
sheets, a floating search pill. What is behind it, blurred, under a tint.
Content that scrolls under it must be drawn *before* it, since it reads what
is already there. On a host without render targets it is the tint alone.
""",
  options: {
    kind: """`"thin"`, `"regular"` (the default) or `"thick"`: how much the backdrop shows through. Sets the default blur and tint strength.""",
    radius: "Corner radius (a bar is 0, a pill is `r.h / 2`).",
    blur: "Gaussian radius in px (by kind: 12 / 20 / 32).",
    tint: "The material's colour (the theme's surface).",
    a: "Tint opacity, 0–255 (by kind: 110 / 165 / 215).",
    hairline: """`true` or `"bottom"` draws the 1-px separator a bar carries on the edge facing the content; `"top"` puts it on top.""",
  },
  example: """draw_material(bar, {kind: "regular", hairline: true})""",
  see: ["draw_backdrop_blur", "layer"])
pub fn draw_material(r)
  draw_material(r, {})
pub fn draw_material(r, opts)
  let t = _palette()
  let kind = _get(opts, "kind", "regular")
  let a_default = if kind == "thin" then 110 else if kind == "thick" then 215 else 165 end
  let blur_default = if kind == "thin" then 12 else if kind == "thick" then 32 else 20 end
  let radius = _get(opts, "radius", 0)
  let tint = _get(opts, "tint", t.surface)
  let a = _get(opts, "a", a_default)
  let blur = _get(opts, "blur", blur_default)
  clip_push(r, radius)
  # Backdrop first, tint over it: on a host without render targets the
  # backdrop is nothing and the tint alone is the flat approximation.
  draw_backdrop_blur(r, blur)
  draw_rect(r, tint, a)
  # The hairline stays inside the clip so a rounded material's corners cut
  # it the way they cut the tint.
  let hairline = _get(opts, "hairline", false)
  if hairline == true || hairline == "bottom" then
    draw_rect(rect(r.x, r.y + r.h - 1, r.w, 1), t.border, 140)
  else if hairline == "top" then
    draw_rect(rect(r.x, r.y, r.w, 1), t.border, 140)
  clip_pop()
  nil

# ── Fonts ─────────────────────────────────────────────────────────────────

@doc("""
A font object: a style record naming a face, so the size and decorations
that belong with it travel with it. It is an ordinary text style record
(see `draw_text`), so it drops into `draw_text`, `text_width` and every
widget `style`, and merges the usual way (`{...title, color: FG}`): one
value describes a run's whole appearance, so what is measured is what is
drawn.
""",
  params: {
    name: """A family name (`"Helvetica Neue"`), a host role (`"mono"`, `"ui"`), or a CSS-style fallback list (`"Menlo, mono"`). One the host cannot draw falls back to its default face, for measuring and drawing alike.""",
    size: "The pixel size.",
  },
  example: """
    let title = font_bold(font("Helvetica Neue", 22))
    draw_text("Chapter One", {x: 20, y: 40}, title)
    let w = text_width("Chapter One", title)
  """,
  see: ["fonts", "font_size", "font_bold", "draw_text"])
pub fn font(name)
  _native_font(name)

# `font(name, size)` — the common case, in one call.
pub fn font(name, size)
  {..._native_font(name), size: size}

@doc("""
A copy of font `f` at `size`. Like every `font_*` decoration it returns a
new font object with one field set, so they compose and never change the
font they were given.
""",
  example: """
    let body = font("Inter", 14)
    let emphasis = font_italic(font_color(body, :3c8cff))
  """,
  see: ["font", "font_weight", "font_color"])
pub fn font_size(f, size)
  {...f, size: size}

@doc("""
A copy of font `f` at weight `w`.
""", params: {w: "A CSS numeric weight, 100–900. A host draws the nearest cut the family ships, synthesizing bold only for a family that has none."}, see: ["font_bold"])
pub fn font_weight(f, w)
  {...f, weight: w}

@doc("A copy of font `f` in bold (weight 700).", see: ["font_weight", "font_italic"])
pub fn font_bold(f)
  {...f, weight: 700}

@doc("A copy of font `f` in italic.", see: ["font_bold"])
pub fn font_italic(f)
  {...f, italic: true}

@doc("A copy of font `f` with `px` of letter-spacing, added after each glyph.", see: ["font"])
pub fn font_spacing(f, px)
  {...f, spacing: px}

@doc("""
A copy of font `f` that draws in colour `c`: a `{r, g, b}` (or `{r, g, b,
a}`) record.
""", see: ["font"])
pub fn font_color(f, c)
  {...f, color: c}

# ── Color helpers ─────────────────────────────────────────────────────────

# A thin wrapper over the `color_lerp` builtin, so the prelude's own name for
# it is discoverable next to `theme`.
@doc("""
Blend two colours: `t` = 0 is `a`, 1 is `b`.
""", example: "let hover_bg = mix(t.panel, t.accent, 0.15)", see: ["lerp_color", "over"])
pub fn mix(a, b, t)
  color_lerp(a, b, t)

@doc("Blend two colours: `mix` under the name the graphics-minded reach for first.", see: ["mix"])
pub fn lerp_color(a, b, t)
  color_lerp(a, b, t)

@doc("""
The perceived brightness of a colour, 0 (black) to 255 (white), by the Rec.
601 luma weights. What a themeable widget needs to know about a colour it
did not choose: `luma(bg) > 128` means a light surface, so pick dark ink.
""", see: ["contrast_text"])
pub fn luma(c)
  (c.r * 299 + c.g * 587 + c.b * 114) / 1000

@doc("""
Black or white, whichever reads on `bg`: near-black on light surfaces,
near-white on dark ones. A readable label for arbitrary tags, avatars and
status chips.
""", example: """draw_text(tag.name, x, y, {size: 12, color: contrast_text(tag.color)})""", see: ["luma"])
pub fn contrast_text(bg)
  if luma(bg) > 140 then :14161c else :f2f5fa end

# ── Compositing ───────────────────────────────────────────────────────────
# A flat tint — a hover wash, a disabled label, a hairline divider, a zebra
# stripe — is a translucent ink over a surface *you already know*. Drawing it
# as a translucent fill hands the compositor a job it does not need, and one
# it is easy to get subtly wrong; worse, it is not idempotent, so two 50%
# fills that land on the same pixel read as 75% and a widget drawn twice in a
# frame (a hover under a selection, say) comes out the wrong colour.
#
# `over` does that composite here, on the CPU, in sRGB — the same space and
# the same source-over formula a correct renderer uses — and returns an
# **opaque** colour. Passing that to a plain `draw_rect` gives the identical
# pixel, once, no matter how many times it is drawn.
#
# This is for tints over a *known* surface only. Genuine translucency — a
# modal backdrop, a fading tooltip, anything over content the widget did not
# paint — still takes a plain alpha, because there is nothing to composite
# against ahead of time. Widgets that flatten a tint therefore take an `on`
# style key naming the surface they sit on.

@doc("""
A percentage as the 0–255 alpha every draw call takes: `alpha_pct(40)` is
102.
""", see: ["tint"])
pub fn alpha_pct(p)
  clamp(int(p * 255 / 100), 0, 255)

@doc("""
`fg` composited over `bg` at alpha `a`, as an opaque colour: a hover wash, a
disabled label, a zebra stripe over a surface you already know. Drawing the
result opaque gives the same pixel however many times it is drawn, where a
translucent fill drawn twice reads darker. Genuine translucency, over
content the widget did not paint, still takes a plain alpha.
""",
  params: {a: "An int is the 0–255 alpha; a float is a 0.0–1.0 fraction."},
  example: "draw_rect(row_r, over(t.panel, t.accent, 0.12))",
  see: ["tint", "hairline"])
pub fn over(bg, fg, a)
  let f = if type(a) == "float" then clamp(a, 0.0, 1.0) else clamp(float(a) / 255.0, 0.0, 1.0) end
  color_lerp(bg, fg, f)

@doc("""
`over` with the alpha as a percentage, which is how tints are specified ("a
10% hairline", "disabled text at 40%").
""", example: "let disabled = tint(t.panel, t.text, 40)", see: ["over"])
pub fn tint(bg, fg, pct)
  over(bg, fg, alpha_pct(pct))

@doc("""
A separator colour for a surface: the ink at 10% over `bg`, which stays a
hairline on a light theme and on a dark one without either being
hand-tuned. Every divider, rule and table gridline wants it.
""", example: "draw_rect(rect(r.x, r.y + r.h - 1, r.w, 1), hairline(t.panel, t.text))", see: ["tint"])
pub fn hairline(bg, ink)
  tint(bg, ink, 10)
