{
  "name": "petal",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "integrations/petal-web-canvas",
    "examples/custom-apps/diagram-canvas"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test-examples": "node tools/test-examples.ts",
    "scan-secrets": "node tools/scan-secrets.ts",
    "petal": "node tools/run-petal.ts",
    "stdlib:json": "node tools/extract-stdlib.ts",
    "reference": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/gen-reference.ts",
    "reference:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/gen-reference.ts --check",
    "lint:docs": "node tools/run-petal.ts lint --strict --rules-include=undocumented-pub,doc-params core/prelude core/packages core-stdlib/ui/src core-stdlib/bloom core-stdlib/text-layout core-stdlib/glsl/src core-stdlib/regex/src",
    "tsc": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.4.0",
    "vitest": "3.1.4"
  }
}
