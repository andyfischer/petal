@module_doc("""
Drawing: shapes, images, text, clipping, gradients, scrims, shadows and
elevation, offscreen canvases, fonts, colour, compositing and the theme.
`ui` re-exports every name here.

Each shape comes flat (`draw_line(x1, y1, x2, y2, r, g, b)`), with records
(`draw_line(p1, p2, c)`), and mixed (`draw_line(x1, y1, x2, y2, c)`). All
take a trailing alpha `a` (0–255); strokes also take a trailing `width`.
Arguments can be named, and are spelt the same way throughout: `x, y, w, h`
/ `rect`, `cx, cy` / `center`, `x1, y1, x2, y2` / `p1, p2`, `radius`,
`r, g, b` / `c`, then `a` and `width`:

```petal
draw_rect_outline(x: 0, y: 0, w: 10, h: 4, c: :ff0000, width: 2)
draw_circle(center: p, radius: 6, c: :ff0000, a: 128)
```

Coordinates may be fractional. A host that draws only whole pixels truncates
them. A host that draws at fractional positions keeps them for circles,
ellipses, arcs, lines, polylines, triangles and polygons, and by default
snaps the rect family (rects, outlines, rect gradients, shadows, images,
canvases, text positions) so that touching rects meet without a seam; see
`pixel_snap`. drawing.md (core-stdlib/ui/docs) covers the primitives in
depth.
""",
  see: ["ui", "pixel_snap"],
  extra: {groups: [
    {name: "Shapes", items: ["clear", "draw_rect", "draw_rect_rounded", "draw_rect_outline", "draw_rect_rounded_outline", "draw_rects", "draw_line", "draw_polyline", "draw_polygon_outline", "draw_circle", "draw_circle_outline", "draw_ellipse", "draw_ellipse_outline", "fill_arc", "fill_triangle", "fill_poly", "fill_polygon", "fill_fan", "pixel_snap"]},
    {name: "Gradients, shadows and effects", items: ["draw_rect_gradient", "draw_rect_gradient_rounded", "draw_circle_gradient", "linear_gradient", "GRAD_RIGHT", "GRAD_DOWN", "GRAD_LEFT", "GRAD_UP", "draw_shadow", "elevation", "draw_elevation", "draw_focus_ring", "draw_scroll_shadow", "draw_scrim", "draw_fade", "draw_area_fill"]},
    {name: "Images", items: ["draw_image", "image_load", "image_size"]},
    {name: "Clipping", items: ["clip_push", "clip_pop", "clip", "clip_none", "clip_rect"], doc: """
Use `clip_push` and `clip_pop` in anything reusable: they clip inside the
clip already in force. `clip` and `clip_none` replace it.
"""},
    {name: "Offscreen layers", items: ["layer", "canvas", "create_canvas", "draw_to", "draw_to_screen", "draw_canvas", "snapshot", "snapshot_to", "blur_canvas", "draw_backdrop_blur", "draw_material"]},
    {name: "Drawing and measuring text", items: ["draw_text", "text_width", "text_advance", "text_metrics", "text_wrap", "text_ellipsize", "text_index_at"], doc: """
A text style is a record (see `draw_text` for its fields). Measure with the
record you draw with. `ui/text` has the helpers built on these: alignment,
truncation, wrapping, text on a path and carets.
"""},
    {name: "Font objects", items: ["font", "font_size", "font_weight", "font_bold", "font_italic", "font_spacing", "font_color", "fonts"], doc: """
Font objects build a text style from a face: `font(name)` is a style
record, and each `font_*` returns a copy with one thing changed.
"""},
    {name: "Colour", items: ["mix", "lerp_color", "luma", "contrast_text", "over", "tint", "hairline", "alpha_pct"]},
    {name: "The theme", items: ["theme", "ui_theme", "theme_set", "theme_reset", "theme_from_palette"]},
    {name: "Geometry, time and the host", items: ["rect", "point_in", "clicked", "elapsed", "host_data"]},
  ]})

# petal-ui draw — module `ui/draw`
#
# The public natives, geometry and timing (`./_base`), the record overloads
# over the draw natives, and the rest of the draw surface.

pub import ./_base
pub import ./_style: theme, ui_theme, theme_set, theme_reset, theme_from_palette
pub import ./_frame: clip, clip_none, clip_push, clip_pop, clip_rect
import ./_native
import ./_style
import ./_frame
import color

# ── Record overloads over the flat draw natives ───────────────────────────
# The flat-int arities delegate to the natives, declared in `./_native` under
# private names (`= "draw_rect"` binds the host native of that name), so
# scripts that use the classic signatures keep working when these overloads
# take the name.

# Every primitive takes an optional trailing alpha `a` (0–255, 255 = opaque).
# Lines and outlines also take an optional trailing stroke `width`. Rounded
# rects add a `radius`.
#
# Each primitive comes in three shapes: the flat packed-int form
# (`draw_line(x1, y1, x2, y2, r, g, b)`), the record form (points, centres and
# rects as `{x, y}` / `{x, y, w, h}` records plus a colour record), and the
# mixed form with flat coordinates and a colour record
# (`draw_line(x1, y1, x2, y2, c)`).
#
# Every shape can be called by name, and its parameters are spelt the same
# way throughout: `x, y, w, h` / `rect`, `cx, cy` / `center`, `x1, y1, x2, y2`
# / `p1, p2`, `radius`, `r, g, b` / `c`, then `a` and `width`:
#
#   draw_rect_outline(x: 0, y: 0, w: 10, h: 4, c: red, width: 2)
#   draw_circle(center: p, radius: 6, c: red, a: 128)
#
# How the declarations are laid out. A shape's longest declaration gives its
# optional tail defaults (`a = 255, width = 1` — what the natives fill in
# themselves), so one declaration covers the shape with and without them and
# a named call can skip `a` to reach `width`. An overload is chosen by the
# number of arguments first and by their names second, so where two shapes
# land on the same count the declaration with exactly that many parameters
# takes both: a positional call tells them apart with `_is_num` — a number
# where the other shape has a record — and a named call that does not fit its
# parameters goes to the other shape's declaration. Such a declaration is
# marked "also positionally" below; its parameter names are the shape it is
# declared as. Next to one, the shape's shorter counts keep declarations of
# their own, so each still says in its own body what its parameters must be
# (`petal lint` reads that) rather than deferring to a runtime test.
#
# One pair needs a third look. `draw_circle_outline(cx, cy, radius, c,
# width: 2)` and `draw_ellipse_outline(cx, cy, rx, ry, c, width: 2)` — flat
# coordinates passed positionally, alpha skipped by naming `width` — have the
# argument count and the `width` name of the centre-record shape's longest
# declaration too. A name that skips a parameter outranks the exact count, so
# the mixed shape's declaration takes the call, and with it the centre-record
# call of the same outline, `(center, radius, c, a, width: 2)`: it tells that
# one apart by its first argument being a record.

fn _is_num(v)
  let t = type(v)
  t == "int" || t == "float"

@doc("""
Draw a host-resolved bitmap scaled into a rect. A host that can't round a
bitmap draws the square image rather than nothing; a host that lacks one of
the `opts` draws the image without it.
""",
  params: {
    source: "An asset path or name the host understands.",
    a: "Opacity, 0–255 (255), or in its place an options record.",
    radius: "Rounds the corners: the avatar, the card thumbnail.",
  },
  options: {
    a: "Opacity, 0–255 (255).",
    radius: "Corner radius in px (0).",
    tint: "A colour the image's pixels are multiplied by: one white sprite, recoloured per use.",
    src: """The part of the image to draw, `{x, y, w, h}` in the image's own pixels: one cell of an atlas.""",
    slice: """Nine-slice insets in the image's own pixels, one number or `{l, t, r, b}`. Corners are drawn unscaled, edges stretch one way, the middle both: a small frame image makes a panel of any size.""",
  },
  example: """
    draw_image("ui/atlas.png", r, {src: rect(32, 0, 16, 16), tint: :ffcc00})
    draw_image("ui/frame.png", panel, {slice: 6})
  """,
  see: ["image_load", "image_size"])
pub fn draw_image(source, x, y, w, h, a = 255, radius = 0)
  if _is_num(a) then
    _native_image(source, x, y, w, h, a, radius)
  else
    _image_opts(source, x, y, w, h, a)
pub fn draw_image(source, rect, a = 255, radius = 0)
  if _is_num(a) then
    _native_image(source, rect.x, rect.y, rect.w, rect.h, a, radius)
  else
    _image_opts(source, rect.x, rect.y, rect.w, rect.h, a)

fn _image_opts(source, x, y, w, h, o)
  let src = o["src"] ?? nil
  let sl = o["slice"] ?? 0
  let sx = 0
  let sy = 0
  let sw = 0
  let sh = 0
  if src != nil then
    sx = src.x
    sy = src.y
    sw = src.w
    sh = src.h
  if _is_num(sl) then
    _native_image(source, x, y, w, h, o["a"] ?? 255, o["radius"] ?? 0, o["tint"] ?? nil,
                  sx, sy, sw, sh, sl, sl, sl, sl)
  else
    _native_image(source, x, y, w, h, o["a"] ?? 255, o["radius"] ?? 0, o["tint"] ?? nil,
                  sx, sy, sw, sh, sl["l"] ?? 0, sl["t"] ?? 0, sl["r"] ?? 0, sl["b"] ?? 0)

@doc("A filled rect with rounded corners.", params: {radius: "The corner radius, in px."}, see: ["draw_rect", "draw_rect_rounded_outline"])
pub fn draw_rect_rounded(x, y, w, h, radius, r, g, b, a = 255)
  _native_rect_rounded(x, y, w, h, radius, r, g, b, a)
pub fn draw_rect_rounded(rect, radius, c, a = 255)
  _native_rect_rounded(rect.x, rect.y, rect.w, rect.h, radius, c.r, c.g, c.b, a)
pub fn draw_rect_rounded(x, y, w, h, radius, c, a = 255)
  _native_rect_rounded(x, y, w, h, radius, c.r, c.g, c.b, a)

@doc("""
A stroked rect, inside the rect's edge.
""", params: {width: "Stroke width in px (1)."}, example: "draw_rect_outline(r, :3a404c, 255, 2)", see: ["draw_rect_rounded_outline", "draw_rect"])
pub fn draw_rect_outline(x, y, w, h, r, g, b, a = 255, width = 1)
  _native_rect_outline(x, y, w, h, r, g, b, a, width)
pub fn draw_rect_outline(x, y, w, h, c)
  _native_rect_outline(x, y, w, h, c.r, c.g, c.b)
pub fn draw_rect_outline(x, y, w, h, c, a)
  _native_rect_outline(x, y, w, h, c.r, c.g, c.b, a)
# Also positionally the flat `(x, y, w, h, r, g, b)`.
pub fn draw_rect_outline(x, y, w, h, c, a = 255, width = 1)
  if _is_num(c) then
    _native_rect_outline(x, y, w, h, c, a, width)
  else
    _native_rect_outline(x, y, w, h, c.r, c.g, c.b, a, width)
pub fn draw_rect_outline(rect, c, a = 255, width = 1)
  _native_rect_outline(rect.x, rect.y, rect.w, rect.h, c.r, c.g, c.b, a, width)

@doc("""
A line from one point to another.
""",
  params: {p1: """The start, `{x, y}`.""", p2: "The end.", width: "Stroke width in px (1)."},
  example: """draw_line({x: 0, y: 0}, {x: 100, y: 50}, :ffffff, 200, 2)""",
  see: ["draw_polyline"])
pub fn draw_line(x1, y1, x2, y2, r, g, b, a = 255, width = 1)
  _native_line(x1, y1, x2, y2, r, g, b, a, width)
pub fn draw_line(x1, y1, x2, y2, c, a)
  _native_line(x1, y1, x2, y2, c.r, c.g, c.b, a)
# Also positionally the flat `(x1, y1, x2, y2, r, g, b)`.
pub fn draw_line(x1, y1, x2, y2, c, a = 255, width = 1)
  if _is_num(c) then
    _native_line(x1, y1, x2, y2, c, a, width)
  else
    _native_line(x1, y1, x2, y2, c.r, c.g, c.b, a, width)
pub fn draw_line(p1, p2, c)
  _native_line(p1.x, p1.y, p2.x, p2.y, c.r, c.g, c.b)
# Alpha and stroke width, matching the flat arities and every other primitive's
# record overload. A checkmark, a strikethrough, a caret and a focus underline
# all want a 2px or translucent stroke; without these the call fell through to
# the native's arity check and failed at *runtime* with "draw_line() expects
# 7 or 8 or 9 or 3 arguments, got 5".
pub fn draw_line(p1, p2, c, a)
  _native_line(p1.x, p1.y, p2.x, p2.y, c.r, c.g, c.b, a)
# Also positionally the mixed `(x1, y1, x2, y2, c)`.
pub fn draw_line(p1, p2, c, a = 255, width = 1)
  if _is_num(p1) then
    _native_line(p1, p2, c, a, width.r, width.g, width.b)
  else
    _native_line(p1.x, p1.y, p2.x, p2.y, c.r, c.g, c.b, a, width)

@doc("A filled disc.", params: {center: """The centre, `{x, y}`."""}, see: ["draw_circle_outline", "draw_ellipse", "draw_circle_gradient"])
pub fn draw_circle(cx, cy, radius, r, g, b, a = 255)
  _native_circle(cx, cy, radius, r, g, b, a)
pub fn draw_circle(center, radius, c)
  _native_circle(center.x, center.y, radius, c.r, c.g, c.b)
# Also positionally the mixed `(cx, cy, radius, c)`.
pub fn draw_circle(center, radius, c, a)
  if _is_num(center) then
    _native_circle(center, radius, c, a.r, a.g, a.b)
  else
    _native_circle(center.x, center.y, radius, c.r, c.g, c.b, a)
pub fn draw_circle(cx, cy, radius, c, a = 255)
  _native_circle(cx, cy, radius, c.r, c.g, c.b, a)

# Record overloads for the rest of the draw surface. Every one of these was
# hand-rolled by at least one testbed app: a call like
# `draw_polyline(pts, C_ROCK, 235, 1)` passes `check --strict` and then dies
# at *runtime* with "Expected int at arg 2, got record", which is the expensive
# round-trip the prelude exists to save. The shapes mirror the flat natives
# exactly — the same optional alpha and stroke width, in the same order — so
# switching a call from packed ints to a colour record changes nothing else.
@doc("A stroked rect with rounded corners.", params: {radius: "The corner radius, in px.", width: "Stroke width in px (1)."}, see: ["draw_rect_outline", "draw_rect_rounded"])
pub fn draw_rect_rounded_outline(x, y, w, h, radius, r, g, b, a = 255, width = 1)
  _native_rect_rounded_outline(x, y, w, h, radius, r, g, b, a, width)
pub fn draw_rect_rounded_outline(x, y, w, h, radius, c)
  _native_rect_rounded_outline(x, y, w, h, radius, c.r, c.g, c.b)
pub fn draw_rect_rounded_outline(x, y, w, h, radius, c, a)
  _native_rect_rounded_outline(x, y, w, h, radius, c.r, c.g, c.b, a)
# Also positionally the flat `(x, y, w, h, radius, r, g, b)`.
pub fn draw_rect_rounded_outline(x, y, w, h, radius, c, a = 255, width = 1)
  if _is_num(c) then
    _native_rect_rounded_outline(x, y, w, h, radius, c, a, width)
  else
    _native_rect_rounded_outline(x, y, w, h, radius, c.r, c.g, c.b, a, width)
pub fn draw_rect_rounded_outline(rect, radius, c, a = 255, width = 1)
  _native_rect_rounded_outline(rect.x, rect.y, rect.w, rect.h, radius, c.r, c.g, c.b, a, width)

# The mixed `(cx, cy, radius, c[, a[, width]])` shares every one of its counts
# with another shape: four and five with the centre-record form, six with the
# flat form. So the centre-record form keeps a declaration per count, each
# looking at its first argument, and the mixed form's own declaration looks at
# its fourth.
@doc("A ring: a stroked circle.", params: {center: """The centre, `{x, y}`.""", width: "Stroke width in px (1)."}, see: ["draw_circle"])
pub fn draw_circle_outline(cx, cy, radius, r, g, b, a = 255, width = 1)
  _native_circle_outline(cx, cy, radius, r, g, b, a, width)
# Also positionally the flat `(cx, cy, radius, r, g, b)`.
# And, with `width` named, the centre-record `(center, radius, c, a)`.
pub fn draw_circle_outline(cx, cy, radius, c, a = 255, width = 1)
  if !_is_num(cx) then
    _native_circle_outline(cx.x, cx.y, cy, radius.r, radius.g, radius.b, c, width)
  else
    if _is_num(c) then
      _native_circle_outline(cx, cy, radius, c, a, width)
    else
      _native_circle_outline(cx, cy, radius, c.r, c.g, c.b, a, width)
pub fn draw_circle_outline(center, radius, c)
  _native_circle_outline(center.x, center.y, radius, c.r, c.g, c.b)
# Also positionally the mixed `(cx, cy, radius, c)`.
pub fn draw_circle_outline(center, radius, c, a)
  if _is_num(center) then
    _native_circle_outline(center, radius, c, a.r, a.g, a.b)
  else
    _native_circle_outline(center.x, center.y, radius, c.r, c.g, c.b, a)
# Also positionally the mixed `(cx, cy, radius, c, a)`.
pub fn draw_circle_outline(center, radius, c, a = 255, width = 1)
  if _is_num(center) then
    _native_circle_outline(center, radius, c, a.r, a.g, a.b, width)
  else
    _native_circle_outline(center.x, center.y, radius, c.r, c.g, c.b, a, width)

@doc("A filled ellipse.", params: {rx: "The horizontal radius.", ry: "The vertical radius."}, see: ["draw_ellipse_outline", "draw_circle"])
pub fn draw_ellipse(cx, cy, rx, ry, r, g, b, a = 255)
  _native_ellipse(cx, cy, rx, ry, r, g, b, a)
pub fn draw_ellipse(center, rx, ry, c)
  _native_ellipse(center.x, center.y, rx, ry, c.r, c.g, c.b)
# Also positionally the mixed `(cx, cy, rx, ry, c)`.
pub fn draw_ellipse(center, rx, ry, c, a)
  if _is_num(center) then
    _native_ellipse(center, rx, ry, c, a.r, a.g, a.b)
  else
    _native_ellipse(center.x, center.y, rx, ry, c.r, c.g, c.b, a)
pub fn draw_ellipse(cx, cy, rx, ry, c, a = 255)
  _native_ellipse(cx, cy, rx, ry, c.r, c.g, c.b, a)

# As with `draw_circle_outline`, the mixed `(cx, cy, rx, ry, c[, a[, width]])`
# shares its counts: five and six with the centre-record form, seven with the
# flat form.
@doc("A stroked ellipse.", params: {rx: "The horizontal radius.", ry: "The vertical radius.", width: "Stroke width in px (1)."}, see: ["draw_ellipse"])
pub fn draw_ellipse_outline(cx, cy, rx, ry, r, g, b, a = 255, width = 1)
  _native_ellipse_outline(cx, cy, rx, ry, r, g, b, a, width)
# Also positionally the flat `(cx, cy, rx, ry, r, g, b)`.
# And, with `width` named, the centre-record `(center, rx, ry, c, a)`.
pub fn draw_ellipse_outline(cx, cy, rx, ry, c, a = 255, width = 1)
  if !_is_num(cx) then
    _native_ellipse_outline(cx.x, cx.y, cy, rx, ry.r, ry.g, ry.b, c, width)
  else
    if _is_num(c) then
      _native_ellipse_outline(cx, cy, rx, ry, c, a, width)
    else
      _native_ellipse_outline(cx, cy, rx, ry, c.r, c.g, c.b, a, width)
pub fn draw_ellipse_outline(center, rx, ry, c)
  _native_ellipse_outline(center.x, center.y, rx, ry, c.r, c.g, c.b)
# Also positionally the mixed `(cx, cy, rx, ry, c)`.
pub fn draw_ellipse_outline(center, rx, ry, c, a)
  if _is_num(center) then
    _native_ellipse_outline(center, rx, ry, c, a.r, a.g, a.b)
  else
    _native_ellipse_outline(center.x, center.y, rx, ry, c.r, c.g, c.b, a)
# Also positionally the mixed `(cx, cy, rx, ry, c, a)`.
pub fn draw_ellipse_outline(center, rx, ry, c, a = 255, width = 1)
  if _is_num(center) then
    _native_ellipse_outline(center, rx, ry, c, a.r, a.g, a.b, width)
  else
    _native_ellipse_outline(center.x, center.y, rx, ry, c.r, c.g, c.b, a, width)

@doc("""
A filled ring segment, between radii `r_in` and `r_out` and angles `a0` to
`a1`: a pie slice (`r_in` 0), a gauge, a progress ring.
""",
  params: {a0: "The start angle, in radians clockwise from +x.", a1: "The end angle."},
  example: """fill_arc({x: 60, y: 60}, 20, 28, 0.0, PI * frac * 2.0, :3c8cff)""")
pub fn fill_arc(cx, cy, r_in, r_out, a0, a1, r, g, b, a = 255)
  _native_arc(cx, cy, r_in, r_out, a0, a1, r, g, b, a)
