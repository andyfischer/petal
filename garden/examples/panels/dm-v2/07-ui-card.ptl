// ── Drag mode 7: a settings card from the ui helpers ─────
//   garden petal-ide examples/panels/dm-v2/07-ui-card.ptl
//
// A card built with the `ui` package's `pad`, `cut_top`,
// `vstack`, `button` and `progress_bar`. Every rectangle is
// computed by library code (the bundled prelude, never
// edited), so every edit lands in this file's few numbers.
//
// What to drag (drag mode on: Cmd+Shift+D):
// - The CARD, anywhere: `panel`'s x / y (literals inside a
//   record). The panel lists the library numbers it saw as
//   "in library code (never edited)".
// - A BUTTON's outline, down: `header_h` (the rows start
//   lower) or the card's y; the second button down alone is
//   `row_gap`.
// - The "Settings" title: it sits at the header cut, so it
//   moves with `inset` or the card.
// - Mark `inset` rigid from its gutter square and drag a
//   button sideways: the card moves instead.

import ui

let panel = {x: 20, y: 20, w: 320, h: 240}
let inset = 12
let header_h = 28
let row_gap = 8

let inner = pad(panel, inset)
let head = cut_top(inner, header_h)
let rows = vstack(head.rest, 4, row_gap)

clear(11, 13, 18)
card(panel)
draw_text("Settings", head.cut.x, head.cut.y + 6, 16, 232, 236, 248)
button(rows[0], "Sync now")
button(rows[1], "Sign out")
progress_bar(rows[2], 0.6)
draw_text("Storage 60%", rows[3].x, rows[3].y + 4, 12, 160, 168, 184)
