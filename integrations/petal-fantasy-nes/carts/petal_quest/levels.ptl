// ── World 3 — Sky Castle ──────────────────────────────────────────────────
// Long falls and three enemy types at once, then two chunks of flat arena at
// the end. The arena has no walls of its own: the camera stops at the map edge
// and `game.ptl` fences the hero in, which is cheaper and never traps him
// inside a tile. Its roof is a lip at each end and open down the middle, so a
// respawn dropped in from above lands on the floor and not on the roof.

let L3_0 = [
  SKY, SKY, SKY, SKY, SKY,
  "..().......()...",
  SKY, SKY, SKY, SKY, SKY, SKY, SKY,
  SKY, SKY, SKY, SKY, SKY,
  "...,........,...",
  "...@............",
  GND,
  FILL, FILL, FILL, FILL, FILL
]

