// ── Thicket ─────────────────────────────────────────────────────────────────
// A todo app. A rail of lists on the left, a date-grouped task feed in the
// middle with an inline composer, and an inspector on the right with notes and
// a subtask checklist.
//
// Exercises: full CRUD over a record store (create through a parsed composer
// line, read/filter/group, update title / priority / due / done / subtasks,
// delete with undo), multi-axis filtering (list + status + text search),
// pixel-scrolled variable-height rows, three focusable text fields, and a
// revision counter standing in for autosave.
//
// Designed for a 1280x850 panel.

// ── palette ─────────────────────────────────────────────────────────────────
let BG      = #10131a   // feed ground
let RAIL    = #0b0e14   // left rail, one step darker
let SURFACE = #151922   // right inspector
let CARD    = #1a1f2a
let CARD_HI = #222836
let LINE    = #262d3a
let SOFT    = #1d2330
let TEXT    = #e9edf4
let DIM     = #98a3b4
let FAINT   = #5f6b7c
let GHOST   = #414c5c
let AMBER   = #f0a44b   // accent
let GREEN   = #56c08d
let RED     = #e8637d
let BLUE    = #6ba7f5
let VIOLET  = #a98cf0
let TEAL    = #3fc2bd
let INK     = #0b0e14

// ── metrics ─────────────────────────────────────────────────────────────────
let W = screen_width()
let H = screen_height()

let RAIL_W   = 234
let DETAIL_W = 354
let MX       = RAIL_W                  // main column left edge
let MAIN_W   = W - RAIL_W - DETAIL_W
let DX0      = W - DETAIL_W
let TOP_H    = 66

let ROW_H  = 58
let HDR_H  = 34
let GAP_H  = 10

let FS_MICRO = 10
let FS_LABEL = 11
let FS_SM    = 12
let FS       = 13
let FS_ROW   = 15
let FS_H     = 18
let FS_XL    = 22

let SOMEDAY = 9000

// ── seed data ───────────────────────────────────────────────────────────────
// `due` is whole days from today; SOMEDAY means unscheduled.
// `prio` is 0 none / 1 low / 2 medium / 3 high.
state tasks = [
  {id: 1,  title: "Send the Q3 roadmap deck to Priya", list: "Product", done: false, prio: 3, due: -2,
    notes: "She only needs the three headline bets, not the appendix. Cut slides 9-14 before sending.",
    subs: [{t: "Trim appendix", done: true}, {t: "Re-render the timeline", done: false}, {t: "Ask Dan for the churn number", done: false}], age: 6},
  {id: 2,  title: "Renew the domain before it lapses", list: "Errands", done: false, prio: 3, due: -1,
    notes: "Auto-renew was turned off after the card expired. Two-year term is cheaper.",
    subs: [], age: 11},
  {id: 3,  title: "Review Wes's pull request on the parser", list: "Product", done: false, prio: 2, due: 0,
    notes: "Big one — 40 files. Focus on the error recovery path; the rest is mechanical renaming.",
    subs: [{t: "Read the design note first", done: true}, {t: "Run the fuzzer overnight", done: false}], age: 2},
  {id: 4,  title: "Water the fig tree", list: "Home", done: false, prio: 1, due: 0,
    notes: "Every four days in summer. It drops leaves when it is thirsty and sulks for a fortnight after.",
    subs: [], age: 1},
  {id: 5,  title: "Book the dentist for the cracked filling", list: "Errands", done: false, prio: 2, due: 0,
    notes: "Dr Okafor's office takes calls after 9am. Ask whether the old crown is still under warranty.",
    subs: [], age: 4},
  {id: 6,  title: "Write the release notes for 0.14", list: "Product", done: false, prio: 2, due: 1,
    notes: "Lead with the panel runtime. The migration section matters more than the feature list — three people asked about it already.",
    subs: [{t: "Draft the migration section", done: false}, {t: "Collect the contributor list", done: false}, {t: "Screenshot the new inspector", done: false}], age: 3},
  {id: 7,  title: "Call the bank about the duplicate charge", list: "Errands", done: false, prio: 2, due: 2,
    notes: "Transaction on the 3rd, posted twice. Reference number is in the statement PDF.",
    subs: [], age: 5},
  {id: 8,  title: "Replace the kitchen tap washer", list: "Home", done: false, prio: 1, due: 3,
    notes: "Half-inch fibre washer. The hardware shop on Mercer has them loose rather than in a kit of forty.",
    subs: [{t: "Measure the old one", done: true}], age: 9},
  {id: 9,  title: "Draft the hiring loop for the compiler role", list: "Product", done: false, prio: 3, due: 4,
    notes: "Four stages, no take-home longer than two hours. Borrow the debugging exercise from the platform loop.",
    subs: [{t: "Write the phone screen rubric", done: false}, {t: "Pick the pairing problem", done: false}], age: 8},
  {id: 10, title: "Finish 'The Overstory'", list: "Reading", done: false, prio: 1, due: 6,
    notes: "About two hundred pages left. The middle section is slow but the last third reportedly pays it back.",
    subs: [], age: 34},
  {id: 11, title: "Sketch the onboarding empty states", list: "Product", done: false, prio: 2, due: 9,
    notes: "Three of them: no projects, no tasks in a project, and search with no hits. Each needs one sentence and one action.",
    subs: [{t: "No projects", done: false}, {t: "Empty project", done: false}, {t: "No search results", done: false}], age: 7},
  {id: 12, title: "Service the bike before the spring ride", list: "Errands", done: false, prio: 1, due: 12,
    notes: "New chain, both brake pads, and true the rear wheel. Drop it off on a Tuesday — they are quiet then.",
    subs: [], age: 20},
  {id: 13, title: "Re-pot the monstera into the tall planter", list: "Home", done: false, prio: 1, due: 18,
    notes: "It has been root-bound since autumn. Needs bark-heavy mix, not the dense potting soil.",
    subs: [], age: 26},
  {id: 14, title: "Read the incremental computation paper", list: "Reading", done: false, prio: 2, due: 21,
    notes: "Adapton. Two colleagues have now recommended it in the same week, which is usually a signal.",
    subs: [], age: 15},
  {id: 15, title: "Plan the summer trip to the coast", list: "Home", done: false, prio: 1, due: 40,
    notes: "Late June, four nights. The cottage with the bad wifi and the good porch, if it is still listed.",
    subs: [{t: "Check the ferry timetable", done: false}], age: 30},
  {id: 16, title: "Learn enough Rust macros to stop copying code", list: "Reading", done: false, prio: 1, due: SOMEDAY,
    notes: "The little book of macros, then rewrite the four hand-expanded builder impls in the render crate.",
    subs: [], age: 60},
  {id: 17, title: "Digitise the box of family photographs", list: "Home", done: false, prio: 0, due: SOMEDAY,
    notes: "Roughly six hundred prints. Borrow the flatbed scanner rather than buying one for a weekend of work.",
    subs: [], age: 120},
  {id: 18, title: "Write up the panel runtime post-mortem", list: "Product", done: false, prio: 1, due: SOMEDAY,
    notes: "What the sleep/wake heuristic cost us, and why the immediate-mode pass was still the right call.",
    subs: [], age: 45},
  {id: 19, title: "Ship the debug-server input endpoints", list: "Product", done: true, prio: 3, due: -4,
    notes: "Key, text and mouse injection all land through the same dispatch as real input.",
    subs: [{t: "Key injection", done: true}, {t: "Mouse drag", done: true}], age: 12},
  {id: 20, title: "Return the library books", list: "Errands", done: true, prio: 2, due: -3,
    notes: "Two of the three were already overdue. The fine was smaller than expected.",
    subs: [], age: 14},
  {id: 21, title: "Fix the flickering hallway light", list: "Home", done: true, prio: 2, due: -1,
    notes: "It was the starter, not the tube. Kept the spare tube for the garage fitting.",
    subs: [], age: 10},
  {id: 22, title: "Reply to Ingrid about the workshop", list: "Product", done: true, prio: 1, due: 0,
    notes: "Said yes to the March slot, ninety minutes, hands-on rather than a talk.",
    subs: [], age: 3},
]

// ── view state ──────────────────────────────────────────────────────────────
state lst      = "All"        // list filter: "All" or a project name
state status   = "Active"     // Active | Done | All
state q        = ""           // search query
state sel_id   = 1            // selected task id
state scroll   = 0            // pixel scroll offset of the feed
state focus    = ""           // "" | compose | search | title
state compose  = ""           // composer buffer
state ed_title = ""           // inline title editor buffer
state next_id  = 23
state rev      = 0            // "autosave" revision — every mutation bumps it
state trash    = []           // deleted tasks, newest last (undo stack)
state completed_today = 2

let PROJECTS = ["Product", "Home", "Errands", "Reading"]

fn list_color(name)
  match name
    when "Product" -> BLUE
    when "Home" -> GREEN
    when "Errands" -> AMBER
    when "Reading" -> VIOLET
    when _ -> TEAL
  end
end

// ── small helpers ───────────────────────────────────────────────────────────
fn prio_color(p)
  if p == 3 then RED
  elsif p == 2 then AMBER
  elsif p == 1 then BLUE
  else GHOST
  end
end

fn prio_name(p)
  if p == 3 then "High"
  elsif p == 2 then "Medium"
  elsif p == 1 then "Low"
  else "None"
  end
end

fn due_label(d)
  if d >= SOMEDAY then "someday"
  elsif d < -1 then "{-d} days late"
  elsif d == -1 then "yesterday"
  elsif d == 0 then "today"
  elsif d == 1 then "tomorrow"
  elsif d < 7 then "in {d} days"
  elsif d < 14 then "next week"
  elsif d < 60 then "in {int(d / 7)} weeks"
  else "in {int(d / 30)} months"
  end
end

fn due_color(d, done)
  if done then FAINT
  elsif d >= SOMEDAY then GHOST
  elsif d < 0 then RED
  elsif d == 0 then AMBER
  elsif d <= 3 then DIM
  else FAINT
  end
end

fn ago(d)
  if d == 0 then "today"
  elsif d == 1 then "yesterday"
  elsif d < 7 then "{d}d ago"
  elsif d < 60 then "{int(d / 7)}w ago"
  else "{int(d / 30)}mo ago"
  end
end

fn group_key(t)
  if t.done then "done"
  elsif t.due < 0 then "over"
  elsif t.due == 0 then "today"
  elsif t.due <= 7 then "soon"
  elsif t.due < SOMEDAY then "later"
  else "someday"
  end
end

fn group_label(k)
  match k
    when "over" -> "OVERDUE"
    when "today" -> "TODAY"
    when "soon" -> "NEXT SEVEN DAYS"
    when "later" -> "LATER"
    when "someday" -> "SOMEDAY"
    when _ -> "COMPLETED"
  end
end

fn group_color(k)
  match k
    when "over" -> RED
    when "today" -> AMBER
    when "soon" -> BLUE
    when "done" -> GREEN
    when _ -> FAINT
  end
end

fn subs_done(t)
  var n = 0
  for s in t.subs do
    if s.done then set n = n + 1 end
  end
  n
end

fn stroke(a, b, c, alpha, width)
  draw_line(a.x, a.y, b.x, b.y, c.r, c.g, c.b, alpha, width)
end

// A rounded panel with a hairline border (draw_rect_outline is square-cornered).
fn rr(r, radius, fill, border)
  draw_rect_rounded(r, radius, border)
  draw_rect_rounded(rect(r.x + 1, r.y + 1, r.w - 2, r.h - 2), radius - 1, fill)
end

fn chip(x, y, label, c, strong)
  let tw = text_width(label, FS_MICRO)
  let r = rect(x, y, tw + 16, 19)
  draw_rect_rounded(r, 9, c, if strong then 46 else 26 end)
  draw_text(label, {x: x + 8, y: y + 4}, {size: FS_MICRO, color: c, spacing: 0.4})
  r.w
end

fn checkbox(cx, cy, done, hot)
  if done then
    draw_circle({x: cx, y: cy}, 10, GREEN)
    stroke({x: cx - 4.5, y: cy}, {x: cx - 1, y: cy + 3.5}, INK, 255, 2)
    stroke({x: cx - 1, y: cy + 3.5}, {x: cx + 5, y: cy - 3.5}, INK, 255, 2)
  else
    let c = if hot then GREEN else GHOST end
    draw_circle({x: cx, y: cy}, 10, c, if hot then 200 else 130 end)
    draw_circle({x: cx, y: cy}, 8.5, if hot then #16202a else BG end)
    if hot then
      stroke({x: cx - 4.5, y: cy}, {x: cx - 1, y: cy + 3.5}, GREEN, 150, 2)
      stroke({x: cx - 1, y: cy + 3.5}, {x: cx + 5, y: cy - 3.5}, GREEN, 150, 2)
    end
  end
end

// A capsule button. kind 0 = quiet, 1 = primary, 2 = danger-quiet.
fn btn(r, label, kind, enabled)
  let hov = hovered(r) && enabled
  if kind == 1 then
    let bg = if hov then #ffb765 else AMBER end
    draw_rect_rounded(r, r.h / 2, bg, if enabled then 255 else 90 end)
    draw_text_center(label, r.x + r.w / 2, r.y + (r.h - FS) / 2, FS, INK)
  else
    let base = if kind == 2 then RED else DIM end
    rr(r, r.h / 2, if hov then CARD_HI else CARD end, LINE)
    let fg = if !enabled then GHOST elsif hov then base else DIM end
    draw_text_center(label, r.x + r.w / 2, r.y + (r.h - FS) / 2, FS, fg)
  end
  hov && mouse_pressed(0)
end

// ── composer parsing ────────────────────────────────────────────────────────
// "!! Ring the vet @tomorrow" -> {title: "Ring the vet", prio: 3, due: 1}
fn parse_line(s, dflt_list)
  var prio = 1
  var due = 0
  var kept = []
  var target = dflt_list
  for w in split(s, " ") do
    if len(w) == 0 then
      continue
    elsif w == "!" then
      set prio = 2
    elsif w == "!!" then
      set prio = 3
    elsif w == "@today" then
      set due = 0
    elsif w == "@tomorrow" then
      set due = 1
    elsif w == "@week" then
      set due = 7
    elsif w == "@someday" then
      set due = SOMEDAY
    else
      var matched = false
      for p in PROJECTS do
        if !matched && w == "#" ++ lower(p) then
          set target = p
          set matched = true
        end
      end
      if !matched then
        set kept = append(kept, w)
      end
    end
  end
  {title: join(kept, " "), prio: prio, due: due, list: target}
end

// ── sorting ─────────────────────────────────────────────────────────────────
fn task_less(a, b)
  if a.prio != b.prio then
    a.prio > b.prio
  elsif a.due != b.due then
    a.due < b.due
  else
    a.id < b.id
  end
end

fn sort_tasks(ts)
  var out = []
  for t in ts do
    var placed = false
    var res = []
    for x in out do
      if !placed && task_less(t, x) then
        set res = append(res, t)
        set placed = true
      end
      set res = append(res, x)
    end
    if !placed then set res = append(res, t) end
    set out = res
  end
  out
end

fn matches(t, needle)
  contains(lower("{t.title} {t.list} {t.notes}"), needle)
end

fn count_open(ts, name)
  var n = 0
  for t in ts do
    if !t.done && (name == "All" || t.list == name) then set n = n + 1 end
  end
  n
end

fn find_by_id(ts, id)
  var found = -1
  for i in range(0, len(ts)) do
    if ts[i].id == id then set found = i end
  end
  found
end

// ── derived: filter, group, lay out ─────────────────────────────────────────
let needle = lower(q)
let scoped = for t in tasks do
  if lst != "All" && t.list != lst then continue end
  if status == "Active" && t.done then continue end
  if status == "Done" && !t.done then continue end
  if len(needle) > 0 && !matches(t, needle) then continue end
  t
end

let GROUPS = ["over", "today", "soon", "later", "someday", "done"]

// The feed is a flat list of display items with pixel offsets, so header rows
// and task rows can have different heights and one scroll offset covers both.
let items = []
let feed_h = 0
for gk in GROUPS do
  let members = sort_tasks(for t in scoped do
    if group_key(t) != gk then continue end
    t
  end)
  if len(members) > 0 then
    items = append(items, {kind: "h", key: gk, y: feed_h + GAP_H, h: HDR_H, n: len(members), task: nil})
    feed_h = feed_h + GAP_H + HDR_H
    for t in members do
      items = append(items, {kind: "t", key: gk, y: feed_h, h: ROW_H, n: 0, task: t})
      feed_h = feed_h + ROW_H
    end
  end
end
feed_h = feed_h + 16

// Task ids in display order — the keyboard walks this.
let order = for it in items do
  if it.kind != "t" then continue end
  it.task.id
end
let n_shown = len(order)

// ── geometry ────────────────────────────────────────────────────────────────
let mx = mouse_x()
let my = mouse_y()

let search_r  = rect(W - DETAIL_W - 286, 17, 262, 32)
let comp_r    = rect(MX + 22, TOP_H + 16, MAIN_W - 44, 44)
let seg_y     = TOP_H + 76
let FEED_TOP  = seg_y + 44
let FEED_H    = H - FEED_TOP - 14
let feed_r    = rect(MX, FEED_TOP, MAIN_W, FEED_H)
let feed_x    = MX + 22
let feed_w    = MAIN_W - 44 - 6

let SEGS = ["Active", "Done", "All"]
fn seg_rect(i)
  rect(MX + 22 + i * 76, seg_y, 70, 28)
end

let rail_top = 108
fn rail_rect(i)
  rect(12, rail_top + i * 36, RAIL_W - 24, 32)
end

let dpad = 24
let dx = DX0 + dpad
let dw = DETAIL_W - dpad * 2
let act_y = H - 66
let act_w = int((dw - 10) / 2)
let act1 = rect(dx, act_y, act_w, 36)
let act2 = rect(dx + act_w + 10, act_y, dw - act_w - 10, 36)

fn prio_pick_rect(i, x, y, w)
  let cw = int((w - 18) / 4)
  rect(x + i * (cw + 6), y, cw, 26)
end

fn sub_rect(i, x, y, w)
  rect(x, y + i * 26, w, 24)
end

// ── input ───────────────────────────────────────────────────────────────────
// `grabbed` suppresses this frame's text so the keystroke that moved focus is
// not also typed into the field it just landed on.
let grabbed = false
let sel_ix = find_by_id(tasks, sel_id)
let selected = if sel_ix >= 0 then tasks[sel_ix] else nil end
let has_sel = sel_ix >= 0

// Focus by click.
if mouse_pressed(0) then
  if point_in(mx, my, search_r) then
    focus = "search"
    grabbed = true
  elsif point_in(mx, my, comp_r) then
    focus = "compose"
    grabbed = true
  elsif !point_in(mx, my, rect(DX0, 0, DETAIL_W, H)) then
    focus = ""
  end
end

// Keyboard shortcuts, only while no text field owns the keyboard.
let typing = len(focus) > 0
if !typing then
  if key_pressed("n") then
    focus = "compose"
    grabbed = true
  end
  if key_pressed("/") then
    focus = "search"
    grabbed = true
  end
end

// Rail: switch list.
if mouse_pressed(0) then
  for i in range(0, len(PROJECTS) + 1) do
    let name = if i == 0 then "All" else PROJECTS[i - 1] end
    if point_in(mx, my, rail_rect(i)) then
      lst = name
      scroll = 0
    end
  end
end

// Status segments.
if mouse_pressed(0) then
  for i in range(0, len(SEGS)) do
    if point_in(mx, my, seg_rect(i)) then
      status = SEGS[i]
      scroll = 0
    end
  end
end

// Feed: click a row to select, click its checkbox to toggle done.
let toggled = -1
if mouse_pressed(0) && point_in(mx, my, feed_r) then
  for it in items do
    if it.kind == "t" then
      let ry = FEED_TOP + it.y - scroll
      if my >= ry && my < ry + ROW_H then
        sel_id = it.task.id
        if mx < feed_x + 48 then
          toggled = it.task.id
        end
        focus = ""
      end
    end
  end
end

// Wheel over the feed.
if point_in(mx, my, feed_r) then
  scroll = scroll - scroll_y() * 44
end

// Keyboard navigation over the display order.
let want_ix = -1
state last_ix = 0
if !typing && n_shown > 0 then
  var cur = -1
  for i in range(0, n_shown) do
    if order[i] == sel_id then set cur = i end
  end
  var w2 = cur
  if cur < 0 then
    // The selected task just left this view (completed, or filtered out), so
    // the selection lands on whichever row took its place rather than on the
    // top of the feed — and this frame's keys are spent doing only that.
    set w2 = int(clamp(last_ix, 0, n_shown - 1))
  else
    if key_pressed("down") || key_pressed("j") then set w2 = w2 + 1 end
    if key_pressed("up") || key_pressed("k") then set w2 = w2 - 1 end
    if key_pressed("pagedown") then set w2 = w2 + 5 end
    if key_pressed("pageup") then set w2 = w2 - 5 end
    if key_pressed("home") then set w2 = 0 end
    if key_pressed("end") then set w2 = n_shown - 1 end
  end
  if w2 != cur then
    want_ix = int(clamp(w2, 0, n_shown - 1))
    sel_id = order[want_ix]
  end
end

for i in range(0, n_shown) do
  if order[i] == sel_id then last_ix = i end
end

// Keep the keyboard selection inside the viewport.
if want_ix >= 0 then
  for it in items do
    if it.kind == "t" && it.task.id == sel_id then
      scroll = ensure_visible_px(scroll, it.y, ROW_H, FEED_H)
    end
  end
end
scroll = int(clamp(scroll, 0, max(0, feed_h - FEED_H)))

// ── mutations ───────────────────────────────────────────────────────────────
// Every write to `tasks` bumps `rev`, which the rail reports as the autosave
// revision — the app's stand-in for a store commit.
let space_toggle = !typing && (key_pressed("space") || key_pressed("x"))
// The inspector's primary button is the third way to flip `done`; all three
// land in the one mutation below so the "done today" tally stays honest.
let act_click = has_sel && mouse_pressed(0) && point_in(mx, my, act1)
let do_toggle = toggled >= 0 || ((space_toggle || act_click) && has_sel)
let toggle_id = if toggled >= 0 then toggled else sel_id end

if do_toggle then
  tasks = for t in tasks do
    if t.id == toggle_id then {...t, done: !t.done} else t end
  end
  let ti = find_by_id(tasks, toggle_id)
  if ti >= 0 && tasks[ti].done then
    completed_today = completed_today + 1
  elsif completed_today > 0 then
    completed_today = completed_today - 1
  end
  rev = rev + 1
end

// Priority: keys 0-3, or the four chips in the inspector.
let set_prio = -1
if !typing && has_sel then
  if key_pressed("0") then set_prio = 0 end
  if key_pressed("1") then set_prio = 1 end
  if key_pressed("2") then set_prio = 2 end
  if key_pressed("3") then set_prio = 3 end
end
state prio_row_y = 0
if has_sel && mouse_pressed(0) then
  for i in range(0, 4) do
    if point_in(mx, my, prio_pick_rect(i, dx, prio_row_y, dw)) then
      set_prio = i
    end
  end
end
if set_prio >= 0 then
  tasks = for t in tasks do
    if t.id == sel_id then {...t, prio: set_prio} else t end
  end
  rev = rev + 1
end

// Due date nudging: "," pulls a task a day earlier, "." pushes it a day later.
let nudge = if !typing && has_sel && key_pressed(",") then -1
elsif !typing && has_sel && key_pressed(".") then 1
else 0
end
if nudge != 0 then
  tasks = for t in tasks do
    if t.id == sel_id && t.due < SOMEDAY then
      {...t, due: max(-30, min(SOMEDAY - 1, t.due + nudge))}
    elsif t.id == sel_id then
      {...t, due: 0}
    else
      t
    end
  end
  rev = rev + 1
end

// Subtask toggling.
state sub_row_y = 0
let sub_hit = -1
if has_sel && mouse_pressed(0) then
  for i in range(0, len(selected.subs)) do
    if point_in(mx, my, sub_rect(i, dx, sub_row_y, dw)) then
      sub_hit = i
    end
  end
end
if sub_hit >= 0 then
  tasks = for t in tasks do
    if t.id == sel_id then
      {...t, subs: for j in range(0, len(t.subs)) do
        if j == sub_hit then {...t.subs[j], done: !t.subs[j].done} else t.subs[j] end
      end}
    else
      t
    end
  end
  rev = rev + 1
end

// ── text fields ─────────────────────────────────────────────────────────────
let typed = if grabbed then "" else text_input() end
let backsp = key_pressed("backspace")
let submitted = key_pressed("return")

fn edited(cur, t, bs)
  var s = cur
  if bs && len(s) > 0 then set s = slice(s, 0, len(s) - 1) end
  if len(t) > 0 then set s = s ++ t end
  s
end

if focus == "compose" then compose = edited(compose, typed, backsp) end
if focus == "search" then q = edited(q, typed, backsp) end
if focus == "title" then ed_title = edited(ed_title, typed, backsp) end

// Create.
let parsed = parse_line(compose, if lst == "All" then "Product" else lst end)
if focus == "compose" && submitted && len(parsed.title) > 0 then
  tasks = append(tasks, {id: next_id, title: parsed.title, list: parsed.list, done: false,
    prio: parsed.prio, due: parsed.due, notes: "", subs: [], age: 0})
  sel_id = next_id
  next_id = next_id + 1
  compose = ""
  rev = rev + 1
end

// Rename (commit the inline title editor).
if focus == "title" && submitted then
  if len(ed_title) > 0 then
    tasks = for t in tasks do
      if t.id == sel_id then {...t, title: ed_title} else t end
    end
    rev = rev + 1
  end
  focus = ""
end

// Start renaming: "e", or a click on the inspector's title block.
let title_r = rect(dx, 96, dw, 58)
if !typing && has_sel && key_pressed("e") then
  focus = "title"
  ed_title = selected.title
  grabbed = true
end
if has_sel && focus != "title" && mouse_pressed(0) && point_in(mx, my, title_r) then
  focus = "title"
  ed_title = selected.title
  grabbed = true
end

// ── delete + undo ───────────────────────────────────────────────────────────
let del_click = has_sel && mouse_pressed(0) && point_in(mx, my, act2)
let do_delete = has_sel && (del_click || (!typing && (key_pressed("d") || key_pressed("delete"))))
if do_delete then
  trash = append(trash, selected)
  let gone_ix = find_by_id(tasks, sel_id)
  tasks = for t in tasks do
    if t.id == sel_id then continue end
    t
  end
  // Hand the selection to the neighbour that took the deleted row's place.
  if len(tasks) > 0 then
    sel_id = tasks[int(clamp(gone_ix, 0, len(tasks) - 1))].id
  end
  rev = rev + 1
end

let undo_key = !typing && key_pressed("u") && len(trash) > 0
if undo_key then
  let back = trash[len(trash) - 1]
  tasks = append(tasks, back)
  trash = slice(trash, 0, len(trash) - 1)
  sel_id = back.id
  rev = rev + 1
end

// Escape unwinds: focus, then the search box, then nothing.
if key_pressed("escape") then
  if len(focus) > 0 then
    focus = ""
  elsif len(q) > 0 then
    q = ""
  end
end

// Tab cycles the two persistent fields.
if key_pressed("tab") then
  focus = if focus == "compose" then "search" else "compose" end
  grabbed = true
end

let sel2 = find_by_id(tasks, sel_id)
let cur = if sel2 >= 0 then tasks[sel2] else nil end
let have = sel2 >= 0

// ═════════════════════════════════════════════════════════════════════════════
// Draw
// ═════════════════════════════════════════════════════════════════════════════
clear(BG.r, BG.g, BG.b)

// ── left rail ───────────────────────────────────────────────────────────────
draw_rect(rect(0, 0, RAIL_W, H), RAIL)
draw_rect(rect(RAIL_W, 0, 1, H), LINE)

// brand mark: three stacked leaves
draw_rect_rounded(rect(24, 20, 24, 24), 7, AMBER)
draw_circle({x: 36, y: 29}, 4.5, INK)
stroke({x: 36, y: 29}, {x: 36, y: 38}, INK, 255, 2)
draw_text("thicket", {x: 58, y: 23}, {size: FS_H, color: TEXT, spacing: 0.3})

draw_text("LISTS", {x: 24, y: rail_top - 26}, {size: FS_MICRO, color: FAINT, spacing: 1.6})

for i in range(0, len(PROJECTS) + 1) do
  let name = if i == 0 then "All" else PROJECTS[i - 1] end
  let r = rail_rect(i)
  let on = lst == name
  let hov = point_in(mx, my, r)
  if on then
    draw_rect_rounded(r, 9, CARD_HI)
    draw_rect_rounded(rect(r.x, r.y + 7, 3, r.h - 14), 2, AMBER)
  elsif hov then
    draw_rect_rounded(r, 9, CARD, 150)
  end
  let dot = if i == 0 then FAINT else list_color(name) end
  draw_circle({x: r.x + 20, y: r.y + 16}, 4, dot)
  let label = if i == 0 then "All tasks" else name end
  draw_text(label, {x: r.x + 34, y: r.y + 9}, {size: FS, color: if on then TEXT else DIM end})
  let n = count_open(tasks, name)
  if n > 0 then
    draw_text_right("{n}", r.x + r.w - 14, r.y + 9, FS_SM, if on then DIM else GHOST end)
  end
end

// today card
let card_y = H - 196
rr(rect(12, card_y, RAIL_W - 24, 108), 12, CARD, LINE)
draw_text("DONE TODAY", {x: 26, y: card_y + 16}, {size: FS_MICRO, color: FAINT, spacing: 1.4})
draw_text("{completed_today}", {x: 26, y: card_y + 34}, {size: FS_XL, color: GREEN})
let open_now = count_open(tasks, lst)
let total_now = completed_today + open_now
draw_text_right("{open_now} left", RAIL_W - 26, card_y + 42, FS_SM, DIM)
let bar = rect(26, card_y + 74, RAIL_W - 52, 6)
draw_rect_rounded(bar, 3, SOFT)
if total_now > 0 then
  let fw = int(bar.w * completed_today / total_now)
  if fw > 3 then
    draw_rect_rounded(rect(bar.x, bar.y, fw, bar.h), 3, GREEN)
  end
end
draw_text("in {if lst == "All" then "every list" else lst end}", {x: 26, y: card_y + 88}, {size: FS_MICRO, color: GHOST})

// autosave line
draw_circle({x: 27, y: H - 60}, 3.5, GREEN, 220)
draw_text("autosaved · rev {rev}", {x: 38, y: H - 66}, {size: FS_MICRO, color: FAINT})
let trash_note = if len(trash) > 0 then "{len(trash)} in trash · u to undo" else "trash empty" end
draw_text(trash_note, {x: 38, y: H - 50}, {size: FS_MICRO, color: GHOST})

// ── top bar ─────────────────────────────────────────────────────────────────
let head = if lst == "All" then "All tasks" else lst end
draw_text(head, {x: MX + 22, y: 21}, {size: FS_XL, color: TEXT})
draw_text("{n_shown}", {x: MX + 26 + text_width(head, FS_XL), y: 27}, {size: FS, color: GHOST})

// search box
let q_on = focus == "search"
rr(search_r, 9, if q_on then #0d1118 else CARD end, if q_on then AMBER else LINE end)
let sc = if q_on then AMBER else FAINT end
draw_circle({x: search_r.x + 18, y: search_r.y + 14}, 5.5, sc)
draw_circle({x: search_r.x + 18, y: search_r.y + 14}, 3.6, if q_on then #0d1118 else CARD end)
draw_line({x: search_r.x + 22, y: search_r.y + 18}, {x: search_r.x + 26, y: search_r.y + 22}, sc)
let qx = search_r.x + 36
if len(q) == 0 && !q_on then
  draw_text("Search tasks and notes", {x: qx, y: search_r.y + 9}, {size: FS, color: GHOST})
  draw_text("/", {x: search_r.x + search_r.w - 16, y: search_r.y + 9}, {size: FS_SM, color: GHOST})
else
  draw_text(ellipsize(q, search_r.w - 52, FS), {x: qx, y: search_r.y + 9}, {size: FS, color: TEXT})
end
if q_on && int(time() * 2) % 2 == 0 then
  draw_line({x: qx + text_width(q, FS) + 1, y: search_r.y + 8},
    {x: qx + text_width(q, FS) + 1, y: search_r.y + 24}, AMBER)
end

draw_rect(rect(MX, TOP_H, MAIN_W, 1), LINE)

// ── composer ────────────────────────────────────────────────────────────────
let c_on = focus == "compose"
rr(comp_r, 12, if c_on then #0d1118 else SOFT end, if c_on then AMBER else LINE end)
let plus_c = if c_on then AMBER else FAINT end
draw_circle({x: comp_r.x + 26, y: comp_r.y + 22}, 9, plus_c, 40)
stroke({x: comp_r.x + 21, y: comp_r.y + 22}, {x: comp_r.x + 31, y: comp_r.y + 22}, plus_c, 255, 1.6)
stroke({x: comp_r.x + 26, y: comp_r.y + 17}, {x: comp_r.x + 26, y: comp_r.y + 27}, plus_c, 255, 1.6)
let cx0 = comp_r.x + 46
if len(compose) == 0 then
  draw_text("Add a task…", {x: cx0, y: comp_r.y + 14}, {size: FS_ROW, color: if c_on then GHOST else FAINT end})
  if !c_on then
    draw_text_right("press n", comp_r.x + comp_r.w - 18, comp_r.y + 16, FS_SM, GHOST)
  end
else
  draw_text(ellipsize(compose, comp_r.w - 200, FS_ROW), {x: cx0, y: comp_r.y + 13}, {size: FS_ROW, color: TEXT})
end
if c_on then
  if int(time() * 2) % 2 == 0 then
    let ccx = cx0 + text_width(compose, FS_ROW) + 2
    stroke({x: ccx, y: comp_r.y + 12}, {x: ccx, y: comp_r.y + 32}, AMBER, 255, 1.5)
  end
  // Live read-out of what the line will actually create.
  let hx = comp_r.x + comp_r.w - 14
  let dl = due_label(parsed.due)
  let hw = text_width(dl, FS_MICRO) + 16
  chip(hx - hw, comp_r.y + 13, dl, AMBER, false)
  let pw = text_width(parsed.list, FS_MICRO) + 16
  chip(hx - hw - pw - 6, comp_r.y + 13, parsed.list, list_color(parsed.list), false)
  if parsed.prio >= 2 then
    let sw = text_width(prio_name(parsed.prio), FS_MICRO) + 16
    chip(hx - hw - pw - sw - 12, comp_r.y + 13, prio_name(parsed.prio), prio_color(parsed.prio), false)
  end
end

// ── status segments ─────────────────────────────────────────────────────────
for i in range(0, len(SEGS)) do
  let r = seg_rect(i)
  let on = status == SEGS[i]
  let hov = point_in(mx, my, r)
  if on then
    draw_rect_rounded(r, 14, CARD_HI)
    draw_rect_rounded(r, 14, AMBER, 30)
  elsif hov then
    draw_rect_rounded(r, 14, CARD, 150)
  end
  draw_text_center(SEGS[i], r.x + r.w / 2, r.y + 7, FS_SM, if on then TEXT else FAINT end)
end
draw_text_right("!  !!  ·  @today @tomorrow @week @someday  ·  #product #home",
  MX + MAIN_W - 22, seg_y + 8, FS_MICRO, GHOST)

// ── feed ────────────────────────────────────────────────────────────────────
clip(MX, FEED_TOP, MAIN_W, FEED_H)
for it in items do
  let iy = FEED_TOP + it.y - scroll
  if iy > FEED_TOP + FEED_H || iy + it.h < FEED_TOP then
    continue
  end
  if it.kind == "h" then
    let gc = group_color(it.key)
    let lbl = group_label(it.key)
    draw_text(lbl, {x: feed_x, y: iy + 14}, {size: FS_MICRO, color: gc, spacing: 1.6})
    let lw = text_width(lbl, {size: FS_MICRO, spacing: 1.6})
    draw_text("{it.n}", {x: feed_x + lw + 10, y: iy + 14}, {size: FS_MICRO, color: GHOST})
    draw_line({x: feed_x + lw + 34, y: iy + 19}, {x: feed_x + feed_w, y: iy + 19}, LINE)
  else
    let t = it.task
    let r = rect(feed_x - 6, iy + 3, feed_w + 6, ROW_H - 8)
    let on = t.id == sel_id
    let hov = point_in(mx, my, r) && point_in(mx, my, feed_r)
    if on then
      draw_rect_rounded(r, 11, CARD_HI)
      draw_rect_rounded(rect(r.x, r.y + 10, 3, r.h - 20), 2, list_color(t.list))
    elsif hov then
      draw_rect_rounded(r, 11, CARD, 140)
    end

    let box_hot = hov && mx < feed_x + 48
    checkbox(feed_x + 22, iy + ROW_H / 2 - 1, t.done, box_hot)

    let tx = feed_x + 48
    let right_pad = 132
    let avail = feed_w - 48 - right_pad
    let tcol = if t.done then FAINT elsif on then #ffffff else TEXT end
    let title = ellipsize(t.title, avail, FS_ROW)
    let ty = iy + 12
    draw_text(title, {x: tx, y: ty}, {size: FS_ROW, color: tcol})
    if t.done then
      let sy = ty + 9
      stroke({x: tx, y: sy}, {x: tx + text_width(title, FS_ROW), y: sy}, FAINT, 190, 1)
    end

    // second line: list, subtask progress, note hint
    var meta = [t.list]
    if len(t.subs) > 0 then
      set meta = append(meta, "{subs_done(t)}/{len(t.subs)} steps")
    end
    if len(t.notes) > 0 then
      set meta = append(meta, "note")
    end
    draw_circle({x: tx + 4, y: iy + 38}, 3, list_color(t.list), if t.done then 120 else 235 end)
    draw_text(fit_parts(meta, avail - 16, FS_SM), {x: tx + 14, y: iy + 32},
      {size: FS_SM, color: if t.done then GHOST else FAINT end})

    // right edge: priority pip + due phrase
    let dcol = due_color(t.due, t.done)
    let dlbl = due_label(t.due)
    draw_text_right(dlbl, feed_x + feed_w - 8, iy + 20, FS_SM, dcol)
    if t.prio >= 2 && !t.done then
      let pc = prio_color(t.prio)
      let px = feed_x + feed_w - 8 - text_width(dlbl, FS_SM) - 16
      draw_rect_rounded(rect(px, iy + 20, 3, 12), 1.5, pc)
      if t.prio == 3 then
        draw_rect_rounded(rect(px - 6, iy + 20, 3, 12), 1.5, pc)
      end
    end
  end
end
clip_none()

// feed scrollbar
if feed_h > FEED_H then
  let track = rect(MX + MAIN_W - 8, FEED_TOP + 4, 4, FEED_H - 8)
  draw_rect_rounded(track, 2, SOFT)
  let th = max(28, int(track.h * FEED_H / feed_h))
  let ty2 = track.y + int((track.h - th) * scroll / max(1, feed_h - FEED_H))
  draw_rect_rounded(rect(track.x, ty2, track.w, th), 2, GHOST, 200)
end

// empty state
if n_shown == 0 then
  draw_text_center("Nothing here", MX + MAIN_W / 2, FEED_TOP + 92, FS_H, DIM)
  let hint = if len(q) > 0 then "No task matches “{q}”." else "This view is clear. Add one above." end
  draw_text_center(hint, MX + MAIN_W / 2, FEED_TOP + 120, FS, GHOST)
end

// ── inspector ───────────────────────────────────────────────────────────────
draw_rect(rect(DX0, 0, DETAIL_W, H), SURFACE)
draw_rect(rect(DX0, 0, 1, H), LINE)

if !have then
  draw_text("No task selected", {x: dx, y: 100}, {size: FS, color: GHOST})
else
  draw_text("TASK", {x: dx, y: 26}, {size: FS_MICRO, color: FAINT, spacing: 1.6})
  draw_text_right(ago(cur.age), DX0 + DETAIL_W - dpad, 25, FS_MICRO, GHOST)

  // title block, editable in place
  let editing_title = focus == "title"
  if editing_title then
    rr(rect(dx - 8, 92, dw + 16, 66), 10, #0d1118, AMBER)
  elsif point_in(mx, my, title_r) then
    draw_rect_rounded(rect(dx - 8, 92, dw + 16, 66), 10, CARD, 120)
  end
  let shown_title = if editing_title then ed_title else cur.title end
  let tcols = int(dw / max(1.0, text_width("m", FS_H)))
  let tlines = preview(shown_title, tcols, 2).lines
  for i in range(0, len(tlines)) do
    draw_text(tlines[i], {x: dx, y: 100 + i * 26}, {size: FS_H, color: if cur.done then DIM else TEXT end})
  end
  if editing_title then
    let last = tlines[len(tlines) - 1]
    let cxx = dx + text_width(last, FS_H) + 2
    if int(time() * 2) % 2 == 0 then
      stroke({x: cxx, y: 100 + (len(tlines) - 1) * 26}, {x: cxx, y: 122 + (len(tlines) - 1) * 26}, AMBER, 255, 1.5)
    end
    draw_text("return saves · esc cancels", {x: dx, y: 162}, {size: FS_MICRO, color: GHOST})
  else
    draw_text("click or press e to rename", {x: dx, y: 162}, {size: FS_MICRO, color: GHOST})
  end

  // status + list + due chips
  let chip_y = 188
  let sx = chip(dx, chip_y, if cur.done then "Completed" else "Open" end,
    if cur.done then GREEN else AMBER end, true)
  let lx2 = chip(dx + sx + 8, chip_y, cur.list, list_color(cur.list), true)
  chip(dx + sx + lx2 + 16, chip_y, due_label(cur.due), due_color(cur.due, cur.done), true)

  draw_line({x: dx, y: chip_y + 42}, {x: dx + dw, y: chip_y + 42}, LINE)

  // priority picker
  let py = chip_y + 62
  prio_row_y = py + 20
  draw_text("PRIORITY", {x: dx, y: py}, {size: FS_MICRO, color: FAINT, spacing: 1.4})
  draw_text_right("keys 0 – 3", dx + dw, py, FS_MICRO, GHOST)
  for i in range(0, 4) do
    let r = prio_pick_rect(i, dx, prio_row_y, dw)
    let on = cur.prio == i
    let c = prio_color(i)
    if on then
      draw_rect_rounded(r, 8, c, 52)
      draw_rect_rounded(rect(r.x, r.y, r.w, r.h), 8, c, 30)
    elsif point_in(mx, my, r) then
      draw_rect_rounded(r, 8, CARD_HI)
    else
      draw_rect_rounded(r, 8, CARD)
    end
    draw_text_center(prio_name(i), r.x + r.w / 2, r.y + 7, FS_MICRO, if on then c else FAINT end)
  end

  // due nudge hint
  let dy2 = prio_row_y + 46
  draw_text("SCHEDULE", {x: dx, y: dy2}, {size: FS_MICRO, color: FAINT, spacing: 1.4})
  draw_text_right("keys , and .", dx + dw, dy2, FS_MICRO, GHOST)
  draw_text(due_label(cur.due), {x: dx, y: dy2 + 18}, {size: FS, color: due_color(cur.due, cur.done)})

  // notes
  let ny = dy2 + 56
  draw_text("NOTES", {x: dx, y: ny}, {size: FS_MICRO, color: FAINT, spacing: 1.4})
  if len(cur.notes) == 0 then
    draw_text("No notes on this task.", {x: dx, y: ny + 20}, {size: FS, color: GHOST})
  else
    let ncols = int(dw / max(1.0, text_width("m", FS)))
    let nlines = preview(cur.notes, ncols, 5).lines
    for i in range(0, len(nlines)) do
      draw_text(nlines[i], {x: dx, y: ny + 20 + i * 19}, {size: FS, color: DIM})
    end
  end

  // checklist
  let sy2 = ny + 132
  draw_line({x: dx, y: sy2 - 18}, {x: dx + dw, y: sy2 - 18}, LINE)
  draw_text("CHECKLIST", {x: dx, y: sy2}, {size: FS_MICRO, color: FAINT, spacing: 1.4})
  if len(cur.subs) > 0 then
    draw_text_right("{subs_done(cur)} of {len(cur.subs)}", dx + dw, sy2, FS_MICRO, GHOST)
  end
  sub_row_y = sy2 + 20
  if len(cur.subs) == 0 then
    draw_text("No steps yet.", {x: dx, y: sub_row_y + 3}, {size: FS, color: GHOST})
  else
    for i in range(0, len(cur.subs)) do
      let s = cur.subs[i]
      let r = sub_rect(i, dx, sub_row_y, dw)
      let hov = point_in(mx, my, r)
      if hov then
        draw_rect_rounded(rect(r.x - 6, r.y - 1, r.w + 12, r.h), 6, CARD, 150)
      end
      let bx = r.x + 8
      let by2 = r.y + 11
      if s.done then
        draw_rect_rounded(rect(bx - 6, by2 - 6, 12, 12), 3, GREEN)
        stroke({x: bx - 3, y: by2}, {x: bx - 1, y: by2 + 2.5}, INK, 255, 1.6)
        stroke({x: bx - 1, y: by2 + 2.5}, {x: bx + 3, y: by2 - 2.5}, INK, 255, 1.6)
      else
        draw_rect_rounded(rect(bx - 6, by2 - 6, 12, 12), 3, if hov then GREEN else GHOST end, 170)
        draw_rect_rounded(rect(bx - 5, by2 - 5, 10, 10), 2, SURFACE)
      end
      let scol = if s.done then GHOST else DIM end
      let st = ellipsize(s.t, dw - 30, FS)
      draw_text(st, {x: bx + 14, y: r.y + 4}, {size: FS, color: scol})
      if s.done then
        stroke({x: bx + 14, y: r.y + 11}, {x: bx + 14 + text_width(st, FS), y: r.y + 11}, GHOST, 190, 1)
      end
    end
  end

  // actions
  draw_line({x: dx, y: act_y - 26}, {x: dx + dw, y: act_y - 26}, LINE)
  draw_text("task #{cur.id}", {x: dx, y: act_y - 46}, {size: FS_MICRO, color: GHOST})
  draw_text_right("added {ago(cur.age)} · in {cur.list}", dx + dw, act_y - 46, FS_MICRO, GHOST)
  if btn(act1, if cur.done then "Reopen" else "Complete" end, 1, true) then end
  if btn(act2, "Delete", 2, true) then end
end

// ── observable summary (read from /state → panes[0].panel.values) ───────────
let visible_count = n_shown
let selection = if have then cur.title else "" end
let focus_id = focus
let revision = rev
let trash_size = len(trash)
