// bloom gallery — every component in the bloom library, live.
//
// bloom (petal-libs/bloom) is a component library written entirely in Petal.
// This app is its showcase and its usage reference: each section below is the
// shortest honest example of the components it names, so a panel author can
// copy a block and have a working control.
//
// Two things to notice while clicking around:
//
//  1. Nothing here holds animation state. Every hover fade, press squash,
//     ripple, sliding thumb, springing knob, staggered menu row and entering
//     dialog is `state` *inside* the component, keyed by the call path — so a
//     component is as cheap to use as a `draw_rect`.
//  2. Overlays capture input. Open the menu or the dialog and the controls
//     underneath go inert, with no `if !blocked` guard anywhere in this file.

import bloom
import bloom/icon as icons
import text_layout as tl

let T = ui_theme()
let w = screen_width()
let h = screen_height()

state section = 0
state pressed = 0
state toggle_on = true
state check_wrap = true
state check_mini = false
state radio = 1
state seg = 1
state volume = 0.6
state zoom = 2
state name = "petunia"
state pick = 0
state progress_v = 0.35
state loading = false
state last_menu = "—"

let SECTIONS = ["Buttons", "Controls", "Menus", "Overlays", "Text", "Motion", "Icons"]

clear(T.bg.r, T.bg.g, T.bg.b)

// ── chrome: a menu bar across the top ─────────────────────────────────────
let bar = rect(0, 0, w, 30)
draw_rect(bar, mix(T.bg, T.panel, t: 0.7))
draw_line({x: 0, y: 30}, {x: w, y: 30}, c: bloom.hair(T))
let chosen = bloom.menu_bar(bar, [
  {label: "File", items: [{label: "New panel", icon: "plus", hint: "⌘N"},
    {label: "Open…", icon: "folder"},
    {sep: true},
    {label: "Close", icon: "close", danger: true, hint: "⌘W"}]},
  {label: "View", items: [{label: "Zoom in", hint: "⌘+"}, {label: "Zoom out", hint: "⌘-"},
    {sep: true}, {label: "Reset", disabled: true}]},
  {label: "Help", items: [{label: "Components", icon: "info"}, {label: "Report a bug", icon: "warning"}]},
])
if chosen.item >= 0 then
  last_menu = "menu {chosen.menu} · item {chosen.item}"
  bloom.toast("Chose {last_menu}", "info")
end

// ── the section rail ──────────────────────────────────────────────────────
let RAIL_W = 148
let rail = rect(0, 31, RAIL_W, h - 31)
draw_rect(rail, mix(T.bg, T.panel, t: 0.45))
draw_line({x: RAIL_W, y: 31}, {x: RAIL_W, y: h}, c: bloom.hair(T))

// The selection marker slides between rows on a spring rather than jumping —
// one `spring` call, no state in this file.
let marker_y = bloom.spring(float(section), {stiffness: 260.0, damping: 24.0})
draw_rect_rounded(rect(6, 42 + marker_y * 34, RAIL_W - 12, 30), radius: 6, c: mix(T.bg, T.accent, t: 0.22))
for i in range(0, len(SECTIONS)) do
  let r = rect(6, 42 + i * 34, RAIL_W - 12, 30)
  if bloom.button(r, label: SECTIONS[i], opts: {variant: "ghost", align: "left", ripple: false,
    size: T.font_md, id: "rail:{i}"}) then
    section = i
  end
end

let body = pad(rect(RAIL_W, 31, w - RAIL_W, h - 31), 20)
draw_text(SECTIONS[section], pos: {x: body.x, y: body.y},
  style: {size: T.font_xl, color: T.text, weight: 700})
let content = rect(body.x, body.y + 40, body.w, body.h - 40)

// ── Buttons ───────────────────────────────────────────────────────────────
if section == 0 then
  let row1 = rect(content.x, content.y, content.w, 32)
  if bloom.button(rect(row1.x, row1.y, 110, 32), label: "Primary", opts: {variant: "primary", icon: "check"}) then
    pressed += 1
    bloom.toast("Primary pressed", "success")
  end
  bloom.button(rect(row1.x + 120, row1.y, 110, 32), "Default")
  bloom.button(rect(row1.x + 240, row1.y, 110, 32), label: "Danger", opts: {variant: "danger", icon: "trash"})
  bloom.button(rect(row1.x + 360, row1.y, 100, 32), label: "Ghost", opts: {variant: "ghost"})

  let row2 = row1.y + 44
  bloom.button(rect(row1.x, row2, 130, 32), label: "Pill", opts: {pill: true, icon_end: "chevron_right"})
  bloom.button(rect(row1.x + 140, row2, 110, 32), label: "Disabled", opts: {disabled: true})
  if bloom.button(rect(row1.x + 260, row2, 110, 32), label: "Load", opts: {loading: loading}) then
    loading = true
  end
  if loading && bloom.button(rect(row1.x + 380, row2, 90, 32), label: "Stop", opts: {variant: "quiet"}) then
    loading = false
  end

  let row3 = row2 + 44
  for i in range(0, len(bloom.ICONS)) do
    if i < 8 then
      bloom.icon_button(rect(row1.x + i * 36, row3, 30, 30), bloom.ICONS[i])
    end
  end
  seg = bloom.segmented(rect(row1.x, row3 + 44, 260, 30), labels: ["Code", "Blame", "Log"], index: seg)
  bloom.chip(x: row1.x + 280, y: row3 + 47, label: "{pressed} presses")
  if bloom.link(x: row1.x, y: row3 + 92, label: "A link, underlined on hover") then
    bloom.toast("Links return true on click too")
  end
  bloom.tooltip(rect(row1.x, row1.y, 110, 32), "Buttons fire on release, not press")
end

// ── Controls ──────────────────────────────────────────────────────────────
if section == 1 then
  let x = content.x
  var y = content.y
  toggle_on = bloom.switch(rect(x, y, 48, 26), toggle_on)
  bloom.text_in(if toggle_on then "Live reload on" else "Live reload off" end,
    r: rect(x + 62, y, 260, 26), style: bloom.ts(t: T, size: T.font_md, color: T.text))
  set y = y + 40
  check_wrap = bloom.checkbox(rect(x, y, 220, 24), label: "Wrap long lines", on: check_wrap)
  check_mini = bloom.checkbox(rect(x + 240, y, 220, 24), label: "Minimap", on: check_mini)
  set y = y + 38
  radio = bloom.radio_group(rect(x, y, 220, 90), labels: ["Spaces", "Tabs", "Whatever the file uses"], index: radio)
  set y = y + 100
  volume = bloom.slider(rect(x, y, 260, 26), value: volume, lo: 0.0, hi: 1.0)
  zoom = bloom.stepper(rect(x + 290, y, 120, 26), value: zoom, lo: 1, hi: 8, step: 1)
  bloom.text_in("zoom", r: rect(x + 420, y, 60, 26), style: bloom.ts(t: T, size: T.font_sm, color: T.muted))
  set y = y + 42
  bloom.progress(rect(x, y, 260, 8), volume)
  bloom.progress(rect(x + 290, y, 120, 8), -1.0)
  set y = y + 28
  let f = bloom.text_field(rect(x, y, 300, 32), buf: name, opts: {id: "name", placeholder: "Panel name"})
  name = f.text
  if f.submitted then
    bloom.toast("Renamed to {name}", "success")
  end
  bloom.text_in("Tab reaches every control with an id.",
    r: rect(x + 320, y, 320, 32), style: bloom.ts(t: T, size: T.font_sm, color: T.dim))
end

// ── Menus ─────────────────────────────────────────────────────────────────
if section == 2 then
  let x = content.x
  let y = content.y
  let picked = bloom.dropdown(rect(x, y, 150, 32), label: "Actions",
    items: [{label: "Rename", icon: "file", hint: "F2"},
      {label: "Duplicate", icon: "plus"},
      {sep: true},
      {label: "Delete", icon: "trash", danger: true, hint: "⌫"}])
  if picked >= 0 then
    bloom.toast("Action {picked}", "info")
  end
  pick = bloom.select(rect(x + 170, y, 170, 32), options: ["Rust", "Petal", "TypeScript"], index: pick)
  bloom.text_in("selected: {["Rust", "Petal", "TypeScript"][pick]}",
    r: rect(x + 360, y, 240, 32), style: bloom.ts(t: T, size: T.font_md, color: T.muted))

  let area = rect(x, y + 56, content.w - 20, 150)
  bloom.stroke(t: T, r: area, radius: T.radius, color: bloom.hair(T), width: 1, inner: mix(T.bg, T.panel, t: 0.35))
  bloom.text_in("Right-click anywhere in this box", r: pad(area, 14),
    style: bloom.ts(t: T, size: T.font_md, color: T.muted))
  let ctx = bloom.context_menu(area, [{label: "Copy", icon: "file", hint: "⌘C"},
    {label: "Paste", hint: "⌘V"},
    {sep: true},
    {label: "Select all"}])
  if ctx >= 0 then
    bloom.toast("Context item {ctx}")
  end
  bloom.text_in("Last menu-bar choice: {last_menu}", r: rect(x, y + 220, content.w, 20),
    style: bloom.ts(t: T, size: T.font_sm, color: T.dim))
end

// ── Overlays ──────────────────────────────────────────────────────────────
if section == 3 then
  let x = content.x
  let y = content.y
  if bloom.button(rect(x, y, 130, 32), label: "Open dialog", opts: {variant: "primary"}) then
    bloom.dialog_open("confirm")
  end
  if bloom.button(rect(x + 150, y, 130, 32), label: "Toast", opts: {icon: "info"}) then
    bloom.toast("Something happened", "success")
  end
  if bloom.button(rect(x + 300, y, 130, 32), label: "Warn", opts: {variant: "warn"}) then
    bloom.toast("Disk is nearly full", "warn")
  end
  if bloom.button(rect(x + 450, y, 130, 32), label: "Popover", opts: {icon_end: "chevron_down"}) then
    bloom.popover_open("filters")
  end
  let po = bloom.popover(id: "filters", anchor: rect(x + 450, y, 130, 32), w: 220, h: 120)
  if po.open then
    bloom.text_in("Filters", r: po.content, style: bloom.ts_bold(t: T, size: T.font_md, color: T.text))
    check_mini = bloom.checkbox(rect(po.content.x, po.content.y + 30, 190, 24), label: "Only mine", on: check_mini)
    check_wrap = bloom.checkbox(rect(po.content.x, po.content.y + 58, 190, 24), label: "Open only", on: check_wrap)
  end

  bloom.banner(rect(x, y + 50, content.w - 20, 34), text: "Hover a control for its tooltip.", kind: "info", show: true)
  bloom.text_in("A skeleton row, while data is in flight:",
    r: rect(x, y + 100, 300, 20), style: bloom.ts(t: T, size: T.font_sm, color: T.dim))
  for i in range(0, 3) do
    bloom.skeleton(rect(x, y + 126 + i * 24, 260 - i * 40, 14), {phase: float(i) * 0.2})
  end
end

// ── Text ──────────────────────────────────────────────────────────────────
// Everything here is text_layout (petal-libs/text-layout), the placement
// library bloom draws every one of its own labels through. The point of the
// section is the red centre line: a label is centred when the line splits its
// capitals — which is not where "the run is `size` px tall and starts at `y`"
// would put it.
if section == 4 then
  let x = content.x
  let y = content.y
  bloom.text_in("The red line is each box's exact middle. A centred label is split by it.",
    r: rect(x, y - 6, content.w, 20), style: bloom.ts(t: T, size: T.font_sm, color: T.dim))

  var ty = y + 22
  for size in [12, 16, 26] do
    let bh = size + 20
    for pair in [[0, "left"], [190, "center"], [380, "right"]] do
      let box = rect(x + pair[0], ty, 170, bh)
      draw_rect_rounded(box, radius: 6, c: mix(T.bg, T.panel, t: 0.9))
      tl.draw_text_line("Hxjy {size}", r: box, style: bloom.ts(t: T, size: size, color: T.text), align: pair[1])
      let mid = box.y + box.h / 2.0
      draw_line({x: box.x, y: mid}, {x: box.x + box.w, y: mid}, T.danger, 120, 1)
    end
    set ty = ty + bh + 8
  end

  // One baseline, three sizes: what `draw_text_baseline` is for.
  let base = ty + 26.0
  draw_line({x: x, y: base}, {x: x + 550, y: base}, T.danger, 120, 1)
  var bx = float(x)
  for s in [26, 16, 12] do
    set bx = bx + tl.draw_text_baseline("Aq{s}", x: bx, baseline: base, style: bloom.ts(t: T, size: s, color: T.text)) + 16.0
  end
  bloom.text_in("one baseline, three sizes", r: rect(x, base + 8, 300, 16),
    style: bloom.ts(t: T, size: T.font_sm, color: T.muted))

  // Wrapping, and the two-line clamp a card summary wants.
  let body = "Wrapping, elision and caret hit-testing are each one native call over the host's advance table, so a paragraph costs about what a label costs."
  let bs = bloom.ts(t: T, size: T.font_sm, color: T.muted)
  let col = rect(x + 580, y + 22, 150, 120)
  draw_rect_rounded(col, radius: 6, c: mix(T.bg, T.panel, t: 0.9))
  tl.draw_text_block(body, r: pad(col, 8), style: bs, opts: {lead: 1.15})
  let col2 = rect(x + 580, y + 152, 150, 46)
  draw_rect_rounded(col2, radius: 6, c: mix(T.bg, T.panel, t: 0.9))
  tl.draw_text_block(body, r: pad(col2, 8), style: bs, opts: {lines: 2, lead: 1.15})
  bloom.text_in("wrapped, then clamped to 2 lines", r: rect(x + 580, y + 202, 220, 16),
    style: bloom.ts(t: T, size: T.font_sm, color: T.dim))

  // The three ends an ellipsis can eat.
  var ey = base + 34.0
  for pair in [["head", "a label longer than the box it is in"],
    ["tail", "petal-libs/text-layout/src/place.ptl"],
    ["both", "commit 9f2a1c3 payload identifier"]] do
    let row = rect(x, ey, 170, 24)
    draw_rect_rounded(row, radius: 4, c: mix(T.bg, T.panel, t: 0.7))
    tl.draw_text_line(tl.elide(pair[1], style: bs, max_w: row.w - 12, keep: pair[0]), r: pad(row, h: 6, v: 0), style: bs, align: "left")
    bloom.text_in("keep {pair[0]}", r: rect(x + 182, ey, 120, 24), style: bloom.ts(t: T, size: T.font_sm, color: T.dim))
    set ey = ey + 30.0
  end
end

// ── Motion ────────────────────────────────────────────────────────────────
if section == 5 then
  let x = content.x
  let y = content.y
  bloom.text_in("The animators, drawn raw. Everything above is built from these.",
    r: rect(x, y - 6, content.w, 20), style: bloom.ts(t: T, size: T.font_sm, color: T.dim))
  // A spring and an eased value chasing the same target: the pointer's x.
  let target = clamp(float(mouse_x() - x), lo: 0.0, hi: 360.0)
  let sp = bloom.spring(target, {stiffness: 120.0, damping: 14.0})
  let ez = bloom.ease_to(target, 9.0)
  draw_rect_rounded(rect(x, y + 30, 360, 4), radius: 2, c: mix(T.bg, T.panel, t: 0.8))
  draw_circle(center: {x: x + sp, y: y + 32}, radius: 9, c: T.accent)
  draw_circle(center: {x: x + ez, y: y + 32}, radius: 6, c: T.success)
  bloom.text_in("spring (accent) vs ease_to (green) — move the pointer",
    r: rect(x, y + 46, 400, 18), style: bloom.ts(t: T, size: T.font_sm, color: T.muted))

  // A staggered entrance: the bars cascade in when this section first appears.
  for i in range(0, 12) do
    let k = bloom.ease_out(bloom.stagger(i, step_s: 0.04, dur: 0.4))
    let bh = 60.0 * k
    draw_rect_rounded(rect(x + i * 26, y + 160 - bh, 18, bh), radius: 3,
      c: mix(T.accent, T.success, t: float(i) / 12.0))
  end
  bloom.text_in("stagger(i, …): one animator per loop iteration",
    r: rect(x, y + 168, 400, 18), style: bloom.ts(t: T, size: T.font_sm, color: T.muted))

  // A pulse and a shake, on demand.
  let p = bloom.pulse(1.4)
  draw_circle({x: x + 20, y: y + 220}, 8 + 6 * p, T.danger, int(90 + 120 * p))
  let angry = bloom.button(rect(x + 60, y + 206 + bloom.shake(pressed % 7 == 3, 6.0), 120, 30),
    label: "Shake me", opts: {variant: "danger"})
  if angry then
    pressed += 1
  end
end

// ── Icons ─────────────────────────────────────────────────────────────────
if section == 6 then
  bloom.text_in("Every glyph is a few strokes in a unit box — no font, no atlas.",
    r: rect(content.x, content.y - 6, content.w, 20), style: bloom.ts(t: T, size: T.font_sm, color: T.dim))
  for i in range(0, len(icons.NAMES)) do
    let col = i % 6
    let row = int(i / 6)
    let cell = rect(content.x + col * 110, content.y + 26 + row * 62, 100, 56)
    let p = bloom.probe(cell)
    draw_rect_rounded(cell, radius: T.radius, c: bloom.wash(t: T, base: mix(T.bg, T.panel, t: 0.5), hot: p.hot, active: p.active))
    icons.icon(name: icons.NAMES[i], r: rect(cell.x + 38, cell.y + 8, 24, 24),
      color: mix(T.muted, T.accent, t: p.hot))
    bloom.text_in(icons.NAMES[i], r: rect(cell.x, cell.y + 34, cell.w, 16),
      style: bloom.ts(t: T, size: T.font_sm, color: T.dim), align: "center")
  end
end

// ── overlays, drawn last so they land on top ──────────────────────────────
let d = bloom.dialog(id: "confirm", w: 380, h: 190, title: "Delete this panel?")
if d.open then
  bloom.text_block_in("The panel and its saved state go with it. This cannot be undone.",
    r: rect(d.content.x, d.content.y, d.content.w, 46),
    style: bloom.ts(t: T, size: T.font_md, color: T.muted), opts: {lead: 1.2})
  let br = rect(d.content.x + d.content.w - 210, d.content.y + d.content.h - 34, 100, 30)
  if bloom.button(br, label: "Cancel", opts: {variant: "quiet"}) then
    bloom.dialog_close()
  end
  if bloom.button(rect(br.x + 110, br.y, 100, 30), label: "Delete", opts: {variant: "danger", icon: "trash"}) then
    bloom.dialog_close()
    bloom.toast("Panel deleted", "danger")
  end
end

bloom.toasts(rect(0, 0, w, h))

// Last line of the frame: paint everything the components deferred — the open
// menu's popup, the tooltips. Without it they would still be painted, just at
// the top of the next frame, and a panel drawn afterwards could cover them.
bloom.overlays()
