// id → position in SETTINGS.
pub fn build_index() -> record
  let idx = {}
  for i in range(0, len(SETTINGS)) do
    idx[SETTINGS[i].id] = i
  end
  idx
end

// The default value of every setting that holds one (actions do not).
pub fn defaults() -> record
  let d = {}
  for s in SETTINGS do
    if s.kind != "action" then
      d[s.id] = s.def
    end
  end
  d
end

// Stored values over the defaults: a key the schema no longer has is dropped,
// and one the store never saw takes its default.
pub fn merged(stored: record) -> record
  let d = defaults()
  for k in keys(d) do
    let v = field(stored, k, nil)
    if v != nil && type(v) == type(d[k]) then
      d[k] = v
    elsif v != nil && (type(v) == "int" || type(v) == "float") && (type(d[k]) == "int" || type(d[k]) == "float") then
      d[k] = v
    end
  end
  d
end

fn two(n: num) -> string
  pad_start(str(int(n)), 2, "0")
end

// A number the way its row shows it: "13 px", "1.5×", "22:00".
pub fn show_num(s: record, v: num) -> string
  if s.fmt == "hour" then
    "{two(v)}:00"
  elsif s.places > 0 then
    let scaled = int(round(float(v) * pow(10.0, float(s.places))))
    let unit_n = int(pow(10.0, float(s.places)))
    let whole = scaled / unit_n
    let frac = pad_start(str(scaled % unit_n), s.places, "0")
    // Trailing zeros carry no information on a ×0.25 scale.
    let trimmed = if s.places == 2 && ends_with(frac, "0") then slice(frac, 0, 1) else frac end
    "{whole}.{trimmed}{s.unit}"
  else
    "{int(round(float(v)))}{s.unit}"
  end
end

// Any value, for the Changes list and for search: "On", "Dark", "13 px".
pub fn show_value(s: record, v) -> string
  match s.kind
    when "toggle" -> if v then "On" else "Off" end
    when "check" -> if v then "On" else "Off" end
    when "seg" -> s.opts[int(v)]
    when "select" -> s.opts[int(v)]
    when "radio" -> s.opts[int(v)]
    when "swatch" -> ACCENTS[int(v)].name
    when "text" -> if v == "" then "empty" else v end
    when "action" -> ""
    when _ -> show_num(s, v)
  end
end

// Snap a slider or stepper value to its step, inside its range. Ints stay
// ints, so a stored "13" compares equal to the default 13.
pub fn snap(s: record, v: num)
  let lo = float(s.lo)
  let stepped = lo + round((float(v) - lo) / float(s.step)) * float(s.step)
  let c = clamp(stepped, lo, float(s.hi))
  if s.places == 0 then int(round(c)) else round(c, s.places) end
end

// Why a text value is not acceptable, or "" when it is.
pub fn problem(s: record, v: string) -> string
  let t = trim(v)
  if s.fmt == "email" then
    let at = index_of(t, "@")
    let domain = if at >= 0 then slice(t, at + 1) else "" end
    if t == "" then "An email address is required."
    elsif contains(t, " ") then "Addresses cannot contain spaces."
    elsif at < 1 || domain == "" then "Add an @ and a domain."
    elsif contains(domain, "@") then "Only one @ is allowed."
    elsif index_of(domain, ".") < 1 || ends_with(domain, ".") then "The domain needs a dot, like fern.dev."
    else ""
    end
  elsif t == "" then
    "This cannot be empty."
  else
    ""
  end
end

// Whether a setting answers a search. Every word of the query must appear
// somewhere in its label, description, tags, group or section name.
pub fn matches(s: record, words: list) -> bool
  let g = GROUPS[s.g]
  let hay = lower("{s.label} {s.desc} {s.tags} {g.name} {SECTIONS[g.sec].label} {join(s.opts, " ")}")
  let ok = true
  for w in words do
    if !contains(hay, w) then ok = false end
  end
  ok
end
