// Package `vec2` — 2D and 3D vectors (core/src/builtins/vec2.rs).
//
// A bundled builtin package: the petal runtime registers these natives in
// every Env, and `import vec2` puts them in scope — bare (`vec2(…)`), qualified
// (`vec2.vec2(…)`) and as methods (`x.vec2(…)`).
//
// Native interface declarations: each `native fn` binds a name to the host
// native of the same name and gives the checker its parameter names, arity
// and types. Several declarations of one name are that native's call forms.
// See docs/ffi.md (Native interfaces).

pub native fn vec2(x, y) -> vec2
pub native fn normalize(v)
pub native fn dot(a, b) -> float
pub native fn limit(v, max_mag)
pub native fn rotate(v, angle) -> vec2
pub native fn vec3(x, y, z) -> vec3
pub native fn cross(a, b) -> vec3
