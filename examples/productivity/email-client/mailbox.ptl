// ─────────────────────────────────────────────────────────────────────────
// mailbox — the data half of Plume: people, the seeded mail store, the clock,
// the query language and every pure transform the UI applies to the store.
//
// Nothing in here draws. A thread is a plain record
//
//   {id, box, labels, starred, unread, subject, msgs}
//
// and a message is {from, to, age, body, atts}. `from` and each `to` entry is
// a key into PEOPLE (or a raw address the user typed), `age` is minutes
// before NOW (zero or less for mail written during the session), `body` is a
// list of paragraphs and `atts` a list of {name, size, kind}.
// ─────────────────────────────────────────────────────────────────────────

// ── The clock ────────────────────────────────────────────────────────────
// There is no date builtin, and a demo whose "38 minutes ago" drifts with the
// wall clock cannot be screenshot-tested, so the mailbox lives at one fixed
// instant: Tuesday 6 October, 10:24.

pub let NOW_MIN = 624          // 10:24, as minutes into the day
let NOW_DOM = 6
let NOW_MON = 9                   // October, zero-based
let NOW_WD = 1                    // Tuesday, Monday = 0

let MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep",
  "Oct", "Nov", "Dec"]
let MONTH_LEN = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
let WEEKDAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

// The age of something that happened `days` days ago at hh:mm.
fn at(days: int, hh: int, mm: int) -> int
  days * 1440 + NOW_MIN - (hh * 60 + mm)
end

fn days_ago(age: int) -> int
  if age <= NOW_MIN then 0 else (age - NOW_MIN - 1) / 1440 + 1 end
end

fn two(n: int) -> string
  if n < 10 then "0{n}" else str(n) end
end

fn clock(age: int) -> string
  let m = ((NOW_MIN - age) % 1440 + 1440) % 1440
  let h = m / 60
  let h12 = if h % 12 == 0 then 12 else h % 12 end
  let half = if h < 12 then "AM" else "PM" end
  "{h12}:{two(m % 60)} {half}"
end

fn month_day(d: int) -> string
  let dom = NOW_DOM - d
  let mon = NOW_MON
  while dom < 1 do
    mon = (mon + 11) % 12
    dom = dom + MONTH_LEN[mon]
  end
  "{MONTHS[mon]} {dom}"
end

fn weekday(d: int) -> string
  WEEKDAYS[((NOW_WD - d) % 7 + 7) % 7]
end

// The list's timestamp: as short as it can be and still be unambiguous.
pub fn when_short(age: int) -> string
  let d = days_ago(age)
  if age <= 0 then "now"
  elsif d == 0 then clock(age)
  elsif d == 1 then "Yesterday"
  elsif d < 7 then weekday(d)
  else month_day(d)
  end
end

// The reading pane's timestamp: the whole thing.
pub fn when_long(age: int) -> string
  let d = days_ago(age)
  if age <= 0 then "Just now"
  elsif d == 0 then "Today, {clock(age)}"
  elsif d == 1 then "Yesterday, {clock(age)}"
  else "{weekday(d)}, {month_day(d)}, {clock(age)}"
  end
end

