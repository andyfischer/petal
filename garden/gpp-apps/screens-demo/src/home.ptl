// screens-demo — HOME screen. A fixed panel drawer (no data). Pressing `n`
// navigates to the detail screen via the first-class `navigate` request.
//
// Built on the petal-ui component library plus **bloom**
// (petal-libs/bloom), the pure-Petal component set Garden registers as
// importable modules: `ui_theme()` mirrors the host palette in Garden and
// falls back to the built-in theme under a bare `petal-ui-run`, so this screen
// runs headlessly too — with `-I petal-libs/bloom/src` so that the bloom
// modules resolve outside Garden.
import bloom

let T = ui_theme()
let w = screen_width()
let h = screen_height()
clear(T.bg.r, T.bg.g, T.bg.b)

// The screen's identity band: HOME is the green screen.
draw_rect(rect(0, 0, w, 4), T.success)

let cw = min(460, w - 48)
let c = card(rect((w - cw) / 2, 56, cw, 132))
draw_text("HOME", {x: c.x, y: c.y}, {size: T.font_xl, color: T.text, weight: 700})
let tag = "screen 1 of 2"
pill(c.x + c.w - text_width(tag, T.font_sm) - 14, c.y + 4, tag, T.success)

draw_text("The host fetches DETAIL's source over the navigate request.",
          {x: c.x, y: c.y + 44}, T.font_sm, T.dim)

// The navigation is a bloom button as well as a key, so the screen is usable
// with a pointer. `id` puts it in the Tab ring, and Return fires it there.
let go = bloom.button(rect(c.x, c.y + 74, 150, 30), "Open DETAIL",
                      {variant: "primary", icon_end: "arrow_right", id: "detail"})

hint_bar(rect(0, h - 26, w, 26), [hint("n", "open DETAIL")])

if go || key_pressed("n") then
  navigate("detail.ptl")
end
