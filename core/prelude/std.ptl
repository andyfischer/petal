// Petal core prelude — module `std`
//
// The standard library the core language ships in Petal source (as opposed to
// the native builtins registered in core/src/builtins). Registered by
// `Env::new` as a permanent implicit import, so every program calls these bare
// with zero ceremony — `import std` / `import std: sum` also work, and are
// no-ops on top of the implicit import.
//
// Implicit bindings are weak: a program's own declaration of the same name
// shadows the prelude silently, and these never raise collision errors. Only
// declarations marked `pub` are visible to importers.
//
// Everything here is pure Petal built on the native builtins — no host natives
// (a frame clock, a renderer). Timing/interaction helpers that need a host
// live in the petal-ui prelude (`elapsed`, `button`, …) instead, since they
// only make sense under a frame loop.

// ── List reductions ────────────────────────────────────────────────────────

// First element, or nil when empty. The complement of the native `last`.
pub fn first(xs)
  if len(xs) == 0 then nil else xs[0] end
end

// True when the list (or string) has no elements.
pub fn is_empty(xs)
  len(xs) == 0
end

// Sum of a list of numbers; 0 for the empty list.
pub fn sum(xs)
  reduce(xs, 0, fn(acc, x) acc + x end)
end

// Product of a list of numbers; 1 for the empty list.
pub fn product(xs)
  reduce(xs, 1, fn(acc, x) acc * x end)
end

// Arithmetic mean as a float, or nil for the empty list (no divide by zero).
pub fn mean(xs)
  if len(xs) == 0 then nil else float(sum(xs)) / len(xs) end
end

// Smallest element, or nil when empty. Works for any comparable element type.
pub fn minimum(xs)
  if len(xs) == 0 then
    nil
  else
    reduce(xs, xs[0], fn(acc, x) if x < acc then x else acc end end)
  end
end

// Largest element, or nil when empty.
pub fn maximum(xs)
  if len(xs) == 0 then
    nil
  else
    reduce(xs, xs[0], fn(acc, x) if x > acc then x else acc end end)
  end
end

// ── Predicate queries ──────────────────────────────────────────────────────

// How many elements satisfy `pred`.
pub fn count(xs, pred)
  len(filter(xs, pred))
end

// `any`, `all` and `find` are native (core/packages/core/src/collections.ptl),
// so they stop at the deciding element and their callbacks fall under the
// builtin-callback `state` rule, as `filter`'s do.

// ── Selection by key ───────────────────────────────────────────────────────
//
// `key` is called once per element. The native `argmin` / `argmax` /
// `top_indices` do the selecting, over the list of keys.

// The element whose `key(x)` is smallest (the first of equals), or nil when
// the list is empty.
pub fn min_by(xs, key)
  let i = argmin(map(xs, key))
  if i == nil then nil else xs[i] end
end

// The element whose `key(x)` is largest (the first of equals), or nil when
// the list is empty.
pub fn max_by(xs, key)
  let i = argmax(map(xs, key))
  if i == nil then nil else xs[i] end
end

// The `k` largest elements, largest first — by `key(x)` when a key is given,
// by the elements themselves (numbers) when not. Fewer than `k` when the list
// is shorter. A bounded selection, not a sort of the whole list.
pub fn top_k(xs, k, key = nil)
  let scores = if key == nil then xs else map(xs, key) end
  map(top_indices(scores, k), fn(i) xs[i] end)
end

// A record of lists: each element goes into the group named by `key(x)`.
// Groups are in the order their key first appears, each in list order. A key
// that is not a string is named by its `str()`.
pub fn group_by(xs, key)
  group_by_keys(xs, map(xs, key))
end

// `f` of every element, with the lists it returns joined end to end:
// `flat(map(xs, f))`.
pub fn flat_map(xs, f)
  flat(map(xs, f))
end

// ── Sublists ───────────────────────────────────────────────────────────────

// The first `n` elements, clamped to the list bounds (never errors).
pub fn take(xs, n)
  slice(xs, 0, max(0, min(n, len(xs))))
end

// Everything after the first `n` elements, clamped to the list bounds.
pub fn drop(xs, n)
  slice(xs, max(0, min(n, len(xs))), len(xs))
end

// ── Ragged records ─────────────────────────────────────────────────────────
//
// Reading a field a record does not carry is a hard error — a typo should not
// pass silently. Data that is legitimately ragged (decoded JSON, a partial
// style record) asks for the absence explicitly: `rec.key ?? fallback`, which
// tolerates the missing field, or one of these two by name.

// True when `rec` carries `key` at all — including when its value is nil,
// which is the one case `rec[key] ?? false` cannot tell apart.
pub fn has_field(rec, key)
  contains(keys(rec), key)
end

// Field `key` of `rec`, or `fallback` when the record does not carry it (or
// carries it as nil). The named spelling of `rec[key] ?? fallback`, useful
// when the key is computed.
pub fn field(rec, key, fallback)
  rec[key] ?? fallback
end

// ── Numbers ────────────────────────────────────────────────────────────────

// Clamp a number to the 0..1 range — the common `clamp(x, 0, 1)` shorthand.
pub fn clamp01(x)
  clamp(x, 0, 1)
end

// ── Text ───────────────────────────────────────────────────────────────────

// A count with its noun: `plural(1, "car")` is "1 car", `plural(3, "car")`
// is "3 cars", `plural(2, "city", "cities")` is "2 cities". The count is
// written with thousands separators (`commas`).
pub fn plural(n, one, many = nil)
  if n == 1 then
    "1 {one}"
  else
    "{commas(n)} {many ?? one ++ "s"}"
  end
end

// A list as prose: "a", "a and b", "a, b and c"; "" for the empty list.
// `word` replaces "and" (`list_and(xs, "or")`).
pub fn list_and(xs, word = "and")
  let n = len(xs)
  if n == 0 then
    ""
  elsif n == 1 then
    str(xs[0])
  else
    join(slice(xs, 0, n - 1), ", ") ++ " {word} " ++ str(xs[n - 1])
  end
end
