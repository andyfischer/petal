@module_doc("""
Text helpers (truncation, wrapping, alignment, ellipsizing), text on a path,
chart labels, text ranges and the clipboard. `ui` re-exports every name
here.

Offsets are character (code point) offsets throughout, the unit `len`,
`slice` and `char_slice` use, so non-ASCII text needs no special care. The
measuring calls take a text style record (see `draw_text`) or a bare pixel
size; pass the style you will draw with, so what is measured is what is
drawn. **Rotated text is not available**: no host can rotate a text run.
`draw_text_along` and `draw_axis_labels` are the workarounds.
""",
  see: ["ui", "ui.draw_text", "ui.text_width"],
  extra: {groups: [
    {name: "Aligned and laid-out text", items: ["draw_text_center", "draw_text_right", "draw_text_along", "draw_axis_labels", "draw_axis_labels_y"]},
    {name: "Fitting text", items: ["ellipsize", "ellipsize_tail", "truncate_head", "truncate_tail", "wrap", "preview", "fit_parts", "fit_parts_n"]},
    {name: "Carets and selections", items: ["text_wrap_rows", "text_row_of", "text_range_rects"]},
    {name: "The clipboard", items: ["clipboard_get", "clipboard_set"]},
  ]})

# petal-ui text — module `ui/text`

import ./_native
import ./_style
import ./draw
import ./layout
import io

# ── Text helpers ──────────────────────────────────────────────────────────

@doc("""
`s` cut to `max_chars` characters keeping its end (a file path), with a
leading "…" when anything was cut.
""", see: ["truncate_head", "ellipsize_tail"])
pub fn truncate_tail(s, max_chars)
  if len(s) <= max_chars then
    s
  else
    "…" ++ slice(s, len(s) - max_chars + 1, len(s))

@doc("""
`s` cut to `max_chars` characters keeping its start, with a trailing "…"
when anything was cut.
""", see: ["truncate_tail", "ellipsize"])
pub fn truncate_head(s, max_chars)
  if len(s) <= max_chars then
    s
  else
    slice(s, 0, max_chars - 1) ++ "…"

fn _wrap_segment(seg, max_chars)
  let lines = []
  let cur = ""
  for word in split(seg, " ") do
    let w = word
    # A token that can never fit gets its own hard-broken lines.
    while len(w) > max_chars do
      if len(cur) > 0 then
        lines = append(lines, cur)
        cur = ""
      let take = max_chars
      let piece = slice(w, 0, take)
      while len(piece) == 0 do
        # max_chars landed inside w's first char and boundary snapping
        # emptied the slice: widen until the char fits.
        take = take + 1
        piece = slice(w, 0, take)
      lines = append(lines, piece)
      w = slice(w, len(piece), len(w))
    if len(cur) == 0 then
      cur = w
    else if len(cur) + 1 + len(w) <= max_chars then
      cur = cur ++ " " ++ w
    else
      lines = append(lines, cur)
      cur = w
  # Flush the line under construction; skip a leftover "" (the tail of a
  # fully hard-broken final word) unless it is the segment's only line.
  if len(cur) > 0 || len(lines) == 0 then
    lines = append(lines, cur)
  lines

@doc("""
Greedy word wrap by characters: `s` split into lines at most `max_chars`
wide. An explicit `"\n"` splits first (each segment wraps on its own), words
break on single spaces, and a word longer than `max_chars` is broken into
pieces. Widths are characters, so multibyte text wraps at the same column
as ASCII.
""",
  returns: "A list of lines; `[s]` when `max_chars <= 0`.",
  example: """wrap("the quick brown fox", 10)   # ["the quick", "brown fox"]""",
  see: ["wrap_px", "preview"])
pub fn wrap(s, max_chars)
  if max_chars <= 0 then
    [s]
  else
    let lines = []
    for seg in split(s, "\n") do
      for line in _wrap_segment(seg, max_chars) do
        lines = append(lines, line)
    lines

# The wrap input is pre-clipped to (max_lines+1)*max_chars characters first,
# so a huge string costs no more than a short one to preview.
@doc("""
The first few wrapped lines of a long string: `text` wrapped to
`max_chars` (as `wrap` does), at most `max_lines` of them, the last ending
in "…" when anything was cut. A huge string costs no more to preview than a
short one.
""",
  returns: """`{lines, truncated}`: `truncated` is true when the last line carries the "…".""",
  see: ["wrap"])
pub fn preview(text, max_chars, max_lines)
  let t = text
  let over = false
  if len(t) > max_chars * (max_lines + 1) then
    t = slice(t, 0, max_chars * (max_lines + 1))
    over = true
  let ls = wrap(t, max_chars)
  if len(ls) > max_lines then
    over = true
  let keep = min(max_lines, len(ls))
  let kept = []
  for j in range(0, keep) do
    let line = ls[j]
    if over && j == keep - 1 then
      # Keep the head, explicit trailing "…" (truncate_head keeps the head;
      # truncate_tail would keep the tail and prefix the ellipsis).
      line = truncate_head(line ++ "…", max_chars)
    kept = append(kept, line)
  {lines: kept, truncated: over}

@doc("""
Draw `text` right-aligned: its right edge sits at `right_x`. `y` is the top
of the line.
""",
  params: {
    style: "A text style record (see `draw_text`). Measuring and drawing then agree even for bold or spaced text, which the bare-`size` form cannot do.",
    size: "A pixel size, in the host's default face.",
    c: "The colour, with `size`.",
  },
  see: ["draw_text_center", "ui.draw_text"])
pub fn draw_text_right(text, right_x, y, size, c)
  _native_text(text, right_x - text_width(text, size), y, size, c.r, c.g, c.b)

pub fn draw_text_right(text, right_x, y, style)
  _native_text(text, right_x - text_width(text, style), y, style)

@doc("""
Draw `text` centred: the run's midpoint sits at `cx`. `y` is the top of the
line.
""",
  params: {
    style: "A text style record (see `draw_text`).",
    size: "A pixel size, in the host's default face.",
    c: "The colour, with `size`.",
  },
  example: """draw_text_center("Paused", r.center_x(), r.y + 8, {size: 18, color: :ffffff})""",
  see: ["draw_text_right", "ui.draw_text"])
pub fn draw_text_center(text, cx, y, size, c)
  _native_text(text, cx - text_width(text, size) / 2, y, size, c.r, c.g, c.b)

pub fn draw_text_center(text, cx, y, style)
  _native_text(text, cx - text_width(text, style) / 2, y, style)

# One walk of the host's advance table, in `text_ellipsize`. This was a
# `text_width` call per character — a native call and a fresh string per step,
# for something a list redraws on every row of every frame — and it had to be
# careful about a hazard the native does not have: len and slice were then
# byte-indexed while text_width counts characters, and "…" is three bytes,
# so a loop that trimmed bytes off a string *already ending* in an ellipsis
# got them snapped back to the character boundary, dropping the whole ellipsis
# and re-adding it. (len and slice count code points now; the walk stays.)
@doc("""
`s` shortened to fit `avail_px`, keeping its start, with a trailing "…":
the pixel-measured `truncate_head`, for text of unknown length in a fixed
box. `s` itself when it already fits.
""",
  params: {size: "A bare pixel size or a text style record. Pass the style you will draw with: measuring a bare 14 and drawing 14-bold overflows the box."},
  see: ["ellipsize_tail", "text_ellipsize"])
pub fn ellipsize(s, avail_px, size)
  text_ellipsize(s, size, float(avail_px), "tail")

# `text_ellipsize`'s "head" end, for the same reason ellipsize above uses it:
# one walk of the advance table rather than a measurement per character.
@doc("""
`s` shortened to fit `avail_px`, keeping its end, with a leading "…": the
pixel-measured `truncate_tail`, and what a file path wants.
"…/panel/src/git_panel.ptl" says which file this is, where `ellipsize`
would spend the box on the directories every row shares. `s` itself when it
already fits.
""",
  params: {size: "A bare pixel size or a text style record, as in `ellipsize`."},
  see: ["ellipsize"])
pub fn ellipsize_tail(s, avail_px, size)
  text_ellipsize(s, size, float(avail_px), "head")

@doc("""
Join `parts` left to right with `"   ·   "` between them, keeping only the
leading run that fits `avail_px`: it stops at the first part that would
overflow and drops it and every part after. A header or metadata line then
degrades by shedding its rightmost segments instead of clipping mid-glyph.
""",
  params: {size: "A bare pixel size or a text style record, as in `ellipsize`."},
  returns: """`{text, count}`: `count` is how many parts survived (0 when even the first overflows).""",
  see: ["fit_parts"])
pub fn fit_parts_n(parts, avail_px, size)
  let out = ""
  let cnt = 0
  let stopped = false
  for i in range(0, len(parts)) do
    if !stopped then
      let cand = parts[i]
      if len(out) > 0 then
        cand = out ++ "   ·   " ++ parts[i]
      if text_width(cand, size) <= avail_px then
        out = cand
        cnt = cnt + 1
      else
        stopped = true
  {text: out, count: cnt}

@doc("""
`fit_parts_n`'s text alone: as many leading `parts` as fit `avail_px`,
joined with `"   ·   "`.
""",
  example: """draw_text(fit_parts([branch, author, date], r.w, 12), r.x, r.y, 12, :aab4c2)""",
  see: ["fit_parts_n"])
pub fn fit_parts(parts, avail_px, size)
  fit_parts_n(parts, avail_px, size).text

# ── Text on a path, and labels that would rather be rotated ───────────────
# **Rotated text is not available.** No host in this ecosystem can rotate a
# text run — the rasterizers place a run by its left/top and scale, and that
# is the whole of the transform they expose. Rather than let every panel
# rediscover that halfway through drawing a chart, the two honest workarounds
# live here.

# The point `d` px along the polyline `points`, and the segment index it fell
# on. Past either end it clamps to the end point.
fn _path_point(points, lens, d)
  let i = 0
  let rest = float(d)
  let last = len(lens) - 1
  while i < last && rest > lens[i] do
    rest = rest - lens[i]
    i = i + 1
  let a = points[i]
  let b = points[i + 1]
  let f = if lens[i] > 0.0 then clamp(rest / lens[i], 0.0, 1.0) else 0.0 end
  {x: float(a.x) + (float(b.x) - float(a.x)) * f,
   y: float(a.y) + (float(b.y) - float(a.y)) * f,
   seg: i}

@doc("""
Draw `s` character by character along a polyline, each glyph upright and
centred on the path: the workaround for the rotated run no host can draw.
An arc of text around a dial, a label following a route, a curved chart
annotation. The glyphs step along the path but never turn, so it reads well
on a gentle curve and badly on a tight one.
""",
  params: {
    points: """The path: `{x, y}` records, in order.""",
    style: "A text style record (see `draw_text`), used to measure and to draw. By default the run is centred on the path; `style.start` places its first glyph that many px along instead.",
  },
  see: ["ui.draw_text"])
pub fn draw_text_along(points, s, style)
  let n = char_len(s)
  if n > 0 && len(points) >= 2 then
    let size = _get(style, "size", 14)
    let lens = []
    let total = 0.0
    for i in range(0, len(points) - 1) do
      let d = distance(points[i].x, points[i].y, points[i + 1].x, points[i + 1].y)
      lens = append(lens, d)
      total = total + d
    let run = float(text_width(s, style))
    let at = float(_get(style, "start", (total - run) / 2.0))
    for i in range(0, n) do
      let ch = char_slice(s, i, i + 1)
      let cw = float(text_width(ch, style))
      # Placed by the glyph's own midpoint, so a proportional face keeps its
      # spacing along the curve instead of bunching at the wide letters.
      let p = _path_point(points, lens, at + cw / 2.0)
      draw_text(ch, {x: p.x - cw / 2.0, y: p.y - float(size) / 2.0}, style)
      at = at + cw
  nil

@doc("""
Chart tick labels under a horizontal axis that drop or stagger instead of
overlapping. Long category labels are usually rotated 45°; since no host
can rotate text, they are kept upright and thinned: a label is drawn only
when it clears the last one drawn, and with `stagger` it drops to a second
row rather than being left out.
""",
  params: {
    r: "The label strip: the band below the plot.",
    ticks: """A list of `{x, label}`, `x` in the same coordinates as `r`.""",
  },
  options: {
    size: "Text size.",
    fg: "Text colour.",
    font: "The face.",
    gap: "The least clear space between neighbours (8 px).",
    stagger: "Alternate rows for labels that would otherwise be dropped.",
  },
  returns: "How many labels were drawn.",
  example: """draw_axis_labels(cut_bottom(plot, 18).cut, [{x: 40, label: "Jan"}, {x: 90, label: "Feb"}], {stagger: true})""",
  see: ["draw_axis_labels_y"])
pub fn draw_axis_labels(r, ticks)
  draw_axis_labels(r, ticks, {})

pub fn draw_axis_labels(r, ticks, style)
  let t = _palette()
  let size = _get(style, "size", t.font_sm)
  let ts = _ts(_face(t, style), size, _get(style, "fg", t.dim))
  let gap = _get(style, "gap", 8)
  let stagger = _get(style, "stagger", false)
  let rows = if stagger then 2 else 1 end
  # The rightmost x each row has committed to, so a row only has to clear its
  # own neighbours. Two rows is the whole stagger, so two cells is the whole
  # bookkeeping.
  let taken_0 = r.x - gap
  let taken_1 = r.x - gap
  let drawn = 0
  let row = 0
  for tick in ticks do
    let label = str(tick.label)
    let w = text_width(label, ts)
    # Centred on the tick, but never hanging outside the strip: the first and
    # last label of an axis otherwise run off the plot.
    let x = clamp(tick.x - w / 2, r.x, max(r.x, r.x + r.w - w))
    let taken = if row == 0 then taken_0 else taken_1 end
    if x >= taken + gap then
      draw_text(label, {x: x, y: r.y + row * (size + 4)}, ts)
      if row == 0 then
        taken_0 = x + w
      else
        taken_1 = x + w
      drawn = drawn + 1
      row = (row + 1) % rows
  drawn

@doc("""
Labels for a y axis: right-aligned against `r`'s right edge and centred on
their ticks, dropping a label that would overlap the last one drawn.
""",
  params: {ticks: """A list of `{y, label}`."""},
  options: {size: "Text size.", fg: "Text colour.", font: "The face.", gap: "The least clear space between neighbours."},
  returns: "How many labels were drawn.",
  see: ["draw_axis_labels"])
pub fn draw_axis_labels_y(r, ticks)
  draw_axis_labels_y(r, ticks, {})

pub fn draw_axis_labels_y(r, ticks, style)
  let t = _palette()
  let size = _get(style, "size", t.font_sm)
  let ts = _ts(_face(t, style), size, _get(style, "fg", t.dim))
  let gap = _get(style, "gap", 4)
  let taken = r.y - gap - size
  let drawn = 0
  for tick in ticks do
    let label = str(tick.label)
    let y = clamp(tick.y - size / 2, r.y, max(r.y, r.y + r.h - size))
    if y >= taken + gap then
      draw_text_right(label, r.x + r.w, y, ts)
      taken = y + size
      drawn = drawn + 1
  drawn

# ── Clipboard ───────────────────────────────────────────────────────────────
# Host side: `petal_ui::clipboard` (`set_clipboard_provider`, and
# `flush_clipboard` after the run for a host that does not use `FrameCore`).

@doc("""
The text on the system clipboard, `""` when it has none. Line breaks arrive
as `\n`. With a host clipboard attached, the text is refreshed on frames
where `v` or `insert` went down, which is when a paste happens; a host with
no system clipboard keeps the text in memory, so a copy still carries from
one field to another. `text_field` calls it; an app needs it only for its
own paste command.
""", see: ["clipboard_set"])
pub fn clipboard_get()
  binding(symbol("clipboard")) ?? ""

@doc("""
Put `text` on the system clipboard. The write lands when the frame ends, so
`clipboard_get` reads it back from the next frame on.
""", see: ["clipboard_get"])
pub fn clipboard_set(text)
  push_output(symbol("clipboard_write"), text)

# ── Text ranges ─────────────────────────────────────────────────────────────
# Every offset here is a character (code point) offset, the unit `char_slice`
# and `char_len` use, so non-ASCII text needs no special care.

@doc("""
`text_wrap` with each row's place in the source, for carets and selections
in wrapped text. What the wrap drops (the space a soft break lands on, the
newline of a hard one) lies between one row's `end` and the next row's
`start`, so an offset in such a gap belongs to the end of the earlier row.
""",
  returns: """A list of `{text, start, end}`, where `char_slice(s, start, end) == text`.""",
  example: """
    let rows = text_wrap_rows(body, style, 320.0)
    for q in text_range_rects(rows, style, hit_start, hit_end, 21) do
      draw_rect(x + q.x, y + q.y, q.w, q.h, MARK)
    for i in range(0, len(rows)) do
      draw_text(rows[i].text, {x: x, y: y + i * 21}, style)
  """,
  see: ["text_row_of", "text_range_rects", "text_wrap"])
pub fn text_wrap_rows(s, style, max_width)
  let st = if type(style) == "record" then {...style, offsets: true} else {size: style, offsets: true} end
  text_wrap(s, st, max_width)

# The rows of unwrapped text: one per hard newline, in the shape
# `text_wrap_rows` returns.
fn _line_rows(s)
  let rows = []
  let at = 0
  for line in split(s, "\n") do
    let n = char_len(line)
    rows = append(rows, {text: line, start: at, end: at + n})
    at = at + n + 1
  rows

@doc("""
The index of the row a caret at character `at` sits on: the last row that
starts at or before it. A caret in the gap after a soft break (on the
trailing space that was dropped) stays on the row it was typed on, and one
at a hard break belongs to the row that starts there.
""", params: {rows: "Rows from `text_wrap_rows`."}, see: ["text_wrap_rows"])
pub fn text_row_of(rows, at)
  let idx = 0
  for i in range(0, len(rows)) do
    if at >= rows[i].start then idx = i end
  idx

@doc("""
The rects that cover characters `a` up to (not including) `b` of `s` drawn
in `style`: a selection highlight, a search hit, a spelling underline. One
rect per row the range touches, relative to the text's top-left (add the
position you draw at). A range that runs past a row's end covers a sliver
for the line break, so a selected empty line still shows.
""",
  params: {
    s: "A string, laid out one row per hard newline, or the rows from `text_wrap_rows` for wrapped text.",
    line_h: "The row step, for text drawn at a line height other than the face's `line_height`.",
  },
  returns: """A list of `{x, y, w, h}`.""",
  see: ["text_wrap_rows"])
pub fn text_range_rects(s, style, a, b)
  text_range_rects(s, style, a, b, text_metrics(style).line_height)

pub fn text_range_rects(s, style, a, b, line_h)
  let rows = if type(s) == "string" then _line_rows(s) else s end
  let lo = min(a, b)
  let hi = max(a, b)
  let out = []
  for i in range(0, len(rows)) do
    let row = rows[i]
    let from = max(lo, row.start)
    let to = min(hi, row.end)
    let past = hi > row.end && lo <= row.end && i < len(rows) - 1
    if from < to || past then
      let x0 = text_width(char_slice(row.text, 0, from - row.start), style)
      let x1 = if to > from then text_width(char_slice(row.text, 0, to - row.start), style) else x0 end
      let pad = if past then max(2, int(line_h / 4)) else 0 end
      out = append(out, {x: x0, y: i * line_h, w: x1 - x0 + pad, h: line_h})
  out
