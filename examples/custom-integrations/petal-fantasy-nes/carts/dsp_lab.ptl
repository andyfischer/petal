// dsp_lab — sound synthesized by Petal itself, both ways round.
//
//   cargo run -- carts/dsp_lab.ptl
//   SELECT       switch between the two paths
//   UP/DOWN      pick a sound / a knob
//   LEFT/RIGHT   change it
//   A            play the selected sound / gate the realtime synth
//   B            time the ahead-of-time render of the selected sound
//
// The chip channels in `sound_lab` are Rust. Everything here is not: the
// waveforms below are ordinary Petal functions of (time, sample index), and
// the host's only job is to ask for blocks of samples and hand them to SDL.
//
// There are two ways to do that, and this cart runs both so the difference is
// measurable rather than argued about:
//
//   BANKED    `register_sound(name, seconds, fn_name)` — the host calls the
//             function once at load, in blocks, caches the result and replays
//             it from memory. Any cost is paid on the loading screen; playing
//             is free. Re-rendered automatically when the cart hot-reloads.
//
//   REALTIME  `enable_dsp(fn_name)` — the same function signature, called once
//             per frame for the next frame's worth of samples and mixed live.
//             The parameters can change every frame, so the sound can follow
//             the game. It costs real milliseconds out of the frame, every
//             frame, and the meter on that screen shows how many.
//
// Blocks are stateless: the callback gets the *absolute* sample index, and the
// same index must always produce the same sample. That is what lets the banked
// path render out of order and the realtime path survive a dropped frame.
//
// All the input handling happens at the top level rather than inside the two
// screen functions, because `set` on a `var` declared outside a function is
// deliberately not allowed — the screens draw, the top level decides.

set_backdrop(black)
palette(0, white, gray, dark_gray)      // labels
palette(1, yellow, orange, brown)       // selection, and "expensive"
palette(2, green, dark_green, olive)    // meters, and "cheap"
palette(3, cyan, teal, navy)            // waveforms

define_art(0, ["........"])
define_art(1, ["11111111", "11111111", "11111111", "11111111",
  "11111111", "11111111", "11111111", "11111111"])
define_art(2, ["33333333", "33333333", "33333333", "33333333",
  "33333333", "33333333", "33333333", "33333333"])

set_map_size(32, 30)
fill_map(0, 0)

let sample_rate = 44100
let frame_budget_ms = 1000.0 / 60.0

// What the host will actually tolerate before it fades the DSP bus out. It is
// a *slice* of the frame, not the frame — the rest belongs to the script, the
// rasterizer and SDL. The host does not publish the number, so it is written
// here to match `audio.rs`'s `DSP_BUDGET_MS`; if that moves, this line has to.
let dsp_budget_ms = 2.0

// One frame's worth of samples: what the host asks the realtime callback for,
// and therefore the divisor that turns `dsp_cost_ms()` into a per-sample cost.
let block_samples = sample_rate / 60

// ── The synthesis primitives ──────────────────────────────────────────────
// `nes_sound` ships the oscillators and envelopes (`osc_*`, `env_*`); this is
// the loop that turns one of them into a block. It writes into an `f64_array`
// rather than appending to a list because the samples are plain floats and the
// array skips the per-element boxing — which is a good part of the difference
// between realtime being viable and not.

fn render_block(start, count, rate, f)
  let out = f64_array(count)
  for k in range(0, count) do
    let i = start + k
    out[k] = f(i / float(rate), i)
  end
  out
end

// ── Path 1: banked sounds ─────────────────────────────────────────────────
// Four one-shots, each a single expression. They are top-level *named*
// functions because `register_sound` takes the name of one — the host calls
// back into the script by name, so a closure would have nothing to look up.

fn snd_laser(start, count, rate)
  render_block(start, count, rate, fn(t, i) ->
    osc_square(t, 1400.0 - 1150.0 * t / 0.28, 1) * env_decay(t, 0.28) * 0.7)
end

fn snd_coin(start, count, rate)
  // Two pitches, the second a fifth up after 60 ms — an arpeggio short enough
  // to read as one sound.
  render_block(start, count, rate, fn(t, i) ->
    osc_square(t, if t < 0.06 then 988.0 else 1480.0 end, 2)
    * env_ad(t, 0.005, 0.30) * 0.6)
end

fn snd_thud(start, count, rate)
  // Noise plus a falling sine: the shape of every kick drum ever sampled.
  render_block(start, count, rate, fn(t, i) ->
    (osc_noise(i) * 0.35 * env_decay(t, 0.09)
      + osc_sine(t, 160.0 - 110.0 * t / 0.22) * env_decay(t, 0.22)) * 0.8)
end

fn snd_chord(start, count, rate)
  // Four detuned saws, a minor triad. Additive synthesis is trivial here and
  // impossible on the chip, which is most of the reason this path exists.
  render_block(start, count, rate, fn(t, i) ->
    (osc_saw(t, 220.0) + osc_saw(t, 261.63) + osc_saw(t, 329.63)
      + osc_saw(t, 220.6)) * 0.18 * env_adsr(t, 0.02, 0.15, 0.55, 0.25, 0.55))
end

// label, name, seconds, and the function itself — the last one only so the cart
// can time and draw the sound without going through the host.
let bank = [
  ["LASER", "snd_laser", 0.28, snd_laser],
  ["COIN", "snd_coin", 0.36, snd_coin],
  ["THUD", "snd_thud", 0.30, snd_thud],
  ["CHORD", "snd_chord", 0.80, snd_chord]
]

// Idempotent and re-issued every frame, like every other resource in a cart:
// the host holds what it already rendered and only re-renders what changed.
for s in bank do
  register_sound(s[1], s[2], s[1])
end

// Which row the cursor is on, declared up here because `probe_block` below
// reads it and a function can only see what was declared before it.
state var pick = 0

// ── Timing the banked path ────────────────────────────────────────────────
// The host renders a banked sound out of sight, at load, and never says how
// long it took — and a cart cannot time it itself, because `time()` is a
// per-frame binding and does not move while a frame is running.
//
// So the cost is measured where the host *does* publish a number: the realtime
// bus. `probe_block` runs the selected sound's own render function over one
// frame's worth of its samples and then throws the result away, returning
// silence, so `dsp_cost_ms()` reports the cost of exactly that work with
// nothing audible. Divide by the block size, multiply by the sound's length,
// and you have an honest estimate of what banking it costs — measured, not
// guessed, and gathered from the same machine and the same build.
fn probe_block(start, count, rate)
  let s = bank[get pick]
  let n = max(1, int(s[2] * float(rate)))
  s[3](pmod(start, n), count, rate)
  f64_array(count)
end

// ── Path 2: the realtime synth ────────────────────────────────────────────
// The knobs live in `state` so they survive frames and hot reloads. The
// callback reads them with `get`, which is the only way to see a var's current
// value from inside a function — a bare name captures the value the function
// was defined with, which for a script re-run every frame would mean the knobs
// never appeared to move at all.

state var dsp_note = 45
state var dsp_wave = 2
state var dsp_detune = 6
state var dsp_vib = 3
state var dsp_level = 5
state var dsp_on = true

let wave_names = ["PULSE 50%", "PULSE 12%", "SAW", "TRIANGLE", "SINE"]

fn wave_at(kind, t, hz)
  if kind == 0 then osc_square(t, hz, 2)
  elsif kind == 1 then osc_square(t, hz, 0)
  elsif kind == 2 then osc_saw(t, hz)
  elsif kind == 3 then osc_tri(t, hz)
  else osc_sine(t, hz) end
end

// One sample of the live voice: two copies of the wave a few cents apart, with
// a slow vibrato on both. The detune is what makes it sound like something the
// chip cannot do; it is also two oscillator evaluations per sample, which is
// what the cost meter is measuring.
fn dsp_voice(t)
  if !(get dsp_on) then
    0.0
  else
    let hz = note_hz(get dsp_note)
    let vib = 1.0 + 0.02 * float(get dsp_vib) * osc_sine(t, 5.5)
    let k = get dsp_wave
    let a = wave_at(k, t, hz * vib)
    let b = wave_at(k, t, hz * vib * (1.0 + 0.0015 * float(get dsp_detune)))
    (a + b) * 0.5 * 0.05 * float(get dsp_level)
  end
end

// The block the host actually calls. It does not go through `render_block` or
// `dsp_voice`: everything that does not change within a block — the frequency,
// the gains, the detune ratio — is hoisted out of the loop, because at 735
// samples a frame the per-sample cost is the only cost there is, and the host
// fades the bus out if it overruns its slice. `dsp_voice` above stays as the
// readable definition of one sample, and is what the on-screen plot draws.
fn dsp_block(start, count, rate)
  let out = f64_array(count)
  if get dsp_on then
    let k = get dsp_wave
    let hz = note_hz(get dsp_note)
    let vd = 0.02 * float(get dsp_vib)
    let dt = 1.0 + 0.0015 * float(get dsp_detune)
    let g = 0.05 * float(get dsp_level) * 0.5
    for j in range(0, count) do
      let t = (start + j) / float(rate)
      let f = hz * (1.0 + vd * osc_sine(t, 5.5))
      out[j] = (wave_at(k, t, f) + wave_at(k, t, f * dt)) * g
    end
  end
  out
end

// ── Mode ──────────────────────────────────────────────────────────────────

start_scene("banked")
if btnp("select") then
  set_scene(if scene() == "banked" then "realtime" else "banked" end)
end

let realtime = scene() == "realtime"

// The chip stays silent throughout: this cart only ever proves the Petal
// paths, and a channel left ringing underneath would muddy what you hear.
apu_mute()

// `enable_dsp("")` is the documented way to switch the bus off, and switching
// it off on the banked screen is the point — otherwise the cost meter would be
// measuring a synth nobody on that screen asked for.
state var probe = false
enable_dsp(if realtime then "dsp_block" elsif probe then "probe_block" else "" end)

// ── Input ─────────────────────────────────────────────────────────────────

// label, low, high — one row per knob on the realtime screen.
let knobs = [
  ["NOTE", 24, 96],
  ["WAVE", 0, 4],
  ["DETUNE", 0, 30],
  ["VIBRATO", 0, 15],
  ["LEVEL", 0, 10]
]

let rows = if realtime then len(knobs) else len(bank) end
if btnp("down") then
  set pick = pmod(pick + 1, rows)
end
if btnp("up") then
  set pick = pmod(pick - 1, rows)
end
if pick >= rows then
  set pick = 0
end

if realtime then
  if btnp("a") then
    set dsp_on = !dsp_on
  end
  let step = (if btn_repeat("right", 0.3, 0.04) then 1 else 0 end) -
  (if btn_repeat("left", 0.3, 0.04) then 1 else 0 end)
  if step != 0 then
    let k = knobs[pick]
    if pick == 0 then
      set dsp_note = clamp(dsp_note + step, k[1], k[2])
    elsif pick == 1 then
      set dsp_wave = clamp(dsp_wave + step, k[1], k[2])
    elsif pick == 2 then
      set dsp_detune = clamp(dsp_detune + step, k[1], k[2])
    elsif pick == 3 then
      set dsp_vib = clamp(dsp_vib + step, k[1], k[2])
    else
      set dsp_level = clamp(dsp_level + step, k[1], k[2])
    end
  end
else
  if btnp("a") then
    play_sound(bank[pick][1])
  end
  if btnp("b") then
    set probe = !probe
  end
end

// ── Shared drawing ────────────────────────────────────────────────────────

map_text_center(0, "DSP LAB", 0)
map_text(2, 2, "BANKED", if realtime then 0 else 1 end)
map_text(12, 2, "REALTIME", if realtime then 1 else 0 end)
map_text_right(31, 2, "SEL SWAP", 0)

// Two ways to draw `f(t)`, and the difference matters: at 30 columns across a
// third of a second, one sample per column is pure aliasing and would draw a
// lie. So a whole sound is drawn as its *envelope* — the loudest excursion
// inside each column's slice of time, mirrored about the centre line, the way
// an audio editor draws a file — and only a span of a couple of cycles is drawn
// sample-by-sample as an actual wave.
//
// Both are normalized to their own peak, so they show the *shape* and not the
// level — at half a dozen cells of vertical room a quiet sound would otherwise
// flatten into a straight line. The level has its own meter.

fn plot_wave(x_cell, y_cell, w, half, span, f)
  let vs = []
  let peak = 0.0001
  for c in range(0, w) do
    let v = f(span * c / float(w))
    vs = append(vs, v)
    peak = max(peak, abs(v))
  end
  map_rect(x_cell, y_cell - half, w, half * 2 + 1, 0, 0)
  for c in range(0, w) do
    let h = int(round(vs[c] / peak * half))
    if h >= 0 then
      map_rect(x_cell + c, y_cell - h, 1, h + 1, 1, 3)
    else
      map_rect(x_cell + c, y_cell, 1, -h + 1, 1, 3)
    end
  end
end

fn plot_envelope(x_cell, y_cell, w, half, span, f)
  let probes = 12
  let vs = []
  let peak = 0.0001
  for c in range(0, w) do
    let v = 0.0
    for s in range(0, probes) do
      v = max(v, abs(f(span * (c + s / float(probes)) / float(w))))
    end
    vs = append(vs, v)
    peak = max(peak, v)
  end
  map_rect(x_cell, y_cell - half, w, half * 2 + 1, 0, 0)
  for c in range(0, w) do
    let h = clamp(int(round(vs[c] / peak * half)), 0, half)
    map_rect(x_cell + c, y_cell - h, 1, h * 2 + 1, 1, 3)
  end
end

// ── The banked screen ─────────────────────────────────────────────────────

fn screen_banked(pick, probe, block_samples)
  map_text(1, 4, "SOUND", 0)
  map_text(10, 4, "SECS", 0)
  map_text(15, 4, "SAMPLES", 0)
  map_text(23, 4, "TO BANK", 0)

  // The probe only ever measures the selected sound, because only one function
  // can be on the DSP bus at a time. Move the cursor and the number follows.
  let per_sample = dsp_cost_ms() / float(block_samples)

  for i in range(0, len(bank)) do
    let s = bank[i]
    let pal = if i == pick then 1 else 0 end
    let y = 6 + i * 2
    let n = int(s[2] * float(sample_rate))
    map_text(0, y, if i == pick then ">" else " " end, pal)
    map_text(1, y, s[0], pal)
    map_text(10, y, str(s[2]), pal)
    map_text(15, y, str(n), pal)
    map_text(23, y, "        ", pal)
    if probe && i == pick then
      map_text(23, y, "{round(per_sample * float(n), 1)}MS", pal)
    else
      map_text(23, y, "-", pal)
    end
  end

  // The selected sound's own shape, envelope and all, over its full length.
  let sel = bank[pick]
  map_text(1, 14, "{sel[0]}: {sel[2]}S OF PETAL", 3)
  plot_envelope(1, 20, 30, 4, sel[2], fn(t) -> sel[3](int(t * float(sample_rate)), 1, sample_rate)[0])

  map_text(1, 26, "A PLAY  UD PICK  B PROBE " ++ (if probe then "ON " else "OFF" end), 0)
  map_text(1, 27, "PROBE RUNS IT MUTED, TO MEASURE", 0)
  map_text(1, 28, "BANKED PLAYBACK ITSELF IS FREE", 2)
end

// ── The realtime screen ───────────────────────────────────────────────────

fn screen_realtime(pick, knobs, vals, on)
  let shown = [note_name(vals[0]), wave_names[vals[1]],
    str(vals[2]), str(vals[3]), str(vals[4])]

  map_text(1, 4, if on then "SYNTH ON " else "SYNTH OFF" end, 1)
  map_text_right(31, 4, "{block_samples} SPL/FRAME", 0)
  for i in range(0, len(knobs)) do
    let y = 6 + i * 2
    let pal = if i == pick then 1 else 0 end
    map_text(0, y, if i == pick then ">" else " " end, pal)
    map_text(1, y, knobs[i][0], pal)
    map_text(9, y, "          ", pal)
    map_text(9, y, shown[i], pal)
    let span = knobs[i][2] - knobs[i][1]
    let lit = int(round(10 * (vals[i] - knobs[i][1]) / span))
    map_rect(20, y, 10, 1, 2, 0)
    map_rect(20, y, max(0, lit), 1, 1, 2)
  end

  // Two cycles of whatever the knobs currently say, so the shape on screen and
  // the sound in the room are the same function.
  plot_wave(1, 18, 30, 3, 2.0 / max(1.0, note_hz(vals[0])), fn(t) -> dsp_voice(t))

  // ── The cost meter ──────────────────────────────────────────────────────
  // `dsp_cost_ms()` is the host's own measurement of the last call, the cost of
  // handing the block back included. The bar is against one 60 Hz frame, so
  // "half full" means half of every frame is being spent inside Petal making
  // noise. The verdict line is computed from that, not asserted.
  let ms = dsp_cost_ms()
  let frac = ms / dsp_budget_ms
  let lit = clamp(int(round(28 * frac)), 0, 28)
  let hot = if frac > 0.6 then 1 else 2 end

  map_text(1, 22, "COST {round(ms, 3)} MS  OF {dsp_budget_ms} MS SLICE", 0)
  map_text(1, 23, "= {round(ms / frame_budget_ms * 100.0, 1)}% OF A 60HZ FRAME", 0)
  map_rect(1, 24, 28, 1, 2, 0)
  map_rect(1, 24, lit, 1, 1, hot)

  let headroom = if ms <= 0.0 then 0.0 else dsp_budget_ms / ms end
  let verdict = if ms <= 0.0 then "MEASURING..."
  elsif frac < 0.5 then "VIABLE: {round(headroom, 1)}X HEADROOM"
  elsif frac < 1.0 then "TIGHT: {round(headroom, 1)}X HEADROOM"
  else "OVER SLICE: HOST FADES IT OUT" end
  map_text(1, 26, verdict, if frac < 0.75 then 2 else 1 end)

  map_text(1, 28, "UD PICK  LR CHANGE  A GATE", 0)
end

if realtime then
  screen_realtime(pick, knobs, [dsp_note, dsp_wave, dsp_detune, dsp_vib, dsp_level], dsp_on)
else
  screen_banked(pick, probe, block_samples)
end
