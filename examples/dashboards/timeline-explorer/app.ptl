// ─────────────────────────────────────────────────────────────────────────────
// CHRONICLE — a timeline explorer
//
// Sixty-eight years of spaceflight on one zoomable time axis: six category
// lanes, point events and long-running programs, a calendar-aware ruler that
// re-ticks from decades down to single days, filters that re-pack the lanes,
// an overview strip with a draggable window, and an inspector.
//
//   Run:   ./launch.sh            (headless: ./launch.sh --headless --debug-port 0)
//   Mouse: wheel zoom at the pointer · drag to pan · drag the ruler to zoom a
//          range · click an event · double-click to zoom in
//   Keys:  left/right pan · up/down or +/- zoom · n/p next/previous event ·
//          return zoom to the event · 1-6 categories · / search · 0 fit all
// ─────────────────────────────────────────────────────────────────────────────

// ── Palette ──────────────────────────────────────────────────────────────────
// A near-black blue ground with two surface steps. Six lane hues of matched
// lightness, and one warm accent that is only ever used for "you are here":
// the selection, the pointer's date flag and the overview window.
let BG      = #0a0d13
let PANEL   = #0e121a
let RAISED  = #161b26
let HOVER   = #1b2230
let LINE    = #1e2532
let LINE_HI = #2d3647
let GRID    = #131822
let TEXT    = #e9ecf3
let SOFT    = #bcc3d0
let DIM     = #8992a3
let FAINT   = #586174
let ACCENT  = #ffd27a

let CAT_NAME = ["Crewed flight", "Space stations", "The Moon", "Deep space", "Observatories", "Orbit & launch"]
let CAT_COL  = [#f0a55c, #56c7bd, #b7a2f7, #ee7480, #73a6ff, #8ecf6c]
let ORG_NAME = ["United States", "USSR / Russia", "Europe", "China", "India", "Japan", "Commercial", "International"]
let IMP_NAME = ["", "Landmark", "Notable", "Detail"]

let CREW = 0
let STATION = 1
let MOON = 2
let DEEP = 3
let SCOPE = 4
let LAUNCH = 5

let USA = 0
let SOV = 1
let EUR = 2
let CHN = 3
let IND = 4
let JPN = 5
let COM = 6
let INTL = 7

// ── Type ─────────────────────────────────────────────────────────────────────
// Inter for words, JetBrains Mono for anything that is a number or a date.
// Five sizes in all.

fn ui(size, c)
  {size: size, font: "ui", color: c}
end

fn uib(size, c)
  {size: size, font: "ui", color: c, weight: 700}
end

fn mono(size, c)
  {size: size, font: "mono", color: c}
end

fn caps(c)
  {size: 10, font: "ui", color: c, spacing: 1.5, weight: 700}
end

fn tx(s, x, y, st)
  draw_text(s, {x: x, y: y}, st)
end

fn tx_right(s, right_x, y, st)
  draw_text(s, {x: right_x - text_width(s, st), y: y}, st)
end

fn tx_center(s, cx, y, st)
  draw_text(s, {x: cx - text_width(s, st) / 2.0, y: y}, st)
end

// The y that vertically centres a run of `size` in a box: a run is drawn at the
// top of a 1.4x line box.
fn vmid(y, h, size)
  y + (h - size * 1.4) / 2.0
end

fn imin(a, b)
  if a < b then a else b end
end

fn imax(a, b)
  if a > b then a else b end
end

// ── Calendar ─────────────────────────────────────────────────────────────────
// Time is a day number: day 0 is 1 January 1950, and the view holds it as a
// float so a zoom can land between days. The two conversions are the usual
// era/day-of-era arithmetic on a March-based year; every quantity stays
// positive, so truncating division is floor division throughout.

let EPOCH = 712163        // days from 0000-03-01 to 1950-01-01
let D0 = 2191             // 1956-01-01, the left edge of the domain
let D1 = 28124            // 2027-01-01, the right edge
let AS_OF = 27575         // 2025-07-01: where a still-running program is drawn to
let DOM = 25933.0         // D1 - D0
let MIN_SPAN = 10.0       // the tightest zoom: ten days across the plot

let MON = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
let MONTH = ["January", "February", "March", "April", "May", "June", "July", "August",
  "September", "October", "November", "December"]

fn day_of(y, m, d)
  let yy = if m <= 2 then y - 1 else y end
  let era = yy / 400
  let yoe = yy - era * 400
  let mp = if m > 2 then m - 3 else m + 9 end
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - EPOCH
end

fn civil(z)
  let zz = z + EPOCH
  let era = zz / 146097
  let doe = zz - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 then mp + 3 else mp - 9 end
  let y = yoe + era * 400 + (if m <= 2 then 1 else 0 end)
  {y: y, m: m, d: d}
end

fn pad2(n)
  if n < 10 then "0" ++ str(n) else str(n) end
end

fn iso(t)
  let c = civil(int(floor(t)))
  str(c.y) ++ "-" ++ pad2(c.m) ++ "-" ++ pad2(c.d)
end

fn fmt_day(z)
  let c = civil(z)
  str(c.d) ++ " " ++ MON[c.m - 1] ++ " " ++ str(c.y)
end

fn fmt_mon(z)
  let c = civil(z)
  MON[c.m - 1] ++ " " ++ str(c.y)
end

// A date as precise as the zoom can resolve: there is no point naming a day
// when a pixel is a month wide.
fn fmt_at(t, ppd)
  let z = int(floor(t))
  if ppd >= 0.9 then fmt_day(z)
  elsif ppd >= 0.012 then fmt_mon(z)
  else str(civil(z).y)
  end
end

fn plural(n, word)
  if n == 1 then "1 " ++ word else str(n) ++ " " ++ word ++ "s" end
end

fn fmt_dur(days)
  if days < 60 then
    plural(days, "day")
  elsif days < 360 then
    plural(int(round(float(days) / 30.44)), "month")
  else
    let months = int(round(float(days) / 30.4375))
    let y = months / 12
    let mo = months % 12
    if mo == 0 then plural(y, "year") else plural(y, "year") ++ ", " ++ plural(mo, "month") end
  end
end

fn fmt_span(days)
  if days >= 730.0 then
    str(round(days / 365.25, 1)) ++ " years"
  elsif days >= 60.0 then
    plural(int(round(days / 30.44)), "month")
  else
    plural(int(round(days)), "day")
  end
end

// ── Events ───────────────────────────────────────────────────────────────────

class Ev
  cat: int,
  org: int,
  imp: int,       // 1 landmark, 2 notable, 3 detail
  t0: int,
  t1: int,        // == t0 for a point event
  live: bool,     // a program that is still running
  title: string,
  blurb: string,
  yr: int,
end

fn P(cat, org, imp, y, m, d, title, blurb)
  let t = day_of(y, m, d)
  Ev(cat, org, imp, t, t, false, title, blurb, y)
end

fn S(cat, org, imp, y0, m0, d0, y1, m1, d1, title, blurb)
  Ev(cat, org, imp, day_of(y0, m0, d0), day_of(y1, m1, d1), false, title, blurb, y0)
end

fn O(cat, org, imp, y, m, d, title, blurb)
  Ev(cat, org, imp, day_of(y, m, d), AS_OF, true, title, blurb, y)
end

fn build_events()
  assert_eq(day_of(1950, 1, 1), 0)
  assert_eq(day_of(1956, 1, 1), D0)
  assert_eq(day_of(2027, 1, 1), D1)
  assert_eq(day_of(2025, 7, 1), AS_OF)
  let c = civil(day_of(1969, 7, 20))
  assert_eq(c.y * 10000 + c.m * 100 + c.d, 19690720)
  let c2 = civil(day_of(2000, 2, 29))
  assert_eq(c2.y * 10000 + c2.m * 100 + c2.d, 20000229)
  let raw = [
    // Crewed flight
    P(CREW, SOV, 1, 1961, 4, 12, "Vostok 1", "Yuri Gagarin completes one orbit in 108 minutes and becomes the first human in space."),
    S(CREW, USA, 2, 1961, 5, 5, 1963, 5, 16, "Project Mercury", "Six crewed flights, from Alan Shepard's fifteen-minute hop to Gordon Cooper's 34 hours in orbit."),
    P(CREW, USA, 2, 1962, 2, 20, "Friendship 7", "John Glenn circles the Earth three times, the first American in orbit."),
    P(CREW, SOV, 2, 1963, 6, 16, "Vostok 6", "Valentina Tereshkova becomes the first woman in space, flying 48 orbits alone."),
    P(CREW, SOV, 2, 1965, 3, 18, "Voskhod 2", "Alexei Leonov floats outside for twelve minutes: the first spacewalk."),
    S(CREW, USA, 2, 1965, 3, 23, 1966, 11, 15, "Project Gemini", "Ten two-person flights rehearse rendezvous, docking and long-duration flight for the Moon program."),
    P(CREW, USA, 3, 1967, 1, 27, "Apollo 1 fire", "A cabin fire during a launch rehearsal kills Grissom, White and Chaffee and forces a redesign of the spacecraft."),
    P(CREW, INTL, 2, 1975, 7, 17, "Apollo-Soyuz", "An American Apollo and a Soviet Soyuz dock in orbit, and the crews shake hands through the hatch."),
    S(CREW, USA, 1, 1981, 4, 12, 2011, 7, 21, "Space Shuttle", "135 flights of a reusable winged orbiter: satellites, Spacelab, Hubble servicing and most of the ISS."),
    P(CREW, USA, 2, 1986, 1, 28, "Challenger lost", "The orbiter breaks apart 73 seconds after liftoff, killing all seven aboard. Flights stop for 32 months."),
    P(CREW, USA, 2, 2003, 2, 1, "Columbia lost", "Damaged by foam at launch, Columbia disintegrates on re-entry. The accident sets the Shuttle's retirement in motion."),
    P(CREW, CHN, 2, 2003, 10, 15, "Shenzhou 5", "Yang Liwei orbits for 21 hours, making China the third nation to launch its own astronauts."),
    P(CREW, COM, 3, 2004, 10, 4, "SpaceShipOne", "A privately built rocket plane reaches space twice in a week and claims the Ansari X Prize."),
    P(CREW, COM, 1, 2020, 5, 30, "Crew Dragon Demo-2", "Behnken and Hurley ride a SpaceX capsule to the ISS, the first crewed orbital flight by a private company."),
    P(CREW, COM, 3, 2021, 9, 16, "Inspiration4", "Four private citizens spend three days in orbit with no professional astronaut aboard."),
    P(CREW, COM, 3, 2024, 9, 12, "Polaris Dawn spacewalk", "Two members of a private crew step outside their Dragon capsule, the first commercial spacewalk."),

    // The Moon
    P(MOON, SOV, 2, 1959, 9, 13, "Luna 2", "The first human-made object to reach another world strikes the Moon east of Mare Imbrium."),
    P(MOON, SOV, 3, 1959, 10, 7, "Luna 3", "Loops behind the Moon and radios back the first photographs of its far side."),
    S(MOON, USA, 1, 1961, 5, 25, 1972, 12, 19, "Apollo program", "From Kennedy's challenge to Congress to the splashdown of Apollo 17: twelve people walk on the Moon."),
    P(MOON, USA, 3, 1964, 7, 31, "Ranger 7", "Returns more than 4,000 close-up images in its final minutes before impact."),
    P(MOON, SOV, 2, 1966, 2, 3, "Luna 9", "The first soft landing on the Moon, and the first pictures from its surface."),
    P(MOON, USA, 3, 1966, 6, 2, "Surveyor 1", "America's first soft lander proves the surface can bear the weight of a spacecraft."),
    S(MOON, USA, 1, 1968, 12, 21, 1968, 12, 27, "Apollo 8", "Borman, Lovell and Anders become the first people to leave Earth orbit, circling the Moon ten times."),
    P(MOON, USA, 3, 1968, 12, 24, "Earthrise", "On the fourth orbit Bill Anders photographs the Earth coming up over the lunar horizon."),
    P(MOON, USA, 2, 1969, 7, 20, "Eagle lands", "The lunar module touches down with under a minute of fuel left. Six hours later Armstrong steps onto the surface."),
    S(MOON, USA, 1, 1969, 7, 16, 1969, 7, 24, "Apollo 11", "Armstrong and Aldrin land in the Sea of Tranquility on 20 July while Collins keeps watch in orbit."),
    S(MOON, USA, 2, 1970, 4, 11, 1970, 4, 17, "Apollo 13", "An oxygen tank ruptures on the way out. The crew use the lunar module as a lifeboat and come home."),
    P(MOON, SOV, 3, 1970, 11, 17, "Lunokhod 1", "The first remote-controlled rover on another world drives for ten months."),
    S(MOON, USA, 2, 1972, 12, 7, 1972, 12, 19, "Apollo 17", "The last crewed landing. Cernan and the geologist Harrison Schmitt spend three days in the Taurus-Littrow valley."),
    P(MOON, SOV, 3, 1976, 8, 18, "Luna 24", "Drills two metres into Mare Crisium and returns the last lunar samples for 44 years."),
    P(MOON, USA, 3, 1994, 1, 25, "Clementine", "Maps the Moon in eleven wavelengths and hints at ice in the polar craters."),
    P(MOON, IND, 3, 2008, 10, 22, "Chandrayaan-1", "India's first lunar orbiter carries the instrument that confirms water molecules across the surface."),
