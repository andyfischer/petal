// State Machine
// Using enums and state to model a traffic light controller.
//
// The light's phase is the *program's* state, not the state of any one call, so
// it lives in top-level `state var` cells: one cell for the whole program, read
// with `get` and written with `set` from anywhere. Declaring it inside
// `traffic_light()` instead would give the controller a fresh cell for every
// tick of the loop below — a light that is forever on its first frame.

enum Light
  Red,
  Yellow,
  Green,
end

state var current = Red
state var ticks_in_state = 0

fn traffic_light()
  set ticks_in_state = get ticks_in_state + 1

  // Transition rules
  let next = match get current
    when Red if get ticks_in_state >= 5 do
      set ticks_in_state = 0
      Green
    end
    when Green if get ticks_in_state >= 4 do
      set ticks_in_state = 0
      Yellow
    end
    when Yellow if get ticks_in_state >= 2 do
      set ticks_in_state = 0
      Red
    end
    when other -> other
  end
  set current = next

  get current
end

fn light_symbol(light)
  match light
    when Red -> "[R] .  . "
    when Yellow -> " . [Y] . "
    when Green -> " .  . [G]"
  end
end

print("Traffic Light Simulation")
print("========================")
for tick in range(1, 25) do
  let light = traffic_light()
  print("Tick", tick, ":", light_symbol(light))
end
