@module_doc("""
Making text fit a width it does not fit, measuring a block of lines, and the
caret hit-testing that a text field needs from the same measurements.

Three answers to "this string is wider than the box": `wrap_text` breaks it
into lines, `elide` cuts it and marks the cut with "…", and `clamp_lines`
wraps but stops after N lines and elides the last one.
""", see: ["wrap_text", "elide", "clamp_lines"])

# Each is one native call over the host's advance table. The versions a
# script would otherwise write (a `text_width` call per character, per frame,
# over a string the user is typing) are the reason `text_wrap`,
# `text_ellipsize` and `text_index_at` exist at all.

import text_layout/place: text_baseline
import ui

@doc("""
The lines `s` breaks into to fit `max_w` px. Existing newlines are honoured;
a word wider than the box is broken rather than allowed to overflow.
""", params: {s: "The text.", style: "The text style record it is drawn with.", max_w: "The width to fit, in px."},
  returns: "The lines, as strings: always at least one, so a caller can lay the result out with no empty case.",
  example: """let lines = wrap_text(body, style, card.w - 24)""", see: ["clamp_lines", "text_layout/block.text_block"])
pub fn wrap_text(s: string, style: record, max_w: num) -> list
  text_wrap(s, style, float(max_w))

@doc("""
`s` cut to fit `max_w` px, with "…" marking the cut. Returns `s` untouched
when it already fits.
""", params: {s: "The text.", style: "The text style record.", max_w: "The width to fit, in px.",
  keep: """Which end survives: `"head"` (the default: a label reads from its start), `"tail"` (a path, where every row shares the directories), or `"both"` (an identifier recognizable by its ends)."""},
  example: """elide(path, style, col.w, "tail")     # "…/src/place.ptl", say""", see: ["clamp_lines"])
pub fn elide(s: string, style: record, max_w: num, keep: string) -> string
  let mode = match keep
    when "tail" -> "head"
    when "both" -> "middle"
    when _ -> "tail"
  text_ellipsize(s, style, float(max_w), mode)

pub fn elide(s: string, style: record, max_w: num) -> string
  text_ellipsize(s, style, float(max_w), "tail")

@doc("""
Wrap `s` into at most `max_lines` lines, ellipsizing the last one if the
text ran past it. The shape a card summary, a toast body or a two-line list
subtitle wants: it fills the room it has and says, in the usual way, that
there was more.
""", params: {s: "The text.", style: "The text style record.", max_w: "The width to fit, in px.",
  max_lines: "The most lines; 0 or less means no limit, so a caller can pass an option through without branching."},
  returns: "The lines, as strings.",
  example: """let lines = clamp_lines(summary, style, card.w, 2)""", see: ["wrap_text", "elide"])
pub fn clamp_lines(s: string, style: record, max_w: num, max_lines: num) -> list
  let lines = text_wrap(s, style, float(max_w))
  if max_lines <= 0 || len(lines) <= max_lines then
    lines
  else
    var out = []
    for i in range(0, max_lines - 1) do
      set out = append(out, lines[i])
    # Everything that did not fit is rejoined before being cut, so the
    # ellipsis lands after as much of the overflow as the last line can hold
    # rather than after the last *whole line* the wrap happened to produce.
    var rest = lines[max_lines - 1]
    for i in range(max_lines, len(lines)) do
      set rest = rest ++ " " ++ lines[i]
    append(out, text_ellipsize(rest, style, float(max_w), "tail"))

# ── Measuring a block ─────────────────────────────────────────────────────

@doc("""
The distance between one line's baseline and the next, for `style`.
""", params: {style: "The text style record.",
  lead: """Scales the face's own recommendation: 1.0 (the default) is the face's comfortable setting, 1.4 opens it up, and a value of 4 or more is read as an explicit pixel distance instead: a caller matching a grid says `{lead: 20}` and means 20 px."""},
  returns: "The line step in px.", see: ["lines_size"])
pub fn line_step(style: record, lead: num) -> float
  let l = float(lead)
  if l >= 4.0 then l else text_metrics(style).line_height * l end

pub fn line_step(style: record) -> float
  line_step(style, 1.0)

@doc("The widest of `lines`, in px.", params: {lines: "The lines, as strings.", style: "The text style record."},
  see: ["lines_size"])
pub fn lines_width(lines: list, style: record) -> float
  var w = 0.0
  for line in lines do
    let lw = float(text_width(line, style))
    if lw > w then
      set w = lw
  w

@doc("""
The size `lines` occupy. The height is the ink-to-ink extent of the block,
the cap height of the first line down to the descenders of the last, not
`count × line_step`, which counts a leading above the first line that
nothing is drawn in and makes a "fitted" box look bottom-heavy.
""", params: {lines: "The lines, as strings.", style: "The text style record.",
  lead: "The leading, as `line_step` takes it (1.0)."},
  returns: """`{w, h}` in px.""", example: """let sz = lines_size(wrap_text(tip, style, 240), style)""",
  see: ["line_step", "lines_width"])
pub fn lines_size(lines: list, style: record, lead: num) -> record
  let m = text_metrics(style)
  let n = max(1, len(lines))
  {w: lines_width(lines, style),
   h: m.cap_height + m.descent + float(n - 1) * line_step(style, lead)}

pub fn lines_size(lines: list, style: record) -> record
  lines_size(lines, style, 1.0)

# ── Carets ────────────────────────────────────────────────────────────────

@doc("""
The character index a click `dx` px into the run falls on, snapped to the
nearer character boundary.
""", params: {s: "The text.", style: "The text style record.", dx: "The click's offset from the run's left edge, in px."},
  returns: "A character index, which is what `slice` and `s[i]` take.",
  example: """let caret = caret_index(text, style, mouse_x() - text_x)""", see: ["caret_x", "caret_rect"])
pub fn caret_index(s: string, style: record, dx: num) -> int
  text_index_at(s, style, float(dx))

@doc("The x offset, from the run's left edge, of the caret sitting before character `i`.",
  params: {s: "The text.", style: "The text style record.", i: "A character index; below 0 reads as 0."},
  see: ["caret_index", "caret_rect"])
pub fn caret_x(s: string, style: record, i: num) -> float
  float(text_width(char_slice(s, 0, max(0, i)), style))

@doc("""
The rect of the caret before character `i`, for text set at the left of
`r`: a 1px-wide bar spanning the line's ink, so it matches the text's height
rather than the control's.
""", params: {s: "The text.", r: "The box the line is set in.", style: "The text style record.",
  i: "A character index.", valign: """How the line sits in `r`, as `text_baseline` takes it (`"middle"`)."""},
  example: """draw_rect(caret_rect(text, field_r, style, caret), t.accent)""",
  see: ["caret_x", "caret_index"])
pub fn caret_rect(s: string, r: record, style: record, i: num, valign: string) -> record
  let m = text_metrics(style)
  let base = text_baseline(r, style, valign)
  Rect(float(r.x) + caret_x(s, style, i), base - m.baseline, 1.0, m.baseline + m.descent)

pub fn caret_rect(s: string, r: record, style: record, i: num) -> record
  caret_rect(s, r, style, i, "middle")
