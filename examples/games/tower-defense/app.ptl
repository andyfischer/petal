// Twelve waves. A group is `n` pests of kind `k`, one every `gap` seconds,
// starting `at` seconds in; lane 0 = north, 1 = south, 2 = alternating.
// `m` scales hit points, `note` is the scouting report shown before the wave.
let WAVES = [
  {m: 1.00, note: "A first scouting party. Thorns will do.",
    groups: [{k: 0, n: 10, gap: 0.70, at: 0.0, lane: 0}]},
  {m: 1.10, note: "Beetles up top, aphids slipping in below.",
    groups: [{k: 1, n: 8, gap: 1.10, at: 0.0, lane: 0}, {k: 0, n: 10, gap: 0.55, at: 5.0, lane: 1}]},
  {m: 1.20, note: "Wasps are fast. Cover the merge.",
    groups: [{k: 2, n: 14, gap: 0.60, at: 0.0, lane: 2}]},
  {m: 1.35, note: "A proper column, with a swarm behind it.",
    groups: [{k: 1, n: 14, gap: 0.80, at: 0.0, lane: 2}, {k: 0, n: 20, gap: 0.35, at: 4.0, lane: 1}]},
  {m: 1.50, note: "Snails. Armoured: darts glance off the shell.",
    groups: [{k: 3, n: 4, gap: 2.50, at: 0.0, lane: 0}, {k: 2, n: 12, gap: 0.50, at: 3.0, lane: 1}]},
  {m: 1.70, note: "The first real swarm. Splash earns its keep.",
    groups: [{k: 0, n: 44, gap: 0.22, at: 0.0, lane: 2}, {k: 1, n: 8, gap: 0.90, at: 5.0, lane: 0}]},
  {m: 1.90, note: "Shells in front, stingers behind.",
    groups: [{k: 3, n: 8, gap: 1.80, at: 0.0, lane: 2}, {k: 2, n: 18, gap: 0.45, at: 6.0, lane: 2}]},
  {m: 2.10, note: "Both gates at once, shoulder to shoulder.",
    groups: [{k: 1, n: 24, gap: 0.50, at: 0.0, lane: 2}, {k: 0, n: 30, gap: 0.25, at: 2.0, lane: 2}]},
  {m: 2.20, note: "A Hornet Queen. She shrugs off the cold.",
    groups: [{k: 4, n: 1, gap: 1.00, at: 0.0, lane: 0}, {k: 2, n: 20, gap: 0.50, at: 2.0, lane: 1}]},
  {m: 2.50, note: "A wall of shells wrapped in a swarm.",
    groups: [{k: 3, n: 12, gap: 1.20, at: 0.0, lane: 2}, {k: 0, n: 44, gap: 0.20, at: 4.0, lane: 2}]},
