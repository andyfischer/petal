let KINDS = [
  {name: "Aphid",  hp: 14.0,   spd: 2.30, gold: 3,   r: 0.15, armor: 0.0, leak: 1,  chill: 1.0, c: #b9d86a},
  {name: "Beetle", hp: 46.0,   spd: 1.45, gold: 7,   r: 0.23, armor: 0.0, leak: 1,  chill: 1.0, c: #d9825a},
  {name: "Wasp",   hp: 26.0,   spd: 3.10, gold: 6,   r: 0.19, armor: 0.0, leak: 1,  chill: 1.0, c: #f0c44c},
  {name: "Snail",  hp: 150.0,  spd: 0.85, gold: 16,  r: 0.29, armor: 4.0, leak: 2,  chill: 0.8, c: #a99ad6},
