// Particle System
// Simulating several independent objects out of one `state` declaration site.
//
// Each particle needs its own position and velocity, and a particle is an
// entity with an id — so the declarations are keyed with `state(id)`. A keyed
// slot is *absolute*: the same key reaches the same cell no matter which
// callsite, loop iteration, or frame asked for it, so particle 2 keeps its own
// trajectory across every frame of the simulation below.
//
// Without the key, all four particles would share one set of cells and the
// "simulation" would be a single particle updated four times per frame.

fn update_particle(id)
  state(id) x = 0.0
  state(id) y = 0.0
  state(id) vx = float(id + 1) * 1.5
  state(id) vy = float(id + 1) * 0.8

  // Update position
  x = x + vx
  y = y + vy

  // Bounce off boundaries
  if x > 50.0 || x < 0.0 then
    vx = -vx
    x = x + vx
  end
  if y > 30.0 || y < 0.0 then
    vy = -vy
    y = y + vy
  end

  print("  Particle", id, "-> x:", floor(x), "y:", floor(y))
end

print("Particle Simulation")
print("====================")

for frame in range(1, 8) do
  print("Frame", frame)
  for p in range(0, 4) do
    update_particle(p)
  end
  print("")
end
