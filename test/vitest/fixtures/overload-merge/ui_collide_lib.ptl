// The arity-collision case. The `ui` package's `draw_rect_outline` set takes 2 to 9
// arguments; this module declares the 2-argument arity itself. Its own
// declaration is the higher-precedence one and wins for that arity (it shifts
// the rect right by 1 so the trace shows which ran); the arities it does not
// declare — here the 3-argument alpha form — stay reachable.
import ui

pub fn draw_rect_outline(r, c)
  ui.draw_rect_outline({ x: r.x + 1, y: r.y, w: r.w, h: r.h }, c)
end

pub fn paint()
  draw_rect_outline({ x: 0, y: 0, w: 10, h: 10 }, { r: 1, g: 2, b: 3 })
  draw_rect_outline({ x: 40, y: 0, w: 10, h: 10 }, { r: 4, g: 5, b: 6 }, 0.5)
end
