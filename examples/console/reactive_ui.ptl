// Reactive UI Sketch
// Inline state gives Petal a React-like component model: a component is a
// function, its state sits next to its view logic, and that state outlives the
// frame that drew it.
//
// Two kinds of state show up in any real UI, and they are declared differently:
//
//   - The app model — one copy, written by event handlers. That is a top-level
//     `state var`: one cell for the program, read with `get`, written with
//     `set` from wherever the event lands.
//   - A widget's own memory — one copy *per widget instance*. That is a `state`
//     inside the widget function. Giving it a key, `state(id)`, pins the cell
//     to the instance's identity, so the two buttons below keep independent
//     click counts out of a single declaration and would keep them across a
//     reorder of the list they were drawn in. This is React's `key` prop.

enum Event
  None(),
  Add(text),
  Clear(),
end

// The app model: one cell, shared by every function that touches it.
state var items = ["Buy groceries", "Write code", "Read a book"]

// A widget. `id` names this button instance; the `click_count` cell belongs to
// that name, not to the `button` function as a whole.
fn button(id, label, clicked)
  state(id) click_count = 0
  if clicked then
    click_count = click_count + 1
  end
  {
    type: "button",
    label: "{label} ({click_count})",
    clicks: click_count,
  }
end

fn todo_app(event)
  // Handle this frame's event (a real UI runtime would feed these from input).
  let pressed = match event
    when Add(text) do
      set items = append(get items, text)
      "add"
    end
    when Clear() do
      set items = []
      "clear"
    end
    when None() -> ""
  end

  let add_btn = button("add", "Add", pressed == "add")
  let clear_btn = button("clear", "Clear", pressed == "clear")

  let list = get items
  print("  Todo App ({len(list)} items)")
  print("  --------")
  for i in range(0, len(list)) do
    print("  [ ] {list[i]}")
  end
  print("  [{add_btn.label}]  [{clear_btn.label}]")
  print("")
end

print("Reactive UI Demo")
print("=================")
print("")

// Simulate render frames, one event each.
let events = [
  None(),
  Add("Water plants"),
  Add("Call Alex"),
  Clear(),
  Add("Start over"),
]

for frame in range(0, len(events)) do
  print("Frame {frame + 1}:")
  todo_app(events[frame])
end
