// The precedence check: a plain import is *weak*. This module declares its
// own `screen_width`, which must silently shadow the one `ui` exports — no
// collision error — while an unshadowed prelude name (`draw_rect`'s record
// overload) still resolves here.

import ui

fn screen_width()
  42
end

pub fn banner(c)
  draw_rect({ x: 0, y: 0, w: screen_width(), h: 10 }, c)
  print("width " ++ str(screen_width()))
end
