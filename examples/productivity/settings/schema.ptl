pub let FONTS = ["JetBrains Mono", "Menlo", "Monaco", "Courier New"]

// One setting. `kind` picks the control:
//   toggle  check  seg  select  slider  stepper  text  swatch  radio  action
// `parent` + `need` make a row depend on another: it is live only while the
// parent holds `need` (and the parent is itself live, so chains work).
// `reveal` rows fold away while their parent is off; the others stay visible
// and go inert.
fn S(id: string, g: int, kind: string, label: string, desc: string, def, x: record = {}) -> record
  {id: id, g: g, kind: kind, label: label, desc: desc, def: def,
    opts: field(x, "opts", []), notes: field(x, "notes", []),
    lo: field(x, "lo", 0), hi: field(x, "hi", 1), step: field(x, "step", 1),
    unit: field(x, "unit", ""), places: field(x, "places", 0), fmt: field(x, "fmt", ""),
    parent: field(x, "parent", ""), need: field(x, "need", true),
    reveal: field(x, "reveal", false), tags: field(x, "tags", ""),
    hint: field(x, "hint", ""), tone: field(x, "tone", "default")}
end

