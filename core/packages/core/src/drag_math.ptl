// Package `core` — the numeric half of `ui/drag`'s `between` and `vary`
// (core/src/builtins/drag_math.rs, docs/proposals/declarative-dragging.md).
//
// The drag engine runs its speculative renderings in Petal and hands these
// only numbers. `drag_triangulate(points)` is a Delaunay triangulation of
// `[[x, y], …]` as `[[i, j, k], …]`; `drag_weights(points, tris, x, y)` the
// barycentric weights of a point over it, one per point, clamped to the hull
// (no triangles: the projection onto the nearest segment on the line);
// `drag_solve_step(values, rows, targets, jac, bounds, scale)` one
// Gauss-Newton step of the DM v2 solver for levers `values`.
//
// Native interface declarations: each `native fn` binds a name to the host
// native of the same name and gives the checker its parameter names, arity
// and types. See docs/usage/ffi.md (Native interfaces).

pub native fn drag_triangulate(points: list) -> list
pub native fn drag_weights(points: list, tris: list, x: num, y: num) -> list
pub native fn drag_solve_step(values: list, rows: list, targets: list, jac: list, bounds, scale: num) -> list
