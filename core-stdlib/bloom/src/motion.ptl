@module_doc("""
The animation core bloom's components are built from: eased and spring
values, entrances, impulses, clock-driven waves, easing curves and rect
interpolation. Use it directly for anything the components do not cover.

Every value here is *per callsite*: the `state` inside these functions is
keyed by the call path, so a component that calls `ease_flag(hover, 18)`
gets its own animator per instance with nothing to plumb through the app.
That is the whole trick behind bloom's components animating by default —
there are no animation state records, no ids, and no registration.

A call in a loop gets one animator per iteration, so a list of buttons
animates independently. The corollary: animators follow the *position*, so
reordering a list makes item 3's motion state stay with slot 3.

Almost everything here integrates `dt()`, the host's frame delta, which the
headless harness pins — so a bloom UI settles identically in a trace and on
screen. The two exceptions are `wave` and `pulse`, which read the wall clock
`time()` so that every callsite sharing a period stays in phase; a headless
run holds that clock still, and they hold their value with it.
""", see: ["ease_to", "spring", "enter"])

import ui

@doc("""
The frame delta, clamped. A pause, a breakpoint or a slow first frame
otherwise arrives as one enormous `dt` that flings every spring across the
screen; capping it at ~3 frames turns a hitch into a slightly slow frame.
""", returns: "`dt()`, at most 0.05 seconds.")
pub fn step() -> float
  min(dt(), 0.05)

# ── Easing curves ─────────────────────────────────────────────────────────
# `t` is clamped to [0, 1] in every one of these, so a caller may hand over a
# raw progress value that has overshot without checking it first.

fn _t(t: num) -> float
  clamp(float(t), 0.0, 1.0)

@doc("""
The ease-out cubic: fast start, gentle landing. `t` is clamped to [0, 1], as
in every curve here, so a progress value that has overshot needs no check.
""", params: {t: "Progress, 0 to 1."}, example: "let slide = ease_out(enter(open, 0.18)) * 12.0",
  see: ["ease_in", "ease_in_out", "ease_back", "ease_elastic"])
pub fn ease_out(t: num) -> float
  let c = _t(t)
  1.0 - pow(1.0 - c, 3.0)

@doc("The ease-in cubic: gentle start, fast finish. `t` is clamped to [0, 1].",
  params: {t: "Progress, 0 to 1."}, see: ["ease_out"])
pub fn ease_in(t: num) -> float
  let c = _t(t)
  c * c * c

@doc("The ease-in-out cubic: gentle at both ends. `t` is clamped to [0, 1].",
  params: {t: "Progress, 0 to 1."}, see: ["ease_out"])
pub fn ease_in_out(t: num) -> float
  let c = _t(t)
  if c < 0.5 then
    4.0 * c * c * c
  else
    1.0 - pow(-2.0 * c + 2.0, 3.0) / 2.0

@doc("""
A curve that overshoots past 1 and settles back: the "pop" a menu or a
dialog opens with. `t` is clamped to [0, 1].
""", params: {t: "Progress, 0 to 1."}, see: ["ease_out", "ease_elastic"])
pub fn ease_back(t: num) -> float
  let c = _t(t)
  let s = 1.70158
  let u = c - 1.0
  1.0 + (s + 1.0) * u * u * u + s * u * u

@doc("""
A curve with a decaying wobble. Louder than `ease_back`: for a control that
wants to be noticed once (a toast landing), not for anything that fires on
every hover. `t` is clamped to [0, 1].
""", params: {t: "Progress, 0 to 1."}, see: ["ease_back"])
pub fn ease_elastic(t: num) -> float
  let c = _t(t)
  if c <= 0.0 then
    0.0
  else
    if c >= 1.0 then
      1.0
    else
      let p = 0.3
      pow(2.0, -10.0 * c) * sin((c - p / 4.0) * (2.0 * pi()) / p) + 1.0

# ── Animated values ───────────────────────────────────────────────────────

@doc("""
A value easing toward `target`: an exponential approach, per callsite. The
first frame *snaps*, so a component does not fade in from zero when it first
appears, and a hot reload does not replay every transition.
""", params: {target: "Where the value is heading; it may change every frame.",
  rate: "Speed in 1/seconds (18): about 18 lands in 110 ms."},
  returns: "This frame's value.",
  example: "let x = ease_to(if open then 240.0 else 0.0 end, 12.0)",
  see: ["ease_flag", "spring", "bloom/theme.rate"])
pub fn ease_to(target: num, rate: num) -> float
  state v = 0.0
  state seen = 0
  if seen == 0 then
    v = float(target)
    seen = 1
  else
    let k = 1.0 - pow(2.718281828459045, -float(rate) * step())
    v = v + (float(target) - v) * k
    if abs(float(target) - v) < 0.001 then
      v = float(target)
  v

pub fn ease_to(target: num) -> float
  ease_to(target, 18.0)

@doc("""
A value easing 0 → 1 as `on` flips, and back: the hover/press/open primitive
every component uses. It is `ease_to` over 0 and 1.
""", params: {on: "The flag.", rate: "Speed in 1/seconds (18)."},
  example: "let hot = ease_flag(hovering(r))", see: ["ease_to"])
pub fn ease_flag(on: bool, rate: num) -> float
  ease_to(if on then 1.0 else 0.0 end, rate)

pub fn ease_flag(on: bool) -> float
  ease_flag(on, 18.0)

@doc("""
A value that follows `target` on a real second-order spring: it overshoots,
oscillates and settles *exactly*. Use it where motion should feel physical (a
knob being flicked, a thumb sliding across a segmented control) and `ease_to`
where it should feel calm. Like `ease_to`, the first frame snaps.
""", params: {target: "Where the spring is pulled to.", cfg: "Spring settings; the defaults are a snappy, barely-overshooting spring."},
  options: {stiffness: "Pull toward the target (170).", damping: "Drag on the motion (20).",
    velocity: "The starting velocity, on the first frame (0)."},
  returns: "This frame's position.",
  example: """let knob_x = spring(if on then r.x + r.w - 10.0 else r.x + 10.0 end, {damping: 14})""",
  see: ["ease_to"])
pub fn spring(target: num, cfg: record) -> float
  let k = float(field(cfg, "stiffness", 170.0))
  let d = float(field(cfg, "damping", 20.0))
  state x = 0.0
  state v = 0.0
  state seen = 0
  if seen == 0 then
    x = float(target)
    v = float(field(cfg, "velocity", 0.0))
    seen = 1
  else
    # Two half-steps: one 60 fps step of a stiff spring is close enough to the
    # stability limit that a dropped frame would ring.
    let h = step() / 2.0
    for _i in range(0, 2) do
      let a = (float(target) - x) * k - v * d
      v = v + a * h
      x = x + v * h
    if abs(float(target) - x) < 0.0005 && abs(v) < 0.01 then
      x = float(target)
      v = 0.0
  x

pub fn spring(target: num) -> float
  spring(target, {})

@doc("""
Linear 0 → 1 progress that advances while `on` and rewinds while not. Unlike
`ease_flag` it reaches its ends exactly and takes a known time, which is what
a staged entrance (fade, then slide, then content) needs. Apply a curve to
the result.
""", params: {on: "Whether to advance.", dur: "Seconds from one end to the other."},
  example: "let pop = ease_out(enter(open, 0.18))", see: ["ease_flag", "stagger"])
pub fn enter(on: bool, dur: num) -> float
  state p = 0.0
  state seen = 0
  if seen == 0 then
    p = if on then 1.0 else 0.0 end
    seen = 1
  else
    let d = max(float(dur), 0.001)
    p = clamp(p + (if on then step() / d else -step() / d end), 0.0, 1.0)
  p

@doc("""
An impulse that decays: 1.0 on the frame `trigger` goes true, then falling
linearly to 0. The building block for one-shot feedback (a ripple, a shake, a
flash), where the trigger is an event and the animation outlives it.
""", params: {trigger: "The event; only its rising edge counts.", dur: "Seconds to decay (0.45)."},
  example: "let flash = impulse(saved, 0.3)", see: ["shake"])
pub fn impulse(trigger: bool, dur: num) -> float
  state v = 0.0
  state was = false
  if trigger && !was then
    v = 1.0
  else
    v = max(0.0, v - step() / max(float(dur), 0.001))
  was = trigger
  v

pub fn impulse(trigger: bool) -> float
  impulse(trigger, 0.45)

@doc("""
A damped horizontal shake, for rejecting input. Feed it the frame an error
happens on and add the result to the control's `x`.
""", params: {trigger: "The error event; only its rising edge counts.", amount: "The largest offset, in px."},
  returns: "This frame's offset in px, settling to 0 over 0.4 s.",
  example: "let box = offset_rect(r, shake(rejected, 6), 0)", see: ["impulse"])
pub fn shake(trigger: bool, amount: num) -> float
  let e = impulse(trigger, 0.4)
  sin(time() * 46.0) * float(amount) * e * e

# ── Clock-driven motion ───────────────────────────────────────────────────
# These read `time()` rather than integrating, so they never drift and every
# callsite with the same period stays in phase (a row of pulsing dots reads as
# one object).

@doc("""
A sine wave from -1 to 1 on the wall clock. It reads `time()` rather than
integrating, so it never drifts and every callsite with the same period stays
in phase (a row of pulsing dots reads as one object).
""", params: {period: "Seconds per cycle."}, see: ["pulse"])
pub fn wave(period: num) -> float
  sin(time() * 2.0 * pi() / max(float(period), 0.001))

@doc("""
0 → 1 → 0, smoothly, on the wall clock: the breathing highlight on a
recording indicator. In phase with every `wave` and `pulse` of the same
period.
""", params: {period: "Seconds per cycle."}, see: ["wave"])
pub fn pulse(period: num) -> float
  (wave(period) + 1.0) / 2.0

# It sums `step()` rather than subtracting two `time()` readings, because a
# headless run pins the clock while still advancing `dt`: a `time()`-based
# age would sit at zero for the whole trace and no entrance animation would
# ever be testable.
@doc("""
Seconds since this callsite first ran. One timer per instance, started when
the instance appears, so an item that enters a list later animates in on its
own schedule. It advances by `step()`, so a headless run ages it too.
""", see: ["stagger"])
pub fn age() -> float
  state t = 0.0
  state seen = 0
  if seen == 0 then
    seen = 1
  else
    t = t + step()
  t

@doc("""
Item `i`'s progress through a cascading entrance: 0 → 1 over `dur` seconds,
starting `i * step_s` seconds after this callsite appeared. The stagger a
list uses to cascade in.
""", params: {i: "The item's index.", step_s: "The delay between one item and the next, in seconds.",
  dur: "Each item's entrance, in seconds."},
  example: """
    for i in range(0, len(rows)) do
      let p = ease_out(stagger(i, 0.03, 0.2))
      draw_text(rows[i], {x: 20.0 + (1.0 - p) * 12.0, y: 40.0 + i * 24.0}, 14, t.text)
  """, see: ["age", "enter"])
pub fn stagger(i: num, step_s: num, dur: num) -> float
  let a = age() - float(i) * float(step_s)
  clamp(a / max(float(dur), 0.001), 0.0, 1.0)

# ── Interpolation ─────────────────────────────────────────────────────────

@doc("""
The rect `t` of the way from `a` to `b`, each edge interpolated. `t` is
clamped to [0, 1].
""", params: {a: "The rect at 0.", b: "The rect at 1.", t: "Progress, 0 to 1."},
  example: "let thumb = lerp_rect(cell_a, cell_b, ease_out(p))", see: ["scale_rect", "offset_rect"])
pub fn lerp_rect(a: record, b: record, t: num) -> Rect
  let c = _t(t)
  Rect(a.x + (b.x - a.x) * c, a.y + (b.y - a.y) * c,
    a.w + (b.w - a.w) * c, a.h + (b.h - a.h) * c)

@doc("""
A rect scaled about its own center: the press squash and the dialog pop.
""", params: {r: "The rect.", s: "The scale; 1 is unchanged."},
  example: "let face = scale_rect(r, 1.0 - 0.03 * press)", see: ["lerp_rect"])
pub fn scale_rect(r: record, s: num) -> Rect
  let w = r.w * float(s)
  let h = r.h * float(s)
  Rect(r.x + (r.w - w) / 2.0, r.y + (r.h - h) / 2.0, w, h)

@doc("`r` moved by (`dx`, `dy`), its size unchanged.", params: {r: "The rect.", dx: "Horizontal offset.", dy: "Vertical offset."},
  see: ["lerp_rect"])
pub fn offset_rect(r: record, dx: num, dy: num) -> Rect
  Rect(r.x + dx, r.y + dy, r.w, r.h)
