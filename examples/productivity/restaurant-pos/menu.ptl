// Juniper & Ash: the menu, the floor and the evening already under way.
//
// Everything here is data. Prices are integer cents. A modifier group is
// `{name, pick, req, opts}`: `pick` is "one" (a radio row) or "many" (toggles),
// `req` says the server cannot add the item until the group has a choice, and
// each option carries what it adds to the item's price.

// ── Modifier groups ─────────────────────────────────────────────────────────

fn opt(label: string, cents: num = 0) -> record
  {label: label, cents: cents}
end

fn group(name: string, pick: string, req: bool, opts: list) -> record
  {name: name, pick: pick, req: req, opts: opts}
end

const TEMP = group("Temperature", "one", true,
  [opt("Rare"), opt("Medium rare"), opt("Medium"), opt("Medium well"), opt("Well done")])
const SIDE = group("Side", "one", true,
  [opt("Hand-cut fries"), opt("Garlic mash"), opt("Side salad"), opt("Truffle fries", 300)])
const STEAK_ADD = group("Sauces & toppings", "many", false,
  [opt("Peppercorn sauce", 300), opt("Bearnaise", 300), opt("Blue cheese crust", 400), opt("Grilled prawns", 900)])
const CHEESE = group("Cheese", "one", true, [opt("Aged cheddar"), opt("Swiss"), opt("Smoked gouda"), opt("No cheese")])
const BURGER_ADD = group("Add-ons", "many", false,
  [opt("Thick-cut bacon", 300), opt("Fried egg", 200), opt("Avocado", 250), opt("Caramelized onion", 150)])
const PASTA = group("Pasta", "one", false, [opt("House-made"), opt("Gluten-free", 300)])
const PASTA_ADD = group("Add protein", "many", false,
  [opt("Grilled chicken", 700), opt("Garlic shrimp", 900), opt("Extra burrata", 600)])
const FISH_SIDE = group("Side", "one", true, [opt("Lemon rice"), opt("Charred broccolini"), opt("Side salad")])
const FLAT_ADD = group("Toppings", "many", false,
  [opt("Prosciutto", 400), opt("Hot honey", 150), opt("Arugula", 100), opt("Extra mozzarella", 200)])
const SPIRIT = group("Spirit", "one", true, [opt("Bourbon"), opt("Rye"), opt("Mezcal", 200)])
const SERVE = group("Serve", "one", true, [opt("Up"), opt("On the rocks")])
const ICE = group("Ice", "one", false, [opt("Regular ice"), opt("Light ice"), opt("No ice")])
const MILK = group("Milk", "one", false, [opt("Whole"), opt("Oat", 75), opt("Almond", 75)])
const SCOOP = group("Flavor", "one", true, [opt("Blood orange"), opt("Raspberry"), opt("Mango")])
const DRESS = group("Dressing", "one", false, [opt("Lemon vinaigrette"), opt("Green goddess"), opt("On the side")])

// Quick notes: the things a server types forty times a night, one tap each,
// per kitchen station.
const NOTES_KITCHEN = ["No onions", "Nut allergy", "Dairy free", "Sauce on side", "Extra crispy", "Rush"]
const NOTES_PASTRY = ["Birthday candle", "Split in two", "Nut allergy", "Dairy free", "Hold until called", "Rush"]
const NOTES_BAR = ["Light ice", "No garnish", "Extra cold", "Less sweet", "With dessert", "Rush"]

pub fn quick_notes(station: string) -> list
  match station
    when "Bar" -> NOTES_BAR
    when "Pastry" -> NOTES_PASTRY
    when _ -> NOTES_KITCHEN
  end
end

