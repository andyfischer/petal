// ── Drawing a shape ──────────────────────────────────────────────────────

fn fill_fan(pts, cx, cy, c, a)
  for i in range(0, len(pts)) do
    let p = pts[i]
    let q = pts[(i + 1) % len(pts)]
    fill_triangle(int(cx), int(cy), int(p[0]), int(p[1]), int(q[0]), int(q[1]),
      c.r, c.g, c.b, a)
  end
end

fn outline_pts(pts, c, a, wd)
  for i in range(0, len(pts)) do
    let p = pts[i]
    let q = pts[(i + 1) % len(pts)]
    seg(p[0], p[1], q[0], q[1], c, a, wd)
  end
end

fn text_style(s)
  let size = max(8, int(s.h * 0.80))
  let st = {size: size, color: s.fill, spacing: s.sp}
  let tw = text_width(s.text, st)
  if tw > s.w && tw > 0 then
    size = max(8, int(float(size) * s.w / float(tw)))
    st = {size: size, color: s.fill, spacing: s.sp}
  end
  st
end

fn draw_shape(s, ox, oy)
  if s.kind == "text" then
    let st = text_style(s)
    draw_text(s.text, {x: int(ox + s.x), y: int(oy + s.y + (s.h - float(st.size) * 1.4) / 2.0)}, st)
  elsif (s.kind == "rect" || s.kind == "line") && s.rot == 0.0 then
    draw_rect(int(ox + s.x), int(oy + s.y), max(1, int(s.w)), max(1, int(s.h)),
      s.fill.r, s.fill.g, s.fill.b, s.alpha)
  else
    let c = centerof(s)
    fill_fan(world_pts(s, ox, oy), ox + c.x, oy + c.y, s.fill, s.alpha)
  end
end

// ── Selection handles ────────────────────────────────────────────────────
//  0 nw  1 n  2 ne  3 e  4 se  5 s  6 sw  7 w   ·  8 = rotate

let HDIR = [[-1.0, -1.0], [0.0, -1.0], [1.0, -1.0], [1.0, 0.0],
  [1.0, 1.0], [0.0, 1.0], [-1.0, 1.0], [-1.0, 0.0]]

fn local_to_panel(s, ox, oy, lx, ly)
  let c = centerof(s)
  let a = radians(s.rot)
  let co = cos(a)
  let si = sin(a)
  {x: ox + c.x + lx * co - ly * si, y: oy + c.y + lx * si + ly * co}
end

fn handle_pts(s, ox, oy)
  let out = []
  for d in HDIR do
    out = append(out, local_to_panel(s, ox, oy, d[0] * s.w / 2.0, d[1] * s.h / 2.0))
  end
  out = append(out, local_to_panel(s, ox, oy, 0.0, 0.0 - s.h / 2.0 - 30.0))
  out
end

fn handle_hit(s, ox, oy, mx, my, rotatable)
  let hs = handle_pts(s, ox, oy)
  let hit = -1
  let n = if rotatable then 9 else 8
  end
  for i in range(0, n) do
    let p = hs[i]
    if hit < 0 && abs(float(mx) - p.x) <= 7.0 && abs(float(my) - p.y) <= 7.0 then
      hit = i
    end
  end
  hit
end

