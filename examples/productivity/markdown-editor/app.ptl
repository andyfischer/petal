// ─────────────────────────────────────────────────────────────────────────
//  INKWELL — a Markdown editor with a live preview, as a Garden Petal panel.
//
//  A dark source editor on the left (soft wrap, caret, selection, undo/redo,
//  syntax colouring, list continuation), a rendered preview on the right
//  (headings, paragraphs with bold/italic/code/links, bullet and numbered
//  lists, task lists you can tick from the preview, quotes, fenced code,
//  tables, rules), a draggable splitter between them, and a rail with the
//  documents and a live outline. The preview follows the editor's scroll,
//  and clicking a heading in the preview puts the caret on its source line.
//  Documents persist through the panel store.
//
//  Designed for a 1280x850 viewport. See README.md.
// ─────────────────────────────────────────────────────────────────────────

// ── Palette ──────────────────────────────────────────────────────────────
// Editor side: ink on slate. Preview side: type on paper.
let SLATE      = #171a23
let SLATE_HI   = #1d2130
let GUTTER     = #141720
let RAIL_BG    = #12141c
let RAIL_ROW   = #1c2030
let OUTLINE    = #262b3a
let TEXT       = #e6e9f0
let DIM        = #8b93a7
let FAINT      = #5b6379
let ACCENT     = #8ab4ff
let ACCENT_INK = #4c6fd6
let SELBG      = #2b3d6a
let CARET      = #ffd479

let SYN_HEAD   = #ffb86b
let SYN_MARK   = #6d7891
let SYN_BOLD   = #f2f4f8
let SYN_ITAL   = #c9b6ff
let SYN_CODE   = #9be7a5
let SYN_LINK   = #8ab4ff
let SYN_QUOTE  = #9aa6bf
let SYN_LIST   = #ffd479
let SYN_FENCE  = #6d7891

let PAPER      = #fbfaf6
let PAPER_LOW  = #f1efe8
let INK        = #23272f
let INK_SOFT   = #4f5563
let INK_FAINT  = #8a8f9b
let RULE       = #e2dfd5
let CODE_BG    = #eeece5
let CODE_INK   = #3b4252
let QUOTE_BAR  = #c9b8e8
let LINK       = #3358c4
let CHECK      = #4c9a6a
let TABLE_HEAD = #f2f0ea

// ── Metrics ──────────────────────────────────────────────────────────────
let W = screen_width()
let H = screen_height()

let TOP_H    = 46
let STATUS_H = 26
let RAIL_W   = 210

let FS_ED    = 13
let LH       = 21                 // editor line height
let GUT_W    = 46                 // line-number gutter
let ED_PAD   = 16
let ED_TS    = {size: FS_ED, font: "mono", color: TEXT}
// Measured over a long run so the per-character advance keeps its fraction;
// a rounded single-glyph width drifts a full column by the end of a line.
let CW       = text_width("mmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm", ED_TS) / 50.0

let PV_FONT  = "ui"
let PV_FS    = 15
let PV_LH    = 24
let PV_PAD   = 36
let PV_TS    = {size: PV_FS, font: PV_FONT, color: INK}

let FS_MICRO = 10
let FS_TINY  = 11
let FS_SM    = 12
let FS       = 13

let MAIN = rect(RAIL_W, TOP_H, W - RAIL_W, H - TOP_H - STATUS_H)

// The chords the editor needs back from Garden.
claim_key("z", "cmd")
claim_key("z", "cmd+shift")
claim_key("b", "cmd")
claim_key("i", "cmd")
claim_key("k", "cmd")
claim_key("a", "cmd")
claim_key("s", "cmd")
claim_key("e", "cmd")

