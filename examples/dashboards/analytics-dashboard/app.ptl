// ─────────────────────────────────────────────────────────────────────────────
// MERIDIAN — product analytics dashboard
//
// A Garden panel app: KPI cards with sparklines, an animated main chart with a
// hover crosshair, a donut, a stacked column chart, a ranked bar list and a
// table — laid out on a responsive card grid that reflows with the pane width.
//
//   Run:  garden --headless --debug-port 0 --init layout.ptl
//   Keys: 1-4 / up / down  pick metric     left / right  change range
//         t  area <-> bars                 h  hide/show the hover readout
// ─────────────────────────────────────────────────────────────────────────────

// ── Palette ──────────────────────────────────────────────────────────────────
// One ink-blue ground, three surface steps above it, and a hairline that is
// just visible enough to separate cards without drawing a box around them.
let BG        = #0d1015
let SURFACE   = #151a22
let RAISED    = #1b212b
let HAIRLINE  = #242b38
let GRID      = #1c222c
let TEXT      = #e9eef6
let DIM       = #8d97a7
let FAINT     = #5b6474
let POS       = #4fcb8f
let NEG       = #f2718c

let C_REV     = #6ea8ff
let C_USERS   = #4fcb8f
let C_CONV    = #f5b356
let C_CHURN   = #c78cf5

let WHITE     = #ffffff
let CH_A      = #6ea8ff
let CH_B      = #4fcb8f
let CH_C      = #f5b356

// Spacing scale: everything in the layout is one of these.
let S1 = 6
let S2 = 12
let S3 = 18
let S4 = 24
let S5 = 32

// The type scale. Five sizes, and that is not only a design choice: the host
// rasterizes one glyph per (character, size) into a fixed atlas, and a dense
// page spread across many sizes overflows it — after which whole runs silently
// fall back to a proportional face at the wrong size. Fewer sizes, fewer
// rasters, and the numbers stay in the grid they were drawn for.
let TYPE_SIZES = [10, 12, 15, 21, 28]

// ── Small text helpers ───────────────────────────────────────────────────────

fn text_w(s, style)
  text_width(s, style)
end

fn text_at(s, x, y, style)
  draw_text(s, {x: x, y: y}, style)
end

fn text_right(s, right_x, y, style)
  draw_text(s, {x: right_x - text_w(s, style), y: y}, style)
end

fn text_center(s, cx, y, style)
  draw_text(s, {x: cx - text_w(s, style) / 2.0, y: y}, style)
end

// ── Number formatting ────────────────────────────────────────────────────────

fn commas(n)
  let s = str(n)
  let out = ""
  let c = 0
  let i = len(s) - 1
  while i >= 0 do
    out = slice(s, i, i + 1) ++ out
    c = c + 1
    if c % 3 == 0 && i > 0 then
      out = "," ++ out
    end
    i = i - 1
  end
  out
end

// Fixed-point decimal without a printf: scale, round, then split the integer
// back apart. `str(float)` would give us 12.300000000000001.
fn dec(x, places)
  let mul = 1
  for i in range(0, places) do
    mul = mul * 10
  end
  let neg = x < 0.0
  let scaled = int(round(abs(x) * float(mul)))
  let whole = scaled / mul
  let frac_part = scaled % mul
  let s = commas(whole)
  if places > 0 then
    let fs = str(frac_part)
    while len(fs) < places do
      fs = "0" ++ fs
    end
    s = s ++ "." ++ fs
  end
  if neg then "-" ++ s else s end
end

// Compact axis/label form: 18,204 -> 18.2k
fn compact(x)
  let a = abs(x)
  if a >= 1000000.0 then
    dec(x / 1000000.0, 1) ++ "M"
  elsif a >= 10000.0 then
    dec(x / 1000.0, 1) ++ "k"
  elsif a >= 1000.0 then
    dec(x / 1000.0, 2) ++ "k"
  else
    dec(x, 0)
  end
end

// ── Deterministic pseudo-random ──────────────────────────────────────────────
// Seeded so the dashboard shows the same "real" numbers on every launch and
// every reload — a chart that reshuffles on hot reload is unreadable.

fn hashi(n)
  let x = (n * 374761393 + 668265263) % 2147483647
  x = (x + 2147483647) % 2147483647
  (x * 1103515245 + 12345) % 2147483647
end

fn rand01(n)
  float(hashi(n) % 100000) / 100000.0
end

// ── Calendar ─────────────────────────────────────────────────────────────────
// Day 1..90 of a 2025 that starts on a Wednesday: Jan(31) Feb(28) Mar(31).

fn day_label(d)
  if d <= 31 then
    "Jan {d}"
  elsif d <= 59 then
    "Feb {d - 31}"
  else
    "Mar {d - 59}"
  end
end

fn day_short(d)
  if d <= 31 then
    "Jan {d}"
  elsif d <= 59 then
    "Feb {d - 31}"
  else
    "Mar {d - 59}"
  end
end

fn weekday(i)
  (i + 2) % 7
end

// ── Series ───────────────────────────────────────────────────────────────────

let SPAN = 90

fn make_series(seed, base, growth, wobble, weekend_dip)
  let out = for i in range(0, SPAN) do
    let t = float(i) / float(SPAN - 1)
    let trend = base * (1.0 + growth * t)
    let wd = weekday(i)
    let week = if wd >= 5 then 1.0 - weekend_dip else 1.0 + weekend_dip * 0.3 end
    let n1 = (rand01(seed * 977 + i) - 0.5) * 2.0
    let n2 = sin(float(i) * 0.37 + float(seed)) * 0.5
    trend * week * (1.0 + wobble * (n1 * 0.62 + n2 * 0.38))
  end
  out
end

fn build_metrics()
  [
    {key: "rev", label: "REVENUE", unit: "usd", color: C_REV,
      note: "gross, net of refunds",
      data: make_series(3, 8400.0, 0.62, 0.16, 0.34)},
    {key: "usr", label: "ACTIVE USERS", unit: "count", color: C_USERS,
      note: "daily active, deduped",
      data: make_series(11, 14200.0, 0.41, 0.11, 0.28)},
    {key: "cvr", label: "CONVERSION", unit: "pct", color: C_CONV,
      note: "visit to paid signup",
      data: make_series(23, 3.05, 0.29, 0.14, 0.12)},
    {key: "chn", label: "CHURN", unit: "pct", color: C_CHURN,
      note: "30-day rolling logo churn",
      data: make_series(41, 2.42, -0.31, 0.13, 0.05)},
  ]
end

let RANGES = [
  {label: "7D", days: 7, tick: 1},
  {label: "30D", days: 30, tick: 5},
  {label: "90D", days: 90, tick: 15},
]

fn tail(xs, n)
  slice(xs, len(xs) - n, len(xs))
end

fn series_min(xs)
  let m = xs[0]
  for v in xs do
    if v < m then m = v end
  end
  m
end

fn series_max(xs)
  let m = xs[0]
  for v in xs do
    if v > m then m = v end
  end
  m
end

fn series_sum(xs)
  let s = 0.0
  for v in xs do
    s = s + v
  end
  s
end

fn resample(xs, n)
  let m = len(xs)
  if m == n then
    return xs
  end
  let out = for i in range(0, n) do
    let t = if n <= 1 then 0.0 else float(i) / float(n - 1) end
    let p = t * float(m - 1)
    let a = int(floor(p))
    let b = min(m - 1, a + 1)
    lerp(xs[a], xs[b], p - float(a))
  end
  out
end

fn fmt_value(v, unit)
  if unit == "usd" then
    "$" ++ commas(int(round(v)))
  elsif unit == "pct" then
    dec(v, 2) ++ "%"
  else
    commas(int(round(v)))
  end
end

fn fmt_axis(v, unit)
  if unit == "usd" then
    "$" ++ compact(v)
  elsif unit == "pct" then
    dec(v, 1) ++ "%"
  else
    compact(v)
  end
end

fn fmt_headline(v, unit)
  if unit == "usd" then
    "$" ++ compact(v)
  elsif unit == "pct" then
    dec(v, 2) ++ "%"
  else
    compact(v)
  end
end

// ── Static supporting datasets ───────────────────────────────────────────────

let SOURCES = [
  {name: "Organic search", v: 34210, d: 8.4},
  {name: "Direct", v: 21870, d: 2.1},
  {name: "Referral", v: 12440, d: 14.7},
  {name: "Social", v: 8930, d: -3.6},
  {name: "Email", v: 6120, d: 5.2},
  {name: "Paid", v: 4380, d: -11.2},
]

let PLANS = [
  {name: "Free", pct: 52.0, color: #3c4658},
  {name: "Starter", pct: 24.0, color: #6ea8ff},
  {name: "Pro", pct: 17.0, color: #7b8cf7},
  {name: "Enterprise", pct: 7.0, color: #c78cf5},
]

let PAGES = [
  {path: "/pricing", views: 41208, d: 12.3},
  {path: "/docs/quickstart", views: 33940, d: 6.8},
  {path: "/changelog", views: 22115, d: 24.1},
  {path: "/blog/scaling-postgres", views: 18470, d: -4.2},
  {path: "/integrations/slack", views: 12603, d: 9.9},
  {path: "/login", views: 10884, d: 1.4},
]

let WEEKDAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

fn channel_matrix()
  let out = for d in range(0, 7) do
    let weekend = if d >= 5 then 0.52 else 1.0 end
    let a = (3100.0 + rand01(700 + d) * 900.0) * weekend
    let b = (1900.0 + rand01(810 + d) * 700.0) * weekend
    let c = (1050.0 + rand01(920 + d) * 520.0) * weekend
    [a, b, c]
  end
  out
end

// ── Card chrome ──────────────────────────────────────────────────────────────

fn card_bg(r, raised)
  let fill = if raised then RAISED else SURFACE end
  draw_rect_rounded(r.x, r.y + 2, r.w, r.h, 12, 0, 0, 0, 60)
  draw_rect_rounded(r, 12, fill)
  draw_rect_outline(r, HAIRLINE, 255, 1)
end

// Title row inside a card; returns the content rect below it.
fn card_head(r, title, right_note)
  let pad = S3
  let ts = {size: 10, color: DIM, spacing: 1.4}
  text_at(title, r.x + pad, r.y + pad, ts)
  if len(right_note) > 0 then
    text_right(right_note, r.x + r.w - pad, r.y + pad, {size: 10, color: FAINT})
  end
  rect(r.x + pad, r.y + pad + 26, r.w - pad * 2, r.h - pad * 2 - 26)
end

fn delta_chip(x, y, d, invert)
  let good = if invert then d < 0.0 else d > 0.0 end
  let col = if good then POS else NEG end
  let arrow = if d > 0.0 then "▲" else "▼" end
  let s = "{arrow} {dec(abs(d), 1)}%"
  let st = {size: 10, color: col}
  let w = text_w(s, st) + 14
  draw_rect_rounded(rect(x, y, w, 20), 6, col, 26)
  text_at(s, x + 7, y + 4, st)
  w
end

// ── Chart geometry ───────────────────────────────────────────────────────────

fn nice_step(span, target)
  let raw = span / float(target)
  let mag = pow(10.0, floor(log(max(raw, 0.000001)) / log(10.0)))
  let norm = raw / mag
  let mult = if norm <= 1.0 then 1.0
  elsif norm <= 2.0 then 2.0
  elsif norm <= 2.5 then 2.5
  elsif norm <= 5.0 then 5.0
  else 10.0
  end
  mult * mag
end

fn y_of(v, lo, hi, plot)
  plot.y + plot.h * (1.0 - (v - lo) / max(hi - lo, 0.000001))
end

fn x_of(i, n, plot)
  if n <= 1 then
    plot.x + plot.w / 2.0
  else
    plot.x + plot.w * float(i) / float(n - 1)
  end
end

// A filled area under a polyline. fill_poly is convex-only, so the region is
// emitted one vertical trapezoid per segment; the vertical gradient comes from
// re-drawing the whole band inside a series of clip strips with falling alpha.
fn area_band(ys, plot, color, a_top, a_bot, bands)
  let n = len(ys)
  // Band boundaries are snapped to whole pixels and shared between neighbours:
  // overlapping clips would double-composite the seam and draw a bright rule
  // across the fill at every step.
  for b in range(0, bands) do
    let y0 = int(plot.y + plot.h * float(b) / float(bands))
    let y1 = int(plot.y + plot.h * float(b + 1) / float(bands))
    clip(int(plot.x), y0, int(plot.w) + 1, max(1, y1 - y0))
    let t = float(b) / float(max(bands - 1, 1))
    let a = int(lerp(float(a_top), float(a_bot), t))
    for i in range(0, n - 1) do
      let x0 = x_of(i, n, plot)
      let x1 = x_of(i + 1, n, plot)
      fill_poly([
        [x0, ys[i]],
        [x1, ys[i + 1]],
        [x1, plot.y + plot.h],
        [x0, plot.y + plot.h],
      ], color.r, color.g, color.b, a)
    end
  end
  clip_none()
end

fn polyline(ys, plot, color, width)
  for i in range(0, len(ys) - 1) do
    draw_line(x_of(i, len(ys), plot), ys[i],
      x_of(i + 1, len(ys), plot), ys[i + 1],
      color.r, color.g, color.b, 255, width)
  end
end

// ── Sparkline (KPI cards) ────────────────────────────────────────────────────

fn sparkline(r, xs, color, alpha)
  let lo = series_min(xs)
  let hi = series_max(xs)
  let pad = (hi - lo) * 0.25 + 0.0001
  let plot = rect(float(r.x), float(r.y), float(r.w), float(r.h))
  let ys = for v in xs do y_of(v, lo - pad, hi + pad, plot) end
  let n = len(ys)
  for i in range(0, n - 1) do
    let x0 = x_of(i, n, plot)
    let x1 = x_of(i + 1, n, plot)
    fill_poly([
      [x0, ys[i]],
      [x1, ys[i + 1]],
      [x1, plot.y + plot.h],
      [x0, plot.y + plot.h],
    ], color.r, color.g, color.b, int(28.0 * alpha))
  end
  for i in range(0, n - 1) do
    draw_line(x_of(i, n, plot), ys[i], x_of(i + 1, n, plot), ys[i + 1],
      color.r, color.g, color.b, int(220.0 * alpha), 1.6)
  end
  draw_circle(x_of(n - 1, n, plot), ys[n - 1], 2.6, color.r, color.g, color.b,
    int(255.0 * alpha))
end

// ── Responsive grid ──────────────────────────────────────────────────────────
// Columns are chosen from the available width, so the same call lays four KPI
// cards out 4-up on a wide pane and 2-up on a narrow one.

// NB: the `clamp` builtin returns a float, which silently turns `i / cols` into
// float division and staircases the whole grid. Column counts have to stay int.
fn iclamp(v, lo, hi)
  max(lo, min(v, hi))
end

fn grid_cols(avail_w, count, min_w, gap)
  let fit = int((avail_w + gap) / (min_w + gap))
  iclamp(fit, 1, count)
end

fn grid_cols_even4(avail_w, min_w, gap)
  let c = grid_cols(avail_w, 4, min_w, gap)
  if c == 3 then 2 else c end
end

fn grid_rows(count, cols)
  (count + cols - 1) / cols
end

fn grid_cells(x, y, w, count, cols, gap, row_h)
  let cw = (w - gap * (cols - 1)) / cols
  let cells = for i in range(0, count) do
    let c = i % cols
    let rw = i / cols
    rect(x + c * (cw + gap), y + rw * (row_h + gap), cw, row_h)
  end
  cells
end

// ═════════════════════════════════════════════════════════════════════════════
// State
// ═════════════════════════════════════════════════════════════════════════════

state metrics = build_metrics()
state channels = channel_matrix()
state sel = 0              // selected metric index
state range_i = 1          // selected range index
state chart_mode = "area"  // "area" | "bars"
state show_readout = true

// Tween between the previously-shown normalised series and the current one, so
// switching metric or range morphs instead of jumping.
state tween = 1.0
state prev_norm = []
state prev_lo = 0.0
state prev_hi = 1.0
// Headline number counts up rather than snapping.
state shown_head = 0.0

let w = screen_width()
let h = screen_height()
let narrow = w < 1180

clear(BG.r, BG.g, BG.b)


// ── Input ────────────────────────────────────────────────────────────────────

let prev_sel = sel
let prev_range = range_i

if key_pressed("1") then sel = 0 end
if key_pressed("2") then sel = 1 end
if key_pressed("3") then sel = 2 end
if key_pressed("4") then sel = 3 end
if key_pressed("down") then sel = (sel + 1) % 4 end
if key_pressed("up") then sel = (sel + 3) % 4 end
if key_pressed("right") then range_i = min(range_i + 1, len(RANGES) - 1) end
if key_pressed("left") then range_i = max(range_i - 1, 0) end
if key_pressed("t") then
  chart_mode = if chart_mode == "area" then "bars" else "area" end
end
if key_pressed("h") then show_readout = !show_readout end

// ── Header ───────────────────────────────────────────────────────────────────

let M = S5                        // page margin
let head_y = S4
let content_x = M
let content_w = w - M * 2

text_at("Meridian", content_x, head_y, {size: 21, color: TEXT})
let brand_w = text_w("Meridian", {size: 21, color: TEXT})
text_at("Analytics", content_x + brand_w + 10, head_y + 6, {size: 15, color: FAINT})

text_at("Northwind Labs  ·  production  ·  all regions",
  content_x, head_y + 30, {size: 10, color: FAINT, spacing: 0.4})

// Range pills, right-aligned in the header.
let pill_h = 28
let pill_y = head_y + 2
let pill_pad = 15
let pills = []
let pill_x = content_x + content_w
let ri = len(RANGES) - 1
while ri >= 0 do
  let lab = RANGES[ri].label
  let pw = text_w(lab, {size: 12, color: TEXT}) + pill_pad * 2
  pill_x = pill_x - pw
  pills = append(pills, {i: ri, r: rect(pill_x, pill_y, pw, pill_h)})
  pill_x = pill_x - S1
  ri = ri - 1
end
for p in pills do
  if clicked(p.r) then range_i = p.i end
end

let live_x = content_x + content_w
let live_s = {size: 10, color: FAINT}
text_right("updated 2 min ago", live_x, head_y + 34, live_s)
let live_w = text_w("updated 2 min ago", live_s)
draw_circle(live_x - live_w - 11, head_y + 39, 3.0, POS.r, POS.g, POS.b, 190)

// header rule
draw_line(content_x, head_y + 56, content_x + content_w, head_y + 56,
  HAIRLINE.r, HAIRLINE.g, HAIRLINE.b, 255, 1)

// ── Selected metric / range ──────────────────────────────────────────────────

let rng = RANGES[range_i]
let metric = metrics[sel]
let full = metric.data
let win = tail(full, rng.days)
let cur = win[len(win) - 1]
let first = win[0]
let head_val = if metric.unit == "count" || metric.unit == "usd" then
  series_sum(win)
else
  series_sum(win) / float(len(win))
end
let delta_pct = (cur - first) / max(abs(first), 0.000001) * 100.0

if prev_sel != sel || prev_range != range_i then
  tween = 0.0
end
tween = min(1.0, tween + dt() * 3.4)

// Headline easing (frame-rate independent).
let ease = min(1.0, dt() * 9.0)
shown_head = lerp(shown_head, head_val, ease)
if abs(shown_head - head_val) < abs(head_val) * 0.004 then
  shown_head = head_val
end

// ── KPI card row ─────────────────────────────────────────────────────────────

// ── Layout solve ─────────────────────────────────────────────────────────────
// Everything under the header divides the height that is actually left, so the
// dashboard fills the pane exactly instead of running off the bottom of it. The
// column counts come from the width, so the same solve reflows a narrow pane:
// the KPI row folds 4 -> 2 -> 1 and the donut leaves the chart row for the
// bottom grid.

let grid_top = head_y + 56 + S4
let foot_h = 30
let grid_bottom = h - S4 - foot_h

let kpi_cols = grid_cols_even4(content_w, 230, S3)
let kpi_rows = grid_rows(4, kpi_cols)
let two_up = content_w >= 1000
let r3_count = if two_up then 3 else 4 end
let r3_cols = grid_cols(content_w, r3_count, 300, S3)
let r3_rows = grid_rows(r3_count, r3_cols)

let kpi_h = 118
let kpi_block_h = kpi_rows * kpi_h + (kpi_rows - 1) * S3
let kpi_y = grid_top

let split = if r3_rows == 1 then 0.55 else 0.40 end
let rest = max(360, grid_bottom - kpi_y - kpi_block_h - S4 - S4)
let row2_h = max(210, int(float(rest) * split))
let row3_block_h = max(196 * r3_rows + S3 * (r3_rows - 1), rest - row2_h)
let row3_h = (row3_block_h - (r3_rows - 1) * S3) / r3_rows

let row2_y = kpi_y + kpi_block_h + S4
let row3_y = row2_y + row2_h + S4

let kpi_cells = grid_cells(content_x, kpi_y, content_w, 4, kpi_cols, S3, kpi_h)
let r3_cells = grid_cells(content_x, row3_y, content_w, r3_count, r3_cols, S3, row3_h)

let donut_w = min(380, int(float(content_w) * 0.27))
let chart_w = if two_up then content_w - donut_w - S3 else content_w end
let chart_r = rect(content_x, row2_y, chart_w, row2_h)
let donut_r = if two_up then
  rect(content_x + content_w - donut_w, row2_y, donut_w, row2_h)
else
  r3_cells[3]
end

for i in range(0, 4) do
  let m = metrics[i]
  let r = kpi_cells[i]
  let is_sel = i == sel
  let hot = hovered(r)
  if mouse_pressed(0) && hot then
    sel = i
  end
  card_bg(r, is_sel || hot)
  if is_sel then
    draw_rect_outline(r, m.color, 150, 1)
    draw_rect_rounded(rect(r.x, r.y + 12, 3, r.h - 24), 2, m.color)
  end

  let mw = tail(m.data, rng.days)
  let mcur = mw[len(mw) - 1]
  let mfirst = mw[0]
  let mdelta = (mcur - mfirst) / max(abs(mfirst), 0.000001) * 100.0
  let head = if m.unit == "pct" then
    series_sum(mw) / float(len(mw))
  else
    series_sum(mw)
  end

  let pad = S3
  text_at(m.label, r.x + pad, r.y + pad, {size: 10, color: DIM, spacing: 1.5})
  text_at(fmt_headline(head, m.unit), r.x + pad, r.y + pad + 20,
    {size: 28, color: if is_sel then TEXT else #cdd5e1 end})
  delta_chip(r.x + pad, r.y + r.h - pad - 20, mdelta, m.key == "chn")

  // Sparkline occupies the lower-right quadrant of the card.
  let sp_w = min(r.w * 0.44, 150.0)
  let sp = rect(r.x + r.w - pad - sp_w, r.y + r.h - pad - 46, sp_w, 44)
  sparkline(sp, resample(mw, min(len(mw), 46)), m.color,
    if is_sel then 1.0 else 0.55 end)
end

// ── Main chart + donut row ───────────────────────────────────────────────────

card_bg(chart_r, false)
let chart_note = "{rng.days} days  ·  {metric.note}"
let chart_body = card_head(chart_r, metric.label ++ "  /  DAILY", chart_note)

// Headline inside the chart card.
text_at(fmt_value(cur, metric.unit), chart_body.x, chart_body.y - 4,
  {size: 28, color: TEXT})
let hv_w = text_w(fmt_value(cur, metric.unit), {size: 28, color: TEXT})
delta_chip(chart_body.x + hv_w + S2, chart_body.y + 6, delta_pct,
  metric.key == "chn")
let agg = if metric.unit == "pct" then "avg" else "Σ" end
text_right("{agg} {fmt_headline(shown_head, metric.unit)} over range",
  chart_body.x + chart_body.w, chart_body.y + 8, {size: 10, color: FAINT})

// Plot area
let gutter = 54
let plot = rect(chart_body.x + gutter, chart_body.y + 44,
  chart_body.w - gutter, chart_body.h - 44 - 24)

// Sample count: enough to read, few enough to draw fast.
let nsamp = min(rng.days, 90)
let cur_s = resample(win, nsamp)
let lo_raw = series_min(cur_s)
let hi_raw = series_max(cur_s)
let pad_v = (hi_raw - lo_raw) * 0.22 + 0.0001
let lo = max(0.0, lo_raw - pad_v)
let hi = hi_raw + pad_v

// Tween source: the previous frame's normalised shape, resampled to match.
let zeros = for i in range(0, nsamp) do 0.0 end
let src = if len(prev_norm) == 0 then zeros else resample(prev_norm, nsamp) end
let cur_norm = for v in cur_s do (v - lo) / max(hi - lo, 0.000001) end
let et = tween * tween * (3.0 - 2.0 * tween)
let shown_norm = for i in range(0, nsamp) do lerp(src[i], cur_norm[i], et) end

// Grid + y labels
let step = nice_step(hi - lo, 5)
let g0 = ceil(lo / step) * step
let gv = g0
while gv <= hi do
  let gy = y_of(gv, lo, hi, plot)
  draw_line(plot.x, gy, plot.x + plot.w, gy, GRID.r, GRID.g, GRID.b, 255, 1)
  text_right(fmt_axis(gv, metric.unit), plot.x - S2, gy - 6, {size: 10, color: FAINT})
  gv = gv + step
end

// The series
let ys = for t in shown_norm do plot.y + plot.h * (1.0 - t) end

if chart_mode == "area" then
  area_band(ys, plot, metric.color, 82, 2, if nsamp > 48 then 20 else 30 end)
  polyline(ys, plot, metric.color, 2.0)
else
  let bw = max(2.0, plot.w / float(nsamp) - 3.0)
  for i in range(0, nsamp) do
    let bx = x_of(i, nsamp, plot) - bw / 2.0
    let by = ys[i]
    let bh = plot.y + plot.h - by
    if bh > 1.0 then
      draw_rect_rounded(bx, by, bw, bh, min(3.0, bw / 2.0),
        metric.color.r, metric.color.g, metric.color.b, 210)
    end
  end
end

// baseline
draw_line(plot.x, plot.y + plot.h, plot.x + plot.w, plot.y + plot.h,
  HAIRLINE.r, HAIRLINE.g, HAIRLINE.b, 255, 1)

// X labels
let day0 = SPAN - rng.days + 1
let xt = 0
while xt < nsamp do
  let d = day0 + int(float(xt) * float(rng.days) / float(nsamp))
  text_center(day_short(d), x_of(xt, nsamp, plot), plot.y + plot.h + 9,
    {size: 10, color: FAINT})
  xt = xt + max(1, int(float(nsamp) / 6.0))
end

// Hover crosshair + readout
let over_plot = point_in(mouse_x(), mouse_y(), plot)
state hover_i = -1
if over_plot then
  let t = (float(mouse_x()) - plot.x) / max(plot.w, 1.0)
  hover_i = iclamp(int(round(t * float(nsamp - 1))), 0, nsamp - 1)
elsif !show_readout then
  hover_i = -1
end

if show_readout && hover_i >= 0 && hover_i < nsamp then
  let hx = x_of(hover_i, nsamp, plot)
  let hy = ys[hover_i]
  draw_line(hx, plot.y, hx, plot.y + plot.h, metric.color.r, metric.color.g,
    metric.color.b, 90, 1)
  draw_circle(hx, hy, 5.0, BG.r, BG.g, BG.b, 255)
  draw_circle(hx, hy, 3.6, metric.color.r, metric.color.g, metric.color.b, 255)

  let hv = cur_s[hover_i]
  let hd = day0 + int(float(hover_i) * float(rng.days - 1) / float(max(nsamp - 1, 1)))
  let l1 = day_label(hd)
  let l2 = fmt_value(hv, metric.unit)
  let s1 = {size: 10, color: DIM, spacing: 0.6}
  let s2 = {size: 15, color: TEXT}
  let tw = max(text_w(l1, s1), text_w(l2, s2)) + 22
  let th = 50
  let tx = clamp(hx - tw / 2.0, plot.x, plot.x + plot.w - tw)
  let ty = clamp(hy - th - 14.0, plot.y, plot.y + plot.h - th)
  draw_rect_rounded(tx, ty + 2, tw, th, 8, 0, 0, 0, 90)
  draw_rect_rounded(tx, ty, tw, th, 8, RAISED.r, RAISED.g, RAISED.b, 250)
  draw_rect_outline(tx, ty, tw, th, metric.color.r, metric.color.g, metric.color.b, 110, 1)
  text_at(l1, tx + 11, ty + 9, s1)
  text_at(l2, tx + 11, ty + 24, s2)
end

prev_norm = shown_norm
prev_lo = lo
prev_hi = hi

// ── Donut: plan mix ──────────────────────────────────────────────────────────

card_bg(donut_r, false)
let donut_body = card_head(donut_r, "PLAN MIX", "8,412 accounts")

let dr_out = min(68.0, min(donut_body.w * 0.21, (donut_body.h - 54.0) * 0.46))
let dr_in = dr_out * 0.66
let dcx = donut_body.x + dr_out + 18.0
let dcy = donut_body.y + (donut_body.h - 46.0) / 2.0
state plan_hover = -1
plan_hover = -1

let ang = -pi() / 2.0
for pi_ in range(0, len(PLANS)) do
  let p = PLANS[pi_]
  let sweep = p.pct / 100.0 * pi() * 2.0
  let segs = max(3, int(sweep * 18.0))
  let mid = ang + sweep / 2.0
  // hit test on the ring
  let mdx = float(mouse_x()) - dcx
  let mdy = float(mouse_y()) - dcy
  let mdist = mag(mdx, mdy)
  let mang = atan2(mdy, mdx)
  let rel = mang - ang
  while rel < 0.0 do rel = rel + pi() * 2.0 end
  while rel >= pi() * 2.0 do rel = rel - pi() * 2.0 end
  let is_hot = mdist >= dr_in && mdist <= dr_out + 6.0 && rel < sweep
  if is_hot then plan_hover = pi_ end
  let bump = if is_hot then 5.0 else 0.0 end
  let ro = dr_out + bump
  let riq = dr_in + bump * 0.4
  let alpha = if plan_hover == pi_ then 255 else 235 end
  for s in range(0, segs) do
    let a0 = ang + sweep * float(s) / float(segs)
    let a1 = ang + sweep * float(s + 1) / float(segs)
    fill_poly([
      [dcx + cos(a0) * riq, dcy + sin(a0) * riq],
      [dcx + cos(a0) * ro, dcy + sin(a0) * ro],
      [dcx + cos(a1) * ro, dcy + sin(a1) * ro],
      [dcx + cos(a1) * riq, dcy + sin(a1) * riq],
    ], p.color.r, p.color.g, p.color.b, alpha)
  end
  ang = ang + sweep
end

// donut center label
let center_top = if plan_hover >= 0 then PLANS[plan_hover].name else "PAID" end
let center_val = if plan_hover >= 0 then dec(PLANS[plan_hover].pct, 0) ++ "%" else "48%" end
text_center(center_val, dcx, dcy - 14.0, {size: 21, color: TEXT})
text_center(center_top, dcx, dcy + 10.0, {size: 10, color: DIM, spacing: 1.2})

// legend
let lg_x = dcx + dr_out + 30.0
let lg_step = min(34.0, (donut_body.h - 62.0) / 4.0)
let lg_y = dcy - lg_step * 1.5 - 6.0
for i in range(0, len(PLANS)) do
  let p = PLANS[i]
  let ly = lg_y + float(i) * lg_step
  let on = plan_hover == i
  if on then
    draw_rect_rounded(lg_x - 8.0, ly - 5.0, donut_body.w - (lg_x - donut_body.x) + 6.0,
      lg_step - 6.0, 6, 255, 255, 255, 10)
  end
  draw_rect_rounded(rect(lg_x, ly + 3.0, 8, 8), 2, p.color)
  let pct_s = dec(p.pct, 0) ++ "%"
  let name_style = {size: 12, color: if on then TEXT else #c3cbd8 end}
  let name_avail = donut_body.x + donut_body.w - (lg_x + 16.0) - text_w(pct_s, name_style) - 12.0
  text_at(ellipsize(p.name, name_avail, 12), lg_x + 16.0, ly, name_style)
  text_right(pct_s, donut_body.x + donut_body.w, ly,
    {size: 12, color: if on then TEXT else DIM end})
end

let stat_y = donut_body.y + donut_body.h - 34
draw_line(donut_body.x, stat_y - 12, donut_body.x + donut_body.w, stat_y - 12,
  HAIRLINE.r, HAIRLINE.g, HAIRLINE.b, 170, 1)
text_at("ARPA", donut_body.x, stat_y, {size: 10, color: FAINT, spacing: 1.0})
text_at("$412", donut_body.x, stat_y + 14, {size: 15, color: TEXT})
text_at("NET RETENTION", donut_body.x + donut_body.w / 2.0, stat_y,
  {size: 10, color: FAINT, spacing: 1.0})
text_at("118%", donut_body.x + donut_body.w / 2.0, stat_y + 14, {size: 15, color: POS})

// ── Row 3: stacked columns · sources · pages ─────────────────────────────────

// (a) stacked columns — sessions by weekday and channel
let sc = r3_cells[0]
card_bg(sc, false)
let sc_body = card_head(sc, "SESSIONS BY DAY", "channel split")
let ch_names = ["Organic", "Direct", "Referral"]
let ch_cols = [CH_A, CH_B, CH_C]

let sc_plot = rect(sc_body.x, sc_body.y + 18, sc_body.w, sc_body.h - 18 - 52)
let stack_max = 0.0
for row in channels do
  let t = row[0] + row[1] + row[2]
  if t > stack_max then stack_max = t end
end
for g in range(1, 3) do
  let gy = sc_plot.y + sc_plot.h * float(g) / 3.0
  draw_line(sc_plot.x, gy, sc_plot.x + sc_plot.w, gy, GRID.r, GRID.g, GRID.b, 255, 1)
end
draw_line(sc_plot.x, sc_plot.y + sc_plot.h, sc_plot.x + sc_plot.w, sc_plot.y + sc_plot.h,
  HAIRLINE.r, HAIRLINE.g, HAIRLINE.b, 255, 1)
let colw = sc_plot.w / 7.0
for d in range(0, 7) do
  let row = channels[d]
  let cx0 = sc_plot.x + colw * float(d)
  let bw = min(colw - 12.0, 30.0)
  let bx = cx0 + (colw - bw) / 2.0
  let hot_col = point_in(mouse_x(), mouse_y(), rect(cx0, sc_plot.y, colw, sc_plot.h + 24))
  if hot_col then
    draw_rect_rounded(cx0 + 1.0, sc_plot.y - 6.0, colw - 2.0, sc_plot.h + 30.0, 6,
      255, 255, 255, 9)
  end
  let acc = 0.0
  for k in range(0, 3) do
    let v = row[k]
    let y1 = sc_plot.y + sc_plot.h * (1.0 - acc / stack_max)
    let y0 = sc_plot.y + sc_plot.h * (1.0 - (acc + v) / stack_max)
    let c = ch_cols[k]
    let a = if hot_col then 255 else 215 end
    draw_rect(bx, y0, bw, max(1.0, y1 - y0 - 1.5), c.r, c.g, c.b, a)
    acc = acc + v
  end
  let lab_col = if hot_col then TEXT else FAINT end
  text_center(WEEKDAYS[d], cx0 + colw / 2.0, sc_plot.y + sc_plot.h + 8,
    {size: 10, color: lab_col})
  if hot_col then
    text_center(compact(acc), cx0 + colw / 2.0,
      sc_plot.y + sc_plot.h * (1.0 - acc / stack_max) - 15.0,
      {size: 10, color: TEXT})
  end
end
// legend strip
let lgy = sc.y + sc.h - S3 - 11
let lgx = sc_body.x
for k in range(0, 3) do
  draw_rect_rounded(rect(lgx, lgy + 3, 8, 8), 2, ch_cols[k])
  text_at(ch_names[k], lgx + 14, lgy, {size: 10, color: DIM})
  lgx = lgx + 14 + text_w(ch_names[k], {size: 10, color: DIM}) + S3
end

// (b) ranked horizontal bars — traffic sources
let src_c = r3_cells[1]
card_bg(src_c, false)
let src_body = card_head(src_c, "TRAFFIC SOURCES", "sessions")
let src_max = SOURCES[0].v
let src_n = iclamp(int((src_body.h - 8.0) / 26.0), 2, len(SOURCES))
let rowh = (src_body.h - 8.0) / float(src_n)
for i in range(0, src_n) do
  let s = SOURCES[i]
  let rr = rect(src_body.x - 6.0, src_body.y + rowh * float(i), src_body.w + 12.0, rowh)
  let hot = hovered(rr)
  if hot then
    draw_rect_rounded(rr, 6, WHITE, 10)
  end
  let ty = rr.y + rowh / 2.0 - 15.0
  text_at(s.name, src_body.x, ty, {size: 12, color: if hot then TEXT else #c3cbd8 end})
  text_right(commas(s.v), src_body.x + src_body.w, ty, {size: 12, color: DIM})
  let bar_y = ty + 19.0
  let bar_w = src_body.w
  draw_rect_rounded(src_body.x, bar_y, bar_w, 5, 2.5, GRID.r, GRID.g, GRID.b, 255)
  let fillw = bar_w * float(s.v) / float(src_max)
  let c = if s.d >= 0.0 then C_REV else #7c8698 end
  draw_rect_rounded(src_body.x, bar_y, max(4.0, fillw), 5, 2.5,
    c.r, c.g, c.b, if hot then 255 else 205 end)
end

// (c) table — top pages
let pg = r3_cells[2]
card_bg(pg, false)
let pg_body = card_head(pg, "TOP PAGES", "views  ·  Δ 7d")
let pg_n = iclamp(int((pg_body.h - 4.0) / 24.0), 2, len(PAGES))
let prowh = (pg_body.h - 4.0) / float(pg_n)
for i in range(0, pg_n) do
  let p = PAGES[i]
  let rr = rect(pg_body.x - 6.0, pg_body.y + prowh * float(i), pg_body.w + 12.0, prowh)
  let hot = hovered(rr)
  if hot then
    draw_rect_rounded(rr, 6, WHITE, 10)
  end
  let ty = rr.y + prowh / 2.0 - 8.0
  let dcol = if p.d >= 0.0 then POS else NEG end
  let dtxt = (if p.d >= 0.0 then "+" else "−" end) ++ dec(abs(p.d), 1) ++ "%"
  let dw = text_w(dtxt, {size: 10, color: dcol})
  let vtxt = commas(p.views)
  let vw = text_w(vtxt, {size: 12, color: DIM})
  let avail = pg_body.w - dw - vw - 30.0
  text_at(ellipsize(p.path, avail, 12), pg_body.x, ty,
    {size: 12, color: if hot then TEXT else #c3cbd8 end})
  text_right(vtxt, pg_body.x + pg_body.w - dw - 14.0, ty, {size: 12, color: DIM})
  text_right(dtxt, pg_body.x + pg_body.w, ty, {size: 10, color: dcol})
  if i < pg_n - 1 then
    draw_line(pg_body.x, rr.y + prowh - 0.5, pg_body.x + pg_body.w, rr.y + prowh - 0.5,
      HAIRLINE.r, HAIRLINE.g, HAIRLINE.b, 120, 1)
  end
end

// ── Footer ───────────────────────────────────────────────────────────────────

let foot_y = row3_y + row3_block_h + S2
draw_line(content_x, foot_y, content_x + content_w, foot_y,
  HAIRLINE.r, HAIRLINE.g, HAIRLINE.b, 160, 1)
let other_mode = if chart_mode == "area" then "bars" else "area" end
let hints = "1-4 / ↑↓ metric      ←→ range      t  {other_mode}      h  readout"
text_at(hints, content_x, foot_y + 11, {size: 10, color: FAINT, spacing: 0.3})
text_right("{nsamp} points  ·  {chart_mode}  ·  {w}×{h}", content_x + content_w,
  foot_y + 11, {size: 10, color: FAINT})

// ── Range pills drawn last so their hover sits above the header rule ─────────

for p in pills do
  let on = p.i == range_i
  let hot = hovered(p.r)
  let bg = if on then #2b3546 elsif hot then RAISED else SURFACE end
  draw_rect_rounded(p.r, 8, bg)
  draw_rect_outline(p.r, if on then #47597a else HAIRLINE end, 255, 1)
  let fg = if on then TEXT elsif hot then #c3cbd8 else DIM end
  text_center(RANGES[p.i].label, p.r.x + p.r.w / 2.0, p.r.y + 8, {size: 12, color: fg})
end
