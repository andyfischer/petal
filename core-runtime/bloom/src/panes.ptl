# bloom/panes — the components that divide and navigate a pane: tabs, the
# ‹ value › cycle control, the splitter and the table.
#
# These replace `ui`'s `tab_bar`, `stepper`, `splitter` and `table`. Where
# `ui` made the caller keep a state record (`splitter_state`, `table_state`)
# these keep it per callsite, like every bloom component: the caller passes
# the value it owns (the split fraction) and gets the new one back, or reads
# the table's selection and sort request off the result.

import bloom/theme: theme, ts, tone, hair, rate, text_cut
import bloom/motion: ease_to, ease_flag, spring
import bloom/interact: probe, drag, pointer_free
import bloom/icon: icon
import bloom/display: scrollbar
import text_layout: draw_text_line
import ui

# ── Tabs ───────────────────────────────────────────────────────────────────

# A horizontal tab strip filling `r`. Each tab is as wide as its label plus
# padding; a click (press and release) switches. The underline springs from
# the old tab to the new one. Returns the new index.
#
# `opts`: {size, gap, fg, fg_active, underline, hover, rule, on} — `on` is the
# surface the strip is drawn over, which the hover wash is flattened against.
pub fn tabs(r: record, labels: list, index: num) -> num
  tabs(r, labels, index, {})
end

pub fn tabs(r: record, labels: list, index: num, opts: record) -> num
  let t = theme()
  let size = field(opts, "size", t.font_md)
  let gap = field(opts, "gap", 4)
  let on = field(opts, "on", t.bg)
  let chosen = index
  let x = float(r.x)
  let ux = 0.0
  let uw = 0.0
  for i in range(0, len(labels)) do
    let active = i == index
    let fg0 = if active then field(opts, "fg_active", t.text) else field(opts, "fg", t.dim) end
    let style = ts(t, size, fg0)
    let w = text_width(labels[i], style) + 24
    let tr = Rect(x, r.y, w, r.h)
    let p = probe(tr)
    if p.click then
      chosen = i
    end
    if !active && p.hot > 0.01 then
      draw_rect(tr, over(on, field(opts, "hover", t.hover), int(p.hot * 160.0)))
    end
    let fg = if active then fg0 else mix(fg0, t.text, p.hot * 0.5) end
    draw_text_line(labels[i], tr, {...style, color: fg}, "center")
    if active then
      ux = x + 6
      uw = w - 12
    end
    x = x + w + gap
  end
  # The underline is a spring on its own left edge and width, so switching
  # three tabs over slides and settles rather than jumping.
  if uw > 0.0 then
    let sx = spring(ux, {stiffness: 300.0, damping: 28.0})
    let sw = spring(uw, {stiffness: 300.0, damping: 28.0})
    draw_rect(Rect(sx, r.y + r.h - 2, sw, 2), field(opts, "underline", t.accent))
  end
  draw_line({x: r.x, y: r.y + r.h}, {x: r.x + r.w, y: r.y + r.h}, field(opts, "rule", hair(t)))
  chosen
end

# ── Cycle ──────────────────────────────────────────────────────────────────

# ‹ value › — the arrows step back and forward through `options`, wrapping,
# and a click on the value steps forward. Returns the new index (an `index`
# outside the list reads as 0). This is `ui`'s `stepper`; bloom's own
# `stepper` steps a number.
#
# `opts`: {labels (shown in place of `str(option)`), size, bg, hover, fg,
# radius, arrow_w (22)}.
pub fn cycle(r: record, options: list, index: num) -> num
  cycle(r, options, index, {})
end

pub fn cycle(r: record, options: list, index: num, opts: record) -> num
  let t = theme()
  let n = len(options)
  let i = if index >= 0 && index < n then index else 0 end
  let aw = field(opts, "arrow_w", 22)
  let radius = field(opts, "radius", t.radius_sm)
  let left = Rect(r.x, r.y, aw, r.h)
  let right = Rect(r.x + r.w - aw, r.y, aw, r.h)
  let mid = Rect(r.x + aw, r.y, r.w - 2 * aw, r.h)
  draw_rect_rounded(r, radius, field(opts, "bg", tone(t, t.panel, 0.12)))
  let out = i
  if n > 0 then
    let lp = probe(left)
    let rp = probe(right)
    let mp = probe(mid)
    let hover = field(opts, "hover", t.hover)
    for side in [{p: lp, r: left, name: "chevron_left"}, {p: rp, r: right, name: "chevron_right"}] do
      if side.p.hot > 0.01 then
        draw_rect_rounded(pad(side.r, 2), radius, mix(field(opts, "bg", tone(t, t.panel, 0.12)), hover, side.p.hot))
      end
      let c = mix(t.muted, t.text, side.p.hot)
      icon(side.name, pad(side.r, max(4.0, min(side.r.w, side.r.h) * 0.28)), c)
    end
    if lp.click then
      out = (i + n - 1) % n
    end
    if rp.click || mp.click then
      out = (i + 1) % n
    end
  end
  let labels = field(opts, "labels", nil)
  let shown = if n == 0 then
    ""
  elsif labels != nil && i < len(labels) then
    str(labels[i])
  else
    str(options[i])
  end
  let style = ts(t, field(opts, "size", t.font_sm), field(opts, "fg", t.text))
  draw_text_line(text_cut(shown, style, max(0, mid.w - 4)), mid, style, "center")
  out
end

# ── Splitter ───────────────────────────────────────────────────────────────

# A draggable divider splitting `r` in two. `frac` is the caller's: pass it
# in, store what comes back. The drag itself is per callsite.
#
#   state left = 0.3
#   let s = bloom.splitter(content, left)
#   left = s.frac
#   ...draw into s.a (left / top) and s.b (right / bottom)...
#
# Returns {frac, a, b, divider, dragging}. `opts`: axis ("x", the default: a
# vertical divider sliding left–right, side-by-side panes; "y": top and
# bottom; "h" and "v" are accepted as "x" and "y"), min_a / min_b (px floors
# for each side, 80), min / max (bounds on `frac`, 0.02 / 0.98), band (the
# grab zone's thickness, 9), gap (blank space beside the line, 4), line /
# active (colours).
pub fn splitter(r: record, frac: num) -> record
  _splitter(r, frac, {})
end

pub fn splitter(r: record, frac: num, opts: record) -> record
  _splitter(r, frac, opts)
end

# `splitter` is also `ui`'s; see bloom/button's `button_impl`.
fn _splitter(r: record, frac: num, opts: record) -> record
  let t = theme()
  let axis0 = field(opts, "axis", "x")
  let horiz = axis0 == "x" || axis0 == "h"
  let min_a = field(opts, "min_a", 80)
  let min_b = field(opts, "min_b", 80)
  let band = field(opts, "band", 9)
  let gap = field(opts, "gap", 4)
  let lo = float(field(opts, "min", 0.02))
  let hi = float(field(opts, "max", 0.98))
  let total = if horiz then r.w else r.h end
  let f = clamp(float(frac), lo, hi)
  let top = float(max(min_a, total - min_b))
  let apx0 = clamp(float(total) * f, float(min_a), top)
  let hit0 = _split_band(r, horiz, apx0, band)
  # The drag starts on the band and keeps following the pointer off it.
  let d = drag(hit0)
  if d.active then
    let along = if horiz then mouse_x() - r.x else mouse_y() - r.y end
    f = clamp(float(along) / float(max(1, total)), lo, hi)
  end
  let apx = int(clamp(float(total) * f, float(min_a), top))
  let hit = _split_band(r, horiz, float(apx), band)
  let hot = ease_flag(d.active || probe(hit).hover, rate(t, 18.0))
  let lc = mix(field(opts, "line", hair(t)), field(opts, "active", t.accent), hot)
  let lw = if hot > 0.5 then 2 else 1 end
  let a = if horiz then Rect(r.x, r.y, apx - gap, r.h) else Rect(r.x, r.y, r.w, apx - gap) end
  let b = if horiz then
    Rect(r.x + apx + gap, r.y, r.w - apx - gap, r.h)
  else
    Rect(r.x, r.y + apx + gap, r.w, r.h - apx - gap)
  end
  if horiz then
    draw_line({x: r.x + apx, y: r.y}, {x: r.x + apx, y: r.y + r.h}, lc, 255, lw)
  else
    draw_line({x: r.x, y: r.y + apx}, {x: r.x + r.w, y: r.y + apx}, lc, 255, lw)
  end
  {frac: f, a: a, b: b, divider: hit, dragging: d.active}
end

fn _split_band(r: record, horiz: bool, apx: num, band: num) -> record
  if horiz then
    Rect(r.x + apx - band / 2.0, r.y, band, r.h)
  else
    Rect(r.x, r.y + apx - band / 2.0, r.w, band)
  end
end

# ── Table ──────────────────────────────────────────────────────────────────

# Column rects for `cols` across `r`: each col is {label, w} — `w` >= 1 is
# fixed pixels, 0 < w < 1 a weight over what is left, missing or 0 an equal
# share of it.
pub fn table_columns(r: record, cols: list) -> list
  let fixed = 0
  let weights = 0.0
  for c in cols do
    let w = float(field(c, "w", 0))
    if w >= 1.0 then
      fixed += int(w)
    elsif w > 0.0 then
      weights += w
    else
      weights += 1.0
    end
  end
  let leftover = max(0, r.w - fixed)
  let out = []
  let x = r.x
  for c in cols do
    let w = float(field(c, "w", 0))
    let cw = 0
    if w >= 1.0 then
      cw = int(w)
    else
      let wt = if w > 0.0 then w else 1.0 end
      if weights > 0.0 then
        cw = int(float(leftover) * wt / weights)
      end
    end
    out = append(out, Rect(x, r.y, cw, r.h))
    x += cw
  end
  out
end

# A header and rows grid: column sizing (`table_columns`), list selection
# (j/k, arrows, page keys, a press on a row; the wheel scrolls), zebra rows,
# a scrollbar, and click-to-sort headers. The table records the *request*
# (`sort_col`, `sort_asc`); the caller owns the data and sorts it — the
# table never reorders rows.
#
#   let tb = bloom.table(r, [{label: "Name", w: 0.6}, {label: "Size", w: 90}], rows)
#   ...sort `rows` by tb.sort_col / tb.sort_asc before passing them in...
#
# `rows` is a list of row lists. The selection, the scroll and the sort live
# per callsite. Returns {selected, scroll, sort_col, sort_asc, changed,
# clicked} — `changed` is true on a frame the selection moved, `clicked` the
# row pressed this frame, else -1.
#
# `opts`: {row_h (26), head_h (28), size, fg, head_bg, selection, zebra, rule,
# on, active} — `active: false` turns the keyboard off (the table does not
# have the focus); `on` is the surface the grid sits on. `selected` /
# `sort_col` / `sort_asc` in `opts` set those from the caller every frame,
# for a table whose selection the app also moves.
pub fn table(r: record, cols: list, rows: list) -> record
  _table(r, cols, rows, {})
end

pub fn table(r: record, cols: list, rows: list, opts: record) -> record
  _table(r, cols, rows, opts)
end

# `table` is also `ui`'s; see bloom/button's `button_impl`.
fn _table(r: record, cols: list, rows: list, opts: record) -> record
  state sel = 0
  state scroll = 0
  state sort_col = -1
  state sort_asc = true
  sel = field(opts, "selected", sel)
  sort_col = field(opts, "sort_col", sort_col)
  sort_asc = field(opts, "sort_asc", sort_asc)
  let t = theme()
  let row_h = field(opts, "row_h", 26)
  let head_h = field(opts, "head_h", 28)
  let size = field(opts, "size", t.font_md)
  let on = field(opts, "on", t.bg)
  let parts = cut_top(r, head_h)
  let head = parts.cut
  let body = parts.rest
  let crects = table_columns(head, cols)
  draw_rect(head, field(opts, "head_bg", t.panel))
  for i in range(0, len(cols)) do
    let cr = crects[i]
    let p = probe(cr)
    if p.click then
      if sort_col == i then
        sort_asc = !sort_asc
      else
        sort_col = i
        sort_asc = true
      end
    end
    let label = field(cols[i], "label", "")
    let fg = if sort_col == i then t.text else mix(t.muted, t.text, p.hot * 0.5) end
    let head_ts = {...ts(t, size, fg), weight: 600}
    let lw = draw_text_line(label, Rect(cr.x + 8, head.y, max(0, cr.w - 16), head_h), head_ts, "left")
    if sort_col == i then
      let arrow = if sort_asc then "chevron_up" else "chevron_down" end
      let s = size * 0.8
      icon(arrow, Rect(cr.x + 12 + lw, head.y + (head_h - s) / 2.0, s, s), t.accent)
    end
  end
  draw_line({x: r.x, y: body.y}, {x: r.x + r.w, y: body.y}, field(opts, "rule", hair(t)))
  let visible = max(1, body.h / row_h)
  let lr = Rect(body.x, body.y, body.w, visible * row_h)
  let before = sel
  let clicked = -1
  # While an overlay holds the pointer (an open bloom menu), the list stands
  # still: `list_update` reads the mouse itself.
  if pointer_free(lr) then
    let pressed = mouse_pressed(0) && point_in(mouse_x(), mouse_y(), lr)
    let lst = list_update({selected: sel, scroll: scroll}, len(rows), visible, lr,
      field(opts, "active", true))
    sel = lst.selected
    scroll = lst.scroll
    if pressed then
      clicked = sel
    end
  end
  let zebra = field(opts, "zebra", true)
  let cell_ts = ts(t, size, field(opts, "fg", t.text))
  for vi in range(0, max(0, min(visible, len(rows) - scroll))) do
    let idx = scroll + vi
    let rr = Rect(body.x, body.y + vi * row_h, body.w, row_h)
    if idx == sel then
      draw_rect(rr, field(opts, "selection", t.selection))
    elsif pointer_free(rr) && point_in(mouse_x(), mouse_y(), rr) then
      draw_rect(rr, t.hover)
    elsif zebra && idx % 2 == 1 then
      draw_rect(rr, over(on, t.hover, 70))
    end
    let cells = rows[idx]
    for ci in range(0, min(len(cols), len(cells))) do
      let cr = crects[ci]
      let cell = Rect(cr.x + 8, rr.y, max(0, cr.w - 16), row_h)
      draw_text_line(text_cut(str(cells[ci]), cell_ts, cell.w), cell, cell_ts, "left")
    end
  end
  scrollbar(lr, len(rows), visible, scroll)
  {selected: sel, scroll: scroll, sort_col: sort_col, sort_asc: sort_asc,
    changed: sel != before, clicked: clicked}
end
