from datetime import datetime

def read_tides(path):
    with open(path) as f:
        for row in csv.DictReader(f):
            yield datetime.fromisoformat(row["time"]), float(row["height_m"])

def highs(tides):
    prev, rising = None, False
    for t, h in tides:
        if prev and h < prev[1] and rising:
            yield prev
        rising = prev is not None and h > prev[1]
        prev = (t, h)

for when, height in highs(read_tides("dataset-tides-2025.csv")):
    print(f"{when:%d %b %H:%M}  {height:.2f} m")"""],
