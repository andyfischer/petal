// ── Pure helpers ─────────────────────────────────────────────────────────

fn tx(s: string, x: num, y: num, style: record) -> nil
  draw_text(s, pos: {x: int(x), y: int(y)}, style: style)
end

fn tx_right(s: string, right_x: num, y: num, style: record) -> nil
  draw_text(s, pos: {x: int(right_x) - text_width(s, style), y: int(y)}, style: style)
end

fn tx_center(s: string, cx: num, y: num, style: record) -> nil
  draw_text(s, pos: {x: int(cx) - text_width(s, style) / 2, y: int(y)}, style: style)
end

// Floor division and the matching always-positive remainder.
fn fdiv(a: int, b: int) -> int
  let q = a / b
  if a % b != 0 && a < 0 then q - 1 else q end
end

fn pmod(a: int, b: int) -> int
  let m = a % b
  if m < 0 then m + b else m end
end

// A float with exactly `places` decimals, never in exponent form.
fn fixed(v: num, places: int) -> string
  let neg = v < 0.0
  let a = abs(float(v))
  let whole = floor(a)
  let scale10 = pow(10.0, float(places))
  let frac = round((a - whole) * scale10)
  if frac >= scale10 then
    whole += 1.0
    frac = 0.0
  end
  let digits = pad_start(str(int(frac)), places, "0")
  let sign_s = if neg && (whole > 0.0 || frac > 0.0) then "-" else "" end
  if places == 0 then "{sign_s}{int(whole)}" else "{sign_s}{int(whole)}.{digits}" end
end

// 1234567 -> "1,234,567"
fn fmt_int(v: num) -> string
  let cs = chars(str(int(v)))
  let out = ""
  for i in range(0, len(cs)) do
    if i > 0 && (len(cs) - i) % 3 == 0 then out ++= "," end
    out ++= cs[i]
  end
  out
end

// Magnification: 1.0x, 240x, 12.5kx, 3.4Mx, then powers of ten.
fn fmt_mag(m: num) -> string
  if m < 10.0 then "{fixed(m, 2)}x"
  elsif m < 1000.0 then "{fixed(m, 0)}x"
  elsif m < 1000000.0 then "{fixed(m / 1000.0, 1)}k x"
  elsif m < 1000000000.0 then "{fixed(m / 1000000.0, 1)}M x"
  else
    let e = int(floor(log(m) / log(10.0)))
    "{fixed(m / pow(10.0, float(e)), 1)}e{e} x"
  end
end

fn fmt_complex(re: num, im: num, places: int) -> string
  let sign_s = if im < 0.0 then "-" else "+" end
  "{fixed(re, places)} {sign_s} {fixed(abs(im), places)}i"
end

// ── Escape-time kernels ──────────────────────────────────────────────────
// Each runs four iterations between bailout tests and returns the smooth
// iteration count, or -1.0 for a point that never escaped. Testing every
// fourth step is safe with a 2^16 bailout: |z| cannot overflow in four
// squarings, and the smooth count n + 1 - log2(ln|z|) is the same number
// whichever step it is read at.

fn esc_quad(zr0: float, zi0: float, cr: float, ci: float, chunks: int) -> float
  let zr = zr0
  let zi = zi0
  let m = 0.0
  let n = -1
  for k in range(0, chunks) do
    let t = zr * zr - zi * zi + cr
    zi = 2.0 * zr * zi + ci
    zr = t * t - zi * zi + cr
    zi = 2.0 * t * zi + ci
    t = zr * zr - zi * zi + cr
    zi = 2.0 * zr * zi + ci
    zr = t * t - zi * zi + cr
    zi = 2.0 * t * zi + ci
    m = zr * zr + zi * zi
    if m > BAIL then
      n = k
      break
    end
  end
  if n < 0 then return -1.0 end
  float(n * 4 + 5) - log(0.5 * log(m)) * INV_LN2
end

fn esc_ship(cr: float, ci: float, chunks: int) -> float
  let zr = 0.0
  let zi = 0.0
  let m = 0.0
  let n = -1
  for k in range(0, chunks) do
    let t = zr * zr - zi * zi + cr
    zi = abs(2.0 * zr * zi) + ci
    zr = t * t - zi * zi + cr
    zi = abs(2.0 * t * zi) + ci
    t = zr * zr - zi * zi + cr
    zi = abs(2.0 * zr * zi) + ci
    zr = t * t - zi * zi + cr
    zi = abs(2.0 * t * zi) + ci
    m = zr * zr + zi * zi
    if m > BAIL then
      n = k
      break
    end
  end
  if n < 0 then return -1.0 end
  float(n * 4 + 5) - log(0.5 * log(m)) * INV_LN2
end

fn esc_tri(cr: float, ci: float, chunks: int) -> float
  let zr = 0.0
  let zi = 0.0
  let m = 0.0
  let n = -1
  for k in range(0, chunks) do
    let t = zr * zr - zi * zi + cr
    zi = ci - 2.0 * zr * zi
    zr = t * t - zi * zi + cr
    zi = ci - 2.0 * t * zi
    t = zr * zr - zi * zi + cr
    zi = ci - 2.0 * zr * zi
    zr = t * t - zi * zi + cr
    zi = ci - 2.0 * t * zi
    m = zr * zr + zi * zi
    if m > BAIL then
      n = k
      break
    end
  end
  if n < 0 then return -1.0 end
  float(n * 4 + 5) - log(0.5 * log(m)) * INV_LN2
end

// Smooth count -> palette phase in cycles (before the band density). The
// log keeps the bands a readable width at every depth: one cycle per
// PHASE_OCT doublings of the count, however deep the view.
fn phase_of(mu: float) -> float
  log(1.0 + max(mu, 0.0) * 0.125) * INV_LN2 / PHASE_OCT
end

fn mu_of(phase: float) -> float
  (exp(phase * PHASE_OCT / INV_LN2) - 1.0) * 8.0
end

// ── Palette tables ───────────────────────────────────────────────────────
// Every palette as LN colours, flattened into three int lists so the draw
// loop reads ints and never builds a colour record.

fn build_lut() -> record
  let cols = []
  for pal in PALS do
    let stops = pal.stops
    let count = len(stops)
    for i in range(0, LN) do
      let t = float(i) / float(LN)
      let k = count - 1
      for q in range(0, count) do
        if stops[q].p <= t then k = q end
      end
      let a = stops[k]
      let b = stops[(k + 1) % count]
      let b_p = if k == count - 1 then 1.0 else b.p end
      let c = lerp(a.c, b.c, (t - a.p) / (b_p - a.p))
      cols = append(cols, c)
    end
  end
  {r: map(cols, fn(c) -> c.r), g: map(cols, fn(c) -> c.g), b: map(cols, fn(c) -> c.b)}
end

// ── Layout ───────────────────────────────────────────────────────────────

let W = screen_width()
let H = screen_height()
let PAD = 20
let HEAD = 76
let FOOT = 56
let SIDE_W = 272
let cv = rect(PAD, HEAD, W - PAD * 2 - SIDE_W - 16, H - HEAD - FOOT)
let side = rect(cv.x + cv.w + 16, HEAD, SIDE_W, cv.h)
let CW = cv.w
let CH = cv.h
let NX = CW / TPX + 2
let NY = CH / TPX + 2
let NSLOT = NX * NY

// Sidebar geometry, shared by the input pass and the draw pass.
let SX = side.x + 16
let SWI = side.w - 32
let CHIP_H = 28
let y_kind = side.y + 16
let y_map = y_kind + 20 + 2 * (CHIP_H + 6) + 12
let map_r = rect(SX, y_map + 20, SWI, 144)
let y_iter = map_r.y + map_r.h + 16
let y_pal = y_iter + 20 + CHIP_H + 16
let y_detail = y_pal + 20 + CHIP_H + 6 + CHIP_H + 16
let y_place = y_detail + 20 + CHIP_H + 16
let PLACE_H = 24

fn kind_chip(i: int) -> Rect
  let cw2 = (SWI - 6) / 2
  rect(SX + (i % 2) * (cw2 + 6), y_kind + 20 + (i / 2) * (CHIP_H + 6), cw2, CHIP_H)
end

let iter_minus = rect(SX, y_iter + 20, 30, CHIP_H)
let iter_plus = rect(SX + 124, y_iter + 20, 30, CHIP_H)
let iter_auto = rect(SX + SWI - 76, y_iter + 20, 76, CHIP_H)

fn pal_chip(i: int) -> Rect
  let pw = (SWI - 4 * 6) / 5
  rect(SX + i * (pw + 6), y_pal + 20, pw, CHIP_H)
end

let band_minus = rect(SX, y_pal + 20 + CHIP_H + 6, 30, CHIP_H)
let band_plus = rect(SX + 124, y_pal + 20 + CHIP_H + 6, 30, CHIP_H)
let cycle_chip = rect(SX + SWI - 76, y_pal + 20 + CHIP_H + 6, 76, CHIP_H)

fn detail_chip(i: int) -> Rect
  let dw = (SWI - 76 - 6 - 2 * 6) / 3
  rect(SX + i * (dw + 6), y_detail + 20, dw, CHIP_H)
end

let tiles_chip = rect(SX + SWI - 76, y_detail + 20, 76, CHIP_H)

fn place_row(i: int) -> Rect
  rect(side.x + 8, y_place + 20 + i * PLACE_H, side.w - 16, PLACE_H)
end

// The locator map: the whole of one fractal, drawn small. A Julia set is
// located by its seed, so it shares the Mandelbrot map.
let MM_CELL = 3
let MAP_OF = [0, 0, 2, 3]            // which fractal's map each kind shows

// Where map px (0, 0) sits and how much plane one map px covers. `wy` is
// the plane's vertical axis as the screen draws it, top to bottom.
fn map_geom(k: int) -> record
  let ms = KINDS[k].span * 1.12 / float(SWI)
  {ms: ms, wx0: KINDS[k].cx - ms * float(SWI) / 2.0,
    wy0: KINDS[k].cy * KINDS[k].ys - ms * float(map_r.h) / 2.0}
end

// ── Persistent state ─────────────────────────────────────────────────────

state lut = build_lut()

// The view: world units per px, and the canvas origin in whole world px.
state var scale = 1.0
state var ox = 0
state var oy = 0
state var kind = 0
state var jr = -0.123                // the Julia seed
state var ji = 0.745
state var maxit = 192
state var auto_iter = true
state var epoch = 1                  // bumped whenever cached samples go stale
state var views = [nil, nil, nil, nil]

// Tile slots. A tile (tx, ty) lives in slot (tx mod NX, ty mod NY), so a pan
// never moves any data: tiles that scroll out are overwritten in place.
state var alloc = 0
state var vals = f64_array(1)        // NSLOT x TN palette phases; -1 = inside
state var t_tx = []
state var t_ty = []
state var t_ep = []                  // the epoch a slot's samples belong to
state var t_lod = []                 // 0 = empty, 1..4 = sharpest finished level
state var t_uni = []                 // 1 = every sample is inside the set
state var t_cap = []                 // sharpest level the draw budget allows it
state var t_n = []                   // segments in the slot's draw list
state var t_fit = []                 // what the draw list was fitted for
state var sgx = f64_array(1)         // draw lists: NSLOT x SEGCAP, tile-local px
state var sgy = f64_array(1)
state var sgw = f64_array(1)
state var sgh = f64_array(1)
state var sga = f64_array(1)         // phase at the left edge, or -1 = inside
state var sgb = f64_array(1)         // phase at the right edge

// The refinement queue: visible slots, nearest the pointer first.
state var queue = []
state var pass_lod = 1
state var qi = 0
state var job_s = -1
state var job_row = 0
state var samples_done = 0
state var iters_done = 0

// The zoom preview: the last sharp image, in the px space of its own view.
state var pvx = f64_array(1)
state var pvy = f64_array(1)
state var pvw = f64_array(1)
state var pvh = f64_array(1)
state var pva = f64_array(1)
state var pvb = f64_array(1)
state var pv_n = 0
state var pv_scale = 1.0
state var pv_ox = 0
state var pv_oy = 0
state var pv_cell = 2.0              // px per sample of the preview's coarsest tile

// What last frame's draw pass saw, for decisions made before this one's.
state var st_blank = 0
state var st_maxcell = 0.0

state ready = false
state q_key = [0, 0, 0, 0]
state pal = 0
state band_i = 2
state detail_i = 0
state cycling = false
state cycle_off = 0.0
state show_tiles = false
state dragging = false
state drag_mx = 0
state drag_my = 0
state drag_ox = 0
state drag_oy = 0
state map_drag = false
state pan_fx = 0.0
state pan_fy = 0.0
state pend_j = false                 // a Julia seed waiting for a coarse pass
state pend_jr = 0.0
state pend_ji = 0.0
state last_mx = 0
state last_my = 0
state zooms = 0
state pans = 0
state maps = [nil, nil, nil, nil]     // locator draw lists, built on first use

// ── View and cache edits ─────────────────────────────────────────────────

fn slot_of(tile_x: int, tile_y: int) -> int
  pmod(tile_x, NX) + pmod(tile_y, NY) * NX
end

// Iterations that suit a magnification: deeper views need more to resolve.
fn auto_maxit(s: float, k: int) -> int
  let home = KINDS[k].span / float(CW)
  let depth = max(log(home / s) * INV_LN2, 0.0)
  let base = if k == K_JULIA then 128.0 else 176.0 end
  let v = int(base + 52.0 * depth)
  min(v / 16 * 16, 4096)
end

// Copy what is on screen into the preview, unless the preview already held
// is sharper than the tiles (a second zoom before the first one finished).
fn keep_preview(wipe: bool) -> nil
  let have = get pv_n > 0
  let r = if have then get pv_scale / get scale else 1.0 end
  if have && (get st_blank > 0 || get st_maxcell > get pv_cell * r + 0.01) then
    if wipe then set pv_cell = 1000000.0 end
    return nil
  end
  let vx0 = get ox
  let vy0 = get oy
  let ep = get epoch
  let n = 0
  let coarsest = 0.0
  for tile_y in range(fdiv(vy0, TPX), fdiv(vy0 + CH - 1, TPX) + 1) do
    for tile_x in range(fdiv(vx0, TPX), fdiv(vx0 + CW - 1, TPX) + 1) do
      let s = slot_of(tile_x, tile_y)
      if get t_ep[s] != ep || get t_tx[s] != tile_x || get t_ty[s] != tile_y then continue end
      let lod = get t_lod[s]
      if lod == 0 then continue end
      if get t_uni[s] == 0 then coarsest = max(coarsest, float(STEPS[lod] * CELL)) end
      let bx = float(tile_x * TPX - vx0)
      let by = float(tile_y * TPX - vy0)
      let so = s * SEGCAP
      for i in range(so, so + get t_n[s]) do
        if n >= PVCAP then break end
        set pvx[n] = bx + get sgx[i]
        set pvy[n] = by + get sgy[i]
        set pvw[n] = get sgw[i]
        set pvh[n] = get sgh[i]
        set pva[n] = get sga[i]
        set pvb[n] = get sgb[i]
        n += 1
      end
    end
  end
  set pv_n = n
  set pv_scale = get scale
  set pv_ox = vx0
  set pv_oy = vy0
  set pv_cell = if wipe then 1000000.0 else max(coarsest, float(CELL)) end
end

// Every cached sample is now stale.
fn invalidate() -> nil
  set epoch += 1
  set job_s = -1
end

// Zoom by `factor` (> 1 is in), keeping the canvas point (px, py) fixed.
fn zoom_at(px: num, py: num, factor: num) -> nil
  let s0 = get scale
  let widest = 16.0 / float(CW)
  let s1 = clamp(s0 / factor, lo: MIN_SCALE, hi: widest)
  if s1 == s0 then return nil end
  let wx = float(get ox + int(px)) * s0
  let wy = float(get oy + int(py)) * s0
  keep_preview(false)
  set scale = s1
  set ox = int(round(wx / s1)) - int(px)
  set oy = int(round(wy / s1)) - int(py)
  if get auto_iter then set maxit = auto_maxit(s1, get kind) end
  invalidate()
end

// Show the window `span` wide centred on (cx, cy) of fractal k's plane.
fn frame_view(k: int, cx: num, cy: num, span: num) -> nil
  let s = max(span / float(CW), MIN_SCALE)
  set scale = s
  set ox = int(round(cx / s)) - CW / 2
  set oy = int(round(cy * KINDS[k].ys / s)) - CH / 2
  if get auto_iter then set maxit = auto_maxit(s, k) end
  invalidate()
end

fn home_view(k: int) -> nil
  frame_view(k, KINDS[k].cx, KINDS[k].cy, KINDS[k].span)
end

// Switch fractal, remembering where the old one was left.
fn switch_kind(k: int) -> nil
  let old = get kind
  if k == old then return nil end
  set views[old] = {scale: get scale, ox: get ox, oy: get oy}
  set kind = k
  set pv_n = 0
  let v = get views[k]
  if v == nil then
    home_view(k)
  else
    set scale = v.scale
    set ox = v.ox
    set oy = v.oy
    if get auto_iter then set maxit = auto_maxit(v.scale, k) end
    invalidate()
  end
end

fn set_seed(re: num, im: num) -> nil
  keep_preview(true)
  set jr = float(re)
  set ji = float(im)
  invalidate()
end

fn set_maxit(v: int) -> nil
  if v == get maxit then return nil end
  keep_preview(false)
  set maxit = v
  invalidate()
end

fn go_place(i: int) -> nil
  let k = get kind
  let p = PLACES[k][i]
  set pv_n = 0
  if k == K_JULIA then
    set jr = p.x
    set ji = p.y
    frame_view(k, 0.0, 0.0, p.span)
  else
    frame_view(k, p.x, p.y, p.span)
  end
end

// Which of fractal k's places the view is showing now, or -1.
fn at_place(k: int) -> int
  let found = -1
  let list = PLACES[k]
  for i in range(0, len(list)) do
    let p = list[i]
    if k == K_JULIA then
      if abs(get jr - p.x) < 0.000000001 && abs(get ji - p.y) < 0.000000001 then found = i end
    else
      let s = max(p.span / float(CW), MIN_SCALE)
      if abs(get scale / s - 1.0) < 0.001 &&
        abs(get ox - (int(round(p.x / s)) - CW / 2)) <= 2 &&
        abs(get oy - (int(round(p.y * KINDS[k].ys / s)) - CH / 2)) <= 2 then
        found = i
      end
    end
  end
  found
end

// ── Fitting a tile's draw list ───────────────────────────────────────────
// Walk each sample row of slot s at level `lod`. A run of interior samples
// becomes one rect. Exterior samples are joined into the longest gradient
// whose straight line stays within `eps` of every sample it passes (the
// slope cone is narrowed sample by sample, so the fit is one pass). A row
// that repeats the row above it is merged into it. Returns true when the
// whole tile is interior.

fn fit_tile(s: int, lod: int, dens: float) -> bool
  let st = STEPS[lod]
  let count = TS / st
  let cpx = float(st * CELL)
  let base = s * TN
  let so = s * SEGCAP
  let eps = fit_eps / dens
  let span = fit_span / dens
  let veps = merge_eps / dens
  let n = 0
  let all_in = true
  let grp = 0                        // first segment of the run of rows being extended
  let grp_n = -1
  if get t_uni[s] == 1 then
    set sgx[so] = 0.0
    set sgy[so] = 0.0
    set sgw[so] = float(TPX)
    set sgh[so] = float(TPX)
    set sga[so] = -1.0
    set sgb[so] = -1.0
    set t_n[s] = 1
    return true
  end
  for ry in range(0, count) do
    let rb = base + ry * st * TS
    let y = float(ry) * cpx
    let k = 0
    let row_start = n
    while k < count do
      let v0 = get vals[rb + k * st]
      if v0 < 0.0 then
        let k1 = k + 1
        while k1 < count && get vals[rb + k1 * st] < 0.0 do k1 += 1 end
        set sgx[so + n] = float(k) * cpx
        set sgy[so + n] = y
        set sgw[so + n] = float(k1 - k) * cpx
        set sgh[so + n] = cpx
        set sga[so + n] = -1.0
        set sgb[so + n] = -1.0
        n += 1
        k = k1
      else
        all_in = false
        let lo = -1000000.0
        let hi = 1000000.0
        let last = k
        let j = k + 1
        while j < count do
          let vj = get vals[rb + j * st]
          if vj < 0.0 then break end
          let d = float(j - k)
          let slope = (vj - v0) / d
          if slope < lo || slope > hi || abs(vj - v0) > span then break end
          lo = max(lo, slope - eps / d)
          hi = min(hi, slope + eps / d)
          last = j
          j += 1
        end
        set sgx[so + n] = float(k) * cpx
        set sgy[so + n] = y
        set sgh[so + n] = cpx
        set sga[so + n] = v0
        if last == k then
          // The neighbour is too far away in phase to be one ramp. Pair
          // the two samples in a single two-cell blend: half the draw
          // calls exactly where the picture is busiest.
          let vn = if k + 1 < count then get vals[rb + (k + 1) * st] else -1.0 end
          if vn < 0.0 then
            set sgw[so + n] = cpx
            set sgb[so + n] = v0
            k += 1
          else
            set sgw[so + n] = cpx * 2.0
            set sgb[so + n] = vn
            k += 2
          end
        elsif last == count - 1 then
          // The ramp reaches the tile's last sample: run it on to the
          // edge instead of spending a call on the final cell.
          let v_end = get vals[rb + last * st]
          set sgw[so + n] = float(count - k) * cpx
          set sgb[so + n] = v_end + (v_end - v0) / float(last - k)
          k = count
        else
          set sgw[so + n] = float(last - k) * cpx
          set sgb[so + n] = get vals[rb + last * st]
          k = last
        end
        n += 1
      end
    end
    // A row that repeats the one above (same cuts, phases within eps of
    // the first row of the run) makes that row taller instead of adding
    // calls: slow exterior and solid interior collapse vertically too.
    let row_n = n - row_start
    let same = row_n == grp_n
    if same then
      for q in range(0, row_n) do
        let a = so + grp + q
        let b = so + row_start + q
        if get sgx[a] != get sgx[b] || get sgw[a] != get sgw[b] ||
          abs(get sga[a] - get sga[b]) > veps || abs(get sgb[a] - get sgb[b]) > veps then
          same = false
          break
        end
      end
    end
    if same then
      for q in range(0, row_n) do
        set sgh[so + grp + q] = get sgh[so + grp + q] + cpx
      end
      n = row_start
    else
      grp = row_start
      grp_n = row_n
    end
  end
  set t_n[s] = n
  all_in
end

// ── The draw budget ──────────────────────────────────────────────────────
// Called as the worker is about to start level `lod` (the 2 px pass). A tile's draw list can grow about threefold per level, and a view
// full of filaments would end up costing several times `draw_budget` calls
// a frame. So the busiest tiles are held at the level they have: they are
// the ones whose next level is mostly aliasing, and the most expensive to
// compute. The worker then skips them, which saves the iterations too.

fn plan_caps(lod: int) -> nil
  let total = 0
  let cands = []
  for s in get queue do
    let have = get t_lod[s]
    let n = get t_n[s]
    if have == lod - 1 && get t_uni[s] == 0 then
      let est = min(int(float(n) * growth), TN / (STEPS[lod] * STEPS[lod]))
      set t_cap[s] = MAXLOD
      total += est
      cands = append(cands, {s: s, n: n, est: est})
    else
      total += n
    end
  end
  if total <= draw_budget then return nil end
  for it in sort_by(cands, fn(it) -> it.n, "desc") do
    if total <= draw_budget then break end
    set t_cap[it.s] = lod - 1
    total -= it.est - it.n
  end
end

// ── The refinement worker ────────────────────────────────────────────────
// Spend up to `budget` iterations. The queue is walked once per level, so
// every visible tile reaches 16 px before any reaches 8 px, and so on. A
// level computes only the samples the previous one skipped.

fn work(budget: int, cap: int, dens: float, fit_key: int) -> int
  let spent = 0
  let k = get kind
  let s_px = get scale * float(CELL)
  let ys = KINDS[k].ys
  let chunks = get maxit / 4
  let inside_cost = get maxit + sample_cost
  let c_re = get jr
  let c_im = get ji
  let qn = len(get queue)
  while spent < budget do
    if get job_s < 0 then
      let found = false
      while get pass_lod <= cap do
        while get qi < qn do
          let cand = get queue[get qi]
          if get t_lod[cand] == get pass_lod - 1 && get t_cap[cand] >= get pass_lod then
            set job_s = cand
            set job_row = 0
            found = true
            break
          end
          set qi += 1
        end
        if found then break end
        set pass_lod += 1
        set qi = 0
        if get pass_lod == MAXLOD && cap == MAXLOD then plan_caps(MAXLOD) end
      end
      if !found then return spent end
    end

    let s = get job_s
    let lod = get t_lod[s] + 1
    let st = STEPS[lod]
    let count = TS / st
    let base = s * TN
    let gx0 = get t_tx[s] * TS
    let gy0 = get t_ty[s] * TS
    let fresh = lod == 1             // level 1 has nothing to reuse
    let row = get job_row
    while row < count && spent < budget do
      let ly = row * st
      let y = float(gy0 + ly) * s_px * ys
      let odd_row = fresh || ly % (st * 2) != 0
      let rb = base + ly * TS
      for col in range(0, count) do
        let lx = col * st
        if !odd_row && lx % (st * 2) == 0 then continue end
        let x = float(gx0 + lx) * s_px
        let mu = -1.0
        if k == K_MANDEL then
          // The main cardioid and the period-2 bulb are interior: no loop.
          let xq = x - 0.25
          let q = xq * xq + y * y
          if q * (q + xq) < 0.25 * y * y || (x + 1.0) * (x + 1.0) + y * y < 0.0625 then
            spent += sample_cost
          else
            mu = esc_quad(0.0, 0.0, x, y, chunks)
            spent += if mu < 0.0 then inside_cost else int(mu) + sample_cost end
          end
        else
          if k == K_JULIA then mu = esc_quad(x, y, c_re, c_im, chunks)
          elsif k == K_SHIP then mu = esc_ship(x, y, chunks)
          else mu = esc_tri(x, y, chunks)
          end
          spent += if mu < 0.0 then inside_cost else int(mu) + sample_cost end
        end
        set vals[rb + lx] = if mu < 0.0 then -1.0 else phase_of(mu) end
      end
      row += 1
    end
    set job_row = row
    if row >= count then
      let all_in = fit_tile(s, lod, dens)
      if all_in && lod >= 3 then
        // Interior at 4 px everywhere: the finer levels would only agree.
        set t_uni[s] = 1
        set t_lod[s] = MAXLOD
      else
        set t_lod[s] = lod
      end
      set t_fit[s] = fit_key + lod
      set samples_done += count * count
      set job_s = -1
      set qi += 1
    end
  end
  set iters_done += spent
  spent
end

// Claim a slot for every visible tile and order them for the worker.
fn build_queue(fx: num, fy: num) -> nil
  let vx0 = get ox
  let vy0 = get oy
  let ep = get epoch
  let items = []
  let keep_job = false
  for tile_y in range(fdiv(vy0, TPX), fdiv(vy0 + CH - 1, TPX) + 1) do
    for tile_x in range(fdiv(vx0, TPX), fdiv(vx0 + CW - 1, TPX) + 1) do
      let s = slot_of(tile_x, tile_y)
      if get t_ep[s] != ep || get t_tx[s] != tile_x || get t_ty[s] != tile_y then
        set t_ep[s] = ep
        set t_tx[s] = tile_x
        set t_ty[s] = tile_y
        set t_lod[s] = 0
        set t_uni[s] = 0
        set t_cap[s] = MAXLOD
        set t_n[s] = 0
      elsif s == get job_s then
        keep_job = true
      end
      let dx = float(tile_x * TPX + TPX / 2 - vx0) - fx
      let dy = float(tile_y * TPX + TPX / 2 - vy0) - fy
      items = append(items, {s: s, d: dx * dx + dy * dy})
    end
  end
  if !keep_job then set job_s = -1 end
  set queue = map(sort_by(items, fn(it) -> it.d), fn(it) -> it.s)
  set pass_lod = 1
  set qi = 0
end

// A locator map: fractal k at 3 px cells, as solid runs of a 14-step ramp.
fn build_map(k: int) -> record
  let g = map_geom(k)
  let ys = KINDS[k].ys
  let cols = map_r.w / MM_CELL
  let rows = map_r.h / MM_CELL
  let xs = []
  let tops = []
  let ws = []
  let cs = []
  for j in range(0, rows) do
    let im = (g.wy0 + (float(j) + 0.5) * float(MM_CELL) * g.ms) * ys
    let run = 0
    let run_c = -1
    for i in range(0, cols + 1) do
      let level = -2
      if i < cols then
        let re = g.wx0 + (float(i) + 0.5) * float(MM_CELL) * g.ms
        let mu = if k == K_SHIP then esc_ship(re, im, 12)
        elsif k == K_TRI then esc_tri(re, im, 12)
        else esc_quad(0.0, 0.0, re, im, 12)
        end
        level = if mu < 0.0 then 13 else min(int(sqrt(max(mu, 0.0)) * 2.2), 12) end
      end
      if level != run_c then
        if run_c > 0 then
          xs = append(xs, run * MM_CELL)
          tops = append(tops, j * MM_CELL)
          ws = append(ws, (i - run) * MM_CELL)
          cs = append(cs, run_c)
        end
        run = i
        run_c = level
      end
    end
  end
  {n: len(xs), x: xs, y: tops, w: ws, c: cs}
end

// Issue slot s's draw list with its top-left at pane px (x, y). The phase
// becomes a colour here, through the palette table: one rect per interior
// run, one gradient rect per fitted ramp. Returns the number of calls.
fn draw_tile(s: int, x: int, y: int, pbase: int, dens: float, off: float, lr: list, lg: list, lb: list) -> int
  let fx = float(x)
  let fy = float(y)
  let so = s * SEGCAP
  let n = get t_n[s]
  let lnf = float(LN)
  for i in range(so, so + n) do
    let a = get sga[i]
    if a < 0.0 then
      draw_rect(fx + get sgx[i], fy + get sgy[i], get sgw[i], get sgh[i], C_INSIDE.r, C_INSIDE.g, C_INSIDE.b)
    else
      let ia = pbase + int(fract(a * dens + off) * lnf)
      let ib = pbase + int(fract(get sgb[i] * dens + off) * lnf)
      draw_rect_gradient(fx + get sgx[i], fy + get sgy[i], get sgw[i], get sgh[i],
        lr[ia], lg[ia], lb[ia], 255, lr[ib], lg[ib], lb[ib], 255, 0.0)
    end
  end
  n
end

// Issue the zoom preview: its segments scaled by `r` and moved by (dx, dy)
// into the canvas at pane px (x, y). Edges are rounded outwards, so scaled
// neighbours overlap by a pixel instead of leaving seams.
fn draw_preview(x: int, y: int, r: float, dx: float, dy: float, pbase: int, dens: float, off: float,
  lr: list, lg: list, lb: list) -> int
  let fcx = float(x)
  let fcy = float(y)
  let fcw = float(CW)
  let fch = float(CH)
  let lnf = float(LN)
  let n = 0
  for i in range(0, get pv_n) do
    let x0 = get pvx[i] * r + dx
    let x1 = x0 + get pvw[i] * r
    if x1 < 0.0 || x0 > fcw then continue end
    let y0 = get pvy[i] * r + dy
    let y1 = y0 + get pvh[i] * r
    if y1 < 0.0 || y0 > fch then continue end
    let px0 = floor(x0)
    let py0 = floor(y0)
    let a = get pva[i]
    if a < 0.0 then
      draw_rect(fcx + px0, fcy + py0, ceil(x1) - px0, ceil(y1) - py0, C_INSIDE.r, C_INSIDE.g, C_INSIDE.b)
    else
      let ia = pbase + int(fract(a * dens + off) * lnf)
      let ib = pbase + int(fract(get pvb[i] * dens + off) * lnf)
      draw_rect_gradient(fcx + px0, fcy + py0, ceil(x1) - px0, ceil(y1) - py0,
        lr[ia], lg[ia], lb[ia], 255, lr[ib], lg[ib], lb[ib], 255, 0.0)
    end
    n += 1
  end
  n
end

// ── Boot ─────────────────────────────────────────────────────────────────

if alloc != NSLOT then
  set alloc = NSLOT
  set vals = f64_array(NSLOT * TN)
  set t_tx = for i in range(0, NSLOT) do 0 end
  set t_ty = for i in range(0, NSLOT) do 0 end
  set t_ep = for i in range(0, NSLOT) do 0 end
  set t_lod = for i in range(0, NSLOT) do 0 end
  set t_uni = for i in range(0, NSLOT) do 0 end
  set t_cap = for i in range(0, NSLOT) do MAXLOD end
  set t_n = for i in range(0, NSLOT) do 0 end
  set t_fit = for i in range(0, NSLOT) do 0 end
  set sgx = f64_array(NSLOT * SEGCAP)
  set sgy = f64_array(NSLOT * SEGCAP)
  set sgw = f64_array(NSLOT * SEGCAP)
  set sgh = f64_array(NSLOT * SEGCAP)
  set sga = f64_array(NSLOT * SEGCAP)
  set sgb = f64_array(NSLOT * SEGCAP)
  set pvx = f64_array(PVCAP)
  set pvy = f64_array(PVCAP)
  set pvw = f64_array(PVCAP)
  set pvh = f64_array(PVCAP)
  set pva = f64_array(PVCAP)
  set pvb = f64_array(PVCAP)
  set pv_n = 0
  invalidate()
  maps = [nil, nil, nil, nil]
end
if !ready then
  ready = true
  home_view(0)
end
let map_k = MAP_OF[kind]
if maps[map_k] == nil then maps[map_k] = build_map(map_k) end
let mm = maps[map_k]
let mg = map_geom(map_k)

// ── Input ────────────────────────────────────────────────────────────────

let mx = mouse_x()
let my = mouse_y()
let in_cv = point_in(px: mx, py: my, r: cv)
let cmx = mx - cv.x                  // pointer in canvas px
let cmy = my - cv.y
let shift = mod_shift()
let pressed = mouse_pressed(0)
let moved = mx != last_mx || my != last_my
last_mx = mx
last_my = my
let places = PLACES[kind]
let busy_input = moved || mouse_down(0) || scroll_y() != 0.0

for i in range(0, len(KINDS)) do
  if key_pressed(KINDS[i].key) then switch_kind(i) end
end

// Keyboard pan: a tap nudges, a held key glides.
let glide = pan_speed * dt() * (if shift then 3.0 else 1.0 end)
let nudge = if shift then 192.0 else 48.0 end
if key_down("left") then pan_fx -= glide end
if key_down("right") then pan_fx += glide end
if key_down("up") then pan_fy -= glide end
if key_down("down") then pan_fy += glide end
if key_pressed("left") then pan_fx -= nudge end
if key_pressed("right") then pan_fx += nudge end
if key_pressed("up") then pan_fy -= nudge end
if key_pressed("down") then pan_fy += nudge end
let pan_ix = int(pan_fx)
let pan_iy = int(pan_fy)
if pan_ix != 0 || pan_iy != 0 then
  pan_fx -= float(pan_ix)
  pan_fy -= float(pan_iy)
  set ox += pan_ix
  set oy += pan_iy
  pans += 1
end
let key_held = key_down("left") || key_down("right") || key_down("up") || key_down("down")

if key_pressed("=") || key_pressed("+") then
  zoom_at(CW / 2, CH / 2, 1.6)
  zooms += 1
end
if key_pressed("-") then
  zoom_at(CW / 2, CH / 2, 1.0 / 1.6)
  zooms += 1
end
if key_pressed("r") || key_pressed("home") then
  set pv_n = 0
  home_view(kind)
end

// Iterations: [ and ] step the manual ladder, A hands it back to the zoom.
let iter_down = key_pressed("[") || (pressed && point_in(px: mx, py: my, r: iter_minus))
let iter_up = key_pressed("]") || (pressed && point_in(px: mx, py: my, r: iter_plus))
if iter_down || iter_up then
  let target = maxit
  if iter_up then
    for v in reverse(ITER_STEPS) do
      if v > maxit then target = v end
    end
  else
    for v in ITER_STEPS do
      if v < maxit then target = v end
    end
  end
  set auto_iter = false
  set_maxit(target)
end
if key_pressed("a") || (pressed && point_in(px: mx, py: my, r: iter_auto)) then
  set auto_iter = !auto_iter
  if auto_iter then set_maxit(auto_maxit(scale, kind)) end
end

// Colour: none of these touch a sample.
if key_pressed("p") then
  pal = (pal + (if shift then len(PALS) - 1 else 1 end)) % len(PALS)
end
if key_pressed(",") || (pressed && point_in(px: mx, py: my, r: band_minus)) then
  band_i = max(band_i - 1, 0)
end
if key_pressed(".") || (pressed && point_in(px: mx, py: my, r: band_plus)) then
  band_i = min(band_i + 1, len(BANDS) - 1)
end
if key_pressed("c") || (pressed && point_in(px: mx, py: my, r: cycle_chip)) then cycling = !cycling end
if key_pressed("d") then detail_i = (detail_i + 1) % len(DETAILS) end
if key_pressed("t") || (pressed && point_in(px: mx, py: my, r: tiles_chip)) then show_tiles = !show_tiles end
if key_pressed("tab") then
  let here = at_place(kind)
  go_place(if here < 0 then 0 else (here + (if shift then len(places) - 1 else 1 end)) % len(places) end)
end

if pressed && point_in(px: mx, py: my, r: side) then
  for i in range(0, len(KINDS)) do
    if point_in(px: mx, py: my, r: kind_chip(i)) then switch_kind(i) end
  end
  for i in range(0, len(PALS)) do
    if point_in(px: mx, py: my, r: pal_chip(i)) then pal = i end
  end
  for i in range(0, len(DETAILS)) do
    if point_in(px: mx, py: my, r: detail_chip(i)) then detail_i = i end
  end
  for i in range(0, len(PLACES[kind])) do
    if point_in(px: mx, py: my, r: place_row(i)) then go_place(i) end
  end
  if point_in(px: mx, py: my, r: map_r) then map_drag = true end
end
if !mouse_down(0) && !pressed then map_drag = false end

// The locator map: drag to move the view, or in a Julia set, the seed.
if map_drag then
  let wx = mg.wx0 + float(clamp(mx - map_r.x, lo: 0, hi: map_r.w)) * mg.ms
  let wy = mg.wy0 + float(clamp(my - map_r.y, lo: 0, hi: map_r.h)) * mg.ms
  if kind == K_JULIA then
    pend_j = true
    pend_jr = wx
    pend_ji = wy * KINDS[K_MANDEL].ys
  else
    let nx = int(round(wx / scale)) - CW / 2
    let ny = int(round(wy / scale)) - CH / 2
    if nx != ox || ny != oy then pans += 1 end
    set ox = nx
    set oy = ny
  end
end

// Canvas: wheel zooms about the pointer, drag pans, double click dives.
if in_cv && scroll_y() != 0.0 then
  zoom_at(cmx, cmy, pow(wheel_gain, -scroll_y()))
  zooms += 1
end
if pressed && in_cv then
  if click_count() >= 2 then
    zoom_at(cmx, cmy, if shift then 0.5 else 2.0 end)
    zooms += 1
  else
    dragging = true
    drag_mx = mx
    drag_my = my
    drag_ox = ox
    drag_oy = oy
  end
end
if dragging then
  let nx = drag_ox - (mx - drag_mx)
  let ny = drag_oy - (my - drag_my)
  if nx != ox || ny != oy then pans += 1 end
  set ox = nx
  set oy = ny
  if !mouse_down(0) && !pressed then dragging = false end
end

// Right click (or J): the Julia set of the point under the pointer, and
// from a Julia set, back to the Mandelbrot set centred on its seed.
if (mouse_pressed(1) && in_cv) || key_pressed("j") then
  if kind == K_MANDEL then
    let re = float(ox + (if in_cv then cmx else CW / 2 end)) * scale
    let im = -float(oy + (if in_cv then cmy else CH / 2 end)) * scale
    set jr = re
    set ji = im
    set views[K_JULIA] = nil
    switch_kind(K_JULIA)
  elsif kind == K_JULIA then
    switch_kind(K_MANDEL)
  end
end

// A dragged seed is applied only once the last one has a full coarse pass,
// so the Julia set morphs as fast as it can be drawn and never goes blank.
if pend_j && (st_blank == 0 || pv_n == 0) then
  pend_j = false
  if kind == K_JULIA && (pend_jr != jr || pend_ji != ji) then set_seed(pend_jr, pend_ji) end
end

// ── Refine ───────────────────────────────────────────────────────────────

let cap = DETAILS[detail_i].lod
let dens = BANDS[band_i]
let fit_key = band_i * 8
let tx0 = fdiv(ox, TPX)
let ty0 = fdiv(oy, TPX)
let tx1 = fdiv(ox + CW - 1, TPX)
let ty1 = fdiv(oy + CH - 1, TPX)
if q_key != [tx0, ty0, epoch, cap] then
  q_key = [tx0, ty0, epoch, cap]
  build_queue(if in_cv then cmx else CW / 2 end, if in_cv then cmy else CH / 2 end)
end
// The budget is a rate times dt(), capped at one 60 Hz frame's worth, so a
// slow frame cannot ask for a slower one, and a frame that took no time (an
// injected event under a test's virtual clock) does no work at all: only
// POST /tick moves the render forward, by the same amount every run.
let interactive = busy_input || key_held || dragging || map_drag
let budget = int(iter_rate * min(dt(), 1.0 / 60.0) * (if interactive then 1.0 else idle_boost end))
let spent = work(budget, cap, dens, fit_key)

// ── Draw: the canvas ─────────────────────────────────────────────────────

clear(C_BG.r, C_BG.g, C_BG.b)
draw_rect_rounded(cv, radius: 12, c: C_STAGE)
clip_push(cv, 12)

if cycling then cycle_off = fract(cycle_off + dt() * cycle_speed) end
let LR = lut.r
let LG = lut.g
let LB = lut.b
let pbase = pal * LN
let segs_drawn = 0

// Sort the visible tiles. A tile at least as sharp as the preview is drawn
// over it. A coarser one is left out where the preview covers it, and drawn
// under the preview where it only partly does (the rim of a zoom out).
let pr = if pv_n > 0 then pv_scale / scale else 1.0 end
let pv_dx = float(pv_ox) * pr - float(ox)     // preview origin in canvas px
let pv_dy = float(pv_oy) * pr - float(oy)
let pv_eff = pv_cell * pr                     // its sample size on screen now
let n_tiles = 0
let n_blank = 0
let n_done = 0
let maxcell = 0.0
let have_samples = 0
let want_samples = 0
let n_capped = 0
let lod_hist = [0, 0, 0, 0, 0]
let refits = 0
let under = []
let over = []
for ty in range(ty0, ty1 + 1) do
  for tx_i in range(tx0, tx1 + 1) do
    let s = slot_of(tx_i, ty)
    let lod = t_lod[s]
    n_tiles += 1
    lod_hist[lod] = lod_hist[lod] + 1
    if lod == 0 then
      n_blank += 1
      want_samples += LOD_SAMPLES[cap]
      continue
    end
    let goal = min(cap, t_cap[s])
    if goal < cap then n_capped += 1 end
    if lod >= goal then n_done += 1 end
    have_samples += LOD_SAMPLES[min(lod, goal)]
    want_samples += LOD_SAMPLES[goal]
    let uni = t_uni[s] == 1
    let cell_px = if uni then float(CELL) else float(STEPS[lod] * CELL) end
    maxcell = max(maxcell, cell_px)
    let bx = tx_i * TPX - ox
    let by = ty * TPX - oy
    let coarse = pv_n > 0 && lod < goal && cell_px > pv_eff + 0.01
    if coarse then
      let covered = float(bx) >= pv_dx && float(by) >= pv_dy &&
        float(bx + TPX) <= pv_dx + float(CW) * pr && float(by + TPX) <= pv_dy + float(CH) * pr
      if covered then continue end
    end
    // A draw list fitted for another band density or level is refitted, a
    // few tiles a frame.
    let want = fit_key + min(lod, cap)
    if !uni && t_fit[s] != want && refits < 24 then
      fit_tile(s, min(lod, cap), dens)
      set t_fit[s] = want
      refits += 1
    end
    let item = {s: s, x: cv.x + bx, y: cv.y + by}
    if coarse then under = append(under, item) else over = append(over, item) end
  end
end

for t in under do
  segs_drawn += draw_tile(t.s, t.x, t.y, pbase, dens, cycle_off, LR, LG, LB)
end

// The preview, scaled into the current view.
if pv_n > 0 then
  segs_drawn += draw_preview(cv.x, cv.y, pr, pv_dx, pv_dy, pbase, dens, cycle_off, LR, LG, LB)
end

for t in over do
  segs_drawn += draw_tile(t.s, t.x, t.y, pbase, dens, cycle_off, LR, LG, LB)
end
let n_shown = len(under) + len(over)
set st_blank = n_blank
set st_maxcell = maxcell
let complete = n_done == n_tiles
if complete && pv_n > 0 then set pv_n = 0 end
let progress = float(have_samples) / float(max(want_samples, 1))

// Tile overlay: the cache made visible. One outline per tile, tinted by level.
if show_tiles then
  let LOD_COL = [C_MUTE, #ff6b6b, #ffb454, #ffe27a, #7ff0b0]
  for ty in range(ty0, ty1 + 1) do
    for tx_i in range(tx0, tx1 + 1) do
      let s = slot_of(tx_i, ty)
      let c = LOD_COL[t_lod[s]]
      let r = rect(cv.x + tx_i * TPX - ox, cv.y + ty * TPX - oy, TPX, TPX)
      draw_rect_outline(r, c, 70, 1)
      draw_rect(r.x + 4, r.y + 4, 5, 5, c.r, c.g, c.b, 220)
      if s == job_s then draw_rect_outline(r.inset(1), C_TEXT, 220, 2) end
    end
  end
end

// What is under the pointer: its coordinates and its cached sample.
let cur_re = float(ox + cmx) * scale
let cur_im = float(oy + cmy) * scale * KINDS[kind].ys
let cur_mu = -2.0                    // -2 = not sampled yet, -1 = inside
if in_cv then
  let s = slot_of(fdiv(ox + cmx, TPX), fdiv(oy + cmy, TPX))
  let lod = t_lod[s]
  if lod > 0 then
    let st = STEPS[lod]
    let lx = pmod(ox + cmx, TPX) / CELL / st * st
    let ly = pmod(oy + cmy, TPX) / CELL / st * st
    let v = if t_uni[s] == 1 then -1.0 else vals[s * TN + ly * TS + lx] end
    cur_mu = if v < 0.0 then -1.0 else mu_of(v) end
  end
end

let mag = KINDS[kind].span / float(CW) / scale
let places_n = clamp(int(log(max(mag, 1.0)) / log(10.0)) + 4, lo: 4, hi: 16)
let ctr_re = float(ox + CW / 2) * scale
let ctr_im = float(oy + CH / 2) * scale * KINDS[kind].ys

fn hud_pill(r: Rect) -> nil
  draw_rect_rounded(r, radius: 9, c: C_BG, a: 214)
  draw_rect_rounded_outline(r, radius: 9, c: C_EDGE, a: 200, width: 1)
end

// Top left: which fractal, and its rule.
let name_s = upper(KINDS[kind].name)
let rule_s = if kind == K_JULIA then "c = {fmt_complex(jr, ji, 4)}" else KINDS[kind].formula end
let name_w = text_width(name_s, S_LABEL)
let head_pill = rect(cv.x + 14, cv.y + 14, name_w + text_width(rule_s, S_MONO_D) + 44, 28)
hud_pill(head_pill)
tx(name_s, x: head_pill.x + 14, y: head_pill.y + 8, style: {...S_LABEL, color: C_ACCENT})
tx(rule_s, x: head_pill.x + 14 + name_w + 14, y: head_pill.y + 6, style: S_MONO_D)

// Bottom left: the pointer.
if in_cv && !dragging then
  let pos_s = fmt_complex(cur_re, cur_im, places_n)
  let what_s = if cur_mu == -2.0 then "not sampled yet"
  elsif cur_mu < 0.0 then "bounded after {maxit} iterations"
  else "escapes after {fixed(cur_mu, 1)} iterations"
  end
  let pw = max(text_width(pos_s, S_MONO), text_width(what_s, S_HINT)) + 28
  let pill = rect(cv.x + 14, cv.y + CH - 60, pw, 46)
  hud_pill(pill)
  tx(pos_s, x: pill.x + 14, y: pill.y + 7, style: S_MONO)
  tx(what_s, x: pill.x + 14, y: pill.y + 25, style: {...S_HINT, color: if cur_mu < 0.0 then C_DIM else C_ACCENT end})
  // A fine crosshair, so the readout has an exact subject.
  draw_rect(mx - 9, my, 6, 1, 255, 255, 255, 170)
  draw_rect(mx + 4, my, 6, 1, 255, 255, 255, 170)
  draw_rect(mx, my - 9, 1, 6, 255, 255, 255, 170)
  draw_rect(mx, my + 4, 1, 6, 255, 255, 255, 170)
end

// Bottom right: what the renderer is doing.
let cap_px = STEPS[cap] * CELL
let status_s = if complete && n_capped > 0 then "DONE - {n_capped} BUSY TILES AT 4 PX"
elsif complete then "SHARP AT {cap_px} PX"
elsif n_blank > 0 then "SKETCHING 16 PX"
else "REFINING TO {STEPS[min(pass_lod, cap)] * CELL} PX"
end
let pct_s = "{int(progress * 100.0)}%"
let sw = text_width(status_s, S_LABEL) + (if complete then 0 else text_width(pct_s, S_MONO) + 12 end) + 40
let stat_pill = rect(cv.x + CW - 14 - sw, cv.y + CH - 42, sw, 28)
hud_pill(stat_pill)
draw_circle({x: stat_pill.x + 14, y: stat_pill.y + 14}, 3, if complete then #7ff0b0 else C_ACCENT end, 255)
tx(status_s, x: stat_pill.x + 26, y: stat_pill.y + 8, style: {...S_LABEL, color: C_TEXT})
if !complete then
  tx_right(pct_s, right_x: stat_pill.x + sw - 14, y: stat_pill.y + 6, style: {...S_MONO, color: C_ACCENT})
  draw_rect(cv.x, cv.y + CH - 3, CW, 3, 0, 0, 0, 120)
  draw_rect(cv.x, cv.y + CH - 3, int(float(CW) * progress), 3, C_ACCENT.r, C_ACCENT.g, C_ACCENT.b)
end

if scale <= MIN_SCALE * 4.0 then
  let warn = "64-BIT FLOATS END HERE"
  let ww = text_width(warn, S_LABEL) + 28
  let wp = rect(cv.x + CW - 14 - ww, cv.y + 14, ww, 28)
  hud_pill(wp)
  tx(warn, x: wp.x + 14, y: wp.y + 8, style: {...S_LABEL, color: #ff8a6b})
end

clip_pop()
draw_rect_rounded_outline(cv, radius: 12, c: C_EDGE, a: 255, width: 1)

// ── Draw: header ─────────────────────────────────────────────────────────

tx("FRACTAL EXPLORER", x: PAD, y: 16, style: S_TITLE)
tx("PETAL / GARDEN TESTBED 48", x: PAD + 2, y: 52, style: S_KICK)

let cell3 = W - PAD
let cell2 = cell3 - 150
let cell1 = cell2 - 150
let cell0 = cell1 - 130
tx_right("ZOOM", right_x: cell0, y: 18, style: S_LABEL)
tx_right(fmt_mag(mag), right_x: cell0, y: 34, style: {...S_STAT, color: C_ACCENT})
tx_right("ITERATIONS", right_x: cell1, y: 18, style: S_LABEL)
tx_right(fmt_int(maxit), right_x: cell1, y: 34, style: S_STAT)
tx_right("SAMPLES", right_x: cell2, y: 18, style: S_LABEL)
tx_right(fmt_int(have_samples), right_x: cell2, y: 34, style: S_STAT)
tx_right("DRAW CALLS", right_x: cell3, y: 18, style: S_LABEL)
tx_right(fmt_int(segs_drawn), right_x: cell3, y: 34, style: S_STAT)

// ── Draw: sidebar ────────────────────────────────────────────────────────

draw_rect_rounded(side, radius: 12, c: C_PANEL)
draw_rect_rounded_outline(side, radius: 12, c: C_EDGE, a: 255, width: 1)

fn key_cap(label: string, right_x: num, y: num, lit: bool) -> nil
  let w = max(text_width(label, S_KEY) + 10, 18)
  let box = rect(right_x - w, y, w, 16)
  draw_rect_rounded(box, radius: 4, c: if lit then C_EDGE else C_LINE end)
  tx_center(label, cx: box.x + box.w / 2, y: y + 1, style: if lit then {...S_KEY, color: C_TEXT} else S_KEY end)
end

fn section(label: string, y: num, note: string) -> nil
  tx(label, x: SX, y: y, style: S_LABEL)
  if note != "" then tx_right(note, right_x: SX + SWI, y: y, style: {...S_LABEL, color: C_MUTE}) end
end

// A chip that is either the selected one of a set, or a plain button.
fn chip(r: Rect, label: string, on: bool, mx: int, my: int) -> nil
  let hov = point_in(px: mx, py: my, r: r)
  draw_rect_rounded(r, radius: 7, c: if on then mix(C_CHIP, C_ACCENT, 0.16) elsif hov then C_EDGE else C_CHIP end)
  if on then draw_rect_rounded_outline(r, radius: 7, c: C_ACCENT, a: 150, width: 1) end
  tx_center(label, cx: r.x + r.w / 2, y: r.y + 6, style: if on then {...S_UI, color: C_ACCENT} elsif hov then S_UI else S_UI_M end)
end

fn toggle_chip(r: Rect, label: string, on: bool, mx: int, my: int) -> nil
  let hov = point_in(px: mx, py: my, r: r)
  draw_rect_rounded(r, radius: 7, c: if hov then C_EDGE else C_CHIP end)
  if on then draw_rect_rounded_outline(r, radius: 7, c: C_ACCENT, a: 130, width: 1) end
  draw_circle({x: r.x + 13, y: r.y + r.h / 2}, 3, if on then C_ACCENT else C_MUTE end, 255)
  tx(label, x: r.x + 23, y: r.y + 6, style: if on then S_UI else S_UI_M end)
end

fn stepper(minus: Rect, plus: Rect, value: string, mx: int, my: int) -> nil
  chip(minus, "-", false, mx, my)
  chip(plus, "+", false, mx, my)
  tx_center(value, cx: (minus.x + minus.w + plus.x) / 2, y: minus.y + 7, style: S_MONO)
end

// Fractal.
section("FRACTAL", y_kind, "1 - 4")
for i in range(0, len(KINDS)) do
  chip(kind_chip(i), KINDS[i].name, kind == i, mx, my)
end

// Locator map.
section(if kind == K_JULIA then "SEED" else "LOCATOR" end, y_map,
  if kind == K_JULIA then "DRAG TO MORPH" else "DRAG TO MOVE" end)
draw_rect_rounded(map_r, radius: 8, c: C_BG)
clip_push(map_r, 8)
let MAP_RAMP = for q in range(0, 14) do
  if q == 13 then #05060a else mix(C_PANEL, #5f7fb8, pow(float(q) / 12.0, 1.3)) end
end
for i in range(0, mm.n) do
  let c = MAP_RAMP[mm.c[i]]
  draw_rect(map_r.x + mm.x[i], map_r.y + mm.y[i], mm.w[i], MM_CELL, c.r, c.g, c.b)
end
if kind == K_JULIA then
  let p = {x: map_r.x + int((jr - mg.wx0) / mg.ms), y: map_r.y + int((ji * KINDS[K_MANDEL].ys - mg.wy0) / mg.ms)}
  draw_rect(p.x - 12, p.y, 25, 1, C_ACCENT.r, C_ACCENT.g, C_ACCENT.b, 150)
  draw_rect(p.x, p.y - 12, 1, 25, C_ACCENT.r, C_ACCENT.g, C_ACCENT.b, 150)
  draw_circle_outline(p, 5, C_ACCENT, 255, 1)
  draw_circle(p, 2, C_TEXT, 255)
else
  // The viewport, or a marker once it is too small to draw as a rect.
  let vx = float(map_r.x) + (float(ox) * scale - mg.wx0) / mg.ms
  let vy = float(map_r.y) + (float(oy) * scale - mg.wy0) / mg.ms
  let vw = float(CW) * scale / mg.ms
  let vh = float(CH) * scale / mg.ms
  if vw >= 8.0 then
    // Clamped to the map, so a view wider than the map still reads as a frame.
    let x0 = max(int(vx), map_r.x + 2)
    let y0 = max(int(vy), map_r.y + 2)
    let x1 = min(int(vx + vw), map_r.x + map_r.w - 2)
    let y1 = min(int(vy + vh), map_r.y + map_r.h - 2)
    if x1 > x0 && y1 > y0 then
      let vr = rect(x0, y0, x1 - x0, y1 - y0)
      if vw < float(map_r.w) * 0.7 then draw_rect(vr, C_ACCENT, 26) end
      draw_rect_rounded_outline(vr, radius: 3, c: C_ACCENT, a: 255, width: 1)
    end
  else
    let p = {x: int(vx + vw / 2.0), y: int(vy + vh / 2.0)}
    draw_circle_outline(p, 7, C_ACCENT, 255, 1)
    draw_circle(p, 2, C_ACCENT, 255)
  end
end
clip_pop()
draw_rect_rounded_outline(map_r, radius: 8, c: if map_drag then C_ACCENT else C_EDGE end, a: 255, width: 1)

// Iterations.
section("ITERATIONS", y_iter, "[ ]")
stepper(iter_minus, iter_plus, fmt_int(maxit), mx, my)
toggle_chip(iter_auto, "Auto", auto_iter, mx, my)

// Palette: a strip of each, drawn through the same table the image uses.
section("PALETTE", y_pal, upper(PALS[pal].name))
for i in range(0, len(PALS)) do
  let r = pal_chip(i)
  let on = pal == i
  clip_push(r, 6)
  for q in range(0, 8) do
    let ia = i * LN + q * (LN / 8)
    let ib = i * LN + ((q + 1) * (LN / 8)) % LN
    let x0 = r.x + q * r.w / 8
    let x1 = r.x + (q + 1) * r.w / 8
    draw_rect_gradient(x0, r.y, x1 - x0, r.h, LR[ia], LG[ia], LB[ia], 255, LR[ib], LG[ib], LB[ib], 255, 0.0)
  end
  clip_pop()
  if on then
    draw_rect_rounded_outline(r.inset(-2), radius: 8, c: C_TEXT, a: 255, width: 2)
  elsif point_in(px: mx, py: my, r: r) then
    draw_rect_rounded_outline(r.inset(-1), radius: 7, c: C_DIM, a: 255, width: 1)
  end
end
stepper(band_minus, band_plus, "{fixed(dens, 2)} bands", mx, my)
toggle_chip(cycle_chip, "Cycle", cycling, mx, my)

// Detail.
section("DETAIL", y_detail, "D")
for i in range(0, len(DETAILS)) do
  chip(detail_chip(i), DETAILS[i].name, detail_i == i, mx, my)
end
toggle_chip(tiles_chip, "Tiles", show_tiles, mx, my)

// Places.
let place_now = at_place(kind)
section(if kind == K_JULIA then "SEEDS" else "PLACES" end, y_place, "TAB")
for i in range(0, len(places)) do
  let r = place_row(i)
  let p = places[i]
  let hov = point_in(px: mx, py: my, r: r)
  let on = place_now == i
  if hov then draw_rect_rounded(r, radius: 6, c: C_CHIP) end
  draw_circle({x: r.x + 14, y: r.y + r.h / 2}, 2, if on then C_ACCENT else C_MUTE end, 255)
  tx(p.name, x: r.x + 26, y: r.y + 4, style: if on then S_UI elsif hov then S_UI else S_UI_M end)
  let note = if kind == K_JULIA then fmt_complex(p.x, p.y, 3) else fmt_mag(KINDS[kind].span / p.span) end
  tx_right(note, right_x: r.x + r.w - 10, y: r.y + 6, style: {...S_KEY, color: if on then C_DIM else C_MUTE end})
end

// ── Draw: footer ─────────────────────────────────────────────────────────

fn hint_chip(x: num, y: num, cap_s: string, desc: string) -> int
  let cw2 = text_width(cap_s, S_CAP) + 18
  let box = rect(int(x), int(y), cw2, 24)
  draw_rect_rounded(box, radius: 7, c: C_CHIP)
  draw_rect_rounded_outline(box, radius: 7, c: C_LINE, a: 255, width: 1)
  tx(cap_s, x: x + 9, y: y + 5, style: S_CAP)
  tx(desc, x: x + cw2 + 8, y: y + 5, style: S_HINT)
  cw2 + 8 + text_width(desc, S_HINT) + 16
end

let fy = cv.y + CH + 16
let fx = PAD
fx += hint_chip(x: fx, y: fy, cap_s: "SCROLL", desc: "zoom")
fx += hint_chip(x: fx, y: fy, cap_s: "DRAG", desc: "pan")
fx += hint_chip(x: fx, y: fy, cap_s: "2x CLICK", desc: "dive")
fx += hint_chip(x: fx, y: fy, cap_s: "RIGHT / J", desc: "julia")
fx += hint_chip(x: fx, y: fy, cap_s: "ARROWS", desc: "pan")
fx += hint_chip(x: fx, y: fy, cap_s: "- / +", desc: "zoom")
fx += hint_chip(x: fx, y: fy, cap_s: "P", desc: "palette")
fx += hint_chip(x: fx, y: fy, cap_s: ", / .", desc: "bands")
fx += hint_chip(x: fx, y: fy, cap_s: "C", desc: "cycle")
fx += hint_chip(x: fx, y: fy, cap_s: "R", desc: "reset")

// The centre of the view, to as many places as the zoom makes meaningful.
let ctr_re_s = fixed(ctr_re, places_n)
let ctr_im_s = fixed(ctr_im, places_n)
let ctr_w = max(text_width(ctr_re_s, S_MONO), text_width(ctr_im_s, S_MONO))
tx_right(ctr_re_s, right_x: W - PAD, y: fy - 3, style: S_MONO)
tx_right(ctr_im_s, right_x: W - PAD, y: fy + 13, style: S_MONO)
tx_right("RE", right_x: W - PAD - ctr_w - 10, y: fy - 1, style: S_LABEL)
tx_right("IM", right_x: W - PAD - ctr_w - 10, y: fy + 15, style: S_LABEL)

if !complete || cycling || pend_j || key_held then request_frame() end

// ── Observation mirrors (readable in /state -> panel.values) ─────────────

let obs_kind = KINDS[kind].name
let obs_scale = scale
let obs_zoom = round(mag, 3)
let obs_origin = [ox, oy]
let obs_center = [ctr_re, ctr_im]
let obs_cursor = [cur_re, cur_im]
let obs_cursor_mu = round(cur_mu, 2)
let obs_maxit = maxit
let obs_auto_iter = auto_iter
let obs_seed = [jr, ji]
let obs_palette = PALS[pal].name
let obs_bands = dens
let obs_cycling = cycling
let obs_cycle_off = round(cycle_off, 3)
let obs_detail = DETAILS[detail_i].name
let obs_epoch = epoch
let obs_tiles = n_tiles
let obs_tiles_blank = n_blank
let obs_tiles_done = n_done
let obs_tiles_capped = n_capped
let obs_tiles_shown = n_shown
let obs_lod_hist = lod_hist
let obs_complete = complete
let obs_progress = round(progress, 3)
let obs_samples = have_samples
let obs_samples_total = samples_done
let obs_iters_frame = spent
let obs_iters_total = iters_done
let obs_budget = budget
let obs_segs = segs_drawn
let obs_preview = pv_n
let obs_pass = pass_lod
let obs_place = if place_now < 0 then "" else places[place_now].name end
let obs_zooms = zooms
let obs_pans = pans
let obs_dragging = dragging
let obs_show_tiles = show_tiles
let obs_canvas = [cv.x, cv.y, CW, CH]
let obs_map = [map_r.x, map_r.y, map_r.w, map_r.h]
let obs_status = status_s
