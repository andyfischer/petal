// petal-ui prelude — module `ui`
//
// Standard interaction primitives over the Layer-0 input natives and the
// Layer-2 draw natives. Registered by embedders as an implicit import, so
// scripts call these bare; `import ui` / `import ui: button` also work.
// Only declarations marked `export` are visible to importers; everything else
// (and any name starting with `_`) is module-private.
//
// Rects are records: {x, y, w, h}. Colors are records: {r, g, b} (hex
// literals like #3c8cff work). Button 0 is the left mouse button.

// ── Geometry + hit testing ────────────────────────────────────────────────

// A rect is a `Rect` — the built-in class (fields x, y, w, h). It is still an
// ordinary record, so every `{x, y, w, h}` written by hand keeps working
// everywhere a rect is taken; going through the class is what earns the
// geometry methods (`r.center_x()`, `r.inset(4)`, `r.right()` …) and makes
// `type(r)` say "Rect". See docs/language-guide.md (Classes & Methods).
//
// Coordinates are kept exactly as passed — `rect(10.5, …)` is a sub-pixel rect,
// not a truncated one — so animated and fractional layout stays smooth. The
// draw natives are where a coordinate becomes a whole pixel.
//
// `rect` *is* the constructor rather than a function wrapping it, so a bad
// argument is reported at the caller's own `rect(...)` — a wrapper would put
// the caret on this file's line and leave the app author reading the prelude.
export let rect = Rect

export fn point_in(px, py, r)
  px >= r.x && px < r.x + r.w && py >= r.y && py < r.y + r.h
end

export fn hovered(r)
  point_in(mouse_x(), mouse_y(), r)
end

export fn clicked(r)
  hovered(r) && mouse_pressed(0)
end

fn _clamp(v, lo, hi)
  max(lo, min(v, hi))
end

// ── Timing ────────────────────────────────────────────────────────────────
// `time()` is an absolute clock in seconds, published by the host each frame
// (monotonic, read fresh — never a running sum of `dt()`, so it does not
// drift). `elapsed()` reports the seconds since it was first called: it
// captures the clock once into `state` and subtracts. The captured `start` is
// a single module state slot, so `elapsed()` is one global timer measured from
// the app's first `elapsed()` call — for independent timers, capture your own
// `state t0 = time()` at the call site and subtract `time() - t0`.
export fn elapsed()
  state start = time()
  time() - start
end

// ── Record overloads over the flat draw natives ───────────────────────────
// The flat-int arities delegate to the captured natives, so scripts that use
// the classic signatures keep working when these shadow the builtins.

let _native_image = draw_image
let _native_rect = draw_rect
let _native_rect_rounded = draw_rect_rounded
let _native_rect_outline = draw_rect_outline
let _native_line = draw_line
let _native_circle = draw_circle
let _native_text = draw_text

// Every primitive takes an optional trailing alpha (0–255, 255 = opaque).
// Lines and outlines also take an optional trailing stroke `width`. Rounded
// rects add a `radius`. Each forwards to the native, which fills defaults.

export fn draw_image(source, x, y, w, h)
  _native_image(source, x, y, w, h)
end
export fn draw_image(source, x, y, w, h, a)
  _native_image(source, x, y, w, h, a)
end
export fn draw_image(source, r)
  _native_image(source, r.x, r.y, r.w, r.h)
end
export fn draw_image(source, r, a)
  _native_image(source, r.x, r.y, r.w, r.h, a)
end

export fn draw_rect(x, y, w, h, r, g, b)
  _native_rect(x, y, w, h, r, g, b)
end
export fn draw_rect(x, y, w, h, r, g, b, a)
  _native_rect(x, y, w, h, r, g, b, a)
end
export fn draw_rect(r, c)
  _native_rect(r.x, r.y, r.w, r.h, c.r, c.g, c.b)
end
export fn draw_rect(r, c, a)
  _native_rect(r.x, r.y, r.w, r.h, c.r, c.g, c.b, a)
end

export fn draw_rect_rounded(x, y, w, h, radius, r, g, b)
  _native_rect_rounded(x, y, w, h, radius, r, g, b)
end
export fn draw_rect_rounded(x, y, w, h, radius, r, g, b, a)
  _native_rect_rounded(x, y, w, h, radius, r, g, b, a)
end
export fn draw_rect_rounded(rect, radius, c)
  _native_rect_rounded(rect.x, rect.y, rect.w, rect.h, radius, c.r, c.g, c.b)
end
export fn draw_rect_rounded(rect, radius, c, a)
  _native_rect_rounded(rect.x, rect.y, rect.w, rect.h, radius, c.r, c.g, c.b, a)
end

export fn draw_rect_outline(x, y, w, h, r, g, b)
  _native_rect_outline(x, y, w, h, r, g, b)
end
export fn draw_rect_outline(x, y, w, h, r, g, b, a)
  _native_rect_outline(x, y, w, h, r, g, b, a)
end
export fn draw_rect_outline(x, y, w, h, r, g, b, a, width)
  _native_rect_outline(x, y, w, h, r, g, b, a, width)
end
export fn draw_rect_outline(r, c)
  _native_rect_outline(r.x, r.y, r.w, r.h, c.r, c.g, c.b)
end
export fn draw_rect_outline(r, c, a)
  _native_rect_outline(r.x, r.y, r.w, r.h, c.r, c.g, c.b, a)
end
export fn draw_rect_outline(r, c, a, width)
  _native_rect_outline(r.x, r.y, r.w, r.h, c.r, c.g, c.b, a, width)
end

export fn draw_line(x1, y1, x2, y2, r, g, b)
  _native_line(x1, y1, x2, y2, r, g, b)
end
export fn draw_line(x1, y1, x2, y2, r, g, b, a)
  _native_line(x1, y1, x2, y2, r, g, b, a)
end
export fn draw_line(x1, y1, x2, y2, r, g, b, a, width)
  _native_line(x1, y1, x2, y2, r, g, b, a, width)
end
export fn draw_line(a, b, c)
  _native_line(a.x, a.y, b.x, b.y, c.r, c.g, c.b)
end

export fn draw_circle(cx, cy, radius, r, g, b)
  _native_circle(cx, cy, radius, r, g, b)
end
export fn draw_circle(cx, cy, radius, r, g, b, a)
  _native_circle(cx, cy, radius, r, g, b, a)
end
export fn draw_circle(center, radius, c)
  _native_circle(center.x, center.y, radius, c.r, c.g, c.b)
end
export fn draw_circle(center, radius, c, a)
  _native_circle(center.x, center.y, radius, c.r, c.g, c.b, a)
end

export fn draw_text(text, x, y, size, r, g, b)
  _native_text(text, x, y, size, r, g, b)
end
export fn draw_text(text, x, y, size, r, g, b, a)
  _native_text(text, x, y, size, r, g, b, a)
end
export fn draw_text(text, pos, size, c)
  _native_text(text, pos.x, pos.y, size, c.r, c.g, c.b)
end
export fn draw_text(text, pos, size, c, a)
  _native_text(text, pos.x, pos.y, size, c.r, c.g, c.b, a)
end
// Styled: a record of any subset of {size, color, font, weight, italic,
// spacing}. Omitted fields mean plain text — the host's own font, upright,
// regular — so a style is a diff against what draw_text always did. Measure
// the same record with text_width(s, style) and the two agree.
//   draw_text("#482", {x: 60, y: 20}, {size: 15, color: FG, weight: 700})
export fn draw_text(text, pos, style)
  _native_text(text, pos.x, pos.y, style)
end

// ── Text helpers ──────────────────────────────────────────────────────────

// Keep the tail of `s` (rightmost chars, e.g. a file path), "…"-prefixed
// when clipped to `max_chars`.
export fn truncate_tail(s, max_chars)
  if len(s) <= max_chars then
    s
  else
    "…" ++ slice(s, len(s) - max_chars + 1, len(s))
  end
end

// Keep the head of `s`, "…"-suffixed when clipped to `max_chars`.
export fn truncate_head(s, max_chars)
  if len(s) <= max_chars then
    s
  else
    slice(s, 0, max_chars - 1) ++ "…"
  end
end

fn _wrap_segment(seg, max_chars)
  let lines = []
  let cur = ""
  for word in split(seg, " ") do
    let w = word
    // A token that can never fit gets its own hard-broken lines.
    while len(w) > max_chars do
      if len(cur) > 0 then
        lines = append(lines, cur)
        cur = ""
      end
      let take = max_chars
      let piece = slice(w, 0, take)
      while len(piece) == 0 do
        // max_chars landed inside w's first char and boundary snapping
        // emptied the slice: widen until the char fits.
        take = take + 1
        piece = slice(w, 0, take)
      end
      lines = append(lines, piece)
      w = slice(w, len(piece), len(w))
    end
    if len(cur) == 0 then
      cur = w
    elsif len(cur) + 1 + len(w) <= max_chars then
      cur = cur ++ " " ++ w
    else
      lines = append(lines, cur)
      cur = w
    end
  end
  // Flush the line under construction; skip a leftover "" (the tail of a
  // fully hard-broken final word) unless it is the segment's only line.
  if len(cur) > 0 || len(lines) == 0 then
    lines = append(lines, cur)
  end
  lines
end

// Greedy word wrap: split `s` into a list of lines at most `max_chars` wide.
// Explicit "\n"s split first (each segment wraps independently), words break
// on single spaces, and a token longer than max_chars is hard-broken into
// max_chars-sized pieces. Widths are bytes, like the truncate_* helpers;
// slice snaps to UTF-8 char boundaries, so multibyte input never panics
// (its lines may just run a little short). max_chars <= 0 returns [s].
export fn wrap(s, max_chars)
  if max_chars <= 0 then
    [s]
  else
    let lines = []
    for seg in split(s, "\n") do
      for line in _wrap_segment(seg, max_chars) do
        lines = append(lines, line)
      end
    end
    lines
  end
end

// Bounded-cost N-line preview: wrap `text` into at most `max_lines` lines of
// `max_chars`, ending the last kept line with an explicit "…" when content was
// clipped. The wrap input is pre-clipped to (max_lines+1)*max_chars bytes first,
// so a huge string costs no more than a short one to preview (slice snaps to
// UTF-8 char boundaries, so multibyte text never breaks). Widths are bytes, like
// wrap / truncate_*. Returns {lines: [..], truncated: bool} — `truncated` is
// true when the last kept line carries the "…" (content was dropped).
export fn preview(text, max_chars, max_lines)
  let t = text
  let over = false
  if len(t) > max_chars * (max_lines + 1) then
    t = slice(t, 0, max_chars * (max_lines + 1))
    over = true
  end
  let ls = wrap(t, max_chars)
  if len(ls) > max_lines then
    over = true
  end
  let keep = min(max_lines, len(ls))
  let kept = []
  for j in range(0, keep) do
    let line = ls[j]
    if over && j == keep - 1 then
      // Keep the head, explicit trailing "…" (truncate_head keeps the head;
      // truncate_tail would keep the tail and prefix the ellipsis).
      line = truncate_head(line ++ "…", max_chars)
    end
    kept = append(kept, line)
  end
  {lines: kept, truncated: over}
end

// Right-aligned text: the right edge sits at `right_x`.
export fn draw_text_right(text, right_x, y, size, c)
  _native_text(text, right_x - text_width(text, size), y, size, c.r, c.g, c.b)
end

// Centered text: the run's midpoint sits at `cx`.
export fn draw_text_center(text, cx, y, size, c)
  _native_text(text, cx - text_width(text, size) / 2, y, size, c.r, c.g, c.b)
end

// Shorten `s` until it fits `avail_px` at font `size`, with a trailing "…".
//
// The pixel-measured counterpart to truncate_head, for anything carrying text
// of unknown length into a fixed box. Returns `s` untouched when it already
// fits.
//
// The ellipsis is appended once, at the end, and never measured back into the
// string being trimmed. That is not tidiness: **len and slice are byte-indexed**
// while text_width counts characters, and "…" is three bytes. A loop that
// trimmed bytes off a string *already ending* in an ellipsis got them snapped
// back to the character boundary, dropping the whole ellipsis and re-adding it —
// a fixed point, and a frame that never returned.
export fn ellipsize(s, avail_px, size)
  if text_width(s, size) <= avail_px then return s end
  let out = s
  // slice snaps down to a character boundary, so each pass drops one whole
  // character and the loop is bounded by the length of the string.
  while len(out) > 0 && text_width(out ++ "…", size) > avail_px do
    out = slice(out, 0, len(out) - 1)
  end
  out ++ "…"
end

// Shorten `s` until it fits `avail_px` at font `size`, with a *leading* "…":
// the mirror of ellipsize, keeping the rightmost text instead of the leftmost.
//
// The pixel-measured counterpart to truncate_tail, and what a file path wants:
// "…/panel/src/git_panel.ptl" says which file this is, while the head-keeping
// ellipsize would spend the whole box on the directories it shares with every
// other row. Returns `s` untouched when it already fits.
//
// The ellipsis is prepended once, at the end, and never measured back into the
// string being trimmed — the same discipline ellipsize documents above, for the
// same reason. Trimming from the front is safe where trimming a string that
// already carries its ellipsis is not: slice snaps a *start* index **up** to a
// character boundary (an end index down), so `slice(out, 1, len(out))` always
// drops one whole character and the loop strictly shrinks toward "".
export fn ellipsize_tail(s, avail_px, size)
  if text_width(s, size) <= avail_px then return s end
  let out = s
  while len(out) > 0 && text_width("…" ++ out, size) > avail_px do
    out = slice(out, 1, len(out))
  end
  "…" ++ out
end

// Join `parts` left to right with "   ·   " separators, keeping only the leading
// run that fits `avail_px` (measured with text_width at font `size`): it stops
// at the first part whose addition would overflow and drops that part and every
// part after it. Lets header / metadata lines degrade by shedding their rightmost
// segments instead of clipping mid-glyph at the pane edge. Returns {text, count}
// — `count` is how many segments survived (0 when even the first overflows).
export fn fit_parts_n(parts, avail_px, size)
  let out = ""
  let cnt = 0
  let stopped = false
  for i in range(0, len(parts)) do
    if !stopped then
      let cand = parts[i]
      if len(out) > 0 then
        cand = out ++ "   ·   " ++ parts[i]
      end
      if text_width(cand, size) <= avail_px then
        out = cand
        cnt = cnt + 1
      else
        stopped = true
      end
    end
  end
  {text: out, count: cnt}
end

// The plain-text convenience over fit_parts_n: just the joined string.
export fn fit_parts(parts, avail_px, size)
  fit_parts_n(parts, avail_px, size).text
end

// ── Style ─────────────────────────────────────────────────────────────────

export let theme = {
  bg: #14161c,
  panel: #1d2027,
  text: #d8dee9,
  dim: #8a93a2,
  accent: #3c8cff,
  outline: #3a404c,
  hover: #262b34,
  selection: #2c4a7a
}

// ── Button (immediate-mode): draws, returns true on click this frame ─────

export fn button(r, label)
  button(r, label, {
    bg: theme.panel,
    hover: theme.hover,
    fg: theme.text,
    outline: theme.outline
  })
end

export fn button(r, label, style)
  let bg = if hovered(r) then style.hover else style.bg end
  draw_rect(r, bg)
  draw_rect_outline(r, style.outline)
  let size = 14
  let tx = r.x + (r.w - text_width(label, size)) / 2
  let ty = r.y + (r.h - size) / 2
  draw_text(label, {x: tx, y: ty}, size, style.fg)
  clicked(r)
end

// ── List widget ───────────────────────────────────────────────────────────
// State is an explicit record so multiple lists coexist:
//   state files = list_state()
//   files = list_update(files, count, visible_rows, r)
// Semantics: j/k/arrows/home/end/pageup/pagedown move the selection, a click
// inside `r` selects the row under the pointer, the wheel scrolls when the
// pointer is over `r`, and the selection is always kept visible.

export fn list_state()
  {selected: 0, scroll: 0}
end

fn _row_h(r, visible_rows)
  max(1, r.h / visible_rows)
end

// Rect of the item with absolute index `i`, given the list's current scroll.
export fn list_row_rect(r, visible_rows, i, scroll)
  {x: r.x, y: r.y + (i - scroll) * _row_h(r, visible_rows), w: r.w, h: _row_h(r, visible_rows)}
end

// Scroll offset that keeps `selected` inside a `visible_rows` window.
export fn ensure_visible(scroll, selected, visible_rows)
  let s = scroll
  if selected < s then
    s = selected
  end
  if selected >= s + visible_rows then
    s = selected - visible_rows + 1
  end
  s
end

// Pixel counterpart of ensure_visible for a VARIABLE-height row list: return the
// scroll offset (px) that keeps the selected row's full [row_off, row_off+row_h)
// span inside a `view_h`-tall viewport. `scroll`, `row_off`, `row_h`, `view_h`
// are all pixels. A row taller than the viewport pins its top (its overflow then
// runs off the bottom); for any row that fits, this leaves an already-visible
// row untouched, scrolls up to reveal a row above, or down to reveal one below.
export fn ensure_visible_px(scroll, row_off, row_h, view_h)
  let s = scroll
  if row_off + row_h > s + view_h then
    s = row_off + row_h - view_h
  end
  if row_off < s then
    s = row_off
  end
  s
end

export fn list_update(lst, item_count, visible_rows, r)
  list_update(lst, item_count, visible_rows, r, true)
end

// Focus-gated form: keyboard navigation only runs when `active` is true, so a
// list can share the keyboard with other widgets (see the focus registry).
// Mouse click still selects a row regardless — the caller pairs that click
// with `focus_set` to make the list focused.
//
// The wheel scrolls the window freely, unclamped by the selection (like gitk /
// native list widgets): only keyboard navigation re-runs `ensure_visible` to
// pull the selection back on screen, so you can browse a long list past the
// selection without it snapping back.
export fn list_update(lst, item_count, visible_rows, r, active)
  let sel = lst.selected
  let scroll = lst.scroll
  let key_moved = false
  if active then
    if key_pressed("down") || key_pressed("j") then
      sel = sel + 1
      key_moved = true
    end
    if key_pressed("up") || key_pressed("k") then
      sel = sel - 1
      key_moved = true
    end
    if key_pressed("pagedown") then
      sel = sel + visible_rows
      key_moved = true
    end
    if key_pressed("pageup") then
      sel = sel - visible_rows
      key_moved = true
    end
    if key_pressed("home") then
      sel = 0
      key_moved = true
    end
    if key_pressed("end") then
      sel = item_count - 1
      key_moved = true
    end
  end
  if mouse_pressed(0) && point_in(mouse_x(), mouse_y(), r) then
    let row = scroll + (mouse_y() - r.y) / _row_h(r, visible_rows)
    if row >= 0 && row < item_count then
      sel = row
    end
  end
  if hovered(r) then
    scroll = scroll + scroll_y()
  end
  sel = _clamp(sel, 0, max(0, item_count - 1))
  scroll = _clamp(scroll, 0, max(0, item_count - visible_rows))
  if key_moved then
    scroll = ensure_visible(scroll, sel, visible_rows)
  end
  {selected: sel, scroll: scroll}
end

// ── Scroll region (row/line based) ────────────────────────────────────────
// Wheel scrolls when the pointer is over `r`; pageup/pagedown page; the
// offset is clamped to [0, total_lines - visible_lines].

export fn scroll_update(offset, total_lines, visible_lines, r)
  scroll_update(offset, total_lines, visible_lines, r, true)
end

// Focus-gated form (mirrors list_update's): the wheel stays hover-scoped, but
// pageup/pagedown only page when `active` is true. In a multi-region panel
// built on the focus registry this stops PageDown in the focused region from
// paging every other scroll region on screen — gate on focused(fc, id).
export fn scroll_update(offset, total_lines, visible_lines, r, active)
  let off = offset
  if hovered(r) then
    off = off + scroll_y()
  end
  if active then
    if key_pressed("pagedown") then
      off = off + visible_lines
    end
    if key_pressed("pageup") then
      off = off - visible_lines
    end
  end
  _clamp(off, 0, max(0, total_lines - visible_lines))
end

// Proportional scrollbar thumb along the right edge of scroll region `r`.
// `count` is the total row count, `rows` the visible rows, `scroll` the current
// top offset (as fed to list_update / scroll_update). Draws nothing when the
// content fits (count <= rows); otherwise a dim track with an accent-neutral
// thumb sized rows/count of the track and positioned by scroll/(count - rows).
export fn draw_scrollbar(r, count, rows, scroll)
  if count > rows then
    let bar_w = 4
    let track = {x: r.x + r.w - bar_w, y: r.y, w: bar_w, h: r.h}
    draw_rect(track, theme.outline)
    let thumb_h = max(12, r.h * rows / count)
    let thumb_y = track.y + (r.h - thumb_h) * scroll / (count - rows)
    draw_rect({x: track.x, y: thumb_y, w: bar_w, h: thumb_h}, theme.dim)
  end
end

// ── Focus registry ─────────────────────────────────────────────────────────
// Focus is panel-global: at most one widget id holds the keyboard at a time.
// Keep it in a `state` record so it survives hot reload:
//   state fc = focus_state()
// An id is any value you compare with == ; the default "" means "nothing".
// Widgets that consume the keyboard (text_field, the gated list_update) check
// `focused(fc, id)` before reading keys, and request focus on click.

export fn focus_state()
  {id: ""}
end

export fn focused(fc, id)
  fc.id == id
end

export fn focus_set(fc, id)
  {id: id}
end

export fn focus_clear(fc)
  {id: ""}
end

// Position of `id` in the ordered list `ids`, or -1 if absent (so an unfocused
// registry — id "" — reads as "before the first").
fn _index_of(ids, id)
  let found = -1
  for i in range(0, len(ids)) do
    if found < 0 && ids[i] == id then
      found = i
    end
  end
  found
end

// Move focus to the next / previous id in the ordered ring `ids`. From nothing
// focused, next lands on the first and prev on the last; both wrap.
export fn focus_next(fc, ids)
  if len(ids) == 0 then
    fc
  else
    let j = _index_of(ids, fc.id) + 1
    if j >= len(ids) then
      j = 0
    end
    focus_set(fc, ids[j])
  end
end

export fn focus_prev(fc, ids)
  if len(ids) == 0 then
    fc
  else
    let idx = _index_of(ids, fc.id)
    let j = idx - 1
    if idx < 0 || j < 0 then
      j = len(ids) - 1
    end
    focus_set(fc, ids[j])
  end
end

// Convenience: Tab advances focus, Shift+Tab reverses it. Call once per frame
// with the ring of focusable widget ids.
export fn focus_update(fc, ids)
  if key_pressed("tab") then
    if mod_shift() then
      focus_prev(fc, ids)
    else
      focus_next(fc, ids)
    end
  else
    fc
  end
end

// A section heading that shows which region owns the keyboard: accent-colored
// with an underline when `active`, dim otherwise. Pairs with the focus
// registry — pass `focused(fc, id)` as `active` to label each focusable region.
export fn section_label(label, x, y, active)
  let size = 14
  let color = if active then theme.accent else theme.dim end
  draw_text(label, {x: x, y: y}, size, color)
  if active then
    let uy = y + size + 1
    draw_line({x: x, y: uy}, {x: x + text_width(label, size), y: uy}, color)
  end
end

// ── Text field (immediate-mode, focus-aware) ────────────────────────────────
// Single-line editable text. Clicking focuses it; while focused it appends
// typed text, backspace deletes the last char, and Return sets `submitted`.
// State is the plain string `buf` (keep it in `state`); focus lives in a
// separate focus record. Returns {focus, text, submitted}:
//   let res = text_field(fc, "name", r, buf)
//   fc = res.focus  buf = res.text
//   if res.submitted then ... end

fn _draw_text_field(r, text, has)
  draw_rect(r, theme.panel)
  let border = if has then theme.accent else theme.outline end
  draw_rect_outline(r, border)
  let size = 14
  let tx = r.x + 6
  let ty = r.y + (r.h - size) / 2
  draw_text(text, {x: tx, y: ty}, size, theme.text)
  if has then
    let cx = tx + text_width(text, size)
    draw_line({x: cx, y: ty}, {x: cx, y: ty + size}, theme.accent)
  end
end

export fn text_field(fc, id, r, buf)
  let f = fc
  if mouse_pressed(0) && point_in(mouse_x(), mouse_y(), r) then
    f = focus_set(fc, id)
  end
  let has = focused(f, id)
  let text = buf
  let submitted = false
  if has then
    if key_pressed("backspace") && len(text) > 0 then
      text = slice(text, 0, len(text) - 1)
    end
    let typed = text_input()
    if len(typed) > 0 then
      text = text ++ typed
    end
    if key_pressed("return") then
      submitted = true
    end
  end
  _draw_text_field(r, text, has)
  {focus: f, text: text, submitted: submitted}
end

// ── Context menu (immediate-mode dropdown) ─────────────────────────────────
// A right-click menu. State is an explicit record so several menus coexist and
// it survives hot reload:
//
//   state menu = menu_state()
//   ...
//   // near the TOP of the frame, before the app's own click handling:
//   if !menu_blocking(menu) then ...normal left-click handling... end
//   menu = menu_open_on_right_click(menu, row_rect, "row:{i}")
//   ...
//   // near the BOTTOM, so it draws over everything else:
//   let picked = context_menu(menu, [menu_item("Copy"), menu_sep(),
//                                    menu_item("Delete", false)])
//   menu = picked.menu
//   if picked.index >= 0 then ...act on picked.label / picked.tag... end
//
// The two-call shape (`menu_blocking` early, `context_menu` late) is what an
// immediate-mode pass can do about z-order: the menu must be *drawn* last to
// sit on top, but its click must be claimed *before* the widgets underneath
// react to the same press. So while a menu is open the rest of the UI simply
// stands down for the frame, and the menu resolves the click at the end.
//
// `tag` is any value you want handed back with the choice — the row the menu
// was opened on, typically. It is never interpreted here.

// One menu row. `enabled: false` draws dim and cannot be chosen.
export fn menu_item(label)
  menu_item(label, true)
end

export fn menu_item(label, enabled)
  {label: label, enabled: enabled, sep: false}
end

// A divider rule between groups of items. Never hoverable or choosable.
export fn menu_sep()
  {label: "", enabled: false, sep: true}
end

// `at` is the frame the menu opened on. The press that opens a menu is still
// a live `mouse_pressed` edge when `context_menu` runs later in the *same*
// frame, and a menu that resolved that edge would dismiss itself the instant it
// appeared. So the opening frame is recorded and skipped when input is
// resolved — the menu starts listening on the next one.
export fn menu_state()
  {open: false, x: 0, y: 0, tag: "", hover: -1, at: -1}
end

// True while the menu owns the pointer. Guard the rest of the panel's own
// click handling with this so one press is not acted on twice.
export fn menu_blocking(m)
  m.open
end

export fn menu_close(m)
  {open: false, x: 0, y: 0, tag: m.tag, hover: -1, at: -1}
end

// Open (or move) the menu to `(x, y)`, remembering `tag`. Hover starts on
// nothing, so a menu opened under the pointer highlights only once it moves.
export fn menu_show(m, x, y, tag)
  {open: true, x: x, y: y, tag: tag, hover: -1, at: frame_count()}
end

// The common trigger: a right press inside `r` opens the menu at the pointer.
// Any other frame leaves the state alone, so this is safe to call every frame
// for every row.
export fn menu_open_on_right_click(m, r, tag)
  if mouse_pressed(1) && point_in(mouse_x(), mouse_y(), r) then
    menu_show(m, mouse_x(), mouse_y(), tag)
  else
    m
  end
end

let _MENU_ROW_H = 24
let _MENU_SEP_H = 9
let _MENU_PAD = 6
let _MENU_SIZE = 14

fn _menu_row_h(item)
  if item.sep then _MENU_SEP_H else _MENU_ROW_H end
end

// Total height of `items` plus the frame's own vertical padding.
fn _menu_h(items)
  let h = _MENU_PAD * 2
  for it in items do
    h = h + _menu_row_h(it)
  end
  h
end

// Width that fits the widest label, clamped so a very long one does not run
// off the screen and a very short menu is still comfortably clickable.
fn _menu_w(items)
  let widest = 0
  for it in items do
    let tw = text_width(it.label, _MENU_SIZE)
    if !it.sep && tw > widest then
      widest = tw
    end
  end
  // `_clamp`, not the `clamp` builtin: that one yields a float, and this feeds
  // pixel geometry that has to stay integral.
  _clamp(widest + 28, 120, max(140, screen_width() - 24))
end

// Where the menu actually lands: it prefers down-and-right of the click, and
// flips to the other side of the pointer when that would put it off-screen —
// so a right-click near the bottom edge opens upward instead of being clipped.
fn _menu_rect(m, items)
  let w = _menu_w(items)
  let h = _menu_h(items)
  let x = m.x
  let y = m.y
  if x + w > screen_width() then
    x = max(0, m.x - w)
  end
  if y + h > screen_height() then
    y = max(0, m.y - h)
  end
  {x: x, y: y, w: w, h: h}
end

// Index of the choosable item at pane-local `(px, py)`, or -1. Separators and
// disabled rows are transparent to this, so neither can be picked.
fn _menu_hit(r, items, px, py)
  let hit = -1
  let y = r.y + _MENU_PAD
  for i in range(0, len(items)) do
    let it = items[i]
    let rh = _menu_row_h(it)
    if !it.sep && it.enabled && px >= r.x && px < r.x + r.w && py >= y && py < y + rh then
      hit = i
    end
    y = y + rh
  end
  hit
end

// Step the keyboard highlight `from` by `step`, skipping separators and
// disabled rows, and stopping at the ends rather than wrapping (a menu is
// short enough that wrapping reads as a glitch). -1 means "nothing yet", so
// the first Down lands on the first choosable row.
fn _menu_step(items, from, step)
  let i = from + step
  if from < 0 && step < 0 then
    i = len(items) - 1
  end
  let found = from
  while i >= 0 && i < len(items) && found == from do
    if !items[i].sep && items[i].enabled then
      found = i
    end
    i = i + step
  end
  found
end

// Draw the menu and resolve this frame's input. Returns
// {menu, index, label, tag}: `index` is -1 unless something was chosen, and
// `tag` is whatever was passed to `menu_show` / `menu_open_on_right_click`.
// A closed menu draws nothing and always returns index -1.
export fn context_menu(m, items)
  if !m.open || len(items) == 0 then
    {menu: m, index: -1, label: "", tag: m.tag}
  else
    let r = _menu_rect(m, items)
    let mx = mouse_x()
    let my = mouse_y()
    let inside = point_in(mx, my, r)
    // The opening press is not the menu's to act on — see `menu_state`.
    let live = m.at != frame_count()

    // Pointer hover wins over the keyboard highlight the moment it is over a
    // row — the two share one `hover`, so the menu never shows two of them.
    let hover = m.hover
    let over = _menu_hit(r, items, mx, my)
    if inside && over >= 0 then
      hover = over
    end
    if key_pressed("down") then
      hover = _menu_step(items, hover, 1)
    end
    if key_pressed("up") then
      hover = _menu_step(items, hover, -1)
    end

    // Resolve: a click on a choosable row takes it, Return takes the
    // highlighted one, and anything else — a click outside, Escape, a second
    // right-click — dismisses without choosing.
    let chosen = -1
    let close = false
    if live then
      if mouse_pressed(0) || mouse_pressed(1) then
        if inside && over >= 0 then
          chosen = over
        end
        close = true
      end
      if key_pressed("return") && hover >= 0 then
        chosen = hover
        close = true
      end
      if key_pressed("escape") then
        close = true
      end
    end

    // Drawn after the input so the highlight reflects this frame's pointer.
    // A soft drop shadow lifts the menu off whatever it covers; without it a
    // dark menu over a dark panel reads as part of the background.
    // Alpha is 0–255, not a 0–1 fraction: a float here truncates to 0 and the
    // shadow disappears entirely.
    draw_rect({x: r.x + 2, y: r.y + 3, w: r.w, h: r.h}, #000000, 89)
    draw_rect(r, theme.panel)
    draw_rect_outline(r, theme.outline)
    let y = r.y + _MENU_PAD
    for i in range(0, len(items)) do
      let it = items[i]
      let rh = _menu_row_h(it)
      if it.sep then
        let sy = y + rh / 2
        draw_line({x: r.x + 8, y: sy}, {x: r.x + r.w - 8, y: sy}, theme.outline)
      else
        let fg = if it.enabled then theme.text else theme.dim end
        if i == hover then
          draw_rect({x: r.x + 1, y: y, w: r.w - 2, h: rh}, theme.selection)
          fg = theme.text
        end
        draw_text(it.label, {x: r.x + 12, y: y + (rh - _MENU_SIZE) / 2}, _MENU_SIZE, fg)
      end
      y = y + rh
    end

    let next = if close then menu_close(m) else {open: true, x: m.x, y: m.y, tag: m.tag, hover: hover, at: m.at} end
    let label = if chosen >= 0 then items[chosen].label else "" end
    {menu: next, index: chosen, label: label, tag: m.tag}
  end
end
