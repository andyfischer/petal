// petal-ui prelude — module `ui`
//
// The petal-ui interface: the declarations of the natives a petal-ui host
// provides, and the standard interaction primitives written in Petal over the
// Layer-0 input natives and the Layer-2 draw natives. Embedders register it
// as the package `ui`; a script writes `import ui` and calls these bare or
// as `ui.button`, or `import ui: button`.
// Only declarations marked `pub` are visible to importers; everything else
// (and any name starting with `_`) is module-private.
//
// Rects are records: {x, y, w, h}. Colors are records: {r, g, b} (hex
// literals like #3c8cff work). Button 0 is the left mouse button.

// ── The native interface ──────────────────────────────────────────────────
// What a petal-ui host implements in Rust (core-libs/petal-ui/src), declared
// here so scripts and `petal check` know each native's parameter names, arity
// and types: `native fn name(params) -> type`. A parameter written `name?`
// may be left off; several declarations of one name are that native's call
// forms. A host registers the natives (`petal_ui::register_all`); loading a
// script into an `Env` that lacks one it uses is an error before any line
// runs.
//
// The natives the prelude wraps in record overloads (`draw_rect`, `clip`, …)
// are declared further down under private `_native_*` names, next to the
// overloads that call them: `native fn _native_rect(…) = "draw_rect"`.

// The input, timing and frame natives are declared in `./input` (module
// `ui/input`) and re-exported here: `import ui` binds them all.
pub import ./input
import color
import creative
import io

// Drawing that needs no overloads (core-libs/petal-ui/src/draw.rs).
pub native fn clear(r: num, g: num, b: num)

// `draw_rect` is a native in every shape — flat, mixed and record — so the
// commonest draw call costs no Petal instructions beyond the call. A colour
// `c` is a `{r, g, b}` record (a hex literal) or a packed RGB int (`r * 65536 + g * 256 + b`). `a` is
// the alpha, 0–255.
pub native fn draw_rect(x: num, y: num, w: num, h: num, r: num, g: num, b: num, a?: num)
pub native fn draw_rect(x: num, y: num, w: num, h: num, c, a?: num)
pub native fn draw_rect(rect, c, a?: num)

// Many filled rects in one call: `rects` is five numbers per rect — x, y, w,
// h, c — as a flat list, a packed array, or a list of `[x, y, w, h, c]`
// lists. With a `palette` (a list of colours) `c` indexes it; without one `c`
// is the colour itself (a packed RGB int (`r * 65536 + g * 256 + b`), or a record in the list
// forms). `dx`, `dy` move the whole batch. See "Retained drawing" below.
pub native fn draw_rects(rects, palette?, dx?: num, dy?: num)

// Images (draw.rs). `image_load(source)` asks the host to have `source` ready
// and answers whether it is; `image_size(source)` is its `{w, h}` in pixels,
// or nil while the host does not know it. `draw_image` is further down.
pub native fn image_load(source: string)
pub native fn image_size(source: string)

// Text measurement (draw.rs, text.rs). The style is a record, or a bare size
// with an optional face name after it — each shape is its own form.
pub native fn text_width(text: string, style) -> int
pub native fn text_width(text: string, size, font?) -> int
pub native fn text_advance(text: string, style) -> float
pub native fn text_advance(text: string, size, font?) -> float
pub native fn text_metrics(style)
pub native fn text_metrics(size, font?)
pub native fn text_wrap(text: string, style, max_width)
pub native fn text_wrap(text: string, size, max_width)
pub native fn text_wrap(text: string, size, font, max_width)
pub native fn text_ellipsize(text: string, style, max_width, where?)
pub native fn text_ellipsize(text: string, size, max_width, where?)
pub native fn text_ellipsize(text: string, size, font, max_width, where?)
pub native fn text_index_at(text: string, style, dx)
pub native fn text_index_at(text: string, size, dx)
pub native fn text_index_at(text: string, size, font, dx)
pub native fn fonts()

// Offscreen canvases (draw.rs).
pub native fn create_canvas(w: num, h: num)
pub native fn draw_to(id)
pub native fn draw_to_screen()
pub native fn snapshot_to(id, x, y)
pub native fn blur_canvas(id, radius)

// The host-data pull channel (core-libs/petal-ui/src/host_data.rs).
pub native fn host_data(kind, arg)

// ── Geometry + hit testing ────────────────────────────────────────────────

// A rect is a `Rect` — the built-in class (fields x, y, w, h). It is still an
// ordinary record, so every `{x, y, w, h}` written by hand keeps working
// everywhere a rect is taken; going through the class is what earns the
// geometry methods (`r.center_x()`, `r.inset(4)`, `r.right()` …) and makes
// `type(r)` say "Rect". See docs/language-guide.md (Classes & Methods).
//
// Coordinates are kept exactly as passed — `rect(10.5, …)` is a sub-pixel rect,
// not a truncated one — so animated and fractional layout stays smooth. The
// draw natives are where a coordinate becomes a whole pixel.
//
// `rect` *is* the constructor rather than a function wrapping it, so a bad
// argument is reported at the caller's own `rect(...)` — a wrapper would put
// the caret on this file's line and leave the app author reading the prelude.
pub let rect = Rect

pub fn point_in(px, py, r)
  px >= r.x && px < r.x + r.w && py >= r.y && py < r.y + r.h
end

// `hovered(r)` — `point_in(mouse_x(), mouse_y(), r)` — is a native
// (core-libs/petal-ui/src/input.rs), so that memoized scopes can record it as a single
// probe with its answer rather than as two pointer reads; see
// docs/dev/memo-scopes.md.

pub fn clicked(r)
  hovered(r) && mouse_pressed(0)
end

// ── Timing ────────────────────────────────────────────────────────────────
// `time()` is an absolute clock in seconds, published by the host each frame
// (monotonic, read fresh — never a running sum of `dt()`, so it does not
// drift). `elapsed()` reports the seconds since it was first called: it
// captures the clock once into `state` and subtracts. That `state` is keyed by
// the call path, so the capture is per *callsite*: every `elapsed()` in a
// program is its own timer, started on the first frame that callsite runs —
// which is what makes "one timer per thing being timed" the default. A call
// inside a loop gets one timer per iteration by the same rule. For a single
// app-global clock instead, capture it once into a top-level cell
// (`state var t0 = time()`) and subtract.
pub fn elapsed()
  state start = time()
  time() - start
end

// ── Record overloads over the flat draw natives ───────────────────────────
// The flat-int arities delegate to the natives, declared here under private
// names (`= "draw_rect"` binds the host native of that name), so scripts that
// use the classic signatures keep working when these overloads take the name.

native fn _native_image(source, x, y, w, h, a?, radius?, tint?, sx?, sy?, sw?, sh?, slice_l?, slice_t?, slice_r?, slice_b?) = "draw_image"
native fn _native_rect_rounded(x: num, y: num, w: num, h: num, radius: num, r: num, g: num, b: num, a?: num) = "draw_rect_rounded"
native fn _native_rect_outline(x: num, y: num, w: num, h: num, r: num, g: num, b: num, a?: num, width?: num) = "draw_rect_outline"
native fn _native_line(x1: num, y1: num, x2: num, y2: num, r: num, g: num, b: num, a?: num, width?: num) = "draw_line"
native fn _native_circle(cx: num, cy: num, radius: num, r: num, g: num, b: num, a?: num) = "draw_circle"
native fn _native_rect_rounded_outline(x: num, y: num, w: num, h: num, radius: num, r: num, g: num, b: num, a?: num, width?: num) = "draw_rect_rounded_outline"
native fn _native_circle_outline(cx: num, cy: num, radius: num, r: num, g: num, b: num, a?: num, width?: num) = "draw_circle_outline"
native fn _native_ellipse(cx: num, cy: num, rx: num, ry: num, r: num, g: num, b: num, a?: num) = "draw_ellipse"
native fn _native_ellipse_outline(cx: num, cy: num, rx: num, ry: num, r: num, g: num, b: num, a?: num, width?: num) = "draw_ellipse_outline"
native fn _native_arc(cx: num, cy: num, r_in: num, r_out: num, a0: num, a1: num, r: num, g: num, b: num, a?: num) = "fill_arc"
native fn _native_triangle(x1: num, y1: num, x2: num, y2: num, x3: num, y3: num, r: num, g: num, b: num, a?: num) = "fill_triangle"
native fn _native_poly(points, r, g, b, a?) = "fill_poly"
native fn _native_polygon(points, r, g, b, a?) = "fill_polygon"
native fn _native_fan(cx, cy, points, r, g, b, a?) = "fill_fan"
native fn _native_text(text, x, y, style) = "draw_text"
native fn _native_text(text, x, y, size, r, g, b, a?) = "draw_text"
native fn _native_font(name) = "font"

// Every primitive takes an optional trailing alpha `a` (0–255, 255 = opaque).
// Lines and outlines also take an optional trailing stroke `width`. Rounded
// rects add a `radius`.
//
// Each primitive comes in three shapes: the flat packed-int form
// (`draw_line(x1, y1, x2, y2, r, g, b)`), the record form (points, centres and
// rects as `{x, y}` / `{x, y, w, h}` records plus a colour record), and the
// mixed form with flat coordinates and a colour record
// (`draw_line(x1, y1, x2, y2, c)`).
//
// Every shape can be called by name, and its parameters are spelt the same
// way throughout: `x, y, w, h` / `rect`, `cx, cy` / `center`, `x1, y1, x2, y2`
// / `p1, p2`, `radius`, `r, g, b` / `c`, then `a` and `width`:
//
//   draw_rect_outline(x: 0, y: 0, w: 10, h: 4, c: red, width: 2)
//   draw_circle(center: p, radius: 6, c: red, a: 128)
//
// How the declarations are laid out. A shape's longest declaration gives its
// optional tail defaults (`a = 255, width = 1` — what the natives fill in
// themselves), so one declaration covers the shape with and without them and
// a named call can skip `a` to reach `width`. An overload is chosen by the
// number of arguments first and by their names second, so where two shapes
// land on the same count the declaration with exactly that many parameters
// takes both: a positional call tells them apart with `_is_num` — a number
// where the other shape has a record — and a named call that does not fit its
// parameters goes to the other shape's declaration. Such a declaration is
// marked "also positionally" below; its parameter names are the shape it is
// declared as. Next to one, the shape's shorter counts keep declarations of
// their own, so each still says in its own body what its parameters must be
// (`petal check` reads that) rather than deferring to a runtime test.
//
// One pair needs a third look. `draw_circle_outline(cx, cy, radius, c,
// width: 2)` and `draw_ellipse_outline(cx, cy, rx, ry, c, width: 2)` — flat
// coordinates passed positionally, alpha skipped by naming `width` — have the
// argument count and the `width` name of the centre-record shape's longest
// declaration too. A name that skips a parameter outranks the exact count, so
// the mixed shape's declaration takes the call, and with it the centre-record
// call of the same outline, `(center, radius, c, a, width: 2)`: it tells that
// one apart by its first argument being a record.

fn _is_num(v)
  let t = type(v)
  t == "int" || t == "float"
end

// draw_image(source, rect[, a[, radius]]) / draw_image(source, x, y, w, h[, a[,
// radius]]) — a host-resolved bitmap scaled into the destination. `source` is
// an asset path or name the host understands. `radius` rounds the corners —
// the avatar, the card thumbnail. A host that can't round a bitmap draws the
// square image rather than nothing.
//
// In place of `a`, an options record says the rest:
//
//   draw_image("ui/atlas.png", r, {src: rect(32, 0, 16, 16), tint: #ffcc00})
//   draw_image("ui/frame.png", panel, {slice: 6})
//
//   a       opacity 0–255 (default 255)
//   radius  corner radius in px (default 0)
//   tint    a colour the image's pixels are multiplied by — one white sprite,
//           recoloured per use (default: none)
//   src     the part of the image to draw, {x, y, w, h} in the image's own
//           pixels: one cell of an atlas (default: the whole image)
//   slice   nine-slice insets in the image's own pixels, one number for all
//           four edges or {l, t, r, b}: corners are drawn unscaled, edges
//           stretch one way, the middle both — a small frame image makes a
//           panel of any size (default: none, the image scales whole)
//
// A host that lacks one of these draws the image without it.
pub fn draw_image(source, x, y, w, h, a = 255, radius = 0)
  if _is_num(a) then
    _native_image(source, x, y, w, h, a, radius)
  else
    _image_opts(source, x, y, w, h, a)
  end
end
pub fn draw_image(source, rect, a = 255, radius = 0)
  if _is_num(a) then
    _native_image(source, rect.x, rect.y, rect.w, rect.h, a, radius)
  else
    _image_opts(source, rect.x, rect.y, rect.w, rect.h, a)
  end
end

fn _image_opts(source, x, y, w, h, o)
  let src = o["src"] ?? nil
  let sl = o["slice"] ?? 0
  let sx = 0
  let sy = 0
  let sw = 0
  let sh = 0
  if src != nil then
    sx = src.x
    sy = src.y
    sw = src.w
    sh = src.h
  end
  if _is_num(sl) then
    _native_image(source, x, y, w, h, o["a"] ?? 255, o["radius"] ?? 0, o["tint"] ?? nil,
                  sx, sy, sw, sh, sl, sl, sl, sl)
  else
    _native_image(source, x, y, w, h, o["a"] ?? 255, o["radius"] ?? 0, o["tint"] ?? nil,
                  sx, sy, sw, sh, sl["l"] ?? 0, sl["t"] ?? 0, sl["r"] ?? 0, sl["b"] ?? 0)
  end
end

pub fn draw_rect_rounded(x, y, w, h, radius, r, g, b, a = 255)
  _native_rect_rounded(x, y, w, h, radius, r, g, b, a)
end
pub fn draw_rect_rounded(rect, radius, c, a = 255)
  _native_rect_rounded(rect.x, rect.y, rect.w, rect.h, radius, c.r, c.g, c.b, a)
end
pub fn draw_rect_rounded(x, y, w, h, radius, c, a = 255)
  _native_rect_rounded(x, y, w, h, radius, c.r, c.g, c.b, a)
end

pub fn draw_rect_outline(x, y, w, h, r, g, b, a = 255, width = 1)
  _native_rect_outline(x, y, w, h, r, g, b, a, width)
end
pub fn draw_rect_outline(x, y, w, h, c)
  _native_rect_outline(x, y, w, h, c.r, c.g, c.b)
end
pub fn draw_rect_outline(x, y, w, h, c, a)
  _native_rect_outline(x, y, w, h, c.r, c.g, c.b, a)
end
// Also positionally the flat `(x, y, w, h, r, g, b)`.
pub fn draw_rect_outline(x, y, w, h, c, a = 255, width = 1)
  if _is_num(c) then
    _native_rect_outline(x, y, w, h, c, a, width)
  else
    _native_rect_outline(x, y, w, h, c.r, c.g, c.b, a, width)
  end
end
pub fn draw_rect_outline(rect, c, a = 255, width = 1)
  _native_rect_outline(rect.x, rect.y, rect.w, rect.h, c.r, c.g, c.b, a, width)
