@module_doc("""
The theme tokens and the painting primitives every bloom component shares:
text styles and placement, surfaces, outlines, washes, the focus ring and the
late paint layer.

bloom does not own a palette. It *derives* one: `theme()` starts from
whatever the host published through the `ui` prelude (Garden binds its
editor palette, the SDL and canvas hosts bind theirs, and a bare host falls
back to the built-in dark theme), then layers bloom's own tokens — motion
speed, the tone ramp, the focus ring — over it, then any override the app
set with `theme_set`. So a bloom panel looks native in its host on the first
frame with no setup, and an app that wants a look of its own overrides one
key rather than a palette.

Every label bloom draws is placed by `text_layout`, which asks the host where
a run's ink actually lands rather than assuming it is `size` px tall starting
at `y`. That is why a bloom label is centered on the line it claims to be on,
and why a component's own text needs no arithmetic from the caller. Reach
past bloom for it (`import text_layout`) when a panel draws text of its own.
""", see: ["text_layout"])

# The drawing and input names used below (`rect`, `draw_rect_rounded`,
# `mix` and friends) come from the `ui` package. This module imports it
# itself: an import reaches only the file it is written in.

# Placement, on the other hand, is a library: text_layout turns the host's
# font metrics into the `y` a run should be drawn at. bloom draws every label
# through it, which is what keeps them on the centre line they claim to be on.
import text_layout: draw_text_line, draw_text_block, text_baseline, text_top,
                    text_align_x, elide, text_size
import ui

# bloom's own layer over the host palette. Numbers only — every color comes
# from the host, so these stay right in a light theme and a dark one.
let TOKENS = {
  # Motion. Multiply every duration by `speed` to slow a whole UI down for a
  # demo (`theme_set({speed: 3})`) or switch it off for a screenshot.
  speed: 1.0,
  hover_rate: 18.0,
  press_rate: 34.0,
  open_dur: 0.16,
  press_scale: 0.97,
  # Shape.
  radius: 7,
  radius_sm: 4,
  radius_lg: 12,
  radius_pill: 999,
  # Rhythm.
  pad_x: 12,
  pad_y: 7,
  gap: 8,
  row_h: 30,
  # Ink strengths, as percentages of the tint that produces them.
  hover_pct: 8,
  press_pct: 14,
  ring_pct: 55,
  border_pct: 14,
}

# The app's override layer, kept per program (and across a hot reload).
state var _over = {}

@doc("""
The live token record: the host palette (whatever `ui_theme()` resolves to:
Garden's editor colors, an SDL app's, the built-in dark default), then
bloom's own tokens over it, then the app's `theme_set` overrides over those.

The host supplies the colors: `bg`, `panel`, `surface`, `overlay`, `text`,
`muted`, `dim`, `accent`, `success`, `warn`, `danger`, `outline`, `border`,
`hover`, `selection`, the `space_*` / `radius_*` / `font_*` scales and
`elevation_1/2/3`. bloom adds numbers only, so they stay right in a light
theme and a dark one:

| Token | Default | Role |
|---|---|---|
| `speed` | 1.0 | multiplies every duration; `theme_set({speed: 0})` freezes the UI for a pixel diff |
| `hover_rate` / `press_rate` | 18 / 34 | how fast the interaction fades run |
| `open_dur` | 0.16 | menu / popover entrance |
| `press_scale` | 0.97 | how far a face squashes when pressed |
| `radius` / `radius_sm` / `radius_lg` / `radius_pill` | 7 / 4 / 12 / 999 | corner scale |
| `pad_x` / `pad_y` / `gap` / `row_h` | 12 / 7 / 8 / 30 | rhythm |
| `hover_pct` / `press_pct` / `ring_pct` / `border_pct` | 8 / 14 / 55 / 14 | ink strengths, in percent |
""", returns: "A fresh record of every token; changing it changes nothing.",
  example: """
    let t = bloom.theme()
    draw_rect_rounded(r, t.radius, t.panel)
  """, see: ["theme_set", "theme_reset"])
pub fn theme() -> record
  let base = ui_theme()
  let t = {}
  for k in keys(base) do
    t[k] = base[k]
  for k in keys(TOKENS) do
    t[k] = TOKENS[k]
  for k in keys(get _over) do
    t[k] = (get _over)[k]
  t

@doc("""
Override tokens for the whole program. It merges into the overrides already
set, so an app usually sets one or two keys. The overrides are program state:
they survive a hot reload.
""", params: {rec: "The tokens to override, any of `theme()`'s keys."},
  example: """bloom.theme_set({accent: :7c5cff, radius: 10, speed: 1.4})""",
  see: ["theme", "theme_reset"])
pub fn theme_set(rec: record)
  let next = {}
  for k in keys(get _over) do
    next[k] = (get _over)[k]
  for k in keys(rec) do
    next[k] = rec[k]
  set _over = next

@doc("Drop every `theme_set` override, back to the host palette and bloom's defaults.", see: ["theme_set"])
pub fn theme_reset()
  set _over = {}

@doc("""
A duration scaled by the theme's `speed`. Every component asks for its
timings through `dur` and `rate`, which is what makes `theme_set({speed: 0})`
freeze an entire UI for a pixel diff.
""", params: {t: "The theme record.", seconds: "The duration at `speed` 1."},
  returns: "`seconds` times `speed`.", see: ["rate"])
pub fn dur(t: record, seconds: num) -> float
  float(seconds) * float(field(t, "speed", 1.0))

@doc("""
An easing rate (in 1/seconds) scaled by the theme's `speed`: the counterpart
of `dur` for the `ease_to` family. At `speed` 0 it is very large, so an
animation lands at once.
""", params: {t: "The theme record.", r: "The rate at `speed` 1."},
  returns: "`r` divided by `speed`.", see: ["dur", "bloom/motion.ease_to"])
pub fn rate(t: record, r: num) -> float
  let s = float(field(t, "speed", 1.0))
  if s <= 0.0 then 100000.0 else float(r) / s end

# ── The late layer ────────────────────────────────────────────────────────
# A menu's popup belongs *above* everything, but the call that opens it sits
# where its button is — usually early in the frame. Immediate mode has no
# z-order to fix that with, so bloom keeps one: a component hands its painting
# to `defer_paint` as a closure, and the closure runs later.
#
# An app that calls `overlays()` as its last line gets exactly correct
# layering. An app that never calls it still gets its overlays painted — at
# the first bloom overlay call of the *next* frame, which is where an
# immediate-mode library would have drawn them anyway. So the ordering rule is
# an improvement to opt into, never a way to lose a menu.

state var _late = []
# Whether a paint has been deferred yet this frame. A plain module `var`, so
# it is false again on every run with no `frame_count()` read to keep the
# frame gate from skipping a quiet panel (see `_building` in bloom/interact).
var _late_begun = false

@doc("""
Put painting on the late layer: `f` runs when `overlays()` is called, above
everything drawn before it. The first deferral of a frame also flushes what
the previous frame left unpainted.
""", params: {f: "A closure that takes no arguments and draws."},
  example: """
    bloom.defer_paint(fn()
      draw_rect_rounded(badge_r, 4, t.accent)
    end)
  """, see: ["overlays"])
pub fn defer_paint(f: function)
  if !(get _late_begun) then
    set _late_begun = true
    overlays()
  set _late = append(get _late, f)

@doc("""
Paint the late layer: everything deferred this frame. Call it as the last
line of the frame; calling it twice, or when nothing is pending, does
nothing.

A menu's popup belongs above everything, but the call that opens it sits
where its button is, usually early in the frame. So menus and tooltips hand
their painting to a closure (`defer_paint`), and `overlays()` runs them. An
app that never calls it still gets its overlays: they are painted at the
first bloom overlay call of the next frame, which is where an immediate-mode
library would have drawn them anyway. So this is an improvement to opt into,
never a way to lose a menu.

Dialogs, popovers and toasts paint immediately, because the app draws *into*
them right after the call; put those calls late in the frame yourself.
""", example: "bloom.overlays()   # the last line of the frame", see: ["defer_paint"])
pub fn overlays()
  let queued = get _late
  set _late = []
  for f in queued do
    f()

# ── Color ─────────────────────────────────────────────────────────────────

@doc("""
Lighten (`amt` > 0) or darken (`amt` < 0) a color toward the theme's own
extremes, so one call reads correctly in a dark theme and a light one:
"toward the text color" is lighter on dark and darker on light.
""", params: {t: "The theme record.", c: "The color to shift.",
  amt: "How far, from -1 (all the way to `t.bg`) to 1 (all the way to `t.text`)."},
  example: "let raised = bloom.tone(t, t.panel, 0.06)")
pub fn tone(t: record, c: record, amt: num)
  let a = float(amt)
  if a >= 0.0 then
    mix(c, t.text, clamp(a, 0.0, 1.0))
  else
    mix(c, t.bg, clamp(-a, 0.0, 1.0))

@doc("""
The readable ink for text sitting on the fill `c`: a light or a dark text
color, whichever contrasts with it. The facade exports it as `ink_on`.
""", params: {t: "The theme record.", c: "The fill the text sits on."})
pub fn on(t: record, c: record)
  contrast_text(c)

@doc("""
The fill for a named variant. Components take `variant` rather than a color
so a whole UI restyles from the theme.
""", params: {t: "The theme record.",
  name: """`"primary"`, `"danger"`, `"success"` or `"warn"`; any other name is the plain `t.panel`."""},
  see: ["variant_ink", "variant_solid"])
pub fn variant_fill(t: record, name: string)
  match name
    when "primary" -> t.accent
    when "danger" -> t.danger
    when "success" -> t.success
    when "warn" -> t.warn
    when _ -> t.panel

@doc("""
The text and icon color for a named variant: the contrasting ink on the
solid variants, `t.muted` for `"quiet"` and `t.text` otherwise.
""", params: {t: "The theme record.", name: "The variant name, as `variant_fill` takes it."},
  see: ["variant_fill"])
pub fn variant_ink(t: record, name: string)
  match name
    when "primary" -> contrast_text(t.accent)
    when "danger" -> contrast_text(t.danger)
    when "success" -> contrast_text(t.success)
    when "warn" -> contrast_text(t.warn)
    when "quiet" -> t.muted
    when _ -> t.text

@doc("""
Whether a variant paints a filled face (and so must not also draw a border):
true for `"primary"`, `"danger"`, `"success"` and `"warn"`.
""", see: ["variant_fill"])
pub fn variant_solid(name: string)
  name == "primary" || name == "danger" || name == "success" || name == "warn"

# ── Text ──────────────────────────────────────────────────────────────────

@doc("""
The text style record a component measures *and* draws with: one record for
`text_width` and `draw_text`. Mixing a bare `draw_text(s, pos, size, color)`
with `text_width(s, size)` measures a different face than it paints, and
every centered label lands off. The font is the theme's `font`, or `"ui"`.
""", params: {t: "The theme record.", size: "Text size in px.", color: "Text color."},
  example: """bloom.text_in("Save", r, bloom.ts(t, 13, t.text), "center")""",
  see: ["ts_a", "ts_bold", "text_in"])
pub fn ts(t: record, size: num, color: record) -> record
  {size: size, font: field(t, "font", "ui"), color: color}

@doc("""
`ts`, translucent. Alpha rides on the *color* record for styled text: there
is no `draw_text(s, pos, style, a)` overload, because the style is where the
host looks for it.
""", params: {t: "The theme record.", size: "Text size in px.", color: "Text color.",
  a: "Alpha, 0 to 255."}, see: ["ts"])
pub fn ts_a(t: record, size: num, color: record, a: num) -> record
  {size: size, font: field(t, "font", "ui"), color: {r: color.r, g: color.g, b: color.b, a: int(clamp(float(a), 0.0, 255.0))}}

@doc("`ts` at weight 700.", params: {t: "The theme record.", size: "Text size in px.", color: "Text color."}, see: ["ts"])
pub fn ts_bold(t: record, size: num, color: record) -> record
  {size: size, font: field(t, "font", "ui"), color: color, weight: 700}

@doc("""
Draw one line of text inside `r`, aligned, and vertically centered, which is
what every control wants.

"Vertically centered" means the *cap height* is centered, not the line box.
The difference is the whole reason this goes through text_layout rather than
the `r.y + (r.h - size) / 2` it used to compute: a run's ink does not start
at `y` and is not `size` px tall, so that arithmetic put every label in
bloom a pixel high at 14 px and three high at 32 — consistently enough that
it read as a style rather than as a bug.
""", params: {s: "The text.", r: "The box.", style: "A text style record (`ts`).",
  align: """`"left"` (the default), `"center"` or `"right"`."""},
  returns: "The run's width, for a caller flowing something after it.",
  example: """let w = bloom.text_in("Name", row, bloom.ts(t, 13, t.muted))""",
  see: ["text_block_in", "text_cut"])
pub fn text_in(s: string, r: record, style: record, align: string)
  draw_text_line(s, r, style, align)

pub fn text_in(s: string, r: record, style: record)
  draw_text_line(s, r, style, "left")

@doc("""
Draw text that may be more than one line: wrapped to `r`, and cut with an
ellipsis if it still does not fit. Without `opts` the block is centered
vertically.
""", params: {s: "The text.", r: "The box.", style: "A text style record (`ts`)."},
  options: {lines: "Cap on the line count.", lead: "Extra leading between lines.",
    align: """`"left"`, `"center"` or `"right"`.""", valign: """`"top"`, `"middle"` or `"bottom"`."""},
  returns: "`text_layout`'s layout record, whose `h` sizes a panel to its text.",
  see: ["text_in", "text_layout.draw_text_block"])
pub fn text_block_in(s: string, r: record, style: record, opts: record)
  draw_text_block(s, r, style, opts)

pub fn text_block_in(s: string, r: record, style: record)
  draw_text_block(s, r, style, {valign: "middle"})

@doc("""
`s` cut to fit `w` px in `style`, with a trailing "…": what a menu label, a
list row or a tab does with a name longer than its box. Text that fits comes
back unchanged.
""", params: {s: "The text.", style: "A text style record (`ts`).", w: "The width available, in px."})
pub fn text_cut(s: string, style: record, w: num)
  elide(s, style, w)

@doc("""
The size `s` takes when wrapped in a box `w` px wide: for a component that
sizes itself to its text (a tooltip, a toast, a popover).
""", params: {s: "The text.", style: "A text style record (`ts`).", w: "The wrap width, in px."},
  returns: """`{w, h}`.""")
pub fn text_extent(s: string, style: record, w: num)
  text_size(s, style, w)

# ── Surfaces ──────────────────────────────────────────────────────────────

@doc("""
Paint a raised panel: shadow, face, hairline border.
""", params: {t: "The theme record.", r: "The panel.", radius: "Corner radius.",
  level: "The elevation, 1 to 3, picking the theme's `elevation_<n>` shadow; 0 draws no shadow."},
  example: "bloom.surface(t, card_r, t.radius_lg, 2)")
pub fn surface(t: record, r: record, radius: num, level: num)
  if level > 0 then
    let e = field(t, "elevation_" ++ str(min(level, 3)), {blur: 8, spread: 0, dy: 2, a: 48})
    draw_shadow(r, {radius: radius, blur: field(e, "blur", 8), spread: field(e, "spread", 0),
      dx: 0, dy: field(e, "dy", 2), color: :000000, a: field(e, "a", 48)})
  draw_rect_rounded(r, radius, t.panel)
  stroke(t, r, radius, hair(t))

@doc("""
The hairline color a surface draws against its own background: the theme's
text color mixed into `t.panel` at `border_pct`.
""")
pub fn hair(t: record)
  over(t.panel, t.text, field(t, "border_pct", 14) * 255 / 100)

@doc("""
Paint a rounded outline. There is no rounded-outline primitive, so this
paints the ring as a rounded rect with the face punched back out of it in
`inner`, the reason `width` is whole pixels. Over anything but a plain
`inner` fill, draw the outline first and the content after.
""", params: {t: "The theme record.", r: "The outline's outer edge.", radius: "Corner radius; 0 or less draws a square outline.",
  color: "The outline color.", width: "Thickness in whole px (1).", inner: "The face color punched back in (`t.panel`)."})
pub fn stroke(t: record, r: record, radius: num, color: record)
  stroke(t, r, radius, color, 1, t.panel)

pub fn stroke(t: record, r: record, radius: num, color: record, width: num, inner: record)
  if radius <= 0 then
    draw_rect_outline(r, color, 255, width)
  else
    draw_rect_rounded(r, radius, color)
    draw_rect_rounded(pad(r, width), max(0, radius - width), inner)

@doc("""
The interaction wash over a surface, composited (never translucent): two
translucent fills over one pixel do not add up to the color the design says.
""", params: {t: "The theme record.", base: "The surface color under the wash.",
  hot: "The hover amount, 0 to 1 (a probe's `hot`).", active: "The press amount, 0 to 1."},
  returns: "The composited color to fill with.",
  example: "draw_rect_rounded(r, t.radius, bloom.wash(t, t.panel, p.hot, press))",
  see: ["bloom/interact"])
pub fn wash(t: record, base: record, hot: num, active: num)
  let h = float(field(t, "hover_pct", 8)) / 100.0
  let p = float(field(t, "press_pct", 14)) / 100.0
  mix(base, t.text, h * float(hot) + p * float(active))

@doc("""
Paint the focus ring: the accent bloomed *outside* the control, so focus
never changes a control's size or doubles its border. Paint the control's
face after it; the ring repaints `r` in `t.panel`.
""", params: {t: "The theme record.", r: "The control.", radius: "The control's corner radius.",
  amount: "How much of the ring, 0 to 1 (an eased focus flag); below 0.005 nothing is drawn."})
pub fn focus_ring(t: record, r: record, radius: num, amount: num)
  let a = clamp(float(amount), 0.0, 1.0)
  if a > 0.005 then
    let grow = 3.0 * a
    let ring = Rect(r.x - grow, r.y - grow, r.w + grow * 2.0, r.h + grow * 2.0)
    draw_rect_rounded(ring, radius + grow, t.accent, int(field(t, "ring_pct", 55) * 255 / 100 * a))
    draw_rect_rounded(r, radius, t.panel)

@doc("""
Paint a hairline divider across the middle of `r`, in the `hair` color.
""", params: {t: "The theme record.", r: "The band the line is centered in.",
  axis: """`"y"` for a vertical line; anything else is horizontal."""})
pub fn divider(t: record, r: record, axis: string)
  let c = hair(t)
  if axis == "y" then
    let x = r.x + r.w / 2
    draw_line({x: x, y: r.y}, {x: x, y: r.y + r.h}, c)
  else
    let y = r.y + r.h / 2
    draw_line({x: r.x, y: y}, {x: r.x + r.w, y: y}, c)
