// Closures and Higher-Order Functions
// Functions that capture their environment and accept functions as arguments.

// A closure: `adder` captures `n` from the call that made it.
fn make_adder(n: num) -> function
  fn adder(x)
    x + n
  end
  adder
end

let add5 = make_adder(5)
let add10 = make_adder(10)
print("add5(3) =", add5(3))
print("add10(3) =", add10(3))

// Lambda (anonymous function)
let double = fn(x) -> x * 2
print("double(7) =", double(7))

// Apply a function to each element (written out here; the builtin `map`
// does the same)
fn my_map(list: list, f: function) -> list
  let result = []
  for item in list do
    result = append(result, f(item))
  end
  result
end

let numbers = [1, 2, 3, 4, 5]
let doubled = my_map(numbers, fn(x) -> x * 2)
let squared = my_map(numbers, fn(x) -> x * x)
print("numbers:", numbers)
print("doubled:", doubled)
print("squared:", squared)

// Filter
fn my_filter(list: list, pred: function) -> list
  let result = []
  for item in list do
    if pred(item) then
      result = append(result, item)
    end
  end
  result
end

let evens = my_filter(numbers, fn(x) -> x % 2 == 0)
print("evens:", evens)

// Reduce
fn my_reduce(list: list, init, f: function)
  let acc = init
  for item in list do
    acc = f(acc, item)
  end
  acc
end

let sum = my_reduce(numbers, 0, fn(a, b) -> a + b)
let product = my_reduce(numbers, 1, fn(a, b) -> a * b)
print("sum:", sum)
print("product:", product)
