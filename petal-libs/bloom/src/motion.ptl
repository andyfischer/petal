// bloom/motion — the animation core of the bloom component library.
//
// Every value here is *per callsite*: the `state` inside these functions is
// keyed by the call path, so a component that calls `ease_flag(hover, 18)`
// gets its own animator per instance with nothing to plumb through the app.
// That is the whole trick behind bloom's components animating by default —
// there are no animation state records, no ids, and no registration.
//
// A call in a loop gets one animator per iteration, so a list of buttons
// animates independently. The corollary: animators follow the *position*, so
// reordering a list makes item 3's motion state stay with slot 3.
//
// Almost everything here integrates `dt()`, the host's frame delta, which the
// headless harness pins — so a bloom UI settles identically in a trace and on
// screen. The two exceptions are `wave` and `pulse`, which read the wall clock
// `time()` so that every callsite sharing a period stays in phase; a headless
// run holds that clock still, and they hold their value with it.

// The frame delta, clamped. A pause, a breakpoint or a slow first frame
// otherwise arrives as one enormous `dt` that flings every spring across the
// screen; capping it at ~3 frames turns a hitch into a slightly slow frame.
export fn step()
  min(dt(), 0.05)
end

// ── Easing curves ─────────────────────────────────────────────────────────
// `t` is clamped to [0, 1] in every one of these, so a caller may hand over a
// raw progress value that has overshot without checking it first.

fn _t(t)
  clamp(float(t), 0.0, 1.0)
end

export fn ease_out(t)
  let c = _t(t)
  1.0 - pow(1.0 - c, 3.0)
end

export fn ease_in(t)
  let c = _t(t)
  c * c * c
end

export fn ease_in_out(t)
  let c = _t(t)
  if c < 0.5 then
    4.0 * c * c * c
  else
    1.0 - pow(-2.0 * c + 2.0, 3.0) / 2.0
  end
end

// Overshoots past 1 and settles back: the "pop" a menu or a dialog opens with.
export fn ease_back(t)
  let c = _t(t)
  let s = 1.70158
  let u = c - 1.0
  1.0 + (s + 1.0) * u * u * u + s * u * u
end

// A decaying wobble. Louder than `ease_back` — for a control that wants to be
// noticed once (a toast landing), not for anything that fires on every hover.
export fn ease_elastic(t)
  let c = _t(t)
  if c <= 0.0 then
    0.0
  else
    if c >= 1.0 then
      1.0
    else
      let p = 0.3
      pow(2.0, -10.0 * c) * sin((c - p / 4.0) * (2.0 * pi()) / p) + 1.0
    end
  end
end

// ── Animated values ───────────────────────────────────────────────────────

// Exponential approach toward `target` at `rate` (1/seconds; ~18 lands in
// about 110 ms). The first frame *snaps*, so a component does not fade in from
// zero when it first appears, and a hot reload does not replay every
// transition.
export fn ease_to(target, rate)
  state v = 0.0
  state seen = 0
  if seen == 0 then
    v = float(target)
    seen = 1
  else
    let k = 1.0 - pow(2.718281828459045, -float(rate) * step())
    v = v + (float(target) - v) * k
    if abs(float(target) - v) < 0.001 then
      v = float(target)
    end
  end
  v
end

export fn ease_to(target)
  ease_to(target, 18.0)
end

// 0 → 1 as `on` flips. The hover/press/open primitive every component uses.
export fn ease_flag(on, rate)
  ease_to(if on then 1.0 else 0.0 end, rate)
end

export fn ease_flag(on)
  ease_flag(on, 18.0)
end

// A real second-order spring: overshoots, oscillates, settles. Use it where
// motion should feel physical (a knob being flicked, a thumb sliding across a
// segmented control) and `ease_to` where it should feel calm.
//
// `cfg` overrides {stiffness, damping, velocity}. The defaults are a snappy,
// barely-overshooting spring.
export fn spring(target, cfg)
  let k = float(field(cfg, "stiffness", 170.0))
  let d = float(field(cfg, "damping", 20.0))
  state x = 0.0
  state v = 0.0
  state seen = 0
  if seen == 0 then
    x = float(target)
    v = float(field(cfg, "velocity", 0.0))
    seen = 1
  else
    // Two half-steps: one 60 fps step of a stiff spring is close enough to the
    // stability limit that a dropped frame would ring.
    let h = step() / 2.0
    for _i in range(0, 2) do
      let a = (float(target) - x) * k - v * d
      v = v + a * h
      x = x + v * h
    end
    if abs(float(target) - x) < 0.0005 && abs(v) < 0.01 then
      x = float(target)
      v = 0.0
    end
  end
  x
end

export fn spring(target)
  spring(target, {})
end

// Linear 0 → 1 progress that advances while `on` and rewinds while not, over
// `dur` seconds. Unlike `ease_flag` this reaches its ends exactly and takes a
// known time, which is what a staged entrance (fade, then slide, then content)
// needs. Apply a curve to the result: `ease_out(enter(open, 0.18))`.
export fn enter(on, dur)
  state p = 0.0
  state seen = 0
  if seen == 0 then
    p = if on then 1.0 else 0.0 end
    seen = 1
  else
    let d = max(float(dur), 0.001)
    p = clamp(p + (if on then step() / d else -step() / d end), 0.0, 1.0)
  end
  p
end

// An impulse that decays: 1.0 on the frame `trigger` goes true, then falls to
// 0 over `dur`. The building block for one-shot feedback — a ripple, a shake,
// a flash — where the trigger is an event and the animation outlives it.
export fn impulse(trigger, dur)
  state v = 0.0
  state was = false
  if trigger && !was then
    v = 1.0
  else
    v = max(0.0, v - step() / max(float(dur), 0.001))
  end
  was = trigger
  v
end

export fn impulse(trigger)
  impulse(trigger, 0.45)
end

// A damped horizontal shake in pixels, for rejecting input. Feed it the frame
// an error happens on.
export fn shake(trigger, amount)
  let e = impulse(trigger, 0.4)
  sin(time() * 46.0) * float(amount) * e * e
end

// ── Clock-driven motion ───────────────────────────────────────────────────
// These read `time()` rather than integrating, so they never drift and every
// callsite with the same period stays in phase (a row of pulsing dots reads as
// one object).

export fn wave(period)
  sin(time() * 2.0 * pi() / max(float(period), 0.001))
end

// 0 → 1 → 0, smoothly. The breathing highlight on a recording indicator.
export fn pulse(period)
  (wave(period) + 1.0) / 2.0
end

// Seconds since this callsite first ran. One timer per instance, started when
// the instance appears — so an item that enters a list later animates in on
// its own schedule.
//
// It sums `step()` rather than subtracting two `time()` readings, because a
// headless run pins the clock while still advancing `dt` — a `time()`-based
// age would sit at zero for the whole trace and no entrance animation would
// ever be testable.
export fn age()
  state t = 0.0
  state seen = 0
  if seen == 0 then
    seen = 1
  else
    t = t + step()
  end
  t
end

// Progress through a `dur`-second entrance that begins `i * step_s` seconds
// after this callsite appeared: the stagger a list uses to cascade in.
export fn stagger(i, step_s, dur)
  let a = age() - float(i) * float(step_s)
  clamp(a / max(float(dur), 0.001), 0.0, 1.0)
end

// ── Interpolation ─────────────────────────────────────────────────────────

export fn lerp_rect(a, b, t)
  let c = _t(t)
  Rect(a.x + (b.x - a.x) * c, a.y + (b.y - a.y) * c,
    a.w + (b.w - a.w) * c, a.h + (b.h - a.h) * c)
end

// A rect scaled about its own center — the press squash and the dialog pop.
export fn scale_rect(r, s)
  let w = r.w * float(s)
  let h = r.h * float(s)
  Rect(r.x + (r.w - w) / 2.0, r.y + (r.h - h) / 2.0, w, h)
end

export fn offset_rect(r, dx, dy)
  Rect(r.x + dx, r.y + dy, r.w, r.h)
end
