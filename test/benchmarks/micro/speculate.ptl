// Micro-benchmark: `speculate(f)` against a plain call of the same `f`.
// `view` is a small immediate-mode view: it reads state, keeps a slot of its
// own, writes a cell and records a place per card. `plain` calls it, `spec`
// speculates it, 200 times each, so the difference per call is the cost of
// the overlay (entering, logging the writes, putting them back, taking the
// places out).
//
//   petal bench --fn plain --fn spec test/benchmarks/micro/speculate.ptl
//
// Numbers are in docs/features/speculate.md (Performance).

var hits = 0

fn view(cards)
  state renders = 0
  renders += 1
  set hits += 1
  for i in range(0, len(cards)) do
    speculate_place(cards[i], {x: 40 + i * 70, y: 100, w: 60, h: 60})
  end
  renders
end

fn plain(cards)
  view(cards)
end

fn spec(cards)
  speculate(view, cards).value
end

let cards = range(0, 10)
var total = 0
for i in range(0, 200) do
  set total += plain(cards)
  set total += spec(cards)
end
get total
