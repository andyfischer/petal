# A small library module — see imports.ptl for a script that imports it.
# A top-level fn / let / state is exported only when marked `pub`;
# everything else (including _underscore names) is module-private.

pub let ellipsis = "..."

fn _cut(s: string, n: num) -> string
  slice(s, start: 0, end: n)

pub fn truncate(s: string, max: num) -> string
  if len(s) > max then
    _cut(s, max) ++ ellipsis
  else
    s

pub fn shout(s: string) -> string
  s ++ "!"

# Tests live beside the code they test. `petal test examples/console` runs
# them; `petal run` and a script that imports this module never do.
test "truncate leaves a short string alone" do
  expect_eq(truncate("hello", 10), "hello")
  expect_eq(truncate("hello", 5), "hello")

test "truncate cuts a long string and marks the cut" do
  expect_eq(truncate("hello world", 5), "hello...")
  # The private helper is in reach here, though not to an importer.
  expect_eq(_cut("hello world", 3), "hel")

test "shout" do
  expect_eq(shout("hi"), "hi!")
