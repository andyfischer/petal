{
  "name": "@petal/ts",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript code for Petal: dev wrapper and integration tests.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test-examples": "tsx bin/test-examples.ts",
    "scan-secrets": "tsx bin/scan-secrets.ts",
    "petal": "tsx bin/run-petal.ts",
    "stdlib:json": "tsx ../tools/extract-stdlib.ts",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "4.19.4",
    "typescript": "^5.4.0",
    "vitest": "3.1.4"
  }
}
