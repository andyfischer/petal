// === Petal FPS — camera, projection, one cube on a floor. ===
//
// The core pipeline with nothing else in the way:
//  - Input (mouse look, WASD) updates camera state
//  - Petal does world → camera → screen projection
//  - Rust rasterizes z-buffered triangles
//
// `fps_game.ptl` is the same pipeline with a city, enemies and a HUD on top.
//
// Controls: mouse looks, WASD moves, Esc releases the mouse grab.

// ---------- persistent state ----------
state player_x = 0.0
state player_y = 1.7
state player_z = -8.0
state yaw = 0.0          // rotation around Y axis (left/right look)
state pitch = 0.0        // rotation around X axis (up/down look)
state want_grab = false

// ---------- frame constants ----------
let delta = dt()
let sw = float(screen_width())
let sh = float(screen_height())
let cx = sw / 2.0
let cy = sh / 2.0

let fov_deg = 70.0
let fov = fov_deg * pi() / 180.0
let focal = cy / tan(fov / 2.0)
let near = 0.2

// ---------- mouse grab on first frame ----------
if !want_grab then
  grab_mouse()
  want_grab = true
end

// ---------- input: mouse look ----------
let look_sens = 0.0022
yaw = yaw + float(mouse_dx()) * look_sens
pitch = pitch - float(mouse_dy()) * look_sens
if pitch > 1.4 then pitch = 1.4 end
if pitch < -1.4 then pitch = -1.4 end

// ---------- input: WASD movement in XZ plane ----------
let move_speed = 6.0
let fwd_x = sin(yaw)
let fwd_z = cos(yaw)
let right_x = cos(yaw)
let right_z = 0.0 - sin(yaw)

let mx = 0.0
let mz = 0.0
if key_down("w") then mx = mx + fwd_x; mz = mz + fwd_z end
if key_down("s") then mx = mx - fwd_x; mz = mz - fwd_z end
if key_down("d") then mx = mx + right_x; mz = mz + right_z end
if key_down("a") then mx = mx - right_x; mz = mz - right_z end
let mag_m = sqrt(mx * mx + mz * mz)
if mag_m > 0.01 then
  player_x = player_x + (mx / mag_m) * move_speed * delta
  player_z = player_z + (mz / mag_m) * move_speed * delta
end

// ---------- rendering constants ----------
let cos_y = cos(0.0 - yaw)
let sin_y = sin(0.0 - yaw)
let cos_p = cos(0.0 - pitch)
let sin_p = sin(0.0 - pitch)

// Transform a world-space point to screen space. Returns a record:
//   {sx, sy, z, ok}  — ok=false means behind the near plane.
fn project(x: num, y: num, z: num) -> record
  let dx = x - player_x
  let dy = y - player_y
  let dz = z - player_z
  // rotate by -yaw around Y: (dx, dz) -> (rx, rz)
  let rx = dx * cos_y + dz * sin_y
  let rz = 0.0 - dx * sin_y + dz * cos_y
  // rotate by -pitch around X: (dy, rz) -> (ry, rz2)
  let ry = dy * cos_p - rz * sin_p
  let rz2 = dy * sin_p + rz * cos_p
  if rz2 < near then
    {sx: 0.0, sy: 0.0, z: rz2, ok: false}
  else
    {
      sx: cx + rx / rz2 * focal,
      sy: cy - ry / rz2 * focal,
      z: rz2,
      ok: true
    }
  end
end

// Submit a world-space triangle. If any vertex is behind near, skip.
fn tri(x1: num, y1: num, z1: num,
  x2: num, y2: num, z2: num,
  x3: num, y3: num, z3: num,
  r: num, g: num, b: num)
  let p1 = project(x: x1, y: y1, z: z1)
  let p2 = project(x: x2, y: y2, z: z2)
  let p3 = project(x: x3, y: y3, z: z3)
  if p1.ok && p2.ok && p3.ok then
    triangle3d(
      p1.sx, p1.sy, p1.z,
      p2.sx, p2.sy, p2.z,
      p3.sx, p3.sy, p3.z,
      r, g, b)
  end
end

// Submit a world-space axis-aligned quad (4 corners, 2 triangles).
fn quad(ax: num, ay: num, az: num,
  bx: num, by: num, bz: num,
  cx_: num, cy_: num, cz: num,
  dx: num, dy_: num, dz: num,
  r: num, g: num, b: num)
  tri(x1: ax, y1: ay, z1: az, x2: bx, y2: by, z2: bz, x3: cx_, y3: cy_, z3: cz, r: r, g: g, b: b)
  tri(x1: ax, y1: ay, z1: az, x2: cx_, y2: cy_, z2: cz, x3: dx, y3: dy_, z3: dz, r: r, g: g, b: b)
end

// Submit an axis-aligned box (cube). x,y,z is the center; w,h,d are extents.
fn box_(x: num, y: num, z: num, w: num, h: num, d: num, r: num, g: num, b: num)
  let hw = w / 2.0
  let hh = h / 2.0
  let hd = d / 2.0
  let x0 = x - hw; let x1 = x + hw
  let y0 = y - hh; let y1 = y + hh
  let z0 = z - hd; let z1 = z + hd
  // Each face gets a fixed tint, which fakes directional light.
  // +Z face (front)
  quad(ax: x0, ay: y0, az: z1,  bx: x1, by: y0, bz: z1,  cx_: x1, cy_: y1, cz: z1,  dx: x0, dy_: y1, dz: z1,  r: r, g: g, b: b)
  // -Z face (back)
  quad(ax: x1, ay: y0, az: z0,  bx: x0, by: y0, bz: z0,  cx_: x0, cy_: y1, cz: z0,  dx: x1, dy_: y1, dz: z0,
    r: int(float(r) * 0.55), g: int(float(g) * 0.55), b: int(float(b) * 0.55))
  // +X face (right)
  quad(ax: x1, ay: y0, az: z1,  bx: x1, by: y0, bz: z0,  cx_: x1, cy_: y1, cz: z0,  dx: x1, dy_: y1, dz: z1,
    r: int(float(r) * 0.8), g: int(float(g) * 0.8), b: int(float(b) * 0.8))
  // -X face (left)
  quad(ax: x0, ay: y0, az: z0,  bx: x0, by: y0, bz: z1,  cx_: x0, cy_: y1, cz: z1,  dx: x0, dy_: y1, dz: z0,
    r: int(float(r) * 0.65), g: int(float(g) * 0.65), b: int(float(b) * 0.65))
  // +Y face (top)
  quad(ax: x0, ay: y1, az: z1,  bx: x1, by: y1, bz: z1,  cx_: x1, cy_: y1, cz: z0,  dx: x0, dy_: y1, dz: z0,
    r: int(min(255.0, float(r) * 1.15)),
    g: int(min(255.0, float(g) * 1.15)),
    b: int(min(255.0, float(b) * 1.15)))
end

// ---------- draw: cyberpunk sky + ground + one neon cube ----------
sky_gradient(40, 8, 90, 240, 70, 150)

// Ground: a large quad at y=0, subdivided into a few strips for visibility.
let ground_color_r = 25
let ground_color_g = 15
let ground_color_b = 45

let ground_half = 30.0
let grid = 0
while grid < 10 do
  let z0 = float(grid) * 6.0 - ground_half
  let z1 = z0 + 6.0
  // alternating bands for visual depth
  let shade = 20 + (grid % 2) * 15
  quad(ax: 0.0 - ground_half, ay: 0.0, az: z0,
    bx: ground_half, by: 0.0, bz: z0,
    cx_: ground_half, cy_: 0.0, cz: z1,
    dx: 0.0 - ground_half, dy_: 0.0, dz: z1,
    r: shade, g: shade / 2, b: shade + 20)
  grid = grid + 1
end

// One neon box in front of spawn.
box_(x: 0.0, y: 1.5, z: 0.0, w: 3.0, h: 3.0, d: 3.0, r: 200, g: 40, b: 180)

// ---------- HUD ----------
// Crosshair
let cxh = int(cx)
let cyh = int(cy)
rect2d(cxh - 1, cyh - 8, 2, 6, 200, 255, 220)
rect2d(cxh - 1, cyh + 2, 2, 6, 200, 255, 220)
rect2d(cxh - 8, cyh - 1, 6, 2, 200, 255, 220)
rect2d(cxh + 2, cyh - 1, 6, 2, 200, 255, 220)

// Debug pos
text2d("POS " ++ str(int(player_x)) ++ " " ++ str(int(player_y)) ++ " " ++ str(int(player_z)),
  10, 10, 2, 180, 255, 220)
text2d("YAW " ++ str(int(yaw * 57.3)) ++ " PIT " ++ str(int(pitch * 57.3)),
  10, 30, 2, 180, 255, 220)
text2d("FRAME " ++ str(frame_count()),
  10, 50, 2, 140, 200, 180)
