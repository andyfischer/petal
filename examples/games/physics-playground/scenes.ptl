// ─────────────────────────────────────────────────────────────────────────
//  scenes.ptl — the six seeded stages of the Physics playground.
//
//  `build(k, W, H)` returns a ready world for a W x H stage together with
//  the material settings that suit it, so each scene opens looking right:
//
//    {world, bounce, fric, drag, trails, emit}
//
//  `emit` is a ball dispenser, {x, y, every, left, r}; `left` is 0 for the
//  scenes that have none. Colour indices: 0 coral, 1 amber, 2 mint, 3 sky,
//  4 violet, 5 rose, 6 steel (fixtures).
// ─────────────────────────────────────────────────────────────────────────

import physics as ph

export let NAMES = ["Cradle", "Bridge", "Pegboard", "Wrecker", "Jelly", "Sandbox"]

export let BLURBS = [
  "Five bobs on rods and a double pendulum. Lift one and let go.",
  "A chain of rods between two pins, sprung weights below, loads above.",
  "Fifty-six balls rattle down nine rows of pegs into ten bins.",
  "A dense ball on a chain meets a chocked pyramid.",
  "Spring-laced wheels and a rigid truss tumble down two ramps.",
  "An empty stage. Launch balls, join them, pin them, cut them loose.",
]

let NO_EMIT = {x: 0.0, y: 0.0, every: 1.0, left: 0, r: 7.0}

fn rod(wd: record, a: int, b: int) -> record
  ph.add_link(wd, a, b, ph.ROD, 0.0, -1.0)
end

fn spring(wd: record, a: int, b: int, hz: num) -> record
  ph.add_link(wd, a, b, ph.SPRING, hz, -1.0)
end

// A soft wheel: a hub and `k` rim discs, laced with springs round the rim,
// across every second disc, and in to the hub.
fn wheel(wd: record, cx: num, cy: num, rad: num, k: int, node_r: num, c: int) -> record
  let hub = wd.n
  let out = ph.add_ball(wd, cx, cy, 13, c)
  for i in range(0, k) do
    let a = 6.2832 * float(i) / float(k)
    out = ph.add_ball(out, cx + cos(a) * rad, cy + sin(a) * rad, node_r, c)
  end
  for i in range(0, k) do
    let a = hub + 1 + i
    let b = hub + 1 + (i + 1) % k
    let c2 = hub + 1 + (i + 2) % k
    out = spring(out, a, b, 11.0)
    out = spring(out, a, c2, 9.0)
    out = spring(out, hub, a, 8.0)
  end
  out
end

fn cradle(W: num, H: num) -> record
  let wd = ph.empty_world()
  let top = H * 0.13
  let drop = H * 0.50
  let r = 24.0
  let gap = r * 2.0 + 0.5
  let x0 = W * 0.40 - gap * 2.0
  wd = ph.add_seg(wd, x0 - 34.0, top - 9.0, x0 + gap * 4.0 + 34.0, top - 9.0)
  for i in range(0, 5) do
    wd = ph.add_pin(wd, x0 + gap * float(i), top, 4, 6)
  end
  for i in range(0, 5) do
    // The first bob starts lifted 41 degrees, ready to fall.
    let a = if i == 0 then 0.72 else 0.0 end
    wd = ph.add_ball(wd, x0 + gap * float(i) - sin(a) * drop, top + cos(a) * drop, r, i)
    wd = ph.add_link(wd, i, 5 + i, ph.ROD, 0.0, drop)
  end
  // The double pendulum, started high so it goes chaotic at once. It hangs
  // in the corner the bobs never reach.
  let px = W * 0.80
  let py = H * 0.22
  let p0 = wd.n
  wd = ph.add_pin(wd, px, py, 5, 6)
  wd = ph.add_ball(wd, px + 56.0, py - 20.0, 12, 5)
  wd = ph.add_ball(wd, px + 92.0, py - 62.0, 15, 4)
  wd = rod(wd, p0, p0 + 1)
  wd = rod(wd, p0 + 1, p0 + 2)
  {world: wd, bounce: 1.0, fric: 0.05, drag: 0.0, trails: true, emit: NO_EMIT}
end

fn bridge(W: num, H: num) -> record
  let wd = ph.empty_world()
  let y0 = H * 0.50
  let xl = W * 0.09
  let xr = W * 0.91
  let planks = 19
  let dx = (xr - xl) / float(planks)
  wd = ph.add_pin(wd, xl, y0, 7, 6)
  for i in range(1, planks) do
    wd = ph.add_body(wd, xl + dx * float(i), y0, 8, 1, false, 5.0, 0.0, 0.0)
  end
  wd = ph.add_pin(wd, xr, y0, 7, 6)
  for i in range(0, planks) do
    // A little slack in every plank, so the deck hangs in a curve.
    wd = ph.add_link(wd, i, i + 1, ph.ROD, 0.0, dx * 1.012)
  end
  // Two weights slung under the deck on springs.
  let wa = wd.n
  wd = ph.add_ball(wd, xl + dx * 6.0, y0 + 96.0, 15, 2)
  wd = ph.add_ball(wd, xl + dx * 13.0, y0 + 130.0, 19, 2)
  wd = ph.add_link(wd, 6, wa, ph.SPRING, 2.4, 80.0)
  wd = ph.add_link(wd, 13, wa + 1, ph.SPRING, 2.0, 104.0)
  // Three loads on their way down.
  wd = ph.add_body(wd, W * 0.30, H * 0.16, 26, 0, false, 0.7, 0.0, 0.0)
  wd = ph.add_ball(wd, W * 0.53, H * 0.07, 18, 3)
  wd = ph.add_body(wd, W * 0.70, H * 0.20, 32, 4, false, 0.7, 0.0, 0.0)
  {world: wd, bounce: 0.25, fric: 0.5, drag: 0.02, trails: false, emit: NO_EMIT}
end

// The pegboard's proportions, shared with whoever counts the bins.
let G_SP   = 44.0      // peg pitch, and bin width
let G_DY   = 30.0      // row pitch
let G_ROWS = 9
let G_TOP  = 0.20      // first row, as a fraction of the stage height

fn pegboard(W: num, H: num) -> record
  let wd = ph.empty_world()
  let cx = W * 0.5
  let top = H * G_TOP
  // A staggered lattice between two walls: eleven pegs, then ten. The end
  // pegs of the long rows stand against the walls, so there is no pocket
  // narrower than a ball anywhere on the board.
  for i in range(0, G_ROWS) do
    let short = i % 2 == 1
    for j in range(0, if short then 10 else 11 end) do
      let off = if short then float(j) - 4.5 else float(j) - 5.0 end
      wd = ph.add_pin(wd, cx + off * G_SP, top + G_DY * float(i), 5, 6)
    end
  end
  // Ten bins under the last row, closed at the sides by the walls.
  let bin_top = top + G_DY * float(G_ROWS) + 2.0
  let wall = 5.0 * G_SP + 8.0
  for j in range(1, 10) do
    wd = ph.add_seg(wd, cx + (float(j) - 5.0) * G_SP, bin_top, cx + (float(j) - 5.0) * G_SP, H + 4.0)
  end
  wd = ph.add_seg(wd, cx - wall, top - 70.0, cx - wall, H + 4.0)
  wd = ph.add_seg(wd, cx + wall, top - 70.0, cx + wall, H + 4.0)
  {world: wd, bounce: 0.1, fric: 0.1, drag: 0.5, trails: false,
    emit: {x: cx, y: top - 40.0, every: 0.25, left: 56, r: 8.0}}
end

// Where the pegboard's bins sit, for whoever wants to count what is in them.
export fn bin_layout(W: num, H: num) -> record
  {x0: W * 0.5 - 5.0 * G_SP, sp: G_SP, n: 10, bin_top: H * G_TOP + G_DY * float(G_ROWS) + 2.0}
end

fn wrecker(W: num, H: num) -> record
  let wd = ph.empty_world()
  let ax = W * 0.42
  let ay = H * 0.10
  let a = 2.86                       // the chain starts almost level, to the left
  let ux = cos(a)
  let uy = sin(a)
  let links = 9
  let step = 27.0
  wd = ph.add_pin(wd, ax, ay, 6, 6)
  for i in range(1, links + 1) do
    wd = ph.add_body(wd, ax + ux * step * float(i), ay + uy * step * float(i), 5, 6, false, 24.0, 0.0, 0.0)
    wd = rod(wd, i - 1, i)
  end
  let reach = step * float(links) + 39.0
  wd = ph.add_body(wd, ax + ux * reach, ay + uy * reach, 34, 0, false, 4.0, 0.0, 0.0)
  wd = rod(wd, links, links + 1)
  // The shelf, two chocks, and a 5-4-3-2-1 pyramid. The shelf stops short
  // of the wall, so whatever is knocked off it falls to the floor.
  let sy = H * 0.62
  let sx = W * 0.565
  wd = ph.add_seg(wd, sx, sy, W * 0.87, sy)
  let r = 15.0
  let pitch = r * 2.0 + 0.6
  let bx = sx + 62.0
  let by = sy - 3.0 - r
  wd = ph.add_pin(wd, bx - r - 4.6, by + 9.0, 5, 6)
  wd = ph.add_pin(wd, bx + pitch * 4.0 + r + 4.6, by + 9.0, 5, 6)
  for row in range(0, 5) do
    for k in range(0, 5 - row) do
      wd = ph.add_ball(wd, bx + pitch * (float(k) + float(row) * 0.5), by - float(row) * pitch * 0.868,
        r, 1 + (row + k) % 5)
    end
  end
  {world: wd, bounce: 0.3, fric: 0.5, drag: 0.02, trails: false, emit: NO_EMIT}
end

fn jelly(W: num, H: num) -> record
  let wd = ph.empty_world()
  wd = ph.add_seg(wd, W * 0.06, H * 0.40, W * 0.60, H * 0.54)
  wd = ph.add_seg(wd, W * 0.94, H * 0.66, W * 0.40, H * 0.82)
  wd = wheel(wd, W * 0.16, H * 0.16, 46.0, 10, 9.0, 2)
  wd = wheel(wd, W * 0.66, H * 0.30, 34.0, 8, 8.0, 5)
  // A rigid truss: four corners, four sides, two diagonals.
  let t = wd.n
  let tx = W * 0.38
  let ty = H * 0.12
  wd = ph.add_ball(wd, tx, ty, 10, 1)
  wd = ph.add_ball(wd, tx + 58.0, ty + 10.0, 10, 1)
  wd = ph.add_ball(wd, tx + 48.0, ty + 68.0, 10, 1)
  wd = ph.add_ball(wd, tx - 10.0, ty + 58.0, 10, 1)
  wd = rod(wd, t, t + 1)
  wd = rod(wd, t + 1, t + 2)
  wd = rod(wd, t + 2, t + 3)
  wd = rod(wd, t + 3, t)
  wd = rod(wd, t, t + 2)
  wd = rod(wd, t + 1, t + 3)
  // And a few loose balls to get in the way.
  wd = ph.add_ball(wd, W * 0.52, H * 0.40, 16, 3)
  wd = ph.add_ball(wd, W * 0.86, H * 0.52, 20, 4)
  wd = ph.add_ball(wd, W * 0.26, H * 0.90, 22, 0)
  {world: wd, bounce: 0.2, fric: 0.7, drag: 0.03, trails: false, emit: NO_EMIT}
end

export fn build(k: int, W: num, H: num) -> record
  if k == 0 then cradle(float(W), float(H))
  elsif k == 1 then bridge(float(W), float(H))
  elsif k == 2 then pegboard(float(W), float(H))
  elsif k == 3 then wrecker(float(W), float(H))
  elsif k == 4 then jelly(float(W), float(H))
  else
    {world: ph.empty_world(), bounce: 0.45, fric: 0.4, drag: 0.02, trails: false, emit: NO_EMIT}
  end
end
