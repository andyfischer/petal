// ── Tunables ─────────────────────────────────────────────────────────────

config let start_gold  = 230
config let start_lives = 20
config let sell_rate   = 0.7      // fraction of gold spent returned by a sale
config let dart_speed  = 11.0     // cells / second
config let chain_jump  = 1.7      // how far lightning leaps, in cells
config let chill_secs  = 1.8      // how long a Frostcap pulse lingers

