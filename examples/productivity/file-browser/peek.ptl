// Burrow: what a file looks like inside.
//
// There are no real files, so every preview is drawn from what the node does
// have: its kind, its name (hashed into a few stable numbers) and, for the
// files with text behind them, that text. `draw` fills a rect with the
// preview; the info pane calls it small and Quick Look calls it large. Image
// thumbnails in the icon grid are `picture` on its own.

import text_layout as tl
import icons as ic

fn frac(h: int, salt: int) -> float
  ((h / salt) % 1000) / 1000.0
end

// ── Pictures ────────────────────────────────────────────────────────────────

let SKIES = [
  [#f6b26b, #f9dcc4, #7d5a7a, #3d3554, #fff3d6],
  [#8ecae6, #dff3fb, #5a8f7b, #2f5d50, #ffffff],
  [#274060, #7b6d8d, #1b2a41, #0f1a2b, #f4e9cd],
  [#f28482, #f7ede2, #84a59d, #3d5a57, #fff1c1],
  [#bfd7ea, #eef4f8, #7a8fa6, #46566b, #ffffff],
  [#ffb4a2, #ffe5d9, #b5838d, #6d6875, #fff6e0],
  [#a8c686, #e9f2d0, #5b8c5a, #2e5339, #fffbe6],
  [#e9c46a, #f6e7b4, #c08552, #5e3023, #ffffff],
]

// A procedural photograph: a sky, a sun and two ridgelines, chosen by `h`.
fn landscape(h: int, r: record) -> nil
  let p = SKIES[(h / 11 + h / 1009) % len(SKIES)]
  draw_rect_gradient(r, p[0], p[1], pi() / 2.0)
  draw_circle({x: r.x + r.w * (0.18 + 0.64 * frac(h, 7)), y: r.y + r.h * (0.22 + 0.22 * frac(h, 13))},
    r.h * (0.07 + 0.05 * frac(h, 29)), p[4])
  for layer in range(0, 2) do
    let base = 0.62 + 0.16 * layer
    let amp = 0.16 - 0.05 * layer
    let ph = frac(h, 3 + layer * 17) * 6.28
    let k = 1.4 + 2.2 * frac(h, 41 + layer * 5)
    let pts = for i in range(0, 13) do
      let t = i / 12.0
      {x: r.x + r.w * t, y: r.y + r.h * (base - amp * (0.5 + 0.5 * sin(ph + t * k * 3.14)) * (0.6 + 0.4 * cos(ph * 2.0 + t * 5.0)))}
    end
    fill_polygon(pts ++ [{x: r.x + r.w, y: r.y + r.h}, {x: r.x, y: r.y + r.h}], p[2 + layer])
  end
end

// A screenshot: somebody's window.
fn screenshot(h: int, r: record) -> nil
  draw_rect(r, #dfe5ee)
  let win = Rect(r.x + r.w * 0.10, r.y + r.h * 0.14, r.w * 0.80, r.h * 0.74)
  draw_rect_rounded(win, max(1.5, r.w * 0.02), #ffffff)
  draw_rect_rounded(Rect(win.x, win.y, win.w, win.h * 0.14), max(1.5, r.w * 0.02), #eceff4)
  for i in range(0, 3) do
    draw_circle({x: win.x + win.w * (0.05 + 0.045 * i), y: win.y + win.h * 0.07}, max(1.0, win.w * 0.013),
      [#ed6a5e, #f4bf4f, #61c554][i])
  end
  draw_rect(Rect(win.x, win.y + win.h * 0.14, win.w * 0.26, win.h * 0.86), #f4f6f9)
  for i in range(0, 5) do
    let w = 0.30 + 0.34 * frac(h, 11 + i * 7)
    draw_rect(Rect(win.x + win.w * 0.32, win.y + win.h * (0.26 + 0.13 * i), win.w * w, max(1.0, win.h * 0.045)),
      if i == 0 then #5b8def else #cdd4df end)
  end
end

// A logo on a flat ground: two waves.
fn logo(h: int, r: record, name: string) -> nil
  let dark = contains(name, "dark") || h % 3 == 0
  let bg = if dark then #14201c else #e8dcc0 end
  let ink = if dark then #5fa8a0 else #1f4d3f end
  draw_rect(r, bg)
  for row in range(0, 2) do
    let pts = for i in range(0, 17) do
      let t = i / 16.0
      {x: r.x + r.w * (0.26 + 0.48 * t), y: r.y + r.h * (0.44 + 0.14 * row) + sin(t * 9.42 + row) * r.h * 0.045}
    end
    draw_polyline(pts, if row == 0 then ink else mix(ink, bg, 0.45) end, 255, max(1.5, r.h * 0.035))
  end
end

// The picture a file's name stands for, clipped to a rounded rect.
pub fn picture(name: string, h: int, r: record, radius: num) -> nil
  let low = lower(name)
  clip_push(r, radius)
  if starts_with(low, "screenshot") || starts_with(low, "scan") then
    screenshot(h, r)
  elsif contains(low, "logo") || contains(low, "wordmark") || contains(low, "favicon") || contains(low, "icon") then
    logo(h, r, low)
  else
    landscape(h, r)
  end
  clip_pop()
end

// ── Text ────────────────────────────────────────────────────────────────────

let CODE_WORDS = ["import", "let", "fn", "pub", "state", "for", "if", "else", "elsif", "end", "match", "when",
  "return", "def", "with", "alias", "set", "link", "yield", "in", "do", "then", "from"]

// `text` as lines of monospace, clipped to `r`. Code is dark with its
// comments and first keywords tinted; prose is ink on paper.
fn text_card(text: string, r: record, code: bool, big: bool) -> nil
  let bg = if code then #14161b else #f4f1ea end
  let ink = if code then #cfd5e1 else #33363d end
  let soft = if code then #6f7a8c else #8a8578 end
  let size = if big then 12.5 else 10.5 end
  let step = if big then 19.0 else 15.0 end
  let pad = if big then 22.0 else 12.0 end
  draw_rect_rounded(r, 8, bg)
  clip_push(Rect(r.x + 1, r.y + 1, r.w - 2, r.h - 2), 8)
  let lines = split(text, "\n")
  let y = r.y + pad
  for line in lines do
    if y > r.y + r.h then
      break
    end
    let t = trim(line)
    let style = if starts_with(t, "//") || (code && starts_with(t, "#")) then
      {size: size, font: "mono", color: soft}
    elsif !code && starts_with(t, "#") then
      {size: size, font: "mono", color: #1c1e22, weight: 700}
    else
      {size: size, font: "mono", color: ink}
    end
    draw_text(line, {x: r.x + pad, y: y}, style)
    if code then
      // Tint the leading keyword, in place over the line.
      let word = split(t, " ")[0]
      if contains(CODE_WORDS, word) then
        let indent = slice(line, 0, index_of(line, word))
        draw_text(word, {x: r.x + pad + text_advance(indent, style), y: y}, {size: size, font: "mono", color: #b79cf5})
      end
    end
    y += step
  end
  clip_pop()
end

// A CSV as a small table.
fn table_card(text: string, r: record, big: bool) -> nil
  draw_rect_rounded(r, 8, #f7f8fa)
  clip_push(Rect(r.x + 1, r.y + 1, r.w - 2, r.h - 2), 8)
  let rows = split(text, "\n")
  let step = if big then 26.0 else 19.0 end
  let size = if big then 12.5 else 10.5 end
  // The small card keeps the first column and the last two.
  let all = len(split(rows[0], ","))
  let cols = if big then all else min(all, 3) end
  let first_w = r.w * (if big then 0.34 else 0.50 end)
  let rest_w = (r.w - first_w) / max(1, cols - 1)
  draw_rect(Rect(r.x, r.y, r.w, step), #35a965)
  for i in range(0, len(rows)) do
    let y = r.y + i * step
    if y > r.y + r.h then
      break
    end
    let every = split(rows[i], ",")
    let cells = if len(every) > cols then [every[0]] ++ slice(every, len(every) - cols + 1) else every end
    if i > 0 && i % 2 == 0 then
      draw_rect(Rect(r.x, y, r.w, step), #eceff3)
    end
    for j in range(0, len(cells)) do
      let cell = if j == 0 then Rect(r.x + 10, y, first_w - 14, step) else Rect(r.x + first_w + (j - 1) * rest_w, y, rest_w - 10, step) end
      let style = {size: size, font: "ui", color: if i == 0 then #ffffff else #2b2e35 end, weight: if i == 0 then 600 else 400 end}
      tl.draw_text_line(tl.elide(cells[j], style, cell.w), cell, style, if j == 0 then "left" else "right" end)
    end
  end
  clip_pop()
end

// A page of something we cannot read: a title and grey paragraphs.
fn page_card(h: int, r: record, accent: record) -> nil
  let pw = min(r.w, r.h * 0.77)
  let p = Rect(r.x + (r.w - pw) / 2.0, r.y, pw, r.h)
  draw_shadow(p, {radius: 3, blur: 14, spread: 0, dx: 0, dy: 4, color: #000000, a: 70})
  draw_rect_rounded(p, 3, #fbfbfc)
  let m = p.w * 0.12
  draw_rect(Rect(p.x + m, p.y + m, p.w * (0.34 + 0.3 * frac(h, 5)), max(2.0, p.h * 0.026)), accent)
  let y = p.y + m + p.h * 0.075
  let i = 0
  while y < p.y + p.h - m do
    let short = (h / (i + 3)) % 5 == 0
    draw_rect(Rect(p.x + m, y, (p.w - 2 * m) * (if short then 0.4 + 0.3 * frac(h, 9 + i) else 1.0 end), max(1.0, p.h * 0.011)), #c9cfda)
    y += p.h * (if short then 0.062 else 0.033 end)
    i += 1
  end
end

fn wave_card(h: int, r: record, accent: record, label: string, T: record) -> nil
  draw_rect_rounded(r, 8, T.well)
  let n = int(r.w / 5.0)
  let mid = r.y + r.h * 0.46
  for i in range(0, n) do
    let t = i / float(n)
    let a = abs(sin(t * (9.0 + 20.0 * frac(h, 3)) + frac(h, 7) * 6.0)) * (0.35 + 0.65 * abs(sin(t * 3.14 * (1.0 + 3.0 * frac(h, 11)))))
    let half = max(1.0, a * r.h * 0.30)
    let x = r.x + 10 + i * (r.w - 20) / float(n)
    draw_line({x: x, y: mid - half}, {x: x, y: mid + half}, if t < 0.31 then accent else mix(accent, T.well, 0.55) end, 255, 2)
  end
  let s = {size: 11, font: "ui", color: T.dim}
  tl.draw_text_line("0:00", Rect(r.x + 12, r.y + r.h - 24, 60, 16), s)
  tl.draw_text_line(label, Rect(r.x + r.w - 72, r.y + r.h - 24, 60, 16), s, "right")
end

fn duration(seconds: int) -> string
  "{seconds / 60}:{pad_start(str(seconds % 60), 2, "0")}"
end

// ── The preview ─────────────────────────────────────────────────────────────

// Fill `r` with a preview of node `n`. `o` carries what the node cannot say
// for itself: {key (its kind), h (name hash), text, big, kids (for a folder:
// the kinds of what is in it)}. `T` is the app's palette.
pub fn draw(n: record, r: record, T: record, o: record) -> nil
  let key = o.key
  let c = ic.kind_color(key)
  if key == "image" then
    // Fit a 3:2 or 4:3 frame inside the rect, like a photo would sit.
    let ar = if o.h % 4 == 0 then 1.0 else 1.5 end
    let w = min(r.w, r.h * ar)
    let f = Rect(r.x + (r.w - w) / 2.0, r.y + (r.h - w / ar) / 2.0, w, w / ar)
    draw_shadow(f, {radius: 6, blur: 16, spread: 0, dx: 0, dy: 5, color: #000000, a: 80})
    picture(n.name, o.h, f, 6)
  elsif (key == "text" || key == "code") && o.text != "" then
    text_card(o.text, r, key == "code", o.big)
  elsif key == "sheet" && o.text != "" then
    table_card(o.text, r, o.big)
  elsif key == "pdf" || key == "doc" || key == "text" || key == "sheet" || key == "code" then
    page_card(o.h, r, c)
  elsif key == "audio" then
    // About a megabyte a minute compressed, ten uncompressed.
    let rate = if ends_with(lower(n.name), ".wav") then 176000 else 24000 end
    wave_card(o.h, r, c, duration(n.size / rate), T)
  elsif key == "video" then
    let w = min(r.w, r.h * 16.0 / 9.0)
    let f = Rect(r.x + (r.w - w) / 2.0, r.y + (r.h - w * 9.0 / 16.0) / 2.0, w, w * 9.0 / 16.0)
    draw_shadow(f, {radius: 6, blur: 16, spread: 0, dx: 0, dy: 5, color: #000000, a: 80})
    picture(n.name, o.h, f, 6)
    draw_rect_rounded(f, 6, #000000, 70)
    let cx = f.x + f.w / 2.0
    let cy = f.y + f.h / 2.0
    let pr = min(f.w, f.h) * 0.15
    draw_circle({x: cx, y: cy}, pr, #ffffff, 225)
    fill_triangle({x: cx - pr * 0.3, y: cy - pr * 0.45}, {x: cx - pr * 0.3, y: cy + pr * 0.45}, {x: cx + pr * 0.5, y: cy}, #1b1d22)
    tl.draw_text_line(duration(n.size / 1900000), Rect(f.x, f.y + f.h - 24, f.w - 10, 16),
      {size: 11, font: "ui", color: #ffffff, weight: 600}, "right")
  elsif key == "folder" && len(o.kids) > 0 then
    // What is inside, as a shelf of small icons.
    let cell = if o.big then 72.0 else 40.0 end
    let cols = max(1, int(r.w / cell))
    let shown = min(len(o.kids), cols * max(1, int(r.h / cell)))
    let used = min(shown, cols) * cell
    for i in range(0, shown) do
      let x = r.x + (r.w - used) / 2.0 + (i % cols) * cell
      let y = r.y + (i / cols) * cell + (r.h - ((shown - 1) / cols + 1) * cell) / 2.0
      ic.file_icon(o.kids[i], Rect(x + cell * 0.15, y + cell * 0.15, cell * 0.7, cell * 0.7))
    end
  else
    let s = min(r.w, r.h) * (if o.big then 0.5 else 0.82 end)
    let box = Rect(r.x + (r.w - s) / 2.0, r.y + (r.h - s) / 2.0, s, s)
    if n.id == 1 then
      ic.trash(box, false)
    else
      ic.file_icon(key, box)
    end
  end
  nil
end
