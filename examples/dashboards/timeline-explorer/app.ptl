    P(DEEP, USA, 3, 1979, 3, 5, "Voyager 1 at Jupiter", "Discovers active volcanoes on Io and a thin ring around the planet."),
    P(DEEP, EUR, 3, 1986, 3, 14, "Giotto", "Flies within 600 km of Halley's Comet and photographs a nucleus darker than coal."),
    P(DEEP, USA, 2, 1989, 8, 25, "Voyager 2 at Neptune", "The only visit to Neptune reveals supersonic winds and geysers on Triton."),
    S(DEEP, USA, 2, 1989, 10, 18, 2003, 9, 21, "Galileo", "Eight years in orbit around Jupiter find evidence of an ocean under Europa's ice."),
