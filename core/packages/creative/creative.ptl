// Package `creative` — The creative-coding set: interpolation, range
// mapping, distances and vector lengths, random picks (core/src/builtins/creative_coding.rs).
//
// A bundled builtin package: the petal runtime registers these natives in
// every Env, and `import creative` puts them in scope — bare (`lerp(…)`),
// qualified (`creative.lerp(…)`) and as methods (`x.lerp(…)`).
//
// Native interface declarations: each `native fn` binds a name to the host
// native of the same name and gives the checker its parameter names, arity
// and types. Several declarations of one name are that native's call forms.
// See docs/ffi.md (Native interfaces).

pub native fn lerp(a, b, t: num)
pub native fn map_range(value: num, in_lo: num, in_hi: num, out_lo: num, out_hi: num) -> float
pub native fn distance(x1, y1, x2, y2) -> float
pub native fn distance(v1, v2) -> float
pub native fn mag(x, y, z?) -> float
pub native fn mag(v) -> float
pub native fn smoothstep(edge0: num, edge1: num, x: num) -> float
pub native fn choose(list)
