// Reactive UI Sketch
// Inline state gives Petal a React-like component model: a component is a
// function, its state sits next to its view logic, and that state outlives the
// frame that drew it.
//
// Two kinds of state show up in any real UI, and they are declared differently:
//
//   - The app model — one copy, written by event handlers. That is a top-level
//     `state var`: one cell for the program, read with `get`, written with
//     `set` from wherever the event lands.
//   - A widget's own memory — one copy *per widget instance*. In a frame-loop
//     host that can be a plain `state` inside the widget function: it is keyed
//     by call path, so each callsite of `button` gets its own cell, as each
//     React component instance gets its own `useState`.
//
// This demo keys its button memory by the button's id instead, in a top-level
// `state var` holding a map, for two reasons. Its "frames" are passes of a
// `for` loop inside one run, and each pass is a different call path, so a
// call-path `state` would start every frame over. And an id-keyed entry stays
// with its button if the buttons are ever reordered, where a call-path cell
// stays with the position. This is React's `key` prop.

enum Event
  None,
  Add(text),
  Clear,
end

// The app model: one cell, shared by every function that touches it.
state var items = ["Buy groceries", "Write code", "Read a book"]

// Per-button memory, one entry per button id. The set of buttons is fixed, so
// nothing is ever removed; a UI whose widgets come and go would `remove` the
// entries of the ones it stopped drawing.
state var click_counts = Map()

// A widget. `id` names this button instance; its click count is the entry
// under that name, not something the `button` function holds as a whole.
fn button(id: string, label: string, clicked: bool) -> record
  let click_count = (get click_counts[id] ?? 0) + (if clicked then 1 else 0 end)
  set click_counts[id] = click_count
  {
    type: "button",
    label: "{label} ({click_count})",
    clicks: click_count,
  }
end

fn todo_app(event)
  // Handle this frame's event (a real UI runtime would feed these from input).
  let pressed = match event
    when Event.Add(text) ->
      set items = append(get items, text)
      "add"
    when Event.Clear ->
      set items = []
      "clear"
    when Event.None -> ""
  end

  let add_btn = button(id: "add", label: "Add", clicked: pressed == "add")
  let clear_btn = button(id: "clear", label: "Clear", clicked: pressed == "clear")

  let list = get items
  print("  Todo App ({len(list)} items)")
  print("  --------")
  for i in range(0, len(list)) do
    print("  [ ] {list[i]}")
  end
  print("  [{add_btn.label}]  [{clear_btn.label}]")
  print("")
end

print("Reactive UI Demo")
print("=================")
print("")

// Simulate render frames, one event each.
let events = [
  Event.None,
  Event.Add("Water plants"),
  Event.Add("Call Alex"),
  Event.Clear,
  Event.Add("Start over"),
]

for frame in range(0, len(events)) do
  print("Frame {frame + 1}:")
  todo_app(events[frame])
end
