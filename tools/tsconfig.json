{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    // The tools run under Node's native type stripping (see their shebangs),
    // which resolves specifiers literally and so requires the `.ts` extension
    // on relative imports. Safe with noEmit.
    "allowImportingTsExtensions": true,
    "lib": ["es2022"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["*.ts"]
}
