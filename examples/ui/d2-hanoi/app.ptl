// Tower of Hanoi with declarative dragging (ui/drag).
//
// The model is three pegs of disk sizes, bottom first. Only a peg's top disk
// is draggable, and its spec lists the states it can reach: the same board,
// or the disk on top of any peg whose top disk is larger. `closest` picks
// the peg nearest the dragged disk, `floating` keeps the disk under the
// pointer, and the disk settles onto its peg when it is let go. An illegal
// peg is simply not in the list, so the drag cannot reach it.
import ui
import ui/drag

let PEG_X = [110, 270, 430]
let BASE_Y = 280
let DISK_H = 22
let DISK_COLORS = [#e57373, #ffb74d, #81c784, #64b5f6, #ba68c8]

state pegs = [[4, 3, 2, 1], [], []]
state moves_made = 0

fn disk_rect(peg, height, size)
  let w = 40 + size * 24
  rect(PEG_X[peg] - w / 2, BASE_Y - (height + 1) * DISK_H, w, DISK_H - 2)
end

fn top(pegs, p)
  if len(pegs[p]) == 0 then nil else pegs[p][len(pegs[p]) - 1] end
end

// Every board the top disk of peg `p` can reach in one legal move, the
// current board included.
fn hanoi_moves(pegs, p)
  let disk = top(pegs, p)
  let out = [pegs]
  for q in range(0, 3) do
    let t = top(pegs, q)
    if q != p && (t == nil || t > disk) then
      let next = pegs
      next[p] = drop_last(pegs[p])
      next[q] = pegs[q] ++ [disk]
      out ++= [next]
    end
  end
  out
end

fn view(pegs)
  for p in range(0, 3) do
    draw_rect(PEG_X[p] - 4, BASE_Y - 130, 8, 130, #5a6070)
  end
  draw_rect(40, BASE_Y, 460, 10, #5a6070)
  for p in range(0, 3) do
    for h in range(0, len(pegs[p])) do
      let size = pegs[p][h]
      let r = place(size, disk_rect(p, h, size))
      if h == len(pegs[p]) - 1 then
        draggable(size, r, fn() closest(hanoi_moves(pegs, p)) |> floating() end)
      end
      place(size, r, fn(q) draw_rect_rounded(q, 4, DISK_COLORS[size]) end)
    end
  end
  nil
end

clear(24, 24, 32)
let d = drag_session(pegs, view)
view(d.preview)
if d.dropped && d.drop != pegs then
  pegs = d.drop
  moves_made += 1
end
let solved = len(pegs[2]) == 4
draw_text(if solved then "Solved in {moves_made} moves" else "Moves: {moves_made}" end, 40, 30, 16, #c8ccd8)
