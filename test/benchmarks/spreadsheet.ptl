// Spreadsheet formula engine, lifted verbatim from
// examples/testbed/25-spreadsheet/app.ptl (the formula engine + sheet seed),
// with a driver that recomputes the whole 26x8 grid. Mirrors the work that
// example's panel does whenever a cell is edited.


let DIGITS = "0123456789"
let LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

fn is_digit(c)
  len(c) == 1 && contains(DIGITS, c)
end

fn digit_val(c)
  let d = -1
  for i in range(0, 10) do
    if slice(DIGITS, i, i + 1) == c then
      d = i
    end
  end
  d
end

fn letter_val(c)
  let d = -1
  for i in range(0, 26) do
    if slice(LETTERS, i, i + 1) == c then
      d = i
    end
  end
  d
end

fn is_alpha(c)
  letter_val(upper(c)) >= 0
end

// ── values ────────────────────────────────────────────────────────────────
// One record shape for every result a cell can hold, so nothing downstream
// has to ask what kind of thing it is holding before it can pass it on.

fn vnum(x)
  {k: "num", n: float(x), s: ""}
end
fn vtext(s)
  {k: "text", n: 0.0, s: s}
end
fn vempty()
  {k: "empty", n: 0.0, s: ""}
end
fn verr(s)
  {k: "err", n: 0.0, s: s}
end

// Numeric coercion for arithmetic: a blank cell reads as 0 (so =SUM over a
// half-filled column works), text does not read as anything.
fn as_num(v)
  if v.k == "num" then v
  elsif v.k == "empty" then vnum(0.0)
  elsif v.k == "err" then v
  else verr("#VALUE!")
  end
end

// ── scanning a number out of a string ─────────────────────────────────────
// `float("3.5")` rejects strings ("Expected float at arg 1, got string"), so
// literals are scanned by hand. Returns {ok, v}: an optional leading "-",
// digits, an optional fraction, and nothing else — a trailing character makes
// the whole thing text, which is what tells "41200" from "Q1".

fn str_num(s)
  let n = len(s)
  let i = 0
  let neg = false
  if n > 0 && slice(s, 0, 1) == "-" then
    neg = true
    i = 1
  end
  let seen = false
  let whole = 0.0
  while i < n && is_digit(slice(s, i, i + 1)) do
    whole = whole * 10.0 + float(digit_val(slice(s, i, i + 1)))
    seen = true
    i = i + 1
  end
  if i < n && slice(s, i, i + 1) == "." then
    i = i + 1
    let scale = 0.1
    while i < n && is_digit(slice(s, i, i + 1)) do
      whole = whole + float(digit_val(slice(s, i, i + 1))) * scale
      scale = scale * 0.1
      seen = true
      i = i + 1
    end
  end
  if !seen || i != n then
    {ok: false, v: 0.0}
  else
    {ok: true, v: if neg then -whole else whole end}
  end
end

// ── tokenizer ─────────────────────────────────────────────────────────────
// Tokens are {t, s, n}, where t is "num" | "name" | "str" | "op".

fn tokenize(src)
  let s = src
  let n = len(s)
  let toks = []
  let i = 0
  while i < n do
    let c = slice(s, i, i + 1)
    if c == " " then
      i = i + 1
    elsif c == "\"" then
      let j = i + 1
      while j < n && slice(s, j, j + 1) != "\"" do
        j = j + 1
      end
      toks = append(toks, {t: "str", s: slice(s, i + 1, j), n: 0.0})
      i = min(j + 1, n)
    elsif is_digit(c) || c == "." then
      let j = i
      while j < n && (is_digit(slice(s, j, j + 1)) || slice(s, j, j + 1) == ".") do
        j = j + 1
      end
      let lit = str_num(slice(s, i, j))
      toks = append(toks, {t: "num", s: slice(s, i, j), n: lit.v})
      i = j
    elsif is_alpha(c) then
      let j = i
      while j < n && (is_alpha(slice(s, j, j + 1)) || is_digit(slice(s, j, j + 1))) do
        j = j + 1
      end
      toks = append(toks, {t: "name", s: upper(slice(s, i, j)), n: 0.0})
      i = j
    elsif c == ">" || c == "<" then
      let nx = if i + 1 < n then slice(s, i + 1, i + 2) else "" end
      if nx == "=" || (c == "<" && nx == ">") then
        toks = append(toks, {t: "op", s: c ++ nx, n: 0.0})
        i = i + 2
      else
        toks = append(toks, {t: "op", s: c, n: 0.0})
        i = i + 1
      end
    else
      toks = append(toks, {t: "op", s: c, n: 0.0})
      i = i + 1
    end
  end
  toks
end

fn tok_at(toks, i)
  if i >= 0 && i < len(toks) then toks[i] else {t: "eof", s: "", n: 0.0} end
end

fn is_op(toks, i, s)
  let t = tok_at(toks, i)
  t.t == "op" && t.s == s
end

// ── cell references ───────────────────────────────────────────────────────
// "B12" -> {ok, r, c}, zero-based; one or more column letters.

fn parse_ref(name)
  let n = len(name)
  let i = 0
  let col = 0
  while i < n && letter_val(slice(name, i, i + 1)) >= 0 do
    col = col * 26 + letter_val(slice(name, i, i + 1)) + 1
    i = i + 1
  end
  if i == 0 || i >= n then
    {ok: false, r: 0, c: 0}
  else
    let rowpart = str_num(slice(name, i, n))
    if !rowpart.ok || rowpart.v < 1.0 then
      {ok: false, r: 0, c: 0}
    else
      {ok: true, r: int(rowpart.v) - 1, c: col - 1}
    end
  end
end

fn ref_name(r, c)
  let col = ""
  let n = c + 1
  while n > 0 do
    let d = (n - 1) % 26
    col = slice(LETTERS, d, d + 1) ++ col
    n = (n - 1) / 26
  end
  col ++ str(r + 1)
end

// ── evaluator ─────────────────────────────────────────────────────────────
// Petal binds a `fn` when its declaration *runs*, so a name used above its
// declaration reads as nil at call time ("Cannot call nil"). This grammar is
// mutually recursive twice over — a primary contains a whole expression, and a
// cell reference re-enters the sheet — so the two back-edges travel through
// `var` cells, which a closure captures as a box and so can be filled in once
// everything below is declared.

var _expr = nil
var _eval_at = nil

fn agg(vals, kind)
  let total = 0.0
  let count = 0
  let best = 0.0
  let err = ""
  for v in vals do
    if v.k == "err" && len(err) == 0 then
      err = v.s
    elsif v.k == "num" then
      if count == 0 || (kind == "min" && v.n < best) || (kind == "max" && v.n > best) then
        best = v.n
      end
      total = total + v.n
      count = count + 1
    end
  end
  if len(err) > 0 then
    verr(err)
  elsif kind == "sum" then
    vnum(total)
  elsif kind == "count" then
    vnum(float(count))
  elsif count == 0 then
    verr("#DIV/0!")
  elsif kind == "avg" then
    vnum(total / float(count))
  else
    vnum(best)
  end
end

fn call_fn(name, vals)
  if name == "SUM" then agg(vals, "sum")
  elsif name == "AVG" || name == "AVERAGE" then agg(vals, "avg")
  elsif name == "MIN" then agg(vals, "min")
  elsif name == "MAX" then agg(vals, "max")
  elsif name == "COUNT" then agg(vals, "count")
  elsif name == "ABS" && len(vals) == 1 then
    let a = as_num(vals[0])
    if a.k == "err" then a else vnum(abs(a.n)) end
  elsif name == "ROUND" && len(vals) == 2 then
    let a = as_num(vals[0])
    let d = as_num(vals[1])
    if a.k == "err" then a
    elsif d.k == "err" then d
    else
      let scale = pow(10.0, d.n)
      vnum(round(a.n * scale) / scale)
    end
  elsif name == "IF" && len(vals) == 3 then
    let c = as_num(vals[0])
    if c.k == "err" then c
    elsif c.n != 0.0 then vals[1]
    else vals[2]
    end
  else
    verr("#NAME?")
  end
end

// Every argument of a call, with `B2:E4` expanded in place into one value per
// cell. Ranges are legal only here, which is why the argument list resolves
// them rather than the expression grammar.
fn parse_args(cx, toks, i0)
  let i = i0
  let vals = []
  let err = ""
  if is_op(toks, i, ")") then
    {vals: vals, i: i + 1, err: ""}
  else
    let done = false
    while !done do
      let a = tok_at(toks, i)
      let b = tok_at(toks, i + 2)
      let ra = if a.t == "name" then parse_ref(a.s) else {ok: false, r: 0, c: 0} end
      let rb = if b.t == "name" then parse_ref(b.s) else {ok: false, r: 0, c: 0} end
      if ra.ok && is_op(toks, i + 1, ":") && rb.ok then
        for r in range(min(ra.r, rb.r), max(ra.r, rb.r) + 1) do
          for c in range(min(ra.c, rb.c), max(ra.c, rb.c) + 1) do
            vals = append(vals, get _eval_at(cx, r, c))
          end
        end
        i = i + 3
      else
        let res = get _expr(cx, toks, i)
        vals = append(vals, res.v)
        i = res.i
      end
      if is_op(toks, i, ",") then
        i = i + 1
      elsif is_op(toks, i, ")") then
        i = i + 1
        done = true
      else
        err = "#SYNTAX"
        done = true
      end
    end
    {vals: vals, i: i, err: err}
  end
end

fn parse_primary(cx, toks, i)
  let t = tok_at(toks, i)
  if t.t == "num" then
    {v: vnum(t.n), i: i + 1}
  elsif t.t == "str" then
    {v: vtext(t.s), i: i + 1}
  elsif t.t == "op" && t.s == "(" then
    let inner = get _expr(cx, toks, i + 1)
    if is_op(toks, inner.i, ")") then
      {v: inner.v, i: inner.i + 1}
    else
      {v: verr("#SYNTAX"), i: inner.i}
    end
  elsif t.t == "name" then
    if is_op(toks, i + 1, "(") then
      let args = parse_args(cx, toks, i + 2)
      if len(args.err) > 0 then
        {v: verr(args.err), i: args.i}
      else
        {v: call_fn(t.s, args.vals), i: args.i}
      end
    else
      let ref = parse_ref(t.s)
      if ref.ok then
        {v: get _eval_at(cx, ref.r, ref.c), i: i + 1}
      else
        {v: verr("#NAME?"), i: i + 1}
      end
    end
  else
    {v: verr("#SYNTAX"), i: i + 1}
  end
end

fn parse_unary(cx, toks, i)
  if is_op(toks, i, "-") then
    let inner = parse_unary(cx, toks, i + 1)
    let a = as_num(inner.v)
    {v: if a.k == "err" then a else vnum(-a.n) end, i: inner.i}
  elsif is_op(toks, i, "+") then
    parse_unary(cx, toks, i + 1)
  else
    parse_primary(cx, toks, i)
  end
end

fn parse_pow(cx, toks, i)
  let a = parse_unary(cx, toks, i)
  if is_op(toks, a.i, "^") then
    let b = parse_pow(cx, toks, a.i + 1)
    let x = as_num(a.v)
    let y = as_num(b.v)
    let v = if x.k == "err" then x elsif y.k == "err" then y else vnum(pow(x.n, y.n)) end
    {v: v, i: b.i}
  else
    a
  end
end

fn parse_mul(cx, toks, i0)
  let acc = parse_pow(cx, toks, i0)
  let i = acc.i
  let v = acc.v
  while is_op(toks, i, "*") || is_op(toks, i, "/") do
    let op = tok_at(toks, i).s
    let rhs = parse_pow(cx, toks, i + 1)
    let x = as_num(v)
    let y = as_num(rhs.v)
    if x.k == "err" then v = x
    elsif y.k == "err" then v = y
    elsif op == "/" && y.n == 0.0 then v = verr("#DIV/0!")
    elsif op == "*" then v = vnum(x.n * y.n)
    else v = vnum(x.n / y.n)
    end
    i = rhs.i
  end
  {v: v, i: i}
end

fn parse_add(cx, toks, i0)
  let acc = parse_mul(cx, toks, i0)
  let i = acc.i
  let v = acc.v
  while is_op(toks, i, "+") || is_op(toks, i, "-") do
    let op = tok_at(toks, i).s
    let rhs = parse_mul(cx, toks, i + 1)
    let x = as_num(v)
    let y = as_num(rhs.v)
    if x.k == "err" then v = x
    elsif y.k == "err" then v = y
    elsif op == "+" then v = vnum(x.n + y.n)
    else v = vnum(x.n - y.n)
    end
    i = rhs.i
  end
  {v: v, i: i}
end

fn cmp_apply(op, x, y)
  if op == ">" then x.n > y.n
  elsif op == "<" then x.n < y.n
  elsif op == ">=" then x.n >= y.n
  elsif op == "<=" then x.n <= y.n
  elsif op == "<>" then x.n != y.n
  else x.n == y.n
  end
end

fn parse_cmp(cx, toks, i0)
  let a = parse_add(cx, toks, i0)
  let t = tok_at(toks, a.i)
  if t.t == "op" && (t.s == ">" || t.s == "<" || t.s == ">=" || t.s == "<=" || t.s == "<>" || t.s == "=") then
    let b = parse_add(cx, toks, a.i + 1)
    let x = as_num(a.v)
    let y = as_num(b.v)
    let v = if x.k == "err" then x
      elsif y.k == "err" then y
      else vnum(if cmp_apply(t.s, x, y) then 1.0 else 0.0 end)
      end
    {v: v, i: b.i}
  else
    a
  end
end

set _expr = parse_cmp

fn raw_at(cells, r, c)
  if r < 0 || r >= len(cells) then ""
  elsif c < 0 || c >= len(cells[r]) then ""
  else cells[r][c]
  end
end

// `cx` is {cells, depth}. There is no dependency graph and no memo table: the
// sheet is 208 cells and a reference simply re-evaluates its target, with the
// depth budget standing in for cycle detection (=A1 in A1 bottoms out at
// #CYCLE rather than hanging the frame).
fn eval_at(cx, r, c)
  if r < 0 || r >= len(cx.cells) || c < 0 || c >= len(cx.cells[0]) then
    verr("#REF!")
  elsif cx.depth > 24 then
    verr("#CYCLE")
  else
    let raw = raw_at(cx.cells, r, c)
    if len(raw) == 0 then
      vempty()
    elsif slice(raw, 0, 1) == "=" then
      let toks = tokenize(slice(raw, 1, len(raw)))
      if len(toks) == 0 then
        vempty()
      else
        let res = parse_cmp({cells: cx.cells, depth: cx.depth + 1}, toks, 0)
        if res.v.k != "err" && res.i < len(toks) then
          verr("#SYNTAX")
        else
          res.v
        end
      end
    else
      let lit = str_num(raw)
      if lit.ok then vnum(lit.v) else vtext(raw) end
    end
  end
end

set _eval_at = eval_at

fn evaluate(cells)
  let grid = for r in range(0, len(cells)) do
    let row = for c in range(0, len(cells[r])) do
      eval_at({cells: cells, depth: 0}, r, c)
    end
    row
  end
  grid
end

// ── display formatting ────────────────────────────────────────────────────

// Group an integer's digits in threes: "1234567" -> "1,234,567".
fn group3(digits)
  let n = len(digits)
  let out = ""
  for i in range(0, n) do
    if i > 0 && (n - i) % 3 == 0 then
      out = out ++ ","
    end
    out = out ++ slice(digits, i, i + 1)
  end
  out
end

// At most two decimals, trailing zeros dropped, thousands grouped.
fn fmt_num(x)
  let neg = x < 0.0
  let scaled = round(abs(x) * 100.0)
  let whole = int(scaled / 100.0)
  let cents = int(scaled) - whole * 100
  let body = group3(str(whole))
  if cents > 0 then
    let frac = if cents < 10 then "0" ++ str(cents) else str(cents) end
    if cents % 10 == 0 then
      frac = slice(frac, 0, 1)
    end
    body = body ++ "." ++ frac
  end
  if neg && (whole > 0 || cents > 0) then "-" ++ body else body end
end

fn display(v)
  if v.k == "num" then fmt_num(v.n)
  elsif v.k == "text" then v.s
  elsif v.k == "err" then v.s
  else ""
  end
end

fn kind_label(raw, v)
  if len(raw) > 0 && slice(raw, 0, 1) == "=" then
    if v.k == "err" then "formula · error" else "formula" end
  elsif v.k == "num" then "number"
  elsif v.k == "text" then "text"
  else "empty"
  end
end

// ══ 2. the sheet ══════════════════════════════════════════════════════════

let COLS = 8
let ROWS = 26

fn blank_row()
  let r = for c in range(0, COLS) do "" end
  r
end

fn seed()
  let g = []
  g = append(g, ["Line item", "Q1", "Q2", "Q3", "Q4", "FY total", "Avg / qtr", "Q4 vs Q1"])
  g = append(g, ["New MRR", "41200", "46800", "52300", "61400", "=SUM(B2:E2)", "=ROUND(AVG(B2:E2),0)", "=ROUND((E2-B2)/B2*100,1)"])
  g = append(g, ["Expansion", "9800", "11450", "12980", "15600", "=SUM(B3:E3)", "=ROUND(AVG(B3:E3),0)", "=ROUND((E3-B3)/B3*100,1)"])
  g = append(g, ["Churned MRR", "-6400", "-7100", "-6850", "-8200", "=SUM(B4:E4)", "=ROUND(AVG(B4:E4),0)", "=ROUND((E4-B4)/ABS(B4)*100,1)"])
  g = append(g, ["Net new MRR", "=SUM(B2:B4)", "=SUM(C2:C4)", "=SUM(D2:D4)", "=SUM(E2:E4)", "=SUM(B5:E5)", "=ROUND(AVG(B5:E5),0)", "=ROUND((E5-B5)/B5*100,1)"])
  g = append(g, blank_row())
  g = append(g, ["Headcount", "18", "21", "24", "27", "", "=ROUND(AVG(B7:E7),1)", "=E7-B7"])
  g = append(g, ["Payroll", "=B7*7400", "=C7*7400", "=D7*7400", "=E7*7400", "=SUM(B8:E8)", "=ROUND(AVG(B8:E8),0)", ""])
  g = append(g, ["Cloud + tools", "8400", "9100", "10250", "12100", "=SUM(B9:E9)", "=ROUND(AVG(B9:E9),0)", ""])
  g = append(g, ["Marketing", "14000", "16500", "15200", "21000", "=SUM(B10:E10)", "=ROUND(AVG(B10:E10),0)", ""])
  g = append(g, ["Total opex", "=SUM(B8:B10)", "=SUM(C8:C10)", "=SUM(D8:D10)", "=SUM(E8:E10)", "=SUM(B11:E11)", "=ROUND(AVG(B11:E11),0)", "=ROUND((E11-B11)/B11*100,1)"])
  g = append(g, blank_row())
  g = append(g, ["Quarterly burn", "=B11-B5", "=C11-C5", "=D11-D5", "=E11-E5", "=SUM(B13:E13)", "=ROUND(AVG(B13:E13),0)", ""])
  g = append(g, ["Cash on hand", "480000", "=B14-B13", "=C14-C13", "=D14-D13", "", "", ""])
  g = append(g, ["Runway (qtrs)", "=ROUND(B14/MAX(B13,1),1)", "=ROUND(C14/MAX(C13,1),1)", "=ROUND(D14/MAX(D13,1),1)", "=ROUND(E14/MAX(E13,1),1)", "", "", ""])
  g = append(g, blank_row())
  g = append(g, ["Verdict", "=IF(E5>D5,\"expanding\",\"flat\")", "", "", "", "", "", "=IF(E15<4,\"raise now\",\"runway ok\")"])
  while len(g) < ROWS do
    g = append(g, blank_row())
  end
  g
end

// ── driver ────────────────────────────────────────────────────────────────

let sheet = seed()
let total = 0.0
for iter in range(0, 10) do
  let grid = evaluate(sheet)
  for row in grid do
    for v in row do
      total = total + v.n
    end
  end
end
print(total)
