  {id: 17, name: "Bartek Nowak",     title: "Engineering Manager",company: "Wisla Robotics",   email: "b.nowak@wisla.pl",      phone: "+48 22 555 76",   stage: "Lead",      value: 26000,  days: 45, owner: "J. Weaver", tags: ["robotics", "inbound"],       notes: "Evaluating three vendors at once. Price-sensitive, and honest about it, which is refreshing."},
