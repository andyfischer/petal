  {id: 14, name: "Ingrid Sørensen",  title: "VP Revenue",         company: "Fjordline",        email: "ingrid@fjordline.no",   phone: "+47 22 555 08",   stage: "Lead",      value: 52000,  days: 27, owner: "J. Weaver", tags: ["nordics", "outbound"],       notes: "Cold outbound that actually landed. Asked for a reference in her industry before committing to a call."},
