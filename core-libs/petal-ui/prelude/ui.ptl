pub fn draw_line(x1, y1, x2, y2, r, g, b, a = 255, width = 1)
  _native_line(x1, y1, x2, y2, r, g, b, a, width)
end
pub fn draw_line(x1, y1, x2, y2, c, a)
  _native_line(x1, y1, x2, y2, c.r, c.g, c.b, a)
end
// Also positionally the flat `(x1, y1, x2, y2, r, g, b)`.
pub fn draw_line(x1, y1, x2, y2, c, a = 255, width = 1)
  if _is_num(c) then
    _native_line(x1, y1, x2, y2, c, a, width)
  else
    _native_line(x1, y1, x2, y2, c.r, c.g, c.b, a, width)
  end
end
pub fn draw_line(p1, p2, c)
  _native_line(p1.x, p1.y, p2.x, p2.y, c.r, c.g, c.b)
end
// Alpha and stroke width, matching the flat arities and every other primitive's
// record overload. A checkmark, a strikethrough, a caret and a focus underline
// all want a 2px or translucent stroke; without these the call fell through to
// the native's arity check and failed at *runtime* with "draw_line() expects
// 7 or 8 or 9 or 3 arguments, got 5".
pub fn draw_line(p1, p2, c, a)
  _native_line(p1.x, p1.y, p2.x, p2.y, c.r, c.g, c.b, a)
end
// Also positionally the mixed `(x1, y1, x2, y2, c)`.
pub fn draw_line(p1, p2, c, a = 255, width = 1)
  if _is_num(p1) then
    _native_line(p1, p2, c, a, width.r, width.g, width.b)
  else
    _native_line(p1.x, p1.y, p2.x, p2.y, c.r, c.g, c.b, a, width)
  end
end

pub fn draw_circle(cx, cy, radius, r, g, b, a = 255)
  _native_circle(cx, cy, radius, r, g, b, a)
end
pub fn draw_circle(center, radius, c)
  _native_circle(center.x, center.y, radius, c.r, c.g, c.b)
end
// Also positionally the mixed `(cx, cy, radius, c)`.
pub fn draw_circle(center, radius, c, a)
  if _is_num(center) then
    _native_circle(center, radius, c, a.r, a.g, a.b)
  else
    _native_circle(center.x, center.y, radius, c.r, c.g, c.b, a)
  end
end
pub fn draw_circle(cx, cy, radius, c, a = 255)
  _native_circle(cx, cy, radius, c.r, c.g, c.b, a)
end

// Record overloads for the rest of the draw surface. Every one of these was
// hand-rolled by at least one testbed app: a call like
// `draw_polyline(pts, C_ROCK, 235, 1)` passes `check --strict` and then dies
// at *runtime* with "Expected int at arg 2, got record", which is the expensive
// round-trip the prelude exists to save. The shapes mirror the flat natives
// exactly — the same optional alpha and stroke width, in the same order — so
// switching a call from packed ints to a colour record changes nothing else.
pub fn draw_rect_rounded_outline(x, y, w, h, radius, r, g, b, a = 255, width = 1)
  _native_rect_rounded_outline(x, y, w, h, radius, r, g, b, a, width)
end
pub fn draw_rect_rounded_outline(x, y, w, h, radius, c)
  _native_rect_rounded_outline(x, y, w, h, radius, c.r, c.g, c.b)
end
pub fn draw_rect_rounded_outline(x, y, w, h, radius, c, a)
  _native_rect_rounded_outline(x, y, w, h, radius, c.r, c.g, c.b, a)
end
// Also positionally the flat `(x, y, w, h, radius, r, g, b)`.
pub fn draw_rect_rounded_outline(x, y, w, h, radius, c, a = 255, width = 1)
  if _is_num(c) then
    _native_rect_rounded_outline(x, y, w, h, radius, c, a, width)
  else
    _native_rect_rounded_outline(x, y, w, h, radius, c.r, c.g, c.b, a, width)
  end
end
pub fn draw_rect_rounded_outline(rect, radius, c, a = 255, width = 1)
  _native_rect_rounded_outline(rect.x, rect.y, rect.w, rect.h, radius, c.r, c.g, c.b, a, width)
end

// The mixed `(cx, cy, radius, c[, a[, width]])` shares every one of its counts
// with another shape: four and five with the centre-record form, six with the
// flat form. So the centre-record form keeps a declaration per count, each
// looking at its first argument, and the mixed form's own declaration looks at
// its fourth.
pub fn draw_circle_outline(cx, cy, radius, r, g, b, a = 255, width = 1)
  _native_circle_outline(cx, cy, radius, r, g, b, a, width)
end
// Also positionally the flat `(cx, cy, radius, r, g, b)`.
// And, with `width` named, the centre-record `(center, radius, c, a)`.
pub fn draw_circle_outline(cx, cy, radius, c, a = 255, width = 1)
  if !_is_num(cx) then
    _native_circle_outline(cx.x, cx.y, cy, radius.r, radius.g, radius.b, c, width)
  else
    if _is_num(c) then
      _native_circle_outline(cx, cy, radius, c, a, width)
    else
      _native_circle_outline(cx, cy, radius, c.r, c.g, c.b, a, width)
    end
  end
end
pub fn draw_circle_outline(center, radius, c)
  _native_circle_outline(center.x, center.y, radius, c.r, c.g, c.b)
end
// Also positionally the mixed `(cx, cy, radius, c)`.
pub fn draw_circle_outline(center, radius, c, a)
  if _is_num(center) then
    _native_circle_outline(center, radius, c, a.r, a.g, a.b)
  else
    _native_circle_outline(center.x, center.y, radius, c.r, c.g, c.b, a)
  end
end
// Also positionally the mixed `(cx, cy, radius, c, a)`.
pub fn draw_circle_outline(center, radius, c, a = 255, width = 1)
  if _is_num(center) then
    _native_circle_outline(center, radius, c, a.r, a.g, a.b, width)
  else
    _native_circle_outline(center.x, center.y, radius, c.r, c.g, c.b, a, width)
  end
end

