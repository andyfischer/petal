  d = append(d, mk(4, "Glow · inner", "ellipse", 510, 50, 162, 162, 0, #f6e7b8, 7))
  d = append(d, mk(5, "Moon", "ellipse", 528, 68, 126, 126, 0, #f6e7b8, 255))
  d = append(d, mk(6, "Ridge · far", "tri", -40, 174, 560, 256, 0, #1d3a5f, 255))
  d = append(d, mk(7, "Ridge · near", "tri", 286, 222, 520, 208, 0, #14283f, 255))
  d = append(d, mk(8, "Lake", "rect", 0, 422, 760, 118, 0, #0a1729, 255))
  d = append(d, mk(9, "Moonpath · near", "rect", 545, 432, 92, 14, 0, #f6e7b8, 12))
  d = append(d, mk(10, "Moonpath · mid", "rect", 555, 466, 72, 11, 0, #f6e7b8, 9))
  d = append(d, mk(11, "Moonpath · far", "rect", 564, 498, 54, 9, 0, #f6e7b8, 6))
  d = append(d, mk(12, "Star · alpha", "star", 108, 66, 30, 30, 12, #f6e7b8, 220))
  d = append(d, mk(13, "Star · beta", "star", 236, 40, 20, 20, -8, #f6e7b8, 170))
  d = append(d, mk(14, "Star · gamma", "star", 402, 96, 15, 15, 20, #f6e7b8, 140))
  d = append(d, mk(15, "Pine", "tri", 198, 320, 64, 102, 0, #071c12, 255))
