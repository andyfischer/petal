// State
// `state` declares storage that belongs to a declaration site and outlives the
// call that created it: the value is still there on the next call, the next
// frame, and — in a live-editing host — after a hot reload.
//
// Which cell a declaration gets depends on how the declaration is reached:
//
//   state x       at the top level   one cell for the whole program
//   state x       in a function      one cell per call path — per callsite,
//                                    and per iteration of the loops that led
//                                    there
//   state var x   anywhere           the cell holds a mutable box, so `set`
//                                    can write it from another function
//
// Rule of thumb: a top-level `state var` when several places must agree on one
// value — holding a map when there is one value per entity id — and a plain
// in-function `state` when the value belongs to the use site itself. A result
// that is a pure function of some key is not state at all: cache it with
// `memo(key)` (last section).

// ── One cell for the whole program ───────────────────────────────────────
// Cross-function shared state is a top-level `state var`. Inside a function a
// bare read needs `get`, so every use site shows that it is touching the one
// shared cell rather than a local of its own.

state var total = 0

fn accumulate(value)
  set total = get total + value
  get total
end

print("Accumulator")
print("===========")
for i in range(1, 6) do
  print("After adding", i, "-> total:", accumulate(i))
end

// ── One entry per entity ─────────────────────────────────────────────────
// When the value belongs to an entity with an id, the shared cell holds a map
// keyed by that id. The same entity reaches the same entry no matter which
// callsite, loop iteration, or recursion depth asked for it — which is what
// lets a count stay with its entity when a list is reordered. Absent keys read
// as `nil`, so `??` supplies the starting value.

state var hits = Map()

fn hit(id)
  set hits[id] = (get hits[id] ?? 0) + 1
  get hits[id]
end

print("")
print("Per-entity counters")
print("===================")
for id in ["goblin", "orc", "goblin", "goblin", "orc"] do
  print("  {id} hit {hit(id)}x")
end

// ── One cell per use site ────────────────────────────────────────────────
// A plain `state` inside a function belongs to the declaration, and to the path
// that reached it — the way a React component instance owns its `useState`
// slots. The two widgets below both name their counter `renders`, and they get
// two different cells: a declaration is identified by where it is written, not
// by the name it picked. So both report their first render, rather than the
// footer inheriting the header's count.
//
// Call-path keying extends that to callsites: a second call of one widget gets
// a second cell, and a widget drawn once per list item gets one cell per item —
// list keying by position, for free. Within one run a path is normally reached
// only once, so an in-function counter like `renders` counts runs (frames),
// not calls; to count calls, share a top-level cell, as above.

fn header(title: string) -> string
  state renders = 0
  renders = renders + 1
  "{title} (render {renders})"
end

fn footer(note: string) -> string
  state renders = 0
  renders = renders + 1
  "{note} (render {renders})"
end

print("")
print("Per-use-site state")
print("==================")
let head = header("Todo")
let foot = footer("v1.0")
print("  {head}")
print("  {foot}")

// ── Cached results ───────────────────────────────────────────────────────
// `memo(key) x = init` runs `init` once per key value and hands every later
// caller with an equal key the same result, whichever callsite asks. That is
// only safe because a memo cannot be written: it is a cache of a pure result,
// not storage, so sharing it is unobservable. Anything the program updates
// belongs in `state`. (The `print` below is there only to show when the
// initializer runs; a real memo initializer should not have side effects.)

fn build_label(id: string) -> string
  print("  (building the label for {id})")
  "<{upper(id)}>"
end

fn label(id: string) -> string
  memo(id) text = build_label(id)
  text
end

print("")
print("Cached results")
print("==============")
for id in ["goblin", "orc", "goblin"] do
  print("  {label(id)}")
end
