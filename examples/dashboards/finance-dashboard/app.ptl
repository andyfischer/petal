    {name: "Whole Foods",           avg: 84.0,   freq: 3.0,  jit: 0.34},
    {name: "Trader Joe's",          avg: 61.0,   freq: 2.4,  jit: 0.30},
    {name: "Corner Market",         avg: 23.0,   freq: 3.2,  jit: 0.45},
