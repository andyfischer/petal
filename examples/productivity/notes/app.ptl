  ]},
  {id: 4, book: "Recipes", pinned: false, mins: 1180,
    title: "Buckwheat pancakes, the good ratio",
    lines: [
      "120g buckwheat, 60g plain, 2 eggs, 400ml buttermilk, a good pinch",
