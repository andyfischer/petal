# Package `core` — Arithmetic, rounding, trigonometry and the numeric casts (core/src/builtins/math.rs).
#
# Native interface declarations: each `native fn` binds a name to the host
# native of the same name and gives the checker its parameter names, arity
# and types. Several declarations of one name are that native's call forms.
# See docs/usage/ffi.md (Native interfaces).

pub native fn abs(x: num)
pub native fn sqrt(x: num)
pub native fn floor(x: num)
pub native fn ceil(x: num)
pub native fn float(value) -> float
pub native fn int(value) -> int
pub native fn random() -> float
pub native fn random(max: num) -> float
pub native fn random(min: num, max: num) -> float
pub native fn min(a, b)
pub native fn max(a, b)
pub native fn round(x: num, places?: num)
pub native fn sin(x: num)
pub native fn cos(x: num)
pub native fn tan(x: num)
pub native fn atan2(y: num, x: num)
pub native fn pi() -> float
pub native fn parse_float(string)
pub native fn parse_int(string)
pub native fn safe_div(a, b)
pub native fn asin(x: num)
pub native fn acos(x: num)
pub native fn atan(x: num)
pub native fn hypot(x: num, y: num)
pub native fn interp(table: list, x: num)
pub native fn hash_int(a: num, b?: num, c?: num, d?: num) -> int
pub native fn hash01(a: num, b?: num, c?: num, d?: num) -> float
pub native fn hash_str(text: string, salt?: num) -> int

# The creative-coding set (core/src/builtins/creative_coding.rs):
# interpolation, range mapping and shaping, distances and vector lengths,
# random picks.
pub native fn clamp(value: num, lo: num, hi: num)
pub native fn pow(base: num, exp: num)
pub native fn sign(x: num)
pub native fn exp(x: num)
pub native fn log(x)
pub native fn fract(x: num)
pub native fn radians(degrees: num)
pub native fn degrees(radians: num)
pub native fn random_int(lo: num, hi: num) -> int
pub native fn lerp(a, b, t: num)
pub native fn map_range(value: num, in_lo: num, in_hi: num, out_lo: num, out_hi: num)
pub native fn distance(x1, y1, x2, y2)
pub native fn distance(v1, v2) -> float
pub native fn mag(x, y, z?)
pub native fn mag(v)
pub native fn smoothstep(edge0: num, edge1: num, x: num)
pub native fn choose(list)
