// text_layout/place — where one line of text goes.
//
// Every `draw_text` in every Petal UI has had to answer the same question, and
// almost all of them have answered it wrong:
//
//     draw_text(label, {x: x, y: r.y + (r.h - size) / 2}, style)
//
// That line says "the run is `size` px tall and starts at `y`". Neither half
// is true. `y` is the top of the run's *line box*, the baseline sits some way
// down inside it, and the ink of a capital reaches nowhere near either edge —
// so the label lands a pixel or two high at 14 px and visibly high at 32.
//
// The host knows the real numbers, and now says so: `text_metrics(style)`
// reports, in pixels, where the baseline falls below the `y` a script hands
// `draw_text`, how far the descenders go, how tall a capital and an "x" are,
// and how far apart to set two lines. This module turns those into the answer
// a caller actually wants — a `y` to draw at.
//
// The `ui` prelude is the host's implicit import and reaches every module of a
// program, so `text_width`, `text_metrics` and `draw_text` are named bare here
// with no `import ui`.

// ── Vertical placement ────────────────────────────────────────────────────

// The baseline y for text set in `r`, vertically aligned by `valign`:
//
//   "middle"    the *cap height* is centred in the box — what a designer means
//               by a centred button label. A label with no descender looks
//               high when its line box is centred instead, which is exactly
//               the bug this library exists to fix.
//   "center"    a spelling of "middle", for callers that spell the other axis
//               "center" and would rather not switch vocabulary mid-record.
//   "top"       the line box's top sits on `r.y`
//   "bottom"    the descenders sit on `r.y + r.h`
//   "baseline"  `r.y + r.h` *is* the baseline
export fn text_baseline(r: record, style: record, valign: string) -> float
  let m = text_metrics(style)
  match valign
    when "top" -> float(r.y) + m.baseline
    when "bottom" -> float(r.y) + float(r.h) - m.descent
    when "baseline" -> float(r.y) + float(r.h)
    when _ -> float(r.y) + float(r.h) / 2.0 + m.cap_height / 2.0
  end
end

// The same, defaulting to a centred label — the case every control wants.
export fn text_baseline(r: record, style: record) -> float
  text_baseline(r, style, "middle")
end

// The `y` to hand `draw_text` so that the run's baseline lands on `baseline`.
// The one conversion between the two coordinate systems in play: a script
// reasons in baselines, `draw_text` takes line-box tops.
export fn text_top(baseline: num, style: record) -> float
  float(baseline) - text_metrics(style).baseline
end

// The `y` to hand `draw_text` for a single line set in `r` — the composition
// of the two above, and the call a control actually makes.
export fn text_line_y(r: record, style: record, valign: string) -> float
  text_top(text_baseline(r, style, valign), style)
end

export fn text_line_y(r: record, style: record) -> float
  text_line_y(r, style, "middle")
end

// ── Horizontal placement ──────────────────────────────────────────────────

// The x for a run of width `w` aligned in `r`. `align` is "left" | "center" |
// "right"; anything else reads as "left", so a caller may pass a value
// straight through from an options record without validating it.
export fn text_align_x(w: num, r: record, align: string) -> float
  match align
    when "center" -> float(r.x) + (float(r.w) - float(w)) / 2.0
    when "right" -> float(r.x) + float(r.w) - float(w)
    when _ -> float(r.x)
  end
end

// ── One line, placed and drawn ────────────────────────────────────────────

// Where `s` goes in `r`: `{x, y, w, baseline}`, with `y` ready for
// `draw_text`. Measures once and returns the width alongside, so a caller that
// needs to underline the run or place something after it does not measure
// again.
export fn text_place(s: string, r: record, style: record, align: string, valign: string) -> record
  let w = float(text_width(s, style))
  let base = text_baseline(r, style, valign)
  {x: text_align_x(w, r, align), y: base - text_metrics(style).baseline, w: w, baseline: base}
end

export fn text_place(s: string, r: record, style: record, align: string) -> record
  text_place(s, r, style, align, "middle")
end

// Draw one line of `s` in `r`, aligned horizontally and centred on its cap
// height vertically. Returns the run's width, which is what a caller laying
// out a row next to it wants.
//
// This is the drop-in for every `draw_text(s, {x: …, y: r.y + (r.h - size) / 2}, …)`
// in a codebase, and it is the whole fix for off-centre labels.
export fn draw_text_line(s: string, r: record, style: record, align: string, valign: string) -> float
  let p = text_place(s, r, style, align, valign)
  draw_text(s, {x: p.x, y: p.y}, style)
  p.w
end

export fn draw_text_line(s: string, r: record, style: record, align: string) -> float
  draw_text_line(s, r, style, align, "middle")
end

export fn draw_text_line(s: string, r: record, style: record) -> float
  draw_text_line(s, r, style, "left", "middle")
end

// Draw `s` on a baseline, aligned about `x` — for a caller that already knows
// its baseline (a chart axis, a run following another run) and wants nothing
// vertical decided for it.
export fn draw_text_baseline(s: string, x: num, baseline: num, style: record, align: string) -> float
  let w = float(text_width(s, style))
  let left = match align
    when "center" -> float(x) - w / 2.0
    when "right" -> float(x) - w
    when _ -> float(x)
  end
  draw_text(s, {x: left, y: float(baseline) - text_metrics(style).baseline}, style)
  w
end

export fn draw_text_baseline(s: string, x: num, baseline: num, style: record) -> float
  draw_text_baseline(s, x, baseline, style, "left")
end
