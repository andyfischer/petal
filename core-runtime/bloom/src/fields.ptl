# bloom/fields — the text fields and a property inspector's fields.
#
# The editing is `ui`'s: `ui.text_field_update` and `ui.text_area_update`
# hold the caret, the selection, the clipboard and undo, and own the
# keyboard through the runtime focus. bloom paints them and puts each one in
# its Tab ring. So a bloom field selects, copies, pastes and undoes like a
# desktop field, and shares one keyboard owner with any `ui` code beside it.
#
# Every field takes its focus id as `opts.id`. A field without one falls
# back to its placeholder, then to "field" — enough for the one search box
# of a panel, and wrong for two fields: give each its own id.
#
# The inspector fields (`commit_field`, `number_field`, `color_field`) apply
# only when the edit is done: the result holds the new value on the frame it
# is committed (Return, or the field losing the keyboard) and the old one,
# or nil, before. Escape abandons the edit and gives the focus up. Each keeps
# its edit in widget `state`, keyed per callsite — so in a loop, key it by
# the row (`for p in props key p.name do … end`).

# The drawing and input names used below come from the `ui` package, which
# this module imports itself: an import reaches only the file it is written
# in.
import bloom/theme: theme, ts, tone, hair, stroke, wash, rate
import bloom/motion: ease_to, ease_out, age
import bloom/interact: probe, focusable, pointer_free
import bloom/overlay: tooltip
import text_layout: text_baseline
import ui

# ── Shared ────────────────────────────────────────────────────────────────

# The focus id a field answers to: `opts.id`, else its placeholder, else
# "field". An int id is fine; the runtime compares ids as strings.
fn _field_id(opts: record) -> string
  str(field(opts, "id", field(opts, "placeholder", "field")))
end

# The text style a field measures and draws with: `opts.text_style` whole,
# or one built from `opts.size` and `opts.color` over the theme. One record
# for both halves, or click-to-place lands the caret off the glyphs.
fn _field_style(t: record, opts: record) -> record
  field(opts, "text_style", ts(t, field(opts, "size", t.font_md), field(opts, "color", t.text)))
end

# What `ui.text_field_update` / `ui.text_area_update` read from their style.
# The pointer stays out while a bloom overlay holds input, unless the field
# sits inside that overlay (a field in a dialog).
fn _update_style(t: record, r: record, opts: record, inset: num) -> record
  {...opts, text_style: _field_style(t, opts), inset: inset,
   pointer: field(opts, "pointer", true) && pointer_free(r)}
end

# The selection tint: the accent over the field's own face.
fn _sel_color(t: record, opts: record)
  field(opts, "selection", mix(field(opts, "bg", t.panel), t.accent, 0.35))
end

# The box every field is drawn in: a hairline that warms toward the accent
# on hover and takes it fully with the focus, and a focus underline that
# grows from the center out — the one motion that reads as "this field is
# taking your keys". `k` is the eased focus amount.
fn _field_box(t: record, r: record, opts: record, hot: num, k: num)
  let radius = field(opts, "radius", t.radius)
  let bg = field(opts, "bg", t.panel)
  let line = mix(mix(hair(t), t.accent, hot * 0.25), field(opts, "focus", t.accent), k)
  stroke(t, r, radius, line, 1, wash(t, bg, hot * 0.6, 0.0))
  let bar_w = r.w * ease_out(k)
  if bar_w > 1.0 then
    let by = r.y + r.h - 1.0
    draw_line({x: r.x + (r.w - bar_w) / 2.0, y: by}, {x: r.x + (r.w + bar_w) / 2.0, y: by},
      field(opts, "focus", t.accent), 255, 2)
  end
end

# The caret's on/off: a dt-driven blink (it also blinks in a headless trace,
# where the wall clock stands still), held on while the text is changing.
fn _caret_on(changed: bool) -> bool
  changed || fract(age() * 1.1) < 0.55
end

# ── Text field ────────────────────────────────────────────────────────────

# A single-line editor with a caret, a selection, the clipboard and undo.
# `buf` is the text (keep it in `state`); the field returns the edited one.
#
#   state name = ""
#   let res = bloom.text_field(r, name, {id: "name", placeholder: "Name"})
#   name = res.text
#   if res.submitted then … end
#
# Mouse: a click focuses and places the caret, shift+click extends the
# selection, a drag selects, a double click selects a word and a triple
# click everything; a press elsewhere gives the focus up. Keys: the arrows
# (alt/ctrl by word, cmd to either end, shift to select), backspace and
# delete (alt/ctrl by word, cmd to the start), cmd+A/C/X/V, cmd+Z and
# cmd+shift+Z / cmd+Y, Return (`submitted`) and Escape (`cancelled`).
#
# `opts`: id, placeholder, size, color, text_style, inset (theme pad_x),
# radius, bg, focus, caret, selection, scroll (true: the text scrolls to
# keep the caret in view), pointer (false keeps the mouse out this frame).
#
# Returns `ui.text_field_update`'s record — {text, caret, submitted,
# changed, anchor, sel_start, sel_end, scroll, overflow, blurred, cancelled}
# — plus `focused`.
pub fn text_field(r: record, buf: string) -> record
  text_field_impl(r, buf, {})
end

pub fn text_field(r: record, buf: string, opts: record) -> record
  text_field_impl(r, buf, opts)
end

# `text_field` is also a name in the `ui` package, which this module imports
# plainly. Inside one variant's own body the name means only that variant,
# so the short form cannot reach the long one directly — it would escape
# outward to `ui`'s set. Both forms, and the inspector fields, go through
# this private implementation instead.
fn text_field_impl(r: record, buf: string, opts: record) -> record
  let t = theme()
  let id = _field_id(opts)
  focusable(id)
  let inset = field(opts, "inset", t.pad_x)
  let res = text_field_update(id, r, buf,
    {..._update_style(t, r, opts, inset), scroll: field(opts, "scroll", true)})
  let has = has_focus(id)
  draw_field_impl(r, res, has, opts)
  {...res, focused: has}
end

# The paint half, for a caller that runs `ui.text_field_update` itself (to
# gate the keys, or to share one edit between two views). `res` is what the
# update returned (or any record with `text` and `caret`; the selection,
# `scroll` and `overflow` are read when present). `opts` as `text_field`'s —
# pass the update the same `text_style` and `inset`, or the caret drifts.
pub fn draw_text_field(r: record, res: record, focused: bool) -> record
  draw_field_impl(r, res, focused, {})
end

pub fn draw_text_field(r: record, res: record, focused: bool, opts: record) -> record
  draw_field_impl(r, res, focused, opts)
end

fn draw_field_impl(r: record, res: record, has: bool, opts: record) -> record
  let t = theme()
  let style = _field_style(t, opts)
  let inset = field(opts, "inset", t.pad_x)
  let p = probe(r)
  let k = ease_to(if has then 1.0 else 0.0 end, rate(t, 20.0))
  _field_box(t, r, opts, p.hot, k)

  let text = field(res, "text", "")
  let n = char_len(text)
  let radius = field(opts, "radius", t.radius)
  clip_push(pad(r, 2), radius)
  let tx = r.x + inset - field(res, "scroll", 0)
  # The run sits on the baseline that centers its cap height in the field,
  # and the caret and the selection span the line's real ink, ascent to
  # descent, rather than a guessed `size` px around a guessed top.
  let m = text_metrics(style)
  let base = text_baseline(r, style)
  let ty = base - m.baseline
  let top = base - m.cap_height - 3.0
  let bottom = base + m.descent + 2.0
  let s0 = clamp(field(res, "sel_start", 0), 0, n)
  let s1 = clamp(field(res, "sel_end", 0), 0, n)
  if has && s0 < s1 then
    let x0 = text_width(char_slice(text, 0, s0), style)
    let x1 = text_width(char_slice(text, 0, s1), style)
    draw_rect_rounded(Rect(tx + x0, top, x1 - x0, bottom - top), 2, _sel_color(t, opts))
  end
  let placeholder = field(opts, "placeholder", "")
  if n == 0 && placeholder != "" then
    draw_text(placeholder, {x: tx, y: ty}, {...style, color: t.dim})
  end
  draw_text(text, {x: tx, y: ty}, style)
  if has && _caret_on(field(res, "changed", false)) then
    let c = clamp(field(res, "caret", n), 0, n)
    let cx = tx + text_width(char_slice(text, 0, c), style)
    draw_line({x: cx, y: top + 1.0}, {x: cx, y: bottom - 1.0}, field(opts, "caret", t.accent), 255, 2)
  end
  clip_pop()
  res
end

# ── Text area ─────────────────────────────────────────────────────────────

# `text_field` for text with line breaks: notes, captions, a chat message.
# The text wraps to the box, Return starts a new line, and a box whose text
# is taller than it scrolls with the wheel and follows the caret. Beyond the
# field's keys: up / down by a row keeping the column, cmd+up / down to
# either end, home / end to the ends of the row.
#
# `opts`: as `text_field`'s, plus line_gap (2). Returns
# `ui.text_area_update`'s record — {text, caret, changed, anchor, sel_start,
# sel_end, scroll, overflow, rows, line_h, content_h} — plus `focused`.
# There is no `submitted`.
pub fn text_area(r: record, buf: string) -> record
  text_area_impl(r, buf, {})
end

pub fn text_area(r: record, buf: string, opts: record) -> record
  text_area_impl(r, buf, opts)
end

fn text_area_impl(r: record, buf: string, opts: record) -> record
  let t = theme()
  let id = _field_id(opts)
  focusable(id)
  let inset = field(opts, "inset", 8)
  let res = text_area_update(id, r, buf, _update_style(t, r, opts, inset))
  let has = has_focus(id)
  draw_area_impl(r, res, has, opts)
  {...res, focused: has}
end

# The paint half of `text_area`: the box, the selection, the rows, the caret
# and, when the text overflows, a scroll thumb. `res` is what
# `ui.text_area_update` returned.
pub fn draw_text_area(r: record, res: record, focused: bool) -> record
  draw_area_impl(r, res, focused, {})
end

pub fn draw_text_area(r: record, res: record, focused: bool, opts: record) -> record
  draw_area_impl(r, res, focused, opts)
end

fn draw_area_impl(r: record, res: record, has: bool, opts: record) -> record
  let t = theme()
  let style = _field_style(t, opts)
  let inset = field(opts, "inset", 8)
  let p = probe(r)
  let k = ease_to(if has then 1.0 else 0.0 end, rate(t, 20.0))
  _field_box(t, r, opts, p.hot, k)

  let tsize = field(style, "size", t.font_md)
  let lh = res.line_h
  let rows = res.rows
  let ox = r.x + inset
  let top = r.y + inset - res.scroll
  clip_push(pad(r, 2), field(opts, "radius", t.radius))
  if has && res.sel_start < res.sel_end then
    let sel = _sel_color(t, opts)
    for sr in text_range_rects(rows, style, res.sel_start, res.sel_end, lh) do
      draw_rect({x: ox + sr.x, y: top + sr.y, w: sr.w, h: sr.h}, sel)
    end
  end
  let placeholder = field(opts, "placeholder", "")
  if char_len(res.text) == 0 && placeholder != "" then
    draw_text(placeholder, {x: ox, y: top + (lh - tsize) / 2}, {...style, color: t.dim})
  end
  for i in range(0, len(rows)) do
    let y = top + i * lh
    if y + lh > r.y && y < r.y + r.h then
      draw_text(rows[i].text, {x: ox, y: y + (lh - tsize) / 2}, style)
    end
  end
  if has && _caret_on(res.changed) then
    let i = text_row_of(rows, res.caret)
    let row = rows[i]
    let cx = ox + text_width(char_slice(row.text, 0, clamp(res.caret - row.start, 0, row.end - row.start)), style)
    let cy = top + i * lh
    draw_line({x: cx, y: cy + 1}, {x: cx, y: cy + lh - 1}, field(opts, "caret", t.accent), 255, 2)
  end
  clip_pop()
  if res.overflow then
    # A thin thumb on the right edge, sized to the share of the text in view.
    let inner_h = r.h - 2 * inset
    let track_h = r.h - 8
    let th = max(12, track_h * inner_h / max(1, res.content_h))
    let span = max(1, res.content_h - inner_h)
    let ty = r.y + 4 + (track_h - th) * clamp(res.scroll, 0, span) / span
    draw_rect_rounded(Rect(r.x + r.w - 6, ty, 3, th), 1.5, mix(t.panel, t.text, 0.35))
  end
  res
end

# ── Inspector fields ──────────────────────────────────────────────────────

# One line of text that applies on Return or when the field loses the
# keyboard; Escape reverts. While unfocused it shows `current`. Returns
# {text, editing}: `text` is nil except on the frame the edit is applied.
# `opts` is `text_field`'s, plus `start`: take the keyboard as soon as the
# field shows (a rename opened by a double-click), rather than on a click.
pub fn commit_field(r: record, current) -> record
  commit_impl(r, current, {})
end

pub fn commit_field(r: record, current, opts: record) -> record
  commit_impl(r, current, opts)
end

fn commit_impl(r: record, current, opts: record) -> record
  let id = _field_id(opts)
  state buf = ""
  state editing = false
  let out = nil
  if field(opts, "start", false) && !editing && !has_focus(id) then
    focus_request(id)
  end
  let res = text_field_impl(r, if editing then buf else str(current ?? "") end, opts)
  if has_focus(id) then
    if !editing then
      editing = true
    end
    buf = res.text
    if res.cancelled then
      focus_request(nil)
      editing = false
    elsif res.submitted then
      out = buf
      focus_request(nil)
      editing = false
    end
  elsif editing then
    # The keyboard went elsewhere (a click, Tab) mid-edit: apply it.
    editing = false
    out = buf
  end
  {text: out, editing: editing}
end

# A number box: drag sideways to scrub (shift for fine steps), double-click
# to type, Return or a click away to apply the typed value, Escape to drop
# it. Returns {value, changed}: `value` is the new value (the old one when
# nothing happened), `changed` whether it differs.
#
# `opts`: id, step (1.0 per pixel of drag), places (2, decimals shown and
# typed), min, max, fine (0.1, the shift multiplier), tip (the hover hint;
# "" for none), size, color, bg, radius.
pub fn number_field(r: record, value: num) -> record
  number_impl(r, value, {})
end

pub fn number_field(r: record, value: num, opts: record) -> record
  number_impl(r, value, opts)
end

fn number_impl(r: record, value: num, opts: record) -> record
  let t = theme()
  let id = _field_id(opts)
  let places = field(opts, "places", 2)
  state buf = ""
  state editing = false
  state last_x = 0
  let out = value
  if has_focus(id) then
    # Typing: entered by a double-click, or by the focus arriving (Tab).
    if !editing then
      buf = fixed(float(value), places)
      editing = true
    end
    let res = text_field_impl(r, buf, {size: t.font_sm, ...opts})
    buf = res.text
    if res.cancelled then
      focus_request(nil)
      editing = false
    elsif res.submitted || !has_focus(id) then
      let v = parse_float(trim(buf))
      if v != nil then out = v end
      focus_request(nil)
      editing = false
    end
  else
    if editing then
      # The focus went elsewhere while typing (a click, Tab): keep the value.
      editing = false
      let v = parse_float(trim(buf))
      if v != nil then out = v end
    end
    # Still in the Tab ring while it shows its value: Tab lands on it and
    # it opens for typing.
    focusable(id)
    let p = probe(r)
    let it = interact(r, id)
    let live = pointer_free(r)
    let radius = field(opts, "radius", t.radius_sm)
    let bg = field(opts, "bg", tone(t, t.panel, 0.25))
    draw_rect_rounded(r, radius, wash(t, bg, p.hot, p.active))
    let style = ts(t, field(opts, "size", t.font_sm), field(opts, "color", t.text))
    let shown = text_ellipsize(fixed(float(value), places), style, r.w - 6)
    draw_text(shown, {x: r.x + (r.w - text_width(shown, style)) / 2.0,
      y: text_baseline(r, style) - text_metrics(style).baseline}, style)
    # The drag is measured from the pointer itself, not `mouse_dx()`, so it
    # scrubs in hosts that report no relative motion.
    if live && it.down && !it.pressed && mouse_x() != last_x then
      let k = if mod_shift() then field(opts, "fine", 0.1) else 1.0 end
      out = float(value) + float(mouse_x() - last_x) * float(field(opts, "step", 1.0)) * k
    end
    last_x = mouse_x()
    if live && it.pressed && click_count() == 2 then
      focus_request(id)
    end
    let tip = field(opts, "tip", "drag to change · shift for fine · double-click to type")
    if tip != "" then tooltip(r, tip) end
  end
  if out != value then
    let lo = field(opts, "min", nil)
    let hi = field(opts, "max", nil)
    if lo != nil then out = max(out, lo) end
    if hi != nil then out = min(out, hi) end
  end
  {value: out, changed: out != value}
end

# A colour chip and its hex, typed: Return or a click away applies, Escape
# reverts. Returns {color}: nil unless a valid new colour was entered. A nil
# `color` shows an empty chip and field. `opts` is `commit_field`'s, plus
# chip_radius and outline.
pub fn color_field(r: record, color) -> record
  color_impl(r, color, {})
end

pub fn color_field(r: record, color, opts: record) -> record
  color_impl(r, color, opts)
end

fn color_impl(r: record, color, opts: record) -> record
  let t = theme()
  let chip = Rect(r.x, r.y + 3, r.h - 6, r.h - 6)
  let cr = field(opts, "chip_radius", t.radius_sm)
  if color != nil then draw_rect_rounded(chip, cr, color) end
  draw_rect_rounded_outline(chip, cr, field(opts, "outline", hair(t)), 255, 1)
  let fr = Rect(r.x + r.h, r.y, r.w - r.h, r.h)
  let shown = if color == nil then "" else color_to_hex(color) end
  let res = commit_impl(fr, shown, {placeholder: "#rrggbb", size: t.font_sm, ...opts})
  let picked = if res.text == nil then nil else color_from_hex(res.text) end
  {color: if same_color(picked, color) then nil else picked end}
end

# A row of square colour chips, `r.h` on a side, `current` ringed; chips
# that would overrun `r.w` are left out. Returns the colour clicked (on
# release, like every bloom control), or nil. `opts`: gap (4), radius,
# ring, hover.
pub fn swatches(r: record, colors: list, current) -> any
  swatches_impl(r, colors, current, {})
end

pub fn swatches(r: record, colors: list, current, opts: record) -> any
  swatches_impl(r, colors, current, opts)
end

fn swatches_impl(r: record, colors: list, current, opts: record) -> any
  let t = theme()
  let picked = nil
  let size = r.h
  let gap = field(opts, "gap", 4)
  let rad = field(opts, "radius", t.radius_sm)
  for i in range(0, len(colors)) do
    let c = colors[i]
    let cr = Rect(r.x + i * (size + gap), r.y, size, size)
    if cr.x + cr.w <= r.x + r.w then
      let p = probe(cr)
      draw_rect_rounded(cr, rad, c)
      if same_color(c, current) then
        draw_rect_rounded_outline(pad(cr, -2), rad + 1, field(opts, "ring", t.accent), 255, 2)
      elsif p.hot > 0.01 then
        draw_rect_rounded_outline(pad(cr, -1), rad + 1, field(opts, "hover", mix(hair(t), t.text, 0.4)),
          int(255 * p.hot), 1)
      end
      if p.click then picked = c end
    end
  end
  picked
end
