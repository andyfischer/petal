// =====================================================================
// SIDE-SCROLLER  -  written in Petal, hosted by petal-sdl
// =====================================================================
//     ./examples/games/side-scroller/run-game.sh
//
// A whole platformer in one script: physics, collision, enemies, camera
// and every pixel of the render. Levels are plain text (levels/*.lvl),
// authored by the editor next door (run-editor.sh).
//
// Press ENTER on the title to start, R to restart a level, ESC to pause.
// =====================================================================

// ----------------------------- TUNING ---------------------------------

let GRAVITY        = 1500.0
let MOVE_SPEED     = 230.0
let AIR_ACCEL      = 1400.0
let GROUND_ACCEL   = 2400.0
let FRICTION       = 1800.0
let JUMP_VY        = -540.0
let JUMP_CUT       = 0.45        // multiply vy by this when jump released early
let MAX_FALL       = 900.0
let COYOTE_MAX     = 0.10
let JUMP_BUF_MAX   = 0.12
let INVUL_MAX      = 1.2
let PLAYER_W       = 22
let PLAYER_H       = 30
let SCREEN_W       = 960
let SCREEN_H       = 600

// ----------------------------- PHASES ---------------------------------

enum Phase
  Title,
  Playing,
  Paused,
  Dying,
  Complete,
  GameOver,
  AllDone,
end

// ----------------------------- STATE ----------------------------------
//
// Anything a function writes is a `state var`, written with `set`: a function
// cannot rebind a name from an enclosing scope, so `=` inside one would build
// a local shadow instead. The rest are plain `state`, rebound with `=` by the
// frame body below, where the rebind is a real dataflow edge.

state phase            = Title
state level_idx        = 0
state var level_loaded = -1
state var level        = nil
state level_files      = [
  "side-scroller/levels/01_first_steps.lvl",
  "side-scroller/levels/02_cavern.lvl",
  "side-scroller/levels/03_sky_ruins.lvl"
]
state level_titles     = ["First Steps", "Cavern Dive", "Sky Ruins"]
state best_times       = [9999.0, 9999.0, 9999.0]
state best_coins       = [0, 0, 0]

// Player physics
state var px           = 100.0
state var py           = 400.0
state var vx           = 0.0
state var vy           = 0.0
state var on_ground    = false
state var facing       = 1
state var coyote       = 0.0
state var jump_buf     = 0.0
state var invul        = 0.0
state var squash       = 1.0          // height scale: < 1 is squat
state var stretch      = 1.0          // width scale:  > 1 is wide
state lives            = 3
state var coins_got    = 0
state var level_timer  = 0.0
state var checkpoint   = nil

// Camera
state var cam_x        = 0.0
state cam_target       = 0.0
state var shake        = 0.0
state shake_dx         = 0.0
state shake_dy         = 0.0

// Visual extras
state var particles    = []
state var floats       = []           // floating "+1" texts etc.
state title_t          = 0.0
state menu_idx         = 0
state phase_t          = 0.0          // time spent in current phase
state var toast        = ""
state var toast_t      = 0.0

// ----------------------------- HELPERS --------------------------------

fn clamp(v: num, lo: num, hi: num) -> num
  max(lo, min(v, hi))
end
fn approach(cur: num, target: num, step: num) -> num
  if cur < target then
    min(cur + step, target)
  else
    max(cur - step, target)
  end
end
fn aabb(ax: num, ay: num, aw: num, ah: num, bx: num, by: num, bw: num, bh: num) -> bool
  ax < bx + bw && ax + aw > bx && ay < by + bh && ay + ah > by
end

// String -> float / int parse helpers used by the level loader.
// Petal's int()/float() work on numeric strings, so we just delegate.
fn parse_int(s: string) -> int
  int(s)
end
fn parse_float(s: string) -> float
  float(s)
end

// ----------------------------- LEVEL I/O ------------------------------

fn empty_level() -> record
  {
    name: "Untitled",
    width: 2400,
    bg_r: 110, bg_g: 180, bg_b: 240,
    start: {x: 100.0, y: 400.0},
    goal:  {x: 2200.0, y: 400.0},
    plats: [],
    oneways: [],
    coins: [],
    spikes: [],
    enemies: [],
    checks: []
  }
end

fn parse_level(src: string) -> record
  let L = empty_level()
  let lines = split(src, "\n")
  for raw in lines do
    let toks = split(raw, " ")
    if len(toks) == 0 then continue end
    let tag = toks[0]
    if tag == "" then continue end
    if tag == "name" then
      // join everything after the tag so multi-word names work
      L.name = join(slice(toks, start: 1, end: len(toks)), " ")
    elsif tag == "width" then
      L.width = parse_int(toks[1])
    elsif tag == "bg" then
      L.bg_r = parse_int(toks[1])
      L.bg_g = parse_int(toks[2])
      L.bg_b = parse_int(toks[3])
    elsif tag == "start" then
      L.start = {x: parse_float(toks[1]), y: parse_float(toks[2])}
    elsif tag == "goal" then
      L.goal = {x: parse_float(toks[1]), y: parse_float(toks[2])}
    elsif tag == "plat" then
      L.plats = append(L.plats, {
        x: parse_int(toks[1]), y: parse_int(toks[2]),
        w: parse_int(toks[3]), h: parse_int(toks[4])
      })
    elsif tag == "oneway" then
      L.oneways = append(L.oneways, {
        x: parse_int(toks[1]), y: parse_int(toks[2]),
        w: parse_int(toks[3])
      })
    elsif tag == "coin" then
      L.coins = append(L.coins, {
        x: parse_int(toks[1]), y: parse_int(toks[2]),
        collected: false
      })
    elsif tag == "spike" then
      L.spikes = append(L.spikes, {x: parse_int(toks[1]), y: parse_int(toks[2])})
    elsif tag == "goomba" then
      // y here is the surface y (plat top); enemy stands on it
      let sx = parse_float(toks[1])
      let sy = parse_float(toks[2])
      let pat = parse_float(toks[3])
      L.enemies = append(L.enemies, {
        kind: "goomba",
        x: sx, y: sy - 22.0,
        vx: -55.0, vy: 0.0,
        origin: sx, origin_y: sy - 22.0, patrol: pat,
        alive: true, squash: 0.0, anim: 0.0
      })
    elsif tag == "jumper" then
      let sx = parse_float(toks[1])
      let sy = parse_float(toks[2])
      L.enemies = append(L.enemies, {
        kind: "jumper",
        x: sx, y: sy - 24.0,
        vx: 0.0, vy: 0.0,
        origin: sx, origin_y: sy - 24.0, patrol: 0.0,
        alive: true, squash: 0.0, anim: 0.0
      })
    elsif tag == "check" then
      L.checks = append(L.checks, {x: parse_int(toks[1]), y: parse_int(toks[2])})
    else
      // unknown tag: ignore the line
    end
  end
  L
end

fn load_level(idx) -> record
  let path = level_files[idx]
  let src = load_text_file(path)
  if len(src) == 0 then
    // file missing — fall back to a tiny default
    let L = empty_level()
    L.name = "Missing: {path}"
    L
  else
    parse_level(src)
  end
end

// ----------------------------- RESET ----------------------------------

fn respawn_player()
  let spawn = get level.start
  if get checkpoint != nil then spawn = get checkpoint end
  set px = spawn.x
  set py = spawn.y
  set vx = 0.0
  set vy = 0.0
  set on_ground = false
  set facing = 1
  set coyote = 0.0
  set jump_buf = 0.0
  set invul = INVUL_MAX
  set squash = 1.0
  set stretch = 1.0
end

fn restart_level()
  set level = load_level(level_idx)
  set level_loaded = level_idx
  set checkpoint = nil
  set coins_got = 0
  set level_timer = 0.0
  set particles = []
  set floats = []
  set cam_x = 0.0
  set shake = 0.0
  respawn_player()
end

fn say(msg: string)
  set toast = msg
  set toast_t = 1.6
end

// ----------------------------- INPUT FRAME ----------------------------

let dts = dt()
phase_t += dts
title_t += dts
set toast_t = max(0.0, toast_t - dts)

// Lazy-load the level on the way into Playing.
if phase == Playing && level_loaded != level_idx then
  restart_level()
end

// ===================== TITLE SCREEN ==================================

if phase == Title then
  if key_pressed("up")    then menu_idx = max(0, menu_idx - 1) end
  if key_pressed("down")  then menu_idx = min(len(level_files) - 1, menu_idx + 1) end
  if key_pressed("return") || key_pressed("space") then
    level_idx = menu_idx
    phase = Playing
    phase_t = 0.0
    restart_level()
  end
end

// ===================== PLAYING =======================================

if phase == Playing then
  set level_timer += dts

  // --- input ---
  let want_left  = key_down("left")  || key_down("a")
  let want_right = key_down("right") || key_down("d")
  let want_jump  = key_pressed("space") || key_pressed("up") || key_pressed("w")
  let jump_held  = key_down("space") || key_down("up") || key_down("w")

  if want_jump then set jump_buf = JUMP_BUF_MAX end
  set jump_buf = max(0.0, jump_buf - dts)

  let target_vx = 0.0
  if want_left  then target_vx = target_vx - MOVE_SPEED; set facing = -1 end
  if want_right then target_vx = target_vx + MOVE_SPEED; set facing = 1 end

  let accel = if on_ground then GROUND_ACCEL else AIR_ACCEL end
  if target_vx == 0.0 then
    // friction
    let fr = if on_ground then FRICTION else AIR_ACCEL * 0.4 end
    set vx = approach(cur: vx, target: 0.0, step: fr * dts)
  else
    set vx = approach(cur: vx, target: target_vx, step: accel * dts)
  end

  // jump
  if jump_buf > 0.0 && (on_ground || coyote > 0.0) then
    set vy = JUMP_VY
    set on_ground = false
    set coyote = 0.0
    set jump_buf = 0.0
    set squash = 0.7
    set stretch = 1.25
    // dust puff
    let i = 0
    while i < 8 do
      set particles = append(particles, {
        kind: "dust",
        x: px + float(PLAYER_W) / 2.0 + random(-6.0, 6.0),
        y: py + float(PLAYER_H),
        vx: random(-90.0, 90.0),
        vy: random(-120.0, -20.0),
        life: random(0.25, 0.55),
        size: random(2.0, 5.0)
      })
      i = i + 1
    end
  end

  // variable jump height
  if !jump_held && vy < 0.0 then set vy = vy * JUMP_CUT end

  // gravity
  set vy = min(MAX_FALL, vy + GRAVITY * dts)

  // --- horizontal move + collision ---
  let new_px = px + vx * dts
  let pw = float(PLAYER_W)
  let ph = float(PLAYER_H)
  for p in level.plats do
    let plx = float(p.x); let ply = float(p.y)
    let plw = float(p.w); let plh = float(p.h)
    if aabb(ax: new_px, ay: py, aw: pw, ah: ph, bx: plx, by: ply, bw: plw, bh: plh) then
      if vx > 0.0 then new_px = plx - pw elsif vx < 0.0 then new_px = plx + plw end
      set vx = 0.0
    end
  end
  set px = new_px

  // --- vertical move + collision ---
  let new_py = py + vy * dts
  set on_ground = false
  for p in level.plats do
    let plx = float(p.x); let ply = float(p.y)
    let plw = float(p.w); let plh = float(p.h)
    if aabb(ax: px, ay: new_py, aw: pw, ah: ph, bx: plx, by: ply, bw: plw, bh: plh) then
      if vy > 0.0 then
        new_py = ply - ph
        if !on_ground then
          // landing dust
          let i = 0
          while i < int(min(8.0, vy / 80.0)) do
            set particles = append(particles, {
              kind: "dust",
              x: px + random(0.0, pw),
              y: new_py + ph,
              vx: random(-60.0, 60.0),
              vy: random(-50.0, -10.0),
              life: random(0.2, 0.4),
              size: random(2.0, 4.0)
            })
            i = i + 1
          end
          if vy > 500.0 then set shake = max(shake, 6.0) end
          set squash = 0.75
          set stretch = 1.15
        end
        set on_ground = true
        set vy = 0.0
      elsif vy < 0.0 then
        new_py = ply + plh
        set vy = 0.0
      end
    end
  end
  // one-way platforms — only collide when falling and previously above
  for o in level.oneways do
    let ox = float(o.x); let oy = float(o.y); let ow = float(o.w)
    if vy > 0.0 && py + ph <= oy + 1.0 then
      if aabb(ax: px, ay: new_py, aw: pw, ah: ph, bx: ox, by: oy, bw: ow, bh: 8.0) then
        new_py = oy - ph
        set vy = 0.0
        set on_ground = true
        set squash = 0.85
        set stretch = 1.07
      end
    end
  end
  set py = new_py

  // coyote time
  if on_ground then set coyote = COYOTE_MAX else set coyote = max(0.0, coyote - dts) end

  // --- coin pickup ---
  for c in level.coins do
    if !c.collected then
      let cx = float(c.x); let cy = float(c.y)
      if abs(px + pw / 2.0 - cx) < 18.0 && abs(py + ph / 2.0 - cy) < 22.0 then
        c.collected = true
        set coins_got = coins_got + 1
        set floats = append(floats, {x: cx, y: cy, vy: -40.0, life: 0.8, text: "+1"})
        let i = 0
        while i < 10 do
          set particles = append(particles, {
            kind: "spark",
            x: cx, y: cy,
            vx: random(-180.0, 180.0),
            vy: random(-220.0, -40.0),
            life: random(0.35, 0.7),
            size: random(2.0, 4.0)
          })
          i = i + 1
        end
      end
    end
  end

  // --- enemies update ---
  for e in level.enemies do
    if !e.alive then continue end
    e.anim = e.anim + dts
    if e.kind == "goomba" then
      // patrol: bounce at patrol distance
      e.x = e.x + e.vx * dts
      if e.patrol > 0.0 && abs(e.x - e.origin) > e.patrol then
        e.vx = -e.vx
        e.x = e.x + e.vx * dts
      end
      // collision with player
      if invul <= 0.0 && aabb(ax: px, ay: py, aw: pw, ah: ph, bx: e.x, by: e.y, bw: 24.0, bh: 22.0) then
        if vy > 50.0 && py + ph - 14.0 < e.y then
          e.alive = false
          e.squash = 1.0
          set vy = JUMP_VY * 0.6
          set floats = append(floats, {x: e.x + 12.0, y: e.y, vy: -30.0, life: 0.7, text: "POW"})
          let i = 0
          while i < 8 do
            set particles = append(particles, {
              kind: "puff",
              x: e.x + 12.0, y: e.y + 11.0,
              vx: random(-150.0, 150.0),
              vy: random(-200.0, -40.0),
              life: random(0.3, 0.6),
              size: random(3.0, 6.0)
            })
            i = i + 1
          end
        else
          // got hit
          set invul = INVUL_MAX
          lives = lives - 1
          set shake = 14.0
          set vx = float(-facing) * 220.0
          set vy = -260.0
        end
      end
    elsif e.kind == "jumper" then
      // sinusoidal bounce around its origin_y
      let bounce = abs(sin(e.anim * 4.0)) * 60.0
      e.y = e.origin_y - bounce
      // collision with player
      if invul <= 0.0 && aabb(ax: px, ay: py, aw: pw, ah: ph, bx: e.x, by: e.y, bw: 24.0, bh: 22.0) then
        if vy > 50.0 && py + ph - 14.0 < e.y then
          e.alive = false
          set vy = JUMP_VY * 0.6
          set floats = append(floats, {x: e.x + 12.0, y: e.y, vy: -30.0, life: 0.7, text: "BONK"})
          let i = 0
          while i < 8 do
            set particles = append(particles, {
              kind: "puff",
              x: e.x + 12.0, y: e.y + 11.0,
              vx: random(-150.0, 150.0),
              vy: random(-200.0, -40.0),
              life: random(0.3, 0.6),
              size: random(3.0, 6.0)
            })
            i = i + 1
          end
        else
          set invul = INVUL_MAX
          lives = lives - 1
          set shake = 14.0
          set vx = float(-facing) * 220.0
          set vy = -260.0
        end
      end
    end
  end

  // --- spikes ---
  for s in level.spikes do
    if invul <= 0.0 then
      if aabb(ax: px, ay: py, aw: pw, ah: ph, bx: float(s.x), by: float(s.y), bw: 24.0, bh: 16.0) then
        set invul = INVUL_MAX
        lives = lives - 1
        set shake = 16.0
        set vy = -360.0
        set vx = float(-facing) * 200.0
        set floats = append(floats, {x: px + pw / 2.0, y: py, vy: -40.0, life: 1.0, text: "OUCH"})
      end
    end
  end

  // --- checkpoints ---
  for ck in level.checks do
    if aabb(ax: px, ay: py, aw: pw, ah: ph, bx: float(ck.x) - 8.0, by: float(ck.y) - 30.0, bw: 32.0, bh: 50.0) then
      if checkpoint == nil || float(ck.x) > checkpoint.x then
        set checkpoint = {x: float(ck.x), y: float(ck.y) - float(PLAYER_H)}
        say("Checkpoint!")
      end
    end
  end

  // --- goal ---
  let gx = level.goal.x
  let gy = level.goal.y
  if aabb(ax: px, ay: py, aw: pw, ah: ph, bx: gx - 6.0, by: gy - 60.0, bw: 24.0, bh: 80.0) then
    phase = Complete
    phase_t = 0.0
    if level_timer < best_times[level_idx] then
      best_times[level_idx] = level_timer
    end
    if coins_got > best_coins[level_idx] then
      best_coins[level_idx] = coins_got
    end
  end

  // --- fall off world ---
  if py > 700.0 && phase == Playing then
    set invul = INVUL_MAX
    lives = lives - 1
    set shake = 14.0
    respawn_player()
  end

  // --- check death ---
  if lives <= 0 && phase == Playing then
    phase = GameOver
    phase_t = 0.0
  end

  set invul = max(0.0, invul - dts)

  // --- restart ---
  if key_pressed("r") then
    restart_level()
  end
  if key_pressed("escape") || key_pressed("p") then
    phase = Paused
    phase_t = 0.0
  end

  // --- camera follow ---
  let target = px + pw / 2.0 - float(SCREEN_W) / 2.0
  target = clamp(target, lo: 0.0, hi: float(level.width) - float(SCREEN_W))
  cam_target = target
  set cam_x = approach(cur: cam_x, target: cam_target, step: abs(cam_target - cam_x) * 6.0 * dts + 50.0 * dts)

  // squash/stretch decay
  set squash = approach(cur: squash, target: 1.0, step: 4.0 * dts)
  set stretch = approach(cur: stretch, target: 1.0, step: 4.0 * dts)
end

// ===================== PAUSE / COMPLETE / OVER =======================

if phase == Paused then
  if key_pressed("escape") || key_pressed("p") then
    phase = Playing
    phase_t = 0.0
  end
  if key_pressed("r") then phase = Playing; restart_level() end
  if key_pressed("q") then phase = Title; phase_t = 0.0 end
end

if phase == Complete then
  if phase_t > 0.6 then
    if key_pressed("return") || key_pressed("space") then
      if level_idx + 1 < len(level_files) then
        level_idx = level_idx + 1
        phase = Playing
        phase_t = 0.0
        restart_level()
      else
        phase = AllDone
        phase_t = 0.0
      end
    end
    if key_pressed("q") then phase = Title; phase_t = 0.0 end
  end
end

if phase == GameOver then
  if phase_t > 0.6 then
    if key_pressed("return") || key_pressed("space") then
      lives = 3
      phase = Playing
      phase_t = 0.0
      set checkpoint = nil
      restart_level()
    end
    if key_pressed("q") then
      lives = 3
      phase = Title
      phase_t = 0.0
    end
  end
end

if phase == AllDone then
  if key_pressed("return") || key_pressed("q") then
    phase = Title
    lives = 3
    phase_t = 0.0
  end
end

// ===================== UPDATE: PARTICLES, FLOATS, SHAKE ==============

set particles = map(particles, fn(p)
  {
    kind: p.kind,
    x: p.x + p.vx * dts,
    y: p.y + p.vy * dts,
    vx: p.vx * 0.96,
    vy: p.vy + 380.0 * dts,
    life: p.life - dts,
    size: p.size
  }
end)
set particles = filter(particles, fn(p) -> p.life > 0.0)

set floats = map(floats, fn(f)
  {x: f.x, y: f.y + f.vy * dts, vy: f.vy * 0.92, life: f.life - dts, text: f.text}
end)
set floats = filter(floats, fn(f) -> f.life > 0.0)

if shake > 0.0 then
  set shake = max(0.0, shake - 40.0 * dts)
  shake_dx = random(-shake, shake)
  shake_dy = random(-shake, shake)
else
  shake_dx = 0.0
  shake_dy = 0.0
end

// =====================================================================
//                              DRAWING
// =====================================================================

fn cam_offset_x() -> int
  int(get cam_x - shake_dx)
end
fn cam_offset_y() -> int
  int(0.0 - shake_dy)
end

fn draw_at(x: num, y: num, w: num, h: num, r: num, g: num, b: num)
  draw_rect(x - cam_offset_x(), y - cam_offset_y(), w, h, r, g, b)
end
fn circ_at(x: num, y: num, rad: num, r: num, g: num, b: num)
  draw_circle(cx: x - cam_offset_x(), cy: y - cam_offset_y(), radius: rad, r: r, g: g, b: b)
end
fn line_at(x1: num, y1: num, x2: num, y2: num, r: num, g: num, b: num)
  draw_line(x1 - cam_offset_x(), y1 - cam_offset_y(),
    x2 - cam_offset_x(), y2 - cam_offset_y(), r, g, b)
end
fn text_at(t: string, x: num, y: num, sz: num, r: num, g: num, b: num)
  draw_text(t, x: x - cam_offset_x(), y: y - cam_offset_y(), size: sz, r: r, g: g, b: b)
end

fn draw_sky()
  // gradient
  let row = 0
  while row < 12 do
    let sy = row * 50
    let t = float(row) / 11.0
    let r = int(float(get level.bg_r) * (1.0 - t) + 240.0 * t)
    let g = int(float(get level.bg_g) * (1.0 - t) + 220.0 * t)
    let b = int(float(get level.bg_b) * (1.0 - t) + 200.0 * t)
    draw_rect(x: 0, y: sy, w: SCREEN_W, h: 55, r: r, g: g, b: b)
    row = row + 1
  end
end

fn draw_parallax_mountains()
  // two layers, different parallax speeds
  let off1 = int(get cam_x * 0.2)
  let m = 0
  while m < 10 do
    let mx = m * 220 - (off1 % 220) - 60
    let mh = 90 + (m % 4) * 25
    let my = 480 - mh
    let r = 60; let g = 80; let b = 110
    draw_circle(cx: mx + 110, cy: my + mh + 30, radius: mh + 30, r: r, g: g, b: b)
    m = m + 1
  end
  let off2 = int(get cam_x * 0.4)
  let n = 0
  while n < 12 do
    let nx = n * 180 - (off2 % 180) - 40
    let nh = 70 + (n % 3) * 20
    let ny = 510 - nh
    draw_circle(cx: nx + 90, cy: ny + nh + 25, radius: nh + 25, r: 90, g: 110, b: 140)
    n = n + 1
  end
end

fn draw_clouds()
  let off = int(get cam_x * 0.1) + frame_count() / 4
  let c = 0
  while c < 8 do
    let cx = (c * 240 - (off % 240)) % (SCREEN_W + 240) - 120
    let cy = 60 + (c % 3) * 30
    let cw = 70 + (c % 2) * 20
    draw_circle(cx: cx + cw / 3, cy: cy + 8, radius: cw / 4, r: 235, g: 240, b: 250)
    draw_circle(cx: cx + cw * 2 / 3, cy: cy + 8, radius: cw / 4, r: 235, g: 240, b: 250)
    draw_circle(cx: cx + cw / 2, cy: cy, radius: cw / 3, r: 245, g: 248, b: 252)
    c = c + 1
  end
end

fn draw_platforms()
  for p in get level.plats do
    // dirt body
    draw_at(x: p.x, y: p.y + 4, w: p.w, h: p.h - 4, r: 110, g: 70, b: 40)
    draw_at(x: p.x, y: p.y + p.h - 3, w: p.w, h: 3, r: 80, g: 50, b: 28)
    // grass top
    draw_at(x: p.x, y: p.y, w: p.w, h: 6, r: 60, g: 170, b: 55)
    draw_at(x: p.x, y: p.y, w: p.w, h: 2, r: 90, g: 210, b: 70)
    // blades
    let i = 0
    while i < p.w / 24 do
      let bx = p.x + i * 24 + 4
      line_at(x1: bx, y1: p.y, x2: bx - 1, y2: p.y - 4, r: 70, g: 200, b: 70)
      i = i + 1
    end
  end
  for o in get level.oneways do
    // wooden plank
    draw_at(x: o.x, y: o.y, w: o.w, h: 6, r: 200, g: 160, b: 90)
    draw_at(x: o.x, y: o.y + 3, w: o.w, h: 3, r: 160, g: 120, b: 70)
    let i = 0
    while i < o.w / 30 do
      line_at(x1: o.x + i * 30 + 10, y1: o.y, x2: o.x + i * 30 + 10, y2: o.y + 6, r: 130, g: 90, b: 50)
      i = i + 1
    end
  end
end

fn draw_spikes()
  for s in get level.spikes do
    let bx = s.x
    let by = s.y
    // 2 triangle spikes per tile (24 wide)
    line_at(x1: bx + 2, y1: by + 16, x2: bx + 8, y2: by, r: 220, g: 220, b: 230)
    line_at(x1: bx + 8, y1: by, x2: bx + 14, y2: by + 16, r: 220, g: 220, b: 230)
    line_at(x1: bx + 2, y1: by + 16, x2: bx + 14, y2: by + 16, r: 220, g: 220, b: 230)
    line_at(x1: bx + 12, y1: by + 16, x2: bx + 18, y2: by + 4, r: 200, g: 200, b: 210)
    line_at(x1: bx + 18, y1: by + 4, x2: bx + 22, y2: by + 16, r: 200, g: 200, b: 210)
  end
end

fn draw_coins()
  let fc = frame_count()
  for c in get level.coins do
    if !c.collected then
      let bob = ((fc + c.x * 3) % 40)
      let off = if bob < 20 then bob / 5 - 2 else 2 - (bob - 20) / 5 end
      let cy = c.y + off
      circ_at(x: c.x, y: cy, rad: 11, r: 180, g: 140, b: 20)
      circ_at(x: c.x, y: cy, rad: 8, r: 255, g: 210, b: 40)
      circ_at(x: c.x - 2, y: cy - 2, rad: 4, r: 255, g: 240, b: 130)
      let sp = (fc + c.x * 7) % 30
      if sp < 10 then
        line_at(x1: c.x + 7, y1: cy - 7, x2: c.x + 13, y2: cy - 7, r: 255, g: 255, b: 200)
        line_at(x1: c.x + 10, y1: cy - 10, x2: c.x + 10, y2: cy - 4, r: 255, g: 255, b: 200)
      end
    end
  end
end

fn draw_checks()
  for ck in get level.checks do
    let lit = get checkpoint != nil && abs(get checkpoint.x - float(ck.x)) < 4.0
    let pole_r = if lit then 230 else 110 end
    let pole_g = if lit then 230 else 110 end
    let pole_b = if lit then 240 else 130 end
    draw_at(x: ck.x + 6, y: ck.y - 32, w: 3, h: 32, r: pole_r, g: pole_g, b: pole_b)
    let flag_r = if lit then 240 else 100 end
    let flag_g = if lit then 80  else 100 end
    let flag_b = if lit then 90  else 100 end
    draw_at(x: ck.x + 9, y: ck.y - 30, w: 14, h: 9, r: flag_r, g: flag_g, b: flag_b)
  end
end

fn draw_enemies()
  let fc = frame_count()
  for e in get level.enemies do
    if !e.alive then continue end
    if e.kind == "goomba" then
      let walk = (fc + int(e.x)) % 16
      let foot_off = if walk < 8 then 0 else 2 end
      // body
      draw_at(x: int(e.x) + 2, y: int(e.y) + 4, w: 20, h: 18, r: 120, g: 70, b: 30)
      // belly
      draw_at(x: int(e.x) + 5, y: int(e.y) + 10, w: 14, h: 10, r: 200, g: 160, b: 90)
      // eyes
      draw_at(x: int(e.x) + 6, y: int(e.y) + 6, w: 4, h: 5, r: 255, g: 255, b: 255)
      draw_at(x: int(e.x) + 14, y: int(e.y) + 6, w: 4, h: 5, r: 255, g: 255, b: 255)
      let pup = if e.vx < 0.0 then 0 else 2 end
      draw_at(x: int(e.x) + 7 + pup, y: int(e.y) + 8, w: 2, h: 3, r: 30, g: 30, b: 30)
      draw_at(x: int(e.x) + 15 + pup, y: int(e.y) + 8, w: 2, h: 3, r: 30, g: 30, b: 30)
      // feet
      draw_at(x: int(e.x) + 2, y: int(e.y) + 22 - foot_off, w: 8, h: 4, r: 60, g: 30, b: 10)
      draw_at(x: int(e.x) + 14, y: int(e.y) + 22 + foot_off, w: 8, h: 4, r: 60, g: 30, b: 10)
    elsif e.kind == "jumper" then
      // e.y already carries the bounce from the update loop
      let by = int(e.y)
      // small squash when near apex
      let bphase = (e.anim * 4.0) % 3.14159
      let stretchy = if bphase < 1.5 && bphase > 0.5 then 1 else 0 end
      // body (slime-y green)
      draw_at(x: int(e.x), y: by + 4 - stretchy, w: 24, h: 20 + stretchy, r: 60, g: 170, b: 80)
      draw_at(x: int(e.x) + 4, y: by + 8, w: 16, h: 10, r: 100, g: 220, b: 120)
      // eyes
      draw_at(x: int(e.x) + 6, y: by + 8, w: 4, h: 5, r: 255, g: 255, b: 255)
      draw_at(x: int(e.x) + 14, y: by + 8, w: 4, h: 5, r: 255, g: 255, b: 255)
      draw_at(x: int(e.x) + 7, y: by + 10, w: 2, h: 3, r: 30, g: 30, b: 30)
      draw_at(x: int(e.x) + 15, y: by + 10, w: 2, h: 3, r: 30, g: 30, b: 30)
    end
  end
end

fn draw_goal()
  let gx = int(get level.goal.x)
  let gy = int(get level.goal.y)
  let pulse = (frame_count() % 60)
  let r = 200 + (pulse * 55) / 60
  // pole
  draw_at(x: gx + 8, y: gy - 80, w: 4, h: 80, r: 230, g: 230, b: 230)
  draw_at(x: gx + 6, y: gy - 84, w: 8, h: 8, r: 255, g: 220, b: 60)
  // flag waves
  let wave = sin(float(frame_count()) * 0.15) * 4.0
  let f = 0
  while f < 24 do
    let fx = gx + 12 + f
    let fy = gy - 76 + int(sin(float(frame_count()) * 0.1 + float(f) * 0.3) * 1.5)
    draw_at(x: fx, y: fy, w: 1, h: 16, r: r, g: 60, b: 60)
    f = f + 1
  end
end

fn draw_player()
  let bx = int(get px) - cam_offset_x()
  let by = int(get py) - cam_offset_y()
  // flicker if invul
  let show = get invul <= 0.0 || (frame_count() % 6) < 3
  if !show then return end
  let sw = int(float(PLAYER_W) * get stretch)
  let sh = int(float(PLAYER_H) * get squash)
  let dx = (PLAYER_W - sw) / 2
  let dy = PLAYER_H - sh
  // body
  draw_rect(x: bx + dx + 2, y: by + dy + 10, w: sw - 4, h: sh - 12, r: 60, g: 130, b: 230)
  draw_rect(x: bx + dx + 4, y: by + dy + 12, w: 6, h: sh - 16, r: 90, g: 160, b: 250)
  // head
  draw_rect(x: bx + dx + 1, y: by + dy + 2, w: sw - 2, h: 12, r: 245, g: 200, b: 165)
  // hat
  draw_rect(x: bx + dx, y: by + dy - 2, w: sw, h: 5, r: 200, g: 60, b: 60)
  draw_rect(x: bx + dx - 2, y: by + dy + 2, w: sw + 4, h: 3, r: 180, g: 50, b: 50)
  // eyes
  let eo = if get facing > 0 then sw - 9 else 3 end
  draw_rect(x: bx + dx + eo, y: by + dy + 6, w: 4, h: 4, r: 255, g: 255, b: 255)
  draw_rect(x: bx + dx + eo - 5, y: by + dy + 6, w: 4, h: 4, r: 255, g: 255, b: 255)
  draw_rect(x: bx + dx + eo + 1, y: by + dy + 7, w: 2, h: 3, r: 20, g: 20, b: 50)
  draw_rect(x: bx + dx + eo - 4, y: by + dy + 7, w: 2, h: 3, r: 20, g: 20, b: 50)
  // legs
  let leg = (frame_count() * 3) % 12
  if abs(get vx) > 20.0 && get on_ground then
    if leg < 6 then
      draw_rect(x: bx + dx + 3, y: by + dy + sh - 6, w: 6, h: 6, r: 60, g: 60, b: 130)
      draw_rect(x: bx + dx + sw - 9, y: by + dy + sh - 8, w: 6, h: 8, r: 60, g: 60, b: 130)
    else
      draw_rect(x: bx + dx + 3, y: by + dy + sh - 8, w: 6, h: 8, r: 60, g: 60, b: 130)
      draw_rect(x: bx + dx + sw - 9, y: by + dy + sh - 6, w: 6, h: 6, r: 60, g: 60, b: 130)
    end
  else
    draw_rect(x: bx + dx + 3, y: by + dy + sh - 6, w: 6, h: 6, r: 60, g: 60, b: 130)
    draw_rect(x: bx + dx + sw - 9, y: by + dy + sh - 6, w: 6, h: 6, r: 60, g: 60, b: 130)
  end
  // shoes
  draw_rect(x: bx + dx + 2, y: by + dy + sh - 1, w: 8, h: 3, r: 160, g: 50, b: 40)
  draw_rect(x: bx + dx + sw - 10, y: by + dy + sh - 1, w: 8, h: 3, r: 160, g: 50, b: 40)
end

fn draw_particles()
  for p in get particles do
    let r = 220
    let g = 200
    let b = 160
    if p.kind == "spark" then r = 255; g = 230; b = 80 end
    if p.kind == "puff"  then r = 200; g = 200; b = 220 end
    let life_t = p.life
    circ_at(x: int(p.x), y: int(p.y), rad: max(1, int(p.size * min(1.0, life_t * 2.0))), r: r, g: g, b: b)
  end
end

fn draw_floats()
  for f in get floats do
    let alpha = clamp(f.life, lo: 0.0, hi: 1.0)
    let r = int(255.0 * alpha)
    let g = int(240.0 * alpha)
    let b = int(120.0 * alpha)
    text_at(t: f.text, x: int(f.x), y: int(f.y), sz: 18, r: r + 30, g: g, b: b)
  end
end

fn draw_hud()
  // top bar
  draw_rect(x: 0, y: 0, w: SCREEN_W, h: 36, r: 0, g: 0, b: 0)
  draw_rect(x: 0, y: 0, w: SCREEN_W, h: 34, r: 25, g: 30, b: 50)
  // hearts
  let h = 0
  while h < 3 do
    let hx = 12 + h * 24
    if h < lives then
      draw_circle(cx: hx + 4, cy: 18, radius: 6, r: 220, g: 60, b: 70)
      draw_circle(cx: hx + 12, cy: 18, radius: 6, r: 220, g: 60, b: 70)
      draw_rect(x: hx + 1, y: 17, w: 16, h: 8, r: 220, g: 60, b: 70)
      draw_rect(x: hx + 4, y: 22, w: 10, h: 4, r: 220, g: 60, b: 70)
    else
      draw_circle(cx: hx + 4, cy: 18, radius: 6, r: 60, g: 25, b: 30)
      draw_circle(cx: hx + 12, cy: 18, radius: 6, r: 60, g: 25, b: 30)
      draw_rect(x: hx + 1, y: 17, w: 16, h: 8, r: 60, g: 25, b: 30)
    end
    h = h + 1
  end
  // coin count
  draw_circle(cx: 110, cy: 18, radius: 8, r: 255, g: 210, b: 40)
  draw_circle(cx: 108, cy: 16, radius: 4, r: 255, g: 240, b: 130)
  draw_text("x{get coins_got}", x: 122, y: 8, size: 22, r: 255, g: 255, b: 255)
  // timer
  let t = get level_timer
  let mins = int(t) / 60
  let secs = int(t) % 60
  let cents = int(t * 100.0) % 100
  draw_text("{mins}:{secs}.{cents}", x: 220, y: 8, size: 22, r: 220, g: 220, b: 240)
  // level name
  draw_text(get level.name, x: SCREEN_W - 240, y: 8, size: 22, r: 230, g: 230, b: 250)
  // toast
  if get toast_t > 0.0 then
    draw_rect(x: SCREEN_W / 2 - 100, y: 50, w: 200, h: 28, r: 0, g: 0, b: 0)
    draw_text(get toast, x: SCREEN_W / 2 - 90, y: 54, size: 20, r: 255, g: 230, b: 120)
  end
end

// ================ TITLE / OVERLAYS ====================================

fn draw_title()
  clear(20, 25, 50)
  // animated stars
  let s = 0
  while s < 80 do
    let sx = (s * 137) % SCREEN_W
    let sy = (s * 73) % 400
    let tw = (frame_count() + s * 3) % 60
    let bright = if tw < 30 then 100 + tw * 4 else 220 - (tw - 30) * 4 end
    draw_rect(x: sx, y: sy, w: 2, h: 2, r: bright, g: bright, b: bright + 20)
    s = s + 1
  end
  // title text wobble
  let bob = int(sin(title_t * 2.0) * 4.0)
  draw_text("PETAL  RUNNER", x: SCREEN_W / 2 - 130, y: 100 + bob, size: 48, r: 255, g: 230, b: 120)
  draw_text("a side-scroller written in petal", x: SCREEN_W / 2 - 150, y: 160, size: 18, r: 200, g: 200, b: 230)
  // level select
  draw_text("Select a level:", x: SCREEN_W / 2 - 80, y: 220, size: 22, r: 230, g: 230, b: 250)
  let i = 0
  while i < len(level_titles) do
    let y = 260 + i * 36
    let sel = i == menu_idx
    let bg_col = if sel then 80 else 30 end
    draw_rect(x: SCREEN_W / 2 - 200, y: y - 4, w: 400, h: 30, r: bg_col, g: bg_col + 10, b: bg_col + 30)
    let mark = if sel then ">" else " " end
    draw_text("{mark} {i + 1}. {level_titles[i]}", x: SCREEN_W / 2 - 190, y: y, size: 22, r: 240, g: 240, b: 255)
    let bt = best_times[i]
    if bt < 9000.0 then
      let mins = int(bt) / 60
      let secs = int(bt) % 60
      draw_text("best {mins}:{secs}  *{best_coins[i]}", x: SCREEN_W / 2 + 60, y: y, size: 18, r: 220, g: 200, b: 100)
    end
    i = i + 1
  end
  draw_text("up/down to choose, ENTER to play", x: SCREEN_W / 2 - 130, y: 480, size: 18, r: 180, g: 180, b: 220)
  draw_text("R restart   ESC pause   arrows/WASD move   SPACE jump", x: SCREEN_W / 2 - 220, y: 510, size: 16, r: 150, g: 160, b: 200)
end

fn draw_pause_overlay()
  draw_rect(x: 0, y: 0, w: SCREEN_W, h: SCREEN_H, r: 0, g: 0, b: 0)
  draw_text("PAUSED", x: SCREEN_W / 2 - 60, y: SCREEN_H / 2 - 60, size: 36, r: 240, g: 240, b: 255)
  draw_text("ESC resume   R restart   Q quit", x: SCREEN_W / 2 - 140, y: SCREEN_H / 2, size: 20, r: 200, g: 200, b: 230)
end

fn draw_complete_overlay()
  let alpha = min(1.0, phase_t * 2.0)
  let dim = int(180.0 * alpha)
  draw_rect(x: 0, y: 0, w: SCREEN_W, h: SCREEN_H, r: 0, g: 0, b: 0)
  draw_text("LEVEL CLEAR!", x: SCREEN_W / 2 - 130, y: 180, size: 40, r: 100, g: 230, b: 120)
  draw_text(get level.name, x: SCREEN_W / 2 - 80, y: 230, size: 22, r: 230, g: 230, b: 250)
  let mins = int(get level_timer) / 60
  let secs = int(get level_timer) % 60
  let cents = int(get level_timer * 100.0) % 100
  draw_text("time  {mins}:{secs}.{cents}", x: SCREEN_W / 2 - 70, y: 280, size: 22, r: 220, g: 220, b: 240)
  draw_text("coins {get coins_got}", x: SCREEN_W / 2 - 50, y: 310, size: 22, r: 255, g: 220, b: 120)
  draw_text("ENTER to continue   Q for menu", x: SCREEN_W / 2 - 140, y: 380, size: 18, r: 180, g: 180, b: 220)
end

fn draw_gameover_overlay()
  draw_rect(x: 0, y: 0, w: SCREEN_W, h: SCREEN_H, r: 0, g: 0, b: 0)
  draw_text("GAME OVER", x: SCREEN_W / 2 - 110, y: 200, size: 40, r: 220, g: 80, b: 80)
  draw_text("ENTER to retry   Q for menu", x: SCREEN_W / 2 - 130, y: 280, size: 20, r: 220, g: 220, b: 240)
end

fn draw_alldone_overlay()
  clear(20, 30, 50)
  draw_text("YOU FINISHED THE GAME", x: SCREEN_W / 2 - 220, y: 200, size: 36, r: 240, g: 230, b: 120)
  draw_text("thanks for playing!", x: SCREEN_W / 2 - 110, y: 250, size: 22, r: 220, g: 220, b: 240)
  let i = 0
  while i < len(level_titles) do
    let y = 320 + i * 30
    let bt = best_times[i]
    let mins = int(bt) / 60
    let secs = int(bt) % 60
    draw_text("{level_titles[i]}  -  {mins}:{secs}  *{best_coins[i]}",
      x: SCREEN_W / 2 - 180, y: y, size: 20, r: 220, g: 220, b: 250)
    i = i + 1
  end
  draw_text("ENTER for title", x: SCREEN_W / 2 - 70, y: 480, size: 18, r: 200, g: 200, b: 230)
end

// =====================================================================
//                              FRAME OUTPUT
// =====================================================================

if phase == Title then
  draw_title()
elsif phase == AllDone then
  draw_alldone_overlay()
else
  clear(level.bg_r, level.bg_g, level.bg_b)
  draw_sky()
  draw_clouds()
  draw_parallax_mountains()
  draw_platforms()
  draw_spikes()
  draw_checks()
  draw_coins()
  draw_goal()
  draw_enemies()
  draw_player()
  draw_particles()
  draw_floats()
  draw_hud()
  if phase == Paused then draw_pause_overlay() end
  if phase == Complete then draw_complete_overlay() end
  if phase == GameOver then draw_gameover_overlay() end
end
