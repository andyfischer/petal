// ─────────────────────────────────────────────────────────────────────────
// data — Campfire's workspace: the people, the channels, the seeded history,
// the afternoon's scripted chatter and the pools teammates reply from.
//
// Everything here is constant data plus pure helpers over it. The app keeps
// the live message list in `state`; this module only says what the
// workspace looked like at 2:32 PM on launch week, and what happens next.
// ─────────────────────────────────────────────────────────────────────────

// The simulated clock starts at 2:32 PM; every message stamps itself with
// minutes into the day.
pub let START_MIN = 872
pub let ME = "jordan"

// ── People ───────────────────────────────────────────────────────────────

const PEOPLE = {
  jordan: {name: "Jordan Lee", role: "Product engineer", color: #4f6bed, away: false},
  maya: {name: "Maya Chen", role: "Design lead", color: #d9488f, away: false},
  theo: {name: "Theo Okafor", role: "Sync engine", color: #2f9e77, away: false},
  priya: {name: "Priya Natarajan", role: "Product manager", color: #c2711b, away: false},
  lars: {name: "Lars Becker", role: "Platform", color: #7b5bd6, away: true},
  ines: {name: "Ines Duarte", role: "Marketing", color: #d4445c, away: false},
  kenji: {name: "Kenji Watanabe", role: "Support", color: #1f8fb8, away: true},
}

pub fn person(key: string) -> record
  field(PEOPLE, key, {name: key, role: "", color: #8a8f9c, away: true})
end

pub fn first_name(key: string) -> string
  if key == ME then "You" else split(person(key).name, " ")[0] end
end

pub fn initials(key: string) -> string
  let parts = split(person(key).name, " ")
  let a = char_slice(parts[0], 0, 1)
  if len(parts) > 1 then a ++ char_slice(parts[len(parts) - 1], 0, 1) else a end
end

// ── Channels ─────────────────────────────────────────────────────────────

