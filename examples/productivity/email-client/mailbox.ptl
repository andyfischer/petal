// The contacts a recipient field can complete against, in the order a short
// prefix should prefer them.
pub let CONTACTS = ["maya", "sofia", "tomas", "priya", "dana", "kofi",
  "jonah", "rafael", "bram", "lena", "ines", "aiko"]

fn before_at(addr: string) -> string
  let i = index_of(addr, "@")
  if i > 0 then char_slice(addr, 0, i) else addr end
end

// A person by key. An address the user typed has no entry, so it is shown as
// itself — which is what a mail client does with a stranger.
pub fn person(key: string) -> record
  let known = field(PEOPLE, key, nil)
  if known != nil then
    known
  else
    {name: before_at(key), email: key, color: #6a7388}
  end
end

pub fn first_name(key: string) -> string
  if key == ME then
    "me"
  else
    split(person(key).name, " ")[0]
  end
end

pub fn initials(name: string) -> string
  let out = ""
  for part in split(name, " ") do
    if char_len(part) > 0 && char_len(out) < 2 then
      out = out ++ upper(char_at(part, 0))
    end
  end
  out
end

// The contact a half-typed recipient most plausibly means: a prefix of a
// first name, a surname or an address. "" when nothing fits.
pub fn complete_contact(fragment: string) -> string
  let f = lower(fragment)
  let found = ""
  if char_len(f) > 0 then
    // A first name or an address wins over a surname: "ra" is Rafael before
    // it is Priya Raman.
    for key in CONTACTS do
      let p = person(key)
      if found == "" && (index_of(lower(p.name), f) == 0 || index_of(lower(p.email), f) == 0) then found = key end
    end
    for key in CONTACTS do
      if found == "" then
        for part in split(lower(person(key).name), " ") do
          if index_of(part, f) == 0 then found = key end
        end
      end
    end
  end
  found
end

// Turn what was typed into the To field into recipient keys: a known address
// or name collapses to its contact key, anything else is kept verbatim.
pub fn parse_recipients(typed: string) -> list
  let out = []
  for raw in split(typed, ",") do
    let s = trim_spaces(raw)
    if char_len(s) > 0 then
      let key = s
      for k in CONTACTS do
        let p = person(k)
        if lower(p.email) == lower(s) || lower(p.name) == lower(s) then key = k end
      end
      out = append(out, key)
    end
  end
  out
end

// Whether every recipient is someone mail could reach: a contact, or at least
// something shaped like an address.
pub fn deliverable(keys: list) -> bool
  let ok = len(keys) > 0
  for k in keys do
    if !contains(CONTACTS, k) && index_of(k, "@") < 1 then ok = false end
  end
  ok
end

pub fn trim_spaces(s: string) -> string
  let a = 0
  let b = char_len(s)
  while a < b && char_at(s, a) == " " do a = a + 1 end
  while b > a && char_at(s, b - 1) == " " do b = b - 1 end
  char_slice(s, a, b)
end

// ── Labels and mailboxes ─────────────────────────────────────────────────

pub let LABELS = [
  {key: "clients",  name: "Clients",  color: #1f9d8f},
  {key: "design",   name: "Design",   color: #7c5cd6},
  {key: "finance",  name: "Finance",  color: #c98414},
  {key: "travel",   name: "Travel",   color: #2f7fd6},
  {key: "personal", name: "Personal", color: #d6527a},
]

pub fn label_of(key: string) -> record
  let found = {key: key, name: key, color: #6a7388}
  for l in LABELS do
    if l.key == key then found = l end
  end
  found
end

pub let BOXES = [
  {key: "inbox",   name: "Inbox"},
  {key: "starred", name: "Starred"},
  {key: "sent",    name: "Sent"},
  {key: "drafts",  name: "Drafts"},
  {key: "archive", name: "Archive"},
  {key: "all",     name: "All mail"},
  {key: "trash",   name: "Trash"},
]

// A view is a mailbox key or "label:<key>".
pub fn view_name(view: string) -> string
  let name = view
  for b in BOXES do
    if b.key == view then name = b.name end
  end
  if index_of(view, "label:") == 0 then
    name = label_of(char_slice(view, 6)).name
  end
  name
end

fn from_me(t: record) -> bool
  let any = false
  for m in t.msgs do
    if m.from == ME then any = true end
  end
  any
end

pub fn in_view(t: record, view: string) -> bool
  if view == "inbox" then t.box == "inbox"
  elsif view == "starred" then t.starred && t.box != "trash"
  elsif view == "sent" then t.box == "sent" || (from_me(t) && (t.box == "inbox" || t.box == "archive"))
  elsif view == "drafts" then t.box == "drafts"
  elsif view == "archive" then t.box == "archive"
  elsif view == "all" then t.box != "trash" && t.box != "drafts"
  elsif view == "trash" then t.box == "trash"
  elsif index_of(view, "label:") == 0 then
    contains(t.labels, char_slice(view, 6)) && t.box != "trash"
  else false
  end
end

// ── Reading a thread ─────────────────────────────────────────────────────

pub fn last_msg(t: record) -> record
  t.msgs[len(t.msgs) - 1]
end

// Newest first means largest stamp first; mail written this session has a
// negative age and so sorts above everything seeded.
pub fn stamp(t: record) -> int
  0 - last_msg(t).age
end

pub fn has_attachment(t: record) -> bool
  let any = false
  for m in t.msgs do
    if len(m.atts) > 0 then any = true end
  end
  any
end

pub fn attachment_count(t: record) -> int
  let n = 0
  for m in t.msgs do n = n + len(m.atts) end
  n
end

// Who the row is "from": the correspondents in the order they first spoke.
// A thread that is only me talking is shown by who it is addressed to.
pub fn participants(t: record) -> string
  let keys = []
  for m in t.msgs do
    if !contains(keys, m.from) then keys = append(keys, m.from) end
  end
  if len(keys) == 1 && keys[0] == ME then
    let to = t.msgs[0].to
    if len(to) == 0 then
      "(no recipient)"
    else
      let names = for k in to do person(k).name end
      "To: " ++ join(names, ", ")
    end
  elsif len(keys) == 1 then
    person(keys[0]).name
  else
    let names = for k in keys do first_name(k) end
    join(names, ", ")
  end
end

// The person whose face the row wears: the latest correspondent who is not me.
pub fn face_of(t: record) -> string
  let key = ME
  for m in t.msgs do
    if m.from != ME then key = m.from end
  end
  if key == ME && len(t.msgs[0].to) > 0 then key = t.msgs[0].to[0] end
  key
end

// A message as one run of text, for snippets and search: paragraphs and the
// line breaks inside them both become spaces.
pub fn body_text(m: record) -> string
  join(split(join(m.body, " "), "\n"), " ")
end

// Everything a free-text term can match in a thread, lowercased once.
fn haystack(t: record) -> string
  let parts = [t.subject]
  for m in t.msgs do
    let p = person(m.from)
    parts = append(parts, p.name)
    parts = append(parts, p.email)
    parts = append(parts, body_text(m))
    for a in m.atts do parts = append(parts, a.name) end
  end
  lower(join(parts, " "))
end

// ── The query language ───────────────────────────────────────────────────
// Free words must all appear somewhere in the thread; `from:maya`,
// `is:unread`, `is:starred`, `has:attachment` and `label:design` narrow it.

pub fn tokens(q: string) -> list
  for tok in split(lower(q), " ") do
    if char_len(tok) == 0 then continue end
    tok
  end
end

pub fn parse_query(q: string) -> record
  let pq = {terms: [], from: "", unread: false, starred: false, att: false, label: "", active: false}
  for tok in tokens(q) do
    let i = index_of(tok, ":")
    let key = if i > 0 then char_slice(tok, 0, i) else "" end
    let val = if i > 0 then char_slice(tok, i + 1) else "" end
    if key == "from" then
      pq.from = val
    elsif key == "is" && val == "unread" then
      pq.unread = true
    elsif key == "is" && val == "starred" then
      pq.starred = true
    elsif key == "has" then
      pq.att = true
    elsif key == "label" then
      pq.label = val
    else
      pq.terms = append(pq.terms, tok)
    end
    pq.active = true
  end
  pq
end

fn sender_matches(t: record, who: string) -> bool
  let hit = false
  for m in t.msgs do
    let p = person(m.from)
    if contains(lower(p.name), who) || contains(lower(p.email), who) then hit = true end
  end
  hit
end

pub fn matches(t: record, pq: record) -> bool
  if pq.unread && !t.unread then return false end
  if pq.starred && !t.starred then return false end
  if pq.att && !has_attachment(t) then return false end
  if char_len(pq.label) > 0 then
    let any = false
    for l in t.labels do
      if index_of(l, pq.label) == 0 then any = true end
    end
    if !any then return false end
  end
  if char_len(pq.from) > 0 && !sender_matches(t, pq.from) then return false end
  if len(pq.terms) > 0 then
    let hay = haystack(t)
    for term in pq.terms do
      if !contains(hay, term) then return false end
    end
  end
  true
end

// Add `tok` to the query, or take it out if it is already there — what a
// filter chip does when it is clicked.
pub fn toggle_token(q: string, tok: string) -> string
  let toks = tokens(q)
  if contains(toks, tok) then
    let kept = for t in toks do
      if t == tok then continue end
      t
    end
    join(kept, " ")
  elsif len(toks) == 0 then
    tok
  else
    trim_spaces(q) ++ " " ++ tok
  end
end

// The line of body a row shows. With a search running, that is the stretch of
// text around the first hit rather than the opening words, so the row shows
// why it matched.
pub fn snippet(t: record, terms: list) -> string
  let text = body_text(last_msg(t))
  if len(terms) > 0 then
    let found = false
    for m in t.msgs do
      if found then continue end
      let b = body_text(m)
      let at_i = index_of(lower(b), terms[0])
      if at_i >= 0 then
        found = true
        if at_i > 34 then
          // Back up a few words and start on a word boundary.
          let from = at_i - 28
          while from < at_i && char_at(b, from - 1) != " " do from = from + 1 end
          text = "… " ++ char_slice(b, from)
        else
          text = b
        end
      end
    end
  end
  text
end

// ── Transforms ───────────────────────────────────────────────────────────
// Each takes the store and returns a new one; the caller owns the `state`.

pub fn find_thread(ts: list, id: int)
  let found = nil
  for t in ts do
    if t.id == id then found = t end
  end
  found
end

pub fn move_to(ts: list, ids: list, box: string) -> list
  for t in ts do
    if contains(ids, t.id) then {...t, box: box} else t end
  end
end

pub fn drop_threads(ts: list, ids: list) -> list
  for t in ts do
    if contains(ids, t.id) then continue end
    t
  end
end

// The threads with these ids, as they are now: what an undo entry keeps.
pub fn pick(ts: list, ids: list) -> list
  for t in ts do
    if !contains(ids, t.id) then continue end
    t
  end
end

// Put `was` back: a thread that is still in the store returns to the mailbox
// it was in and keeps whatever has happened to it since; one that was deleted
// comes back whole.
pub fn restore(ts: list, was: list) -> list
  let out = for t in ts do
    let old = find_thread(was, t.id)
    if old != nil then {...t, box: old.box} else t end
  end
  for old in was do
    if find_thread(ts, old.id) == nil then out = append(out, old) end
  end
  out
end

pub fn set_unread(ts: list, ids: list, unread: bool) -> list
  for t in ts do
    if contains(ids, t.id) then {...t, unread: unread} else t end
  end
end

pub fn set_starred(ts: list, ids: list, starred: bool) -> list
  for t in ts do
    if contains(ids, t.id) then {...t, starred: starred} else t end
  end
end

pub fn add_reply(ts: list, id: int, m: record) -> list
  for t in ts do
    if t.id == id then {...t, msgs: append(t.msgs, m), unread: false} else t end
  end
end

pub fn next_id(ts: list) -> int
  let top = 0
  for t in ts do top = max(top, t.id) end
  top + 1
end

// Who a reply to this thread goes to: whoever last wrote that was not me.
pub fn reply_to(t: record) -> list
  let key = ""
  for m in t.msgs do
    if m.from != ME then key = m.from end
  end
  if key == "" then t.msgs[0].to else [key] end
end

pub fn count_unread(ts: list, view: string) -> int
  let n = 0
  for t in ts do
    if t.unread && in_view(t, view) then n = n + 1 end
  end
  n
end

pub fn count_view(ts: list, view: string) -> int
  let n = 0
  for t in ts do
    if in_view(t, view) then n = n + 1 end
  end
  n
end

// ── Seed data ────────────────────────────────────────────────────────────

fn msg(from: string, to: list, age: int, body: list, atts: list)
  {from: from, to: to, age: age, body: body, atts: atts}
end

fn file(name: string, size: string, kind: string) -> record
  {name: name, size: size, kind: kind}
end

// `flags` holds "u" for unread and "s" for starred.
fn thread(id: int, box: string, labels: list, subject: string, msgs: list, flags: string)
  {id: id, box: box, labels: labels, starred: contains(flags, "s"), unread: contains(flags, "u"), subject: subject, msgs: msgs}
end

pub fn seed_threads() -> list
  [
    thread(1, "inbox", ["clients", "design"], "Harbor & Pine rebrand: round two feedback", [
      msg("maya", ["me"], at(1, 15, 12), [
        "Hi Noor,",
        "The board saw the three directions on Monday and the room went quiet in the good way. Direction B (the lighthouse mark with the condensed serif) is the clear favourite, and nobody wants to revisit A.",
        "Two things came up that I would like your read on before we lock anything. First, the teal reads a little cold next to our packaging stock. Second, the wordmark feels tight at small sizes on the mobile nav.",
      ], []),
      msg("me", ["maya"], at(1, 17, 40), [
        "That is great news, and both notes are fair.",
        "On the teal: I can warm it two steps toward the kelp green without losing contrast on white. On the wordmark, the tightness is the optical size, not the tracking. I will cut a small-size variant with opened counters and send both on the nav mockup.",
        "Would Thursday work for a 30 minute walkthrough?",
      ], []),
      msg("maya", ["me"], 38, [
        "Thursday at 2 works. I have pulled in Sofia so she can sanity check it against the launch copy.",
        "I attached the board's annotated deck. Page 6 has the comment about the lighthouse beam angle, which I think is a taste note and not a change request, but you should see it. Page 9 is the one that matters: they want the secondary palette cut from six colours to four.",
        "Also, quietly: they loved the motion study. Expect a request for more of that.",
      ], [file("Board-feedback-round-2.pdf", "2.4 MB", "pdf"), file("nav-crops.png", "640 KB", "img")]),
    ], "s"),

    thread(2, "inbox", ["design"], "Token export is breaking dark mode", [
      msg("tomas", ["me", "priya"], at(0, 8, 31), [
        "Morning. The nightly export from the tokens file flipped surface-2 and surface-3 in the dark theme, so every card in the app now sits darker than the page behind it.",
        "I think it is the alias chain: surface-3 points at neutral-850, which was renamed last week. The exporter falls back to the light value when an alias does not resolve, and it does it silently.",
      ], []),
      msg("tomas", ["me", "priya"], 72, [
        "Follow up: confirmed. Nine aliases point at names that no longer exist. I have a branch that makes the exporter fail loudly instead of guessing.",
        "Can you look at the list and tell me which ones were meant to move to the new elevation scale? I do not want to guess at intent.",
      ], [file("unresolved-aliases.csv", "3 KB", "sheet")]),
    ], "u"),

    thread(3, "inbox", ["finance"], "Invoice INV-2041 is due Friday", [
      msg("ledger", ["me"], 128, [
        "Hello Noor,",
        "This is a reminder that invoice INV-2041 for Fernhill Studio is due on Friday 9 October. The amount outstanding is 1,180.00 EUR for the Studio plan, 12 seats, billed annually.",
        "You can pay by card or bank transfer from the billing page. If you have already paid, thank you, and please disregard this message.",
      ], [file("INV-2041.pdf", "88 KB", "pdf")]),
    ], "u"),

    thread(4, "inbox", [], "Offsite agenda, draft for your eyes", [
      msg("priya", ["me"], at(0, 8, 5), [
        "Here is the first pass at the offsite agenda. I kept Thursday morning free of anything with slides.",
        "The open question is whether the critique session should be one long block or two short ones either side of lunch. I lean two short ones: people are sharper, and it gives the quieter folks a second run at it.",
        "Tell me what to cut. It is too full.",
      ], [file("Offsite-agenda-v1.docx", "41 KB", "doc")]),
    ], ""),

    thread(5, "inbox", ["clients"], "Q4 capacity: can we take the Meridian project?", [
      msg("dana", ["me", "priya", "tomas"], at(1, 10, 2), [
        "Meridian came back. They want a full product redesign, twelve weeks, starting the first week of November. It is the kind of work we say we want.",
        "Before I answer I need an honest picture of capacity. Please reply with what you are committed to through December.",
      ], []),
      msg("priya", ["dana", "me", "tomas"], at(1, 11, 30), [
        "I am on Harbor & Pine support two days a week until launch, then free. I could lead research for Meridian from mid November.",
      ], []),
      msg("tomas", ["dana", "me", "priya"], at(1, 13, 15), [
