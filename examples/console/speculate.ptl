# Hypothetical calls with `speculate`
# Run a function "as if", and keep only what it returned and recorded.

import io

# A view that keeps a little state, writes a shared cell, draws, and marks
# where each card landed with `speculate_place` (the identity outside a
# speculative call). It is the kind of function a drag engine runs once
# per candidate arrangement.
var draws = 0

fn view(cards)
  state renders = 0
  renders += 1
  set draws += 1
  for i in range(0, len(cards)) do
    let r = speculate_place(cards[i], {x: 40 + i * 70, y: 100})
    push_output(symbol("draw"), "card {cards[i]} at {r.x}")
  renders

# The candidate orders a drag of "A" could reach: A moved to each slot.
fn moves(xs, i)
  let x = xs[i]
  let rest = remove_at(xs, i)
  for j in range(0, len(xs)) do take(rest, j) ++ [x] ++ drop(rest, j) end

let cards = ["A", "B", "C"]
for c in moves(cards, 0) do
  let r = speculate(view, c)
  let a = find(r.places, fn(p) p.key == "A" end)
  print("{c}: A lands at x={a.value.x}, {len(r.emits)} draw commands, renders={r.value}")

# Nothing the hypothetical runs did is left behind: the cell is untouched,
# the random stream did not move, and no draw command reached the buffer.
print("draws after speculating: {get draws}")
let r = speculate(fn() random() end)
print("same next draw: {r.value == random()}")

# The live call is an ordinary call.
print("live renders: {view(cards)}, draws: {get draws}")
print("speculating now: {speculating()}")
