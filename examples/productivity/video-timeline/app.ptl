// ─────────────────────────────────────────────────────────────────────────
//  SPLICE — a non-linear video editor's timeline, in a Garden panel.
//
//  Six tracks (three picture, three sound) hold the clips of a 43-second
//  teaser cut. A playhead scrubs and plays across them at 24 fps, and the
//  program monitor shows the picture under it: every "frame" of footage is
//  drawn procedurally by scenes.ptl from the clip's source time, so trimming
//  a clip's head really does change what the monitor shows at that point.
//
//  Clips move between positions and tracks with snapping, trim from either
//  edge within their source media, split at the playhead, delete (or ripple
//  delete), and come in from the media bin by drag and drop. Every edit is
//  one undo step.
//
//  Designed for a 1280x850 viewport. See README.md.
// ─────────────────────────────────────────────────────────────────────────

import text_layout
import ui
import garden
import ./scenes

// ── Palette ──────────────────────────────────────────────────────────────
let BG      = #0a0c10
let CARD    = #12151c
let WELL    = #181c25
let WELL_HI = #20252f
let LINE    = #262c38
let LINE_S  = #1c212a
let TEXT    = #eef1f6
let DIM     = #a3abba
let FAINT   = #697284
let GHOST   = #3b4352
let ACCENT  = #f2b766
let HEAD    = #ff5d55
let SNAPC   = #ffd166

// ── Text styles ──────────────────────────────────────────────────────────
let S_BRAND = {size: 15, font: "ui", weight: 700, color: TEXT, spacing: 2.4}
let S_TITLE = {size: 14, font: "ui", weight: 700, color: TEXT}
let S_SUB   = {size: 11, font: "ui", color: DIM}
let S_CAP   = {size: 9, font: "ui", weight: 700, color: FAINT, spacing: 1.3}
let S_BODY  = {size: 12, font: "ui", color: TEXT}
let S_SMALL = {size: 10, font: "ui", color: DIM}
let S_TINY  = {size: 9, font: "ui", color: FAINT}
let S_BTN   = {size: 11, font: "ui", weight: 600, color: DIM}
let S_TCBIG = {size: 22, font: "mono", color: TEXT}
let S_TC    = {size: 11, font: "mono", color: DIM}
let S_RULER = {size: 9, font: "mono", color: FAINT}
let S_CLIP  = {size: 10, font: "ui", weight: 600, color: #f4f6fa}
let S_KEY   = {size: 9, font: "mono", color: DIM}

// ── Model ────────────────────────────────────────────────────────────────
let FPS = 24
let MIN_LEN = 6            // shortest clip a trim leaves, in frames
let SNAP_PX = 8

// Media: the bin. `dur` is the source length in frames; titles are
// generated, so theirs is generous.
const MEDIA = [
  {name: "Harbour at Dusk", file: "A014_C003_dusk.mov", kind: "video", scene: "harbor", dur: 336, color: #4c8dff},
  {name: "Lighthouse Beam", file: "A016_C011_beam.mov", kind: "video", scene: "lighthouse", dur: 288, color: #4c8dff},
  {name: "Mara — Interview", file: "B002_C001_mara.mov", kind: "video", scene: "interview", dur: 528, color: #4c8dff},
  {name: "Old Town at Night", file: "A021_C004_town.mov", kind: "video", scene: "city", dur: 240, color: #4c8dff},
  {name: "Coast Road", file: "C007_C002_road.mov", kind: "video", scene: "road", dur: 216, color: #4c8dff},
  {name: "Cliffs — Drone", file: "DJI_0412.mp4", kind: "video", scene: "cliffs", dur: 384, color: #4c8dff},
  {name: "Main Title", file: "Title · Harbour Lights", kind: "title", scene: "title", dur: 1440, color: #f2b766},
  {name: "Lower Third — Mara", file: "Title · Name strap", kind: "title", scene: "lower", dur: 1440, color: #f2b766},
  {name: "End Card", file: "Title · Release", kind: "title", scene: "endcard", dur: 1440, color: #f2b766},
  {name: "VO — Mara, take 3", file: "mara_vo_t03.wav", kind: "audio", scene: "vo", dur: 576, color: #4fc28a},
  {name: "Score — Tidewater", file: "tidewater_v4_mix.wav", kind: "audio", scene: "score", dur: 1200, color: #d46fd8},
  {name: "Gulls & Surf", file: "amb_harbour_gulls.wav", kind: "audio", scene: "gulls", dur: 720, color: #46b8c8},
]

// Tracks, top to bottom as drawn. Picture tracks composite bottom-up
// (V1 first), so a clip on V2 covers V1 and a title on V3 sits over both.
const TRACKS = [
  {code: "V3", name: "Titles", kind: "video", h: 42, color: #f2b766},
  {code: "V2", name: "B-roll", kind: "video", h: 46, color: #8b7cf6},
  {code: "V1", name: "Main", kind: "video", h: 46, color: #4c8dff},
  {code: "A1", name: "Dialogue", kind: "audio", h: 38, color: #4fc28a},
  {code: "A2", name: "Music", kind: "audio", h: 38, color: #d46fd8},
  {code: "A3", name: "Ambience", kind: "audio", h: 38, color: #46b8c8},
]
let N_TRK = 6
let BIN_TABS = ["All", "Video", "Titles", "Audio"]

fn cl(id: int, m: int, t: int, s: int, n: int, i: int) -> record
  {id: id, m: m, t: t, s: s, n: n, i: i}
end

fn seed_doc() -> record
  {clips: [
    cl(1, 6, 0, 24, 120, 0), cl(2, 7, 0, 232, 120, 0), cl(3, 8, 0, 936, 96, 0),
    cl(4, 3, 1, 312, 72, 120), cl(5, 5, 1, 420, 60, 250),
    cl(6, 0, 2, 0, 96, 24), cl(7, 1, 2, 96, 120, 40), cl(8, 2, 2, 216, 288, 48),
    cl(9, 4, 2, 504, 120, 30), cl(10, 5, 2, 624, 168, 60), cl(11, 3, 2, 792, 120, 40),
    cl(12, 0, 2, 912, 120, 200),
    cl(13, 9, 3, 216, 288, 30), cl(14, 9, 3, 664, 110, 380),
    cl(15, 10, 4, 0, 1032, 0),
    cl(16, 11, 5, 0, 240, 0), cl(17, 11, 5, 840, 192, 400),
  ],
    markers: [
      {f: 24, name: "Title in"}, {f: 216, name: "Mara"}, {f: 504, name: "Beat drop"},
      {f: 912, name: "Resolve"},
    ],
    next: 18}
end

let DRAG0 = {kind: "", id: -1, off: 0.0, t: 0, s: 0, n: 0, m: -1, mx0: 0.0, f0: 0.0, moved: false, ok: false}

// ── State ────────────────────────────────────────────────────────────────
state doc = seed_doc()
state playhead = 0.0         // frames, fractional while playing
state playing = false
state ppf = 0.0              // pixels per frame; 0 until the first fit
state view0 = 0.0            // frame at the left edge of the tracks
state sel = -1               // selected clip id
state snap_on = true
state off = [false, false, false, false, false, false]   // track hidden / muted
state undo = []
state redo = []
state drag = DRAG0
state g_doc = doc            // the document as a gesture found it
state bin_tab = 0
state bin_scroll = 0.0
state meter = [0.0, 0.0]
state peak = [0.0, 0.0]
state played = 0.0           // seconds of playback, for tests
state n_moves = 0
state n_trims = 0
state n_splits = 0
state n_drops = 0
state n_deletes = 0
state n_snaps = 0
state toast = {text: "", t: -10.0}

// ── Layout (recomputed every frame; the pane can resize) ─────────────────
let W = screen_width()
let H = screen_height()
let M = 16
let TOP_H = 50
let UP_Y = TOP_H + 4
let TOOL_H = 38
let RULER_H = 28
let TRK_TOTAL = 42 + 46 + 46 + 38 + 38 + 38 + 5 * 2
let TL_NEED = TOOL_H + RULER_H + TRK_TOTAL + 26
let UP_H = max(250, H - UP_Y - 12 - TL_NEED - M)
let BIN_W = 262
let INS_W = 262
let R_BIN = rect(M, UP_Y, BIN_W, UP_H)
let R_MON = rect(M + BIN_W + 12, UP_Y, W - M * 2 - BIN_W - INS_W - 24, UP_H)
let R_INS = rect(W - M - INS_W, UP_Y, INS_W, UP_H)
let TL_Y = UP_Y + UP_H + 12
let R_TL = rect(M, TL_Y, W - M * 2, H - TL_Y - M)
let HEAD_W = 158
let TX0 = R_TL.x + HEAD_W
let TW = R_TL.w - HEAD_W - 10
let RULER_Y = TL_Y + TOOL_H
let TRK_Y0 = RULER_Y + RULER_H + 2
let TY = [TRK_Y0, TRK_Y0 + 44, TRK_Y0 + 92, TRK_Y0 + 140, TRK_Y0 + 180, TRK_Y0 + 220]
let TRK_END = TRK_Y0 + 258
let R_TRACKS = rect(TX0, TRK_Y0, TW, TRK_END - TRK_Y0)
let R_RULER = rect(TX0, RULER_Y, TW, RULER_H)
let R_SB = rect(TX0, TRK_END + 6, TW, 8)

// Monitor: screen, meters, transport.
let MON_HEAD = 34
let MON_FOOT = 58
let SCR_AVAIL_H = UP_H - MON_HEAD - MON_FOOT
let SCR_H = min(SCR_AVAIL_H, (R_MON.w - 70) * 9 / 16)
let SCR_W = SCR_H * 16 / 9
let R_SCR = rect(R_MON.x + (R_MON.w - 34 - SCR_W) / 2, R_MON.y + MON_HEAD, SCR_W, SCR_H)
let R_METER = rect(R_SCR.x + SCR_W + 12, R_SCR.y, 22, SCR_H)
let FOOT_Y = R_MON.y + UP_H - MON_FOOT + 6
let TC_CX = R_SCR.x + R_SCR.w / 2
let R_PREV  = rect(TC_CX - 104, FOOT_Y + 8, 36, 32)
let R_BACK  = rect(TC_CX - 62, FOOT_Y + 8, 36, 32)
let R_PLAY  = rect(TC_CX - 20, FOOT_Y + 4, 40, 40)
let R_FWD   = rect(TC_CX + 26, FOOT_Y + 8, 36, 32)
let R_NEXT  = rect(TC_CX + 68, FOOT_Y + 8, 36, 32)

// Bin rows.
let BIN_LIST_Y = R_BIN.y + 70
let BIN_ROW = 50
let R_BINLIST = rect(R_BIN.x + 8, BIN_LIST_Y, BIN_W - 16, R_BIN.y + UP_H - BIN_LIST_Y - 8)

// ── Time helpers ─────────────────────────────────────────────────────────
fn two(n: int) -> string
  pad_start(n, 2, "0")
end

fn tc(f: num) -> string
  let fi = max(0, int(floor(f)))
  let s = fi / FPS
  "{two(s / 3600)}:{two(s / 60 % 60)}:{two(s % 60)}:{two(fi % FPS)}"
end

fn dur_label(n: int) -> string
  let s = n / FPS
  if s >= 60 then "{s / 60}:{two(s % 60)}:{two(n % FPS)}" else "{s}:{two(n % FPS)}" end
end

fn ruler_label(f: int, step: int) -> string
  let s = f / FPS
  if step % FPS == 0 then "{two(s / 60)}:{two(s % 60)}" else "{s / 60}:{two(s % 60)}:{two(f % FPS)}" end
end

// ── View: frames <-> pixels ──────────────────────────────────────────────
fn fx(v: record, f: num) -> float
  v.x0 + (f - v.v0) * v.ppf
end

fn f_at(v: record, x: num) -> float
  v.v0 + (x - v.x0) / v.ppf
end

fn track_at(y: num) -> int
  let out = -1
  for i in range(0, N_TRK) do
    if y >= TY[i] && y < TY[i] + TRACKS[i].h then out = i end
  end
  out
end

fn clip_rect(v: record, c: record) -> Rect
  rect(fx(v, c.s), TY[c.t] + 2, c.n * v.ppf, TRACKS[c.t].h - 4)
end

fn fits(kind: string, t: int) -> bool
  if kind == "audio" then TRACKS[t].kind == "audio" else TRACKS[t].kind == "video" end
end

// ── Pure document edits ──────────────────────────────────────────────────
fn find_clip(clips: list, id: int) -> int
  let out = -1
  for k in range(0, len(clips)) do
    if clips[k].id == id then out = k end
  end
  out
end

fn seq_end(clips: list) -> int
  let e = 0
  for c in clips do
    e = max(e, c.s + c.n)
  end
  e
end

fn without(clips: list, id: int) -> list
  filter(clips, fn(c) -> c.id != id)
end

// Overwrite edit: lay `c` onto its track, cutting away whatever it covers.
// A clip it lands inside is split in two around it.
fn place(d: record, c: record) -> record
  let out = []
  let next = d.next
  let cs = c.s
  let ce = c.s + c.n
  for o in d.clips do
    if o.id == c.id then continue end
    let os = o.s
    let oe = o.s + o.n
    if o.t != c.t || oe <= cs || os >= ce then
      out = append(out, o)
    elsif os >= cs && oe <= ce then
      nil
    elsif os < cs && oe > ce then
      out = append(out, {...o, n: cs - os})
      out = append(out, {...o, id: next, s: ce, n: oe - ce, i: o.i + (ce - os)})
      next += 1
    elsif os < cs then
      out = append(out, {...o, n: cs - os})
    else
      out = append(out, {...o, s: ce, n: oe - ce, i: o.i + (ce - os)})
    end
  end
  {...d, clips: append(out, c), next: next}
end

fn split_one(d: record, k: int, f: int) -> record
  let c = d.clips[k]
  let left = {...c, n: f - c.s}
  let right = {...c, id: d.next, s: f, n: c.s + c.n - f, i: c.i + (f - c.s)}
  let cs = for j in range(0, len(d.clips)) do
    if j == k then left else d.clips[j] end
  end
  {...d, clips: append(cs, right), next: d.next + 1}
end

fn spans(c: record, f: int) -> bool
  f > c.s && f < c.s + c.n
end

// Split the selected clip at the playhead, or, with nothing selected (or
// the selection elsewhere), every clip on a live track the playhead crosses.
fn split_at(d: record, sel_id: int, f: int, dead: list) -> record
  let k = find_clip(d.clips, sel_id)
  if k >= 0 && spans(d.clips[k], f) then
    return split_one(d, k, f)
  end
  let out = d
  let ids = for c in d.clips do
    if spans(c, f) && !dead[c.t] then c.id else continue end
  end
  for id in ids do
    out = split_one(out, find_clip(out.clips, id), f)
  end
  out
end

fn ripple_delete(d: record, id: int) -> record
  let k = find_clip(d.clips, id)
  if k < 0 then return d end
  let c = d.clips[k]
  let rest = for o in d.clips do
    if o.id == id then continue end
    if o.t == c.t && o.s >= c.s + c.n then {...o, s: o.s - c.n} else o end
  end
  {...d, clips: rest}
end

// The nearest clip edges on a track either side of a clip: how far a trim
// may reach before it would run into a neighbour.
fn prev_end(clips: list, c: record) -> int
  let e = 0
  for o in clips do
    if o.t == c.t && o.id != c.id && o.s + o.n <= c.s then e = max(e, o.s + o.n) end
  end
  e
end

fn next_start(clips: list, c: record) -> int
  let s = 1000000
  for o in clips do
    if o.t == c.t && o.id != c.id && o.s >= c.s + c.n then s = min(s, o.s) end
  end
  s
end

fn edit_points(clips: list) -> list
  let pts = [0]
  for c in clips do
    pts = append(pts, c.s)
    pts = append(pts, c.s + c.n)
  end
  sort(pts)
end

fn snap_points(d: record, ph: num, except: int) -> list
  let pts = [0, int(round(ph))]
  for c in d.clips do
    if c.id == except then continue end
    pts = append(pts, c.s)
    pts = append(pts, c.s + c.n)
  end
  for mk in d.markers do
    pts = append(pts, mk.f)
  end
  pts
end

// Nearest snap point to any of `cands` (frames), within `thr` frames.
// Returns how far to shift and where the snap line goes, or nil.
fn snap_best(pts: list, cands: list, thr: num) -> record
  let best = {d: 0, at: -1, dist: thr + 1.0}
  for c in cands do
    for p in pts do
      let dd = abs(p - c)
      if dd < best.dist then best = {d: p - c, at: p, dist: dd} end
    end
  end
  best
end

// The clip on track `t` under frame `f`.
fn clip_under(clips: list, t: int, f: num) -> record
  let out = nil
  for c in clips do
    if c.t == t && f >= c.s && f < c.s + c.n then out = c end
  end
  out
end

fn media_ok(tab: int, m: record) -> bool
  match tab
    when 1 -> m.kind == "video"
    when 2 -> m.kind == "title"
    when 3 -> m.kind == "audio"
    when _ -> true
  end
end

// ═════════════════════════════════════════════════════════════════════════
//  INPUT
// ═════════════════════════════════════════════════════════════════════════
claim_key("z", "cmd")
claim_key("z", "cmd+shift")

let mx = mouse_x()
let my = mouse_y()
let fdt = clamp(dt(), 0.0, 0.25)
let ph0 = playhead
let end_f = seq_end(doc.clips)

if ppf == 0.0 then
  ppf = TW / (end_f * 1.04)
  view0 = 0.0
end
let V = {x0: TX0, w: TW, v0: view0, ppf: ppf}
let SNAP_F = SNAP_PX / ppf

fn say(msg: string) -> record
  {text: msg, t: time()}
end

// ── Hover ────────────────────────────────────────────────────────────────
let in_tracks = point_in(mx, my, R_TRACKS)
let hov_t = if in_tracks then track_at(my) else -1 end
let hov_id = -1
let hov_edge = ""
if in_tracks && drag.kind == "" then
  for c in doc.clips do
    let r = clip_rect(V, c)
    if c.t == hov_t && mx >= r.x && mx < r.x + r.w then
      hov_id = c.id
      let grip = if r.w >= 24 then 7 else 3 end
      hov_edge = if mx < r.x + grip then "l" elsif mx >= r.x + r.w - grip then "r" else "" end
    end
  end
end
let hov_bin = -1
let bin_items = for k in range(0, len(MEDIA)) do
  if media_ok(bin_tab, MEDIA[k]) then k else continue end
end
if point_in(mx, my, R_BINLIST) then
  let row = int(floor((my - BIN_LIST_Y + bin_scroll) / BIN_ROW))
  if row >= 0 && row < len(bin_items) then hov_bin = bin_items[row] end
end

// Toolbar buttons, measured once and shared by hit-testing and drawing.
fn tool_buttons(x0: num, y: num) -> list
  let labels = [["Undo", "⌘Z"], ["Redo", "⇧⌘Z"], ["Split", "S"], ["Delete", "⌫"], ["Ripple", "⇧⌫"],
    ["Marker", "M"], ["Snap", "N"]]
  let x = x0
  for l in labels do
    let w = text_width(l[0], S_BTN) + 22
    let r = rect(x, y, w, 24)
    x = x + w + (if l[0] == "Redo" || l[0] == "Ripple" then 14 else 6 end)
    {label: l[0], key: l[1], r: r}
  end
end
let TB_Y = TL_Y + 8
let BTNS = tool_buttons(TX0, TB_Y)
let R_ZOOM = rect(R_TL.x + R_TL.w - 10 - 46 - 26 - 130 - 26 - 6, TB_Y + 6, 130, 12)
let R_ZOUT = rect(R_ZOOM.x - 28, TB_Y, 24, 24)
let R_ZIN = rect(R_ZOOM.x + R_ZOOM.w + 4, TB_Y, 24, 24)
let R_FIT = rect(R_ZIN.x + 30, TB_Y, 46, 24)
let PPF_LO = 0.2
let PPF_HI = 16.0

fn zoom_frac(p: num) -> float
  log(p / PPF_LO) / log(PPF_HI / PPF_LO)
end

fn eye_rect(t: int) -> Rect
  rect(R_TL.x + HEAD_W - 38, TY[t] + (TRACKS[t].h - 22) / 2, 26, 22)
end

let BIN_TAB_R = for k in range(0, 4) do
  rect(R_BIN.x + 10 + k * ((BIN_W - 20) / 4), R_BIN.y + 38, (BIN_W - 20) / 4 - 4, 22)
end

// ── Actions shared by keys and buttons ───────────────────────────────────
let act = ""
let blocked = drag.kind != ""

if !blocked then
  if key_pressed("z") && mod_cmd() then
    act = if mod_shift() then "redo" else "undo" end
  elsif !mod_cmd() then
    if key_pressed("space") then playing = !playing end
    if key_pressed("k") then playing = false end
    if key_pressed("l") then playing = true end
    let step = if mod_shift() then FPS else 1 end
    if key_pressed("left") then
      playing = false
      playhead = max(0.0, float(int(floor(playhead)) - step))
    end
    if key_pressed("right") then
      playing = false
      playhead = float(int(floor(playhead)) + step)
    end
    if key_pressed("up") || key_pressed("down") then
      playing = false
      let here = int(round(playhead))
      let pts = edit_points(doc.clips)
      if key_pressed("up") then
        let prev = filter(pts, fn(p) -> p < here)
        if len(prev) > 0 then playhead = float(last(prev)) end
      else
        let nxt = filter(pts, fn(p) -> p > here)
        if len(nxt) > 0 then playhead = float(nxt[0]) end
      end
    end
    if key_pressed("home") then playhead = 0.0 end
    if key_pressed("end") then playhead = float(end_f) end
    if key_pressed("s") then act = "split" end
    if key_pressed("m") then act = "marker" end
    if key_pressed("n") then act = "snap" end
    if key_pressed("delete") || key_pressed("backspace") then
      act = if mod_shift() then "ripple" else "delete" end
    end
    if key_pressed("equals") then act = "zoom_in" end
    if key_pressed("minus") then act = "zoom_out" end
    if key_pressed("backslash") then act = "fit" end
    if key_pressed("escape") then sel = -1 end
  end
end

// ── Mouse press: exactly one gesture starts ──────────────────────────────
if !blocked && mouse_pressed(0) then
  let hit_btn = ""
  for b in BTNS do
    if point_in(mx, my, b.r) then hit_btn = b.label end
  end
  if hit_btn != "" then
    act = lower(hit_btn)
  elsif point_in(mx, my, R_PLAY) then
    playing = !playing
  elsif point_in(mx, my, R_BACK) then
    playing = false
    playhead = max(0.0, float(int(floor(playhead)) - 1))
  elsif point_in(mx, my, R_FWD) then
    playing = false
    playhead = float(int(floor(playhead)) + 1)
  elsif point_in(mx, my, R_PREV) || point_in(mx, my, R_NEXT) then
    playing = false
    let here = int(round(playhead))
    let pts = edit_points(doc.clips)
    if point_in(mx, my, R_PREV) then
      let prev = filter(pts, fn(p) -> p < here)
      if len(prev) > 0 then playhead = float(last(prev)) end
    else
      let nxt = filter(pts, fn(p) -> p > here)
      if len(nxt) > 0 then playhead = float(nxt[0]) end
    end
  elsif point_in(mx, my, R_ZOUT) then
    act = "zoom_out"
  elsif point_in(mx, my, R_ZIN) then
    act = "zoom_in"
  elsif point_in(mx, my, R_FIT) then
    act = "fit"
  elsif point_in(mx, my, rect(R_ZOOM.x - 4, R_ZOOM.y - 6, R_ZOOM.w + 8, R_ZOOM.h + 12)) then
    drag = {...DRAG0, kind: "zoom"}
  elsif point_in(mx, my, rect(R_RULER.x, R_RULER.y - 2, R_RULER.w, R_RULER.h + 2)) then
    playing = false
    drag = {...DRAG0, kind: "scrub"}
  elsif point_in(mx, my, rect(R_SB.x, R_SB.y - 4, R_SB.w, R_SB.h + 8)) then
    drag = {...DRAG0, kind: "scroll", mx0: mx, f0: view0}
  elsif hov_id >= 0 then
    let c = doc.clips[find_clip(doc.clips, hov_id)]
    sel = c.id
    if hov_edge == "l" then
      drag = {...DRAG0, kind: "trim_l", id: c.id, t: c.t, s: c.s, n: c.n, mx0: mx}
    elsif hov_edge == "r" then
      drag = {...DRAG0, kind: "trim_r", id: c.id, t: c.t, s: c.s, n: c.n, mx0: mx}
    else
      drag = {...DRAG0, kind: "move", id: c.id, off: f_at(V, mx) - c.s, t: c.t, s: c.s, n: c.n, m: c.m, mx0: mx}
    end
  elsif in_tracks then
    sel = -1
  elsif hov_bin >= 0 then
    drag = {...DRAG0, kind: "bin", m: hov_bin, mx0: mx, f0: my}
  else
    for t in range(0, N_TRK) do
      if point_in(mx, my, eye_rect(t)) then off[t] = !off[t] end
    end
    for k in range(0, 4) do
      if point_in(mx, my, BIN_TAB_R[k]) then
        bin_tab = k
        bin_scroll = 0.0
      end
    end
  end
  if drag.kind != "" then g_doc = doc end
end

// ── Escape mid-gesture puts everything back ──────────────────────────────
if drag.kind != "" && key_pressed("escape") then
  doc = g_doc
  drag = DRAG0
  toast = say("Edit cancelled")
end

// ── The gesture in flight ────────────────────────────────────────────────
let snap_line = -1
if drag.kind != "" && (mouse_down(0) || mouse_released(0)) then
  if abs(mx - drag.mx0) > 3 || abs(my - drag.f0) > 3 && drag.kind == "bin" then drag.moved = true end
  let fm = f_at(V, mx)
  if drag.kind == "scrub" then
    let f = round(clamp(fm, 0.0, float(end_f + FPS * 10)))
    if snap_on then
      let b = snap_best(snap_points(doc, -1000, -1), [f], SNAP_F)
      if b.at >= 0 then
        f = float(b.at)
        snap_line = b.at
      end
    end
    playhead = f
  elsif drag.kind == "zoom" then
    let u = clamp((mx - R_ZOOM.x) / float(R_ZOOM.w), 0.0, 1.0)
    let np = PPF_LO * pow(PPF_HI / PPF_LO, u)
    let anchor = clamp(playhead, view0, view0 + TW / ppf)
    let ax = fx(V, anchor)
    ppf = np
    view0 = anchor - (ax - TX0) / np
  elsif drag.kind == "scroll" then
    let total = max(float(end_f + FPS * 4), view0 + TW / ppf)
    view0 = drag.f0 + (mx - drag.mx0) * total / TW
  elsif drag.kind == "move" then
    let k = find_clip(doc.clips, drag.id)
    if k >= 0 then
      let c = doc.clips[k]
      let s = int(round(fm - drag.off))
      let ht = track_at(my)
      let t = if ht >= 0 && fits(MEDIA[c.m].kind, ht) then ht else drag.t end
      if snap_on && drag.moved then
        let b = snap_best(snap_points(doc, playhead, c.id), [s, s + c.n], SNAP_F)
        if b.at >= 0 then
          s += b.d
          snap_line = b.at
        end
      end
      drag.s = max(0, s)
      drag.t = t
    end
  elsif drag.kind == "trim_l" || drag.kind == "trim_r" then
    let k = find_clip(doc.clips, drag.id)
    if k >= 0 && drag.moved then
      let c = doc.clips[k]
      let f = int(round(fm))
      if snap_on then
        let b = snap_best(snap_points(doc, playhead, c.id), [f], SNAP_F)
        if b.at >= 0 then
          f = b.at
          snap_line = b.at
        end
      end
      if drag.kind == "trim_l" then
        // A title is generated, so its head extends freely; footage stops
        // at the first frame of its source.
        let is_title = MEDIA[c.m].kind == "title"
        let lo = max(prev_end(doc.clips, c), if is_title then 0 else c.s - c.i end)
        let ns = clamp(f, lo, c.s + c.n - MIN_LEN)
        doc.clips[k] = {...c, s: ns, n: c.n - (ns - c.s), i: max(0, c.i + (ns - c.s))}
      else
        let hi = min(next_start(doc.clips, c), c.s + (MEDIA[c.m].dur - c.i))
        let ne = clamp(f, c.s + MIN_LEN, hi)
        doc.clips[k] = {...c, n: ne - c.s}
      end
      if snap_line >= 0 && (f == doc.clips[k].s || f == doc.clips[k].s + doc.clips[k].n) then
        nil
      else
        snap_line = -1
      end
    end
  elsif drag.kind == "bin" then
    let m = MEDIA[drag.m]
    let ht = if point_in(mx, my, R_TRACKS) then track_at(my) else -1 end
    let n = match m.kind
      when "title" -> 96
      when "audio" -> min(m.dur, 240)
      when _ -> min(m.dur - 24, 120)
    end
    let s = max(0, int(round(fm - 6 / ppf)))
    drag.ok = ht >= 0 && fits(m.kind, ht)
    if drag.ok && snap_on then
      let b = snap_best(snap_points(doc, playhead, -1), [s, s + n], SNAP_F)
      if b.at >= 0 then
        s = max(0, s + b.d)
        snap_line = b.at
      end
    end
    drag.t = ht
    drag.s = s
    drag.n = n
  end
end

// Release: commit the gesture.
if drag.kind != "" && !mouse_down(0) then
  if drag.kind == "move" && drag.moved then
    let k = find_clip(doc.clips, drag.id)
    if k >= 0 then
      let c = doc.clips[k]
      if drag.s != c.s || drag.t != c.t then
        doc = place(doc, {...c, s: drag.s, t: drag.t})
        n_moves += 1
        if snap_line >= 0 then n_snaps += 1 end
      end
    end
  elsif drag.kind == "trim_l" || drag.kind == "trim_r" then
    if doc != g_doc then
      n_trims += 1
      if snap_line >= 0 then n_snaps += 1 end
    end
  elsif drag.kind == "bin" && drag.ok then
    let m = MEDIA[drag.m]
    let c = cl(doc.next, drag.m, drag.t, drag.s, drag.n, if m.kind == "video" then 24 else 0 end)
    doc = place({...doc, next: doc.next + 1}, c)
    sel = c.id
    n_drops += 1
    toast = say("Added {m.name} to {TRACKS[drag.t].code}")
  end
  if doc != g_doc then
    undo = append(undo, g_doc)
    if len(undo) > 80 then undo = slice(undo, 1, len(undo)) end
    redo = []
  end
  drag = DRAG0
end

// ── Commands ─────────────────────────────────────────────────────────────
let ph_f = int(round(playhead))
let pre = doc
match act
  when "undo" ->
    if len(undo) > 0 then
      redo = append(redo, doc)
      doc = last(undo)
      undo = drop_last(undo)
      toast = say("Undo")
    end
  when "redo" ->
    if len(redo) > 0 then
      undo = append(undo, doc)
      doc = last(redo)
      redo = drop_last(redo)
      toast = say("Redo")
    end
  when "split" ->
    doc = split_at(doc, sel, ph_f, off)
    let made = len(doc.clips) - len(pre.clips)
    n_splits += made
    toast = say(if made > 0 then "Split {plural(made, "clip")} at {tc(ph_f)}" else "Nothing under the playhead to split" end)
  when "delete" | "ripple" ->
    if find_clip(doc.clips, sel) >= 0 then
      doc = if act == "ripple" then ripple_delete(doc, sel) else {...doc, clips: without(doc.clips, sel)} end
      n_deletes += 1
      toast = say(if act == "ripple" then "Ripple deleted, gap closed" else "Deleted clip" end)
      sel = -1
    end
  when "marker" ->
    if !any(doc.markers, fn(mk) -> mk.f == ph_f) then
      doc.markers = sort_by(append(doc.markers, {f: ph_f, name: "Marker {len(doc.markers) + 1}"}), fn(mk) -> mk.f)
      toast = say("Marker at {tc(ph_f)}")
    end
  when "snap" ->
    snap_on = !snap_on
    toast = say(if snap_on then "Snapping on" else "Snapping off" end)
  when "zoom_in" | "zoom_out" ->
    let np = clamp(ppf * (if act == "zoom_in" then 1.5 else 1 / 1.5 end), PPF_LO, PPF_HI)
    let anchor = clamp(playhead, view0, view0 + TW / ppf)
    let ax = fx(V, anchor)
    ppf = np
    view0 = anchor - (ax - TX0) / np
  when "fit" ->
    ppf = clamp(TW / (max(end_f, FPS) * 1.04), PPF_LO, PPF_HI)
    view0 = 0.0
  when _ -> nil
end
// A key or button edit is one undo step of its own (undo/redo excepted).
if act != "undo" && act != "redo" && doc != pre then
  undo = append(undo, pre)
  if len(undo) > 80 then undo = slice(undo, 1, len(undo)) end
  redo = []
end
if find_clip(doc.clips, sel) < 0 then sel = -1 end

// ── Wheel: scroll the timeline; cmd/alt zooms around the pointer ─────────
let wy = scroll_y()
let wx = scroll_x()
if drag.kind == "" && (wy != 0 || wx != 0) then
  if point_in(mx, my, rect(TX0, RULER_Y, TW, R_SB.y + R_SB.h - RULER_Y)) then
    if mod_cmd() || mod_alt() || mod_ctrl() then
      let anchor = f_at(V, mx)
      let np = clamp(ppf * (if wy > 0 then 1 / 1.25 else 1.25 end), PPF_LO, PPF_HI)
      ppf = np
      view0 = anchor - (mx - TX0) / np
    else
      let d = if wx != 0 then wx else wy end
      view0 += d * 40 / ppf
    end
  elsif point_in(mx, my, R_BINLIST) then
    let total = len(bin_items) * BIN_ROW
    bin_scroll = clamp(bin_scroll + wy * 30, 0.0, max(0.0, float(total - R_BINLIST.h)))
  end
end

// ═════════════════════════════════════════════════════════════════════════
//  PLAYBACK
// ═════════════════════════════════════════════════════════════════════════
end_f = seq_end(doc.clips)
if playing then
  playhead += fdt * FPS
  played += fdt
  if playhead >= end_f then
    playhead = float(end_f)
    playing = false
  end
  // Page the view along when the playhead runs off the right edge.
  let x = TX0 + (playhead - view0) * ppf
  if x > TX0 + TW - 24 then view0 = playhead - TW * 0.08 / ppf end
  request_frame()
end
playhead = clamp(playhead, 0.0, float(end_f + FPS * 10))

// Keep a playhead that a key or button moved in view.
if !playing && drag.kind == "" && playhead != ph0 then
  let x = TX0 + (playhead - view0) * ppf
  if x < TX0 then view0 = playhead - 20 / ppf end
  if x > TX0 + TW then view0 = playhead - TW * 0.8 / ppf end
end
view0 = clamp(view0, 0.0, max(0.0, float(end_f + FPS * 6) - TW / ppf))
V = {x0: TX0, w: TW, v0: view0, ppf: ppf}

// What the monitor shows: each picture track, bottom-up.
let PH = int(floor(playhead))
let on_air = for t in [2, 1, 0] do
  if off[t] then continue end
  let c = clip_under(doc.clips, t, PH)
  if c == nil then continue end
  c
end

// Meters: the loudness of every live audio clip under the playhead.
let lvl_l = 0.0
let lvl_r = 0.0
for t in [3, 4, 5] do
  let c = clip_under(doc.clips, t, PH)
  if c != nil && !off[t] then
    let m = MEDIA[c.m]
    let gain = match m.scene
      when "vo" -> 0.95
      when "score" -> 0.6
      when _ -> 0.4
    end
    lvl_l += scenes.audio_amp(m.scene, c.i + playhead - c.s) * gain
    lvl_r += scenes.audio_amp(m.scene, c.i + playhead - c.s + 1.5) * gain * (if m.scene == "vo" then 0.85 else 1.0 end)
  end
end
let target = if playing then [min(1.0, lvl_l), min(1.0, lvl_r)] else [0.0, 0.0] end
for ch in range(0, 2) do
  meter[ch] = if target[ch] > meter[ch] then target[ch] else max(target[ch], meter[ch] - fdt * 1.6) end
  peak[ch] = if meter[ch] > peak[ch] then meter[ch] else max(0.0, peak[ch] - fdt * 0.35) end
end
if meter[0] > 0.0 || meter[1] > 0.0 || peak[0] > 0.0 || peak[1] > 0.0 then request_frame() end
if time() - toast.t < 2.2 then request_frame() end

// ── Values for tests ─────────────────────────────────────────────────────
let obs_playhead = PH
let obs_tc = tc(PH)
let obs_playing = playing
let obs_clips = len(doc.clips)
let obs_sel = sel
let obs_zoom = round(ppf, 3)
let obs_view = round(view0, 1)
let obs_snap = snap_on
let obs_undo = len(undo)
let obs_redo = len(redo)
let obs_end = end_f
let obs_drag = drag.kind
let obs_monitor = for c in on_air do MEDIA[c.m].name end
let obs_meter = [round(meter[0], 2), round(meter[1], 2)]
let obs_counts = {moves: n_moves, trims: n_trims, splits: n_splits, drops: n_drops, deletes: n_deletes, snaps: n_snaps}
let obs_markers = len(doc.markers)
let obs_off = off
let obs_layout = for c in sort_by(sort_by(doc.clips, fn(c) -> c.s), fn(c) -> c.t) do
  "{TRACKS[c.t].code}:{c.id}:{c.s}+{c.n}@{c.i}"
end
let obs_played = round(played, 2)

// ═════════════════════════════════════════════════════════════════════════
//  DRAWING
// ═════════════════════════════════════════════════════════════════════════

fn label(s: string, r: record, style: record, align: string) -> nil
  text_layout.draw_text_line(s, r, style, align)
  nil
end

fn panel_card(r: Rect) -> nil
  draw_shadow(r, {radius: 10, blur: 18, spread: 0, dx: 0, dy: 6, color: #000000, a: 90})
  draw_rect_rounded(r, 10, CARD)
  draw_rect_rounded_outline(r, 10, LINE_S)
end

fn chip(x: num, y: num, s: string, c: record) -> float
  let w = text_width(s, S_TINY) + 14
  draw_rect_rounded(x, y, w, 18, 9, tint(CARD, c, 16))
  label(s, rect(x, y, w, 18), {...S_TINY, color: tint(TEXT, c, 45)}, "center")
  w
end

fn key_cap(x: num, y: num, s: string) -> float
  let w = max(18, text_width(s, S_KEY) + 10)
  draw_rect_rounded(x, y, w, 17, 4, WELL_HI)
  draw_rect_rounded_outline(x, y, w, 17, 4, LINE)
  label(s, rect(x, y, w, 17), S_KEY, "center")
  w
end

fn btn(r: Rect, text: string, hot: bool, on: bool, enabled: bool) -> nil
  let bg = if on then tint(WELL, ACCENT, 22) elsif hot && enabled then WELL_HI else WELL end
  draw_rect_rounded(r, 6, bg)
  draw_rect_rounded_outline(r, 6, if on then tint(WELL, ACCENT, 55) else LINE end)
  let fg = if on then ACCENT elsif !enabled then GHOST elsif hot then TEXT else DIM end
  label(text, r, {...S_BTN, color: fg}, "center")
end

// ── Transport icons (no glyphs: every shape is drawn) ────────────────────
fn icon_play(cx: num, cy: num, s: num, c: record) -> nil
  fill_triangle(cx - s * 0.4, cy - s * 0.55, cx - s * 0.4, cy + s * 0.55, cx + s * 0.6, cy, c)
end

fn icon_pause(cx: num, cy: num, s: num, c: record) -> nil
  draw_rect_rounded(cx - s * 0.45, cy - s * 0.55, s * 0.3, s * 1.1, 1, c)
  draw_rect_rounded(cx + s * 0.15, cy - s * 0.55, s * 0.3, s * 1.1, 1, c)
end

fn icon_step(cx: num, cy: num, s: num, dir: num, c: record) -> nil
  fill_triangle(cx - dir * s * 0.35, cy - s * 0.45, cx - dir * s * 0.35, cy + s * 0.45, cx + dir * s * 0.35, cy, c)
  draw_rect(cx + dir * s * 0.35 - (if dir > 0 then 0 else s * 0.16 end), cy - s * 0.45, s * 0.16, s * 0.9, c)
end

fn icon_edit(cx: num, cy: num, s: num, dir: num, c: record) -> nil
  // Jump to an edit point: two arrowheads running into a bar.
  for k in range(0, 2) do
    let tip = cx + dir * (s * 0.3 - k * s * 0.42)
    fill_triangle(tip - dir * s * 0.42, cy - s * 0.4, tip - dir * s * 0.42, cy + s * 0.4, tip, cy, c)
  end
  let bx = cx + dir * s * 0.34
  draw_rect(bx - s * 0.07, cy - s * 0.42, s * 0.14, s * 0.84, c)
end

fn transport_btn(r: Rect, hot: bool, primary: bool) -> nil
  if primary then
    draw_shadow(r, {radius: r.w / 2, blur: 14, spread: 0, dx: 0, dy: 3, color: ACCENT, a: if hot then 110 else 60 end})
    draw_circle(r.x + r.w / 2, r.y + r.h / 2, r.w / 2, if hot then #ffc781 else ACCENT end)
  else
    if hot then draw_rect_rounded(r, 8, WELL_HI) end
  end
end

// ── Bin ──────────────────────────────────────────────────────────────────
fn draw_thumb(m: record, r: Rect, t: num) -> nil
  if m.kind == "audio" then
    draw_rect_rounded(r, 4, tint(#0d1017, m.color, 14))
    let n = int(r.w / 3)
    for k in range(0, n) do
      let a = scenes.audio_amp(m.scene, 40 + k * 7)
      let h = max(1.0, a * (r.h - 8))
      draw_rect(r.x + 2 + k * 3, r.y + r.h / 2 - h / 2, 2, h, m.color, 200)
    end
  elsif m.kind == "title" then
    draw_rect_rounded(r, 4, #101320)
    for k in range(0, int(r.w / 6) + 1) do
      for j in range(0, int(r.h / 6) + 1) do
        if (k + j) % 2 == 0 then draw_rect(r.x + k * 6, r.y + j * 6, min(6, r.w - k * 6), min(6, r.h - j * 6), #161a28) end
      end
    end
    scenes.draw_footage(m.scene, r, 1.6, 4.0, false)
  else
    scenes.draw_footage(m.scene, r, t, m.dur / float(FPS), false)
  end
  draw_rect_rounded_outline(r, 4, #000000, 120)
end

fn draw_bin(items: list, hov: int, tab: int, scroll: num, dragging: int) -> nil
  panel_card(R_BIN)
  label("MEDIA", rect(R_BIN.x + 14, R_BIN.y + 8, 100, 22), S_CAP, "left")
  label("{len(MEDIA)} items", rect(R_BIN.x, R_BIN.y + 8, BIN_W - 14, 22), S_TINY, "right")
  for k in range(0, 4) do
    let r = BIN_TAB_R[k]
    let on = k == tab
    let hot = point_in(mouse_x(), mouse_y(), r)
    draw_rect_rounded(r, 6, if on then WELL_HI elsif hot then WELL else CARD end)
    if on then draw_rect_rounded_outline(r, 6, LINE) end
    label(BIN_TABS[k], r, {...S_SMALL, color: if on then TEXT else FAINT end, weight: if on then 600 else 400 end}, "center")
  end
  clip_push(R_BINLIST)
  for row in range(0, len(items)) do
    let k = items[row]
    let m = MEDIA[k]
    let y = BIN_LIST_Y + row * BIN_ROW - scroll
    if y + BIN_ROW < R_BINLIST.y || y > R_BINLIST.y + R_BINLIST.h then continue end
    let r = rect(R_BINLIST.x, y + 2, R_BINLIST.w, BIN_ROW - 4)
    if k == hov || k == dragging then draw_rect_rounded(r, 7, WELL_HI) end
    let th = rect(r.x + 6, r.y + 5, 64, 36)
    draw_thumb(m, th, 3.0)
    draw_text(text_ellipsize(m.name, S_BODY, r.w - 90), {x: r.x + 80, y: r.y + 6}, {...S_BODY, weight: 600})
    let kind = match m.kind
      when "video" -> "1080p"
      when "title" -> "Title"
      when _ -> "48 kHz"
    end
    draw_rect_rounded(r.x + 80, r.y + 26, 6, 6, 3, m.color)
    draw_text("{kind}  ·  {if m.kind == "title" then "—" else dur_label(m.dur) end}", {x: r.x + 91, y: r.y + 22}, S_TINY)
  end
  clip_pop()
  let total = len(items) * BIN_ROW
  if total > R_BINLIST.h then
    draw_fade(rect(R_BINLIST.x, R_BINLIST.y + R_BINLIST.h - 22, R_BINLIST.w, 22), {edge: "bottom", color: CARD})
    let bar_h = R_BINLIST.h * R_BINLIST.h / float(total)
    let bar_y = R_BINLIST.y + scroll / total * R_BINLIST.h
    draw_rect_rounded(R_BINLIST.x + R_BINLIST.w - 3, bar_y, 3, bar_h, 1.5, GHOST)
  end
end

// ── Monitor ──────────────────────────────────────────────────────────────
fn draw_monitor(air: list, ph: num, play: bool, endf: int, lv: list, pk: list, mode: string) -> nil
  panel_card(R_MON)
  label("PROGRAM", rect(R_MON.x + 16, R_MON.y + 8, 100, 22), S_CAP, "left")
  label("Sequence 01 — Teaser cut", rect(R_MON.x + 80, R_MON.y + 8, 300, 22), S_SMALL, "left")
  let top = if len(air) > 0 then last(air) else nil end
  let now = if mode != "" then "{mode}  ·  {MEDIA[top.m].name}" elsif top == nil then "Gap" else "{TRACKS[top.t].code}  {MEDIA[top.m].name}" end
  label(now, rect(R_MON.x, R_MON.y + 8, R_MON.w - 16, 22), {...S_SMALL, color: if top == nil then FAINT else DIM end}, "right")

  draw_shadow(R_SCR, {radius: 2, blur: 22, spread: 0, dx: 0, dy: 8, color: #000000, a: 160})
  draw_rect(R_SCR, #000000)
  for c in air do
    let m = MEDIA[c.m]
    scenes.draw_footage(m.scene, R_SCR, (c.i + ph - c.s) / float(FPS), (c.i + c.n) / float(FPS), true)
  end
  if len(air) == 0 then
    label("No picture at {tc(ph)}", R_SCR, {...S_SMALL, color: GHOST}, "center")
  end
  // Action-safe guides, faint, like a monitor overlay.
  draw_rect_outline(R_SCR.x + R_SCR.w * 0.05, R_SCR.y + R_SCR.h * 0.05, R_SCR.w * 0.9, R_SCR.h * 0.9, #ffffff, 18)
  if mode != "" then
    // Trim view: the frame at the edge being dragged, framed in the accent.
    draw_rect_outline(R_SCR, ACCENT, 255, 2)
    let tag = if mode == "Trim in" then "IN" else "OUT" end
    let tw = text_width(tag, S_CAP) + 14
    draw_rect_rounded(R_SCR.x + 10, R_SCR.y + 10, tw, 18, 4, ACCENT)
    label(tag, rect(R_SCR.x + 10, R_SCR.y + 10, tw, 18), {...S_CAP, color: #1a1206}, "center")
  end

  // Meters: two channels, -60..0 dB, green to amber to red.
  let mr = R_METER
  for ch in range(0, 2) do
    let r = rect(mr.x + ch * 9, mr.y, 7, mr.h - 14)
    draw_rect_rounded(r, 2, #07090d)
    let v = lv[ch]
    let segs = int(r.h / 4)
    let lit = int(v * segs)
    for k in range(0, lit) do
      let u = k / float(segs)
      let c = if u > 0.88 then #ff5d55 elsif u > 0.7 then #f2b766 else #4fc28a end
      draw_rect(r.x + 1, r.y + r.h - 2 - (k + 1) * 4 + 1, 5, 3, c)
    end
    if pk[ch] > 0.02 then
      draw_rect(r.x + 1, r.y + r.h - 2 - pk[ch] * segs * 4, 5, 2, TEXT, 200)
    end
  end
  label("L R", rect(mr.x - 4, mr.y + mr.h - 12, 26, 12), {...S_TINY, size: 8}, "center")

  // Transport row.
  label(tc(ph), rect(R_MON.x + 18, FOOT_Y + 2, 200, 28), S_TCBIG, "left")
  label("of {tc(endf)}", rect(R_MON.x + 19, FOOT_Y + 30, 200, 16), {...S_TC, size: 10, color: FAINT}, "left")
  let mx = mouse_x()
  let my = mouse_y()
  transport_btn(R_PREV, point_in(mx, my, R_PREV), false)
  transport_btn(R_BACK, point_in(mx, my, R_BACK), false)
  transport_btn(R_PLAY, point_in(mx, my, R_PLAY), true)
  transport_btn(R_FWD, point_in(mx, my, R_FWD), false)
  transport_btn(R_NEXT, point_in(mx, my, R_NEXT), false)
  icon_edit(R_PREV.x + 18, R_PREV.y + 16, 12, -1, DIM)
  icon_step(R_BACK.x + 18, R_BACK.y + 16, 12, -1, DIM)
  if play then icon_pause(R_PLAY.x + 20, R_PLAY.y + 20, 16, #1a1206) else icon_play(R_PLAY.x + 21, R_PLAY.y + 20, 16, #1a1206) end
  icon_step(R_FWD.x + 18, R_FWD.y + 16, 12, 1, DIM)
  icon_edit(R_NEXT.x + 18, R_NEXT.y + 16, 12, 1, DIM)
  let fr = "24 fps  ·  1920×1080"
  label(fr, rect(R_MON.x, FOOT_Y, R_MON.w - 18, 48), S_TINY, "right")
end

// ── Inspector ────────────────────────────────────────────────────────────
fn prop(y: num, k: string, v: string) -> nil
  label(k, rect(R_INS.x + 16, y, 100, 20), S_SMALL, "left")
  label(v, rect(R_INS.x, y, INS_W - 16, 20), {...S_TC, color: TEXT}, "right")
end

fn draw_inspector(d: record, sel_id: int, ph: num, endf: int) -> nil
  panel_card(R_INS)
  let k = find_clip(d.clips, sel_id)
  let x = R_INS.x + 16
  if k < 0 then
    label("SEQUENCE", rect(x, R_INS.y + 8, 100, 22), S_CAP, "left")
    draw_text("Harbour Lights", {x: x, y: R_INS.y + 34}, S_TITLE)
    draw_text("Teaser cut  ·  v12", {x: x, y: R_INS.y + 54}, S_SUB)
    let y = R_INS.y + 82
    prop(y, "Duration", tc(endf))
    prop(y + 20, "Clips", str(len(d.clips)))
    prop(y + 40, "Markers", str(len(d.markers)))
    prop(y + 60, "Format", "1080p · 24 fps")
    draw_rect(x, y + 88, INS_W - 32, 1, LINE_S)
    label("SHORTCUTS", rect(x, y + 96, 100, 20), S_CAP, "left")
    let hints = [["Space", "Play / pause"], ["← →", "Step a frame (⇧ 1 s)"], ["↑ ↓", "Previous / next edit"],
      ["S", "Split at playhead"], ["⌫", "Delete  (⇧ ripple)"], ["⌘Z", "Undo  (⇧ redo)"], ["= −", "Zoom  (\\ fit)"]]
    let hy = y + 120
    for h in hints do
      if hy + 18 > R_INS.y + UP_H - 8 then break end
      key_cap(x, hy, h[0])
      label(h[1], rect(x + 52, hy - 1, 180, 19), S_SMALL, "left")
      hy += 22
    end
    return nil
  end
  let c = d.clips[k]
  let m = MEDIA[c.m]
  let tr = TRACKS[c.t]
  label("CLIP", rect(x, R_INS.y + 8, 100, 22), S_CAP, "left")
  chip(R_INS.x + INS_W - 16 - text_width(tr.code ++ "  " ++ tr.name, S_TINY) - 14, R_INS.y + 10, tr.code ++ "  " ++ tr.name, tr.color)
  draw_text(text_ellipsize(m.name, S_TITLE, INS_W - 32), {x: x, y: R_INS.y + 34}, S_TITLE)
  draw_text(text_ellipsize(m.file, S_SUB, INS_W - 32), {x: x, y: R_INS.y + 54}, {...S_SUB, color: FAINT})
  // A still of the frame under the playhead, or the clip's first frame.
  let pv = rect(x, R_INS.y + 76, INS_W - 32, (INS_W - 32) * 9 / 16)
  let at = if ph >= c.s && ph < c.s + c.n then ph else float(c.s) end
  if m.kind == "audio" then
    draw_rect_rounded(pv, 6, tint(#0d1017, m.color, 10))
    let n = int(pv.w / 3)
    let span = c.n / float(n)
    for j in range(0, n) do
      let a = scenes.audio_amp(m.scene, c.i + j * span)
      let h = max(1.0, a * (pv.h - 16))
      let past = c.s + j * span <= ph
      draw_rect(pv.x + 1 + j * 3, pv.y + pv.h / 2 - h / 2, 2, h, m.color, if past then 255 else 120 end)
    end
  else
    draw_rect_rounded(pv, 6, #000000)
    clip_push(pv, 6)
    scenes.draw_footage(m.scene, pv, (c.i + at - c.s) / float(FPS), (c.i + c.n) / float(FPS), true)
    clip_pop()
  end
  draw_rect_rounded_outline(pv, 6, LINE)
  let y = pv.y + pv.h + 10
  prop(y, "Start", tc(c.s))
  prop(y + 19, "End", tc(c.s + c.n))
  prop(y + 38, "Duration", dur_label(c.n))
  if m.kind != "title" then
    prop(y + 57, "Source in", tc(c.i))
    // Where the clip sits inside its source media.
    let bar = rect(x, y + 84, INS_W - 32, 6)
    draw_rect_rounded(bar, 3, WELL_HI)
    let a = bar.x + bar.w * c.i / float(m.dur)
    let b = bar.x + bar.w * (c.i + c.n) / float(m.dur)
    draw_rect_rounded(a, bar.y, max(3, b - a), bar.h, 3, m.color)
    label("Uses {dur_label(c.n)} of {dur_label(m.dur)} source", rect(x, y + 92, INS_W - 32, 18), S_TINY, "left")
  else
    label("Generated title  ·  any length", rect(x, y + 58, INS_W - 32, 18), S_TINY, "left")
  end
end

// ── Timeline ─────────────────────────────────────────────────────────────
fn tick_step(p: num) -> int
  let out = 14400
  for st in [1, 2, 4, 6, 12, 24, 48, 120, 240, 480, 1440, 2880, 7200, 14400] do
    if st * p >= 74 && out == 14400 then out = st end
  end
  out
end

fn draw_ruler(v: record, d: record, ph: num, endf: int) -> nil
  draw_rect(R_RULER, WELL)
  let step = tick_step(v.ppf)
  let minor = if step % 4 == 0 then step / 4 elsif step % 3 == 0 then step / 3 else step / 2 end
  let f0 = int(floor(v.v0 / minor)) * minor
  let f1 = int(v.v0 + v.w / v.ppf) + minor
  clip_push(R_RULER)
  // Beyond the end of the sequence is dimmed.
  let ex = fx(v, endf)
  if ex < R_RULER.x + R_RULER.w then
    draw_rect(max(ex, R_RULER.x), R_RULER.y, R_RULER.x + R_RULER.w - max(ex, R_RULER.x), R_RULER.h, BG, 120)
  end
  for f in range(f0, f1, max(1, minor)) do
    let x = fx(v, f)
    if f % step == 0 then
      draw_rect(x, R_RULER.y + 13, 1, R_RULER.h - 13, GHOST)
      draw_text(ruler_label(f, step), {x: x + 4, y: R_RULER.y + 3}, S_RULER)
    else
      draw_rect(x, R_RULER.y + R_RULER.h - 6, 1, 6, LINE)
    end
  end
  for mk in d.markers do
    let x = fx(v, mk.f)
    fill_polygon([[x, R_RULER.y + R_RULER.h], [x - 5, R_RULER.y + R_RULER.h - 6], [x - 5, R_RULER.y + R_RULER.h - 13],
      [x + 5, R_RULER.y + R_RULER.h - 13], [x + 5, R_RULER.y + R_RULER.h - 6]], #6fb3f2)
  end
  // A marker under the pointer names itself.
  for mk in d.markers do
    let x = fx(v, mk.f)
    if abs(mouse_x() - x) <= 6 && point_in(mouse_x(), mouse_y(), R_RULER) then
      let w = text_width(mk.name, S_TINY) + 12
      let bx = if x + 8 + w > R_RULER.x + R_RULER.w then x - 8 - w else x + 8 end
      draw_rect_rounded(bx, R_RULER.y + 3, w, 16, 4, #1d3550)
      label(mk.name, rect(bx, R_RULER.y + 3, w, 16), {...S_TINY, color: #cfe4fb}, "center")
    end
  end
  clip_pop()
  draw_rect(R_RULER.x, R_RULER.y + R_RULER.h - 1, R_RULER.w, 1, LINE)
end

fn draw_track_heads(dead: list, d: record) -> nil
  for t in range(0, N_TRK) do
    let tr = TRACKS[t]
    let r = rect(R_TL.x + 8, TY[t], HEAD_W - 14, tr.h - 2)
    draw_rect_rounded(r, 6, WELL)
    draw_rect_rounded(r.x, r.y + 6, 3, r.h - 12, 1.5, if dead[t] then GHOST else tr.color end)
    label(tr.code, rect(r.x + 12, r.y, 26, r.h), {size: 11, font: "mono", weight: 700, color: if dead[t] then FAINT else tint(TEXT, tr.color, 55) end}, "left")
    label(tr.name, rect(r.x + 40, r.y, 80, r.h), {...S_SMALL, color: if dead[t] then FAINT else TEXT end}, "left")
    let er = eye_rect(t)
    let hot = point_in(mouse_x(), mouse_y(), er)
    draw_rect_rounded(er, 5, if hot then WELL_HI else WELL end)
    let cx = er.x + er.w / 2
    let cy = er.y + er.h / 2
    let ic = if dead[t] then GHOST elsif hot then TEXT else DIM end
    if tr.kind == "video" then
      draw_ellipse_outline(cx, cy, 7, 4.5, ic, 255, 1.5)
      draw_circle(cx, cy, 2.2, ic)
    else
      draw_rect(cx - 6, cy - 2.5, 3.5, 5, ic)
      fill_triangle(cx - 3, cy - 2.5, cx - 3, cy + 2.5, cx + 2, cy - 6, ic)
      fill_triangle(cx - 3, cy + 2.5, cx + 2, cy + 6, cx + 2, cy - 6, ic)
      if !dead[t] then
        draw_line(cx + 4.5, cy - 3, cx + 4.5, cy + 3, ic, 255, 1.2)
      end
    end
    if dead[t] then draw_line(cx - 7, cy + 6, cx + 7, cy - 6, HEAD, 255, 1.6) end
  end
end

fn draw_waveform(v: record, c: record, m: record, r: Rect, col: record) -> nil
  let x0 = max(r.x + 1, float(TX0))
  let x1 = min(r.x + r.w - 1, float(TX0 + TW))
  let mid = r.y + 9 + (r.h - 9) / 2
  let half = (r.h - 13) / 2
  let x = x0
  while x < x1 do
    let f = f_at(v, x)
    let a = scenes.audio_amp(m.scene, c.i + f - c.s)
    let h = max(1.0, a * half)
    draw_rect(x, mid - h, 2, h * 2, col)
    x += 3
  end
end

fn draw_filmstrip(v: record, c: record, m: record, r: Rect) -> nil
  let th = r.h - 15
  let tw = th * 16 / 9
  let x = r.x
  let lo = float(TX0) - tw
  let hi = float(TX0 + TW)
  while x < r.x + r.w && x < hi do
    if x > lo then
      let src = c.i + f_at(v, x) - c.s
      scenes.draw_footage(m.scene, rect(x, r.y + 14, tw, th), src / float(FPS), m.dur / float(FPS), false)
      draw_rect(x + tw - 1, r.y + 14, 1, th, #000000, 140)
    end
    x += tw
  end
end

fn draw_clip(v: record, c: record, r: Rect, selected: bool, hot: bool, edge: string, ghost: bool, dead: bool) -> nil
  let m = MEDIA[c.m]
  let col = m.color
  let body = tint(#0c0f15, col, if m.kind == "audio" then 20 else 26 end)
  if ghost then
    draw_shadow(r, {radius: 6, blur: 16, spread: 0, dx: 0, dy: 6, color: #000000, a: 160})
  end
  clip_push(r, 5)
  draw_rect(r, body)
  if m.kind == "video" then
    draw_filmstrip(v, c, m, r)
  elsif m.kind == "audio" then
    draw_waveform(v, c, m, r, tint(body, col, 70))
  else
    draw_rect_gradient(rect(r.x, r.y + 13, r.w, r.h - 13), tint(#0c0f15, col, 34), tint(#0c0f15, col, 18), 0)
    draw_text("T", {x: r.x + 7, y: r.y + 15}, {size: 16, font: "ui", weight: 700, color: tint(body, col, 60)})
    if r.w > 60 then
      draw_text(text_ellipsize(m.file, S_TINY, r.w - 30), {x: r.x + 24, y: r.y + 20}, {...S_TINY, color: tint(body, col, 55)})
    end
  end
  draw_rect(r.x, r.y, r.w, 13, tint(#0c0f15, col, if selected then 75 elsif hot then 55 else 45 end))
  if r.w > 26 then
    let name_x = max(r.x + 5, float(TX0 + 4))
    let avail = r.x + r.w - name_x - 6
    if avail > 18 then
      draw_text(text_ellipsize(m.name, S_CLIP, avail), {x: name_x, y: r.y}, {...S_CLIP, color: if selected then #0c0f15 else #f4f6fa end})
    end
  end
  if dead then draw_rect(r, BG, 150) end
  clip_pop()
  if selected then
    draw_rect_rounded_outline(r, 5, #ffffff, 255, 2)
  elsif hot then
    draw_rect_rounded_outline(r, 5, tint(body, col, 80), 255, 1)
  else
    draw_rect_rounded_outline(r, 5, #000000, 110, 1)
  end
  // Trim grips: a bracket on the edge under the pointer.
  if edge == "l" then
    draw_rect_rounded(r.x - 1, r.y - 1, 5, r.h + 2, 2, ACCENT)
    draw_rect(r.x + 4, r.y - 1, 5, 2, ACCENT)
    draw_rect(r.x + 4, r.y + r.h - 1, 5, 2, ACCENT)
  elsif edge == "r" then
    draw_rect_rounded(r.x + r.w - 4, r.y - 1, 5, r.h + 2, 2, ACCENT)
    draw_rect(r.x + r.w - 9, r.y - 1, 5, 2, ACCENT)
    draw_rect(r.x + r.w - 9, r.y + r.h - 1, 5, 2, ACCENT)
  end
end

fn draw_toolbar(btns: list, can_undo: bool, can_redo: bool, has_sel: bool, snap: bool, p: num) -> nil
  label("TIMELINE", rect(R_TL.x + 16, TB_Y, 120, 24), S_CAP, "left")
  let mx = mouse_x()
  let my = mouse_y()
  for b in btns do
    let enabled = match b.label
      when "Undo" -> can_undo
      when "Redo" -> can_redo
      when "Delete" | "Ripple" -> has_sel
      when _ -> true
    end
    btn(b.r, b.label, point_in(mx, my, b.r), b.label == "Snap" && snap, enabled)
  end
  btn(R_ZOUT, "−", point_in(mx, my, R_ZOUT), false, p > PPF_LO)
  btn(R_ZIN, "+", point_in(mx, my, R_ZIN), false, p < PPF_HI)
  btn(R_FIT, "Fit", point_in(mx, my, R_FIT), false, true)
  let u = zoom_frac(p)
  draw_rect_rounded(R_ZOOM.x, R_ZOOM.y + 4, R_ZOOM.w, 4, 2, WELL_HI)
  draw_rect_rounded(R_ZOOM.x, R_ZOOM.y + 4, R_ZOOM.w * u, 4, 2, tint(WELL, ACCENT, 60))
  draw_circle(R_ZOOM.x + R_ZOOM.w * u, R_ZOOM.y + 6, 6, TEXT)
  draw_circle_outline(R_ZOOM.x + R_ZOOM.w * u, R_ZOOM.y + 6, 6, #000000, 90, 1)
end

fn draw_timeline(v: record, d: record, sel_id: int, hid: int, hedge: string, dr: record, dead: list, snap_f: int, ph: num, endf: int) -> nil
  draw_rect(R_TL.x + 1, RULER_Y - 1, R_TL.w - 2, 1, LINE_S)
  // Track lanes.
  for t in range(0, N_TRK) do
    let tr = TRACKS[t]
    let lane = rect(TX0, TY[t], TW, tr.h - 2)
    let target = dr.kind == "move" && dr.moved && dr.t == t || dr.kind == "bin" && dr.ok && dr.t == t
    draw_rect(lane, if target then tint(WELL, tr.color, 8) else tint(CARD, #000000, 25) end)
    if t == 2 then draw_rect(TX0, TY[t] + tr.h, TW, 1, LINE) end
  end
  let ex = fx(v, endf)
  if ex < TX0 + TW then
    draw_rect(max(ex, float(TX0)), TRK_Y0, TX0 + TW - max(ex, float(TX0)), TRK_END - TRK_Y0, BG, 110)
  end
  draw_track_heads(dead, d)

  clip_push(rect(TX0, TRK_Y0 - 2, TW, TRK_END - TRK_Y0 + 4))
  // Marker lines run faintly through the tracks.
  for mk in d.markers do
    draw_rect(fx(v, mk.f), TRK_Y0, 1, TRK_END - TRK_Y0, #6fb3f2, 40)
  end
  for c in d.clips do
    let r = clip_rect(v, c)
    if r.x > TX0 + TW || r.x + r.w < TX0 then continue end
    let moving = dr.kind == "move" && dr.moved && dr.id == c.id
    if moving then
      // Leave a hollow where the clip was picked up from.
      draw_rect_rounded_outline(r, 5, GHOST, 255, 1)
      continue
    end
    let trimming = (dr.kind == "trim_l" || dr.kind == "trim_r") && dr.id == c.id
    let edge = if trimming then (if dr.kind == "trim_l" then "l" else "r" end) elsif c.id == hid then hedge else "" end
    draw_clip(v, c, r, c.id == sel_id, c.id == hid, edge, false, dead[c.t])
  end
  // The clip being dragged, at its candidate position, over everything.
  if dr.kind == "move" && dr.moved then
    let k = find_clip(d.clips, dr.id)
    if k >= 0 then
      let c = {...d.clips[k], s: dr.s, t: dr.t}
      draw_clip(v, c, clip_rect(v, c), true, false, "", true, false)
    end
  end
  if dr.kind == "bin" && dr.ok then
    let c = cl(-1, dr.m, dr.t, dr.s, dr.n, if MEDIA[dr.m].kind == "video" then 24 else 0 end)
    draw_clip(v, c, clip_rect(v, c), true, false, "", true, false)
  end
  if snap_f >= 0 then
    let sx = fx(v, snap_f)
    draw_rect(sx - 1, TRK_Y0 - 2, 2, TRK_END - TRK_Y0 + 4, SNAPC)
  end
  clip_pop()

  // Playhead.
  let px = fx(v, ph)
  if px >= TX0 - 1 && px <= TX0 + TW + 1 then
    draw_rect(px - 1, R_RULER.y + 8, 2, TRK_END - R_RULER.y - 8, HEAD)
    fill_polygon([[px - 6, R_RULER.y + 2], [px + 6, R_RULER.y + 2], [px + 6, R_RULER.y + 13], [px, R_RULER.y + 19],
      [px - 6, R_RULER.y + 13]], HEAD)
  end
  if snap_f >= 0 then
    let sx = fx(v, snap_f)
    fill_triangle(sx - 5, R_RULER.y + R_RULER.h - 7, sx + 5, R_RULER.y + R_RULER.h - 7, sx, R_RULER.y + R_RULER.h - 1, SNAPC)
  end

  // Scrollbar.
  let total = max(float(endf + FPS * 4), v.v0 + v.w / v.ppf)
  let a = R_SB.x + R_SB.w * v.v0 / total
  let w = max(24.0, R_SB.w * (v.w / v.ppf) / total)
  draw_rect_rounded(R_SB, 4, WELL)
  let hot = dr.kind == "scroll" || point_in(mouse_x(), mouse_y(), rect(R_SB.x, R_SB.y - 4, R_SB.w, R_SB.h + 8))
  draw_rect_rounded(min(a, R_SB.x + R_SB.w - w), R_SB.y + 1, w, R_SB.h - 2, 3, if hot then FAINT else GHOST end)
  label("{len(d.clips)} clips  ·  {tc(endf)}", rect(R_TL.x + 16, R_SB.y - 6, HEAD_W - 20, 20), S_TINY, "left")
end

// ── Frame ────────────────────────────────────────────────────────────────
clear(BG.r, BG.g, BG.b)

// Top bar.
let brand_x = M + 4
draw_rect_rounded(brand_x, 14, 22, 22, 5, ACCENT)
draw_rect(brand_x + 5, 19, 3, 12, #1a1206)
draw_rect(brand_x + 10, 19, 3, 12, #1a1206)
draw_rect(brand_x + 15, 19, 3, 12, #1a1206)
label("SPLICE", rect(brand_x + 32, 10, 100, 30), S_BRAND, "left")
draw_rect(brand_x + 112, 16, 1, 18, LINE)
label("Harbour Lights", rect(brand_x + 126, 10, 200, 30), S_TITLE, "left")
label("Teaser cut  ·  Sequence 01", rect(brand_x + 126 + text_width("Harbour Lights", S_TITLE) + 12, 11, 260, 30), S_SUB, "left")
let cx = W - M - 4
let chips = [[if snap_on then "Snapping on" else "Snapping off" end, if snap_on then ACCENT else FAINT end],
  ["{plural(len(undo), "edit")}", #6fb3f2], [if playing then "Playing" else "Paused" end, if playing then #4fc28a else FAINT end]]
for ch in chips do
  let w = text_width(ch[0], S_TINY) + 14
  cx -= w
  chip(cx, 16, ch[0], ch[1])
  cx -= 6
end

let dragging_bin = if drag.kind == "bin" then drag.m else -1 end
draw_bin(bin_items, hov_bin, bin_tab, bin_scroll, dragging_bin)
let trim_k = if drag.kind == "trim_l" || drag.kind == "trim_r" then find_clip(doc.clips, drag.id) else -1 end
if trim_k >= 0 then
  let c = doc.clips[trim_k]
  let at = if drag.kind == "trim_l" then c.s else c.s + c.n - 1 end
  draw_monitor([c], float(at), false, end_f, meter, peak, if drag.kind == "trim_l" then "Trim in" else "Trim out" end)
else
  draw_monitor(on_air, playhead, playing, end_f, meter, peak, "")
end
draw_inspector(doc, sel, playhead, end_f)
panel_card(R_TL)
draw_toolbar(BTNS, len(undo) > 0, len(redo) > 0, sel >= 0, snap_on, ppf)
draw_ruler(V, doc, playhead, end_f)
draw_timeline(V, doc, sel, hov_id, hov_edge, drag, off, snap_line, playhead, end_f)

// Timecode bubble on the playhead while scrubbing or trimming.
if drag.kind == "scrub" || drag.kind == "trim_l" || drag.kind == "trim_r" || drag.kind == "move" && drag.moved then
  let k = find_clip(doc.clips, drag.id)
  let f = if drag.kind == "scrub" || k < 0 then PH
    elsif drag.kind == "move" then drag.s
    elsif drag.kind == "trim_l" then doc.clips[k].s
    else doc.clips[k].s + doc.clips[k].n
  end
  let s = tc(f)
  let bw = text_width(s, S_TC) + 16
  let lx = fx(V, f)
  let bx = if lx + 10 + bw > TX0 + TW then lx - 10 - bw else lx + 10 end
  let br = rect(bx, RULER_Y + 3, bw, 19)
  draw_rect_rounded(br, 5, #05070a)
  draw_rect_rounded_outline(br, 5, if drag.kind == "scrub" then HEAD else ACCENT end)
  label(s, br, {...S_TC, color: TEXT}, "center")
end

// A bin item in flight follows the pointer.
if drag.kind == "bin" && drag.moved && !drag.ok then
  let m = MEDIA[drag.m]
  let r = rect(mx + 10, my + 8, 96, 54)
  draw_shadow(r, {radius: 6, blur: 18, spread: 0, dx: 0, dy: 8, color: #000000, a: 170})
  draw_thumb(m, r, 3.0)
  let nm = text_ellipsize(m.name, S_TINY, 120)
  let nw = text_width(nm, S_TINY) + 12
  draw_rect_rounded(r.x, r.y + r.h + 4, nw, 17, 4, #05070a, 220)
  label(nm, rect(r.x, r.y + r.h + 4, nw, 17), {...S_TINY, color: TEXT}, "center")
end

// Toast.
let age = time() - toast.t
if age < 2.2 && toast.text != "" then
  let a = clamp((2.2 - age) / 0.4, 0.0, 1.0)
  let w = text_width(toast.text, S_BODY) + 28
  let r = rect(R_SCR.x + (R_SCR.w - w) / 2, R_SCR.y + R_SCR.h - 44, w, 30)
  layer(r, {a: int(255 * a)}, fn()
    draw_rect_rounded(rect(0, 0, r.w, r.h), 8, #10131a, 235)
    draw_rect_rounded_outline(rect(0, 0, r.w, r.h), 8, #3a4252)
    label(toast.text, rect(0, 0, r.w, r.h), S_BODY, "center")
  end)
end
