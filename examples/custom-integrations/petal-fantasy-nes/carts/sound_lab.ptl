// sound_lab — turn the knobs on the sound chip and hear it immediately.
//
//   cargo run -- carts/sound_lab.ptl
//   SELECT       next channel (pulse 1, pulse 2, triangle, noise)
//   UP/DOWN      pick a parameter
//   LEFT/RIGHT   change it (hold to sweep)
//   A            gate the channel on / off
//   B            reset this channel
//
// This cart talks to the chip directly with `apu_pulse` / `apu_triangle` /
// `apu_noise` and never touches the `nes_sound` driver, because the two are
// alternatives, not layers: the driver's job is to write those same four
// registers once a frame from a song, and having both do it would just mean
// whichever ran last won. A cart plays music *or* it drives the chip by hand.
//
// The registers are re-written every frame from the values below — that is the
// whole model. Nothing is "triggered"; a note is simply what the register says
// this frame, which is why sweeping a value with the d-pad bends the pitch
// instead of restarting it.

set_backdrop(black)
palette(0, white, gray, dark_gray)     // labels
palette(1, yellow, orange, brown)      // the selected row / channel
palette(2, green, dark_green, olive)   // meters
palette(3, cyan, teal, navy)           // the waveform sketch

define_art(0, ["........"])
define_art(1, ["11111111", "11111111", "11111111", "11111111",
               "11111111", "11111111", "11111111", "11111111"])

set_map_size(32, 30)
fill_map(0, 0)

// ── The settings ──────────────────────────────────────────────────────────
// One record holds every knob on the console, and each channel's parameter
// table names the fields it owns. Keeping them in one place is what lets the
// cursor, the meters and the register writes all be written once instead of
// four times.

state var cfg = {note: 60, duty: 2, vol: 12, per: 8, nvol: 10, mode: 0, tri_on: 1}
state var chan = 0
state var cursor = 0
state var gate = true

let defaults = {note: 60, duty: 2, vol: 12, per: 8, nvol: 10, mode: 0, tri_on: 1}

// label, field, low, high — the four things a knob needs.
let knobs = [
  [["NOTE", "note", 24, 107], ["DUTY", "duty", 0, 3], ["VOLUME", "vol", 0, 15]],
  [["NOTE", "note", 24, 107], ["DUTY", "duty", 0, 3], ["VOLUME", "vol", 0, 15]],
  [["NOTE", "note", 24, 107], ["ON", "tri_on", 0, 1]],
  [["PERIOD", "per", 0, 15], ["VOLUME", "nvol", 0, 15], ["MODE", "mode", 0, 1]]
]

let names = ["PULSE 1", "PULSE 2", "TRIANGLE", "NOISE"]
let tabs = ["PUL1", "PUL2", "TRI", "NOISE"]

// ── Input ─────────────────────────────────────────────────────────────────

if btnp("select") then
  set chan = pmod(chan + 1, 4)
  set cursor = 0
end

let rows = knobs[chan]

if btnp("up") then
  set cursor = pmod(cursor - 1, len(rows))
end
if btnp("down") then
  set cursor = pmod(cursor + 1, len(rows))
end
if btnp("a") then
  set gate = !gate
end

// Held left/right sweeps: fast enough to hear a pitch bend, slow enough to
// land on a particular duty. `btn_repeat` gives the first press for free.
let k = rows[cursor]
let step = (if btn_repeat("right", 0.3, 0.03) then 1 else 0 end) -
           (if btn_repeat("left", 0.3, 0.03) then 1 else 0 end)

let c = cfg
if step != 0 then
  c[k[1]] = clamp(c[k[1]] + step, k[2], k[3])
end
if btnp("b") then
  for kn in rows do
    c[kn[1]] = defaults[kn[1]]
  end
end
set cfg = c

// ── Writing the chip ──────────────────────────────────────────────────────
// All four channels are written every frame; the three that are not selected
// are written silent. Writing silence explicitly rather than just not writing
// is the habit that keeps a cart from leaving a note ringing after a scene
// change — the registers hold their last value forever otherwise.

let live = gate

apu_pulse(0, cfg.note, cfg.duty, if chan == 0 && live then cfg.vol else 0 end)
apu_pulse(1, cfg.note, cfg.duty, if chan == 1 && live then cfg.vol else 0 end)
apu_triangle(cfg.note, chan == 2 && live && cfg.tri_on > 0)
apu_noise(cfg.per, if chan == 3 && live then cfg.nvol else 0 end, cfg.mode)

// ── The screen ────────────────────────────────────────────────────────────

map_text_center(1, "SOUND LAB", 0)

// Channel tabs, the selected one in the highlight palette.
let tx = 2
for i in range(0, len(tabs)) do
  map_text(tx, 3, tabs[i], if i == chan then 1 else 0 end)
  tx = tx + len(tabs[i]) + 2
end

map_text(2, 5, names[chan] ++ "  " ++ (if live then "ON " else "OFF" end), 1)

// One line per knob: cursor, label, value, and a meter that makes a sweep
// legible at a glance.
for i in range(0, len(rows)) do
  let kn = rows[i]
  let v = cfg[kn[1]]
  let pal = if i == cursor then 1 else 0 end
  let y = 8 + i * 3

  map_text(1, y, if i == cursor then ">" else " " end, pal)
  map_text(3, y, kn[0], pal)
  map_text(11, y, "      ", pal)
  map_text(11, y, str(v), pal)

  // The pitch knobs are worth showing as a note name as well as a number.
  if kn[1] == "note" then
    map_text(15, y, note_name(v), pal)
  end

  let span = kn[3] - kn[2]
  let full = 12
  let lit = if span == 0 then full else int(round(full * (v - kn[2]) / span)) end
  map_rect(19, y, full, 1, 0, 0)
  map_rect(19, y, max(0, lit), 1, 1, 2)
end

// ── The waveform sketch ───────────────────────────────────────────────────
// Not a real oscilloscope — the host does not hand the samples back — but a
// drawing of what the selected channel's generator is doing, from the same
// numbers that were just written to it. Enough to connect "duty 0" with "thin,
// nasal" without having to imagine it.

fn sketch_pulse(duty)
  let high = [1, 2, 4, 6][duty]
  let prev = -1
  for x in range(0, 32) do
    let y = if x % 8 < high then 18 else 22 end
    if prev >= 0 && prev != y then
      map_rect(x, 18, 1, 5, 1, 3)
    end
    set_tile(x, y, 1, 3)
    prev = y
  end
end

fn sketch_triangle()
  for x in range(0, 32) do
    let p = x % 16
    let up = if p < 8 then p else 16 - p end
    set_tile(x, 22 - int(up / 2), 1, 3)
  end
end

fn sketch_noise(per)
  // A stable hash, not `random`: the picture has to hold still between frames
  // or it reads as an animation rather than as the shape of the sound.
  for x in range(0, 32) do
    let h = int(fract(sin(x * 12.9898 + per * 7.13) * 43758.5453) * 5)
    map_rect(x, 22 - h, 1, h + 1, 1, 3)
  end
end

if chan == 3 then
  sketch_noise(cfg.per)
elsif chan == 2 then
  sketch_triangle()
else
  sketch_pulse(cfg.duty)
end

map_text(1, 25, "SEL CHAN  UD PICK  LR CHANGE", 0)
map_text(1, 26, "A GATE  B RESET", 0)
map_text(1, 28, "REGISTERS REWRITTEN EACH FRAME", 0)
