// Every drawing primitive a panel has, on one screen — the visual reference
// for the vocabulary in docs/petal-graphical-panels.md, and the fixture the
// renderer is checked against.
//
// Use it from a layout script:   panel("examples/panels/shapes.ptl")

let w = screen_width()
let h = screen_height()

clear(14, 16, 22)

fn label(text, x, y)
  draw_text(text, x, y, size: 12, r: 150, g: 160, b: 180)
end

// ── Row 1: strokes ────────────────────────────────────────────────────────
// A polyline is one shape, so a translucent stroke composites evenly instead
// of darkening at every join the way overlapping circles or lines do.
label("polyline", x: 20, y: 16)
let zig = [[20, 40], [60, 90], [100, 40], [140, 90], [180, 40]]
draw_polyline(points: zig, r: 90, g: 200, b: 255, a: 120, width: 14)

label("draw_line x4 (for contrast)", x: 210, y: 16)
let lines = [[210, 40], [250, 90], [290, 40], [330, 90], [370, 40]]
for i in range(0, 4) do
  draw_line(x1: lines[i][0], y1: lines[i][1], x2: lines[i + 1][0], y2: lines[i + 1][1], r: 90, g: 200, b: 255, a: 120, width: 14)
end

// ── Row 2: conics ─────────────────────────────────────────────────────────
label("ellipse", x: 20, y: 120)
draw_ellipse(cx: 70, cy: 165, rx: 48, ry: 24, r: 240, g: 120, b: 90)

label("ellipse outline", x: 150, y: 120)
draw_ellipse_outline(cx: 210, cy: 165, rx: 48, ry: 24, r: 240, g: 200, b: 90, a: 255, width: 5)

label("circle outline", x: 300, y: 120)
draw_circle_outline(cx: 340, cy: 165, radius: 26, r: 120, g: 220, b: 140, a: 255, width: 4)

// ── Row 3: arcs — one call per donut segment, not a hand-rolled quad fan ──
label("fill_arc donut", x: 20, y: 210)
let cx = 80
let cy = 275
let slices = [0.35, 0.25, 0.22, 0.18]
let colors = [[88, 166, 255], [63, 185, 80], [210, 153, 34], [248, 81, 73]]
var a0 = -1.5708
for i in range(0, 4) do
  let a1 = a0 + slices[i] * 6.28318
  fill_arc(cx, cy, 26.0, 52.0, a0, a1, r: colors[i][0], g: colors[i][1], b: colors[i][2])
  set a0 = a1
end

// A pie slice is the same call with no hole.
label("pie", x: 170, y: 210)
fill_arc(215, 275, 0.0, 50.0, 2.2, 5.6, r: 188, g: 140, b: 255)

// ── Row 4: fills ──────────────────────────────────────────────────────────
// A five-pointed star: concave, so `fill_poly`'s first-vertex fan would spill
// between the arms. `fill_polygon` triangulates it properly.
label("fill_polygon (concave)", x: 300, y: 210)
var star = []
for i in range(0, 10) do
  let r = if i % 2 == 0 then 46.0 else 19.0 end
  let t = 6.28318 * float(i) / 10.0 - 1.5708
  set star = append(star, [365 + int(r * cos(t)), 275 + int(r * sin(t))])
end
fill_polygon(points: star, r: 255, g: 214, b: 102)

label("fill_fan", x: 460, y: 210)
var rim = []
for i in range(0, 9) do
  let t = 3.14159 * float(i) / 8.0
  set rim = append(rim, [520 + int(46.0 * cos(t)), 275 + int(46.0 * sin(t))])
end
fill_fan(cx: 520, cy: 275, points: rim, r: 120, g: 200, b: 255)

// ── Row 5: rounded frames ────────────────────────────────────────────────
// Genuinely hollow, at any radius — what two stacked rounded fills can't do.
label("rounded outline", x: 20, y: 330)
draw_rect_rounded_outline(x: 20, y: 350, w: 160, h: 70, radius: 14, r: 88, g: 166, b: 255, a: 255, width: 3)
draw_rect_rounded_outline(x: 200, y: 350, w: 160, h: 70, radius: 1, r: 248, g: 81, b: 73, a: 255, width: 2)
draw_text("radius 14 / radius 1", x: 32, y: 378, size: 12, r: 230, g: 236, b: 243)

// ── Persistence ───────────────────────────────────────────────────────────
// `panel_store_*` is scoped to this script's path and survives a restart, so a
// panel can remember something without any file API.
state runs = 0
if runs == 0 then
  runs = int(panel_store_get("runs") ?? "0") + 1
  panel_store_set("runs", str(runs))
end
draw_text("run #{runs} (remembered across restarts)", x: 400, y: 378, size: 12, r: 150, g: 160, b: 180)

draw_rect_outline(0, 0, w, h, 44, 52, 68)
