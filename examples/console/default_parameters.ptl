// Default Parameter Values
// A parameter written `name = expr` may be left out of a call. The default is
// an expression, evaluated inside the function on every call that omits the
// argument — never once at declaration.

fn greet(name: string, greeting: string = "Hello", punct: string = "!") -> string
  "{greeting}, {name}{punct}"
end

// Trailing defaulted parameters can simply be left off.
print(greet("Ada"))
print(greet("Ada", "Hi"))

// Any defaulted parameter can be skipped by naming a later one.
print(greet("Ada", punct: "?"))
print(greet(punct: "...", name: "Ada"))

// A default may use the parameters before it, and anything the function body
// could capture.
let margin = 4

fn inset(width: num, height: num = width, pad: num = margin * 2) -> list
  [width - pad, height - pad]
end

print("inset:", inset(20))
print("inset:", inset(20, 10))
print("inset:", inset(20, pad: 0))

// The expression runs on *every* call that omits the argument, so a list
// default is a fresh list each time — the two calls below do not share one.
fn tagged(item, tags: list = [])
  push(tags, item)
end

print("tagged:", tagged("a"))
print("tagged:", tagged("b"))
print("tagged:", tagged("c", ["x"]))

// The same goes for a default with a side effect: it happens once per call
// that leans on it, and not at all when the argument is passed.
var issued = 0

fn next_id() -> int
  set issued += 1
  get issued
end

fn ticket(label: string, id: int = next_id()) -> string
  "#{id} {label}"
end

print(ticket("first"))
print(ticket("second"))
print(ticket("reserved", 99))
print(ticket("third"))
print("ids issued:", get issued)

// Passing nil is passing an argument; only omitting it evaluates the default.
fn describe(value = "nothing passed")
  "got {value}"
end

print(describe())
print(describe(nil))

// Lambdas take defaults too, and a callback handed fewer arguments than it
// declares uses its defaults for the rest.
let scale = fn(x, by = 10) -> x * by
print("scale:", scale(3), scale(3, 2))
print("mapped:", map([1, 2, 3], fn(x, by = 100) -> x * by))

// Methods: the receiver is the first parameter, the defaults come after it.
class Counter
  count: int,
end

fn Counter.bumped(c: Counter, by: int = 1) -> Counter
  Counter(c.count + by)
end

let c = Counter(5)
print("bumped:", c.bumped().count, c.bumped(10).count, c.bumped(by: 3).count)

// Overloads: a variant with exactly as many parameters as the call has
// arguments still wins; otherwise the call goes to the one variant whose
// defaults cover it.
fn area(size)
  "square {size * size}"
end
fn area(width, height, unit = "px")
  "rect {width * height}{unit}"
end

print(area(5))
print(area(5, 3))
print(area(width: 5, height: 3, unit: "pt"))
