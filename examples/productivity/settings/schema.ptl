// Fern preferences: the schema.
//
// Every setting the app shows is one record in SETTINGS. The app is a loop
// over this list: layout, search, the modified markers, reset, undo, the
// "Changes" list and persistence all read it, and nothing about a setting is
// written anywhere else. Adding a preference is adding a line here.

pub let SECTIONS = [
  {key: "general", label: "General", icon: "gear",
    blurb: "Startup behaviour, your profile and how Fern keeps itself current."},
  {key: "appearance", label: "Appearance", icon: "palette",
    blurb: "Colors, density and motion. These restyle this window as you change them."},
  {key: "editor", label: "Editor", icon: "code",
    blurb: "Type, layout and formatting for every buffer. The preview follows along."},
  {key: "notifications", label: "Notifications", icon: "bell",
    blurb: "What Fern interrupts you for, where the alert appears and when it stays quiet."},
  {key: "privacy", label: "Privacy & data", icon: "shield",
    blurb: "What leaves this machine, and what is kept on it."},
]

// A group is a titled card of rows inside a section: the nested sub-sections
// the sidebar lists under the open section.
pub let GROUPS = [
  {sec: 0, name: "Startup", note: ""},
  {sec: 0, name: "Profile", note: "Used to sign commits and to label you in shared sessions."},
  {sec: 0, name: "Updates", note: ""},
  {sec: 1, name: "Theme", note: ""},
  {sec: 1, name: "Interface", note: ""},
  {sec: 1, name: "Motion", note: ""},
  {sec: 2, name: "Font", note: ""},
  {sec: 2, name: "Display", note: ""},
  {sec: 2, name: "Formatting", note: ""},
  {sec: 3, name: "Alerts", note: ""},
  {sec: 3, name: "Events", note: "Choose which events raise an alert."},
  {sec: 3, name: "Quiet hours", note: ""},
  {sec: 4, name: "Telemetry", note: ""},
  {sec: 4, name: "Storage", note: ""},
]

