// `(points, c, a, width)` has the same count as the flat `(points, r, g, b)`.
// The native tells them apart itself (a colour record second means alpha and
// width follow), and takes the colour as it is — a `{r, g, b}` record, or with
// two or three arguments a packed RGB int (`r * 65536 + g * 256 + b`) — so no declaration here tests
// a type or unpacks a record: each only forwards. They stay Petal functions
// for the named calls that skip `a` to reach `width`.

pub fn draw_polyline(points, r, g, b, a = 255, width = 1)
  _native_polyline(points, r, g, b, a, width)
end
pub fn draw_polyline(points, c)
  _native_polyline(points, c)
end
pub fn draw_polyline(points, c, a)
  _native_polyline(points, c, a)
end
// Also positionally the flat `(points, r, g, b)`.
pub fn draw_polyline(points, c, a = 255, width = 1)
  _native_polyline(points, c, a, width)
end

// A closed outline: `draw_polyline` with the first point repeated at the end,
// so a ship, a hex or a rotated box needs no `append(pts, pts[0])` at every
// call. Takes exactly `draw_polyline`'s argument shapes.
fn _closed(points)
  if len(points) > 1 then append(points, points[0]) else points end
end
pub fn draw_polygon_outline(points, r, g, b, a = 255, width = 1)
  draw_polyline(_closed(points), r, g, b, a, width)
end
pub fn draw_polygon_outline(points, c)
  draw_polyline(_closed(points), c)
end
pub fn draw_polygon_outline(points, c, a)
  draw_polyline(_closed(points), c, a)
end
// Also positionally the flat `(points, r, g, b)`.
pub fn draw_polygon_outline(points, c, a = 255, width = 1)
  draw_polyline(_closed(points), c, a, width)
end

pub fn draw_text(text, x, y, size, r, g, b, a = 255)
  _native_text(text, x, y, size, r, g, b, a)
end
pub fn draw_text(text, x, y, size, c, a = 255)
  _native_text(text, x, y, size, c.r, c.g, c.b, a)
end
// Also positionally the mixed `(text, x, y, size, c)`.
pub fn draw_text(text, pos, size, c, a = 255)
  if _is_num(pos) then
    _native_text(text, pos, size, c, a.r, a.g, a.b)
  else
    _native_text(text, pos.x, pos.y, size, c.r, c.g, c.b, a)
  end
end
// Styled: a record of any subset of {size, color, font, weight, italic,
// spacing}. Omitted fields mean plain text — the host's own font, upright,
// regular — so a style is a diff against what draw_text always did. Measure
// the same record with text_width(s, style) and the two agree.
//   draw_text("#482", {x: 60, y: 20}, {size: 15, color: FG, weight: 700})
pub fn draw_text(text, pos, style)
  _native_text(text, pos.x, pos.y, style)
end
// The styled form with flat coordinates. Also positionally `(text, pos, size,
// c)`.
pub fn draw_text(text, x, y, style)
  if _is_num(x) then
    _native_text(text, x, y, style)
  else
    _native_text(text, x.x, x.y, y, style.r, style.g, style.b)
  end
end

// ── Pixel snapping ────────────────────────────────────────────────────────

// pixel_snap(on) — how what is drawn after it lands on the pixel grid, on a
// host that draws at fractional positions. By default rects (and images,
// gradients, shadows, canvases, text positions) snap to whole pixels, so
// rects that tile meet without a seam, and circles, lines, polylines and
// polygons keep their fractions, so a slow drift moves smoothly.
//
//   pixel_snap(true)    snap everything: pixel art
//   pixel_snap(false)   snap nothing
//   pixel_snap(nil)     back to the default
//
// Every frame starts at the default. A host that draws only whole pixels
// snaps everything whatever this says.
pub fn pixel_snap(on)
  _native_pixel_snap(on)
end

// ── Gradients ─────────────────────────────────────────────────────────────
// A gradient stop is an ordinary color record. It may carry an `a` field, in
// which case that is the stop's alpha — the only primitive where alpha rides
// *with* the color, because a two-stop fade needs two of them and there is no
// sensible positional place for the second. The trailing `a0, a1` parameters
// default to it, and override it when you'd rather pass alpha the way every
// other primitive does.
//
// `angle` is radians, clockwise from +x with y growing downward (the screen
// convention `fill_arc` uses): 0 runs left→right, PI/2 top→bottom.

// A stop's own alpha, or opaque when it carries none.
fn _stop_a(c)
  c["a"] ?? 255
end

pub fn draw_rect_gradient(rect, c0, c1, angle, a0 = _stop_a(c0), a1 = _stop_a(c1))
  _native_rect_gradient(rect.x, rect.y, rect.w, rect.h, c0.r, c0.g, c0.b, a0,
                        c1.r, c1.g, c1.b, a1, angle)
end
pub fn draw_rect_gradient(x, y, w, h, c0, c1, angle)
  _native_rect_gradient(x, y, w, h, c0.r, c0.g, c0.b, _stop_a(c0),
                        c1.r, c1.g, c1.b, _stop_a(c1), angle)
end
// The flat form, forwarded so the native stays reachable through the prelude.
pub fn draw_rect_gradient(x, y, w, h, r0, g0, b0, a0, r1, g1, b1, a1, angle)
  _native_rect_gradient(x, y, w, h, r0, g0, b0, a0, r1, g1, b1, a1, angle)
end

pub fn draw_rect_gradient_rounded(rect, radius, c0, c1, angle, a0 = _stop_a(c0), a1 = _stop_a(c1))
  _native_rect_gradient_rounded(rect.x, rect.y, rect.w, rect.h, radius,
                                c0.r, c0.g, c0.b, a0, c1.r, c1.g, c1.b, a1, angle)
end
pub fn draw_rect_gradient_rounded(x, y, w, h, radius, c0, c1, angle)
  _native_rect_gradient_rounded(x, y, w, h, radius,
                                c0.r, c0.g, c0.b, _stop_a(c0),
                                c1.r, c1.g, c1.b, _stop_a(c1), angle)
end
pub fn draw_rect_gradient_rounded(x, y, w, h, radius, r0, g0, b0, a0, r1, g1, b1, a1, angle)
  _native_rect_gradient_rounded(x, y, w, h, radius, r0, g0, b0, a0, r1, g1, b1, a1, angle)
end

// A disc shading from `c0` at the center to `c1` at the rim — glow, vignette,
// soft spotlight.
pub fn draw_circle_gradient(center, radius, c0, c1, a0 = _stop_a(c0), a1 = _stop_a(c1))
  _native_circle_gradient(center.x, center.y, radius, c0.r, c0.g, c0.b, a0,
                          c1.r, c1.g, c1.b, a1)
end
pub fn draw_circle_gradient(cx, cy, radius, c0, c1)
  _native_circle_gradient(cx, cy, radius, c0.r, c0.g, c0.b, _stop_a(c0),
                          c1.r, c1.g, c1.b, _stop_a(c1))
end
pub fn draw_circle_gradient(cx, cy, radius, r0, g0, b0, a0, r1, g1, b1, a1)
  _native_circle_gradient(cx, cy, radius, r0, g0, b0, a0, r1, g1, b1, a1)
end

// A multi-stop gradient: `stops` is a list of color records, spaced evenly
// along the axis. Two stops is exactly `draw_rect_gradient`; more than two is
// subdivided here into one two-stop band per pair, so a three-stop sky or a
// heat ramp costs no new draw command. Neighbouring bands share their edge
// color and the host interpolates per vertex, so the seams do not show.
//
// The bands are laid out along whichever axis the angle leans toward, which
// makes them exact for an axis-aligned `angle` and an approximation for a
// diagonal one (each band still gradates along the true angle; only the band
// *boundaries* are axis-aligned). Two stops has no bands and is exact at any
// angle.
pub fn linear_gradient(rect, stops, angle, radius = 0)
  let n = len(stops)
  if n == 1 then
    draw_rect_rounded(rect, radius, stops[0], _stop_a(stops[0]))
  end
  if n == 2 then
    draw_rect_gradient_rounded(rect, radius, stops[0], stops[1], angle)
  end
  if n > 2 then
    // The rounded corners come from a rounded clip rather than from the
    // bands: only the first and last band touch a corner, and asking each to
    // round the ones it doesn't touch would notch the middle of the shape.
    if radius > 0 then
      clip_push(rect, radius)
    end
    let bands = n - 1
    let along_x = abs(cos(angle)) >= abs(sin(angle))
    let forward = cos(angle) >= 0.0
    if !along_x then
      forward = sin(angle) >= 0.0
    end
    for i in range(0, bands) do
      // The band's span along the layout axis, as fractions of the rect. A
      // gradient pointing backwards along the axis lays its bands out from
      // the far end, so stop 0 is still where the gradient starts.
      let t0 = (i * 1.0) / bands
      let t1 = ((i + 1) * 1.0) / bands
      if !forward then
        let swap = t0
        t0 = 1.0 - t1
        t1 = 1.0 - swap
      end
      let band = {x: rect.x + t0 * rect.w, y: rect.y, w: (t1 - t0) * rect.w, h: rect.h}
      if !along_x then
        band = {x: rect.x, y: rect.y + t0 * rect.h, w: rect.w, h: (t1 - t0) * rect.h}
      end
      // Band `i` is the i-th *along the gradient*, so it always carries stops
      // i→i+1; a backwards angle only moved where it sits, and the angle
      // itself still orients the fade inside it.
      draw_rect_gradient(band, stops[i], stops[i + 1], angle)
    end
    if radius > 0 then
      clip_pop()
    end
  end
  nil
end

// The four axis-aligned gradient angles, named. `angle` is radians clockwise
// from +x with y downward, so these are the directions a fade *travels*:
// `GRAD_DOWN` starts opaque at the top edge.
pub let GRAD_RIGHT = 0.0
pub let GRAD_DOWN = 1.5707963267948966
pub let GRAD_LEFT = 3.141592653589793
pub let GRAD_UP = 4.71238898038469

// ── Scrims, fades and area fills ──────────────────────────────────────────
// The three things a two-stop gradient is for in an interface, as helpers, so
// no panel has to work out the stop-and-angle arithmetic again.

// A scrim: a band of `color` fading to nothing, laid over content so text can
// sit on top of it and stay legible — a caption over a photo, a title over a
// hero image, a toolbar over a map. The band is opaque at the edge the text is
// anchored to and gone at the other, which is what keeps the underlying image
// visible everywhere the text is not.
//
//   draw_scrim(caption_band, {edge: "bottom"})
//   draw_text(caption, {x: ..., y: ...}, ...)
pub fn draw_scrim(r)
  draw_scrim(r, {})
end

// `style` overrides {color, a, edge} — `edge` is which side of `r` the scrim
// is solid at: "bottom" (the default — a caption band), "top", "left",
// "right".
pub fn draw_scrim(r, style)
  let c = _get(style, "color", :000000)
  let a = _get(style, "a", 190)
  let edge = _get(style, "edge", "bottom")
  // The fade runs *away* from the solid edge, so the angle is the direction
  // the alpha decreases in.
  let angle = GRAD_UP
  if edge == "top" then
    angle = GRAD_DOWN
  elsif edge == "left" then
    angle = GRAD_RIGHT
  elsif edge == "right" then
    angle = GRAD_LEFT
  end
  draw_rect_gradient(r, c, c, angle, a, 0)
end

// A fade-out mask along one edge of a scrolling region: the region's own
// background, opaque at the edge and transparent a few pixels in, so content
// scrolling past the boundary dissolves instead of being guillotined by the
// clip. The counterpart to a scrim — a scrim hides what is under it, a fade
// hides where content *ends*.
//
//   clip_push(list_rect)
//   ...rows...
//   clip_pop()
//   draw_fade(cut_bottom(list_rect, 24).cut, {edge: "bottom"})
pub fn draw_fade(r)
  draw_fade(r, {})
end

// `style` overrides {color, a, edge}; `color` defaults to the theme background
// (what the fade is dissolving *into*) and `edge` is the side it is solid at.
pub fn draw_fade(r, style)
  let t = _palette()
  draw_scrim(r, {
    color: _get(style, "color", t.bg),
    a: _get(style, "a", 255),
    edge: _get(style, "edge", "bottom")
  })
end

// The filled area under a line chart, fading to transparent at the baseline —
// the shape a plain rect fill cannot make, because the top edge follows the
// data.
//
// `points` is the polyline, in order, as {x, y} records; `baseline_y` is the
// axis the fill drops to. Each segment is cut into `step`-px columns and each
// column drawn as its own vertical gradient. That is exact rather than
// approximate: the fill's alpha at a pixel is a linear function of y alone, so
// starting each column at its own top with the alpha that ramp has *there*
// reproduces the single global ramp, column by column.
pub fn draw_area_fill(points, baseline_y, color)
  draw_area_fill(points, baseline_y, color, {})
end

// `style` overrides {a, step} — `a` is the alpha at the highest point of the
// series (the fill is weakest where the data is lowest, which is what reads as
// depth), `step` the column width in px.
pub fn draw_area_fill(points, baseline_y, color, style)
  let n = len(points)
  if n >= 2 then
    let peak = _get(style, "a", 110)
    let step = max(1, _get(style, "step", 3))
    // The top of the ramp: the highest point of the series. Everything below
    // it is proportionally weaker.
    let top = points[0].y
    for p in points do
      if p.y < top then top = p.y end
    end
    let span = float(baseline_y - top)
    for i in range(0, n - 1) do
      let a = points[i]
      let b = points[i + 1]
      let dx = float(b.x - a.x)
      if dx > 0.0 then
        let cols = max(1, int(dx / float(step)))
        for j in range(0, cols) do
          let x0 = float(a.x) + dx * float(j) / float(cols)
          let x1 = float(a.x) + dx * float(j + 1) / float(cols)
          // The column's own top, on the segment.
          let cy = float(a.y) + float(b.y - a.y) * (float(j) + 0.5) / float(cols)
          if float(baseline_y) > cy then
            // The global ramp's alpha at this column's top.
            let a0 = peak
            if span > 0.0 then
              a0 = int(float(peak) * (float(baseline_y) - cy) / span)
            end
            let band = {x: x0, y: cy, w: x1 - x0, h: float(baseline_y) - cy}
            draw_rect_gradient(band, color, color, GRAD_DOWN, a0, 0)
          end
        end
      end
    end
  end
  nil
end

// ── Shadows ───────────────────────────────────────────────────────────────

// A CSS box-shadow cast by the rounded rect `rect`. `opts` is a partial record
// of {radius, blur, spread, dx, dy, color, a} — anything omitted defaults to
// the plain drop shadow (square corners, no spread, no offset, black at 25%).
// The whole shadow composites once, so it never shows a seam:
//
//   draw_shadow(card, {radius: 8, blur: 16, dy: 4, a: 60})
//   draw_rect_rounded(card, 8, t.panel)

pub fn draw_shadow(rect, opts)
  let c = opts["color"] ?? :000000
  _native_shadow(rect.x, rect.y, rect.w, rect.h,
                 opts["radius"] ?? 0, opts["blur"] ?? 8, opts["spread"] ?? 0,
                 opts["dx"] ?? 0, opts["dy"] ?? 0,
                 c.r, c.g, c.b, opts["a"] ?? 64)
end

// The positional form, for the common "soft shadow under this card" call.
pub fn draw_shadow(rect, radius, blur, c, a = _stop_a(c))
  _native_shadow(rect.x, rect.y, rect.w, rect.h, radius, blur, 0, 0, 0, c.r, c.g, c.b, a)
end
// The flat form the native takes, forwarded so it stays reachable.
pub fn draw_shadow(x, y, w, h, radius, blur, spread, dx, dy, r, g, b, a = 255)
  _native_shadow(x, y, w, h, radius, blur, spread, dx, dy, r, g, b, a)
end

// ── Elevation ─────────────────────────────────────────────────────────────
// The named scale the widget set casts its shadows from — `elevation_1/2/3` on
// the theme. One scale for every floating thing (cards at 1, menus and
// popovers and dropdowns at 2, modals and toasts at 3) is what makes a panel
// read as one surface lit by one light. The alternative, which this library
// shipped for years, is a hard-edged offset rectangle per widget: that does
// not read as elevation at all, it reads as a misaligned duplicate.
//
//   draw_elevation(card_rect, t.radius, 1)
//   draw_rect_rounded(card_rect, t.radius, t.surface)

// The `draw_shadow` opts record for elevation `level` (1–3, clamped).
pub fn elevation(level)
  let t = _palette()
  let l = clamp(level, 1, 3)
  if l == 1 then
    t.elevation_1
  elsif l == 2 then
    t.elevation_2
  else
    t.elevation_3
  end
end

// Cast elevation `level`'s shadow for a rounded rect. Draw it *before* the
// surface itself — the shadow is what is behind the card, not on it.
pub fn draw_elevation(r, radius, level)
  draw_elevation(r, radius, level, {})
end

// `style` overrides any of {blur, spread, dx, dy, color, a} over the level's
// values — for a coloured glow, or a shadow that has to lean a particular way.
pub fn draw_elevation(r, radius, level, style)
  let e = elevation(level)
  draw_shadow(r, {
    radius: radius,
    blur: _get(style, "blur", e.blur),
    spread: _get(style, "spread", e.spread),
    dx: _get(style, "dx", 0),
    dy: _get(style, "dy", e.dy),
    color: _get(style, "color", :000000),
    a: _get(style, "a", e.a)
  })
end

// A focus ring: the accent colour bloomed around `r` rather than a hard
// second outline, so focus reads as attention rather than as a doubled
// border. Draw it before the widget's own surface, like any other shadow.
pub fn draw_focus_ring(r, radius)
  draw_focus_ring(r, radius, {})
end

// `style` overrides {color, blur, spread, a}.
pub fn draw_focus_ring(r, radius, style)
  let t = _palette()
  let c = _get(style, "color", t.accent)
  draw_shadow(r, {
    radius: radius,
    blur: _get(style, "blur", 8),
    spread: _get(style, "spread", 1),
    color: c,
    a: _get(style, "a", 150)
  })
end

// The shadow a sticky header casts over content scrolled underneath it: a
// short vertical fade below `header_rect`, at a strength that follows how far
// the content has scrolled, so a list at rest shows no seam at all. `frac` is
// 0 (at the top, nothing drawn) to 1 (fully lifted); scaling it by
// `min(1.0, scroll_px / 24.0)` is the usual call.
pub fn draw_scroll_shadow(header_rect, frac)
  draw_scroll_shadow(header_rect, frac, {})
end

// `style` overrides {height, color, a}.
pub fn draw_scroll_shadow(header_rect, frac, style)
  let f = clamp(float(frac), 0.0, 1.0)
  if f > 0.004 then
    let h = _get(style, "height", 8)
    let c = _get(style, "color", :000000)
    let peak = int(float(_get(style, "a", 70)) * f)
    let band = rect(header_rect.x, header_rect.y + header_rect.h, header_rect.w, h)
    // Downward: opaque at the header's edge, gone `h` px later.
    draw_rect_gradient(band, c, c, GRAD_DOWN, peak, 0)
  end
end

// ── Layers — offscreen canvases, backdrops and blur ───────────────────────
// A *layer* is a canvas the size of a rect that a closure draws into, then
// composited back at that rect. It is what every effect that needs an
// offscreen buffer is made of, and the closure is what keeps it composable:
// `draw_to` hands back the target it replaced, so layers nest without a
// stack anyone has to keep, and the body draws in canvas-local coordinates
// ((0, 0) is the rect's top-left) the same way it would on screen.
//
//   // A group of overlapping translucent shapes at 50%, as one object — the
//   // thing drawing each shape at 50% gets wrong, since alpha blending is not
//   // idempotent and every overlap would read darker.
//   layer(card, {a: 128}, fn()
//     draw_circle(rect(0, 0, 80, 80), c1)
//     draw_circle(rect(40, 0, 80, 80), c2)
//   end)
//
//   // A glow: the shape drawn into a layer and the layer blurred.
//   layer(halo, {blur: 12}, fn() draw_circle(rect(0, 0, halo.w, halo.h), accent) end)
//
//   // The translucent bar content scrolls under — see draw_material.
//   draw_material(bar, {kind: "regular", hairline: true})
//
// Hosts without render targets draw nothing for a canvas (it never existed),
// so a helper that must stay legible everywhere paints its flat fallback
// *outside* the layer — `draw_material` draws its tint after the blurred
// snapshot, which on such a host is the tint alone: right in aggregate.

// An offscreen canvas, transparent until drawn into, recreated each frame.
pub fn canvas(w, h)
  create_canvas(int(w), int(h))
end
pub fn canvas(r)
  create_canvas(int(r.w), int(r.h))
end

// The flat form, forwarded so it stays reachable under the record one.
pub fn draw_canvas(id, x, y, a = 255, w = 0, h = 0)
  _native_draw_canvas(id, x, y, a, w, h)
end

// draw_canvas(id, at[, opts]) — `at` is a point {x, y} (natural size) or a
// rect (the canvas scaled into it); `opts` is {a}. Three arguments is also,
// positionally, the flat `draw_canvas(id, x, y)`, told apart by whether the
// second is a number.
pub fn draw_canvas(id, at, opts = {})
  if _is_num(at) then
    _native_draw_canvas(id, at, opts)
  else
    _draw_canvas_at(id, at, opts)
  end
end

// `at`'s numbers go through as the flat form's do: a host that truncates
// does so in the native, and a sub-pixel host keeps the fractions under
// `pixel_snap(false)`.
fn _draw_canvas_at(id, at, opts)
  _native_draw_canvas(id, at.x, at.y, _get(opts, "a", 255),
                      _get(at, "w", 0), _get(at, "h", 0))
end

// Draw `body()` into a fresh canvas the size of `r` — canvas-local
// coordinates — then composite it at `r`. `opts` is {a, blur}: the group's
// opacity, and a Gaussian blur (px) applied to the whole layer before it is
// drawn. Returns the canvas id, so the caller can draw it again (a repeated
// stamp) or filter it further.
pub fn layer(r, body)
  layer(r, {}, body)
end
pub fn layer(r, opts, body)
  let c = create_canvas(int(r.w), int(r.h))
  let prev = draw_to(c)
  body()
  draw_to(prev)
  let blur = _get(opts, "blur", 0)
  if blur > 0 then
    blur_canvas(c, blur)
  end
  _native_draw_canvas(c, int(r.x), int(r.y), _get(opts, "a", 255), 0, 0)
  c
end

// A canvas holding what is currently painted under `r` — the backdrop
// primitive. Order matters: it copies the target as drawn *so far*.
pub fn snapshot(r)
  let c = create_canvas(int(r.w), int(r.h))
  snapshot_to(c, int(r.x), int(r.y))
  c
end

// Replace what is under `r` with a `radius`-px Gaussian blur of itself.
pub fn draw_backdrop_blur(r, radius)
  let c = snapshot(r)
  blur_canvas(c, radius)
  _native_draw_canvas(c, int(r.x), int(r.y), 255, 0, 0)
end

// The translucent, background-sampling surface Apple's chrome is made of —
// navigation and tab bars, sheets, the floating search pill: what is behind
// it, blurred, under a tint. `opts`:
//   kind      "thin" | "regular" | "thick" — how much the backdrop shows
//             through (sets the default blur and tint strength)
//   radius    corner radius (a bar is 0, a pill is r.h / 2)
//   blur      Gaussian radius in px (default by kind: 12 / 20 / 32)
//   tint      the material's colour (default: the theme surface)
//   a         tint opacity 0–255 (default by kind: 110 / 165 / 215)
//   hairline  true draws the 1-px separator a bar carries on the edge facing
//             the content ("top" / "bottom" choose the edge; true = bottom)
//
// Content that scrolls under the material must be drawn *before* it — the
// snapshot reads what is already there.
pub fn draw_material(r)
  draw_material(r, {})
end
pub fn draw_material(r, opts)
  let t = _palette()
  let kind = _get(opts, "kind", "regular")
  let a_default = if kind == "thin" then 110 elsif kind == "thick" then 215 else 165 end
  let blur_default = if kind == "thin" then 12 elsif kind == "thick" then 32 else 20 end
  let radius = _get(opts, "radius", 0)
  let tint = _get(opts, "tint", t.surface)
  let a = _get(opts, "a", a_default)
  let blur = _get(opts, "blur", blur_default)
  clip_push(r, radius)
  // Backdrop first, tint over it: on a host without render targets the
  // backdrop is nothing and the tint alone is the flat approximation.
  draw_backdrop_blur(r, blur)
  draw_rect(r, tint, a)
  // The hairline stays inside the clip so a rounded material's corners cut
  // it the way they cut the tint.
  let hairline = _get(opts, "hairline", false)
  if hairline == true || hairline == "bottom" then
    draw_rect(rect(r.x, r.y + r.h - 1, r.w, 1), t.border, 140)
  elsif hairline == "top" then
    draw_rect(rect(r.x, r.y, r.w, 1), t.border, 140)
  end
  clip_pop()
  nil
end

// ── Fonts ─────────────────────────────────────────────────────────────────

// `font(name)` names a face as an *object* rather than a string, so the size
// and decorations that belong with it can travel with it:
//
//   let title = font_bold(font("Helvetica Neue", 22))
//   draw_text("Chapter One", {x: 20, y: 40}, title)
//   let w = text_width("Chapter One", title)
//
// A font object is an ordinary style record — the same `{size, color, font,
// weight, italic, spacing}` `draw_text`, `text_width` and every widget `style`
// argument already take — so it drops into all of them, and merges with a
// style the usual way (`{...title, color: FG}`). That is the point: one value
// describes a run's whole appearance, so what you measure is what you draw.
//
// `name` is a family name (`"Helvetica Neue"`), one of the host's role names
// (`"mono"`, `"ui"`), or a CSS-style fallback list (`"Menlo, mono"`). The host
// resolves it against the fonts actually installed; one it cannot draw keeps
// the name as written and falls back to the host's default face for both
// measuring and drawing, so a script written on one machine still lays out
// sensibly on another. `fonts()` lists what this host offers.
pub fn font(name)
  _native_font(name)
end

// `font(name, size)` — the common case, in one call.
pub fn font(name, size)
  {..._native_font(name), size: size}
end

// The decorations. Each returns a *new* font object with one field set, so
// they compose and never mutate the font they were given:
//   let body = font("Inter", 14)
//   let emphasis = font_italic(font_color(body, ACCENT))
pub fn font_size(f, size)
  {...f, size: size}
end

// CSS numeric weight, 100–900. A host draws the nearest cut the family ships,
// synthesizing bold only for a family that has none.
pub fn font_weight(f, w)
  {...f, weight: w}
end

pub fn font_bold(f)
  {...f, weight: 700}
end

pub fn font_italic(f)
  {...f, italic: true}
end

// Letter-spacing in pixels, added after each glyph.
pub fn font_spacing(f, px)
  {...f, spacing: px}
end

// The color a run in this font draws in — a `{r, g, b}` (or `{r, g, b, a}`)
// record, the same shape every other draw call takes.
pub fn font_color(f, c)
  {...f, color: c}
end

// ── Color helpers ─────────────────────────────────────────────────────────

// Blend two colors: `t` = 0 is `a`, 1 is `b`. Thin wrapper over the `color_lerp`
// builtin so the prelude's own name for it is discoverable next to `theme` —
// several apps hand-rolled this same three-channel average.
pub fn mix(a, b, t)
  color_lerp(a, b, t)
end

// `lerp_color` is the same function under the name the graphics-minded reach
// for first.
pub fn lerp_color(a, b, t)
  color_lerp(a, b, t)
end

// Perceived brightness of a color, 0 (black) – 255 (white), using the Rec. 601
// luma weights. The one thing a themeable widget actually needs to know about a
// color it did not choose: `luma(bg) > 128` means "this is a light surface", so
// pick dark ink. Handy for deriving a readable foreground for arbitrary tags,
// avatars and status chips.
pub fn luma(c)
  (c.r * 299 + c.g * 587 + c.b * 114) / 1000
end

// A foreground that stays readable on `bg`: near-black on light surfaces,
// near-white on dark ones.
pub fn contrast_text(bg)
  if luma(bg) > 140 then :14161c else :f2f5fa end
end

// ── Compositing ───────────────────────────────────────────────────────────
// A flat tint — a hover wash, a disabled label, a hairline divider, a zebra
// stripe — is a translucent ink over a surface *you already know*. Drawing it
// as a translucent fill hands the compositor a job it does not need, and one
// it is easy to get subtly wrong; worse, it is not idempotent, so two 50%
// fills that land on the same pixel read as 75% and a widget drawn twice in a
// frame (a hover under a selection, say) comes out the wrong colour.
//
// `over` does that composite here, on the CPU, in sRGB — the same space and
// the same source-over formula a correct renderer uses — and returns an
// **opaque** colour. Passing that to a plain `draw_rect` gives the identical
// pixel, once, no matter how many times it is drawn.
//
// This is for tints over a *known* surface only. Genuine translucency — a
// modal backdrop, a fading tooltip, anything over content the widget did not
// paint — still takes a plain alpha, because there is nothing to composite
// against ahead of time. Widgets that flatten a tint therefore take an `on`
// style key naming the surface they sit on.

// A percentage as the 0–255 alpha every draw primitive takes: alpha_pct(40)
// is 102. The unit conversion that flat-tint percentages keep needing.
pub fn alpha_pct(p)
  clamp(int(p * 255 / 100), 0, 255)
end

// `fg` composited over `bg` at alpha `a`, as an opaque colour. `a` is either
// the 0–255 alpha every primitive takes or a 0.0–1.0 fraction — a float is
// read as the fraction, an int as the byte.
pub fn over(bg, fg, a)
  let f = if type(a) == "float" then clamp(a, 0.0, 1.0) else clamp(float(a) / 255.0, 0.0, 1.0) end
  color_lerp(bg, fg, f)
end

// `over` with the alpha written as a percentage — how tints are actually
// specified ("a 10% hairline", "disabled text at 40%").
pub fn tint(bg, fg, pct)
  over(bg, fg, alpha_pct(pct))
end

// The hairline every divider, rule and table gridline wants: the surface's own
// ink at 10%, which stays a hairline on a light theme and on a dark one
// without either being hand-tuned.
pub fn hairline(bg, ink)
  tint(bg, ink, 10)
end
