// ── Vellum ──────────────────────────────────────────────────────────────────
// A notes app on paper. A notebook rail on the left, a searchable note list in
// the middle, and a real multi-line text editor on the right: soft-wrapped
// lines, a placed caret, click-and-drag selection, shift-arrow selection,
// double-click word select, and live search highlighting inside the body.
//
// Exercises: text editing (a full line/column edit model built in Petal —
// insert, delete, split, join, word wrap with a display-row index), selection
// (mouse drag, shift+arrows, double-click), persistence (a saved snapshot
// separate from the working copy, dirty tracking, idle autosave, explicit
// save, and an undo history that can resurrect a deleted note), and search
// (case-insensitive across titles and bodies, with in-body highlighting).
//
// Designed for a 1280x850 panel.

// ── palette ─────────────────────────────────────────────────────────────────
let RAIL_BG   = #e7e1d5
let LIST_BG   = #f1ece2
let PAPER     = #fbf8f2
let CARD_HOV  = #e9e3d7
let INK       = #2a2622
let INK_SOFT  = #635b50
let FAINT     = #9a9081
let GHOST     = #b9b1a2
let RULE      = #d9d1c1
let RULE_SOFT = #e6dfd1
let ACCENT    = #b2543a
let SAGE      = #4c7360
let GOLD      = #b3861f
let BLUE      = #4a6f96
let VIOLET    = #7a6ba8
let SELBG     = #d2dbe6
let MATCH     = #f3dfa4
let WHITE     = #ffffff

// ── metrics ─────────────────────────────────────────────────────────────────
let W = screen_width()
let H = screen_height()

let RAIL_W = 208
let LIST_W = 360
let EDX    = RAIL_W + LIST_W
let EDW    = W - EDX

let PAD    = 20
let LPAD   = 18
let EPAD   = 44

let FS_MICRO = 10
let FS_TINY  = 11
let FS_SM    = 12
let FS       = 13
let FS_ROW   = 14
let FS_BODY  = 14
let FS_TITLE = 22
let FS_MARK  = 21

let LH  = 23                          // body line height
let CW  = text_width("m", FS_BODY)    // monospace advance

let BODY_X = EDX + EPAD
let BODY_W = EDW - EPAD - 36
let BODY_Y = 158
let FOOT_H = 44
let BODY_H = H - BODY_Y - FOOT_H - 14
let MAXC   = BODY_W / CW         // wrap width, in characters

// ── the store ───────────────────────────────────────────────────────────────
// `saved` is the persisted document; `notes` is the working copy. Values are
// immutable, so `saved = notes` really is a snapshot — nothing later written
// through `notes` can reach into it. Save commits, Revert restores.
state notes = [
  {id: 1, book: "Journal", pinned: true, mins: 14,
    title: "Morning, the long table",
    lines: [
