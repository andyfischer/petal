// ── The levels ────────────────────────────────────────────────────────────
// `world` selects the tileset; `pal` is the four background sub-palettes as
// three colors each (entry 0 is always the backdrop). Palette 2 is the status
// bar's and is white in every world on purpose — the HUD should not change
// character when the scenery does.
//
// `boss` is the world pixel past which the Rift Warden wakes, or -1 for a
// level that ends at a banner instead.

export fn level(n)
  if n == 1 then
    {
      name: "THE DEEP",
      world: 1,
      backdrop: black,
      pal: [
        [navy, gray, light_gray],       // 0 — fractured stone
        [indigo, violet, pink],         // 1 — crystal seams and blocks
        [gray, light_gray, white],      // 2 — status bar
        [maroon, red, orange]           // 3 — embers
      ],
      chunks: [L2_0, L2_1, L2_2, L2_3, L2_4, L2_5, L2_6, L2_7, L2_8],
      boss: -1
    }
  elsif n == 2 then
    {
      name: "SKY CASTLE",
      world: 2,
      backdrop: navy,
      pal: [
        [gray, light_gray, white],      // 0 — cut marble
        [purple, magenta, pink],        // 1 — royal brick
        [gray, light_gray, white],      // 2 — status bar
        [blue, cyan, pale_cyan]         // 3 — glass and stars
      ],
      chunks: [L3_0, L3_1, L3_2, L3_3, L3_4, L3_5, L3_6, L3_7, L3_8],
      boss: 900
    }
  else
    {
      name: "GREEN FIELDS",
      world: 0,
      backdrop: light_blue,
      pal: [
        [brown, peach, light_green],    // 0 — grass over dirt
        [maroon, brown, peach],         // 1 — brick and timber
        [gray, light_gray, white],      // 2 — status bar
        [dark_green, green, pale_green] // 3 — foliage
      ],
      chunks: [L1_0, L1_1, L1_2, L1_3, L1_4, L1_5, L1_6, L1_7, L1_8],
      boss: -1
    }
  end
end

// How many levels there are. `game.ptl` counts wins against this.
export let level_count = 3
