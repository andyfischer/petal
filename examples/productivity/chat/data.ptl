// ── Replies ──────────────────────────────────────────────────────────────
// A teammate answering something you wrote picks from the pool its words
// suggest; `pick` chooses deterministically from the message number.

const POOLS = [
  {keys: ["thank", "thx", "appreciate"], lines: ["Anytime 🙌", "Of course!", "Happy to help."]},
  {keys: ["ship", "launch", "release", "thursday"], lines: ["Thursday can't come soon enough 🚀", "Fingers crossed for a very boring launch day.", "We're in good shape. Runbook's pinned if anyone needs it."]},
  {keys: ["lunch", "coffee", "taco", "cake", "gerald"], lines: ["Count me in ☕", "Tacos. Always tacos 🌮", "I'm already in the kitchen."]},
  {keys: ["lgtm", "looks good", "great", "nice", "love"], lines: ["Thanks! Merging now.", "Appreciate it 🙏", "That means a lot — thank you."]},
  {keys: ["bug", "broken", "error", "fail", "flaky"], lines: ["Ugh. Can you drop the logs in a thread? I'll take a look.", "On it — I'll open a ticket and link it here.", "Reproduced it. Fix incoming."]},
  {keys: ["?"], lines: ["Good question — I think so, but let me double-check and get back to you.", "Yes! I'll confirm in a bit.", "Not yet. I can pick it up after the 3:30.", "I'd say yes, but Priya has the final call."]},
]

const GENERIC = ["Makes sense to me.", "👍 on it.", "Noted — I'll follow up in a bit.", "Agreed. Let's do it.", "Ha, fair point.", "Sounds good, thanks for flagging."]

pub fn pick(seed: int, salt: int, n: int) -> int
  hash_int(seed, salt) % max(1, n)
end

pub fn reply_for(text: string, seed: int, who: string) -> string
  let low = lower(text)
  // A message that ends on a question gets an answer, whatever else it says.
  if ends_with(trim(low), "?") then
    let qs = last(POOLS).lines
    return qs[pick(seed, hash_str(who) % 1000, len(qs))]
  end
  let pool = find(POOLS, fn(p) -> any(p.keys, fn(k) -> index_of(low, k) >= 0))
  let lines = if pool != nil then pool.lines else GENERIC end
  lines[pick(seed, hash_str(who) % 1000, len(lines))]
end

// Who answers you in a channel: whoever you named, else anyone there but
// you, preferring whoever spoke last.
pub fn responder(c: record, text: string, last_other: string, seed: int) -> string
  if c.kind == "dm" then return dm_peer(c) end
  let others = filter(c.members, fn(k) -> k != ME)
  let named = addressed(c, text)
  if named != "" then return named end
  if last_other != "" && pick(seed, 3, 3) > 0 then last_other else others[pick(seed, 5, len(others))] end
end

// The teammate in `c` that `text` names, by @handle or first name; "" for none.
pub fn addressed(c: record, text: string) -> string
  let low = lower(text)
  let named = find(c.members, fn(k) -> k != ME && (index_of(low, "@" ++ k) >= 0 || index_of(low, lower(first_name(k))) >= 0))
  named ?? ""
end

// Someone else who will leave a reaction on your message.
pub fn reactor(c: record, not_who: string, seed: int) -> string
  let others = filter(c.members, fn(k) -> k != ME && k != not_who)
  if len(others) == 0 then "" else others[pick(seed, 11, len(others))] end
end

pub const QUICK = ["👍", "🎉", "👀", "🙌"]

// Whether `text` mentions you.
pub fn mentions_me(text: string) -> bool
  index_of(lower(text), "@jordan") >= 0
end
