// Micro-benchmark: what declaring enum constant data costs a run. 50 variants,
// three data keys each, declared and otherwise unused; `enum_decl_plain.ptl`
// is the same enum without data. Run both on one kept stack:
//
//   cd core && cargo run --release --example rerun_timing -- \
//     ../test/benchmarks/micro/enum_decl_data.ptl ../test/benchmarks/micro/enum_decl_plain.ptl
//
// Figures are in docs/dev/performance.md (Enum data reads).

enum Tile
  t00(code: 0, label: "t00", cost: 0.5),
  t01(code: 1, label: "t01", cost: 2),
  t02(code: 2, label: "t02", cost: 3.5),
  t03(code: 3, label: "t03", cost: 5),
